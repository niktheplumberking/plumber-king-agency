# Production address. Used for canonical tags, sitemap.xml, robots.txt, llms.txt and schema.
NEXT_PUBLIC_SITE_URL=https://plumberkingagency.com
# Where the contact / audit forms POST (JSON). Leave empty and the forms fall back to opening an email to nick@plumberkingagency.com.
NEXT_PUBLIC_FORM_ENDPOINT=
# Booking link for "Book your free strategy call" (Calendly, Cal.com, GHL...). Empty = the button goes to /contact/.
NEXT_PUBLIC_BOOKING_URL=
# 1 = show placeholder reviews, stats and portfolio (preview only, each badged PLACEHOLDER). Never 1 on the live site.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=0
