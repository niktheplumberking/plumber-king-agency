---
// /about final CTA, fix round 3 (D, RECHECK MAJOR 1 + BLOCKER 1b). Was "Talk to the crew": a second Kody / Zak / Chase list
// with "Named in N of 16" (the first one is "The names in the reviews" above) and "When you call, one of these picks up"
// (who answers is not confirmed). Both are gone. New idea, "Keep the card": Kody's real business card, large and centred,
// is the call to action. It tilts toward the pointer and turns over on a tap (front: the whole logo, 24/7, licensed and
// insured; back: Kody Glass, Owner, the number, the licence). It moved here from the hero, so "Kody Glass, Owner" is never
// in the same view as the single crew face at the top of the page (no names beside a single face, at any width).
// 21st.dev: "Holographic Business Card" (@aakashmehra, id 44447: tilts toward the pointer, lifts on hover, flips on click),
// adapted to vanilla TS + CSS 3D, re-skinned: no foil, a soft light that follows the pointer, the Glass powder offset shadow; the turn-over pill bites
// the card's lower edge (the depth layer).
// Nearest match: Glass home Crew also flips this card (there it sits on the van photo inside the crew section); here it is
// the whole section, centred, with tilt, and the page's last call buttons. Mike's CTAs are a tear-off flyer, hex swell,
// road sign, wall calendar; Khinda's a wall switch and a viewfinder; none is a card.
// JS: two listeners on the card (pointer tilt, gated to fine pointers + motion) and the flip; nothing runs while idle.
// Reduced motion: no tilt, the flip is a short cross-fade. No JS: the front shows and hover turns it over.
import Head from '../areas/Head.astro';
import Btn from '../kit/Btn.astro';
import Img from '../ui/Img.astro';
import { SITE } from '../../data/site';
---
<section class="bcall" data-m-section aria-labelledby="bcall-h">
  <div class="wrap bk-in">
    <div class="bk-head">
      <Head eyebrow="Keep the card" l1="One number," l2="any hour." size={64} sizeM={40} id="bcall-h" br={false} />
      <p class="bk-lead" data-t="3">It is the number on the van and on the card. Call it, or text a photo of the problem first.</p>
    </div>

    <div class="bk-stage" data-t="4" data-fx="pop">
      <div class="bk-tilt" data-bk-tilt>
        <button class="bk-card" type="button" aria-pressed="false" data-bcard>
          <span class="sr-only" data-bcard-label>Kody Glass's business card, front. Turn it over</span>
          <span class="bk-inner" aria-hidden="true">
            <span class="bk-face bk-front">
              <Img name="business-card" alt="" sizes="(min-width:768px) 520px, 300px" fit="cover" widths={[340, 520, 700, 1040]} />
            </span>
            <span class="bk-face bk-back">
              <Img name="business-card" alt="" sizes="(min-width:768px) 520px, 300px" fit="cover" widths={[340, 520, 700, 1040]} />
            </span>
          </span>
        </button>
      </div>
      <p class="bk-hint" aria-hidden="true" data-bk-hint-wrap><svg viewBox="0 0 16 16" width="12" height="12"><path d="M2.5 8a5.5 5.5 0 0 1 9.6-3.7M13.5 8a5.5 5.5 0 0 1-9.6 3.7M12.6 1.6v3h-3M3.4 14.4v-3h3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><span data-bcard-hint>Tap the card to turn it over</span></p>
      <p class="sr-only">Front: Glass Plumbing Services, commercial and residential, {SITE.phone}, 24/7 emergency service, licensed and insured. Back: Kody Glass, Owner, {SITE.phone}, kodyglassplumbing@gmail.com, licensed and insured, {SITE.licence.number}.</p>
    </div>

    <p class="bk-status" data-t="3"><span class="bk-live" aria-hidden="true"></span>Line open · 24/7</p>
    <div class="bk-btns">
      <Btn look="call" sub="Call now · 24/7" size="l" w={300} wm={350} t="3" />
      <Btn look="line" label="Text a photo" icon="camera" arrow size="l" w={240} wm={350} hm={56} t="3" />
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.bcall [data-bcard]').forEach((b) => {
    const label = b.querySelector<HTMLElement>('[data-bcard-label]')!;
    const stage = b.closest<HTMLElement>('.bk-stage')!;
    const hint = stage.querySelector<HTMLElement>('[data-bcard-hint]')!;
    stage.classList.add('is-js');
    b.addEventListener('click', () => {
      const on = b.getAttribute('aria-pressed') !== 'true';
      b.setAttribute('aria-pressed', String(on));
      label.textContent = on ? "Kody Glass's business card, back: Kody Glass, Owner. Turn it back" : "Kody Glass's business card, front. Turn it over";
      hint.textContent = on ? 'Tap again for the front' : 'Tap the card to turn it over';
    });
    // Tilt toward the pointer (fine pointers + motion only). The rect is read once on enter, never per frame.
    const tilt = stage.querySelector<HTMLElement>('[data-bk-tilt]')!;
    if (!document.documentElement.classList.contains('motion') || !matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    let r: DOMRect | null = null, raf = 0, px = 0, py = 0;
    const paint = () => { raf = 0; tilt.style.setProperty('--ry', `${(px - .5) * 14}deg`); tilt.style.setProperty('--rx', `${(.5 - py) * 10}deg`); tilt.style.setProperty('--gx', `${px * 100}%`); };
    tilt.addEventListener('pointerenter', () => { r = tilt.getBoundingClientRect(); tilt.classList.add('is-over'); });
    tilt.addEventListener('pointermove', (e) => { if (!r) return; px = (e.clientX - r.left) / r.width; py = (e.clientY - r.top) / r.height; if (!raf) raf = requestAnimationFrame(paint); });
    tilt.addEventListener('pointerleave', () => { r = null; tilt.classList.remove('is-over'); tilt.style.setProperty('--rx', '0deg'); tilt.style.setProperty('--ry', '0deg'); });
  });
</script>

<style>
  .bcall { position: relative; background: var(--white); padding: 112px 0 128px; }
  .bk-in { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .bk-head { display: flex; flex-direction: column; align-items: center; }
  .bk-head :global(.ah-eb) { justify-content: center; }
  .bk-lead { max-width: 520px; margin-top: 18px; font-size: 18px; line-height: 1.5; color: var(--ink); }

  /* The card, large and centred; the turn-over pill sits over its lower edge. */
  .bk-stage { position: relative; width: 520px; margin-top: 56px; padding-bottom: 46px; }
  .bk-tilt { --rx: 0deg; --ry: 0deg; --gx: 50%; position: relative; z-index: 2; perspective: 1600px; }
  .bk-card { position: relative; display: block; width: 100%; padding: 0; border: 0; background: none; cursor: pointer; rotate: -3deg; transition: rotate .6s var(--ease-io), translate .6s var(--ease-io); }
  .bk-tilt.is-over .bk-card { rotate: 0deg; translate: 0 -6px; }
  .bk-inner { position: relative; display: block; aspect-ratio: 1341 / 765; transform-style: preserve-3d; transform: rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform .8s var(--ease-io); }
  .bk-tilt.is-over .bk-inner { transition: transform .25s ease-out; }
  .bk-card[aria-pressed='true'] .bk-inner { transform: rotateX(var(--rx)) rotateY(calc(180deg + var(--ry))); }
  .bk-tilt.is-over .bk-card[aria-pressed='true'] .bk-inner, .bk-tilt.is-over .bk-card .bk-inner { transition: transform .8s var(--ease-io); }
  .bk-face { position: absolute; inset: 0; overflow: hidden; border-radius: 8px; background: var(--white); box-shadow: 12px 12px 0 var(--powder); backface-visibility: hidden; -webkit-backface-visibility: hidden; }
  .bk-face::after { content: ''; position: absolute; inset: 0; border: 2px solid var(--ink); border-radius: 8px; pointer-events: none;
    background: linear-gradient(105deg, transparent calc(var(--gx) - 30%), rgb(255 255 255 / .28) var(--gx), transparent calc(var(--gx) + 30%)); }
  /* The source photo holds the front (x 22-1363, y 30-795 of 1385 x 1628) above the back (y 847-1612): each face is a
     1341:765 window onto the same file, so both sides show whole (the logo is never cut). */
  .bk-face :global(picture) { display: contents; }
  .bk-face :global(img) { position: absolute; left: -1.641%; top: 0; width: 103.28%; height: auto; max-width: none; translate: 0 -1.843%; }
  .bk-back { transform: rotateY(180deg); }
  .bk-back :global(img) { translate: 0 -52.03%; }
  :global(html:not(.js)) .bk-card:hover .bk-inner { transform: rotateY(180deg); }
  .bk-card:focus-visible { outline: 3px solid var(--pdeep); outline-offset: 8px; border-radius: 10px; }
  .bk-hint { position: absolute; left: 50%; bottom: 26px; z-index: 3; display: inline-flex; align-items: center; gap: 6px; min-height: 30px; padding: 0 14px; translate: -50% 0; border-radius: 15px;
    background: var(--ink); color: var(--white); font-family: var(--f-m); font-weight: 700; font-size: 10px; letter-spacing: .06em; text-transform: uppercase; white-space: nowrap; }
  .bk-stage:not(.is-js) .bk-hint { display: none; }

  .bk-status { display: inline-flex; align-items: center; gap: 10px; height: 36px; margin-top: 48px; padding: 0 16px; border: 1.5px solid var(--ink); border-radius: 18px; font-family: var(--f-m); font-weight: 700; font-size: 11px; line-height: 15px; letter-spacing: .06em; text-transform: uppercase; color: var(--ink); }
  .bk-live { width: 12px; height: 12px; border-radius: 50%; background: var(--pdeep); box-shadow: 0 0 0 3px var(--powder); }
  .bk-btns { display: flex; justify-content: center; gap: 16px; margin-top: 22px; }
  @media (prefers-reduced-motion: reduce) { .bk-inner, .bk-card { transition: none; } }
  :global(html:not(.motion)) .bk-inner { transition: none; }

  @media (min-width: 768px) and (max-width: 1279px) { .bk-stage { width: min(480px, 70vw); } }
  @media (max-width: 767px) {
    .bcall { padding: 64px 0 88px; }
    .bk-lead { margin-top: 12px; font-size: 16px; }
    .bk-stage { width: min(300px, 100% - 40px); margin-top: 36px; padding-bottom: 36px; }
    .bk-card { rotate: -2deg; }
    .bk-face { box-shadow: 7px 7px 0 var(--powder); }
    .bk-status { margin-top: 40px; }
    .bk-btns { flex-direction: column; align-items: stretch; width: 100%; max-width: 350px; gap: 14px; }
  }
</style>
