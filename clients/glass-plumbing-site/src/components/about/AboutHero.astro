---
// /about hero (Figma 724:746 y 172 h 740 / mobile 725:439 y 158 h 932). White. Eyebrow, H1 (= SEO H1), lead, the call
// button, the crew photo (no names on faces: the alt says "a crew member") and Kody's business card.
// R2 (Nick 20 Nov): the photo sat 120 px short of the grid's right edge with the face low in the frame -> the photo now
// ends on the grid edge and its focal point is the face (52% 80% of the portrait file). The business card used to be a
// cover crop of the two-sided photo (front + back stacked), which cut the logo in half -> it is now a real two-sided card:
// the front shows the whole logo, a tap flips it to "Kody Glass, Owner" (21st.dev skyleen77/flip-card, re-skinned).
// Fix round 3 (D, RECHECK BLOCKER 1b): at 390 the flip card ("Kody Glass, Owner") still stacked right above the single
// face. The card now lives in the page's last section (AboutCall, "Keep the card"), far from any face at every width; the
// hero keeps the centred photo (Nick's fix) and gets the licence line beside the call button instead. Earlier (fix B): the H1 no longer says "Glass Brothers" (that phrase is only used inside David Peek's quoted review). Visible breadcrumbs are gone site-wide (Nick):
// Breadcrumbs stays for its BreadcrumbList JSON-LD and its nav is hidden here.
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import Eyebrow from '../kit/Eyebrow.astro';
import Btn from '../kit/Btn.astro';
import Img from '../ui/Img.astro';
import { SITE } from '../../data/site';
---
<section class="bhero" data-m-section data-m-hero aria-labelledby="bhero-h">
  <div class="wrap bh-grid">
    <div class="bh-copy">
      <Breadcrumbs items={[{ label: 'About', href: '/about' }]} class="bh-crumbs" t={false} />
      <Eyebrow text="Glass Plumbing Services · Largo, FL" t="1" class="bh-eb bh-eb--d" />
      <Eyebrow text="Glass Plumbing Services · Largo" t="1" class="bh-eb bh-eb--m" />
      <h1 id="bhero-h" class="bh-h" data-t="2">Meet the crew<br /><span class="tone">behind the van.</span></h1>
      <p class="bh-lead" data-t="3" data-fx="nudge"><span class="d">A Florida-licensed plumbing contractor and his crew, fixing homes and businesses across Pinellas County from Largo.</span><span class="m">A Florida-licensed plumbing contractor and his crew, fixing homes and businesses across Pinellas from Largo.</span></p>
      <div class="bh-act">
        <div class="bh-btn"><Btn look="call" sub="Call or text · 24/7" size="l" w={320} wm={350} t="3" /></div>
        <p class="bh-lic" data-t="4">Florida licence {SITE.licence.number} · active on DBPR</p>
      </div>
    </div>
    <div class="bh-media">
      <figure class="bh-photo" data-t="4" data-fx="frame">
        <Img name="crew-selfie" alt="A Glass Plumbing crew member in a cap and sunglasses, taking a selfie in the work van" priority focus="52% 80%"
          sizes="(min-width:1280px) 460px, (min-width:768px) 38vw, 280px" box={460 / 560} boxM={280 / 340} widths={[280, 460, 560, 920]} />
      </figure>
    </div>
  </div>
</section>

<style>
  .bhero { position: relative; background: var(--white); padding: 72px 0 84px; }
  .bhero :global(.bh-crumbs) { display: none; }
  .bh-grid { display: grid; grid-template-columns: minmax(0, 640px) 460px; justify-content: space-between; align-items: center; }
  .bhero :global(.bh-eb) { margin-top: 0; }
  .bhero :global(.bh-eb--m) { display: none; }
  .bh-h { margin-top: 16px; font-family: var(--f-h); font-weight: 800; font-size: 88px; line-height: .96; letter-spacing: -.02em; color: var(--ink); white-space: nowrap; }
  .bh-h .tone { color: var(--pdeep); }
  .bh-lead { margin-top: 24px; max-width: 560px; font-size: 19px; line-height: 1.5; color: var(--ink); }
  .bh-act { display: flex; align-items: center; gap: 44px; margin-top: 36px; }
  .bh-media { position: relative; width: 460px; }
  .bh-photo { position: relative; margin: 0; width: 460px; height: 560px; border-radius: 6px; box-shadow: 12px 12px 0 var(--powder); }
  .bh-photo :global(picture), .bh-photo :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; border-radius: 6px; }
  .bh-photo::after { content: ''; position: absolute; inset: 0; border: 2px solid var(--ink); border-radius: 6px; pointer-events: none; }

  .bh-lic { font-family: var(--f-m); font-weight: 700; font-size: 12px; line-height: 1.5; letter-spacing: .04em; text-transform: uppercase; color: var(--ink); max-width: 220px; }
  .m { display: none; }

  @media (min-width: 768px) and (max-width: 1279px) {
    .bh-grid { grid-template-columns: minmax(0, 1fr) minmax(0, .72fr); column-gap: 48px; }
    .bh-h { font-size: clamp(52px, 6.6vw, 88px); white-space: normal; }
    .bh-media { width: 100%; }
    .bh-photo { width: 100%; height: auto; aspect-ratio: 460 / 560; }
    .bh-act { flex-direction: column; align-items: flex-start; gap: 36px; }
  }
  @media (max-width: 767px) {
    .bhero { padding: 32px 0 88px; }
    .bh-grid { display: flex; flex-direction: column; align-items: stretch; }
    .bhero :global(.bh-eb--d) { display: none; }
    .bhero :global(.bh-eb--m) { display: flex; }
    .bh-h { margin-top: 10px; font-size: 44px; line-height: 1.02; white-space: normal; }
    .bh-lead { margin-top: 14px; font-size: 16px; }
    .bh-act { flex-direction: column; align-items: stretch; gap: 32px; margin-top: 28px; }
    .d { display: none; } .m { display: inline; }
    .bh-media { align-self: center; width: 280px; margin-top: 44px; }
    .bh-photo { width: 280px; height: 340px; box-shadow: 8px 8px 0 var(--powder); }
    .bh-lic { max-width: none; text-align: center; }
  }
</style>
