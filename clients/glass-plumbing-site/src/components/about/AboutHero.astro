---
// /about hero, R4 (independent re-check R3 MAJOR 4: text left / photo right with nothing to touch, rules 14 + 15; Nick R2
// point 8: centre the photo). New idea, THE WINDOW OPENS: one centred column. Eyebrow, H1 (= SEO H1), lead, the call
// button and the licence line sit centred on top; under them the crew photo is centred and first seen through a narrow
// pill-shaped window, the shape of a filter-housing glass. As you scroll, the window opens to the whole photo (kit scrub
// data-scrub-ft scrubs one custom property, --o, from 1 to 0, which drives the clip-path inset and radius), and the
// powder offset shadow follows the window's shape (drop-shadow on the frame). No name anywhere in the section: the only
// face on screen is never beside a name (the alt says "a crew member").
// 21st.dev: "Scroll media expansion hero" (@arunachalam, id 1932: media expands as you scroll) + "Video Scroll Hero"
// (@isaiahbjork, id 7512: centred media scales up with the scroll), rebuilt on the kit scrub engine, no React, re-skinned
// as the Glass housing window.
// Nearest match: Glass AboutRecord / home Hero (photo housings with plates, static), Glass reviews TownReview (photo seen
// through letters), Mike about AHero (logo in hex halos + polaroid), Khinda city Owner (layers shift toward the pointer).
// None opens a window onto the photo with the scroll.
// No JS / reduced motion: the window is fully open.
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import Eyebrow from '../kit/Eyebrow.astro';
import Btn from '../kit/Btn.astro';
import Img from '../ui/Img.astro';
import { SITE } from '../../data/site';
---
<section class="bhero" data-m-section data-m-hero aria-labelledby="bhero-h">
  <div class="wrap bh-in">
    <Breadcrumbs items={[{ label: 'About', href: '/about' }]} class="bh-crumbs" t={false} />
    <Eyebrow text="Glass Plumbing Services · Largo, FL" t="1" class="bh-eb" />
    <h1 id="bhero-h" class="bh-h" data-t="2">Meet the crew <span class="tone">behind the van.</span></h1>
    <p class="bh-lead" data-t="3" data-fx="nudge">A Florida-licensed plumbing contractor and his crew, fixing homes and businesses across Pinellas County from Largo.</p>
    <div class="bh-act">
      <Btn look="call" sub="Call or text · 24/7" size="l" w={320} wm={350} t="3" />
      <p class="bh-lic" data-t="4">Florida licence {SITE.licence.number} · active on DBPR</p>
    </div>
    <figure class="bh-fig" data-scrub data-start="top 72%" data-end="top 12%" data-start-m="top 88%" data-end-m="top 22%" data-lag="0.4">
      <div class="bh-fr" data-scrub-ft='{"from":{"--o":1},"to":{"--o":0}}'>
        <div class="bh-win">
          <Img name="crew-selfie" alt="A Glass Plumbing crew member in a cap and sunglasses, taking a selfie in the work van" priority focus="50% 62%"
            sizes="(min-width:768px) 520px, 320px" box={520 / 640} boxM={320 / 400} widths={[320, 520, 640, 1040]} />
        </div>
      </div>
    </figure>
  </div>
</section>

<style>
  .bhero { position: relative; background: var(--white); padding: 64px 0 96px; }
  .bhero :global(.bh-crumbs) { display: none; }
  .bh-in { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .bhero :global(.bh-eb) { margin-top: 0; justify-content: center; }
  .bh-h { margin-top: 16px; font-family: var(--f-h); font-weight: 800; font-size: 88px; line-height: .98; letter-spacing: -.02em; color: var(--ink); }
  .bh-h .tone { display: block; color: var(--pdeep); }
  .bh-lead { margin-top: 22px; max-width: 620px; font-size: 19px; line-height: 1.5; color: var(--ink); }
  .bh-act { display: flex; flex-direction: column; align-items: center; gap: 14px; margin-top: 32px; }
  .bh-lic { font-family: var(--f-m); font-weight: 700; font-size: 12px; line-height: 1.5; letter-spacing: .04em; text-transform: uppercase; color: var(--ink); }

  /* The window: --o = 1 a narrow housing-glass pill, 0 the whole photo. Static CSS = open; html.motion starts closed. */
  .bh-fig { margin: 52px 0 0; }
  .bh-fr { --o: 0; filter: drop-shadow(2px 0 0 var(--ink)) drop-shadow(-2px 0 0 var(--ink)) drop-shadow(0 2px 0 var(--ink)) drop-shadow(0 -2px 0 var(--ink)) drop-shadow(12px 12px 0 var(--powder)); }
  :global(html.motion) .bh-fr { --o: 1; }
  .bh-win { position: relative; width: 520px; height: 640px; overflow: hidden;
    clip-path: inset(calc(var(--o) * 4%) calc(var(--o) * 25%) round calc(var(--o) * 240px + 8px)); }
  .bh-win :global(picture), .bh-win :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; }

  @media (min-width: 768px) and (max-width: 1279px) {
    .bh-h { font-size: clamp(56px, 7vw, 88px); }
  }
  @media (max-width: 767px) {
    .bhero { padding: 32px 0 72px; }
    .bh-h { margin-top: 10px; font-size: 44px; line-height: 1.02; }
    .bh-lead { margin-top: 14px; font-size: 16px; }
    .bh-act { align-self: stretch; margin-top: 26px; }
    .bh-act > :global(*) { width: 100%; max-width: 350px; }
    .bh-fig { margin-top: 36px; }
    .bh-fr { filter: drop-shadow(1.5px 0 0 var(--ink)) drop-shadow(-1.5px 0 0 var(--ink)) drop-shadow(0 1.5px 0 var(--ink)) drop-shadow(0 -1.5px 0 var(--ink)) drop-shadow(7px 7px 0 var(--powder)); }
    .bh-win { width: min(320px, calc(100vw - 56px)); height: 400px; clip-path: inset(calc(var(--o) * 4%) calc(var(--o) * 20%) round calc(var(--o) * 150px + 6px)); }
  }
</style>
