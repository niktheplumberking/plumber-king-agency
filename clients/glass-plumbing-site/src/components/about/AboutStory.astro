---
// /about "Story / On the record" (Figma y 913 h 800 / mobile y 1090 h 604). Frost. Head + intro (desktop), and a
// five-step record with dots (four filled, the last hollow). Copy from the frames; the two Google counts are named side by
// side (two profiles), never summed: Figma's "104 + 77" is written "104 and 77" so it cannot read as a total.
import Head from '../areas/Head.astro';
import { SITE } from '../../data/site';
const g = SITE.google;
const items = [
  { t: 'Licence', d: `Florida Certified Plumbing Contractor, ${SITE.licence.number}. Active on DBPR, expires ${SITE.licence.expires}.`, m: `${SITE.licence.number}. Active on DBPR, expires ${SITE.licence.expires}.` },
  { t: 'Up and running', d: '“Officially up and running as a Licensed and insured master plumber.” Kody, on Instagram.', m: '“Officially up and running as a Licensed and insured master plumber.” Kody' },
  { t: 'On Instagram', d: `${SITE.social.instagramHandle}, verified, 34 posts of real jobs.`, m: `${SITE.social.instagramHandle}, verified, 34 posts.` },
  { t: 'Today', d: `5.0 on Google from ${g.a.count} and ${g.b.count} reviews on two profiles (read ${g.checked}).`, m: `5.0 on Google from ${g.a.count} and ${g.b.count} reviews on two profiles (${g.checked}).` },
  { t: 'Licence holders', d: 'Glass, Dakota K and Glass Plumbing Services LLC, on DBPR.', m: 'Glass, Dakota K + Glass Plumbing Services LLC (DBPR).' },
];
---
<section class="bstory" data-m-section aria-labelledby="bstory-h">
  <div class="wrap bs-grid">
    <div>
      <Head eyebrow="On the record" l1="What you can check," l2="before you call." id="bstory-h" />
      <p class="bs-p" data-t="3">Kody holds Florida licence {SITE.licence.number} and runs Glass Plumbing Services from Largo. The brothers and their crew handle homes, rentals and commercial build-outs, as their reviews say.</p>
    </div>
    <ol class="bs-list" role="list" data-t="4" data-stagger>
      {items.map((it, i) => (
        <li class:list={['bs-it', i === items.length - 1 && 'is-open']}>
          <span class="bs-dot" aria-hidden="true"></span>
          <h3 class="bs-t">{it.t}</h3>
          <p class="bs-d"><span class="d">{it.d}</span><span class="m">{it.m}</span></p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .bstory { position: relative; background: var(--frost); padding: 110px 0 90px; }
  .bs-grid { display: grid; grid-template-columns: 560px 548px; justify-content: space-between; align-items: start; }
  .bs-p { margin-top: 42px; max-width: 500px; font-size: 17px; line-height: 1.5; color: var(--ink); }
  .bs-it { position: relative; height: 120px; padding-left: 48px; }
  .bs-dot { position: absolute; left: 0; top: 2px; width: 24px; height: 24px; border-radius: 50%; background: var(--pdeep); border: 3px solid var(--pdeep); }
  .is-open .bs-dot { background: var(--white); }
  .bs-t { font-family: var(--f-h); font-weight: 800; font-size: 22px; line-height: 1.04; letter-spacing: -.02em; color: var(--ink); }
  .bs-d { margin-top: 9px; max-width: 500px; font-size: 15px; line-height: 1.5; color: var(--muted); }
  .m { display: none; }
  @media (min-width: 768px) and (max-width: 1279px) {
    .bs-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 40px; }
    .bs-it { height: auto; padding-bottom: 32px; }
  }
  @media (max-width: 767px) {
    .bstory { padding: 48px 0 41px; }
    .bs-grid { display: block; }
    .bs-p { display: none; }
    .bs-list { margin-top: 24px; }
    .bs-it { height: auto; padding-left: 36px; }
    .bs-it + .bs-it { margin-top: 22px; }
    .bs-dot { top: 2px; width: 20px; height: 20px; }
    .bs-t { font-size: 17px; }
    .bs-d { margin-top: 8px; font-size: 14px; }
    .d { display: none; } .m { display: inline; }
  }
</style>
