---
// /areas CTA "Town not listed?" (Figma 721:525 y 5503 h 677 / mobile y 5156 h 657). Ink, meniscus seam rising over the
// white FAQ. INTERACTION note: live town checker. Type a town: it matches against the Pinellas County town list
// (towns.ts) and answers "Yes, we cover it" with a check, or "Call and ask" for anywhere else. Enter submits nothing; it
// only answers. Built as an ARIA 1.2 combobox (input + listbox of matching towns) with a polite live result.
import Head from './Head.astro';
import Btn from '../kit/Btn.astro';
import Plate from '../kit/Plate.astro';
import Seam from '../kit/Seam.astro';
import { TOWNS } from '../../data/towns';
import { SITE } from '../../data/site';
const names = TOWNS.map((t) => t.name).sort((a, b) => a.localeCompare(b));
const start = 'Oldsmar';
---
<section class="acheck on-ink" data-m-section aria-labelledby="acheck-h">
  <Seam from="var(--white)" to="var(--ink)" flip />
  <div class="wrap acheck-grid">
    <div class="acheck-copy">
      <Head eyebrow="Town not listed?" l1="Type your town." l2="We’ll tell you straight." size={56} sizeM={36} dark id="acheck-h" />
      <div class="tc" data-town-check data-towns={JSON.stringify(names)} data-t="4">
        <label class="sr-only" for="tc-in">Your town</label>
        <div class="tc-box">
          <svg class="tc-ring" viewBox="0 0 18 18" width="18" height="18" aria-hidden="true"><circle cx="9" cy="9" r="8" fill="none" stroke="currentColor" stroke-width="2" /></svg>
          <input id="tc-in" class="tc-in" type="text" value={start} placeholder="Type your town" autocomplete="off" autocapitalize="words" spellcheck="false"
            role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="tc-list" aria-describedby="tc-res" enterkeyhint="done" />
          <ul class="tc-list" id="tc-list" role="listbox" aria-label="Towns we cover" hidden></ul>
        </div>
        <div class="tc-res is-yes" id="tc-res" role="status" aria-live="polite" aria-atomic="true">
          <span class="tc-ic" aria-hidden="true">
            <svg class="tc-ic-yes" viewBox="0 0 15 11" width="15" height="11"><path d="M1.1 5.1l4 4 8-8" fill="none" stroke="#16130F" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <svg class="tc-ic-ask" viewBox="0 0 24 24" width="14" height="14"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.18 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.1 9.9a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" fill="none" stroke="#16130F" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
          <span class="tc-txt" data-tc-txt>{start} is in Pinellas County. Yes, we cover it.</span>
        </div>
      </div>
    </div>
    <div class="acheck-side">
      <div class="acheck-plate" data-t="4"><Plate title="Service area" rows={[['Base', 'Largo, FL'], ['Covers', 'All of Pinellas County'], ['Across the bay', 'Call and ask'], ['Hours', '24/7 for emergencies']]} w={560} pad={18} size={12} tsize={12} kx={150} pitch={22} tone="ink" shadow="powder" /></div>
      <div class="acheck-btns">
        <Btn look="call" sub="Call now · 24/7" size="l" w={300} wm={350} class="acheck-call" t="3" />
        <Btn look="line" label="Text a photo" icon="camera" arrow size="l" w={244} wm={350} hm={56} class="acheck-text" t="3" />
      </div>
    </div>
  </div>
</section>

<script>
  // Live town checker (combobox). Answers as you type; Enter only picks the highlighted town, never submits anything.
  const norm = (s: string) => s.toLowerCase().normalize('NFKD').replace(/[̀-ͯ]/g, '').replace(/\./g, '').replace(/,?\s*(fl|florida)$/, '')
    .replace(/\bsaint\b/g, 'st').replace(/\s+/g, ' ').trim();
  const ALIAS: Record<string, string> = { 'st pete': 'St. Petersburg', stpete: 'St. Petersburg', 'st petersburg': 'St. Petersburg', 'st pete beach': 'St. Pete Beach' };
  document.querySelectorAll<HTMLElement>('[data-town-check]').forEach((root) => {
    const towns: string[] = JSON.parse(root.dataset.towns || '[]');
    const input = root.querySelector<HTMLInputElement>('input[role="combobox"]')!;
    const list = root.querySelector<HTMLUListElement>('[role="listbox"]')!;
    const res = root.querySelector<HTMLElement>('.tc-res')!;
    const txt = root.querySelector<HTMLElement>('[data-tc-txt]')!;
    let options: string[] = [];
    let active = -1;
    const exact = (v: string) => { const n = norm(v); return towns.find((t) => norm(t) === n) || ALIAS[n] || null; };
    const matches = (v: string) => {
      const n = norm(v); if (!n) return [];
      return towns.filter((t) => { const tn = norm(t); return tn.startsWith(n) || tn.split(' ').some((w) => w.startsWith(n)); }).slice(0, 6);
    };
    const say = (state: 'yes' | 'ask' | 'idle' | 'more', text: string) => {
      if (txt.textContent === text && res.classList.contains(`is-${state}`)) return;
      res.classList.add('is-swap');
      window.setTimeout(() => {
        res.classList.remove('is-yes', 'is-ask', 'is-idle', 'is-more'); res.classList.add(`is-${state}`);
        txt.textContent = text; res.classList.remove('is-swap');
      }, document.documentElement.classList.contains('motion') ? 160 : 0);
    };
    const answer = () => {
      const v = input.value.trim();
      const hit = exact(v);
      if (!v) say('idle', 'Type a town in Pinellas County and we answer here.');
      else if (hit) say('yes', `${hit} is in Pinellas County. Yes, we cover it.`);
      else if (matches(v).length) say('more', 'Keep typing, or pick your town from the list.');
      else say('ask', `${v} is not on our Pinellas list. Call and ask: ${'(727) 512-0673'}.`);
    };
    const close = () => { list.hidden = true; input.setAttribute('aria-expanded', 'false'); input.removeAttribute('aria-activedescendant'); active = -1; };
    const paint = () => {
      list.querySelectorAll('[role="option"]').forEach((o, i) => o.setAttribute('aria-selected', String(i === active)));
      if (active >= 0) input.setAttribute('aria-activedescendant', `tc-opt-${active}`); else input.removeAttribute('aria-activedescendant');
    };
    const open = () => {
      const v = input.value;
      options = matches(v).filter((t) => norm(t) !== norm(v));
      list.replaceChildren(...options.map((t, i) => { const li = document.createElement('li'); li.id = `tc-opt-${i}`; li.setAttribute('role', 'option'); li.textContent = t; return li; }));
      active = -1;
      if (!options.length) { close(); return; }
      list.hidden = false; input.setAttribute('aria-expanded', 'true'); paint();
    };
    const pick = (t: string) => { input.value = t; close(); answer(); };
    input.addEventListener('input', () => { open(); answer(); });
    input.addEventListener('focus', () => { if (input.value && !exact(input.value)) open(); });
    input.addEventListener('blur', () => window.setTimeout(close, 120));
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        if (list.hidden) open();
        if (!options.length) return;
        e.preventDefault();
        active = e.key === 'ArrowDown' ? (active + 1) % options.length : (active <= 0 ? options.length - 1 : active - 1);
        paint();
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (!list.hidden && active >= 0) pick(options[active]); else { close(); answer(); }
      } else if (e.key === 'Escape') {
        if (!list.hidden) { e.preventDefault(); close(); }
      }
    });
    list.addEventListener('pointerdown', (e) => e.preventDefault());
    list.addEventListener('click', (e) => { const o = (e.target as HTMLElement).closest('[role="option"]'); if (o) pick(o.textContent || ''); });
  });
</script>

<style>
  .acheck { position: relative; background: var(--ink); color: var(--white); padding: 120px 0 162px; }
  .acheck-grid { display: grid; grid-template-columns: 560px 560px; justify-content: space-between; align-items: start; }
  .acheck-side { padding-top: 20px; }

  .tc { margin-top: 44px; }
  .tc-box { position: relative; display: flex; align-items: center; gap: 14px; height: 64px; padding: 0 20px; background: var(--white); border-radius: 4px; box-shadow: 6px 6px 0 var(--powder); color: var(--ink); }
  .tc-box:focus-within { outline: 3px solid var(--powder); outline-offset: 3px; }
  .tc-ring { flex: none; }
  .tc-in { flex: 1; min-width: 0; height: 100%; padding: 0; background: none; border: 0; font-weight: 600; font-size: 18px; line-height: 27px; color: var(--ink); caret-color: var(--pdeep); }
  .tc-in::placeholder { color: var(--muted); opacity: 1; font-weight: 400; }
  .tc-in:focus, .tc-in:focus-visible { outline: none; }
  .tc-list { position: absolute; z-index: 6; left: 0; right: 0; top: calc(100% + 8px); margin: 0; padding: 6px; list-style: none; background: var(--white); border: 1px solid var(--frost3); border-radius: 4px; box-shadow: 6px 6px 0 var(--ink3); }
  .tc-list :global([role='option']) { display: flex; align-items: center; min-height: 44px; padding: 0 14px; border-radius: 3px; font-weight: 600; font-size: 16px; color: var(--ink); cursor: pointer; transition: background-color .3s var(--ease-io); }
  .tc-list :global([role='option']:hover), .tc-list :global([role='option'][aria-selected='true']) { background: var(--frost); }

  .tc-res { display: flex; align-items: center; gap: 14px; min-height: 64px; margin-top: 20px; padding: 10px 18px; background: var(--ink2); border: 1px solid var(--ink3); border-radius: 4px; transition: opacity .16s var(--ease-io); }
  .tc-res.is-swap { opacity: 0; }
  .tc-ic { display: grid; place-items: center; flex: none; width: 24px; height: 24px; border-radius: 50%; background: var(--powder); transition: background-color .4s var(--ease-io); }
  .tc-ic svg { display: none; }
  .is-yes .tc-ic-yes, .is-ask .tc-ic-ask { display: block; }
  .is-ask .tc-ic { background: var(--steel); }
  .is-idle .tc-ic, .is-more .tc-ic { background: transparent; box-shadow: inset 0 0 0 2px var(--ink3); }
  .tc-txt { font-weight: 600; font-size: 16px; line-height: 24px; color: var(--white); }

  .acheck-btns { display: flex; gap: 16px; margin-top: 132px; }

  @media (min-width: 768px) and (max-width: 1279px) {
    .acheck { padding: 112px 0 120px; }
    .acheck-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 40px; }
    .acheck-btns { flex-wrap: wrap; margin-top: 48px; }
  }
  @media (max-width: 767px) {
    .acheck { padding: 80px 0 100px; }
    .acheck-grid { display: block; }
    .tc { margin-top: 28px; }
    .tc-box { height: 56px; padding: 0 16px; gap: 12px; box-shadow: 5px 5px 0 var(--powder); }
    .tc-in { font-size: 17px; }
    .tc-res { min-height: 72px; margin-top: 16px; padding: 12px 16px; align-items: flex-start; }
    .tc-ic { margin-top: 0; }
    .tc-txt { font-size: 15px; line-height: 23px; }
    .acheck-side { padding-top: 34px; }
    .acheck-plate { display: none; }
    .acheck-btns { flex-direction: column; gap: 16px; margin-top: 0; }
  }
</style>
