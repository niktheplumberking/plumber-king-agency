---
// /areas "As the crow flies" (R2 rebuild: the R1 text-left / five tubes-right was rule-14 slop). Ink2. Centred head, then
// one long water tube (the Glass housing, lying down) marked with a tick for each of the 20 towns in towns.ts at its
// straight-line distance from Largo (Census points, NOT driving miles). A real range input (21st.dev
// halaska-studio/slider: live readout + a thumb that grows while held) sets how far the water runs; every town inside
// the radius lights up in the list below and the readout counts them. On enter the water runs out to 8 mi once (1.4 s,
// ease-in-out) so the section answers before anyone touches it. Reduced motion / no JS: set at 8 mi, all static.
import Head from './Head.astro';
import { TOWNS } from '../../data/towns';
const MAX = 16;
const START = 8;
const towns = [...TOWNS].sort((a, b) => a.mi - b.mi);
const inside = towns.filter((t) => t.mi <= START).length;
---
<section class="adist on-ink" data-m-section aria-labelledby="adist-h">
  <div class="wrap">
    <div class="ad-head">
      <Head eyebrow="As the crow flies" l1="Largo sits in the" l2="middle of Pinellas." dark size={56} sizeM={32} id="adist-h" />
      <p class="ad-lead" data-t="3">Drag the water out from our Largo base and see which towns it reaches. Straight-line miles on Census map points: not driving miles, and not a promise of arrival time.</p>
    </div>

    <div class="ad-dial" data-dial data-t="4" style={`--v:${START / MAX}`}>
      <p class="ad-read" aria-hidden="true"><b data-dial-mi>{START.toFixed(1)}</b> mi from Largo · <b data-dial-n>{inside}</b> of {towns.length} towns</p>
      <div class="ad-track">
        <span class="ad-tube" aria-hidden="true"><span class="ad-water"><span class="ad-shine"></span></span></span>
        <span class="ad-ticks" aria-hidden="true">
          {towns.map((t) => <i style={`left:calc(22px + ${(t.mi / MAX).toFixed(4)} * (100% - 44px))`} data-tick={t.slug}></i>)}
        </span>
        <span class="ad-base" aria-hidden="true">Largo</span>
        <label class="sr-only" for="ad-range">Distance from our Largo base, in miles</label>
        <input id="ad-range" class="ad-range" type="range" min="0" max={MAX} step="0.1" value={START} data-dial-input aria-valuetext={`${START} miles: ${inside} towns`} />
      </div>
      <p class="ad-scale" aria-hidden="true"><span>0 mi</span><span>4</span><span>8</span><span>12</span><span>16 mi</span></p>
      <ul class="ad-towns" role="list" aria-label="Towns by straight-line distance from Largo">
        {towns.map((t) => (
          <li class:list={['ad-t', t.mi <= START && 'is-in']} data-dial-town={t.mi}>
            <span class="ad-tn">{t.name}</span><span class="ad-tm">{t.mi} mi</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  import { onEnter, motionOn } from './inview';
  document.querySelectorAll<HTMLElement>('[data-dial]').forEach((dial) => {
    const input = dial.querySelector<HTMLInputElement>('[data-dial-input]')!;
    const miEl = dial.querySelector<HTMLElement>('[data-dial-mi]')!;
    const nEl = dial.querySelector<HTMLElement>('[data-dial-n]')!;
    const items = [...dial.querySelectorAll<HTMLElement>('[data-dial-town]')];
    const max = parseFloat(input.max);
    const set = (v: number) => {
      dial.style.setProperty('--v', String(v / max));
      let n = 0;
      items.forEach((it) => { const on = parseFloat(it.dataset.dialTown!) <= v; it.classList.toggle('is-in', on); if (on) n++; });
      miEl.textContent = v.toFixed(1);
      nEl.textContent = String(n);
      input.setAttribute('aria-valuetext', `${v.toFixed(1)} miles: ${n} towns`);
    };
    input.addEventListener('input', () => { dial.classList.add('is-user'); set(parseFloat(input.value)); });
    const end = parseFloat(input.value);
    if (!motionOn()) { set(end); return; }
    set(0); input.value = '0';
    onEnter(dial, () => {
      if (dial.classList.contains('is-user')) return;
      const t0 = performance.now(), dur = 1400;
      const ease = (x: number) => (x < .5 ? 2 * x * x : 1 - Math.pow(-2 * x + 2, 2) / 2);
      const step = (now: number) => {
        if (dial.classList.contains('is-user')) return;
        const k = Math.min(1, (now - t0) / dur);
        const v = Math.round(end * ease(k) * 10) / 10;
        input.value = String(v); set(v);
        if (k < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }, '0px 0px -25% 0px');
  });
</script>

<style>
  .adist { position: relative; background: var(--ink2); color: var(--white); padding: 120px 0 110px; }
  .ad-head { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .ad-head :global(.ah-eb) { justify-content: center; }
  .ad-lead { max-width: 620px; margin-top: 18px; font-size: 17px; line-height: 1.5; color: rgb(255 255 255 / .88); }
  .ad-dial { margin-top: 56px; }
  .ad-read { text-align: center; font-family: var(--f-m); font-weight: 500; font-size: 13px; letter-spacing: .04em; color: var(--powder); }
  .ad-read b { font-family: var(--f-h); font-weight: 800; font-size: 40px; letter-spacing: -.02em; color: var(--white); vertical-align: -6px; }
  .ad-track { position: relative; height: 64px; margin-top: 26px; }
  .ad-tube { position: absolute; inset: 8px 0; background: var(--ink); border: 2px solid var(--steel2); border-radius: 26px; overflow: hidden; }
  .ad-water { position: absolute; inset: 0 auto 0 0; width: calc(22px + var(--v) * (100% - 44px)); background: var(--powder); border-radius: 0 22px 22px 0; }
  .ad-shine { position: absolute; left: 14px; right: 14px; top: 7px; height: 4px; border-radius: 2px; background: rgb(255 255 255 / .55); }
  .ad-ticks { position: absolute; inset: 8px 0; pointer-events: none; }
  .ad-ticks i { position: absolute; top: 50%; width: 2px; height: 22px; margin: -11px 0 0 -1px; background: var(--white); opacity: .55; border-radius: 1px; }
  .ad-base { position: absolute; left: 0; top: -22px; font-family: var(--f-m); font-weight: 700; font-size: 10px; letter-spacing: .06em; text-transform: uppercase; color: var(--powder); }
  .ad-range { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; background: transparent; -webkit-appearance: none; appearance: none; cursor: grab; }
  .ad-range:active { cursor: grabbing; }
  .ad-range::-webkit-slider-runnable-track { height: 64px; background: transparent; }
  .ad-range::-moz-range-track { height: 64px; background: transparent; }
  .ad-range::-webkit-slider-thumb { -webkit-appearance: none; width: 44px; height: 44px; margin-top: 10px; border-radius: 50%; background: var(--white); border: 3px solid var(--ink); box-shadow: 0 0 0 4px var(--powder), 4px 4px 0 var(--pdeep); transition: scale .3s var(--ease-io); }
  .ad-range::-moz-range-thumb { width: 38px; height: 38px; border-radius: 50%; background: var(--white); border: 3px solid var(--ink); box-shadow: 0 0 0 4px var(--powder), 4px 4px 0 var(--pdeep); }
  .ad-range:active::-webkit-slider-thumb { scale: 1.12; }
  .ad-range:focus-visible { outline: none; }
  .ad-range:focus-visible::-webkit-slider-thumb { box-shadow: 0 0 0 4px var(--white), 0 0 0 7px var(--pdeep); }
  .ad-range:focus-visible::-moz-range-thumb { box-shadow: 0 0 0 4px var(--white), 0 0 0 7px var(--pdeep); }
  .ad-scale { display: flex; justify-content: space-between; margin-top: 8px; font-family: var(--f-m); font-weight: 500; font-size: 10px; letter-spacing: .04em; color: rgb(255 255 255 / .7); }
  .ad-towns { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 40px; }
  .ad-t { display: inline-flex; align-items: baseline; gap: 8px; min-height: 40px; padding: 10px 14px; border-radius: 20px; box-shadow: inset 0 0 0 1.5px var(--ink3); color: rgb(255 255 255 / .62);
    transition: background-color .45s var(--ease-io), color .45s var(--ease-io), box-shadow .45s var(--ease-io); }
  .ad-tn { font-weight: 700; font-size: 14px; line-height: 1.2; }
  .ad-tm { font-family: var(--f-m); font-weight: 500; font-size: 10px; }
  .ad-t.is-in { background: var(--powder); color: var(--ink); box-shadow: inset 0 0 0 1.5px var(--powder); }
  @media (prefers-reduced-motion: reduce) { .ad-t, .ad-range::-webkit-slider-thumb { transition: none; } }

  @media (max-width: 767px) {
    .adist { padding: 56px 0 64px; }
    .ad-lead { margin-top: 12px; font-size: 14px; }
    .ad-dial { margin-top: 32px; }
    .ad-read { font-size: 11px; }
    .ad-read b { font-size: 28px; vertical-align: -3px; }
    .ad-track { height: 56px; margin-top: 30px; }
    .ad-range::-webkit-slider-runnable-track { height: 56px; }
    .ad-range::-webkit-slider-thumb { margin-top: 6px; }
    .ad-ticks i { height: 16px; margin-top: -8px; }
    .ad-towns { gap: 8px; margin-top: 28px; }
    .ad-t { padding: 8px 12px; }
    .ad-tn { font-size: 13px; }
  }
</style>
