---
// /areas "Good to know in Pinellas", R4 (independent re-check R3 MAJOR 3: the R3 test strip and Seminole TownFacts were the
// same device, four tabs + a "READING 0N" card, with the same 217 ppm and storm facts, and both were close to Khinda /areas
// Rules, four index tabs with one fact each). No tabs now. New idea, FOGGED GLASS: four panes of glass stand in a row, each
// fogged over like a cold glass on a Florida porch. Each pane holds one fact's figure; wipe the fog away to read it (move
// the pointer across the pane, or tap it on a phone: a wipe runs across it). The fact's sentence and source sit under each
// pane in plain text, always readable, so nothing is hidden from search or screen readers. "Wipe all" clears the four.
// Seminole (TownFacts) no longer repeats any of these: it keeps its own distance and a build-year check.
// 21st.dev: "Scratch To Reveal" (@dillionverma, id 1508: canvas you rub to reveal) + "Scratch Card" (@arihantcodes, id
// 29938: auto-reveal once enough is cleared), rebuilt in vanilla TS (one small canvas per pane, drawn once, cleared with
// destination-out; no per-frame loop), re-skinned as Glass's own material: frost condensation on a glass pane with a
// meniscus line and the housing cap on top.
// Nearest match: Glass home Areas (split-flap dispatch board), Glass contact ConHero (switchboard keys), Glass /faq hero
// (search housing), Khinda areas Rules (tabbed code book), Khinda city Plate (tilt). Neither site has a surface you wipe.
// Facts and sources: LOCAL-FACTS sections 3, 4 and 5 (unchanged from R3; the 1978 median stays labelled third party).
// No JS / reduced motion: no fog, the panes are clear (R5: reduced motion builds nothing, no canvas, no wipe buttons). Keyboard: each pane has its own "Wipe" button.
import Head from './Head.astro';
const facts = [
  { k: 'Permits', v: 'City or county', t: 'Permits depend on the city.', d: 'Pinellas County handles permits for unincorporated areas. Largo and Clearwater issue their own. Your address decides which office.', s: 'pinellas.gov/express-permits · largo.com · myclearwater.com (read 17 Nov 2026)' },
  { k: 'Water', v: '217 ppm', t: 'Hard, treated water.', d: 'Pinellas County Utilities water averages 217 ppm hardness and is treated with chloramine. Hard water leaves scale in heaters and fixtures.', s: 'PCU 2025 Consumer Confidence Report' },
  { k: 'Homes', v: '1978', t: 'The median Largo home.', d: 'Largo’s median home was built in 1978, by a third-party summary of Census figures.', s: 'ACS 2023 via city-stats.com (third party)' },
  { k: 'Storms', v: '6.5 ft', t: 'Surge reaches the coast.', d: 'Hurricane Helene (2024) pushed about 6.5 ft of surge into Clearwater Beach.', s: 'axios.com/local/tampa-bay' },
];
---
<section class="afacts" data-m-section aria-labelledby="afacts-h">
  <div class="wrap">
    <div class="af-head"><Head eyebrow="Good to know in Pinellas" l1="Four facts" l2="that change the job." id="afacts-h" /></div>
    <p class="af-lead" data-t="3"><span class="fog-only">The glass is fogged. <span class="d">Wipe it to read each figure.</span><span class="m">Tap a pane to wipe it.</span></span></p>
    <ul class="fg" role="list" data-fg data-t="4" data-stagger>
      {facts.map((f, i) => (
        <li class="fg-i">
          <div class="fg-pane" data-fg-pane>
            <span class="fg-cap" aria-hidden="true"></span>
            <div class="fg-glass">
              <p class="fg-k">{String(i + 1).padStart(2, '0')} · {f.k}</p>
              <p class:list={['fg-v', f.v.length > 8 && 'fg-v--l']}>{f.v}</p>
              <canvas class="fg-c" aria-hidden="true" data-fg-c></canvas>
              <span class="fg-hint" aria-hidden="true">Wipe</span>
            </div>
            <button type="button" class="fg-b" data-fg-b>Wipe<span class="sr-only"> the {f.k.toLowerCase()} pane</span></button>
          </div>
          <h3 class="fg-t">{f.t}</h3>
          <p class="fg-d">{f.d}</p>
          <p class="fg-s">Source: {f.s}</p>
        </li>
      ))}
    </ul>
    <p class="fg-all-w fog-only"><button type="button" class="fg-all" data-fg-all>Wipe all four</button></p>
  </div>
</section>

<script>
  // One canvas per pane, drawn once (fog + condensation beads), cleared with destination-out strokes. Work happens only on
  // pointer moves over a pane and once per pane at build (when the section first nears the screen); nothing runs per frame.
  const sec = document.querySelector<HTMLElement>('.afacts');
  const root = sec?.querySelector<HTMLElement>('[data-fg]');
  // R5 (re-check R4 MINOR 5): with reduced motion (or no motion class) there is no fog at all: the panes are clear glass,
  // static and complete, and nothing is built.
  if (sec && root && typeof HTMLCanvasElement !== 'undefined' && document.documentElement.classList.contains('motion')) {
    const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
    const panes = Array.from(root.querySelectorAll<HTMLElement>('[data-fg-pane]'));
    type P = { el: HTMLElement; c: HTMLCanvasElement; x: CanvasRenderingContext2D; w: number; h: number; done: boolean; lx: number; ly: number; n: number };
    const ps: P[] = [];
    const clearAll = (p: P) => {
      if (p.done) return; p.done = true; p.el.classList.add('is-clear');
    };
    const coverage = (p: P) => {
      // Sample a 12 x 12 grid of alpha: cleared once 55 % is gone.
      const d = p.x.getImageData(0, 0, p.c.width, p.c.height).data; let gone = 0, all = 0;
      for (let gy = 0; gy < 12; gy++) for (let gx = 0; gx < 12; gx++) {
        const px = Math.floor(((gx + .5) / 12) * p.c.width), py = Math.floor(((gy + .5) / 12) * p.c.height);
        all++; if (d[(py * p.c.width + px) * 4 + 3] < 60) gone++;
      }
      return gone / all;
    };
    const stroke = (p: P, x0: number, y0: number, x1: number, y1: number, r: number) => {
      const k = p.c.width / p.w;
      p.x.lineWidth = r * 2 * k; p.x.beginPath(); p.x.moveTo(x0 * k, y0 * k); p.x.lineTo(x1 * k, y1 * k); p.x.stroke();
      if (++p.n % 6 === 0 && coverage(p) > .55) clearAll(p);
    };
    const draw = (p: P) => {
      const gl = p.el.querySelector<HTMLElement>('.fg-glass')!;
      p.w = gl.offsetWidth; p.h = gl.offsetHeight;
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      p.c.width = Math.round(p.w * dpr); p.c.height = Math.round(p.h * dpr);
      const x = p.x; x.globalCompositeOperation = 'source-over';
      const g = x.createLinearGradient(0, 0, 0, p.c.height);
      g.addColorStop(0, 'rgba(238,243,244,.97)'); g.addColorStop(1, 'rgba(220,230,233,.97)');
      x.fillStyle = g; x.fillRect(0, 0, p.c.width, p.c.height);
      // condensation beads (seeded, so every pane differs but stays the same between loads)
      let s = ps.length * 97 + 13; const rnd = () => ((s = (s * 9301 + 49297) % 233280) / 233280);
      for (let i = 0; i < 70; i++) {
        const bx = rnd() * p.c.width, by = rnd() * p.c.height, br = (1 + rnd() * 3.2) * dpr;
        x.fillStyle = 'rgba(132,179,199,.45)'; x.beginPath(); x.arc(bx, by, br, 0, Math.PI * 2); x.fill();
        x.fillStyle = 'rgba(255,255,255,.9)'; x.beginPath(); x.arc(bx - br * .3, by - br * .3, br * .35, 0, Math.PI * 2); x.fill();
      }
      x.globalCompositeOperation = 'destination-out'; x.lineCap = 'round'; x.lineJoin = 'round'; x.strokeStyle = '#000';
    };
    // A tap (or the button): one wipe runs across the pane in three passes, like a hand.
    const sweep = (p: P) => {
      if (p.done) return;
      const rows = [.25, .55, .82]; const t0 = performance.now(); const dur = 650; let last = 0;
      const tick = (now: number) => {
        const t = Math.min(1, (now - t0) / dur);
        const seg = Math.min(2, Math.floor(t * 3)), u = (t * 3) - seg;
        const dir = seg % 2 ? -1 : 1; const y = rows[seg] * p.h;
        const xa = p.w * (dir > 0 ? last : 1 - last), xb = p.w * (dir > 0 ? u : 1 - u);
        stroke(p, xa, y, xb, y, p.h * .2);
        last = u >= 1 ? 0 : u;
        if (t < 1) requestAnimationFrame(tick); else clearAll(p);
      };
      requestAnimationFrame(tick);
    };
    const build = () => {
      sec.classList.add('fg-on');
      panes.forEach((el) => {
        const c = el.querySelector<HTMLCanvasElement>('[data-fg-c]')!; const x = c.getContext('2d', { willReadFrequently: true });
        if (!x) return;
        const p: P = { el, c, x, w: 0, h: 0, done: false, lx: -1, ly: -1, n: 0 };
        ps.push(p); draw(p);
        const glass = el.querySelector<HTMLElement>('.fg-glass')!;
        if (fine) {
          let rect: DOMRect | null = null;
          glass.addEventListener('pointerenter', (e) => { rect = glass.getBoundingClientRect(); p.lx = e.clientX - rect.left; p.ly = e.clientY - rect.top; });
          glass.addEventListener('pointermove', (e) => {
            if (p.done || !rect) return;
            const z = rect.width / p.w; const nx = (e.clientX - rect.left) / z, ny = (e.clientY - rect.top) / z;
            stroke(p, p.lx < 0 ? nx : p.lx / z, p.ly < 0 ? ny : p.ly / z, nx, ny, p.h * .16);
            p.lx = e.clientX - rect.left; p.ly = e.clientY - rect.top;
          });
          glass.addEventListener('pointerleave', () => { rect = null; p.lx = p.ly = -1; });
        } else glass.addEventListener('click', () => sweep(p));
        el.querySelector<HTMLButtonElement>('[data-fg-b]')!.addEventListener('click', () => sweep(p));
      });
      sec.querySelector('[data-fg-all]')?.addEventListener('click', () => ps.forEach((p, i) => setTimeout(() => sweep(p), i * 120)));
      let rt = 0;
      addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(() => ps.forEach((p) => { if (!p.done) { draw(p); p.n = 0; } }), 250); });
    };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { io.disconnect(); build(); } }, { rootMargin: '0px 0px 60% 0px' });
      io.observe(root);
    } else build();
  }
</script>

<style>
  .afacts { position: relative; background: var(--white); padding: 110px 0 120px; }
  .af-head { display: flex; justify-content: center; text-align: center; }
  .af-head :global(.ah-eb) { justify-content: center; }
  .af-lead { min-height: 26px; margin-top: 16px; text-align: center; font-size: 17px; color: var(--muted); }
  .fog-only { visibility: hidden; }
  :global(html:not(.motion)) .af-lead, :global(html:not(.motion)) .fg-all-w { display: none; }
  .fg-on .fog-only { visibility: visible; }
  .m { display: none; }
  @media (hover: none), (pointer: coarse) { .d { display: none; } .m { display: inline; } }

  .fg { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px; margin: 48px 0 0; padding: 0; list-style: none; }
  .fg-i { display: flex; flex-direction: column; text-align: left; }
  /* The pane: a housing cap on top, a tall glass with a meniscus line near the bottom. */
  .fg-pane { position: relative; }
  .fg-cap { display: block; height: 16px; margin: 0 -6px; border-radius: 4px; background: var(--ink); }
  .fg-glass { position: relative; display: flex; flex-direction: column; justify-content: flex-start; align-items: center; height: 220px; padding: 44px 14px 20px; overflow: hidden;
    border-radius: 0 0 26px 26px; background: linear-gradient(180deg, var(--white) 0 70%, var(--frost2) 70%); box-shadow: inset 0 0 0 2px var(--ink), 10px 10px 0 var(--powder); text-align: center; }
  .fg-glass::after { content: ''; position: absolute; left: 2px; right: 2px; top: 70%; height: 10px; margin-top: -5px; border-radius: 50%; border-top: 2px solid var(--powder); pointer-events: none; }
  .fg-k { font: 700 11px/1 var(--f-m); letter-spacing: .1em; text-transform: uppercase; color: var(--pdeep); }
  .fg-v { margin-top: 12px; font: 800 44px/1 var(--f-h); letter-spacing: -.02em; color: var(--ink); }
  .fg-v--l { font-size: 30px; line-height: 1.05; }
  .fg-c { position: absolute; inset: 0; width: 100%; height: 100%; display: none; border-radius: inherit; transition: opacity .6s var(--ease-io); cursor: crosshair; touch-action: pan-y; }
  .fg-on .fg-c { display: block; }
  .fg-hint { position: absolute; left: 50%; bottom: 16px; translate: -50% 0; display: none; padding: 6px 10px; border-radius: 12px; background: var(--ink); color: var(--white); font: 700 10px/1 var(--f-m); letter-spacing: .1em; text-transform: uppercase; pointer-events: none; transition: opacity .4s var(--ease-io); }
  .fg-on .fg-hint { display: block; }
  .fg-pane.is-clear .fg-c, .fg-pane.is-clear .fg-hint { opacity: 0; pointer-events: none; }
  .fg-b { position: absolute; right: 10px; top: 26px; display: none; min-width: 44px; min-height: 32px; padding: 0 10px; border: 0; border-radius: 16px; background: var(--white); box-shadow: inset 0 0 0 1.5px var(--ink); color: var(--ink); font: 700 11px/1 var(--f-m); letter-spacing: .06em; text-transform: uppercase; cursor: pointer; opacity: 0; transition: opacity .3s var(--ease-io); }
  .fg-on .fg-b { display: block; }
  .fg-b:focus-visible { opacity: 1; outline: 3px solid var(--pdeep); outline-offset: 2px; }
  .fg-pane.is-clear .fg-b { visibility: hidden; }
  .fg-t { margin-top: 26px; font: 800 22px/1.15 var(--f-h); letter-spacing: -.01em; color: var(--ink); }
  .fg-d { margin-top: 10px; font-size: 16px; line-height: 1.5; color: var(--ink); }
  .fg-s { margin-top: auto; padding-top: 14px; font: 500 11px/1.4 var(--f-m); color: var(--muted); }
  .fg-all-w { display: flex; justify-content: center; margin-top: 40px; }
  .fg-all { min-height: 48px; padding: 0 22px; border: 0; border-radius: 4px; background: var(--ink); color: var(--white); box-shadow: 4px 4px 0 var(--powder); font: 700 15px/1 var(--f-b); cursor: pointer; }
  .fg-all:hover { background: var(--pdeep); }
  .fg-all:focus-visible { outline: 3px solid var(--pdeep); outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) { .fg-c, .fg-hint, .fg-b { transition: none; } }

  @media (min-width: 768px) and (max-width: 1279px) {
    .fg { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px 32px; }
  }
  @media (max-width: 767px) {
    .afacts { padding: 56px 0 64px; }
    .af-lead { font-size: 15px; }
    .fg { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 30px 14px; margin-top: 28px; }
    .fg-cap { height: 12px; margin: 0 -4px; }
    .fg-glass { height: 150px; padding: 26px 8px 10px; border-radius: 0 0 18px 18px; box-shadow: inset 0 0 0 2px var(--ink), 6px 6px 0 var(--powder); }
    .fg-k { font-size: 9px; letter-spacing: .06em; }
    .fg-v { margin-top: 8px; font-size: 26px; }
    .fg-v--l { font-size: 19px; }
    .fg-b { right: 6px; top: 18px; }
    .fg-t { margin-top: 18px; font-size: 17px; }
    .fg-d { font-size: 14px; }
    .fg-s { font-size: 10px; }
  }
</style>
