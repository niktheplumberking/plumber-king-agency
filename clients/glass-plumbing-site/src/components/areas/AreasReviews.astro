---
// /areas "Reviews by town", fix round 3 (E, RECHECK MAJOR 5: three plain white review cards). New idea, ZOOM TO THE WORDS:
// each review is a short chapter down the centre. Its place (SEMINOLE, TAMPA / ST. PETE, RENTALS) starts huge and pale
// and settles to its size and full ink as the chapter scrolls up (kit/scrub.ts data-scrub-tw: scale + opacity, the
// scroll drives it), so the reader "zooms in" on where the job was; the review itself sits under the word in large type
// with its stars and a Google link. Three real Google review excerpts (checked word for word against reviews.ts at build),
// both profiles as badges (104 and 77, never summed). 21st.dev: reuno-ui "Text Scroll animation" (words scaling with the
// scroll) re-skinned with Glass type, powder rule and ink outline. Reduced motion / no JS: the words rest at size 1.
import Head from './Head.astro';
import Seam from '../kit/Seam.astro';
import { quote, STARS } from './reviews';
import { REVIEWS } from '../../data/reviews';
import { SITE } from '../../data/site';
const prof = (n: string) => (REVIEWS.find((r) => r.name === n)!.profile === 'a' ? SITE.google.a : SITE.google.b);
const ext = '<path d="M5 2h7v7M12 2 4.5 9.5M9 12H2V5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>';
const cards = [
  { chip: 'Seminole', big: 'Seminole', name: 'Cody Weaver', q: quote('Cody Weaver', 'Kody came out and fixed my shower in Seminole that refused to drain.') },
  { chip: 'Tampa / St. Pete', big: 'St. Pete', name: 'Peter Van Buskirk', q: quote('Peter Van Buskirk', "I wouldn't think of working with anyone else in the Tampa / St. Pete area.") },
  { chip: 'Rentals & family homes', big: 'Rentals', name: 'David Peek', q: quote('David Peek', 'I’ve had them do work for me in my own home, my daughter’s home, rental properties, my in-laws’ properties and estate properties.') },
];
---
<section class="arev" data-m-section aria-labelledby="arev-h">
  <Seam from="var(--white)" to="var(--frost)" flip />
  <div class="wrap">
    <div class="arev-head">
      <Head eyebrow="Reviews by town" l1="From Seminole" l2="to St. Pete." id="arev-h" />
      <ul class="arev-badges" role="list" data-t="3">
        {[['Profile 1', SITE.google.a], ['Profile 2', SITE.google.b]].map(([k, p]: any) => (
          <li><a class="gb" href={p.url} target="_blank" rel="noopener"><span class="gb-g" aria-hidden="true">G</span><span class="gb-v">{p.value}</span><svg viewBox="0 0 80 13" width="70" height="11" fill="#F9B50D" aria-hidden="true" set:html={STARS} /><span class="gb-n">{p.count} reviews · Google {k.toLowerCase()}</span><svg class="gb-x" viewBox="0 0 14 14" width="11" height="11" aria-hidden="true" set:html={ext} /><span class="sr-only">: 5.0 stars (opens in a new tab)</span></a></li>
        ))}
      </ul>
    </div>
    <ol class="zq" role="list">
      {cards.map((c, i) => (
        <li class="zq-ch" data-scrub data-no-px data-start="top 95%" data-end="top 45%" data-start-m="top 98%" data-end-m="top 55%">
          <p class="zq-big" aria-hidden="true"><span data-scrub-tw='{"scale":2.4,"opacity":0.12}'>{c.big}</span></p>
          <figure class="zq-fig" data-t="3">
            <p class="zq-k"><span>0{i + 1}</span> {c.chip}</p>
            <svg class="rc-stars" viewBox="0 0 80 13" width="96" height="16" fill="#F9B50D" role="img" aria-label="5 out of 5 stars" set:html={STARS} />
            <blockquote class="zq-q"><p>“{c.q}”</p></blockquote>
            <figcaption class="rc-by"><span class="rc-g" aria-hidden="true">G</span>{c.name} · <a href={prof(c.name).url} target="_blank" rel="noopener">Google<span class="sr-only"> profile with this review (opens in a new tab)</span></a></figcaption>
          </figure>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .zq { display: grid; gap: 70px; margin: 64px auto 0; padding: 0; max-width: 900px; list-style: none; }
  .zq-ch { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .zq-big { margin: 0; font-family: var(--f-h); font-weight: 800; font-size: 120px; line-height: .9; letter-spacing: -.04em; color: transparent; -webkit-text-stroke: 2px var(--ink); white-space: nowrap; }
  .zq-big span { display: inline-block; transform-origin: 50% 70%; }
  .zq-fig { margin: -18px 0 0; position: relative; width: min(780px, 100%); padding: 30px 40px 26px; background: var(--white); border-radius: 6px; box-shadow: inset 0 0 0 1.5px var(--ink), 8px 8px 0 var(--powder); }
  .zq-k { display: inline-flex; gap: 10px; align-items: center; margin-bottom: 12px; font-family: var(--f-m); font-weight: 700; font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: var(--pdeep); }
  .zq-k span { padding: 3px 7px; border-radius: 3px; background: var(--ink); color: var(--white); }
  .zq-fig .rc-stars { display: block; margin: 0 auto; }
  .zq-q { margin: 14px 0 0; font-family: var(--f-h); font-weight: 800; font-size: 28px; line-height: 1.22; letter-spacing: -.01em; color: var(--ink); }
  .zq-fig .rc-by { margin-top: 16px; }
  .arev { position: relative; overflow-x: clip; background: var(--frost); padding: 110px 0 110px; }
  .arev-head { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .arev-head :global(.ah-eb) { justify-content: center; }
  .arev-badges { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 26px; }
  .gb { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 16px 0 8px; border-radius: 22px; background: var(--white); box-shadow: inset 0 0 0 1.5px var(--ink); color: var(--ink); text-decoration: none; transition: background-color .4s var(--ease-io); }
  .gb:hover { background: var(--steel); }
  .gb:focus-visible { outline: 3px solid var(--pdeep); outline-offset: 2px; }
  .gb-g, .rc-g { display: inline-grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--frost); color: #4285F4; font-family: var(--f-h); font-weight: 800; font-size: 15px; }
  .gb-v { font-family: var(--f-h); font-weight: 800; font-size: 18px; }
  .gb-n { font-family: var(--f-m); font-weight: 500; font-size: 11px; letter-spacing: .02em; }
  .rc-g { width: 20px; height: 20px; margin-right: 6px; font-size: 11px; vertical-align: -5px; background: var(--frost); }
  .rc-by a { display: inline-block; min-width: 44px; padding: 15px 0; margin: -15px 0; text-align: center; color: inherit; text-decoration: underline; text-underline-offset: 2px; }
  .rc-by { margin-top: auto; font-family: var(--f-m); font-weight: 500; font-size: 11px; line-height: 15px; letter-spacing: .02em; color: var(--pdeep); }

  @media (min-width: 768px) and (max-width: 1279px) {
    .arev { padding: 96px 0 80px; }
  }
  @media (max-width: 767px) {
    .arev { padding: 56px 0 64px; }
    .rc-by { font-size: 9px; line-height: 12px; }
    .gb-n { font-size: 10px; }
    .arev-badges { margin-top: 18px; }
  }
  @media (min-width: 768px) and (max-width: 1279px) { .zq-big { font-size: 96px; } }
  @media (max-width: 767px) {
    .zq { gap: 44px; margin-top: 36px; }
    .zq-big { font-size: 58px; -webkit-text-stroke-width: 1.5px; }
    .zq-fig { margin-top: -8px; padding: 22px 16px 18px; box-shadow: inset 0 0 0 1.5px var(--ink), 5px 5px 0 var(--powder); }
    .zq-q { font-size: 19px; }
  }
</style>
