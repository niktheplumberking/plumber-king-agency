---
// Contact hero (Figma 724:1091 "Hero" y 172 h 600 / 725:701 y 158 h 420): crumbs, eyebrow, H1, the steel number plate.
import './cx.css';
import Crumbs from './Crumbs.astro';
import Eyebrow from '../kit/Eyebrow.astro';
import Btn from '../kit/Btn.astro';
import { SITE } from '../../data/site';
---
<section class="cx-sec cx-frost ch" data-m-section data-m-hero aria-labelledby="ch-h">
  <div class="wrap">
    <Crumbs label="Contact" class="ch-cr" />
    <Eyebrow text="A real plumber picks up" tone="pdeep" class="ch-eb" />
    <h1 id="ch-h" class="cx-h ch-h" data-t="2"><span class="ln">Call or Text</span> <span class="ln tone">Glass Plumbing</span></h1>
    <div class="ch-plate" data-t="4" data-fx="scale">
      <span class="rv" aria-hidden="true"></span><span class="rv" aria-hidden="true"></span><span class="rv" aria-hidden="true"></span><span class="rv" aria-hidden="true"></span>
      <p class="ch-lbl">Call or text · 24/7 emergency</p>
      <a class="ch-num" href={SITE.tel}><span class="sr-only">Call </span>{SITE.phone}</a>
      <Btn look="call" label="Call now" sub="24/7" href={SITE.tel} w={280} size="l" class="ch-btn" />
    </div>
  </div>
</section>
<style>
  .ch { padding: 44px 0 80px; }
  .ch :global(.ch-eb) { margin-top: 29px; }
  .ch-h { --fs: 64px; --fs-m: 38px; margin-top: 16px; max-width: 700px; }
  .ch-plate { position: relative; margin-top: 80px; height: 190px; padding: 32px 0 0 48px; background: var(--steel); border: 1px solid var(--steel2);
    border-radius: 6px; box-shadow: 10px 10px 0 var(--ink); }
  .rv { position: absolute; width: 12px; height: 12px; border-radius: 50%; background: var(--steel2); }
  .rv:nth-child(1) { left: 11px; top: 11px; } .rv:nth-child(2) { right: 11px; top: 11px; }
  .rv:nth-child(3) { left: 11px; bottom: 11px; } .rv:nth-child(4) { right: 11px; bottom: 11px; }
  .ch-lbl { margin: 0; font: 700 12px/16px var(--f-m); letter-spacing: .06em; text-transform: uppercase; color: var(--ink); }
  .ch-num { display: inline-block; margin: 10px 0 0 -4px; font: 800 110px/1.04 var(--f-h); letter-spacing: -0.02em; color: var(--ink); white-space: nowrap; text-decoration: none; }
  .ch-num:hover { color: var(--pdeep); }
  .ch :global(.ch-btn) { position: absolute; right: 39px; top: 61px; }
  @media (min-width: 768px) and (max-width: 1279px) {
    .ch-num { font-size: clamp(56px, 8.4vw, 100px); }
    .ch :global(.ch-btn) { position: static; margin-top: 16px; }
    .ch-plate { height: auto; padding-bottom: 32px; }
  }
  @media (max-width: 767px) {
    .ch { padding: 24px 0 56px; }
    .ch :global(.ch-eb) { margin-top: 15px; }
    .ch-h { margin-top: 10px; }
    .ch-plate { margin-top: 28px; height: 180px; padding: 21px 18px 0 20px; box-shadow: 8px 8px 0 var(--ink); }
    .rv { width: 8px; height: 8px; }
    .rv:nth-child(1) { left: 7px; top: 7px; } .rv:nth-child(2) { right: 7px; top: 7px; }
    .rv:nth-child(3) { left: 7px; bottom: 7px; } .rv:nth-child(4) { right: 7px; bottom: 7px; }
    .ch-lbl { font-size: 9px; line-height: 12px; }
    .ch-num { font-size: 40px; margin: 7px 0 0 -2px; }
    .ch :global(.ch-btn) { position: static; width: 100%; height: 56px; margin-top: 18px; }
  }
</style>
