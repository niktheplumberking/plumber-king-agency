---
// "Five ways to reach us" (Figma "Ways to reach" y 772 h 740 / mobile y 578 h 722). Each row is one link (stretched).
import './cx.css';
import Eyebrow from '../kit/Eyebrow.astro';
import { SITE } from '../../data/site';
const rows = [
  { n: 1, t: 'Call', sub: SITE.phone, href: SITE.tel, d: 'Fastest. Any hour for emergencies.' },
  { n: 2, t: 'Text a photo', sub: SITE.phone, href: SITE.sms, d: '“I took a few pictures of the valve that needed replaced and he was at my home the next day !!” Jen James' },
  { n: 3, t: 'Form', sub: 'Below', href: '#estimate', d: 'We call you back.' },
  { n: 4, t: 'Email', sub: SITE.email, href: `mailto:${SITE.email}`, d: 'For bids and paperwork.' },
  { n: 5, t: 'Instagram DM', sub: SITE.social.instagramHandle, href: SITE.social.instagram, d: 'See our jobs, send a message.', ext: true },
];
---
<section class="cx-sec cx-white cw" data-m-section aria-labelledby="cw-h">
  <div class="wrap cw-g">
    <div class="cw-head shead">
      <Eyebrow text="Fastest first" tone="pdeep" />
      <h2 id="cw-h" class="cx-h cw-h" data-t="2"><span class="ln">Five ways</span> <span class="ln tone">to reach us.</span></h2>
    </div>
    <ol class="cw-l" role="list" data-t="3" data-stagger>
      {rows.map((r) => (
        <li class="cw-r">
          <span class="cw-n" aria-hidden="true">{r.n}</span>
          <div class="cw-m">
            <h3 class="cw-t"><a href={r.href} target={r.ext ? '_blank' : undefined} rel={r.ext ? 'noopener' : undefined}>{r.t}{r.ext && <span class="sr-only"> (opens in a new tab)</span>}</a></h3>
            <p class="cw-s">{r.sub}</p>
          </div>
          <p class="cw-d">{r.d}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .cw { padding: 110px 0 109px; }
  .cw-g { display: grid; grid-template-columns: 480px 1fr; }
  .cw-h { --fs: 52px; --fs-m: 28px; margin-top: 16px; }
  .cw-l { margin: 0; padding: 0; list-style: none; border-top: 1px solid rgba(22, 19, 15, .2); }
  .cw-r { position: relative; display: grid; grid-template-columns: 60px 260px 1fr; height: 104px; padding-top: 24px; border-bottom: 1px solid rgba(22, 19, 15, .2); }
  .cw-n { font: 800 40px/1.04 var(--f-h); letter-spacing: -0.02em; color: var(--pdeep); }
  .cw-t { margin: 0; font: 800 22px/1.04 var(--f-h); letter-spacing: -0.02em; color: var(--ink); }
  .cw-t a { color: inherit; text-decoration: none; }
  .cw-t a::after { content: ''; position: absolute; inset: 0; }
  .cw-r:hover .cw-t a { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 2px; }
  .cw-r:has(a:focus-visible) { outline: 3px solid var(--pdeep); outline-offset: 2px; }
  .cw-s { margin: 11px 0 0; font: 700 11px/15px var(--f-m); letter-spacing: .01em; color: var(--pdeep); }
  .cw-d { margin: 2px 0 0; font: 400 15px/1.5 var(--f-b); color: var(--muted); max-width: 400px; }
  @media (min-width: 768px) and (max-width: 1279px) {
    .cw-g { grid-template-columns: 1fr; gap: 40px; }
  }
  @media (max-width: 767px) {
    .cw { padding: 48px 0 40px; }
    .cw-g { grid-template-columns: 1fr; }
    .cw-h { margin-top: 10px; }
    .cw-l { margin-top: 20px; }
    .cw-r { grid-template-columns: 40px 1fr; height: auto; padding: 14px 0 16px; }
    .cw-n { font-size: 30px; grid-row: span 2; }
    .cw-t { font-size: 18px; }
    .cw-s { margin-top: 9px; font-size: 9px; line-height: 12px; }
    .cw-d { grid-column: 2; margin-top: 8px; font-size: 13px; max-width: 300px; }
  }
</style>
