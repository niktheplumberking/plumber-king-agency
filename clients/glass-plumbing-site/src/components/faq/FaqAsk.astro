---
// "Didn't see your question? Ask a real plumber." (Figma "CTA ask a plumber" y 4665 h 659 / mobile y 3864 h 643).
// INTERACTION note (884:651): the big field grows as you type; the send button fills when there is text and a number.
// Same backend rule as the other forms: PUBLIC_FORM_ENDPOINT set -> POST (multipart, photo included) then /thank-you;
// not set (preview) -> straight to /thank-you, nothing leaves the browser. forms.ts needs a name field this box does not
// have, so the box has its own small submit script with the same rule (lib/form.ts).
// R2 polish (Nick praised the questions; rule 17 + 15): the head is centred, and a text-message bubble pinned over the
// box's corner shows the question as Kody will get it, live as you type (21st.dev "Chat bubble / message preview" idea,
// re-skinned as an SMS slip with the powder offset). The bubble is aria-hidden: the field itself is the real content.
import '../contact/cx.css';
import Eyebrow from '../kit/Eyebrow.astro';
import { SITE } from '../../data/site';
---
<section class="cx-sec cx-white fa" data-m-section aria-labelledby="fa-h">
  <div class="wrap">
    <div class="shead fa-top">
      <Eyebrow text="Still have a question?" tone="pdeep" />
      <h2 id="fa-h" class="cx-h fa-h" data-t="2"><span class="ln">Didn’t see your question?</span> <span class="ln tone">Ask a real plumber.</span></h2>
    </div>
    <div class="fa-wrap">
    <div class="fa-sms" aria-hidden="true" data-ask-sms>
      <p class="fa-to">To Kody · {SITE.phone}</p>
      <p class="fa-bub" data-ask-bub data-empty="Your question shows up here, as a text."></p>
    </div>
    <form class="fa-box" data-ask novalidate data-t="3" data-fx="frame" enctype="multipart/form-data">
      <label class="sr-only" for="fa-q">Your question</label>
      <textarea id="fa-q" name="message" rows="1" placeholder="Type your question…" required></textarea>
      <div class="fa-row">
        <label class="sr-only" for="fa-p">Your phone number</label>
        <input id="fa-p" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="Your phone number" required />
        <label class="fa-chip">
          <input type="file" name="photo" accept="image/*,video/*" class="sr-only" data-ask-photo />
          <span data-ask-photo-label>+ Add a photo</span>
        </label>
        <button type="submit" class="fa-send" aria-disabled="true" aria-describedby="fa-hint">
          <span>Send to Kody</span>
          <svg width="14" height="12" viewBox="0 0 14 12" aria-hidden="true"><path d="M.9 5.9h12M7.9 10.9l5-5-5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
      <p class="fa-msg" role="status" aria-live="polite" data-ask-msg></p>
      <p class="sr-only" id="fa-hint" data-ask-hint>Type your question and a 10-digit phone number to send.</p>
    </form>
    </div>
    <p class="fa-note" data-t="4"><span class="d">Goes to the crew as a text. </span>Emergency? Call <a href={SITE.tel}>{SITE.phone}</a>.</p>
  </div>
</section>
<script>
  import { FORM_ENDPOINT, THANK_YOU } from '../../lib/form';
  import { SITE } from '../../data/site';
  const digits = (v: string) => v.replace(/\D/g, '').replace(/^1(?=\d{10}$)/, '');
  document.querySelectorAll<HTMLFormElement>('form[data-ask]').forEach((form) => {
    const q = form.querySelector<HTMLTextAreaElement>('textarea[name="message"]')!;
    const p = form.querySelector<HTMLInputElement>('input[name="phone"]')!;
    const msg = form.querySelector<HTMLElement>('[data-ask-msg]')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const file = form.querySelector<HTMLInputElement>('[data-ask-photo]');
    const fileLabel = form.querySelector<HTMLElement>('[data-ask-photo-label]');
    msg.id = 'fa-msg';
    // The field grows as you type (CSS field-sizing where supported; this covers the rest).
    const grow = () => { if (CSS.supports('field-sizing', 'content')) return; q.style.height = 'auto'; q.style.height = `${q.scrollHeight}px`; };
    const hint = form.querySelector<HTMLElement>('[data-ask-hint]');
    // Not ready: the button keeps the Figma ink fill but says so (aria-disabled + hint); pressing it still explains what is missing.
    const ready = () => {
      const ok = q.value.trim().length > 0 && digits(p.value).length === 10;
      form.classList.toggle('is-ready', ok);
      btn.setAttribute('aria-disabled', ok ? 'false' : 'true');
      if (hint) hint.textContent = ok ? 'Ready to send.' : 'Type your question and a 10-digit phone number to send.';
    };
    const bub = form.parentElement?.querySelector<HTMLElement>('[data-ask-bub]');
    const sms = form.parentElement?.querySelector<HTMLElement>('[data-ask-sms]');
    const mirror = () => { if (!bub || !sms) return; const t = q.value.trim(); bub.textContent = t.length > 160 ? `${t.slice(0, 157)}…` : t; sms.classList.toggle('is-typing', t.length > 0); };
    q.addEventListener('input', () => { grow(); ready(); mirror(); q.removeAttribute('aria-invalid'); });
    p.addEventListener('input', () => { ready(); p.removeAttribute('aria-invalid'); });
    file?.addEventListener('change', () => { if (fileLabel) fileLabel.textContent = file.files?.[0] ? `Photo: ${file.files[0].name}` : '+ Add a photo'; });
    grow(); ready();
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const qBad = !q.value.trim(); const pBad = digits(p.value).length !== 10;
      const need: string[] = [];
      if (qBad) need.push('your question'); if (pBad) need.push('a 10-digit phone number');
      [q, p].forEach((i) => i.setAttribute('aria-describedby', msg.id));
      if (qBad) q.setAttribute('aria-invalid', 'true'); if (pBad) p.setAttribute('aria-invalid', 'true');
      if (need.length) { msg.textContent = `Please add ${need.join(' and ')} so we can text you back.`; (qBad ? q : p).focus(); return; }
      if (!FORM_ENDPOINT) { location.href = THANK_YOU; return; }
      btn.disabled = true; btn.setAttribute('aria-busy', 'true'); msg.textContent = 'Sending...';
      try {
        const fd = new FormData(form); fd.append('page', location.pathname); fd.append('form', 'faq-question');
        const res = await fetch(FORM_ENDPOINT, { method: 'POST', body: fd, headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(`The form service answered ${res.status}.`);
        location.href = THANK_YOU;
      } catch (err) {
        const why = err instanceof Error ? err.message : 'The form could not be sent.';
        msg.textContent = `Sorry, that didn't send (${why}) Please call ${SITE.phone} and we'll sort it out.`;
        btn.disabled = false; btn.removeAttribute('aria-busy');
      }
    });
  });
</script>
<style>
  .fa { padding: 110px 0 95px; }
  .fa-h { --fs: 52px; --fs-m: 32px; margin-top: 16px; max-width: 620px; text-wrap: wrap; }
  .fa-box { position: relative; margin-top: 40px; padding: 30px 32px 18px; border-radius: 8px; background: var(--white); box-shadow: inset 0 0 0 1.5px var(--ink), 10px 10px 0 var(--powder); }
  .fa-box textarea { display: block; width: 100%; min-height: 64px; max-height: 260px; margin: 0; padding: 2px 0; border: 0; resize: none; background: transparent; field-sizing: content;
    font: 600 28px/1.04 var(--f-h); letter-spacing: -0.02em; color: var(--ink); caret-color: var(--pdeep); box-sizing: border-box; }
  .fa-box textarea::placeholder { color: var(--muted); opacity: 1; }
  .fa-box textarea:focus { outline: none; }
  .fa-box:has(textarea:focus-visible) { box-shadow: inset 0 0 0 1.5px var(--ink), 0 0 0 3px var(--pdeep), 10px 10px 0 var(--powder); }
  .fa-row { display: flex; align-items: center; gap: 18px; margin-top: 12px; }
  .fa-row input[type="tel"] { width: 420px; height: 48px; padding: 0 16px; border: 0; border-radius: 4px; background: var(--frost); box-shadow: inset 0 0 0 1.5px var(--frost3);
    font: 400 16px/1.5 var(--f-b); color: var(--ink); box-sizing: border-box; }
  .fa-row input::placeholder { color: var(--muted); opacity: 1; }
  .fa-row input:focus-visible { outline: 3px solid var(--pdeep); outline-offset: 2px; }
  .fa-row input[aria-invalid="true"], .fa-box textarea[aria-invalid="true"] { box-shadow: inset 0 0 0 2px var(--pdeep); }
  .fa-chip { position: relative; display: inline-flex; align-items: center; height: 34px; padding: 0 14px; border-radius: 17px; box-shadow: inset 0 0 0 1.2px var(--ink);
    font: 600 14px/1.5 var(--f-b); color: var(--ink); cursor: pointer; white-space: nowrap; max-width: 260px; overflow: hidden; text-overflow: ellipsis; }
  .fa-chip::after { content: ''; position: absolute; inset: -5px 0; }
  .fa-chip:hover { background: var(--frost); }
  .fa-chip:has(input:focus-visible) { outline: 3px solid var(--pdeep); outline-offset: 3px; }
  .fa-send { display: inline-flex; align-items: center; justify-content: space-between; width: 240px; height: 56px; margin-left: auto; padding: 0 18px; border: 0; border-radius: 4px;
    background: var(--ink); font: 700 16px/1.3 var(--f-b); color: var(--white); cursor: pointer;
    transition: background-color .35s var(--ease-out, ease), color .35s var(--ease-out, ease); }
  @media (hover: hover) and (pointer: fine) { .fa-box.is-ready .fa-send:hover { background: var(--ink3); } }
  .fa-send:focus-visible { outline: 3px solid var(--pdeep); outline-offset: 3px; }
  .fa-msg { margin: 0; font: 600 14px/1.4 var(--f-b); color: var(--ink); }
  .fa-msg:empty { display: none; }
  .fa-msg:not(:empty) { margin-top: 12px; border-left: 3px solid var(--pdeep); padding-left: 10px; }
  .fa-note { margin: 28px 0 0; font: 500 11px/15px var(--f-m); letter-spacing: .02em; color: var(--muted); }
  .fa-note a { color: inherit; text-underline-offset: 2px; }
  @media (min-width: 768px) and (max-width: 1279px) {
    .fa-row { flex-wrap: wrap; }
    .fa-row input[type="tel"] { width: min(420px, 100%); }
  }
  @media (max-width: 767px) {
    .fa { padding: 64px 0 87px; }
    .fa-h { margin-top: 12px; }
    .fa-box { margin-top: 28px; padding: 20px 18px 18px; box-shadow: inset 0 0 0 1.5px var(--ink), 6px 6px 0 var(--powder); }
    .fa-box:has(textarea:focus-visible) { box-shadow: inset 0 0 0 1.5px var(--ink), 0 0 0 3px var(--pdeep), 6px 6px 0 var(--powder); }
    .fa-box textarea { min-height: 78px; font-size: 21px; }
    .fa-row { flex-direction: column; align-items: flex-start; gap: 0; margin-top: 12px; }
    .fa-row input[type="tel"] { width: 100%; }
    .fa-chip { margin-top: 14px; }
    .fa-send { width: 100%; margin: 20px 0 0; }
    .fa-note { margin-top: 24px; font-size: 10px; line-height: 13px; }
    .d { display: none; }
  }
  .fa-top { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .fa-wrap { position: relative; }
  .fa-sms { position: absolute; right: 28px; bottom: calc(100% - 30px); z-index: 2; max-width: 300px; display: flex; flex-direction: column; align-items: flex-end; gap: 6px; rotate: 1.5deg; pointer-events: none; }
  .fa-to { font: 700 10px/1 var(--f-m); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .fa-bub { min-height: 44px; padding: 12px 16px; border-radius: 18px 18px 4px 18px; background: var(--pdeep); color: var(--white); font: 500 15px/1.4 var(--f-b); box-shadow: 5px 5px 0 var(--powder); transition: background-color .4s var(--ease-io); overflow-wrap: anywhere; }
  .fa-bub:empty::before { content: attr(data-empty); opacity: .75; }
  .fa-sms.is-typing .fa-bub { background: var(--ink); }
  @media (max-width: 1023px) { .fa-sms { position: static; rotate: 0deg; max-width: none; align-items: flex-end; margin: 22px 0 14px; } }
</style>
