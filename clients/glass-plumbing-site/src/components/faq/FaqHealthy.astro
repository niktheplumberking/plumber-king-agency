---
// "Keep it healthy", R2 rebuild (watch list: three equal cards = simple layout). "Three habits" as hover-expand columns:
// the open column is wide and shows the habit, the question and the call line; the other two fold to tall ink rails with
// their glyph, number and the title turned on its side. Hover (fine pointers), focus or a tap on a rail opens it; the
// glyph of the open column draws itself (stroke dash, 1 s), its water band rises. Centred head (rule 17).
// 21st.dev: "Hover Expand" (educalvolpz, id 28111: panels expand on hover / keyboard focus, the rest collapse to a strip
// with a rotated label) + "Collapsing Cards Accordion" (aloksivastava1025, id 45440), re-skinned: ink rails, powder open
// panel with a meniscus water band, the Figma glyphs. Phones / no JS / reduced motion: three open panels stacked.
// Glyph paths are the Figma vectors (884:628); copy and sources unchanged.
import '../contact/cx.css';
import Eyebrow from '../kit/Eyebrow.astro';
import Seam from '../kit/Seam.astro';
import { SITE } from '../../data/site';
const cards = [
  { n: '01', t: 'Before storm season', d: 'Find your main shut-off and label it.', q: 'Can’t find it or it won’t turn?', g: 'storm' },
  { n: '02', t: 'Hard water', d: 'Scale builds up fast at 217 ppm.', q: 'Tank popping or running out of hot water?', g: 'scale', powder: true },
  { n: '03', t: 'Cold nights under 32°F', d: 'Open sink cabinets and let outdoor faucets drip.', q: 'Pipe split anyway?', g: 'cold' },
];
---
<section class="cx-sec cx-ink fk on-ink" data-m-section aria-labelledby="fk-h">
  <Seam from="var(--white)" to="var(--ink)" flip />
  <div class="wrap">
    <div class="shead fk-top">
      <Eyebrow text="Keep it healthy" tone="light" />
      <h2 id="fk-h" class="cx-h fk-h" data-t="2"><span class="ln">Three habits.</span> <span class="ln tone">Then call us.</span></h2>
    </div>
    <ul class="fk-l" role="list" data-t="3" data-fk>
      {cards.map((c, i) => (
        <li class:list={['fk-c', i === 1 && 'is-open']} data-fk-c>
          <span class="fk-wat" aria-hidden="true"></span>
          <button type="button" class="fk-rail" aria-expanded={i === 1 ? 'true' : 'false'} aria-controls={`fk-p${i}`} data-fk-b><span class="fk-n">{c.n}</span><span class="fk-rt">{c.t}</span><span class="sr-only">: open</span></button>
          {c.g === 'storm' && (
            <svg class="fk-g" viewBox="0 0 122 122" aria-hidden="true" data-draw>
              <path pathLength="1" d="M15.6132 54.6996C-3.58676 54.6996 -3.58676 23.4996 18.0132 23.4996C20.4132 -0.500391 56.4132 -7.70039 66.0132 16.2996C90.0132 11.4996 104.413 33.0996 90.0132 54.6996H15.6132Z" />
              <path pathLength="1" d="M13.5 1.50049L1.5 23.1005H18.3L6.3 44.7005" />
            </svg>
          )}
          {c.g === 'scale' && (
            <svg class="fk-g" viewBox="0 0 122 122" aria-hidden="true" data-draw>
              <path pathLength="1" d="M39.9 1.5C39.9 1.5 1.5 49.5 1.5 73.5C1.5 95.1 18.3 109.5 39.9 109.5C61.5 109.5 78.3 95.1 78.3 73.5C78.3 49.5 39.9 1.5 39.9 1.5Z" />
              <rect class="f" x="37.5" y="73.5" width="48" height="3.6" rx="1.8" />
              <rect class="f" x="39.9" y="85.5" width="43.2" height="3.6" rx="1.8" />
              <rect class="f" x="42.3" y="97.5" width="38.4" height="3.6" rx="1.8" />
            </svg>
          )}
          {c.g === 'cold' && (
            <svg class="fk-g" viewBox="0 0 120 120" aria-hidden="true" data-draw>
              <rect pathLength="1" x="49.5" y="6.3" width="21" height="76.2" rx="10.5" />
              <circle pathLength="1" cx="60" cy="96" r="22.5" />
              <circle class="f" cx="60" cy="96" r="12" />
              <rect class="f" x="56.4" y="36" width="7.2" height="52.8" rx="3" />
              <rect class="f" x="76.8" y="14.4" width="12" height="3" />
              <rect class="f" x="76.8" y="28.8" width="12" height="3" />
              <rect class="f" x="76.8" y="43.2" width="12" height="3" />
              <rect class="f" x="76.8" y="57.6" width="12" height="3" />
            </svg>
          )}
          <div class="fk-body" id={`fk-p${i}`}>
          <h3 class="fk-t">{c.t}</h3>
          <p class="fk-d">{c.d}</p>
          <div class="fk-f">
            <p class="fk-q">{c.q}</p>
            <a class="fk-call" href={SITE.tel}>{`Call ${SITE.phone} `}<span aria-hidden="true">→</span></a>
          </div>
          </div>
        </li>
      ))}
    </ul>
    <p class="fk-src" data-t="4"><span class="d">Cold-night steps: Pinellas County and the Florida Division of Emergency Management. Freeze warning = below 32°F (National Weather Service).</span><span class="m">Sources: Pinellas County, Florida Division of Emergency Management, National Weather Service.</span></p>
  </div>
</section>
<script>
  // Glyphs draw in (1 s stroke dash) when their column is open and on screen. Without html.motion the CSS shows them drawn.
  const list = document.querySelector<HTMLElement>('[data-fk]');
  if (list) {
    const cols = [...list.querySelectorAll<HTMLElement>('[data-fk-c]')];
    const wide = matchMedia('(min-width: 768px)');
    const open = (c: HTMLElement) => {
      cols.forEach((x) => { const on = x === c; x.classList.toggle('is-open', on); x.querySelector('[data-fk-b]')!.setAttribute('aria-expanded', String(on || !wide.matches)); });
      if (seen) c.querySelector('.fk-g')?.classList.add('is-drawn');
    };
    let seen = false;
    list.classList.add('is-js');
    cols.forEach((c) => {
      c.querySelector('[data-fk-b]')!.addEventListener('click', () => open(c));
      c.addEventListener('focusin', () => open(c));
      c.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse' && wide.matches) open(c); });
    });
    const drawOpen = () => { seen = true; const c = cols.find((x) => x.classList.contains('is-open')); c?.querySelector('.fk-g')?.classList.add('is-drawn'); if (!wide.matches) cols.forEach((x) => x.querySelector('.fk-g')?.classList.add('is-drawn')); };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { drawOpen(); io.disconnect(); } }), { rootMargin: '0px 0px -15% 0px' });
      io.observe(list);
    } else drawOpen();
    const sync = () => cols.forEach((x) => x.querySelector('[data-fk-b]')!.setAttribute('aria-expanded', String(x.classList.contains('is-open') || !wide.matches)));
    wide.addEventListener?.('change', sync); sync();
  }
</script>
<style>
  .fk { padding: 120px 0 104px; }
  .fk-top { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .fk-h { --fs: 52px; --fs-m: 34px; margin-top: 16px; }
  .fk-l { display: flex; flex-direction: column; gap: 14px; margin: 48px 0 0; padding: 0; list-style: none; }
  .fk-c { position: relative; display: flex; flex-direction: column; min-height: 360px; padding: 26px 28px 21px; box-sizing: border-box; border-radius: 10px; overflow: hidden; isolation: isolate;
    background: var(--ink2); box-shadow: inset 0 0 0 1px var(--ink3); color: var(--white); transition: flex-grow .7s var(--ease-io), background-color .6s var(--ease-io), color .6s var(--ease-io); }
  .fk-c.is-open { background: var(--powder); color: var(--ink); box-shadow: none; }
  .fk-wat { position: absolute; left: 0; right: 0; bottom: 0; height: 34%; z-index: -1; background: rgba(255,255,255,.22); transform-origin: 50% 100%; scale: 1 0; transition: scale .9s var(--ease-io); }
  .fk-wat::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 3px; background: rgba(255,255,255,.7); }
  .fk-c.is-open .fk-wat { scale: 1 1; }
  .fk-rail { all: unset; display: flex; align-items: center; gap: 14px; min-height: 44px; cursor: pointer; border-radius: 4px; }
  .fk-rail:focus-visible { outline: 3px solid currentColor; outline-offset: 4px; }
  .fk-n { font: 700 11px/15px var(--f-m); letter-spacing: .06em; color: var(--powder); transition: color .6s var(--ease-io); }
  .is-open .fk-n { color: var(--ink); }
  .fk-rt { display: none; font: 800 22px/1.05 var(--f-h); letter-spacing: -.02em; white-space: nowrap; }
  .fk-g { position: absolute; right: 28px; top: 26px; width: 110px; height: 110px; overflow: visible; transition: scale .7s var(--ease-io), translate .7s var(--ease-io); }
  .fk-g path, .fk-g rect:not(.f), .fk-g circle:not(.f) { fill: none; stroke: var(--powder); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; transition: stroke .6s var(--ease-io); }
  .fk-g .f { fill: var(--powder); transition: fill .6s var(--ease-io); }
  .is-open .fk-g path, .is-open .fk-g rect:not(.f), .is-open .fk-g circle:not(.f) { stroke: var(--ink); }
  .is-open .fk-g .f { fill: var(--ink); }
  :global(html.motion) .fk-g [pathLength] { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1s var(--ease-io, ease-in-out), stroke .6s var(--ease-io); }
  :global(html.motion) .fk-g .f { opacity: 0; transition: opacity .4s .7s, fill .6s var(--ease-io); }
  :global(html.motion) .fk-g.is-drawn [pathLength] { stroke-dashoffset: 0; }
  :global(html.motion) .fk-g.is-drawn .f { opacity: 1; }
  .fk-body { display: flex; flex-direction: column; flex: 1; margin-top: 110px; transition: opacity .5s var(--ease-io); }
  .fk-t { margin: 0; max-width: 420px; font: 800 30px/1.06 var(--f-h); letter-spacing: -0.02em; }
  .fk-d { margin: 16px 0 0; max-width: 420px; font: 400 17px/1.5 var(--f-b); }
  .fk-f { margin-top: auto; padding-top: 13px; border-top: 1px solid rgba(255, 255, 255, .3); }
  .is-open .fk-f { border-top-color: rgba(22, 19, 15, .3); }
  .fk-q { margin: 0; font: 600 14px/1.5 var(--f-b); opacity: .85; }
  .fk-call { display: inline-flex; align-items: center; align-self: flex-start; min-height: 44px; margin: 2px 0 -10px; font: 700 15px/1.5 var(--f-b); color: var(--powder);
    text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1.5px; }
  .is-open .fk-call { color: var(--ink); }
  .fk-call:focus-visible { outline: 3px solid currentColor; outline-offset: 2px; }
  .fk-src { margin: 28px 0 0; text-align: center; font: 500 10px/13px var(--f-m); letter-spacing: .02em; color: rgba(255, 255, 255, .6); }
  .m { display: none; }

  /* >= 768 with JS: hover-expand columns. */
  @media (min-width: 768px) {
    .fk-l.is-js { flex-direction: row; height: 440px; gap: 16px; }
    .fk-l.is-js .fk-c { flex: 1 1 0; min-width: 0; min-height: 0; }
    .fk-l.is-js .fk-c.is-open { flex-grow: 3.4; }
    .fk-l.is-js .fk-c:not(.is-open) { padding: 26px 0 24px; align-items: center; cursor: pointer; }
    .fk-l.is-js .fk-c:not(.is-open) .fk-rail { flex-direction: column; gap: 22px; height: 100%; align-self: stretch; }
    .fk-l.is-js .fk-c:not(.is-open) .fk-rt { display: block; writing-mode: vertical-rl; rotate: 180deg; }
    .fk-l.is-js .fk-c:not(.is-open) .fk-g { right: 50%; top: auto; bottom: 26px; translate: 50% 0; scale: .5; transform-origin: 50% 100%; }
    .fk-l.is-js .fk-c:not(.is-open) .fk-body { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); opacity: 0; margin: 0; }
    .fk-l.is-js .fk-c:not(.is-open):hover { background: var(--ink3); }
  }
  @media (min-width: 768px) and (max-width: 1279px) {
    .fk-l.is-js { height: 420px; }
    .fk-g { width: 88px; height: 88px; }
    .fk-t { font-size: 25px; }
  }
  @media (max-width: 767px) {
    .fk { padding: 80px 0 90px; }
    .fk-h { margin-top: 12px; }
    .fk-l { margin-top: 28px; }
    .fk-c { min-height: 0; padding: 20px 20px 15px; background: var(--ink2); color: var(--white); }
    .fk-c.is-open { background: var(--powder); color: var(--ink); }
    .fk-rail { cursor: default; }
    .fk-g { right: 20px; top: 20px; width: 72px; height: 72px; }
    .fk-body { margin-top: 70px; }
    .fk-t { font-size: 22px; line-height: 1.04; }
    .fk-d { margin-top: 10px; font-size: 15px; line-height: 23px; }
    .fk-f { margin-top: 14px; padding-top: 0; border-top: 0; }
    .fk-q { font-size: 13px; line-height: 20px; }
    .d { display: none; } .m { display: inline; }
    .fk-src { margin-top: 28px; text-align: left; font-size: 9px; line-height: 12px; letter-spacing: .01em; }
  }
</style>
