---
// The one legal template (Figma privacy 743:492 desktop / 743:658 mobile; /terms uses the same layout, BUILD-BRIEF 11).
// Frost hero (BreadcrumbList JSON-LD only, "Plain English" eyebrow, H1 64/34, lead 18/15), white body: sticky "On this page" rail at x 120
// (current item Bold ink + a 3 px pdeep bar; desktop only) and numbered sections at x 480, 760 wide (mono number, Schibsted
// 30/22 heading, Public Sans 18/15 at 1.6, ink 20 % rule under each), ink "Questions?" band with the red call button
// (440 x 64, powder shadow), then the towns strip. The rail follows the scroll (IntersectionObserver, no motion needed).
import Btn from '../kit/Btn.astro';
import Eyebrow from '../kit/Eyebrow.astro';
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import TownsStrip from './TownsStrip.astro';
interface Section { id: string; nav: string; t: string; body: string }
interface Props { title: string; crumb: string; path: string; lead: string; sections: Section[] }
const { title, crumb, path, lead, sections } = Astro.props;
---
<section class="lg-hero" data-m-section data-m-hero>
  <div class="wrap">
    <Breadcrumbs items={[{ label: crumb, href: path }]} />
    <Eyebrow text="Plain English" class="lg-eb" />
    <h1 class="h1 lg-h" data-t="2">{title}</h1>
    <p class="lg-lead" data-t="3">{lead}</p>
  </div>
</section>
<section class="lg-body" data-m-section>
  <div class="wrap lg-in">
    <nav class="lg-rail" aria-labelledby="lg-rail-h" data-lg-rail>
      <p class="mono-b lg-rail-h" id="lg-rail-h">On this page</p>
      <ul role="list">{sections.map((s, i) => <li><a href={`#${s.id}`} aria-current={i === 0 ? 'true' : undefined}>{s.nav}</a></li>)}</ul>
    </nav>
    <div class="lg-list">
      {sections.map((s, i) => (
        <article class="lg-sec" id={s.id} aria-labelledby={`${s.id}-h`} data-t="3">
          <p class="mono-b lg-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
          <h2 class="h3 lg-st" id={`${s.id}-h`}>{s.t}</h2>
          <p class="lg-p" set:html={s.body} />
        </article>
      ))}
    </div>
  </div>
</section>
<section class="lg-q on-ink" data-m-section>
  <div class="wrap lg-q-in">
    <div>
      <p class="mono-b lg-qk" data-t="1">Questions?</p>
      <h2 class="h2 lg-qh" data-t="2">Ask a real person.</h2>
    </div>
    <div data-t="3"><Btn sub="Call · 24/7" size="l" w={440} wm={350} /></div>
  </div>
</section>
<TownsStrip />
<script>
  // "On this page": the section nearest the top of the viewport is the current one (aria-current + the pdeep bar).
  const rail = document.querySelector('[data-lg-rail]');
  if (rail && 'IntersectionObserver' in window) {
    const links = Array.from(rail.querySelectorAll<HTMLAnchorElement>('a'));
    const mark = (id: string) => links.forEach((a) => { if (a.hash === `#${id}`) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current'); });
    const io = new IntersectionObserver((es) => { es.forEach((e) => { if (e.isIntersecting) mark((e.target as HTMLElement).id); }); }, { rootMargin: '-30% 0px -60% 0px' });
    document.querySelectorAll('.lg-sec').forEach((s) => io.observe(s));
  }
</script>
<style>
  .lg-hero { background: var(--frost); padding: 72px 0 80px; } /* R2: no visible breadcrumb row; eyebrow 72 px under the strip */
  .lg-hero :global(.lg-eb) { margin-top: 0; }
  .lg-h { --h1: 64px; --h1m: 34px; margin-top: 16px; line-height: 1.02; }
  .lg-lead { max-width: 600px; margin-top: 16px; font-size: 18px; line-height: 1.5; }
  .lg-body { background: var(--white); padding: 80px 0 61px; }
  .lg-in { display: grid; grid-template-columns: 360px 760px; }
  .lg-rail { position: sticky; top: calc(var(--header-h) + 24px); align-self: start; }
  .lg-rail-h { color: var(--muted); }
  .lg-rail ul { margin: 17px 0 0; padding: 0; list-style: none; }
  .lg-rail li + li { margin-top: 13px; }
  .lg-rail a { position: relative; display: inline-block; font-weight: 500; font-size: 15px; line-height: 23px; color: var(--muted); transition: color .25s; }
  .lg-rail a::before { content: ''; position: absolute; left: 0; top: -4px; width: 3px; height: 26px; background: var(--pdeep); transform: scaleY(0); transition: transform .35s var(--ease-out); }
  .lg-rail a[aria-current] { font-weight: 700; color: var(--ink); }
  .lg-rail a[aria-current]::before { transform: scaleY(1); }
  .lg-rail a:hover { color: var(--ink); }
  .lg-sec { padding-bottom: 22px; border-bottom: 1px solid var(--line); scroll-margin-top: calc(var(--header-h) + 24px); }
  .lg-sec + .lg-sec { margin-top: 21px; }
  .lg-n { color: var(--pdeep); }
  .lg-st { --h3: 30px; --h3m: 22px; margin-top: 7px; }
  .lg-p { margin-top: 10px; font-size: 18px; line-height: 1.6; }
  .lg-p :global(a) { text-decoration: underline; text-underline-offset: 3px; }
  .lg-q { padding: 80px 0 100px; }
  .lg-q-in { display: grid; grid-template-columns: 680px 1fr; align-items: start; }
  .lg-qk { color: var(--powder); }
  .lg-qh { --h2: 48px; --h2m: 28px; margin-top: 13px; line-height: 1.04; }
  .lg-q-in > div:last-child { padding-top: 16px; }
  @media (max-width: 1279px) { .lg-in { grid-template-columns: 260px minmax(0, 1fr); } .lg-q-in { grid-template-columns: 1fr auto; gap: 32px; } }
  @media (max-width: 1023px) { .lg-in { grid-template-columns: 1fr; } .lg-rail { display: none; } }
  @media (max-width: 767px) {
    .lg-hero { padding: 40px 0 40px; }
    .lg-hero :global(.lg-eb) { margin-top: 0; }
    .lg-h { margin-top: 10px; }
    .lg-lead { margin-top: 16px; font-size: 15px; }
    .lg-body { padding: 40px 0 34px; }
    .lg-sec { padding-bottom: 14px; }
    .lg-sec + .lg-sec { margin-top: 14px; }
    .lg-n { --monom: 10px; }
    .lg-st { margin-top: 9px; }
    .lg-p { font-size: 15px; }
    .lg-q { padding: 40px 0 40px; }
    .lg-q-in { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .lg-qk { --monom: 10px; }
    .lg-qh { margin-top: 9px; }
    .lg-q-in > div:last-child { padding-top: 0; }
  }
</style>
