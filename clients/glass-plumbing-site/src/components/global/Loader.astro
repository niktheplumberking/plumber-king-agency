---
// First-visit-per-session loader, "Clear Water" (revision round 2: same family as the page curtain, kit/Curtain.astro;
// no blinds). The screen is the housing: powder, deep and clear-frost water rise with the load count (kit/water.ts), and
// a spec plate with Kody's logo and a mono gauge "042 / 100" floats in the middle. At 100 the screen is full, the plate
// sinks and the water drains down and away (the curtain's reveal), so the page appears from the top. HUD lines in
// JetBrains Mono: the business top left, Largo / Pinellas top right. Shown only under html.intro (Base.astro: once per
// session, never under reduced motion). Click, tap or any key skips. Driven by kit/loader.ts (runLoader).
import { Image } from 'astro:assets';
import logo from '../../assets/brand/logo-glass.png';
import Water from '../kit/Water.astro';
import { SITE } from '../../data/site';
---
<div class="ld" data-loader aria-hidden="true">
  <Water class="ld-water" empty />
  <div class="ld-plate">
    <i class="ld-rv ld-rv1"></i><i class="ld-rv ld-rv2"></i><i class="ld-rv ld-rv3"></i><i class="ld-rv ld-rv4"></i>
    <span class="ld-logo"><Image src={logo} alt="" width={200} widths={[150, 200, 400]} sizes="(max-width: 767px) 150px, 200px" loading="eager" fetchpriority="low" /></span>
    <p class="ld-gauge"><span data-ld-num>000</span> / 100</p>
  </div>
  <p class="ld-hud ld-tl">{SITE.name}</p>
  <p class="ld-hud ld-tr"><span class="ld-dot"></span>{SITE.city}, {SITE.region} · {SITE.county}</p>
  <button type="button" class="ld-skip" data-loader-skip tabindex="-1">Skip intro →</button>
</div>
<style>
  .ld { display: none; }
  :global(html.intro) .ld { display: block; position: fixed; inset: 0; z-index: var(--z-loader); color: var(--ink); overflow: hidden; background: var(--white); }
  :global(html.intro) .ld.is-open { background: transparent; }
  .ld-plate { position: absolute; left: 50%; top: 50%; translate: -50% -50%; z-index: 2; display: flex; flex-direction: column; align-items: center;
    padding: 28px 36px 22px; background: var(--white); border: 2px solid var(--ink); border-radius: 6px; box-shadow: 8px 8px 0 var(--powder); }
  .ld-rv { position: absolute; width: 6px; height: 6px; border-radius: 50%; background: var(--steel2); box-shadow: inset 0 0 0 1px var(--ink); }
  .ld-rv1 { left: 8px; top: 8px; } .ld-rv2 { right: 8px; top: 8px; } .ld-rv3 { left: 8px; bottom: 8px; } .ld-rv4 { right: 8px; bottom: 8px; }
  .ld-logo { display: block; width: 200px; }
  .ld-logo :global(img) { width: 100%; height: auto; display: block; }
  .ld-gauge { margin: 18px 0 0; font-family: var(--f-m); font-weight: 700; font-size: 13px; line-height: 16px; letter-spacing: .1em; color: var(--muted); font-variant-numeric: tabular-nums; }
  .ld-gauge span { color: var(--pdeep); }
  .ld-hud { position: absolute; z-index: 2; margin: 0; font-family: var(--f-m); font-weight: 500; font-size: 11px; line-height: 15px; letter-spacing: .06em; text-transform: uppercase; color: var(--ink); }
  .ld-tl { left: clamp(20px, 4vw, 48px); top: clamp(20px, 4vh, 40px); font-weight: 700; }
  .ld-tr { right: clamp(20px, 4vw, 48px); top: clamp(20px, 4vh, 40px); display: flex; align-items: center; gap: 8px; }
  .ld-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--pdeep); }
  .ld-skip { position: absolute; z-index: 2; right: clamp(12px, 4vw, 40px); bottom: clamp(10px, 4vh, 30px); min-height: 44px; padding: 0 12px; font-family: var(--f-m); font-weight: 700; font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: var(--ink); background: var(--white); border-radius: 4px; transition: color .3s; }
  .ld-skip:hover { color: var(--pdeep); }
  @media (max-width: 767px) {
    .ld-plate { padding: 22px 26px 18px; box-shadow: 6px 6px 0 var(--powder); }
    .ld-logo { width: 150px; }
    .ld-tr { display: none; }
  }
</style>
