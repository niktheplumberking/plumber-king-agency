---
// Home areas, fix round A (independent R2 review MAJOR 3: home Areas was "map + plate" again, the /areas page owns the
// map). Rebuilt as a different object: THE DISPATCH BOARD. A split-flap board in a steel housing frame ("Leaving Largo"),
// one row per town: town, straight-line miles from the Largo base (towns.ts, LOCAL-FACTS 1), and a link where a town page
// exists. Four region keys (Central / North / South / Beaches: real radios) flip the board to that region; the letters
// roll through the flaps like a station board. On first view the board flips in once (scroll-triggered, never a loop,
// so no pause is needed). The base plate bolts over the board's top-left corner (depth layer).
// 21st.dev: @harshjadhavconnect/split-flap-display (label/value rows) + @manuarora700/text-flipping-board (flip timing);
// shortlist also @ridemountainpig/departures-board (status filter). Adapted: no React, vanilla TS, Glass ink/steel/powder.
// No JS: the radios still switch the board (CSS :has), letters static. Reduced motion: switches are instant.
import Eyebrow from '../kit/Eyebrow.astro';
import Plate from '../kit/Plate.astro';
import { TOWNS } from '../../data/towns';
const GROUPS = ['Central', 'North', 'South', 'Beaches'] as const;
const W = 18; // flap cells for the town name (longest: "Indian Rocks Beach")
const ROWS = Math.max(...GROUPS.map((g) => TOWNS.filter((t) => t.group === g).length)); // 7
const pad = (s: string, n: number) => (s.toUpperCase() + ' '.repeat(n)).slice(0, n);
const padL = (s: string, n: number) => (' '.repeat(n) + s).slice(-n);
const boards = GROUPS.map((g) => {
  const ts = TOWNS.filter((t) => t.group === g).sort((a, b) => a.mi - b.mi);
  return { g, ts, rows: Array.from({ length: ROWS }, (_, i) => ts[i]) };
});
const SEL = 0;
---
<section class="ar" aria-labelledby="ar-h" data-m-section>
  <div class="wrap">
    <div class="ar-head">
      <Eyebrow text="Where we work" />
      <h2 id="ar-h" class="h2 ar-h" data-t="2">Based in Largo. <span class="tone">All of Pinellas.</span></h2>
      <p class="note" data-t="3">Pick a part of the county. Miles are straight-line from our base in Largo, not driving miles.</p>
    </div>

    <div class="dsp" data-dsp data-no-px data-t="4">
      <div class="keys" role="radiogroup" aria-label="Part of Pinellas County">
        {boards.map((b, i) => (
          <label class="key">
            <input type="radio" name="ar-region" value={b.g} checked={i === SEL} data-region={i} />
            <span class="key-l">{b.g}</span><span class="key-n">{b.ts.length} towns</span>
          </label>
        ))}
      </div>

      <div class="frame">
        <div class="bplate"><Plate title="Glass Plumbing" rows={[['Base', 'Largo, FL'], ['Covers', 'All of Pinellas']]} w={232} wm={196} pad={12} padm={10} size={10} sizem={9} kx={76} kxm={66} pitch={19} pitchm={17} shadow="powder" /></div>
        <div class="board" style={`--w:${W}`}>
          <p class="bhd" aria-hidden="true"><span class="bh-t">Leaving Largo for</span><span class="bh-m">Miles</span><span class="bh-g">Town page</span></p>
          <div class="sets">
            {boards.map((b, i) => (
              <ol class:list={['set', { on: i === SEL }]} data-set={i} aria-label={`${b.g} Pinellas: towns and straight-line miles from Largo`}>
                {b.rows.map((t) => (
                  <li class:list={['row', { empty: !t }]} aria-hidden={t ? undefined : 'true'}>
                    <span class="cells town" aria-hidden="true">{[...pad(t ? t.name : '', W)].map((c) => <span class="c">{c}</span>)}</span>
                    <span class="cells mi" aria-hidden="true">{[...padL(t ? t.mi.toFixed(1) : '', 4)].map((c) => <span class="c">{c}</span>)}</span>
                    {t && <span class="sr-only">{t.name}, {t.mi.toFixed(1)} miles</span>}
                    <span class="go">{t?.page ? <a href={t.page}>Seminole page<span aria-hidden="true"> →</span></a> : t ? <span class="dash" aria-hidden="true">·</span> : null}</span>
                  </li>
                ))}
              </ol>
            ))}
          </div>
          <p class="bft"><span>Straight-line miles · Census 2024 town points</span><a href="/areas">Every town on the map →</a></p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Split-flap: one writer per cell (its textContent and the .f class that runs the CSS flap). Switching region flips the
  // newly shown set's cells from scrambled letters to their real ones, row by row; reduced motion swaps at once.
  const dsp = document.querySelector<HTMLElement>('[data-dsp]');
  if (dsp) {
    const html = document.documentElement;
    const sets = Array.from(dsp.querySelectorAll<HTMLElement>('[data-set]'));
    const radios = Array.from(dsp.querySelectorAll<HTMLInputElement>('[data-region]'));
    const ABC = 'ABCDEFGHIJKLMNOPRSTUVWY0123456789.';
    let run = 0;
    const flip = (set: HTMLElement) => {
      if (!html.classList.contains('motion')) return;
      const my = ++run;
      const cells = Array.from(set.querySelectorAll<HTMLElement>('.c'));
      cells.forEach((c) => { c.dataset.v ??= c.textContent || ' '; });
      cells.forEach((c, k) => {
        const v = c.dataset.v!; const row = Array.from(set.children).indexOf(c.closest('.row')!);
        const col = Array.from(c.parentElement!.parentElement!.querySelectorAll('.c')).indexOf(c);
        const start = row * 70 + col * 18; const turns = v === ' ' ? 1 : 3 + (k % 3);
        for (let s = 0; s <= turns; s++) {
          window.setTimeout(() => {
            if (my !== run) { c.textContent = v; return; }
            c.textContent = s === turns ? v : (v === ' ' ? ' ' : ABC[(Math.random() * ABC.length) | 0]);
            c.classList.remove('f'); void c.offsetWidth; c.classList.add('f');
          }, start + s * 70);
        }
      });
    };
    const show = (i: number) => { sets.forEach((s, k) => s.classList.toggle('on', k === i)); flip(sets[i]); };
    radios.forEach((r) => r.addEventListener('change', () => { if (r.checked) show(Number(r.dataset.region)); }));
    dsp.classList.add('is-js');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => {
        if (es.some((e) => e.isIntersecting)) { io.disconnect(); const k = radios.findIndex((r) => r.checked); flip(sets[Math.max(0, k)]); }
      }, { threshold: 0.4 });
      io.observe(dsp.querySelector('.board')!);
    }
  }
</script>

<style>
  .ar { position: relative; background: var(--frost); padding: 128px 0 120px; }
  .ar-head { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .ar-h { margin-top: 16px; } .ar-h .tone { display: block; }
  .note { max-width: 520px; margin-top: 18px; font-size: 16px; line-height: 1.5; color: var(--muted); }

  .dsp { max-width: 1040px; margin: 44px auto 0; }
  /* Region keys: real radios as steel keys; the picked one fills powder-deep. */
  .keys { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; }
  .key { position: relative; display: flex; flex-direction: column; justify-content: center; min-width: 150px; min-height: 60px; padding: 8px 18px; border: 2px solid var(--ink); border-radius: 8px;
    background: var(--steel); color: var(--ink); cursor: pointer; box-shadow: 4px 4px 0 var(--ink);
    transition: background-color .45s var(--ease-io), color .45s var(--ease-io), translate .45s var(--ease-io), box-shadow .45s var(--ease-io); }
  .key input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .key-l { font: 800 18px/1.1 var(--f-h); letter-spacing: -.01em; }
  .key-n { margin-top: 3px; font: 500 10px/13px var(--f-m); letter-spacing: .06em; text-transform: uppercase; opacity: .8; }
  .key:hover { translate: -1px -1px; box-shadow: 5px 5px 0 var(--ink); }
  .key:has(input:checked) { background: var(--pdeep); color: var(--white); translate: 2px 2px; box-shadow: 2px 2px 0 var(--ink); }
  .key:has(input:focus-visible) { outline: 3px solid var(--pdeep); outline-offset: 4px; }

  /* The board in its steel frame. */
  .frame { position: relative; margin-top: 56px; padding: 18px; border: 2px solid var(--ink); border-radius: 16px; background: linear-gradient(180deg, #D6DCDF, var(--steel) 60%, #B9C1C5); box-shadow: 14px 14px 0 var(--powder); }
  .bplate { position: absolute; z-index: 3; left: -40px; top: -78px; rotate: -3deg; }
  .board { --cw: 30px; --ch: 42px; padding: 26px 28px 18px; border-radius: 8px; background: var(--ink); color: var(--white); }
  .bhd { display: grid; grid-template-columns: calc(var(--w) * var(--cw) + (var(--w) - 1) * 3px) calc(4 * var(--cw) + 9px) 1fr; column-gap: 22px; padding: 0 0 12px;
    font: 700 10px/13px var(--f-m); letter-spacing: .1em; text-transform: uppercase; color: var(--powder); }
  .bh-m { text-align: right; } .bh-g { text-align: right; }
  .sets { display: grid; }
  .set { grid-area: 1 / 1; margin: 0; padding: 0; list-style: none; visibility: hidden; }
  .set.on { visibility: visible; }
  .dsp:not(.is-js) .set { visibility: hidden; }
  .dsp:not(.is-js):has(.key:nth-child(1) input:checked) .set:nth-child(1),
  .dsp:not(.is-js):has(.key:nth-child(2) input:checked) .set:nth-child(2),
  .dsp:not(.is-js):has(.key:nth-child(3) input:checked) .set:nth-child(3),
  .dsp:not(.is-js):has(.key:nth-child(4) input:checked) .set:nth-child(4) { visibility: visible; }
  .row { display: grid; grid-template-columns: auto auto 1fr; align-items: center; column-gap: 22px; padding: 4px 0; border-top: 1px solid var(--ink3); }
  .cells { display: flex; gap: 3px; }
  .c { position: relative; display: grid; place-items: center; width: var(--cw); height: var(--ch); border-radius: 3px; background: var(--ink2); box-shadow: inset 0 0 0 1px var(--ink3);
    font: 700 22px/1 var(--f-m); color: var(--white); white-space: pre; perspective: 200px; }
  .c::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: rgb(0 0 0 / .55); }
  .mi .c { color: var(--powder); }
  .row.empty .c { background: rgb(36 33 28 / .55); }
  .c.f { animation: flap .14s var(--ease-io); }
  @keyframes flap { 0% { transform: rotateX(0); } 50% { transform: rotateX(-80deg); } 100% { transform: rotateX(0); } }
  .go { justify-self: end; font: 700 12px/1 var(--f-m); letter-spacing: .04em; text-transform: uppercase; }
  .go a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 14px; border-radius: 6px; background: var(--powder); color: var(--ink); text-decoration: none; transition: background-color .35s var(--ease-io); }
  .go a:hover { background: var(--white); }
  .go a:focus-visible { outline: 3px solid var(--powder); outline-offset: 3px; }
  .dash { color: var(--ink3); font-size: 18px; }
  .row:not(.empty):hover .town .c { background: var(--ink3); }
  .bft { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 6px 16px; margin-top: 10px; padding-top: 8px; border-top: 1px solid var(--ink3);
    font: 500 10px/13px var(--f-m); letter-spacing: .06em; text-transform: uppercase; color: rgb(255 255 255 / .7); }
  .bft a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 700; font-size: 12px; color: var(--powder); text-decoration: underline; text-underline-offset: 4px; }
  .bft a:hover { color: var(--white); }

  @media (min-width: 768px) and (max-width: 1100px) {
    .board { --cw: 24px; --ch: 34px; padding: 22px 20px 14px; }
    .c { font-size: 17px; }
    .bplate { left: -12px; }
  }
  @media (max-width: 767px) {
    .ar { padding: 64px 0 80px; }
    .ar-h { margin-top: 10px; }
    .note { margin-top: 10px; font-size: 14px; }
    .dsp { margin-top: 28px; }
    .keys { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .key { min-width: 0; min-height: 54px; padding: 6px 12px; box-shadow: 3px 3px 0 var(--ink); }
    .key-l { font-size: 16px; }
    .frame { margin-top: 76px; padding: 8px; border-radius: 12px; box-shadow: 8px 8px 0 var(--powder); }
    .bplate { left: -6px; top: -66px; rotate: -2deg; }
    /* Phones: the town strip takes the full width; miles and the town-page link sit on a second line. */
    .board { --cw: calc((100vw - 2 * var(--gutter) - 16px - 20px - 17 * 2px) / 18); --ch: calc(var(--cw) * 1.5); padding: 12px 10px 6px; }
    .cells { gap: 2px; }
    .c { font-size: calc(var(--cw) * .74); border-radius: 2px; }
    .row { grid-template-columns: auto 1fr; row-gap: 4px; column-gap: 10px; padding: 6px 0; }
    .town { grid-column: 1 / -1; }
    .row.empty { display: none; }
    .go a { min-height: 44px; font-size: 11px; }
    .bhd { grid-template-columns: 1fr auto; }
    .bh-m, .bh-g { display: none; }
    .bft { font-size: 9px; }
  }
</style>
