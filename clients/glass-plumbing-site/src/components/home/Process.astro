---
// Home process, R4 (independent re-check R3 MAJOR 1; Nick 20 Nov: "idea is good (5 steps, no surprises), but the layout is
// shit, and it does not show anything interactable"). The R2/R3 pinned pipe that filled with the scroll was Mike's home
// Process device (scrub.ts water along a pipe, stops light) and WhProcess repeated it. New idea, THE JOB PAD: the five steps
// are the five pages of one top-bound job pad lying on the ink band. Only the top page is readable; the pages under it show
// as paper edges. "Next" (on the page), a tick box under the pad, a swipe up / left on the pad, or the arrow keys turn the
// page: it flips up over the binding (CSS 3D rotateX about the top edge, 0.7 s ease-in-out) and the next page rises to the
// top; "Back" flips the last page down again. Each page you pass ticks its box in the "No surprises" row under the pad.
// 21st.dev: "3D Journal Page Carousel" (@kedhareswer, id 44662: pages turned by click, drag or arrow keys, the rest in a
// receding stack) + "Photo Deck" (@sajad, id 46730: step through a stack, counter and caption hand over), rebuilt in
// vanilla TS + CSS 3D, re-skinned: white ruled paper, powder margin rule, steel binding bar with rivets, powder offset shadow.
// Nearest match: Mike about ANext (a wall calendar: ONE page swings on scroll, nothing to touch), Mike FinalCta / Tickets
// (job tickets: a form and hover cards), Khinda HubTrack (cards land on a pile with the scroll), Glass WhWhy (a leaflet that
// unfolds), Glass home Crew card (one card turns over sideways). None is a pad of pages you turn yourself, one at a time.
// Facts: hedged as before (permit step "usually", Largo / Clearwater / county; "Price first" stays for Kody to confirm).
// No JS: the five pages are listed one under another. Reduced motion: pages swap with no flip. The section still ends on
// ink, so the meniscus seam into Emergency (Emergency.astro, Nick's keep list) is unchanged.
import Btn from '../kit/Btn.astro';
import Eyebrow from '../kit/Eyebrow.astro';
import Plate from '../kit/Plate.astro';
import { quote } from './fig';
type Step = { t: string; s: string; d: string; q?: { name: string; text: string }; plate?: [string, string][] };
const steps: Step[] = [
  { t: 'Call or text a photo', s: 'Call or text', d: 'Any hour. A photo helps us bring the right part.',
    q: quote('Jen James', 'I took a few pictures of the valve that needed replaced and he was at my home the next day !!') },
  { t: 'We come out', s: 'We come out', d: 'The Glass crew, in the white van.',
    q: quote('John Rooney', 'He always does a great job and shows up when he says he’s going to, with the right equipment and attitude.') },
  { t: 'Price before any work', s: 'Price first', d: 'You hear the price and the plan first.',
    q: quote('Parker L', 'Kody came out the same day I called to give an estimate, and returned the next day to do the work.') },
  // Fix round A (LOCAL-FACTS 3): hedged. Largo and Clearwater run their own building divisions; the county covers
  // unincorporated Pinellas. "Usually" because the research only infers which jobs need one.
  { t: 'Permit if needed', s: 'Permit', d: 'Water heater swaps and repipes usually need one. Largo and Clearwater issue their own; the county covers unincorporated Pinellas. We tell you on the call if yours needs one.',
    plate: [['Usually', 'Heater swaps · repipes'], ['Issued by', 'Your city or county'], ['Filed by', 'A licensed contractor']] },
  { t: 'Fixed and tested', s: 'Fixed & tested', d: 'We test it with you before we go.',
    q: quote('Jacob Gars', 'He even went above and beyond to clean the bathroom spotless after!') },
];
const pad = (i: number) => String(i + 1).padStart(2, '0');
---
<section class="pr on-ink" aria-labelledby="pr-h" data-m-section>
  <div class="wrap">
    <div class="pr-head">
      <Eyebrow text="How a job goes" class="pr-eb" />
      <h2 id="pr-h" class="h2 pr-h" data-t="2">Five steps. <span class="tone">No surprises.</span></h2>
      <p class="pr-lead" data-t="3">One page per step, in order. <span class="js-only">Turn the pages.</span></p>
    </div>

    <div class="jp" data-jp data-t="4" data-fx="up">
      <div class="jp-bind" aria-hidden="true"><i></i><span>Job pad · Glass Plumbing</span><i></i></div>
      <ol class="jp-pages" role="list" aria-label="The five steps">
        {steps.map((s, i) => (
          <li class:list={['pg', i === 0 && 'is-top']} id={`pr-p${i}`} data-pg style={`--d:${i}`}>
            <div class="pg-in">
              <p class="pg-k"><span>Step {pad(i)} <span class="pg-of">/ 05</span></span><span class="pg-s">{s.s}</span></p>
              <h3 class="pg-t" tabindex="-1">{s.t}</h3>
              <p class="pg-d">{s.d}</p>
              {s.q
                ? <figure class="pg-q"><blockquote><p>“{s.q.text}”</p></blockquote><figcaption>{s.q.name} · Google</figcaption></figure>
                : <div class="pg-pl"><Plate title="Permits" rows={s.plate!} w={300} wm={270} pad={14} size={11} kx={104} pitch={21} kxm={92} shadow="ink" tone="steel" /></div>}
              <div class="pg-nav js-only">
                {i > 0 && <button type="button" class="pg-b pg-back" data-jp-go={i - 1}><span aria-hidden="true">←</span> Back</button>}
                {i < steps.length - 1
                  ? <button type="button" class="pg-b pg-next" data-jp-go={i + 1}>Next: {steps[i + 1].s} <span aria-hidden="true">↑</span></button>
                  : <button type="button" class="pg-b pg-next" data-jp-go="0">Back to step 01 <span aria-hidden="true">↺</span></button>}
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <div class="jp-ticks js-only" data-t="4">
      <p class="jp-tl" aria-hidden="true">No surprises</p>
      <ol class="jp-row" role="list" aria-label="Go to a step">
        {steps.map((s, i) => (
          <li><button type="button" class:list={['tk', i === 0 && 'is-cur']} data-jp-go={i} aria-controls={`pr-p${i}`} aria-current={i === 0 ? 'step' : undefined}>
            <span class="tk-box" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3 8.5l3.2 3.2L13 4.6" /></svg></span>
            <span class="tk-n" aria-hidden="true">{pad(i)}</span><span class="tk-l"><span class="sr-only">Step {i + 1}: </span>{s.s}</span>
          </button></li>
        ))}
      </ol>
      <p class="sr-only" aria-live="polite" data-jp-live></p>
    </div>

    <div class="bar" data-t="3">
      <div class="bar-t"><p class="bt">Step 1 starts here.</p><p class="bs">Call or text any hour</p></div>
      <div class="bar-b">
        <Btn look="line" icon="camera" label="Text a photo" sub="TO (727) 512-0673" arrow size="l" w={240} wm={350} class="b-text" />
        <Btn sub="CALL NOW · 24/7" size="l" w={280} wm={350} class="b-call" />
      </div>
    </div>
  </div>
</section>

<script>
  // The job pad: one state (cur). Pages before cur are flipped up over the binding (.is-up), cur is on top (.is-top), the
  // rest wait under it (--d = depth). Inactive pages are inert, so only the top page's buttons can be reached.
  document.querySelectorAll<HTMLElement>('[data-jp]').forEach((jp) => {
    const sec = jp.closest('section')!;
    sec.classList.add('jp-on');
    const pages = Array.from(jp.querySelectorAll<HTMLElement>('[data-pg]'));
    const ticks = Array.from(sec.querySelectorAll<HTMLButtonElement>('.tk'));
    const live = sec.querySelector<HTMLElement>('[data-jp-live]');
    const n = pages.length;
    let cur = 0;
    const show = (k: number, focus = false) => {
      cur = Math.max(0, Math.min(n - 1, k));
      pages.forEach((p, i) => {
        p.classList.toggle('is-up', i < cur); p.classList.toggle('is-top', i === cur);
        p.style.setProperty('--d', String(Math.max(0, i - cur)));
        p.inert = i !== cur; p.setAttribute('aria-hidden', String(i !== cur));
      });
      ticks.forEach((t, i) => {
        t.classList.toggle('is-done', i < cur); t.classList.toggle('is-cur', i === cur);
        if (i === cur) t.setAttribute('aria-current', 'step'); else t.removeAttribute('aria-current');
      });
      if (live) live.textContent = `Step ${cur + 1} of ${n}: ${pages[cur].querySelector('.pg-t')!.textContent}`;
      if (focus) pages[cur].querySelector<HTMLElement>('.pg-next')?.focus({ preventScroll: true });
    };
    sec.querySelectorAll<HTMLButtonElement>('[data-jp-go]').forEach((b) => b.addEventListener('click', () => show(Number(b.dataset.jpGo), !!b.closest('[data-pg]'))));
    jp.addEventListener('keydown', (e) => {
      const k = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? cur + 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? cur - 1 : e.key === 'Home' ? 0 : e.key === 'End' ? n - 1 : null;
      if (k === null || (e.target as HTMLElement).closest('a')) return;
      e.preventDefault(); show(k, true);
    });
    // Swipe on the pad: up or left = next, down or right = back (a deliberate 48 px stroke; taps stay taps).
    let sx = 0, sy = 0, on = false;
    jp.addEventListener('pointerdown', (e) => { if (e.pointerType === 'mouse') return; on = true; sx = e.clientX; sy = e.clientY; });
    jp.addEventListener('pointerup', (e) => {
      if (!on) return; on = false;
      const dx = e.clientX - sx, dy = e.clientY - sy;
      if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.4) show(cur + (dx < 0 ? 1 : -1));
    });
    jp.addEventListener('pointercancel', () => { on = false; });
    show(0);
  });
</script>

<style>
  .pr { position: relative; background: var(--ink); color: var(--white); padding: 110px 0 110px; }
  .pr-head { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .pr-h { margin-top: 16px; color: var(--white); }
  .pr-lead { margin-top: 14px; font-size: 17px; line-height: 1.5; color: rgb(255 255 255 / .85); }
  .js-only { display: none; }
  .jp-on .js-only { display: revert; }
  .jp-on .pg-nav.js-only { display: flex; }
  .jp-on .jp-ticks.js-only { display: flex; }

  /* The pad: a steel binding bar on top, white ruled pages under it. */
  .jp { position: relative; width: min(820px, 100%); margin: 48px auto 0; }
  .jp-bind { position: relative; z-index: 30; display: flex; align-items: center; justify-content: center; gap: 18px; height: 46px; margin: 0 -14px; border-radius: 6px;
    background: var(--steel); box-shadow: inset 0 0 0 1px var(--steel2), 0 6px 0 var(--ink3); color: var(--ink); font: 700 11px/1 var(--f-m); letter-spacing: .12em; text-transform: uppercase; }
  .jp-bind i { width: 10px; height: 10px; border-radius: 50%; background: var(--steel2); box-shadow: inset 0 0 0 1.5px rgb(22 19 15 / .35); }
  .jp-pages { margin: 0; padding: 0; list-style: none; }
  .pg { position: relative; background: var(--white); color: var(--ink); border-radius: 0 0 8px 8px; box-shadow: inset 0 0 0 1.5px var(--ink); }
  .pg + .pg { margin-top: 16px; border-radius: 8px; }
  .pg-in { position: relative; padding: 40px 56px 32px 88px; min-height: 100%;
    background: repeating-linear-gradient(transparent 0 31px, rgb(47 97 120 / .12) 31px 32px) 0 22px / 100% calc(100% - 44px) no-repeat; }
  .pg-in::before { content: ''; position: absolute; left: 60px; top: 0; bottom: 0; width: 2px; background: var(--powder); }
  .pg-k { display: flex; justify-content: space-between; gap: 16px; font: 700 12px/1 var(--f-m); letter-spacing: .08em; text-transform: uppercase; color: var(--pdeep); }
  .pg-of { color: var(--muted); }
  .pg-s { color: var(--ink); }
  .pg-t { margin-top: 14px; font: 800 44px/1.04 var(--f-h); letter-spacing: -.02em; color: var(--ink); outline: none; }
  .pg-d { margin-top: 14px; max-width: 600px; font-size: 18px; line-height: 1.5; color: var(--ink); }
  .pg-q { margin-top: 22px; padding: 16px 20px; border-left: 4px solid var(--pdeep); background: var(--frost); }
  .pg-q p { font: 700 20px/1.3 var(--f-h); letter-spacing: -.01em; color: var(--ink); }
  .pg-q figcaption { margin-top: 10px; font: 500 11px/1.3 var(--f-m); letter-spacing: .02em; color: var(--pdeep); }
  .pg-pl { margin-top: 22px; }
  .pg-nav { justify-content: space-between; gap: 12px; margin-top: 26px; padding-top: 18px; border-top: 1px dashed rgb(22 19 15 / .3); }
  .pg-b { display: inline-flex; align-items: center; gap: 8px; min-height: 48px; padding: 0 18px; border: 0; border-radius: 4px; cursor: pointer;
    font: 700 15px/1 var(--f-b); transition: background-color .35s var(--ease-io), color .35s var(--ease-io); }
  .pg-back { background: var(--white); color: var(--ink); box-shadow: inset 0 0 0 1.5px var(--ink); }
  .pg-next { margin-left: auto; background: var(--ink); color: var(--white); box-shadow: 4px 4px 0 var(--powder); }
  .pg-back:hover { background: var(--frost); }
  .pg-next:hover { background: var(--pdeep); }
  .pg-b:focus-visible { outline: 3px solid var(--pdeep); outline-offset: 3px; }

  /* With JS: one grid cell, the pages stacked; the pad keeps the tallest page's height, so nothing below jumps. */
  .jp-on .jp-pages { display: grid; perspective: 2000px; perspective-origin: 50% 0; filter: drop-shadow(14px 14px 0 var(--powder)); }
  .jp-on .pg { grid-area: 1 / 1; margin: 0; border-radius: 0 0 8px 8px; transform-origin: 50% 0; backface-visibility: hidden; -webkit-backface-visibility: hidden;
    z-index: calc(20 - var(--d)); transform: translateY(calc(min(var(--d), 3) * 12px)) scale(calc(1 - min(var(--d), 3) * .025));
    box-shadow: inset 0 0 0 1.5px var(--ink), 0 1px 0 var(--ink);
    transition: transform .7s var(--ease-io), opacity .7s var(--ease-io), visibility 0s linear 0s; }
  .jp-on .pg:not(.is-top) .pg-in > * { opacity: 0; transition: opacity .25s var(--ease-io); }
  .jp-on .pg.is-top .pg-in > * { opacity: 1; transition: opacity .35s var(--ease-io) .3s; }
  .jp-on .pg:nth-child(n + 5):not(.is-top):not(.is-up) { opacity: 0; }
  /* Turned: up and over the binding, toward you (rotateX about the top edge), then hidden behind it. */
  .jp-on .pg.is-up { z-index: 25; transform: rotateX(178deg); opacity: 0; visibility: hidden;
    transition: transform .7s var(--ease-io), opacity .2s linear .5s, visibility 0s linear .7s; }
  :global(html:not(.motion)) .jp-on .pg, :global(html:not(.motion)) .jp-on .pg .pg-in > * { transition: none; }

  /* The "No surprises" row: one tick box per step; passed steps are ticked. */
  .jp-ticks { flex-direction: column; align-items: center; margin-top: 36px; }
  .jp-tl { font: 700 11px/1 var(--f-m); letter-spacing: .12em; text-transform: uppercase; color: var(--powder); }
  .jp-row { display: flex; justify-content: center; gap: 10px; margin: 14px 0 0; padding: 0; list-style: none; }
  .tk { display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 14px 0 10px; border: 0; border-radius: 24px; background: var(--ink2); box-shadow: inset 0 0 0 1px var(--ink3);
    color: var(--white); font: 600 14px/1 var(--f-b); cursor: pointer; transition: background-color .4s var(--ease-io), box-shadow .4s var(--ease-io); }
  .tk:hover { box-shadow: inset 0 0 0 1.5px var(--powder); }
  .tk:focus-visible { outline: 3px solid var(--powder); outline-offset: 2px; }
  .tk-box { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 5px; box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / .7); transition: background-color .4s var(--ease-io); }
  .tk-box svg { width: 16px; height: 16px; fill: none; stroke: var(--ink); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 16; stroke-dashoffset: 16; transition: stroke-dashoffset .45s var(--ease-io) .1s; }
  .tk-n { font: 700 11px/1 var(--f-m); letter-spacing: .06em; color: var(--powder); }
  .tk.is-done .tk-box { background: var(--powder); box-shadow: none; }
  .tk.is-done .tk-box svg { stroke-dashoffset: 0; }
  .tk.is-cur { background: var(--white); color: var(--ink); }
  .tk.is-cur .tk-n { color: var(--pdeep); }
  .tk.is-cur .tk-box { box-shadow: inset 0 0 0 1.5px var(--ink); }
  :global(html:not(.motion)) .tk-box svg, :global(html:not(.motion)) .tk { transition: none; }

  .bar { display: flex; align-items: center; justify-content: space-between; height: 100px; margin-top: 56px; padding: 0 32px; border: 1px solid var(--ink3); border-radius: 6px; background: var(--ink2); }
  .bt { font-family: var(--f-h); font-weight: 800; font-size: 28px; line-height: 1.04; letter-spacing: -.02em; }
  .bs { margin-top: 8px; font-family: var(--f-m); font-weight: 700; font-size: 11px; line-height: 15px; letter-spacing: .06em; text-transform: uppercase; color: var(--powder); }
  .bar-b { display: flex; gap: 16px; }

  @media (min-width: 768px) and (max-width: 1279px) {
    .pg-t { font-size: 38px; }
    .tk { padding: 0 12px 0 8px; font-size: 13px; }
    .bar { flex-wrap: wrap; height: auto; padding: 24px; gap: 20px; }
  }
  @media (min-width: 768px) and (max-width: 1023px) { .tk-l { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; } }
  @media (max-width: 767px) {
    .pr { padding: 72px 0 80px; }
    .pr-h { margin-top: 10px; }
    .pr-h .tone { display: block; }
    .pr-lead { margin-top: 8px; font-size: 15px; }
    .jp { margin-top: 30px; }
    .jp-bind { height: 38px; margin: 0 -8px; gap: 10px; font-size: 9px; }
    .pg-in { padding: 24px 16px 18px 36px; background-position: 0 14px; }
    .pg-in::before { left: 20px; }
    .pg-k { font-size: 10px; }
    .pg-t { margin-top: 10px; font-size: 27px; }
    .pg-d { margin-top: 10px; font-size: 15px; }
    .pg-q { margin-top: 16px; padding: 12px 14px; }
    .pg-q p { font-size: 16px; }
    .pg-q figcaption { font-size: 10px; }
    .pg-pl { margin-top: 16px; }
    .pg-nav { margin-top: 18px; padding-top: 14px; }
    .pg-b { padding: 0 14px; font-size: 14px; }
    .jp-on .jp-pages { filter: drop-shadow(7px 7px 0 var(--powder)); }
    .jp-on .pg { transform: translateY(calc(min(var(--d), 3) * 8px)) scale(calc(1 - min(var(--d), 3) * .025)); }
    .jp-ticks { margin-top: 28px; }
    .jp-row { gap: 6px; }
    .tk { flex-direction: column; justify-content: center; gap: 4px; width: 56px; min-height: 60px; padding: 6px 0; border-radius: 10px; }
    .tk-l { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .bar { display: block; height: auto; margin-top: 32px; padding: 0; border: 0; background: none; }
    .bar-t { display: none; }
    .bar-b { flex-direction: column-reverse; gap: 12px; }
  }
</style>
