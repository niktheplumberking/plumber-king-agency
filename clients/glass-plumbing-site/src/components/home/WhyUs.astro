---
// Home "Why us", fix round 3 (D, RECHECK BLOCKER 2: the fridge door of notes and magnets copied Mike's /about AFamily).
// Nick's original complaint (R2): "text only, no stars, nothing builds credibility". New idea: FIVE STARS, OPENED.
// The 5.0 rating is drawn as five large stars; each star holds one whole Google review, word for word (quote() fails the
// build on any drift). Pick a star (tap, click, arrow keys) and it lifts, fills gold from the bottom like a glass filling,
// and its review opens on the paper card under it, with that review's own stars, date and profile. On first view the five
// stars fill one after another (5.0). Both Google profiles sit in the head, each with its own count (never added).
// 21st.dev: "Star Rate" (@ham7a311, id 43963: each selected star pops in, staggered, a line below says what the rating
// means) + "Star Rating" (@arihantcodes, id 29301: hover preview, rolling value), adapted: the stars are a tablist and the
// "line below" is the whole review. Vanilla TS, about 1 KB: one click/key handler and one IntersectionObserver (it
// disconnects after the first fill). No drag, no per-frame work.
// Nearest match: home Reviews (two housings + three cards), /reviews hero (a dealt deck), /reviews Mention (highlighted
// words), Mike home Reviews (spotlight carousel with a slide number) and Khinda Thermo (a ring that snaps to answers):
// none uses the rating stars themselves as the control. Reduced motion / no JS: all stars full, star 1's review open,
// the other four reviews listed under it.
import Eyebrow from '../kit/Eyebrow.astro';
import { STARS, quote } from './fig';
import { SITE } from '../../data/site';
import { REVIEWS } from '../../data/reviews';

const PICK = ['Kevin Kelleman', 'Michael Marks', 'Cody Weaver', 'Seth Nye', 'Peter Van Buskirk'];
const picks = PICK.map((n) => {
  const r = REVIEWS.find((x) => x.name === n)!;
  const q = quote(n, r.text); // the whole review, checked word for word
  return { ...q, when: r.when, profile: r.profile === 'a' ? 1 : 2 };
});
const g = SITE.google;
// Star outline (100 x 100 box), the same proportions as the gold Figma star.
const pts = Array.from({ length: 10 }, (_, i) => {
  const a = -Math.PI / 2 + (i * Math.PI) / 5, rad = i % 2 === 0 ? 48 : 20.6;
  return `${(50 + rad * Math.cos(a)).toFixed(2)},${(52 + rad * Math.sin(a)).toFixed(2)}`;
}).join(' ');
---
<section class="why" aria-labelledby="why-h" data-m-section>
  <svg class="why-defs" width="0" height="0" aria-hidden="true" focusable="false"><defs><clipPath id="why-star"><polygon points={pts} /></clipPath></defs></svg>
  <div class="wrap">
    <div class="why-head">
      <Eyebrow text="What the reviews say" class="why-eb" />
      <h2 id="why-h" class="h2 why-h" data-t="2">Five stars. <span class="tone">Open each one.</span></h2>
      <p class="why-rate" data-t="3">
        <span set:html={STARS(90, 15)} />
        <a href={g.a.url} target="_blank" rel="noopener">{g.a.value} · {g.a.count} reviews<span class="sr-only"> on Google profile 1 (opens in a new tab)</span></a>
        <span class="sep" aria-hidden="true">|</span>
        <a href={g.b.url} target="_blank" rel="noopener">{g.b.value} · {g.b.count} reviews<span class="sr-only"> on Google profile 2 (opens in a new tab)</span></a>
        <span class="why-k">Google · read {g.checked}</span>
      </p>
    </div>

    <div class="sky" data-sky data-t="4" data-no-px style="--sel:0">
      <div class="row" role="tablist" aria-label="Five Google reviews, one behind each star">
        {picks.map((p, i) => (
          <button type="button" role="tab" class="st" id={`why-t${i}`} aria-controls={`why-p${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-st={i} style={`--i:${i}`}>
            <svg class="st-g" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
              <g clip-path="url(#why-star)"><rect class="st-bg" width="100" height="100" /><rect class="st-w" width="100" height="100" /></g>
              <polygon class="st-o" points={pts} />
            </svg>
            <span class="st-n" aria-hidden="true">0{i + 1}</span>
            <span class="sr-only">Review {i + 1} of 5, by {p.name}</span>
          </button>
        ))}
      </div>
      <span class="notch" aria-hidden="true"></span>
      <div class="card">
        {picks.map((p, i) => (
          <div class="rv" id={`why-p${i}`} role="tabpanel" aria-labelledby={`why-t${i}`} data-rv={i} hidden={i !== 0 ? true : undefined}>
            <p class="rv-top"><span set:html={STARS(96, 16)} /><span class="sr-only">5 out of 5 stars.</span><span class="rv-w">Google · profile {p.profile} · {p.when}</span></p>
            <blockquote class="rv-q"><p>“{p.text}”</p></blockquote>
            <p class="rv-by"><span class="gm" aria-hidden="true">G</span><b>{p.name}</b><span class="rv-k" aria-hidden="true">Star 0{i + 1} of 05</span></p>
          </div>
        ))}
      </div>
    </div>
    <p class="why-foot" data-t="3"><a class="all" href="/reviews">Read all 16 reviews, word for word →</a></p>
  </div>
</section>
<script>
  // Tabs: the picked star lifts and fills (CSS, from aria-selected); its review shows. Without JS the panels stay visible
  // (the script hides 1-4 only when it runs, see the `hidden` handling below).
  const sky = document.querySelector<HTMLElement>('[data-sky]');
  if (sky) {
    const tabs = Array.from(sky.querySelectorAll<HTMLButtonElement>('[data-st]'));
    const pans = Array.from(sky.querySelectorAll<HTMLElement>('[data-rv]'));
    sky.classList.add('is-js');
    const pick = (i: number, focus = false) => {
      tabs.forEach((t, k) => { const on = k === i; t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1; });
      pans.forEach((p, k) => { p.hidden = k !== i; });
      sky.style.setProperty('--sel', String(i));
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => pick(i));
      t.addEventListener('keydown', (e) => {
        const n = tabs.length;
        const k = e.key === 'ArrowRight' ? (i + 1) % n : e.key === 'ArrowLeft' ? (i - 1 + n) % n : e.key === 'Home' ? 0 : e.key === 'End' ? n - 1 : -1;
        if (k < 0) return; e.preventDefault(); pick(k, true);
      });
    });
    // First view: the five stars fill one after another (motion only, and only if the row is still below the fold).
    if (document.documentElement.classList.contains('motion') && 'IntersectionObserver' in window && sky.getBoundingClientRect().top > innerHeight * .9) {
      sky.classList.add('is-armed');
      const io = new IntersectionObserver((es) => { if (es.some((x) => x.isIntersecting)) { sky.classList.add('is-in'); io.disconnect(); } }, { threshold: .3 });
      io.observe(sky);
      setTimeout(() => sky.classList.add('is-in'), 12000);
    }
  }
</script>
<style>
  .why { position: relative; background: var(--frost); padding: 112px 0 104px; }
  .why-defs { position: absolute; width: 0; height: 0; }
  .why-head { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .why-h { margin-top: 16px; } .why-h .tone { display: block; }
  .why-rate { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 6px 12px; margin-top: 18px; font-family: var(--f-m); font-weight: 700; font-size: 12px; letter-spacing: .04em; }
  .why-rate a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--frost3); }
  .why-rate a:hover { text-decoration-color: currentColor; color: var(--pdeep); }
  .why-k { font-weight: 500; color: var(--muted); text-transform: uppercase; }

  /* The stars: one row, centred; each a tab. The gold "water" (rect .st-w) rises inside the star clip. */
  .sky { --sel: 0; position: relative; max-width: 920px; margin: 44px auto 0; }
  .row { display: grid; grid-template-columns: repeat(5, 1fr); }
  .st { position: relative; display: grid; justify-items: center; padding: 14px 0 26px; border: 0; background: none; cursor: pointer; color: var(--ink); -webkit-tap-highlight-color: transparent; }
  .st-g { width: 132px; height: 132px; overflow: visible; translate: 0 0; scale: .86; transition: translate .6s var(--ease-io), scale .6s var(--ease-io); }
  .st-bg { fill: var(--white); }
  .st-w { fill: #F9B50D; transform-box: view-box; transform: translateY(0%); transition: transform .8s var(--ease-io); }
  .st-o { fill: none; stroke: var(--ink); stroke-width: 3.2; stroke-linejoin: round; }
  .st-n { margin-top: 10px; font-family: var(--f-m); font-weight: 700; font-size: 11px; letter-spacing: .08em; color: var(--muted); transition: color .4s var(--ease-io); }
  .st[aria-selected='true'] .st-g { translate: 0 -10px; scale: 1; filter: drop-shadow(8px 8px 0 var(--powder)); }
  .st[aria-selected='true'] .st-n { color: var(--ink); }
  @media (hover: hover) and (pointer: fine) { .st:hover .st-g { scale: .94; } .st[aria-selected='true']:hover .st-g { scale: 1; } }
  .st:focus-visible { outline: none; }
  .st:focus-visible .st-o { stroke: var(--pdeep); stroke-width: 6; }
  /* JS: unpicked stars hold a little less water, the picked one is full (a glass filling). */
  .sky.is-js .st:not([aria-selected='true']) .st-w { transform: translateY(14%); }
  /* First fill (armed by the script only): empty, then one after another to full. */
  .sky.is-armed .st .st-w { transform: translateY(100%); }
  .sky.is-armed.is-in .st .st-w { transform: translateY(0%); transition-delay: calc(var(--i) * .16s); }
  .sky.is-armed.is-in .st:not([aria-selected='true']) .st-w { transform: translateY(14%); }

  /* The card: the notch points at the picked star (CSS only: --sel), the review is word for word. */
  .notch { position: absolute; top: calc(132px + 14px + 26px + 22px); left: calc((var(--sel) + .5) * 20%); z-index: 2; width: 28px; height: 28px; margin-left: -14px;
    background: var(--white); border-left: 2px solid var(--ink); border-top: 2px solid var(--ink); rotate: 45deg; transition: left .6s var(--ease-io); }
  .card { position: relative; margin-top: 8px; padding: 40px 48px 32px; border: 2px solid var(--ink); border-radius: 8px; background: var(--white); box-shadow: 12px 12px 0 var(--powder); min-height: 286px; }
  .sky:not(.is-js) .rv[hidden] { display: block; margin-top: 28px; padding-top: 24px; border-top: 1px dashed var(--frost3); }
  .rv { animation: why-in .55s var(--ease-io); }
  @keyframes why-in { from { opacity: 0; translate: 0 10px; } to { opacity: 1; translate: 0 0; } }
  :global(html:not(.motion)) .rv { animation: none; }
  :global(html:not(.motion)) .st-g, :global(html:not(.motion)) .st-w, :global(html:not(.motion)) .notch { transition: none; }
  .rv-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px; }
  .rv-top > span:first-child { display: flex; }
  .rv-w { font-family: var(--f-m); font-weight: 700; font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .rv-q { margin: 18px 0 0; }
  .rv-q p { font-family: var(--f-h); font-weight: 600; font-size: 24px; line-height: 1.34; letter-spacing: -.012em; color: var(--ink); text-wrap: pretty; }
  .rv-by { display: flex; align-items: center; gap: 12px; margin-top: 22px; padding-top: 16px; border-top: 1px dashed rgb(22 19 15 / .3); font-size: 16px; }
  .rv-by b { font-family: var(--f-h); font-weight: 800; letter-spacing: -.015em; }
  .rv-k { margin-left: auto; font-family: var(--f-m); font-weight: 700; font-size: 11px; letter-spacing: .08em; color: var(--pdeep); }
  .gm { display: grid; place-items: center; flex: none; width: 28px; height: 28px; border-radius: 50%; background: var(--ink); color: var(--white); font: 800 15px/1 var(--f-h); }
  .why-foot { display: flex; justify-content: center; margin-top: 36px; }
  .all { display: inline-flex; align-items: center; min-height: 44px; font-weight: 700; font-size: 15px; color: var(--pdeep); text-decoration: underline; text-underline-offset: 4px; }
  .all:hover { color: var(--ink); }

  @media (min-width: 768px) and (max-width: 1023px) {
    .st-g { width: 104px; height: 104px; }
    .notch { top: calc(104px + 14px + 26px + 22px); }
    .card { padding: 32px 32px 26px; }
    .rv-q p { font-size: 21px; }
  }
  @media (max-width: 767px) {
    .why { padding: 72px 0 72px; }
    .why-h { margin-top: 10px; }
    .why-rate { font-size: 11px; gap: 0 10px; }
    .sep { display: none; }
    .sky { margin-top: 26px; }
    .st { padding: 8px 0 16px; }
    .st-g { width: 58px; height: 58px; }
    .st[aria-selected='true'] .st-g { translate: 0 -6px; filter: drop-shadow(4px 4px 0 var(--powder)); }
    .st-o { stroke-width: 4.5; }
    .st-n { margin-top: 6px; font-size: 10px; }
    .notch { top: calc(58px + 8px + 16px + 22px); width: 20px; height: 20px; margin-left: -10px; }
    .card { margin-top: 2px; padding: 26px 18px 20px; box-shadow: 7px 7px 0 var(--powder); min-height: 0; }
    .rv-q { margin-top: 14px; }
    .rv-q p { font-size: 18px; line-height: 1.4; }
    .rv-top :global(svg) { width: 80px; height: 13px; }
    .rv-w { font-size: 10px; }
    .rv-by { flex-wrap: wrap; gap: 8px 10px; font-size: 15px; }
    .rv-k { margin-left: 0; width: 100%; }
    .all { font-size: 14px; text-align: center; }
  }
</style>
