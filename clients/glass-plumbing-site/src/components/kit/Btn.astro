---
// Btn: the ONE button (BUILD-BRIEF section 10). Measured from every "button ·" frame in the round-7 cache (19 Nov):
// radius 4; icon x 16 (wrench 20 px / camera 18 px), text x 46 / 44 (x 18 with no icon); label Public Sans Bold 16/21;
// optional second line JetBrains Mono Medium 11/15, +2 %, 80 % opacity, 2 px under the label (two-line text sits at y 10,
// one-line text is centred); trailing arrow 12 x 10, 18 px from the right edge. Call buttons carry a hard 4/4 offset
// shadow: ink on light sections, powder inside `.on-ink`.
//   look  'call'   red fill, white text, wrench, href defaults to tel:. RED IS FOR CALL BUTTONS AND "Call me back" ONLY.
//         'ink'    ink fill, white text (Send to Kody, Next, Follow on Instagram).
//         'line'   1.5 px ink outline, ink text; inside `.on-ink` it turns white (white outline, white text).
//         'light'  white fill, ink text (on ink: Google profile buttons, Instagram on thank-you).
//         'powder' powder fill, ink text (no frame uses it yet; kept for the contract).
//   size  'l' 64 (60 under 768) | 'm' 56 | 's' 48. `h` / `hm` override the height in px (desktop / mobile) for the odd
//         Figma heights (52, 58, 60).
//   w / wm  width in px at 1440 / under 768 (never wider than its container). `block` = 100 % width.
//   icon  'wrench' | 'camera' (the Figma glyphs) | any Icon.astro name | false. Defaults: call -> wrench; others none.
//         A camera button with no href defaults to sms: (Text a photo).
//   arrow trailing arrow (Figma "Vector" 12 x 10). shadow: true | false | 'ink' | 'powder' (default: call looks only).
//   type  given -> a real <button type=...> (forms); otherwise always an <a>.
//   t     motion tier (data-t), `fx` its data-fx. external = new tab (+ screen-reader note).
// Accessible name = the visible text; a tel: link whose text does not show the number gets ", (727) 512-0673" for screen
// readers, and a visible phone-number label gets "Call " in front (WCAG 2.5.3: the name starts with the visible label... the
// sr prefix is allowed because the label text is still contained).
import { SITE } from '../../data/site';
import Icon from '../ui/Icon.astro';
type Look = 'call' | 'ink' | 'line' | 'light' | 'powder';
interface Props {
  look?: Look; label?: string; sub?: string; href?: string; icon?: string | false; arrow?: boolean;
  size?: 'l' | 'm' | 's'; h?: number; hm?: number; w?: number; wm?: number; block?: boolean;
  shadow?: boolean | 'ink' | 'powder'; type?: 'button' | 'submit' | 'reset'; t?: string | false; fx?: string;
  external?: boolean; class?: string; [k: string]: any;
}
const {
  look = 'call', label, sub, href, icon, arrow = false, size = 'm', h, hm, w, wm, block = false, shadow, type,
  t, fx, external = false, class: cls, ...rest
} = Astro.props;
const ico = icon === undefined ? (look === 'call' ? 'wrench' : false) : icon;
const text = label ?? (look === 'call' ? SITE.phone : '');
if (!text) throw new Error('Btn: `label` is required for this look');
const link = href ?? (look === 'call' ? SITE.tel : ico === 'camera' ? SITE.sms : undefined);
if (!type && !link) throw new Error(`Btn "${text}": give an href (or a type for a form button)`);
const sh = shadow === undefined ? look === 'call' : shadow;
const showsPhone = `${text} ${sub ?? ''}`.includes(SITE.phone);
const isTel = !!link && link.startsWith('tel:');
const srBefore = isTel && text === SITE.phone ? 'Call ' : '';
const srAfter = [isTel && !showsPhone ? `, ${SITE.phone}` : '', external ? ' (opens in a new tab)' : ''].join('');
const style = [w && `--bw:${w}px`, wm && `--bwm:${wm}px`, h && `--bh:${h}px`, hm && `--bhm:${hm}px`].filter(Boolean).join(';') || undefined;
const classes = ['btn', `btn-${look}`, `btn--${size}`, sub && 'has-sub', ico && 'has-ico', block && 'btn-block',
  sh && 'btn-sh', typeof sh === 'string' && `btn-sh-${sh}`, cls];
const Tag = type ? 'button' : 'a';
const attrs = type ? { type } : { href: link, ...(external ? { target: '_blank', rel: 'noopener' } : {}) };
---
<Tag class:list={classes} style={style} data-t={t || undefined} data-fx={fx} {...attrs} {...rest}>
  {ico === 'wrench' && (
    <svg class="btn-ico btn-wrench" viewBox="0 0 21 21" width="20" height="20" aria-hidden="true" focusable="false"><path d="M11.708 4.513c-1.25-1.25-1.083-3.25.417-3.917l2 2h2v2l2 2c-.667 1.5-2.667 1.667-3.917.417l-9.75 9.75c-.833.833-2.5.833-3.333 0-.834-.834-.834-2.5 0-3.334l10.583-8.916Z" fill="#fff" stroke="#000"/></svg>
  )}
  {ico === 'camera' && (
    <svg class="btn-ico btn-camera" viewBox="0 0 18 18" width="18" height="18" aria-hidden="true" focusable="false"><rect x=".8" y="5.3" width="16.4" height="10.1" rx="2.2" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="9" cy="10.08" r="2.44" fill="none" stroke="currentColor" stroke-width="1.6"/><rect x="5.4" y="2.16" width="7.2" height="2.52" rx="1" fill="currentColor"/></svg>
  )}
  {ico && ico !== 'wrench' && ico !== 'camera' && <Icon name={ico} size={20} class="btn-ico" />}
  <span class="btn-txt">
    <span class="btn-lab">{srBefore && <span class="sr-only">{srBefore}</span>}{text}{srAfter && <span class="sr-only">{srAfter}</span>}</span>
    {sub && <span class="btn-sub">{sub}</span>}
  </span>
  {arrow && <svg class="btn-ar" viewBox="0 0 14 12" width="14" height="12" aria-hidden="true" focusable="false"><path d="M.9 5.9h12m-5 5 5-5-5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>}
</Tag>
<style>
  .btn {
    position: relative; display: inline-flex; align-items: center; gap: 10px; box-sizing: border-box;
    width: var(--bw, auto); max-width: 100%; height: var(--bh, 56px); min-height: 44px; padding: 0 24px 0 18px;
    border: 0; border-radius: 4px; background: transparent; color: var(--ink); text-align: left; text-decoration: none;
    font-family: var(--f-b); cursor: pointer; vertical-align: top; -webkit-tap-highlight-color: transparent;
    transition: background-color .3s var(--ease-io), color .3s var(--ease-io), box-shadow .3s var(--ease-io), translate .3s var(--ease-io);
  }
  .btn--l { height: var(--bh, 64px); }
  .btn--s { height: var(--bh, 48px); }
  .btn.has-ico { padding-left: 16px; }
  .btn-block { display: flex; width: 100%; }
  .btn[style*='--bw'] { padding-right: 18px; }
  .btn-txt { display: flex; flex-direction: column; min-width: 0; }
  .btn-txt > .btn-lab { font-weight: 700; font-size: 16px; line-height: 21px; white-space: nowrap; }
  .btn-txt > .btn-sub { margin-top: 2px; font-family: var(--f-m); font-weight: 500; font-size: 11px; line-height: 15px; letter-spacing: .02em; text-transform: uppercase; opacity: .8; white-space: nowrap; }
  /* Two-line buttons: Figma puts the label at y 10 at every height (56, 60, 64), so the text block is top-anchored. */
  .has-sub { align-items: flex-start; }
  .has-sub .btn-txt { padding-top: 10px; }
  .has-sub .btn-ico, .has-sub .btn-ar { align-self: center; }
  .btn-ico { flex: none; }
  .btn-camera { margin-right: 0; }
  .btn-ar { flex: none; margin-left: auto; margin-right: -2px; }

  .btn-call { background: var(--red); color: var(--white); }
  .btn-ink { background: var(--ink); color: var(--white); }
  .btn-line { box-shadow: inset 0 0 0 1.5px currentColor; color: var(--ink); }
  .btn-light { background: var(--white); color: var(--ink); }
  .btn-powder { background: var(--powder); color: var(--ink); }
  :global(.on-ink) .btn-line { color: var(--white); }
  .btn-sh { box-shadow: var(--shadow-ink); }
  :global(.on-ink) .btn-sh { box-shadow: var(--shadow-powder); }
  .btn-sh.btn-sh-ink { box-shadow: var(--shadow-ink); }
  .btn-sh.btn-sh-powder { box-shadow: var(--shadow-powder); }

  @media (hover: hover) and (pointer: fine) {
    .btn-call:hover { background: #9E2C31; }
    .btn-ink:hover { background: var(--ink3); }
    .btn-line:hover { background: var(--ink); color: var(--white); box-shadow: inset 0 0 0 1.5px var(--ink); }
    :global(.on-ink) .btn-line:hover { background: var(--white); color: var(--ink); box-shadow: inset 0 0 0 1.5px var(--white); }
    .btn-light:hover { background: var(--frost); }
    .btn-powder:hover { background: #9CC3D3; }
    :global(html.motion) .btn-sh:hover { translate: -2px -2px; box-shadow: 6px 6px 0 var(--ink); }
    :global(html.motion .on-ink) .btn-sh:hover, :global(html.motion) .btn-sh.btn-sh-powder:hover { box-shadow: 6px 6px 0 var(--powder); }
    :global(html.motion) .btn-sh.btn-sh-ink:hover { box-shadow: 6px 6px 0 var(--ink); }
    .btn:hover .btn-ar { translate: 4px 0; }
    .btn-ar { transition: translate .3s var(--ease-io); }
  }
  :global(html.motion) .btn-sh:active { translate: 2px 2px; box-shadow: 2px 2px 0 var(--ink); }
  :global(html.motion .on-ink) .btn-sh:active { box-shadow: 2px 2px 0 var(--powder); }
  .btn:focus-visible { outline: 3px solid var(--pdeep); outline-offset: 3px; }
  :global(.on-ink) .btn:focus-visible { outline-color: var(--powder); }

  @media (max-width: 767px) {
    .btn { width: var(--bwm, var(--bw, auto)); }
    .btn { height: var(--bhm, var(--bh, 56px)); }
    .btn--l { height: var(--bhm, var(--bh, 60px)); }
    .btn--s { height: var(--bhm, var(--bh, 48px)); }
    .btn[style*='--bwm'] { padding-right: 18px; }
  }
</style>
