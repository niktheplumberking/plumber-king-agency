---
// Page curtain, "Clear Water" (revision round 2: Glass's own, no blinds; kit/curtain.ts drives it, kit/water.ts draws it).
// Cover = the screen fills like a housing: powder water, then deep water, then a clear frost layer rise from the bottom,
// each surface a meniscus, the white meniscus line on the front; Kody's logo floats up into the clear water. Reveal on the
// new page = the water drains down and away, front layer first, so the page appears from the top (header first).
// Resting markup = covering, which is exactly what html.pt-in needs at first paint; on every other page the curtain is
// visibility: hidden until a cover starts. One writer: the path `d` attributes (kit/water.ts draw), .pt-mark opacity +
// transform (curtain.ts).
import { Image } from 'astro:assets';
import logo from '../../assets/brand/logo-glass.png';
import Water from './Water.astro';
---
<div class="pt" data-pt aria-hidden="true">
  <Water />
  <span class="pt-mark"><Image src={logo} alt="" width={180} widths={[180, 360]} sizes="180px" loading="eager" decoding="async" fetchpriority="low" /></span>
</div>
<style>
  .pt { position: fixed; inset: 0; z-index: var(--z-curtain); pointer-events: none; visibility: hidden; overflow: hidden; }
  .pt.is-on, :global(html.pt-in) .pt { visibility: visible; }
  .pt-mark { position: absolute; left: 50%; top: 50%; width: 180px; margin: -53px 0 0 -90px; opacity: 0; will-change: transform, opacity; }
  :global(html.pt-in) .pt-mark { opacity: 1; }
  .pt-mark :global(img) { width: 100%; height: auto; display: block; }
  @media (max-width: 767px) { .pt-mark { width: 140px; margin: -41px 0 0 -70px; } }
</style>
