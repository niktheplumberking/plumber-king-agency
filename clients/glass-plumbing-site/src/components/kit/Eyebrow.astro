---
// Eyebrow: the ONE eyebrow (BUILD-BRIEF section 10). Figma "eyebrow" frame (146 instances, desktop and mobile identical):
// a 9 x 15 housing tick (cap 9 x 4, glass 7 x 10 outline 1.4 with a 3.5 px round bottom, water 5 x 4) + JetBrains Mono
// Bold 12 px, +8 %, caps, text at x 18, 16 px tall.
//   tone  'pdeep' (default on light) | 'light' (powder, for ink sections) | 'dark' (ink). Inside `.on-ink` the default
//         becomes powder by itself.
//   text  or the slot. `t` = motion tier (default '1'; false = none). `as` = tag (default p). Other attributes pass.
interface Props { text?: string; tone?: 'pdeep' | 'light' | 'dark'; t?: string | false; as?: string; class?: string; [k: string]: any }
const { text, tone, t, as: Tag = 'p', class: cls, ...rest } = Astro.props;
---
<Tag class:list={['eb', tone && `eb-${tone}`, cls]} data-t={t === undefined ? '1' : t || undefined} {...rest}>
  <svg class="eb-tick" viewBox="0 0 9 15" width="9" height="15" aria-hidden="true" focusable="false">
    <rect x="0" y="1" width="9" height="4" rx="1" fill="currentColor" />
    <path d="M1.7 5.7h5.6v5.8a2.8 2.8 0 0 1-2.8 2.8 2.8 2.8 0 0 1-2.8-2.8z" fill="none" stroke="currentColor" stroke-width="1.4" />
    <path d="M2 10h5v1.5a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2z" fill="currentColor" />
  </svg>
  <span class="eb-t">{text ?? <slot />}</span>
</Tag>
<style>
  .eb { display: flex; align-items: center; gap: 9px; margin: 0; color: var(--pdeep); font-family: var(--f-m); font-weight: 700; font-size: 12px; line-height: 16px; letter-spacing: .08em; text-transform: uppercase; }
  .eb-tick { flex: none; margin-top: -1px; }
  :global(.on-ink) .eb { color: var(--powder); }
  .eb.eb-pdeep { color: var(--pdeep); }
  .eb.eb-light { color: var(--powder); }
  .eb.eb-dark { color: var(--ink); }
</style>
