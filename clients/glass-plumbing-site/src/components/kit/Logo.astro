---
// Kody's logo (transparent PNG, logo + mascot) as an image. Decorative unless `alt` is given. `w` = rendered width in px.
import { Image } from 'astro:assets';
import logo from '../../assets/brand/logo-glass.png';
interface Props { w: number; alt?: string; class?: string; eager?: boolean }
const { w, alt = '', class: cls, eager = false } = Astro.props;
---
<Image src={logo} alt={alt} width={w} widths={[w, w * 2]} sizes={`${w}px`} class={cls} loading={eager ? 'eager' : 'lazy'} />
