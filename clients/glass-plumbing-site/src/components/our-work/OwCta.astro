---
// "Want your job on this page?", fix round C (independent R2 review: text left / polaroid right). New idea, "Print tray":
// one centred composition. A steel print tray holds a real crew polaroid and an empty dashed frame; the empty frame is a
// real photo picker ("Try it: pick a photo of your job"). The picked photo develops in the frame like a print (blur, sepia,
// then clear) and is captioned "Your job · text it to (727) 512-0673"; nothing is uploaded (it stays in the browser), and
// the Text button lights up to send it. The polaroid slides out of the tray with the scroll (kit/scrub, as before).
// Copy: no posting promise (unconfirmed); only "Call or text a photo of the job."
// 21st.dev: "PhotoBox" (@abushaidislam7/photo-box, id 46671: a sliding Polaroid print tray with hover lift) + "Image
// Preview Dropzone" (@uilayout.contact/imgpreview-dropzone, id 18045: pick a file, see its thumbnail), adapted to Astro +
// vanilla TS (URL.createObjectURL, revoked on change), re-skinned: steel tray with rivets, pdeep dashed frame, powder
// offset shadow. No JS: the frame is a plain file input label; reduced motion: the print shows at once.
import '../contact/cx.css';
import Eyebrow from '../kit/Eyebrow.astro';
import Btn from '../kit/Btn.astro';
import Img from '../ui/Img.astro';
import { SITE } from '../../data/site';
---
<section class="cx-sec cx-frost oc" data-m-section aria-labelledby="oc-h" data-oc>
  <div class="wrap">
    <div class="shead oc-head">
      <Eyebrow text="Next on this page" tone="pdeep" class="oc-eb" />
      <h2 id="oc-h" class="cx-h oc-h" data-t="2"><span class="ln">Want your job</span> <span class="ln tone">on this page?</span></h2>
      <p class="oc-lead" data-t="3">Call or text a photo of the job. Try it below: pick one and see it in the frame.</p>
    </div>
    <div class="oc-tray" data-t="4" data-scrub data-start="top 90%" data-end="center 55%" data-start-m="top 95%" data-end-m="center 60%">
      <figure class="oc-pol" data-scrub-tw='{"rotate":-7,"x":-40,"y":-6}'>
        <div class="oc-ph"><Img name="crew-selfie" alt="A crew member in a cap and mirrored sunglasses taking a selfie in the van" sizes="(min-width: 768px) 220px, 140px" /></div>
        <figcaption>From the van</figcaption>
      </figure>
      <div class="oc-slot" data-oc-slot>
        <input id="oc-file" class="oc-file" type="file" accept="image/*" data-oc-file />
        <label for="oc-file" class="oc-pick">
          <span class="oc-empty">
            <svg width="40" height="40" viewBox="0 0 18 18" aria-hidden="true"><rect x=".8" y="5.3" width="16.4" height="10.1" rx="2.2" fill="none" stroke="currentColor" stroke-width="1"/><circle cx="9" cy="10.08" r="2.44" fill="none" stroke="currentColor" stroke-width="1"/><rect x="5.4" y="2.16" width="7.2" height="2.52" rx="1" fill="currentColor"/></svg>
            <span class="oc-et">Your job, next.</span>
            <span class="oc-es">Try it: pick a photo</span>
          </span>
          <span class="oc-print" aria-hidden="true"><img alt="" data-oc-img /></span>
        </label>
        <p class="oc-cap" data-oc-cap>Your job · text it to {SITE.phone}</p>
      </div>
      <i class="oc-rv" aria-hidden="true"></i><i class="oc-rv" aria-hidden="true"></i>
    </div>
    <p class="oc-note" data-oc-note aria-live="polite">Nothing is uploaded: the photo stays on your device.</p>
    <div class="oc-btns" data-t="3">
      <Btn look="call" label={SITE.phone} sub="Call now · 24/7" href={SITE.tel} w={300} size="l" class="oc-b1" />
      <Btn look="line" label="Text a photo" icon="camera" arrow href={SITE.sms} w={240} size="l" hm={56} class="oc-b2" />
    </div>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-oc]').forEach((root) => {
    const file = root.querySelector<HTMLInputElement>('[data-oc-file]');
    const img = root.querySelector<HTMLImageElement>('[data-oc-img]');
    const note = root.querySelector<HTMLElement>('[data-oc-note]');
    let url = '';
    file?.addEventListener('change', () => {
      const f = file.files && file.files[0];
      if (!f || !img || !f.type.startsWith('image/')) return;
      if (url) URL.revokeObjectURL(url);
      url = URL.createObjectURL(f);
      root.classList.remove('is-dev');
      img.onload = () => { void img.offsetWidth; root.classList.add('has-photo', 'is-dev'); };
      img.src = url;
      if (note) note.textContent = 'Looks good. Text it to (727) 512-0673 with your town. Nothing was uploaded.';
    });
  });
</script>
<style>
  .oc { padding: 110px 0 110px; }
  .oc-head { display: grid; justify-items: center; text-align: center; }
  .oc-head :global(.oc-eb) { justify-content: center; }
  .oc-h { --fs: 56px; --fs-m: 36px; margin-top: 16px; }
  .oc-lead { margin: 18px 0 0; max-width: 520px; font: 400 17px/1.5 var(--f-b); color: var(--muted); }

  /* Steel print tray, centred; the polaroid and the frame stand in it. */
  .oc-tray { position: relative; display: flex; justify-content: center; align-items: flex-end; gap: 36px; width: 640px; max-width: 100%; margin: 44px auto 0; padding: 0 40px 40px; }
  .oc-tray::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 18px; border-radius: 0 0 10px 10px; background: var(--steel); box-shadow: inset 0 0 0 1.5px var(--steel2), 10px 10px 0 var(--ink); }
  .oc-rv { position: absolute; z-index: 1; bottom: 5px; width: 8px; height: 8px; border-radius: 50%; background: var(--steel2); }
  .oc-rv:nth-of-type(1) { left: 14px; } .oc-rv:nth-of-type(2) { right: 14px; }
  .oc-pol { position: relative; width: 240px; margin: 0; padding: 10px 10px 0; background: var(--white); border-radius: 3px; box-shadow: 0 12px 24px -10px rgba(13,13,10,.3); rotate: -4deg; transform-origin: 50% 100%; }
  .oc-ph { position: relative; width: 220px; height: 220px; overflow: hidden; }
  .oc-pol figcaption { padding: 14px 0 16px; text-align: center; font: 700 11px/14px var(--f-m); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .oc-slot { position: relative; width: 250px; rotate: 3deg; transform-origin: 50% 100%; }
  .oc-file { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .oc-pick { position: relative; display: block; height: 286px; border-radius: 3px; background: var(--white); color: var(--pdeep); cursor: pointer; transition: translate .35s var(--ease-io), box-shadow .35s var(--ease-io);
    background-image: repeating-linear-gradient(90deg, var(--pdeep) 0 8px, transparent 8px 14px), repeating-linear-gradient(90deg, var(--pdeep) 0 8px, transparent 8px 14px),
      repeating-linear-gradient(0deg, var(--pdeep) 0 8px, transparent 8px 14px), repeating-linear-gradient(0deg, var(--pdeep) 0 8px, transparent 8px 14px);
    background-size: 100% 2px, 100% 2px, 2px 100%, 2px 100%; background-position: 0 0, 0 100%, 0 0, 100% 0; background-repeat: no-repeat; }
  .oc-pick:hover { translate: 0 -6px; box-shadow: 8px 8px 0 var(--powder); }
  .oc-file:focus-visible + .oc-pick { outline: 3px solid var(--pdeep); outline-offset: 4px; }
  .oc-empty { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px; text-align: center; transition: opacity .4s var(--ease-io); }
  .oc-et { font: 800 22px/1.04 var(--f-h); letter-spacing: -0.02em; }
  .oc-es { display: inline-flex; align-items: center; min-height: 32px; padding: 0 12px; border-radius: 999px; background: var(--pdeep); color: var(--white); font: 700 11px/1 var(--f-m); letter-spacing: .06em; text-transform: uppercase; }
  .oc-print { position: absolute; inset: 10px 10px 56px; overflow: hidden; opacity: 0; background: var(--frost2); }
  .oc-print img { width: 100%; height: 100%; object-fit: cover; }
  .oc-cap { position: absolute; left: 10px; right: 10px; bottom: 14px; margin: 0; text-align: center; font: 700 10px/13px var(--f-m); letter-spacing: .06em; text-transform: uppercase; color: var(--ink); opacity: 0; transition: opacity .4s var(--ease-io) .6s; }
  .oc.has-photo .oc-empty { opacity: 0; }
  .oc.has-photo .oc-print, .oc.has-photo .oc-cap { opacity: 1; }
  .oc.has-photo .oc-pick { background-image: none; box-shadow: 0 12px 24px -10px rgba(13,13,10,.3); }
  html.motion .oc.is-dev .oc-print img { animation: oc-dev 1.6s var(--ease-io) both; }
  @keyframes oc-dev { 0% { filter: blur(12px) sepia(1) brightness(1.6); opacity: .2; } 60% { filter: blur(2px) sepia(.4) brightness(1.1); opacity: .9; } 100% { filter: none; opacity: 1; } }
  .oc-note { margin: 22px 0 0; text-align: center; font: 500 12px/16px var(--f-m); letter-spacing: .03em; color: var(--muted); }
  .oc-btns { display: flex; justify-content: center; gap: 16px; margin-top: 20px; }
  .oc-btns :global(.btn) { height: 64px; }
  .oc.has-photo .oc-btns :global(.oc-b2) { box-shadow: 4px 4px 0 var(--powder); }
  @media (max-width: 767px) {
    .oc { padding: 64px 0 80px; }
    .oc-h { margin-top: 12px; }
    .oc-lead { margin-top: 12px; font-size: 15px; }
    .oc-tray { gap: 12px; margin-top: 30px; padding: 0 10px 30px; }
    .oc-tray::after { height: 14px; box-shadow: inset 0 0 0 1.5px var(--steel2), 6px 6px 0 var(--ink); }
    .oc-rv { bottom: 3px; }
    .oc-pol { width: 150px; padding: 7px 7px 0; }
    .oc-ph { width: 136px; height: 136px; }
    .oc-pol figcaption { padding: 10px 0 12px; font-size: 9px; }
    .oc-slot { width: 160px; }
    .oc-pick { height: 186px; }
    .oc-et { font-size: 17px; } .oc-empty { gap: 10px; } .oc-empty svg { width: 30px; height: 30px; }
    .oc-es { font-size: 9px; min-height: 28px; padding: 0 8px; }
    .oc-print { inset: 7px 7px 44px; }
    .oc-cap { font-size: 8px; line-height: 11px; bottom: 8px; }
    .oc-btns { flex-direction: column; gap: 16px; }
    .oc-btns :global(.btn) { width: 100%; height: 60px; }
    .oc-btns :global(.btn.oc-b2) { height: 56px; }
  }
</style>
