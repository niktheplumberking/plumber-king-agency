---
// "Follow the van.", R2 rebuild (Nick 20 Nov: promote the Instagram visibly; proof shown, not only linked; every section
// interactive). The crew's Instagram as a profile plate: avatar ring with the real logo, @glassplumbingservices with the
// verified tick, the public counts (34 posts, 653 followers: read 17 Nov 2026, REVISION-R2 point 8) counting up as it
// enters, and four photos from the crew's posts in a grid. Each tile lifts with a pointer-tracked powder glow and shows
// its caption on hover / focus. Follow button links the real profile. No names on faces.
// 21st.dev: "Profile Hover Card" (isaiahbjork, id 29440: avatar, follower stats, follow button) + "Glow Card Grid"
// (ncdai, id 25283: pointer-tracked glow per card), re-skinned: steel plate header with rivets, powder offset, ink.
import '../contact/cx.css';
import Eyebrow from '../kit/Eyebrow.astro';
import Seam from '../kit/Seam.astro';
import Btn from '../kit/Btn.astro';
import Logo from '../kit/Logo.astro';
import Img from '../ui/Img.astro';
import { SITE } from '../../data/site';
const FEED = [
  { img: 'hero-crew-job', alt: 'A crew member on a mini-excavator in a yard, the Glass Plumbing van parked behind', cap: 'Dig day, van on site' },
  { img: 'crew-crawlspace', alt: 'A crew member in a Glass cap smiling from a crawlspace', cap: 'In the crawlspace' },
  { img: 'corroded-pipe', alt: 'A corroded pipe and valve on a utility wall before the repair', cap: 'Before the repair' },
  { img: 'crew-water-heater-tank', alt: 'A crew member lifting a water heater part in a tiled room', cap: 'Water heater job' },
];
const IG = { posts: SITE.social.instagramStats.posts, followers: SITE.social.instagramStats.followers, read: SITE.social.instagramStats.checked };
---
<section class="cx-sec cx-white of" data-m-section aria-labelledby="of-h" data-of>
  <Seam from="var(--frost)" to="var(--white)" />
  <div class="wrap">
    <div class="shead of-top">
      <Eyebrow text={SITE.social.instagramHandle} tone="pdeep" />
      <h2 id="of-h" class="cx-h of-h" data-t="2">Follow the van.</h2>
    </div>
    <div class="of-card" data-t="4">
      <div class="of-prof">
        <a class="of-av" href={SITE.social.instagram} target="_blank" rel="noopener" aria-label={`${SITE.social.instagramHandle} on Instagram (opens in a new tab)`}><span class="of-ring"><Logo w={64} alt="" /></span></a>
        <div class="of-id">
          <p class="of-hd">{SITE.social.instagramHandle.slice(1)} <svg class="of-tick" viewBox="0 0 24 24" width="18" height="18" role="img" aria-label="Verified"><path d="M12 1l2.6 2.1 3.3-.4 1.2 3.1 3.1 1.2-.4 3.3L23 12l-2.1 2.6.4 3.3-3.1 1.2-1.2 3.1-3.3-.4L12 23l-2.6-2.1-3.3.4-1.2-3.1-3.1-1.2.4-3.3L0 12l2.1-2.6-.4-3.3 3.1-1.2 1.2-3.1 3.3.4Z" fill="#3897F0" /><path d="M7 12.4l3.2 3.1L17 8.7" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg></p>
          <p class="of-nm">{SITE.name} · {SITE.city}, {SITE.region}</p>
        </div>
        <dl class="of-st">
          <div><dt>posts</dt><dd data-count={IG.posts}>{IG.posts}</dd></div>
          <div><dt>followers</dt><dd data-count={IG.followers}>{IG.followers}</dd></div>
        </dl>
        <Btn look="light" label="Follow on Instagram" href={SITE.social.instagram} external arrow w={260} class="of-btn" />
        <p class="of-read">Counts read {IG.read}</p>
      </div>
      <ul class="of-g" role="list" data-stagger>
        {FEED.map((p) => (
          <li class="of-i">
            <a class="of-a" href={SITE.social.instagram} target="_blank" rel="noopener">
              <Img name={p.img} alt={p.alt} sizes="(min-width: 1280px) 240px, (min-width: 768px) 23vw, 46vw" />
              <span class="of-glow" aria-hidden="true"></span>
              <span class="of-cap"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2" /><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2" /><circle cx="17.3" cy="6.7" r="1.2" fill="currentColor" /></svg>{p.cap}</span>
              <span class="sr-only"> (Instagram, opens in a new tab)</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
<style>
  .of { padding: 110px 0 96px; }
  .of-top { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .of-h { --fs: 56px; --fs-m: 30px; margin-top: 16px; }
  .of-card { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 0; max-width: 1120px; margin: 48px auto 0; border-radius: 8px; background: var(--frost); box-shadow: inset 0 0 0 1.5px var(--ink), 12px 12px 0 var(--powder); overflow: hidden; }
  .of-prof { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: 18px; padding: 32px 28px; background: var(--ink); color: var(--white); }
  .of-av { display: block; border-radius: 50%; }
  .of-ring { display: grid; place-items: center; width: 96px; height: 96px; border-radius: 50%; background: var(--white); box-shadow: 0 0 0 3px var(--ink), 0 0 0 6px var(--powder); transition: box-shadow .4s var(--ease-io); }
  .of-av:hover .of-ring, .of-av:focus-visible .of-ring { box-shadow: 0 0 0 3px var(--ink), 0 0 0 9px var(--powder); }
  .of-ring :global(img) { width: 64px; height: auto; }
  .of-hd { display: flex; align-items: center; gap: 6px; font: 800 19px/1.2 var(--f-h); letter-spacing: -.01em; word-break: break-all; }
  .of-tick { flex: none; }
  .of-nm { margin-top: 4px; font-size: 14px; line-height: 1.4; color: var(--frost3); }
  .of-st { display: flex; gap: 28px; margin: 0; }
  .of-st div { display: flex; flex-direction: column-reverse; }
  .of-st dt { font: 500 11px/1 var(--f-m); letter-spacing: .06em; text-transform: uppercase; color: var(--powder); margin-top: 6px; }
  .of-st dd { margin: 0; font: 800 40px/1 var(--f-h); letter-spacing: -.02em; }
  .of :global(.of-btn) { height: 52px; margin-top: 10px; }
  .of-read { font: 500 10px/1 var(--f-m); letter-spacing: .04em; color: var(--muted2); }
  .of-g { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin: 0; padding: 24px; list-style: none; }
  .of-i { aspect-ratio: 1.45; }
  .of-a { position: relative; display: block; height: 100%; border-radius: 5px; overflow: hidden; isolation: isolate; box-shadow: inset 0 0 0 2px var(--ink); transition: translate .4s var(--ease-io), box-shadow .4s var(--ease-io); }
  .of-a :global(img) { position: relative; z-index: -2; transition: scale .6s var(--ease-io); }
  .of-glow { position: absolute; inset: 0; z-index: -1; background: radial-gradient(260px circle at var(--gx, 50%) var(--gy, 50%), rgba(132,179,199,.45), transparent 65%); opacity: 0; transition: opacity .4s var(--ease-io); }
  .of-cap { position: absolute; left: 12px; bottom: 12px; display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: 4px; background: var(--ink); color: var(--white); font: 700 11px/1 var(--f-m); letter-spacing: .04em; text-transform: uppercase; opacity: 0; translate: 0 8px; transition: opacity .4s var(--ease-io), translate .4s var(--ease-io); }
  .of-a:hover, .of-a:focus-visible { translate: -3px -3px; box-shadow: inset 0 0 0 2px var(--ink), 6px 6px 0 var(--ink); }
  .of-a:hover .of-glow, .of-a:focus-visible .of-glow { opacity: 1; }
  .of-a:hover .of-cap, .of-a:focus-visible .of-cap { opacity: 1; translate: 0 0; }
  .of-a:hover :global(img) { scale: 1.04; }
  .of-a:focus-visible { outline: 3px solid var(--pdeep); outline-offset: 3px; }
  @media (hover: none) { .of-cap { opacity: 1; translate: 0 0; } }
  @media (max-width: 1023px) { .of-card { grid-template-columns: 1fr; } .of-prof { display: grid; grid-template-columns: auto 1fr; align-items: center; } .of-st, .of :global(.of-btn), .of-read { grid-column: 1 / -1; } }
  @media (max-width: 767px) {
    .of { padding: 64px 0 56px; }
    .of-h { margin-top: 10px; }
    .of-card { margin-top: 28px; box-shadow: inset 0 0 0 1.5px var(--ink), 6px 6px 0 var(--powder); }
    .of-prof { padding: 22px 18px; gap: 14px; }
    .of-ring { width: 72px; height: 72px; } .of-ring :global(img) { width: 48px; }
    .of-hd { font-size: 16px; }
    .of-st dd { font-size: 30px; }
    .of :global(.of-btn) { width: 100%; }
    .of-g { gap: 8px; padding: 12px; }
    .of-i { aspect-ratio: 1; }
    .of-cap { left: 6px; bottom: 6px; padding: 6px 7px; font-size: 9px; gap: 5px; }
    .of-cap svg { width: 12px; height: 12px; }
  }
</style>
<script>
  const root = document.querySelector<HTMLElement>('[data-of]');
  if (root && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    root.querySelectorAll<HTMLElement>('.of-a').forEach((a) => a.addEventListener('pointermove', (e) => {
      const r = a.getBoundingClientRect();
      a.style.setProperty('--gx', `${e.clientX - r.left}px`); a.style.setProperty('--gy', `${e.clientY - r.top}px`);
    }));
  }
</script>
