---
// Our work hero (Figma 727:993 "Hero" y 172 h 690 / 729:1033 y 158 h 540). Ink band, three photos with steel tags
// (phones: a clipped swipe row with mono captions). Photos mapped by hash (IMAGE-HASHES.md).
import '../contact/cx.css';
import Eyebrow from '../kit/Eyebrow.astro';
import Img from '../ui/Img.astro';
const shots = [
  { img: 'manifold-install', alt: 'A manifold install with copper lines and valves inside an open wall panel', k: 'Recent install', v: 'On a real job', m: 'Recent install' },
  { img: 'van-night', alt: 'The Glass Plumbing Services van at night, the mascot and phone number on its side', k: 'The van', v: 'Glass Plumbing Services', m: 'The van', sh: true },
  { img: 'water-heater-expansion-tank', alt: 'A new water heater being installed in a closet, its expansion tank on the floor beside it, with the words “Floor Drain Built In” on the photo', k: 'Water heater', v: 'With expansion tank', m: 'Water heater + exp. tank' },
];
---
<section class="cx-sec cx-ink oh on-ink" data-m-section data-m-hero aria-labelledby="oh-h">
  <div class="wrap">
    <Eyebrow tone="light" class="oh-eb"><span class="d">From our Instagram · @glassplumbingservices</span><span class="m">From our Instagram</span></Eyebrow>
    <h1 id="oh-h" class="cx-h oh-h" data-t="2">Recent Work <span class="tone">Across Pinellas</span></h1>
    <p class="oh-lead lead" data-t="3" data-fx="nudge">Real jobs, real photos, straight from the van. 34 posts and counting.</p>
    <p class="oh-swipe" aria-hidden="true">Swipe →</p>
    <ul class="oh-row cx-scroll" role="list" data-track data-hscroll aria-label="Recent job photos">
      {shots.map((s, i) => (
        <li class:list={['oh-c', s.sh && 'oh-sh']} data-t="4" data-fx={i === 0 ? 'frame' : 'up'}>
          <figure>
            <div class="oh-ph"><Img name={s.img} alt={s.alt} sizes="(min-width: 1280px) 384px, (min-width: 768px) 30vw, 260px" box={384 / 300} boxM={260 / 220} priority={i === 0} /></div>
            <figcaption><dl class="cx-tag oh-tag"><dt>{s.k}</dt><dd>{s.v}</dd></dl><span class="oh-mc">{s.m}</span></figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .oh { padding: 76px 0 90px; }
  .oh :global(.oh-eb) { margin-top: 0; }
  .oh :global(.oh-eb .m), .oh-swipe { display: none; }
  .oh-h { --fs: 76px; --fs-m: 40px; margin-top: 14px; line-height: 1.04; }
  .oh-lead { margin-top: 18px; max-width: 520px; color: var(--white); }
  .oh-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin: 31px 0 0; padding: 0; list-style: none; overflow: visible; }
  .oh-c figure { position: relative; margin: 0; }
  .oh-ph { position: relative; height: 300px; border: 2px solid var(--white); border-radius: 6px; overflow: hidden; }
  .oh-sh .oh-ph { box-shadow: 10px 10px 0 var(--powder); }
  .oh-tag { left: 16px; bottom: 23px; width: 250px; grid-template-columns: 98px 1fr; box-shadow: none; }
  .oh-mc { display: none; }
  @media (min-width: 768px) and (max-width: 1279px) {
    .oh-ph { height: auto; aspect-ratio: 384 / 300; }
    .oh-tag { width: auto; right: 16px; }
  }
  @media (max-width: 767px) {
    .oh { padding: 44px 0 45px; }
    .oh :global(.oh-eb) { margin-top: 0; }
    .oh :global(.oh-eb .d) { display: none; } .oh :global(.oh-eb .m) { display: inline; }
    .oh-h { margin-top: 10px; line-height: 1.02; }
    .oh-h .tone { display: block; }
    .oh-lead { margin-top: 14px; font-size: 16px; }
    .oh-swipe { display: block; margin: 6px 0 0; text-align: right; padding-right: 14px; font: 700 10px/13px var(--f-m); letter-spacing: .06em; text-transform: uppercase; color: var(--powder); }
    .oh-row { display: flex; gap: 16px; margin: 9px calc(-1 * var(--gutter)) 0 0; padding-right: var(--gutter); overflow-x: auto; }
    .oh-c { width: 260px; }
    .oh-ph { height: 220px; }
    .oh-sh .oh-ph { box-shadow: none; }
    .oh-tag { display: none; }
    .oh-mc { display: block; margin-top: 12px; font: 700 10px/13px var(--f-m); letter-spacing: .06em; text-transform: uppercase; color: var(--white); }
  }
</style>
