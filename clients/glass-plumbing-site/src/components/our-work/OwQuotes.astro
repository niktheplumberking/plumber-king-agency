---
// Reviews on /our-work, fix round 3 (D, RECHECK MAJOR 1: the three-slip rail here and the dealt deck in the /reviews hero
// were the same device twice; the deck stays on /reviews). New form, THE JOB QUILT: three jobs, each next to what its
// customer wrote about it, set as a checkerboard of ink job tiles and paper review tiles (desktop: three columns, job over
// review / review over job / job over review; tablet and phone: rows alternate J Q / Q J, so every job sits by its review). Pointing at (or focusing) a job lights its review: the review tile lifts on a
// powder offset and fills its stars, the other tiles' stars fade (text stays full contrast). Each job tile links to the matching service page.
// The interaction is CSS only (:has on the grid): no JS on this section at all.
// 21st.dev: "Testimonial Carousel Section / Checker Quilt Testimonials" (@kedhareswer, id 38036: a full-bleed checkerboard
// of quotes and portraits), adapted: no portraits (no faces next to names), the "portrait" squares are the job tiles in
// the Glass ink with kit rivets; no carousel.
// Nearest match: /reviews RevList (a moving three-column wall), home Reviews (three cards beside two housings), Mike
// OWall / Khinda Work (photo walls), Mike RevSpotlight (one sheet at a time). None pairs jobs and reviews on a checkerboard.
// R4 (re-check R3 MINOR, rule 16): the job tiles carry real job photos from the crew's Instagram that are not used anywhere
// else on /our-work (job-state-heater, job-vanity, job-supply-lines; cropped below the burnt-in captions, no
// faces). R5 (re-check R4 MINOR 7): the "New construction" tile's photo (job-rough-in, an IG video frame) was motion-blurred, and no
// other sharp, faceless job photo is left unused on /our-work, so that tile is dropped: the quilt is three jobs. The note
// says the photo shows that kind of job.
// Quotes: word for word (the build fails if one is not a substring of its review in reviews.ts).
import '../contact/cx.css';
import Stars from '../contact/Stars.astro';
import Img from '../ui/Img.astro';
import { REVIEWS } from '../../data/reviews';
import { SITE } from '../../data/site';
const Q = [
  { job: 'Water heater', sub: 'New install', href: '/services/water-heaters', img: 'job-state-heater', alt: 'A new State water heater installed against a block wall, copper lines on top', who: 'Kevin Kelleman', q: 'Needed a new Water Heater, called and had one installed the next day at a great price.' },
  { job: 'Bathroom remodel', sub: 'Residential', href: '/services', img: 'job-vanity', alt: 'A new dark vanity with a stone top in a remodelled bathroom', who: 'Peter Van Buskirk', q: 'These guys can handle anything from a residential bathroom remodel to a high end commercial build-out.' },
  { job: 'Pipes & fittings', sub: 'Leak fixed', href: '/services', img: 'job-supply-lines', alt: 'A hand on new braided supply lines under a sink', who: 'Seth Nye', q: 'Hired glass plumbing services for a leaky shower faucet, Mr. Glass was here same day to replace pipes/ fittings and new kit and left here good as new!' },
];
Q.forEach(({ who, q }) => { const r = REVIEWS.find((x) => x.name === who); if (!r || !r.text.replace(/\s+/g, ' ').includes(q)) throw new Error(`OwQuotes: "${q}" is not in ${who}'s review`); });
const g = SITE.google;
---
<section class="cx-sec cx-ink2 oq on-ink" data-m-section aria-labelledby="oq-h">
  <div class="wrap">
    <div class="oq-top">
      <p class="oq-eb" data-t="1">What customers say</p>
      <h2 class="cx-h oq-h" id="oq-h" data-t="2"><span class="ln">Three jobs.</span> <span class="ln tone">Three customers’ words.</span></h2>
      <ul class="oq-rec" role="list" data-t="3">
        {[g.a, g.b].map((p, i) => (
          <li><a class="oq-pf" href={p.url} target="_blank" rel="noopener"><span class="oq-g" aria-hidden="true">G</span><b>{p.value}</b><Stars w={70} /><span class="oq-n">{p.count} reviews · profile {i + 1}</span><span class="sr-only"> on Google, read {g.checked} (opens in a new tab)</span></a></li>
        ))}
      </ul>
    </div>
    <ul class="quilt" role="list" data-t="4" data-stagger>
      {Q.map((x, i) => (
        <li class:list={['pair', `p${i}`]}>
          <a class="job" href={x.href}>
            <span class="job-ph"><Img name={x.img} alt={x.alt} sizes="(min-width:1024px) 250px, (min-width:768px) 290px, 150px" widths={[160, 250, 320, 500]} /></span>
            <i class="rv" aria-hidden="true"></i><i class="rv" aria-hidden="true"></i>
            <span class="job-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="job-t">{x.job}</span>
            <span class="job-s">{x.sub}<span class="job-go" aria-hidden="true"> · see the service →</span></span>
          </a>
          <figure class="rev">
            <Stars w={84} label="5 out of 5 stars" class="rev-st" />
            <blockquote><p>“{x.q}”</p></blockquote>
            <figcaption>{x.who} · Google</figcaption>
          </figure>
        </li>
      ))}
    </ul>
    <p class="oq-note" data-t="3"><span class="d">Point at a job to light its review.</span><span class="m">Tap a job to see its service.</span> Every quote is word for word from Google. Job photos are from the crew’s Instagram and show the same kind of job, not the reviewer’s own home.</p>
  </div>
</section>
<style>
  .oq { padding: 96px 0 100px; background: var(--ink2); }
  .oq-top { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .oq-eb { font: 700 12px/1 var(--f-m); letter-spacing: .08em; text-transform: uppercase; color: var(--powder); }
  .oq-h { --fs: 52px; margin-top: 14px; }
  .oq-rec { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin: 22px 0 0; padding: 0; list-style: none; }
  .oq-pf { display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 6px 18px 6px 8px; border-radius: 26px; background: var(--ink); box-shadow: inset 0 0 0 1px var(--ink3); color: var(--white); transition: box-shadow .35s var(--ease-io); }
  .oq-pf:hover, .oq-pf:focus-visible { box-shadow: inset 0 0 0 1.5px var(--powder); }
  .oq-pf b { font: 800 22px/1 var(--f-h); }
  .oq-g { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--white); color: #4285F4; font: 800 16px/1 var(--f-h); }
  .oq-n { font: 500 11px/1 var(--f-m); color: var(--powder); text-decoration: underline; text-underline-offset: 3px; }

  /* The quilt (R5, three pairs): desktop = three columns, each pair a job over its review; the middle pair runs review over
     job, so the colours checker. Tablet / phone = one column of rows that alternate job-review / review-job. */
  .quilt { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; margin: 48px 0 0; padding: 0; list-style: none; border: 2px solid var(--ink); border-radius: 8px; overflow: hidden; box-shadow: 14px 14px 0 var(--powder); }
  .pair { display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: auto 1fr; }
  .p1 { grid-template-rows: 1fr auto; }
  .p1 .job { order: 2; }
  .job { position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: flex-end; gap: 6px; min-height: 260px; padding: 26px 24px; background: var(--ink); color: var(--white); text-decoration: none;
    box-shadow: inset 0 0 0 1px var(--ink3); transition: background-color .45s var(--ease-io); }
  .job-ph { position: absolute; inset: 0; overflow: hidden; }
  .job-ph :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; transition: scale .6s var(--ease-io); }
  .job-ph::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(22 19 15 / .35) 0%, rgb(22 19 15 / .1) 35%, rgb(22 19 15 / .88) 100%); transition: background-color .45s var(--ease-io); }
  .job:hover .job-ph :global(img), .job:focus-visible .job-ph :global(img) { scale: 1.05; }
  .job:hover .job-ph::after, .job:focus-visible .job-ph::after { background-color: rgb(47 97 120 / .45); }
  .job > :not(.job-ph) { position: relative; z-index: 1; }
  .job .job-n { position: absolute; }
  .job .rv { position: absolute; z-index: 1; top: 12px; width: 8px; height: 8px; border-radius: 50%; background: var(--steel2); }
  .job .rv:first-child { left: 12px; } .job .rv:nth-child(2) { right: 12px; }
  .job-n { position: absolute; left: 24px; top: 26px; font: 700 12px/1 var(--f-m); letter-spacing: .08em; color: var(--powder); }
  .job-t { font: 800 30px/1.04 var(--f-h); letter-spacing: -.02em; }
  .job-s { font: 500 11px/15px var(--f-m); letter-spacing: .06em; text-transform: uppercase; color: rgb(255 255 255 / .92); }
  .job-go { opacity: 0; transition: opacity .35s var(--ease-io); }
  .job:hover .job-go, .job:focus-visible .job-go { opacity: 1; }
  .job:hover .job-n, .job:focus-visible .job-n { color: var(--white); }
  .job:focus-visible { outline: 3px solid var(--powder); outline-offset: -6px; }
  .rev { position: relative; z-index: 1; display: flex; flex-direction: column; margin: 0; padding: 26px 26px 22px; background: var(--white); color: var(--ink); box-shadow: inset 0 0 0 1px var(--frost3);
    transition: translate .5s var(--ease-io), box-shadow .5s var(--ease-io), opacity .5s var(--ease-io); }
  .rev blockquote { margin: 14px 0 0; flex: 1; }
  .rev p { margin: 0; font: 700 19px/1.32 var(--f-h); letter-spacing: -.01em; }
  .rev figcaption { margin-top: 16px; font: 500 11px/15px var(--f-m); letter-spacing: .02em; color: var(--pdeep); }
  .rev :global(.rev-st path) { transition: opacity .35s var(--ease-io); }
  /* Point at a job: its own review lifts and its stars fill in turn; the other reviews dim. CSS only. */
  @media (hover: hover) and (pointer: fine) {
    .quilt:has(.job:hover) .rev :global(.rev-st path) { opacity: .25; }
  }
  .quilt:has(.job:focus-visible) .rev :global(.rev-st path) { opacity: .25; }
  .pair:has(.job:hover) .rev, .pair:has(.job:focus-visible) .rev { opacity: 1; z-index: 2; translate: -4px -4px; box-shadow: inset 0 0 0 2px var(--ink), 8px 8px 0 var(--powder); }
  .pair:has(.job:hover) .rev :global(.rev-st path), .pair:has(.job:focus-visible) .rev :global(.rev-st path) { opacity: 1; }
  .pair:has(.job:hover) .rev :global(.rev-st path:nth-child(2)) { transition-delay: .06s; } .pair:has(.job:hover) .rev :global(.rev-st path:nth-child(3)) { transition-delay: .12s; }
  .pair:has(.job:hover) .rev :global(.rev-st path:nth-child(4)) { transition-delay: .18s; } .pair:has(.job:hover) .rev :global(.rev-st path:nth-child(5)) { transition-delay: .24s; }
  .oq-note { margin-top: 30px; text-align: center; font: 500 11px/16px var(--f-m); letter-spacing: .04em; text-transform: uppercase; color: rgb(255 255 255 / .8); }
  .oq-note .m { display: none; }
  :global(html:not(.motion)) .rev, :global(html:not(.motion)) .job, :global(html:not(.motion)) .job-ph :global(img) { transition: none; }

  @media (min-width: 768px) and (max-width: 1023px) {
    .quilt { grid-template-columns: 1fr; }
    .pair, .p1 { grid-template-rows: none; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); }
    .p1 { grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr); }
  }
  @media (max-width: 767px) {
    .oq { padding: 60px 0 64px; }
    .oq-h { margin-top: 10px; }
    .oq-pf { padding-right: 12px; gap: 7px; }
    .quilt { grid-template-columns: 1fr; margin-top: 30px; box-shadow: 8px 8px 0 var(--powder); }
    .pair { grid-template-rows: none; grid-template-columns: minmax(0, .42fr) minmax(0, .58fr); }
    .p1 { grid-template-rows: none; grid-template-columns: minmax(0, .58fr) minmax(0, .42fr); }
    .job { min-height: 200px; padding: 40px 14px 16px; gap: 4px; }
    .job-n { left: 14px; top: 18px; font-size: 10px; }
    .job .rv:first-child { display: none; }
    .job-t { font-size: 20px; }
    .job-s { font-size: 9px; line-height: 12px; }
    .job-go { display: none; }
    .rev { padding: 16px 14px 14px; }
    .rev p { font-size: 15px; line-height: 1.3; }
    .rev :global(.rev-st) { width: 64px; height: 10px; }
    .rev figcaption { margin-top: 10px; font-size: 10px; }
    .oq-note .d { display: none; } .oq-note .m { display: inline; }
  }
</style>
