---
// "What people mention", fix round 3 (D, RECHECK MAJOR 7: the R2 rack of six housings, each filled to "N/16", was the
// same device as Mike's home "what the reviews mention 6/9" tally). New form, THE MARKED PAGE: the sentences people wrote
// are set as one run-on page of paper, word for word, each followed by its reviewer's name. Six marker pens lie across the
// top edge of the page, one per thing people mention, each pen's cap carries its real count (fair price 6, professional 6,
// on time 5, same or next day 4, explained 2, cleaned up 2; counted from the 16 reviews in reviews.ts, the numbers are
// THEMES lengths below). Uncap a pen and its words get marked in the page, sweeping in; the sentences that do not say it
// fade back. The count is never a bar or a fill: you see the marks themselves.
// 21st.dev: "Text Highlighter" (@danielpetho, id 18773: a marker sweep behind inline text, triggered on demand) + "Marker
// Highlight" (@kapishdima, id 12045), adapted: vanilla TS, one attribute on the page drives every mark through CSS.
// Nearest match: Mike home Reviews tally (a list of counts), Mike RevPattern (tapes on a pipe), Glass RevOwner (one line
// whose words light on scroll) and home WhyUs (stars as tabs). None marks a page of text with pens.
// JS: one click/key handler, no observers. Reduced motion: marks appear without the sweep. No JS: every mark is shown as
// a light underline, the whole page readable.
import '../contact/cx.css';
import Eyebrow from '../kit/Eyebrow.astro';
import Stars from '../contact/Stars.astro';
import { REVIEWS } from '../../data/reviews';
type Ex = [name: string, sentence: string, mark: string];
const THEMES: { id: string; t: string; ex: Ex[] }[] = [
  { id: 'price', t: 'Fair price', ex: [
    ['Kevin Kelleman', 'Needed a new Water Heater, called and had one installed the next day at a great price.', 'at a great price'],
    ['Parker L', 'He was reliable, professional, knowledgeable, and did great work at an affordable price!', 'at an affordable price'],
    ['Seth Nye', 'Also, was able to unclog my sewage lines shortly after my new installation, all for a very good price.', 'a very good price'],
    ['Emily Van Den Langenberg', 'They are efficient, knowledgeable, and their prices are always fair.', 'their prices are always fair'],
    ['David Peek', 'Always very responsive to communications and always on time as scheduled and their prices are very reasonable.', 'their prices are very reasonable'],
    ['Cary Cannon', 'He was prompt, honest, and affordable.', 'affordable'],
  ] },
  { id: 'pro', t: 'Professional', ex: [
    ['Peter Van Buskirk', 'Zac and Kody Glass are an extremely qualified and profeesional plumbing team!', 'profeesional'],
    ['Greg Letsch', 'Zach was very professional and well versed in his knowledge.', 'very professional'],
    ['Cody Weaver', 'He was efficient and professional throughout the whole experience.', 'efficient and professional'],
    ['Jordan Carlson', 'Zak was professional, punctual, and very friendly.', 'professional'],
    ['Parker L', 'He was reliable, professional, knowledgeable, and did great work at an affordable price!', 'professional'],
    ['Eduardo “EddieZoRz” Perea', 'Professional, reliable, and efficient, turned a plumbing nightmare into a manageable situation.', 'Professional'],
  ] },
  { id: 'time', t: 'On time', ex: [
    ['Michael Marks', 'Zak and Chase were on time, explained everything in detail, made solid recommendations, and did the little extras (cleaning up, performance & look) that turn a really good outcome into a great one.', 'were on time'],
    ['Cody Weaver', 'They do what they say they will and show up on time!', 'show up on time'],
    ['Jordan Carlson', 'Zak was professional, punctual, and very friendly.', 'punctual'],
    ['David Peek', 'Always very responsive to communications and always on time as scheduled and their prices are very reasonable.', 'always on time as scheduled'],
    ['Cary Cannon', 'He showed up on time, explained everything clearly, and did excellent work without overcharging.', 'showed up on time'],
  ] },
  { id: 'fast', t: 'Same or next day', ex: [
    ['Jen James', 'I took a few pictures of the valve that needed replaced and he was at my home the next day !!', 'he was at my home the next day'],
    ['Kevin Kelleman', 'Needed a new Water Heater, called and had one installed the next day at a great price.', 'installed the next day'],
    ['Parker L', 'Kody came out the same day I called to give an estimate, and returned the next day to do the work.', 'came out the same day I called'],
    ['Seth Nye', 'Hired glass plumbing services for a leaky shower faucet, Mr. Glass was here same day to replace pipes/ fittings and new kit and left here good as new!', 'was here same day'],
  ] },
  { id: 'explain', t: 'Explained everything', ex: [
    ['Michael Marks', 'Zak and Chase were on time, explained everything in detail, made solid recommendations, and did the little extras (cleaning up, performance & look) that turn a really good outcome into a great one.', 'explained everything in detail'],
    ['Cary Cannon', 'He showed up on time, explained everything clearly, and did excellent work without overcharging.', 'explained everything clearly'],
  ] },
  { id: 'clean', t: 'Cleaned up after', ex: [
    ['Michael Marks', 'Zak and Chase were on time, explained everything in detail, made solid recommendations, and did the little extras (cleaning up, performance & look) that turn a really good outcome into a great one.', 'cleaning up'],
    ['Jacob Gars', 'He even went above and beyond to clean the bathroom spotless after!', 'clean the bathroom spotless'],
  ] },
];
const byName = new Map(REVIEWS.map((r) => [r.name, r]));
// Unique sentences (in the order of reviews.ts), each with the theme marks inside it (checked: word for word, no overlap).
type Seg = { t: string; m?: string };
const sent = new Map<string, { name: string; s: string; marks: { at: number; len: number; th: string }[] }>();
for (const th of THEMES) for (const [name, s, m] of th.ex) {
  const r = byName.get(name);
  if (!r) throw new Error(`RevMention: no review by ${name}`);
  if (!r.text.includes(s)) throw new Error(`RevMention: "${s}" is not word for word in ${name}'s review`);
  const at = s.indexOf(m); if (at < 0) throw new Error(`RevMention: mark "${m}" not in the sentence`);
  const key = name + '|' + s;
  if (!sent.has(key)) sent.set(key, { name, s, marks: [] });
  sent.get(key)!.marks.push({ at, len: m.length, th: th.id });
}
const order = (k: string) => { const [n, s] = k.split('|'); const i = REVIEWS.findIndex((r) => r.name === n); return i * 1000 + REVIEWS[i].text.indexOf(s) / 1000; };
const lines = [...sent.entries()].sort((a, b) => order(a[0]) - order(b[0])).map(([, v]) => {
  const ms = v.marks.sort((a, b) => a.at - b.at);
  ms.forEach((m, i) => { if (i && m.at < ms[i - 1].at + ms[i - 1].len) throw new Error(`RevMention: marks overlap in ${v.name}`); });
  const segs: Seg[] = []; let p = 0;
  for (const m of ms) { if (m.at > p) segs.push({ t: v.s.slice(p, m.at) }); segs.push({ t: v.s.slice(m.at, m.at + m.len), m: m.th }); p = m.at + m.len; }
  if (p < v.s.length) segs.push({ t: v.s.slice(p) });
  return { name: v.name, segs, th: [...new Set(ms.map((m) => m.th))].join(' ') };
});
const pens = THEMES.map((th) => ({ id: th.id, t: th.t, n: th.ex.length }));
---
<section class="cx-sec cx-frost rm" data-m-section aria-labelledby="rm-h">
  <div class="wrap">
    <div class="shead rm-head">
      <Eyebrow text="What people mention" tone="pdeep" class="rm-eb" />
      <h2 id="rm-h" class="cx-h rm-h" data-t="2"><span class="ln">Their words,</span> <span class="ln tone">marked up.</span></h2>
      <p class="rm-note" data-t="3">Every line below is from a Google review, word for word. Uncap a pen to mark what people say about it. The cap shows how many of the 16 reviews say it.</p>
    </div>

    <div class="rm-desk" data-mark data-t="4" data-fx="up" data-no-px>
      <div class="rm-pens" role="group" aria-label="Mark what people mention">
        {pens.map((p, i) => (
          <button type="button" class="pen" aria-pressed={i === 0 ? 'true' : 'false'} data-pen={p.id} style={`--k:${i}`}>
            <span class="pen-cap" aria-hidden="true"><b>{p.n}</b></span>
            <span class="pen-body"><span class="pen-t">{p.t}</span><span class="sr-only">, {p.n} of 16 reviews</span></span>
            <span class="pen-tip" aria-hidden="true"></span>
          </button>
        ))}
      </div>
      <div class="rm-page" data-on="price" aria-live="off">
        <p class="rm-txt">
          {lines.map((l) => (
            <span class="s" data-th={l.th}>“{l.segs.map((g) => (g.m ? <mark data-m={g.m}>{g.t}</mark> : g.t))}”<cite><Stars w={44} />{l.name}</cite></span>
          ))}
        </p>
      </div>
    </div>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-mark]').forEach((desk) => {
    const page = desk.querySelector<HTMLElement>('.rm-page')!;
    const pens = Array.from(desk.querySelectorAll<HTMLButtonElement>('[data-pen]'));
    desk.classList.add('is-js');
    pens.forEach((b) => b.addEventListener('click', () => {
      pens.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      page.dataset.on = b.dataset.pen!;
    }));
  });
</script>
<style>
  .rm { padding: 104px 0 112px; }
  .rm-head { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .rm :global(.rm-eb) { justify-content: center; }
  .rm-h { --fs: 56px; --fs-m: 34px; margin-top: 14px; }
  .rm-note { max-width: 600px; margin-top: 18px; font-size: 17px; line-height: 1.5; color: var(--ink); }

  /* The desk: the pens lie across the top edge of the page (depth layer), the page is ruled paper. */
  .rm-desk { position: relative; max-width: 1080px; margin: 52px auto 0; }
  .rm-pens { position: relative; z-index: 2; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 12px; padding: 0 28px; margin-bottom: -30px; }
  .pen { position: relative; display: flex; align-items: stretch; height: 60px; padding: 0; border: 0; background: none; cursor: pointer; color: var(--ink); rotate: calc((var(--k) - 2.5) * .8deg);
    transition: translate .5s var(--ease-io), rotate .5s var(--ease-io); }
  .pen-cap { position: relative; z-index: 1; display: grid; place-items: center; flex: none; width: 46px; border: 2px solid var(--ink); border-radius: 10px 4px 4px 10px; background: var(--powder);
    font: 800 22px/1 var(--f-h); transition: translate .5s var(--ease-io), background-color .5s var(--ease-io); }
  .pen-body { display: flex; align-items: center; flex: 1; min-width: 0; margin-left: -2px; padding: 0 10px; border: 2px solid var(--ink); border-left-width: 0; background: var(--white); box-shadow: 5px 5px 0 rgb(22 19 15 / .18); }
  .pen-t { font: 700 13px/1.15 var(--f-b); text-align: left; }
  .pen-tip { flex: none; width: 14px; margin: 14px 0; border: 2px solid var(--ink); border-left: 0; border-radius: 0 6px 6px 0; background: var(--powder); }
  .pen[aria-pressed='true'] { translate: 0 -10px; rotate: 0deg; }
  .pen[aria-pressed='true'] .pen-cap { translate: -10px 0; background: var(--ink); color: var(--white); }
  @media (hover: hover) and (pointer: fine) { .pen:hover { translate: 0 -5px; } .pen[aria-pressed='true']:hover { translate: 0 -10px; } }
  .pen:focus-visible { outline: 3px solid var(--pdeep); outline-offset: 4px; border-radius: 6px; }
  .rm-desk:not(.is-js) .pen { pointer-events: none; }

  .rm-page { position: relative; z-index: 1; padding: 64px 56px 48px; border: 2px solid var(--ink); border-radius: 8px; box-shadow: 14px 14px 0 var(--powder);
    background: repeating-linear-gradient(180deg, transparent 0 35px, rgb(132 179 199 / .28) 35px 36px), var(--white); background-position: 0 50px; }
  .rm-txt { columns: 2; column-gap: 56px; font-size: 18px; line-height: 36px; color: var(--ink); }
  .s { transition: color .55s var(--ease-io), opacity .55s var(--ease-io); }
  .s :global(.cx-stars) { transition: opacity .55s var(--ease-io); }
  .s cite { display: inline-flex; align-items: center; gap: 6px; margin: 0 18px 0 8px; font: 700 11px/1 var(--f-m); font-style: normal; letter-spacing: .04em; color: var(--pdeep); white-space: nowrap; vertical-align: 1px; }
  mark { padding: 2px 1px; background: linear-gradient(transparent 12%, rgb(132 179 199 / .85) 12%, rgb(132 179 199 / .85) 88%, transparent 88%) no-repeat 0 0 / 0% 100%; color: inherit;
    border-radius: 3px; box-decoration-break: clone; -webkit-box-decoration-break: clone; transition: background-size .7s var(--ease-io); }
  .rm-desk:not(.is-js) mark { text-decoration: underline 2px var(--powder); text-underline-offset: 4px; }
  /* Sentences that do not say it step back to the muted grey (still 6:1 on white, so they stay readable). */
  .rm-desk.is-js .s { color: var(--muted); }
  .rm-page[data-on='price'] .s[data-th~='price'], .rm-page[data-on='pro'] .s[data-th~='pro'], .rm-page[data-on='time'] .s[data-th~='time'],
  .rm-page[data-on='fast'] .s[data-th~='fast'], .rm-page[data-on='explain'] .s[data-th~='explain'], .rm-page[data-on='clean'] .s[data-th~='clean'] { color: var(--ink); }
  .rm-page[data-on='price'] mark[data-m='price'], .rm-page[data-on='pro'] mark[data-m='pro'], .rm-page[data-on='time'] mark[data-m='time'],
  .rm-page[data-on='fast'] mark[data-m='fast'], .rm-page[data-on='explain'] mark[data-m='explain'], .rm-page[data-on='clean'] mark[data-m='clean'] { background-size: 100% 100%; transition-delay: .2s; }
  :global(html:not(.motion)) .s, :global(html:not(.motion)) mark, :global(html:not(.motion)) .pen, :global(html:not(.motion)) .pen-cap { transition: none; }

  @media (min-width: 768px) and (max-width: 1279px) {
    .rm-pens { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 14px; }
    .rm-page { padding: 56px 36px 40px; }
  }
  @media (max-width: 767px) {
    .rm { padding: 64px 0 72px; }
    .rm-h { margin-top: 10px; }
    .rm-note { margin-top: 12px; font-size: 15px; }
    .rm-desk { margin-top: 32px; }
    .rm-pens { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 10px; padding: 0 4px; margin-bottom: -22px; }
    .pen { height: 50px; rotate: 0deg; }
    .pen-cap { width: 38px; font-size: 18px; }
    .pen-body { padding: 0 8px; }
    .pen-t { font-size: 12px; }
    .pen-tip { width: 10px; margin: 12px 0; }
    .rm-page { padding: 44px 18px 24px; box-shadow: 8px 8px 0 var(--powder); background-position: 0 30px; }
    .rm-txt { columns: 1; font-size: 16px; line-height: 32px; }
    .rm-page { background: repeating-linear-gradient(180deg, transparent 0 31px, rgb(132 179 199 / .28) 31px 32px), var(--white); background-position: 0 30px; }
  }
</style>
