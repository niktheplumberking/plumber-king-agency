---
// Promises bento (Figma 718:522 "Promises" y 4290 h 796 / mobile y 3899 h 998). Hover a tile: it lifts 4 px and its offset
// shadow grows. The 16 review dots fill one by one when the tile scrolls in. "Check it yourself" opens the DBPR licence
// search in a new tab. Every line is the Figma copy; the counts come from the 16 Google reviews in reviews.ts.
import Eyebrow from '../kit/Eyebrow.astro';
import Plate from '../kit/Plate.astro';
import Img from '../ui/Img.astro';
import { SITE } from '../../data/site';
const L = SITE.licence;
---
<section class="pr" data-m-section>
  <div class="wrap">
    <Eyebrow text="What you can count on" />
    <h2 class="h2 pr-h" data-t="2" style="--h2:52px;--h2m:36px">Five things<br /><span class="tone">on every job.</span></h2>
    <div class="pr-grid" data-t="3" data-stagger>
      <article class="pr-t pr-lic">
        <p class="pr-k">01 · Licensed</p>
        <h3 class="pr-big">Licensed.<br />Checked on DBPR.</h3>
        <Plate class="pr-plate" tone="ink" shadow={false} title="Florida DBPR lookup" t={false}
          rows={[['Licence', L.number], ['Type', L.kind], ['Status', 'Active'], ['Expires', L.expires]]}
          pad={14} size={11} tsize={12} kx={98} pitch={21} padm={12} sizem={10} kxm={82} pitchm={19} />
        <a class="pr-check" href={L.url} target="_blank" rel="noopener">Check it yourself <span aria-hidden="true">→</span><span class="sr-only"> (DBPR licence search, opens in a new tab)</span></a>
      </article>
      <div class="pr-side">
        <article class="pr-t pr-price">
          <p class="pr-k">02 · Price first</p>
          <h3 class="pr-m">You hear the price before we start.</h3>
          <div class="pr-slip" aria-hidden="true">
            <i></i><i></i><i></i><i></i>
            <span class="sk">Price</span><span class="sv">first</span><span class="sk">Start</span><span class="sv">yes</span>
          </div>
        </article>
        <article class="pr-t pr-time">
          <p class="pr-k">03 · On time</p>
          <h3 class="pr-m">Named in 5 of 16 reviews.</h3>
          <p class="pr-dots" data-pr-dots role="img" aria-label="5 of 16 Google reviews mention being on time">
            {Array.from({ length: 16 }, (_, i) => <span class:list={['pr-dot', i < 5 && 'f']} style={`--d:${i}`}></span>)}
          </p>
          <p class="pr-src">16 Google reviews</p>
        </article>
        <article class="pr-t pr-clean">
          <div class="pr-ph"><Img name="shower-valve" alt="A new shower valve and trim on fresh tile" sizes="(min-width:1280px) 180px, (min-width:768px) 22vw, 167px" box={1} boxM={167 / 80} widths={[200, 360, 540]} /></div>
          <p class="pr-k">04 · Clean up</p>
          <h3 class="pr-m">We leave it clean.</h3>
          <p class="pr-note">Cleaning up is named in 2 of 16 reviews.</p>
        </article>
        <article class="pr-t pr-off">
          <p class="pr-k">05 · Discount</p>
          <p class="pr-pct">10%</p>
          <p class="pr-offt">off for veterans, first responders, teachers &amp; seniors. Up to $100.</p>
        </article>
      </div>
    </div>
  </div>
</section>
<style>
  .pr { background: var(--frost); padding: 110px 0 120px; }
  .pr-h { margin-top: 16px; }
  .pr-grid { display: grid; grid-template-columns: 460px minmax(0, 1fr); gap: 20px; margin-top: 48px; }
  .pr-side { display: grid; grid-template-columns: 340fr 40fr 300fr; grid-template-rows: 180px 180px; gap: 20px; }
  .pr-price { grid-column: 1; } .pr-time { grid-column: 2 / 4; }
  .pr-clean { grid-column: 1 / 3; } .pr-off { grid-column: 3; }
  .pr-t {
    position: relative; border-radius: 8px; background: var(--white); box-shadow: inset 0 0 0 1.5px var(--ink), 0 0 0 var(--ink);
    padding: 22px 24px; overflow: hidden; transition: translate .35s var(--ease-io), box-shadow .35s var(--ease-io);
  }
  .pr-t:hover { translate: 0 -4px; box-shadow: inset 0 0 0 1.5px var(--ink), 6px 6px 0 var(--ink); }
  .pr-k { font-family: var(--f-m); font-weight: 700; font-size: 11px; line-height: 15px; letter-spacing: .06em; text-transform: uppercase; color: var(--pdeep); }
  .pr-m { margin-top: 11px; max-width: 180px; font-family: var(--f-h); font-weight: 800; font-size: 22px; line-height: 1.1; letter-spacing: -.02em; }
  .pr-time .pr-m { max-width: 300px; }

  .pr-lic { height: 380px; padding: 28px; background: var(--ink); color: var(--white); box-shadow: 10px 10px 0 var(--powder); overflow: visible; }
  .pr-lic:hover { box-shadow: 14px 14px 0 var(--powder); }
  .pr-lic .pr-k { color: var(--powder); }
  .pr-big { margin-top: 13px; font-family: var(--f-h); font-weight: 800; font-size: 32px; line-height: 1.06; letter-spacing: -.02em; }
  .pr-lic :global(.pr-plate) { margin-top: 46px; }
  .pr-check { display: inline-block; margin-top: 26px; padding: 10px 0; margin-bottom: -10px; font-weight: 700; font-size: 15px; line-height: 1.5; color: var(--powder); text-decoration: underline; text-decoration-thickness: 1.5px; text-underline-offset: 3px; }
  .pr-check:hover { color: var(--white); }

  .pr-slip {
    position: absolute; left: 214px; top: 40px; width: 104px; height: 54px; padding: 12px 10px 0; rotate: -4deg;
    display: grid; grid-template-columns: 44px 1fr; row-gap: 6px; align-content: start;
    background: var(--frost); border-radius: 3px; box-shadow: inset 0 0 0 1px var(--steel2); font-family: var(--f-m); font-size: 9px; line-height: 12px;
  }
  .pr-slip i { position: absolute; width: 6px; height: 6px; border-radius: 50%; background: var(--steel2); }
  .pr-slip i:nth-child(1) { left: 6px; top: 6px; } .pr-slip i:nth-child(2) { right: 6px; top: 6px; }
  .pr-slip i:nth-child(3) { left: 6px; bottom: 6px; } .pr-slip i:nth-child(4) { right: 6px; bottom: 6px; }
  .pr-slip .sk { font-weight: 500; letter-spacing: .06em; text-transform: uppercase; color: rgba(22,19,15,.7); }
  .pr-slip .sv { font-weight: 700; letter-spacing: .04em; }
  .pr-price:hover .pr-slip { rotate: -1deg; }
  .pr-slip { transition: rotate .4s var(--ease-io); }

  .pr-dots { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 56px; }
  .pr-dot { width: 13px; height: 13px; border-radius: 50%; box-shadow: inset 0 0 0 1.2px var(--pdeep); background: transparent; transition: background-color .25s var(--ease-io) calc(var(--d) * 90ms); }
  .pr-dot.f { background: var(--pdeep); }
  :global(html.motion) .pr-dots:not(.in) .pr-dot.f { background: transparent; }
  .pr-src { margin-top: 9px; font-family: var(--f-m); font-weight: 500; font-size: 9px; line-height: 12px; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }

  .pr-clean { padding-right: 204px; }
  .pr-ph { position: absolute; right: 0; top: 0; bottom: 0; width: 180px; overflow: hidden; border-radius: 0 8px 8px 0; }
  .pr-note { margin-top: 16px; font-size: 13px; line-height: 1.5; color: var(--muted); }

  .pr-off { background: var(--powder); box-shadow: 0 0 0 var(--ink); }
  .pr-off:hover { box-shadow: 6px 6px 0 var(--ink); }
  .pr-off .pr-k { color: var(--ink); }
  .pr-pct { margin-top: 1px; font-family: var(--f-h); font-weight: 900; font-size: 72px; line-height: 1; letter-spacing: -.02em; }
  .pr-offt { margin-top: 6px; max-width: 252px; font-size: 13px; line-height: 1.35; }

  @media (min-width: 768px) and (max-width: 1279px) {
    .pr-grid { grid-template-columns: minmax(0, 1fr); }
    .pr-lic { height: auto; }
    .pr-side { grid-template-rows: auto auto; }
    .pr-t { min-height: 180px; }
    .pr-slip { left: auto; right: 20px; }
  }
  @media (max-width: 767px) {
    .pr { padding: 64px 0 90px; }
    .pr-h { margin-top: 12px; }
    .pr-grid { grid-template-columns: minmax(0, 1fr); gap: 16px; margin-top: 28px; }
    .pr-side { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: 176px 176px; gap: 16px; }
    .pr-price, .pr-time, .pr-clean, .pr-off { grid-column: auto; }
    .pr-t { padding: 16px 14px; }
    .pr-t:hover { translate: none; }
    .pr-k { font-size: 9px; line-height: 12px; }
    .pr-m { margin-top: 10px; max-width: 139px; font-size: 17px; line-height: 1.12; }
    .pr-time .pr-m { max-width: 139px; }
    .pr-lic { height: 330px; padding: 22px 20px; box-shadow: 6px 6px 0 var(--powder); }
    .pr-lic .pr-k { font-size: 10px; line-height: 13px; }
    .pr-big { margin-top: 9px; font-size: 26px; }
    .pr-lic :global(.pr-plate) { margin-top: 24px; }
    .pr-check { margin-top: 32px; }
    .pr-slip, .pr-note, .pr-src { display: none; }
    .pr-dots { gap: 6px; margin-top: 42px; max-width: 132px; }
    .pr-dot { width: 11px; height: 11px; }
    .pr-clean { padding: 94px 14px 16px; }
    .pr-clean .pr-m { margin-top: 8px; }
    .pr-ph { left: 0; right: 0; bottom: auto; width: auto; height: 80px; border-radius: 8px 8px 0 0; }
    .pr-pct { font-size: 52px; margin-top: 4px; }
    .pr-offt { margin-top: 8px; font-size: 12px; }
  }
</style>
<script>
  // Fill the review dots one by one (CSS transition-delay per dot) when the tile is well in view.
  document.querySelectorAll<HTMLElement>('[data-pr-dots]').forEach((el) => {
    if (!('IntersectionObserver' in window)) { el.classList.add('in'); return; }
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { el.classList.add('in'); io.disconnect(); } }), { rootMargin: '0px 0px -15% 0px' });
    io.observe(el);
  });
</script>
