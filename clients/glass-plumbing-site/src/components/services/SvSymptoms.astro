---
// Symptom picker (Figma 718:522 "Symptom picker" y 818 h 768 / mobile y 1022 h 915). Eight cards, each a little frost sight
// glass whose water level is the Figma's. Desktop: the title is a stretched link to the usual job; "Call" and "Text a photo"
// sit above it. Phone: the whole card is that one link (call and text are in the sticky call bar).
import Eyebrow from '../kit/Eyebrow.astro';
import Housing from '../kit/Housing.astro';
import { SITE } from '../../data/site';
import { SYMPTOMS } from './data';
import { ARROW } from './glyphs';
---
<section class="sy" data-m-section>
  <div class="wrap">
    <div class="sy-top">
      <div>
        <Eyebrow text="Tell us what you see" />
        <h2 class="h2 sy-h" data-t="2" style="--h2:52px;--h2m:30px">Not sure what it’s called?<br /><span class="tone">Start with what you see.</span></h2>
      </div>
      <p class="sy-lead" data-t="3">Pick the closest one. It tells you which job it usually is, and you can call or text a photo from there.</p>
    </div>
    <ul class="sy-grid" role="list" data-t="3" data-stagger>
      {SYMPTOMS.map((s) => (
        <li class="sy-card">
          <Housing w={34} h={52} wm={26} hm={40} r={10} rm={8} cap={14} tone="frost" fill={s.fill} class="sy-g" />
          <a class="sy-name" href={s.href}>
            {s.nameM ? <><span class="d">{s.name}</span><span class="m">{s.nameM}</span></> : s.name}
            <span class="sr-only">: usually {s.job}</span>
          </a>
          <p class="sy-job" aria-hidden="true"><span class="d">Usually: {s.job}</span><span class="m">{s.jobM ?? s.job}</span></p>
          <div class="sy-act">
            <a class="sy-call" href={SITE.tel}>Call</a>
            <a class="sy-text" href={SITE.sms}>Text a photo</a>
          </div>
          <span class="sy-ar" set:html={ARROW} />
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .sy { background: var(--white); padding: 96px 0 100px; }
  .sy-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 40px; }
  .sy-h { margin-top: 16px; max-width: 760px; }
  .sy-lead { width: 400px; margin-top: 44px; font-size: 16px; line-height: 1.5; color: var(--muted); }
  .sy-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; margin: 66px 0 0; padding: 0; list-style: none; }
  .sy-card {
    position: relative; height: 172px; padding: 22px 20px 0; background: var(--white); border-radius: 4px;
    box-shadow: inset 0 0 0 1.5px var(--ink); transition: box-shadow .3s var(--ease-io), translate .3s var(--ease-io);
    display: grid; grid-template-columns: 34px minmax(0, 1fr); grid-template-rows: 82px 28px auto; column-gap: 18px; align-content: start;
  }
  .sy-card:hover { translate: 0 -2px; box-shadow: inset 0 0 0 1.5px var(--ink), 4px 4px 0 var(--powder); }
  .sy-card :global(.sy-g) { grid-row: 1; grid-column: 1; margin-left: 0; }
  .sy-name { grid-row: 1; grid-column: 2; align-self: start; font-family: var(--f-h); font-weight: 800; font-size: 20px; line-height: 1.1; letter-spacing: -.02em; color: var(--ink); }
  .sy-name::after { content: ''; position: absolute; inset: 0; border-radius: 4px; }
  .sy-name:focus-visible { outline: none; }
  .sy-name:focus-visible::after { outline: 3px solid var(--pdeep); outline-offset: 3px; }
  .sy-job { grid-row: 2; grid-column: 1 / -1; font-family: var(--f-m); font-weight: 700; font-size: 10px; line-height: 13px; letter-spacing: .02em; color: var(--pdeep); }
  .sy-act { grid-row: 3; grid-column: 1 / -1; position: relative; z-index: 1; display: flex; gap: 25px; margin: 0 -20px; padding: 0 20px; border-top: 1px solid rgba(22,19,15,.1); height: 40px; align-items: center; width: max-content; }
  .sy-act { width: auto; }
  .sy-act a { font-family: var(--f-b); font-weight: 700; font-size: 14px; line-height: 21px; padding: 10px 0; }
  .sy-call { color: var(--ink); }
  .sy-text { color: var(--pdeep); }
  .sy-act a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .sy-ar { position: absolute; right: 20px; bottom: 16px; display: block; width: 12px; height: 10px; color: var(--ink); pointer-events: none; transition: translate .3s var(--ease-io); }
  .sy-ar :global(svg) { display: block; width: 12px; height: 10px; }
  .sy-card:hover .sy-ar { translate: 6px 0; }
  .sy-act { pointer-events: none; }
  .sy-act a { pointer-events: auto; }

  @media (min-width: 768px) and (max-width: 1279px) {
    .sy-top { flex-direction: column; gap: 0; }
    .sy-lead { width: auto; max-width: 560px; margin-top: 20px; }
    .sy-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 40px; }
  }
  @media (max-width: 767px) {
    .sy { padding: 64px 0 68px; }
    .sy-h { margin-top: 10px; }
    .sy-lead { display: none; }
    .sy-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 8px; margin-top: 28px; }
    .sy-card { height: 150px; padding: 16px 14px 0; grid-template-columns: minmax(0, 1fr); grid-template-rows: 50px 58px auto; }
    .sy-card :global(.sy-g) { grid-row: 1; }
    .sy-name { grid-row: 2; grid-column: 1; font-size: 16px; }
    .sy-job { grid-row: 3; font-size: 8px; line-height: 11px; letter-spacing: .01em; }
    .sy-act { display: none; }
    .sy-ar { top: 24px; bottom: auto; right: 16px; }
  }
</style>
