---
// /areas/seminole "Local facts", R4 (independent re-check R3 MAJOR 3: this clipboard of four tabs and /areas AreasFacts
// were the same device, four tabs + a "READING 0N" card, sharing 217 ppm and the storm facts; both close to Khinda /areas
// Rules). The county-wide facts now live on /areas only (and 217 ppm in this page's FAQ, as before); this section keeps
// what is about Seminole and its homes. New idea, THE TAPE MEASURE: two tapes on one steel bench.
//   1. Distance: a tape measure case marked LARGO; as the bench scrolls in, the tape runs out of the case, mile marks
//      0-6, until its hook catches at SEMINOLE, 5.9 mi (kit scrub data-scrub-ft, the scroll drives it).
//   2. Your home: a second tape of build years 1950-2020 with the polybutylene years (1978-1995, third-party, Florida-wide)
//      hatched on it. Drag the hook (a real range input: arrows, Page Up / Down, Home / End) to your home's build year and
//      the line under it says whether that year sits inside the window, and what to do (text a photo of the pipe).
// 21st.dev: "Marks Slider" (@ai2, id 29217: a ruler-style range with labelled ticks) + "Time Ruler" (@romanvasnev,
// id 40126: a value picked on a draggable ruler with a badge), rebuilt as a native range input + CSS, re-skinned as a
// cream tape with ink ticks on a steel bench with rivets.
// Nearest match: Glass /areas AreasFacts (fogged panes you wipe), Glass home Areas (split-flap board), Glass Seminole
// TownNearby (stamps with miles), Khinda city Distance (a cable drawn on a map screenshot), Khinda SvPricing (a range that
// prices a job). No tape measure, and no build-year check, on either site.
// Facts: miles = Census Gazetteer points (LOCAL-FACTS 1, towns.ts); polybutylene 1978-1995 = third-party, labelled and
// hedged ("often"), no Seminole count (research has none). No JS: the readout shows the default year's line; the tape is out.
import Head from '../areas/Head.astro';
import Seam from '../kit/Seam.astro';
import { TOWN } from './data';
const MAX = 6;
const miPct = (TOWN.mi / MAX) * 100;
const Y0 = 1950, Y1 = 2020, PB0 = 1978, PB1 = 1995, DEF = 1985;
const yPct = (y: number) => ((y - Y0) / (Y1 - Y0)) * 100;
const verdict = (y: number) => y >= PB0 && y <= PB1
  ? `Inside the 1978–1995 window. Florida homes built in these years often got grey polybutylene supply pipe, and many insurers limit it. Text us a photo of the pipe under a sink.`
  : `Outside the 1978–1995 polybutylene window. Not sure what you have? Text us a photo of the pipe under a sink.`;
---
<section class="tfacts" data-m-section aria-labelledby="tfacts-h">
  <Seam from="var(--white)" to="var(--frost)" />
  <div class="wrap">
    <div class="tf-head">
      <Head eyebrow="Local facts" l1="Two things to measure" l2="before you call." size={52} sizeM={30} id="tfacts-h" />
      <p class="tf-lead" data-t="3">How far Seminole is from our base, and whether your home’s build year matters for its pipes.</p>
    </div>

    <div class="bench" data-t="4" data-fx="up">
      <i class="rv" aria-hidden="true"></i><i class="rv" aria-hidden="true"></i><i class="rv" aria-hidden="true"></i><i class="rv" aria-hidden="true"></i>

      <div class="row">
        <div class="rd">
          <p class="rd-k">01 · Distance</p>
          <p class="rd-v">{TOWN.mi} <small>mi</small></p>
          <p class="rd-d">From our Largo base to Seminole, in a straight line between Census map points. Driving is longer: call and we tell you when we can come.</p>
        </div>
        <div class="tm" data-scrub data-start="top 85%" data-end="center 45%" data-start-m="top 92%" data-end-m="center 55%" data-lag="0.5" aria-hidden="true">
          <div class="tm-case"><span class="tm-hub"></span><span class="tm-lb">Largo</span></div>
          <div class="tm-run">
            <div class="tm-tape" data-scrub-ft='{"from":{"x":0,"xPercent":-100},"to":{"x":0,"xPercent":0}}'>
              <div class="tm-scale" style={`--to:${miPct}%`}>
                {Array.from({ length: MAX * 2 + 1 }, (_, i) => <span class:list={['tk', i % 2 === 0 && 'tk-big']} style={`left:${(i / (MAX * 2)) * 100}%`}>{i % 2 === 0 && <b>{i / 2}</b>}</span>)}
              </div>
              <span class="tm-hook" style={`left:${miPct}%`}><span data-scrub-ft='{"from":{"opacity":0},"to":{"opacity":1}}' data-win="0.8,1">Seminole</span></span>
            </div>
          </div>
        </div>
        <p class="sr-only">Seminole is {TOWN.mi} miles from our Largo base in a straight line.</p>
        <p class="src">Source: US Census 2024 Gazetteer points, read 17 Nov 2026</p>
      </div>

      <div class="row row-y" data-yr>
        <div class="rd">
          <p class="rd-k">02 · Your home</p>
          <p class="rd-v"><label for="tf-yr">Built in</label> <output for="tf-yr" data-yr-out>{DEF}</output></p>
          <p class="rd-d" data-yr-v aria-live="polite">{verdict(DEF)}</p>
        </div>
        <div class="yr">
          <div class="yr-tape" aria-hidden="true">
            <span class="yr-pb" style={`left:${yPct(PB0)}%;width:${yPct(PB1) - yPct(PB0)}%`}><b>Polybutylene years</b></span>
            {Array.from({ length: (Y1 - Y0) / 5 + 1 }, (_, i) => { const y = Y0 + i * 5; return <span class:list={['tk', y % 10 === 0 && 'tk-big']} style={`left:${yPct(y)}%`}>{y % 10 === 0 && <b>{y}</b>}</span>; })}
          </div>
          <input class="yr-in" id="tf-yr" type="range" min={Y0} max={Y1} step="1" value={DEF} aria-describedby="tf-yr-hint" data-yr-in />
          <p class="yr-hint" id="tf-yr-hint">Drag the hook to the year your home was built.</p>
        </div>
        <p class="src">Source: third-party, Florida-wide pattern (NBC 6 Responds, barchart.com), read 17 Nov 2026. We have no count for Seminole.</p>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-yr]').forEach((row) => {
    const inp = row.querySelector<HTMLInputElement>('[data-yr-in]')!;
    const out = row.querySelector<HTMLOutputElement>('[data-yr-out]')!;
    const v = row.querySelector<HTMLElement>('[data-yr-v]')!;
    let last = '';
    const upd = () => {
      const y = Number(inp.value); out.textContent = String(y);
      const inside = y >= 1978 && y <= 1995;
      row.classList.toggle('is-in', inside);
      const t = inside
        ? 'Inside the 1978–1995 window. Florida homes built in these years often got grey polybutylene supply pipe, and many insurers limit it. Text us a photo of the pipe under a sink.'
        : 'Outside the 1978–1995 polybutylene window. Not sure what you have? Text us a photo of the pipe under a sink.';
      if (t !== last) { v.textContent = t; last = t; }
      inp.style.setProperty('--p', String((y - 1950) / 70));
    };
    inp.addEventListener('input', upd); upd();
  });
</script>

<style>
  .tfacts { position: relative; background: var(--frost); padding: 120px 0 110px; }
  .tf-head { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .tf-head :global(.ah-eb) { justify-content: center; }
  .tf-lead { max-width: 560px; margin-top: 18px; font-size: 17px; line-height: 1.5; color: var(--muted); }

  /* The bench: one steel plate with rivets holding both tapes. */
  .bench { position: relative; max-width: 1080px; margin: 56px auto 0; padding: 48px 56px 44px; border-radius: 10px; background: var(--steel); box-shadow: inset 0 0 0 1.5px var(--steel2), 12px 12px 0 var(--ink); }
  .rv { position: absolute; width: 8px; height: 8px; border-radius: 50%; background: var(--steel2); box-shadow: inset 0 0 0 1px rgb(22 19 15 / .3); }
  .rv:nth-child(1) { left: 12px; top: 12px; } .rv:nth-child(2) { right: 12px; top: 12px; } .rv:nth-child(3) { left: 12px; bottom: 12px; } .rv:nth-child(4) { right: 12px; bottom: 12px; }
  .row + .row { margin-top: 44px; padding-top: 40px; border-top: 1.5px dashed rgb(22 19 15 / .35); }
  .rd { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 32px; align-items: end; }
  .rd-k { grid-column: 1 / -1; font: 700 12px/1 var(--f-m); letter-spacing: .1em; text-transform: uppercase; color: var(--ink); }
  .rd-v { margin-top: 10px; font: 800 64px/1 var(--f-h); letter-spacing: -.03em; color: var(--ink); white-space: nowrap; }
  .rd-v small { font-size: .45em; letter-spacing: 0; color: var(--pdeep); }
  .rd-v label { font-size: .45em; letter-spacing: 0; color: var(--pdeep); }
  .rd-v output { font-variant-numeric: tabular-nums; }
  .rd-d { max-width: 560px; font-size: 16px; line-height: 1.5; color: var(--ink); }
  .src { margin-top: 14px; font: 500 11px/1.4 var(--f-m); color: rgb(22 19 15 / .78); }

  /* Tape 1: the case on the left, the tape running out to the right. */
  .tm { display: flex; align-items: center; margin-top: 26px; }
  .tm-case { position: relative; z-index: 2; flex: none; display: grid; place-items: center; width: 108px; height: 108px; border-radius: 26px; background: var(--ink); box-shadow: 6px 6px 0 var(--powder); }
  .tm-hub { width: 46px; height: 46px; border-radius: 50%; background: var(--powder); box-shadow: inset 0 0 0 8px var(--ink2), 0 0 0 2px var(--powder); }
  .tm-lb { position: absolute; bottom: 10px; font: 700 9px/1 var(--f-m); letter-spacing: .14em; text-transform: uppercase; color: var(--frost); }
  .tm-run { position: relative; flex: 1; margin-left: -4px; padding: 28px 70px 30px 0; overflow: hidden; }
  .tm-tape { position: relative; height: 48px; }
  :global(html.motion) .tm:not(.is-scrub) .tm-tape { transform: translateX(-100%); }
  :global(html.motion) .tm:not(.is-scrub) .tm-hook span { opacity: 0; }
  .tm-scale { position: absolute; inset: 0; border-radius: 0 4px 4px 0; background: var(--cream); box-shadow: inset 0 0 0 1.5px var(--ink); }
  .tk { position: absolute; top: 0; width: 1.5px; height: 12px; margin-left: -.75px; background: var(--ink); }
  .tk-big { height: 22px; }
  .tk b { position: absolute; top: 24px; left: 50%; translate: -50% 0; font: 700 11px/1 var(--f-m); color: var(--ink); }
  .tm-hook { position: absolute; top: -8px; bottom: -8px; width: 14px; margin-left: -7px; border-radius: 3px; background: var(--ink); }
  .tm-hook span { position: absolute; left: 50%; bottom: calc(100% + 6px); translate: -50% 0; padding: 5px 9px; border-radius: 4px; background: var(--ink); color: var(--white); font: 700 11px/1 var(--f-m); letter-spacing: .06em; text-transform: uppercase; white-space: nowrap; }

  /* Tape 2: a build-year rule with the polybutylene years hatched; the range input's thumb is the hook. */
  .yr { position: relative; margin-top: 34px; padding-top: 30px; --th: 28px; }
  .yr-tape { position: absolute; left: calc(var(--th) / 2); right: calc(var(--th) / 2); top: 30px; height: 48px; border-radius: 4px; background: var(--cream); box-shadow: inset 0 0 0 1.5px var(--ink); }
  .yr-pb { position: absolute; top: 0; bottom: 0; background: repeating-linear-gradient(-45deg, rgb(47 97 120 / .35) 0 5px, transparent 5px 10px); box-shadow: inset 0 0 0 1.5px var(--pdeep); }
  .yr-pb b { position: absolute; bottom: calc(100% + 6px); left: 0; font: 700 11px/1 var(--f-m); letter-spacing: .04em; text-transform: uppercase; color: var(--ink); white-space: nowrap; }
  .yr-in { position: relative; z-index: 2; display: block; width: 100%; height: 48px; margin: 0; background: none; cursor: pointer; -webkit-appearance: none; appearance: none; }
  .yr-in::-webkit-slider-runnable-track { height: 48px; background: transparent; }
  .yr-in::-moz-range-track { height: 48px; background: transparent; }
  .yr-in::-webkit-slider-thumb { -webkit-appearance: none; width: var(--th); height: 64px; margin-top: -8px; border: 0; border-radius: 4px; background: var(--ink); box-shadow: 4px 4px 0 var(--powder); }
  .yr-in::-moz-range-thumb { width: var(--th); height: 64px; border: 0; border-radius: 4px; background: var(--ink); box-shadow: 4px 4px 0 var(--powder); }
  .yr-in:focus-visible { outline: 3px solid var(--pdeep); outline-offset: 6px; border-radius: 6px; }
  .row-y.is-in .rd-v output { color: var(--pdeep); }
  .yr-hint { margin-top: 30px; font: 500 12px/1.4 var(--f-m); color: var(--ink); }

  @media (min-width: 768px) and (max-width: 1279px) {
    .bench { padding: 40px 36px; }
    .rd { grid-template-columns: 1fr; }
    .rd-d { margin-top: 12px; }
  }
  @media (max-width: 767px) {
    .tfacts { padding: 72px 0 64px; }
    .tf-lead { font-size: 15px; margin-top: 12px; }
    .bench { margin-top: 36px; padding: 28px 16px 24px; box-shadow: inset 0 0 0 1.5px var(--steel2), 6px 6px 0 var(--ink); }
    .row + .row { margin-top: 30px; padding-top: 26px; }
    .rd { grid-template-columns: 1fr; }
    .rd-v { font-size: 46px; }
    .rd-d { margin-top: 10px; font-size: 15px; }
    .tm { margin-top: 18px; }
    .tm-case { width: 64px; height: 64px; border-radius: 16px; box-shadow: 4px 4px 0 var(--powder); }
    .tm-hub { width: 26px; height: 26px; box-shadow: inset 0 0 0 5px var(--ink2), 0 0 0 1.5px var(--powder); }
    .tm-lb { bottom: 5px; font-size: 7px; }
    .tm-run { padding: 30px 46px 28px 0; }
    .tm-tape { height: 38px; }
    .tk-big { height: 16px; }
    .tk b { top: 18px; font-size: 9px; }
    .tm-hook span { font-size: 9px; padding: 4px 6px; }
    .yr { --th: 24px; }
    .yr .tk:not(.tk-big) { display: none; }
    .yr .tk b { font-size: 8px; }
    .yr-pb b { font-size: 9px; }
  }
</style>
