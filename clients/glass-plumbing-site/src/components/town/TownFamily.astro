---
// /areas/seminole "Family band" (Figma y 4527 h 300 / mobile y 4144 h 268). Ink2. The crew photo in a standing housing that
// pokes 60 px (phones 44) up into the frost section above; "The Glass brothers, Largo." (David Peek's own words, checked
// against reviews.ts), licence line. The photo is not captioned with anyone's name.
import Housing from '../kit/Housing.astro';
import Img from '../ui/Img.astro';
import { quote } from '../areas/reviews';
import { SITE } from '../../data/site';
const q = quote('David Peek', 'The Glass brothers with Glass Plumbing Services are the best!');
---
<section class="tfam" data-m-section aria-labelledby="tfam-h">
  <div class="wrap tf-grid">
    <div class="tf-jar" data-t="4" data-fx="frame">
      <Housing w={220} h={300} wm={130} hm={180} cap={21} capm={14} shadow={10} shadowm={6} tone="photo">
        <Img name="crew-crawlspace" alt="A Glass Plumbing crew member smiling from under a house, in a crawlspace" sizes="(min-width:768px) 220px, 130px" box={220 / 281} boxM={130 / 168} widths={[130, 220, 260, 440]} focus="50% 40%" />
      </Housing>
    </div>
    <div class="tf-copy">
      <h2 id="tfam-h" class="tf-h" data-t="2">The Glass brothers, Largo.</h2>
      <p class="tf-q" data-t="3">“{q}” David Peek<span class="d">, Google</span></p>
      <p class="tf-l" data-t="3"><span class="d">Same licensed crew in Seminole as in Largo. FL {SITE.licence.number}.</span><span class="m">Same licensed crew. FL {SITE.licence.number}.</span></p>
    </div>
  </div>
</section>

<style>
  .tfam { position: relative; z-index: 1; background: var(--ink2); color: var(--white); height: 300px; }
  .tf-grid { display: grid; grid-template-columns: 220px 1fr; column-gap: 60px; align-items: start; }
  .tf-jar { position: relative; margin-top: -60px; }
  .tf-jar :global(.hs-cap), .tf-jar :global(.hs-port) { background: var(--steel2); } /* Figma: steel cap + port on this photo housing */
  .tf-jar :global(.hs-glass)::after { box-shadow: inset 0 0 0 2px var(--white); }
  .tf-copy { padding-top: 70px; }
  .tf-h { font-family: var(--f-h); font-weight: 800; font-size: 40px; line-height: 1.04; letter-spacing: -.02em; color: var(--white); }
  .tf-q { margin-top: 16px; font-style: italic; font-size: 17px; line-height: 1.5; color: var(--white); }
  .tf-l { margin-top: 14px; font-size: 16px; line-height: 1.5; color: rgb(255 255 255 / .8); }
  .m { display: none; }
  @media (min-width: 768px) and (max-width: 1279px) {
    .tfam { height: auto; padding-bottom: 60px; }
    .tf-copy { padding-top: 56px; }
    .tf-h { font-size: 34px; }
  }
  @media (max-width: 767px) {
    .tfam { height: 268px; }
    .tf-grid { grid-template-columns: 1fr; }
    .tf-jar { position: absolute; right: 30px; top: -44px; margin: 0; }
    .tf-copy { padding-top: 40px; }
    .tf-h { width: 200px; font-size: 22px; }
    .tf-q { margin-top: 70px; font-size: 14px; }
    .tf-l { margin-top: 20px; font-size: 13px; }
    .d { display: none; } .m { display: inline; }
  }
</style>
