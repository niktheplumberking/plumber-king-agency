---
// /areas/seminole "Neighbourhoods" (Figma y 3033 h 364 / mobile y 2775 h 392). Frost. Six neighbourhood chips (Figma copy;
// the Kody-to-confirm note stays off the site).
import Head from '../areas/Head.astro';
const hoods = ['Bardmoor', 'Seminole Lake Country Club', 'Oakhurst Shores', 'Oakhurst Highlands', 'Seminole Country Estates', 'Lake Gardens'];
---
<section class="thood" data-m-section aria-labelledby="thood-h">
  <div class="wrap th-grid">
    <Head eyebrow="Neighbourhoods" l1="All over" l2="Seminole." size={48} sizeM={28} id="thood-h" />
    <div class="th-side">
      <ul class="th-chips" role="list" data-t="4" data-stagger>{hoods.map((h) => <li class="th-chip">{h}</li>)}</ul>
      <p class="th-note" data-t="5">Not listed? If you are in Seminole, we cover you.</p>
    </div>
  </div>
</section>

<style>
  .thood { position: relative; background: var(--frost); padding: 100px 0 77px; }
  .th-grid { display: grid; grid-template-columns: 440px 760px; justify-content: space-between; align-items: start; }
  .th-side { padding-top: 20px; }
  .th-chips { display: flex; flex-wrap: wrap; gap: 27px 12px; }
  .th-chip { padding: 5px 17px 4px; background: var(--white); border: 1.2px solid var(--ink); border-radius: 18.5px; font-weight: 600; font-size: 17px; line-height: 26px; color: var(--ink); }
  .th-note { margin-top: 43px; font-size: 15px; line-height: 1.5; color: var(--muted); }
  @media (min-width: 768px) and (max-width: 1279px) {
    .th-grid { grid-template-columns: minmax(0, .6fr) minmax(0, 1fr); column-gap: 40px; }
    .th-chips { gap: 16px 12px; }
  }
  @media (max-width: 767px) {
    .thood { padding: 48px 0 30px; }
    .th-grid { display: block; }
    .th-side { padding-top: 24px; }
    .th-chips { gap: 14px 8px; }
    .th-chip { display: flex; align-items: center; height: 44px; padding: 0 11px; border-radius: 22px; font-size: 14px; line-height: 21px; }
    .th-note { margin-top: 26px; font-size: 13px; }
  }
</style>
