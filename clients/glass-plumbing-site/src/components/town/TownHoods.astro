---
// /areas/seminole "Neighbourhoods" (R2 rebuild: the R1 head-left / chips-right with an empty field was rule-14 slop).
// Frost. Centred head, then two rows of steel street plates that slide in opposite directions with the page scroll
// (21st.dev cnippet-dev/scroll-velocity-text "opposing rows", rebuilt in vanilla TS: driven by scroll position only,
// so it never moves on its own and needs no pause). Hover lifts a plate. Six neighbourhoods (Figma copy); the moving rows
// are decorative copies, the real list is the sr-only <ul>. Reduced motion / no JS: one static, centred, wrapped row.
import Head from '../areas/Head.astro';
const hoods = ['Bardmoor', 'Seminole Lake Country Club', 'Oakhurst Shores', 'Oakhurst Highlands', 'Seminole Country Estates', 'Lake Gardens'];
const rowA = [...hoods, ...hoods, ...hoods];
const rowB = [...hoods.slice(3), ...hoods.slice(0, 3), ...hoods.slice(3), ...hoods.slice(0, 3), ...hoods.slice(3), ...hoods.slice(0, 3)];
---
<section class="thood" data-m-section aria-labelledby="thood-h">
  <div class="wrap th-head">
    <Head eyebrow="Neighbourhoods" l1="All over" l2="Seminole." size={56} sizeM={32} id="thood-h" />
  </div>
  <ul class="sr-only" aria-label="Seminole neighbourhoods we cover">{hoods.map((h) => <li>{h}</li>)}</ul>
  <div class="th-rows" aria-hidden="true" data-t="4" data-hoods data-marquee>
    <div class="th-row" data-hood-row="-1">{rowA.map((h) => <span class="th-plate"><b>{h}</b><i>Seminole, FL</i></span>)}</div>
    <div class="th-row" data-hood-row="1">{rowB.map((h) => <span class="th-plate th-plate--ink"><b>{h}</b><i>Seminole, FL</i></span>)}</div>
  </div>
  <div class="th-static" aria-hidden="true">{hoods.map((h) => <span class="th-plate"><b>{h}</b><i>Seminole, FL</i></span>)}</div>
  <p class="wrap th-note" data-t="3">Not listed? If you are in Seminole, we cover you.</p>
</section>

<script>
  import { motionOn } from '../areas/inview';
  // Each row's x follows how far the section has travelled through the viewport (0 -> 1): row 1 moves left, row 2 right,
  // by up to 30 % of its own width. One rAF per scroll frame; off-screen it does nothing.
  document.querySelectorAll<HTMLElement>('[data-hoods]').forEach((wrap) => {
    if (!motionOn()) return;
    const sec = wrap.closest('section')!;
    sec.classList.add('is-moving');
    const rows = [...wrap.querySelectorAll<HTMLElement>('[data-hood-row]')];
    let ticking = false;
    const draw = () => {
      ticking = false;
      const r = sec.getBoundingClientRect();
      const vh = innerHeight;
      if (r.bottom < 0 || r.top > vh) return;
      const p = Math.min(1, Math.max(0, (vh - r.top) / (vh + r.height)));
      rows.forEach((row) => {
        const dir = parseFloat(row.dataset.hoodRow!);
        const span = row.scrollWidth * 0.3;
        const x = dir < 0 ? -p * span : (p - 1) * span;
        row.style.transform = `translate3d(${x.toFixed(1)}px,0,0)`;
      });
    };
    const req = () => { if (!ticking) { ticking = true; requestAnimationFrame(draw); } };
    addEventListener('scroll', req, { passive: true });
    addEventListener('resize', req);
    draw();
  });
</script>

<style>
  .thood { position: relative; background: var(--frost); padding: 110px 0 90px; overflow: hidden; }
  .th-head { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .th-head :global(.ah-eb) { justify-content: center; }
  .th-rows { display: none; margin-top: 52px; }
  .th-row { display: flex; gap: 16px; width: max-content; will-change: transform; }
  .th-row + .th-row { margin-top: 16px; }
  .is-moving .th-rows { display: block; }
  .is-moving .th-static { display: none; }
  .th-static { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; max-width: 1000px; margin: 44px auto 0; padding: 0 var(--gutter); }
  .th-plate { position: relative; display: inline-flex; flex-direction: column; justify-content: center; min-height: 84px; padding: 14px 28px; background: var(--steel); border-radius: 4px; box-shadow: inset 0 0 0 1px var(--steel2), 6px 6px 0 var(--ink); color: var(--ink); white-space: nowrap; transition: translate .4s var(--ease-io), box-shadow .4s var(--ease-io); }
  .th-plate--ink { background: var(--ink); color: var(--white); box-shadow: inset 0 0 0 1px var(--ink3), 6px 6px 0 var(--powder); }
  .th-plate::before, .th-plate::after { content: ''; position: absolute; top: 50%; width: 6px; height: 6px; margin-top: -3px; border-radius: 50%; background: var(--steel2); }
  .th-plate::before { left: 9px; } .th-plate::after { right: 9px; }
  .th-plate--ink::before, .th-plate--ink::after { background: var(--ink3); }
  .th-plate b { font-family: var(--f-h); font-weight: 800; font-size: 28px; line-height: 1.04; letter-spacing: -.02em; }
  .th-plate i { margin-top: 6px; font-style: normal; font-family: var(--f-m); font-weight: 700; font-size: 10px; letter-spacing: .08em; text-transform: uppercase; opacity: .7; }
  .th-rows:hover .th-plate:hover { translate: 0 -4px; }
  .th-note { margin-top: 40px; text-align: center; font-size: 15px; line-height: 1.5; color: var(--muted); }
  @media (max-width: 767px) {
    .thood { padding: 56px 0 48px; }
    .th-rows { margin-top: 28px; }
    .th-row { gap: 10px; }
    .th-row + .th-row { margin-top: 10px; }
    .th-plate { min-height: 62px; padding: 10px 20px; box-shadow: inset 0 0 0 1px var(--steel2), 4px 4px 0 var(--ink); }
    .th-plate--ink { box-shadow: inset 0 0 0 1px var(--ink3), 4px 4px 0 var(--powder); }
    .th-plate b { font-size: 19px; }
    .th-plate i { font-size: 9px; }
    .th-static { gap: 10px; margin-top: 28px; }
    .th-static .th-plate { white-space: normal; text-align: center; }
    .th-note { margin-top: 26px; font-size: 13px; }
  }
</style>
