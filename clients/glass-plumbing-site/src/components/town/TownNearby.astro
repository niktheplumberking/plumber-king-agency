---
// /areas/seminole "Nearby towns", fix round 3 (E, RECHECK BLOCKER 3: the pond with distance rings and towns on the rings
// was Khinda's /areas Rings). New idea, A SHEET OF STAMPS: the towns around Seminole as a perforated sheet of postage
// stamps, one per town. Each stamp has a small line drawing, the town name and, as its "value", the straight-line miles
// from our Largo base (towns.ts, Census points). Point at a stamp (hover / focus / tap): it lifts off the sheet, the others
// dim, and a Largo postmark with wavy cancel lines draws over it ("sent from Largo"). Every stamp is a link to /areas.
// Seminole itself is left off the sheet (its distance shows once in the hero and once in Local facts: RECHECK MAJOR 1).
// No rings, no positions by distance, no map. 21st.dev: lavikatiyar "Cards" (hover-reveal grid: the hovered card is lit,
// the rest blur and fade; keyboard accessible) + ham7a311 "Ticket Card" (perforated edge), rebuilt as vanilla CSS/TS and
// re-skinned with Glass tokens (powder offset shadow, mono labels, meniscus waves as the cancel lines).
// Reduced motion / no JS: a static sheet, the postmark shows on hover/focus without drawing.
import { TOWNS } from '../../data/towns';
const pick = ['largo', 'belleair-bluffs', 'indian-rocks-beach', 'pinellas-park', 'redington-shores', 'madeira-beach'];
const near = pick.map((s) => TOWNS.find((t) => t.slug === s)!);
// One line drawing per stamp (24 x 24 units): drop, wave, house, tank, valve, sun over water.
const art = [
  'M12 3c4 5 6 8 6 11a6 6 0 0 1-12 0c0-3 2-6 6-11z',
  'M2 14c3-3 5-3 8 0s5 3 8 0 4-2 4-2M2 19c3-3 5-3 8 0s5 3 8 0 4-2 4-2',
  'M4 21V11l8-6 8 6v10zM10 21v-6h4v6',
  'M7 5h10v15H7zM7 9h10M10 3h4v2h-4z',
  'M3 12h7M14 12h7M10 9h4v6h-4zM12 9V4M8 4h8',
  'M12 4v3M5 7l2 2M19 7l-2 2M7 14a5 5 0 0 1 10 0M2 18c3-2 5-2 8 0s5 2 8 0 4-1 4-1',
];
---
<section class="tnear" data-m-section aria-labelledby="tnear-h">
  <div class="wrap">
    <div class="tn-head">
      <p class="tn-k" data-t="1">Nearby towns</p>
      <h2 id="tnear-h" class="tn-h" data-t="2">Next door to Seminole. <span class="tone">Same crew, same number.</span></h2>
      <p class="tn-p" data-t="3">Point at a town to send it from Largo.</p>
    </div>
    <ul class="sheet" role="list" data-stamps data-stagger data-t="4">
      {near.map((t, i) => (
        <li>
          <a class="stamp" href="/areas" data-stamp style={`--r:${[-1.2, .8, -.4, 1, -.9, .5][i]}deg`}>
            <span class="st-in">
              <span class="st-top"><span class="st-c">USA · FL</span><span class="st-v">{t.mi}<small>mi</small></span></span>
              <svg class="st-art" viewBox="0 0 24 24" aria-hidden="true"><path d={art[i]} /></svg>
              <span class="st-n">{t.name}</span>
              <span class="st-f">from our Largo base</span>
            </span>
            <svg class="st-pm" viewBox="0 0 160 100" aria-hidden="true">
              <circle cx="46" cy="50" r="30" pathLength="1" /><circle cx="46" cy="50" r="24" pathLength="1" />
              <text x="46" y="47">LARGO</text><text x="46" y="60" class="sm">FL · GLASS</text>
              {[30, 44, 58, 72].map((y) => <path d={`M82 ${y}c8-6 14-6 22 0s14 6 22 0 14-6 22 0`} pathLength="1" />)}
            </svg>
            <span class="sr-only">: {t.mi} miles from our Largo base in a straight line. See every town we cover.</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="tn-foot" data-t="3">Values are straight-line miles from our Largo base (Census map points), not driving miles. <a href="/areas">See all 20 towns</a></p>
  </div>
</section>

<script>
  // Hover / focus / tap lights one stamp and dims the rest (the sheet carries .has-on). Touch: the first tap lights the
  // stamp, a second tap follows the link.
  document.querySelectorAll<HTMLElement>('[data-stamps]').forEach((sheet) => {
    const stamps = [...sheet.querySelectorAll<HTMLAnchorElement>('[data-stamp]')];
    const on = (s: HTMLElement | null) => { stamps.forEach((x) => x.classList.toggle('is-on', x === s)); sheet.classList.toggle('has-on', !!s); };
    stamps.forEach((s) => {
      s.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') on(s); });
      s.addEventListener('focus', () => on(s));
      s.addEventListener('blur', () => on(null));
      s.addEventListener('click', (e) => { if (!s.classList.contains('is-on')) { e.preventDefault(); on(s); } });
    });
    sheet.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse' && !sheet.contains(document.activeElement)) on(null); });
  });
</script>

<style>
  .tnear { position: relative; background: var(--white); padding: 110px 0 100px; }
  .tn-head { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .tn-k { font-family: var(--f-m); font-weight: 700; font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: var(--pdeep); }
  .tn-h { max-width: 820px; margin-top: 14px; font-family: var(--f-h); font-weight: 800; font-size: 48px; line-height: 1.04; letter-spacing: -.02em; color: var(--ink); }
  .tn-h .tone { color: var(--pdeep); }
  .tn-p { margin-top: 14px; font-size: 17px; color: var(--muted); }

  /* The sheet: a frost backing card with the stamps in a 3 x 2 grid. */
  .sheet { display: grid; grid-template-columns: repeat(3, 236px); justify-content: center; gap: 26px 30px; margin: 48px auto 0; padding: 36px 40px; width: max-content; max-width: 100%; list-style: none; background: var(--frost); border-radius: 6px; box-shadow: inset 0 0 0 1.5px var(--ink), 10px 10px 0 var(--powder); }
  .sheet li { display: flex; }
  .stamp { position: relative; display: block; width: 100%; padding: 9px; background: var(--white); color: var(--ink); text-decoration: none; rotate: var(--r);
    outline: 7px dotted var(--frost); outline-offset: -3px; box-shadow: 4px 4px 0 rgb(22 19 15 / .18);
    transition: rotate .5s var(--ease-io), translate .5s var(--ease-io), box-shadow .5s var(--ease-io), opacity .5s var(--ease-io), filter .5s var(--ease-io); }
  .st-in { display: grid; justify-items: center; gap: 6px; padding: 12px 12px 14px; border: 1.5px solid var(--ink); background: var(--cream); }
  .st-top { display: flex; justify-content: space-between; align-items: baseline; width: 100%; font-family: var(--f-m); }
  .st-c { font-weight: 700; font-size: 10px; letter-spacing: .08em; color: var(--pdeep); }
  .st-v { font-family: var(--f-h); font-weight: 800; font-size: 26px; line-height: 1; }
  .st-v small { margin-left: 2px; font-family: var(--f-m); font-size: 11px; }
  .st-art { width: 64px; height: 64px; fill: none; stroke: var(--pdeep); stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
  .st-n { font-family: var(--f-h); font-weight: 800; font-size: 19px; line-height: 1.1; text-align: center; }
  .st-f { font-family: var(--f-m); font-weight: 500; font-size: 10px; letter-spacing: .06em; text-transform: uppercase; color: rgb(22 19 15 / .7); }
  /* Postmark: drawn over the stamp's right half when it is lit. */
  .st-pm { position: absolute; right: -26px; top: 22%; width: 150px; height: 94px; fill: none; stroke: var(--ink); stroke-width: 2; opacity: 0; pointer-events: none; transition: opacity .3s var(--ease-io); }
  .st-pm circle, .st-pm path { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset .9s var(--ease-io); }
  .st-pm text { fill: var(--ink); stroke: none; font-family: var(--f-m); font-weight: 800; font-size: 11px; letter-spacing: .08em; text-anchor: middle; }
  .st-pm text.sm { font-size: 7px; }
  .stamp.is-on { rotate: 0deg; translate: -3px -6px; box-shadow: 10px 12px 0 var(--powder); }
  .stamp.is-on .st-pm { opacity: .85; }
  .stamp.is-on .st-pm circle, .stamp.is-on .st-pm path { stroke-dashoffset: 0; }
  .sheet.has-on .stamp:not(.is-on) { opacity: .45; filter: blur(1.5px); }
  .stamp:focus-visible { outline: 3px solid var(--pdeep); outline-offset: 4px; }
  @media (prefers-reduced-motion: reduce) { .stamp, .st-pm, .st-pm circle, .st-pm path { transition: none; } }

  .tn-foot { max-width: 640px; margin: 34px auto 0; text-align: center; font-size: 14px; line-height: 1.5; color: var(--muted); }
  .tn-foot a { display: inline-flex; align-items: center; min-height: 44px; margin-left: 6px; font-weight: 700; color: var(--pdeep); }

  @media (min-width: 768px) and (max-width: 1279px) { .tn-h { font-size: 40px; } .sheet { grid-template-columns: repeat(3, minmax(0, 200px)); padding: 28px; gap: 22px; } }
  @media (max-width: 767px) {
    .tnear { padding: 60px 0 64px; }
    .tn-h { font-size: 28px; }
    .tn-p { font-size: 15px; }
    .sheet { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 14px; width: 100%; margin-top: 28px; padding: 18px 14px; box-shadow: inset 0 0 0 1.5px var(--ink), 6px 6px 0 var(--powder); }
    .stamp { padding: 7px; outline-width: 6px; }
    .st-in { padding: 8px 6px 10px; gap: 4px; }
    .st-v { font-size: 20px; }
    .st-art { width: 44px; height: 44px; }
    .st-n { font-size: 15px; }
    .st-f { font-size: 8px; }
    .st-pm { width: 110px; right: -18px; }
    .tn-foot { font-size: 13px; }
  }
</style>
