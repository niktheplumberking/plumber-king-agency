---
// /areas/seminole "Local permits" (R2 rebuild: text-left / plate-right was rule-14 slop). White. Centred head and answer,
// then one "permit finder" object: an ink panel with two questions as real radio groups (what is the job? where is the
// address?) and a steel slip that prints the answer. 21st.dev sean0205/c-questionnaire-2 (live answers -> summary card),
// rebuilt in vanilla TS, re-skinned as Glass's spec plate.
// Fix round B (independent review BLOCKER 2): the R2 slip printed "Permit: Needed" for every choice and cited a county
// page that only covers unincorporated Pinellas. Now, per research LOCAL-FACTS section 3 (read 17 Nov 2026):
//   unincorporated -> Pinellas County lists an Express Permit for each of the three job types (FACT, pinellas.gov/express-permits);
//                     "each needs a permit" stays hedged ("likely", "ask the county") because research marks it INFERRING;
//   City of Seminole -> we have NO wording from the city: "ask the City of Seminole building department"; Glass, a licensed
//                     contractor, can tell you on the call. No promise that Glass pulls or files the permit (no source).
//   not sure        -> how to tell, plus the call.
// No JS: the slip shows the "not sure" answer (both offices).
const jobs = [
  { v: 'wh', l: 'Water heater swap', x: 'Water Heater Equal Change Out, Tank or Tankless' },
  { v: 'repipe', l: 'Interior repipe', x: 'Re-pipe Water Distribution Interior Only' },
  { v: 'sewer', l: 'Sewer / water service', x: 'Emergency Sewer/Water Service Replacement Only' },
];
// Each answer: permit line, office line, next step, stamp, source. `{x}` = the county's own Express Permit name for the job.
const where = [
  { v: 'city', l: 'City of Seminole', p: 'Ask the city: we don’t have its wording', o: 'City of Seminole building department', n: 'Glass is a licensed contractor (FL CFC1432488) and can tell you what applies on the call.', st: 'Ask the city', src: 'Research: no City of Seminole permit wording found (17 Nov 2026)' },
  { v: 'county', l: 'Unincorporated Pinellas', p: 'Likely. The county lists an Express Permit: “{x}”', o: 'Pinellas County Building & Development Review Services, (727) 464-3888', n: 'Ask the county to confirm for your address, or ask us on the call.', st: 'Express permit', src: 'Source: pinellas.gov/express-permits, read 17 Nov 2026' },
  { v: 'unsure', l: 'Not sure', p: 'Depends on who has jurisdiction over the address', o: 'City of Seminole inside city limits; Pinellas County in unincorporated areas', n: 'Ask us on the call: we can tell you which office applies.', st: 'Check address', src: 'Source: pinellas.gov/express-permits (county areas only), read 17 Nov 2026' },
];
const start = where[2];
---
<section class="tperm" data-m-section aria-labelledby="tperm-h">
  <div class="wrap">
    <div class="tq-head">
      <h2 id="tperm-h" class="tq-h" data-t="2">Do you need a plumbing<br /><span class="tone">permit in Seminole?</span></h2>
      <p class="tq-p" data-t="3"><span class="d">Often, yes, for jobs like a water heater swap or a repipe. Who decides depends on the address: inside the City of Seminole, the city’s building department; in unincorporated Pinellas, the county. Pick your job and address below.</span><span class="m">Often, yes. Inside the City of Seminole the city decides; in unincorporated Pinellas, the county. Pick yours below.</span></p>
    </div>
    <div class="pf" data-t="4" data-permit>
      <div class="pf-qs">
        <fieldset class="pf-q">
          <legend><span class="pf-n">1</span>What is the job?</legend>
          <div class="pf-opts">{jobs.map((j, i) => <label><input type="radio" name="pf-job" value={j.v} data-l={j.l} data-x={j.x} checked={i === 0} /><span>{j.l}</span></label>)}</div>
        </fieldset>
        <fieldset class="pf-q">
          <legend><span class="pf-n">2</span>Where is the address?</legend>
          <div class="pf-opts">{where.map((w) => <label><input type="radio" name="pf-where" value={w.v} data-p={w.p} data-o={w.o} data-n={w.n} data-st={w.st} data-src={w.src} checked={w === start} /><span>{w.l}</span></label>)}</div>
        </fieldset>
      </div>
      <div class="pf-slip" aria-live="polite">
        <p class="pf-t">Permit slip · Seminole</p>
        <dl>
          <div><dt>Job</dt><dd data-pf-job>{jobs[0].l}</dd></div>
          <div><dt>Permit</dt><dd data-pf-p>{start.p}</dd></div>
          <div><dt>Who decides</dt><dd data-pf-office>{start.o}</dd></div>
          <div><dt>Next step</dt><dd data-pf-n>{start.n}</dd></div>
        </dl>
        <span class="pf-stamp" aria-hidden="true" data-pf-stamp>{start.st}</span>
        <p class="pf-src" data-pf-src>{start.src}</p>
        <i class="rv" aria-hidden="true"></i><i class="rv" aria-hidden="true"></i><i class="rv" aria-hidden="true"></i><i class="rv" aria-hidden="true"></i>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-permit]').forEach((pf) => {
    const $ = (k: string) => pf.querySelector<HTMLElement>(`[data-pf-${k}]`)!;
    const stamp = $('stamp');
    const upd = (press: boolean) => {
      const j = pf.querySelector<HTMLInputElement>('input[name="pf-job"]:checked')!.dataset;
      const w = pf.querySelector<HTMLInputElement>('input[name="pf-where"]:checked')!.dataset;
      $('job').textContent = j.l!;
      $('p').textContent = w.p!.replace('{x}', j.x!);
      $('office').textContent = w.o!;
      $('n').textContent = w.n!;
      $('src').textContent = w.src!;
      stamp.textContent = w.st!;
      if (press) { stamp.classList.remove('is-press'); void stamp.offsetWidth; stamp.classList.add('is-press'); }
    };
    pf.querySelectorAll('input').forEach((i) => i.addEventListener('change', () => upd(true)));
    upd(false);
  });
</script>

<style>
  .tperm { position: relative; background: var(--white); padding: 110px 0 110px; }
  .tq-head { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .tq-h { font-family: var(--f-h); font-weight: 800; font-size: 52px; line-height: 1.02; letter-spacing: -.02em; color: var(--ink); }
  .tq-h .tone { color: var(--pdeep); }
  .tq-p { margin-top: 20px; max-width: 700px; font-size: 18px; line-height: 1.5; color: var(--ink); }
  .m { display: none; }
  .pf { display: grid; grid-template-columns: minmax(0, 1fr) 440px; gap: 40px; align-items: center; margin-top: 48px; padding: 40px; background: var(--ink); border-radius: 8px; box-shadow: 12px 12px 0 var(--powder); color: var(--white); }
  .pf-q { margin: 0; padding: 0; border: 0; }
  .pf-q + .pf-q { margin-top: 30px; }
  .pf-q legend { display: flex; align-items: center; gap: 12px; padding: 0; font-family: var(--f-h); font-weight: 800; font-size: 24px; letter-spacing: -.02em; }
  .pf-n { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--powder); color: var(--ink); font-family: var(--f-m); font-size: 13px; }
  .pf-opts { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
  .pf-opts label { position: relative; display: inline-flex; }
  .pf-opts input { position: absolute; inset: 0; margin: 0; opacity: 0; cursor: pointer; }
  .pf-opts span { display: inline-flex; align-items: center; min-height: 48px; padding: 0 18px; border-radius: 24px; box-shadow: inset 0 0 0 1.5px var(--ink3); font-weight: 700; font-size: 15px; color: rgb(255 255 255 / .85); transition: background-color .45s var(--ease-io), color .45s var(--ease-io), box-shadow .45s var(--ease-io); }
  .pf-opts label:hover span { box-shadow: inset 0 0 0 1.5px var(--powder); }
  .pf-opts input:checked + span { background: var(--powder); color: var(--ink); box-shadow: inset 0 0 0 1.5px var(--powder); }
  .pf-opts input:focus-visible + span { outline: 3px solid var(--white); outline-offset: 2px; }
  .pf-slip { position: relative; padding: 24px 26px 20px; background: var(--steel); border-radius: 3px; box-shadow: inset 0 0 0 1px var(--steel2), 8px 8px 0 var(--pdeep); color: var(--ink); font-family: var(--f-m); rotate: 1.2deg; }
  .pf-t { padding-bottom: 12px; border-bottom: 1px solid rgb(22 19 15 / .3); font-weight: 800; font-size: 13px; letter-spacing: .1em; text-transform: uppercase; }
  .pf-slip dl > div { display: grid; grid-template-columns: 104px 1fr; gap: 12px; padding: 9px 0; border-bottom: 1px dashed rgb(22 19 15 / .2); }
  .pf-slip dt { font-weight: 500; font-size: 10px; letter-spacing: .06em; text-transform: uppercase; color: rgb(22 19 15 / .7); padding-top: 2px; }
  .pf-slip dd { margin: 0; font-weight: 700; font-size: 13px; line-height: 1.4; }
  .pf-stamp { position: absolute; right: 18px; top: -20px; padding: 8px 12px; border: 3px solid var(--pdeep); border-radius: 6px; color: var(--ink); font-family: var(--f-h); font-weight: 800; font-size: 16px; letter-spacing: .02em; text-transform: uppercase; rotate: -10deg; background: rgb(199 206 209 / .85); }
  .pf-stamp.is-press { animation: pf-press .6s var(--ease-io); }
  @keyframes pf-press { 0% { scale: 1.4; opacity: 0; } 60% { scale: .94; opacity: 1; } 100% { scale: 1; opacity: 1; } }
  .pf-src { margin-top: 14px; font-weight: 500; font-size: 10px; color: rgb(22 19 15 / .75); }
  .rv { position: absolute; width: 6px; height: 6px; border-radius: 50%; background: var(--steel2); }
  .rv:nth-of-type(1) { left: 6px; top: 6px; } .rv:nth-of-type(2) { right: 6px; top: 6px; }
  .rv:nth-of-type(3) { left: 6px; bottom: 6px; } .rv:nth-of-type(4) { right: 6px; bottom: 6px; }
  @media (prefers-reduced-motion: reduce) { .pf-stamp.is-press { animation: none; } .pf-opts span { transition: none; } }

  @media (min-width: 768px) and (max-width: 1279px) {
    .pf { grid-template-columns: 1fr; }
    .pf-slip { max-width: 520px; }
    .tq-h { font-size: clamp(36px, 4.6vw, 52px); }
  }
  @media (max-width: 767px) {
    .tperm { padding: 56px 0 64px; }
    .tq-h { font-size: 28px; }
    .tq-p { margin-top: 14px; font-size: 15px; }
    .d { display: none; } .m { display: inline; }
    .pf { grid-template-columns: 1fr; gap: 28px; margin-top: 28px; padding: 22px 16px 26px; box-shadow: 6px 6px 0 var(--powder); }
    .pf-q legend { font-size: 19px; }
    .pf-opts span { min-height: 44px; padding: 0 14px; font-size: 14px; }
    .pf-slip { padding: 18px 16px 16px; rotate: 0deg; box-shadow: inset 0 0 0 1px var(--steel2), 5px 5px 0 var(--pdeep); }
    .pf-slip dl > div { grid-template-columns: 78px 1fr; }
    .pf-stamp { position: static; display: inline-block; margin: 12px 0 2px; font-size: 12px; padding: 6px 9px; rotate: -3deg; }
  }
</style>
