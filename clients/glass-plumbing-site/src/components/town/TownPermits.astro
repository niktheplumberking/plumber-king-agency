---
// /areas/seminole "Local permits" (R2 rebuild: the R1 text-left / plate-right was rule-14 slop). White. Centred head and
// answer, then one "permit finder" object: an ink panel with two questions as real radio groups (what is the job? where
// is the address?) and a steel permit slip that prints the answer: permit needed, which office issues it, who files it.
// 21st.dev sean0205/c-questionnaire-2 (live answers -> summary card), rebuilt in vanilla TS and re-skinned as Glass's spec
// plate. Facts only from the R1 copy and its source (pinellas.gov/express-permits, read 17 Nov 2026): the three job types
// all need a permit; the city's building office or Pinellas County (unincorporated) issues it; Glass files it.
// No JS: the slip lists both offices.
const jobs = [
  { v: 'wh', l: 'Water heater swap' },
  { v: 'repipe', l: 'Interior repipe' },
  { v: 'sewer', l: 'Sewer / water service' },
];
const where = [
  { v: 'city', l: 'Inside city limits', o: 'Your city’s building office' },
  { v: 'county', l: 'Unincorporated area', o: 'Pinellas County' },
  { v: 'unsure', l: 'Not sure', o: 'City or Pinellas County: we check your address' },
];
---
<section class="tperm" data-m-section aria-labelledby="tperm-h">
  <div class="wrap">
    <div class="tq-head">
      <h2 id="tperm-h" class="tq-h" data-t="2">Do you need a plumbing<br /><span class="tone">permit in Seminole?</span></h2>
      <p class="tq-p" data-t="3"><span class="d">Most replacement jobs, like a water heater or a repipe, need one. Which office issues it depends on the address: your city’s building office, or Pinellas County for unincorporated areas. We check the address and file it for you.</span><span class="m">Most replacement jobs, like a water heater or a repipe, need one. Your city or Pinellas County issues it, depending on the address. We check and file it.</span></p>
    </div>
    <div class="pf" data-t="4" data-permit>
      <div class="pf-qs">
        <fieldset class="pf-q">
          <legend><span class="pf-n">1</span>What is the job?</legend>
          <div class="pf-opts">{jobs.map((j, i) => <label><input type="radio" name="pf-job" value={j.v} data-l={j.l} checked={i === 0} /><span>{j.l}</span></label>)}</div>
        </fieldset>
        <fieldset class="pf-q">
          <legend><span class="pf-n">2</span>Where is the address?</legend>
          <div class="pf-opts">{where.map((w, i) => <label><input type="radio" name="pf-where" value={w.v} data-o={w.o} checked={i === 2} /><span>{w.l}</span></label>)}</div>
        </fieldset>
      </div>
      <div class="pf-slip" aria-live="polite">
        <p class="pf-t">Permit slip · Seminole</p>
        <dl>
          <div><dt>Job</dt><dd data-pf-job>Water heater swap, interior repipe or sewer / water service</dd></div>
          <div><dt>Permit</dt><dd>Needed</dd></div>
          <div><dt>Issued by</dt><dd data-pf-office>Your city’s building office, or Pinellas County for unincorporated areas</dd></div>
          <div><dt>Who files</dt><dd>Glass Plumbing</dd></div>
        </dl>
        <span class="pf-stamp" aria-hidden="true" data-pf-stamp>We file it</span>
        <p class="pf-src">Source: pinellas.gov/express-permits, read 17 Nov 2026</p>
        <i class="rv" aria-hidden="true"></i><i class="rv" aria-hidden="true"></i><i class="rv" aria-hidden="true"></i><i class="rv" aria-hidden="true"></i>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-permit]').forEach((pf) => {
    const job = pf.querySelector<HTMLElement>('[data-pf-job]')!;
    const office = pf.querySelector<HTMLElement>('[data-pf-office]')!;
    const stamp = pf.querySelector<HTMLElement>('[data-pf-stamp]')!;
    const upd = (press: boolean) => {
      job.textContent = pf.querySelector<HTMLInputElement>('input[name="pf-job"]:checked')!.dataset.l!;
      office.textContent = pf.querySelector<HTMLInputElement>('input[name="pf-where"]:checked')!.dataset.o!;
      if (press) { stamp.classList.remove('is-press'); void stamp.offsetWidth; stamp.classList.add('is-press'); }
    };
    pf.querySelectorAll('input').forEach((i) => i.addEventListener('change', () => upd(true)));
    upd(false);
  });
</script>

<style>
  .tperm { position: relative; background: var(--white); padding: 110px 0 110px; }
  .tq-head { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .tq-h { font-family: var(--f-h); font-weight: 800; font-size: 52px; line-height: 1.02; letter-spacing: -.02em; color: var(--ink); }
  .tq-h .tone { color: var(--pdeep); }
  .tq-p { margin-top: 20px; max-width: 700px; font-size: 18px; line-height: 1.5; color: var(--ink); }
  .m { display: none; }
  .pf { display: grid; grid-template-columns: minmax(0, 1fr) 440px; gap: 40px; align-items: center; margin-top: 48px; padding: 40px; background: var(--ink); border-radius: 8px; box-shadow: 12px 12px 0 var(--powder); color: var(--white); }
  .pf-q { margin: 0; padding: 0; border: 0; }
  .pf-q + .pf-q { margin-top: 30px; }
  .pf-q legend { display: flex; align-items: center; gap: 12px; padding: 0; font-family: var(--f-h); font-weight: 800; font-size: 24px; letter-spacing: -.02em; }
  .pf-n { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--powder); color: var(--ink); font-family: var(--f-m); font-size: 13px; }
  .pf-opts { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
  .pf-opts label { position: relative; display: inline-flex; }
  .pf-opts input { position: absolute; inset: 0; margin: 0; opacity: 0; cursor: pointer; }
  .pf-opts span { display: inline-flex; align-items: center; min-height: 48px; padding: 0 18px; border-radius: 24px; box-shadow: inset 0 0 0 1.5px var(--ink3); font-weight: 700; font-size: 15px; color: rgb(255 255 255 / .85); transition: background-color .45s var(--ease-io), color .45s var(--ease-io), box-shadow .45s var(--ease-io); }
  .pf-opts label:hover span { box-shadow: inset 0 0 0 1.5px var(--powder); }
  .pf-opts input:checked + span { background: var(--powder); color: var(--ink); box-shadow: inset 0 0 0 1.5px var(--powder); }
  .pf-opts input:focus-visible + span { outline: 3px solid var(--white); outline-offset: 2px; }
  .pf-slip { position: relative; padding: 24px 26px 20px; background: var(--steel); border-radius: 3px; box-shadow: inset 0 0 0 1px var(--steel2), 8px 8px 0 var(--pdeep); color: var(--ink); font-family: var(--f-m); rotate: 1.2deg; }
  .pf-t { padding-bottom: 12px; border-bottom: 1px solid rgb(22 19 15 / .3); font-weight: 800; font-size: 13px; letter-spacing: .1em; text-transform: uppercase; }
  .pf-slip dl > div { display: grid; grid-template-columns: 96px 1fr; gap: 12px; padding: 9px 0; border-bottom: 1px dashed rgb(22 19 15 / .2); }
  .pf-slip dt { font-weight: 500; font-size: 10px; letter-spacing: .06em; text-transform: uppercase; color: rgb(22 19 15 / .7); padding-top: 2px; }
  .pf-slip dl > div:nth-child(-n+2) dd { padding-right: 120px; }
  .pf-slip dd { margin: 0; font-weight: 700; font-size: 13px; line-height: 1.4; }
  .pf-stamp { position: absolute; right: 22px; top: 54px; padding: 8px 12px; border: 3px solid var(--pdeep); border-radius: 6px; color: var(--ink); font-family: var(--f-h); font-weight: 800; font-size: 16px; letter-spacing: .02em; text-transform: uppercase; rotate: -10deg; background: rgb(199 206 209 / .85); }
  .pf-stamp.is-press { animation: pf-press .6s var(--ease-io); }
  @keyframes pf-press { 0% { scale: 1.4; opacity: 0; } 60% { scale: .94; opacity: 1; } 100% { scale: 1; opacity: 1; } }
  .pf-src { margin-top: 14px; font-weight: 500; font-size: 10px; color: rgb(22 19 15 / .75); }
  .rv { position: absolute; width: 6px; height: 6px; border-radius: 50%; background: var(--steel2); }
  .rv:nth-of-type(1) { left: 6px; top: 6px; } .rv:nth-of-type(2) { right: 6px; top: 6px; }
  .rv:nth-of-type(3) { left: 6px; bottom: 6px; } .rv:nth-of-type(4) { right: 6px; bottom: 6px; }
  @media (prefers-reduced-motion: reduce) { .pf-stamp.is-press { animation: none; } .pf-opts span { transition: none; } }

  @media (min-width: 768px) and (max-width: 1279px) {
    .pf { grid-template-columns: 1fr; }
    .pf-slip { max-width: 520px; }
    .tq-h { font-size: clamp(36px, 4.6vw, 52px); }
  }
  @media (max-width: 767px) {
    .tperm { padding: 56px 0 64px; }
    .tq-h { font-size: 28px; }
    .tq-p { margin-top: 14px; font-size: 15px; }
    .d { display: none; } .m { display: inline; }
    .pf { grid-template-columns: 1fr; gap: 28px; margin-top: 28px; padding: 22px 16px 26px; box-shadow: 6px 6px 0 var(--powder); }
    .pf-q legend { font-size: 19px; }
    .pf-opts span { min-height: 44px; padding: 0 14px; font-size: 14px; }
    .pf-slip { padding: 18px 16px 16px; rotate: 0deg; box-shadow: inset 0 0 0 1px var(--steel2), 5px 5px 0 var(--pdeep); }
    .pf-slip dl > div { grid-template-columns: 78px 1fr; }
    .pf-slip dl > div:nth-child(-n+2) dd { padding-right: 0; }
    .pf-src { padding-right: 96px; }
    .pf-stamp { top: auto; bottom: 46px; right: 14px; font-size: 12px; padding: 6px 9px; }
  }
</style>
