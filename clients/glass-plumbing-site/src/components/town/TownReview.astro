---
// /areas/seminole "Reviews", fix round 3 (E, RECHECK MAJOR 1: the job board of pinned slips and photos repeated the home
// pinned-notes idea; no pinned notes or pinned photos anywhere now). New idea, THE REVIEW, SEEN THROUGH THE JOB: the heart
// of Cody Weaver's Seminole review ("fixed my shower … refused to drain") is set huge, and the letters are windows onto a
// real job photo (background-clip: text). Four job chips under it swap the photo seen through the words (cross-fade);
// as the section scrolls, the photo slides slowly inside the letters (kit/scrub.ts data-scrub-tw on background-position,
// so the scroll drives it). The whole review sits under it in normal type with stars, name and platform, then David
// Peek's line (the only place "the Glass brothers" appears: inside his quoted review) and the two Google profiles (104 and
// 77, never summed). No faces; captions say "· Pinellas" (which jobs were in Seminole waits for Kody).
// 21st.dev: daiwiikharihar "Reveal Image Mask" (an image bloomed through a mask on scroll) + soralabs "Text Reveal (Mask)",
// rebuilt with CSS background-clip and the kit scrub engine, re-skinned with Glass ink outline and powder offset shadow.
// Reduced motion / no JS: the first photo shows in the letters, still; browsers without background-clip text get ink type.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Seam from '../kit/Seam.astro';
import Head from '../areas/Head.astro';
import { quote, STARS } from '../areas/reviews';
import { SITE } from '../../data/site';
const q = quote('Cody Weaver', 'Kody came out and fixed my shower in Seminole that refused to drain. He was efficient and professional throughout the whole experience.');
const big = quote('Cody Weaver', 'fixed my shower … that refused to drain');
const q2 = quote('David Peek', 'The Glass brothers with Glass Plumbing Services are the best!');
const all = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/*.jpg', { eager: true });
const P = [
  { name: 'valve', cap: 'Shower valve trim', alt: 'a black shower valve trim on a tiled wall', pos: '50% 40%' },
  { name: 'tankless-pair', cap: 'Tankless pair', alt: 'two tankless water heaters side by side on a brick wall', pos: '50% 50%' },
  { name: 'water-filters', cap: 'Whole-house filters', alt: 'blue whole-house filter housings on a wall', pos: '50% 50%' },
  { name: 'kitchen-faucet-2', cap: 'Kitchen faucet', alt: 'a brushed-steel kitchen faucet over a sink', pos: '50% 50%' },
];
const photos = await Promise.all(P.map(async (p) => {
  const src = all[`/src/assets/photos/${p.name}.jpg`].default;
  const [a, j] = await Promise.all([getImage({ src, width: 1200, format: 'avif', quality: 55 }), getImage({ src, width: 1200, format: 'jpg', quality: 60 })]);
  return { ...p, bg: `image-set(url("${a.src}") type("image/avif"), url("${j.src}") type("image/jpeg"))` };
}));
---
<section class="trev" data-m-section aria-labelledby="trev-h">
  <Seam from="var(--ink)" to="var(--frost)" flip d={40} dm={32} />
  <div class="wrap">
    <div class="tr-head">
      <Head eyebrow="From a Seminole customer" l1="Said in Seminole." l2="Seen through the job." size={52} sizeM={30} id="trev-h" />
    </div>
    <div class="tw" data-tw data-scrub data-no-px data-start="top bottom" data-end="bottom top">
      <p class="tw-big" aria-hidden="true" data-t="3">
        <span class="tw-l is-on" data-tw-l style={`--bg:${photos[0].bg};--pos:${photos[0].pos}`} data-scrub-tw='{"backgroundPositionY":"20%"}'>{big}</span>
        <span class="tw-l" data-tw-l data-scrub-tw='{"backgroundPositionY":"20%"}'>{big}</span>
      </p>
      <div class="tw-chips" role="radiogroup" aria-label="Photo seen through the words" data-t="5">
        {photos.map((p, i) => (
          <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} class="tw-chip" data-bg={p.bg} data-pos={p.pos}>
            <i style={`background-image:${i === 0 ? p.bg : 'none'}`} data-thumb={p.bg} aria-hidden="true"></i>{p.cap}<span class="sr-only">: {p.alt}</span><em> · Pinellas</em>
          </button>
        ))}
      </div>
      <figure class="tw-card" data-t="4">
        <svg class="tw-stars" viewBox="0 0 80 13" fill="#F9B50D" role="img" aria-label="5 out of 5 stars" set:html={STARS} />
        <blockquote><p>“{q}”</p></blockquote>
        <figcaption>Cody Weaver · Google review · Seminole</figcaption>
        <p class="tw-two">“{q2}” <span>David Peek · Google review</span></p>
      </figure>
    </div>
    <p class="pb-pills" data-t="3">
      <a href={SITE.google.a.url} target="_blank" rel="noopener"><b>{SITE.google.a.value}</b> · {SITE.google.a.count} Google reviews<span class="sr-only"> on our first Google profile (opens in a new tab)</span></a>
      <a href={SITE.google.b.url} target="_blank" rel="noopener"><b>{SITE.google.b.value}</b> · {SITE.google.b.count} Google reviews<span class="sr-only"> on our second Google profile (opens in a new tab)</span></a>
    </p>
  </div>
</section>

<script>
  // Swap the photo seen through the words: the back layer takes the new photo, then the two layers cross-fade.
  document.querySelectorAll<HTMLElement>('[data-tw]').forEach((tw) => {
    const layers = [...tw.querySelectorAll<HTMLElement>('[data-tw-l]')];
    const chips = [...tw.querySelectorAll<HTMLButtonElement>('.tw-chip')];
    // Thumbnails load once the section is near (not with the page).
    new IntersectionObserver((e, io) => { if (e[0].isIntersecting) { chips.forEach((c) => { const i = c.querySelector<HTMLElement>('i')!; i.style.backgroundImage = i.dataset.thumb!; }); io.disconnect(); } }, { rootMargin: '400px' }).observe(tw);
    const pick = (c: HTMLButtonElement) => {
      if (c.getAttribute('aria-checked') === 'true') return;
      chips.forEach((x) => x.setAttribute('aria-checked', String(x === c)));
      const on = layers.find((l) => l.classList.contains('is-on'))!, off = layers.find((l) => l !== on)!;
      off.style.setProperty('--bg', c.dataset.bg!); off.style.setProperty('--pos', c.dataset.pos!);
      off.classList.add('is-on'); on.classList.remove('is-on');
    };
    chips.forEach((c, i) => {
      c.addEventListener('click', () => pick(c));
      c.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
        if (!d) return; e.preventDefault(); const n = chips[(i + d + chips.length) % chips.length]; n.focus(); pick(n);
      });
      c.tabIndex = i === 0 ? 0 : -1;
      c.addEventListener('focus', () => chips.forEach((x) => (x.tabIndex = x === c ? 0 : -1)));
    });
  });
</script>

<style>
  .trev { position: relative; background: var(--frost); padding: 120px 0 110px; }
  .tr-head { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .tr-head :global(.ah-eb) { justify-content: center; }
  .tw { display: flex; flex-direction: column; align-items: center; margin-top: 40px; }
  .tw-big { display: grid; max-width: 1180px; margin: 0; text-align: center; }
  .tw-l { grid-area: 1 / 1; font-family: var(--f-h); font-weight: 800; font-size: 118px; line-height: .96; letter-spacing: -.035em; color: var(--ink);
    -webkit-text-stroke: 1.5px var(--ink); opacity: 0; transition: opacity .7s var(--ease-io); }
  .tw-l.is-on { opacity: 1; }
  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    .tw-l { color: transparent; background-image: var(--bg, none); background-size: cover; background-position: 50% 80%; -webkit-background-clip: text; background-clip: text; }
  }
  .tw-chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 30px; }
  .tw-chip { display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 5px 16px 5px 6px; border: 0; border-radius: 26px; background: var(--white); box-shadow: inset 0 0 0 1.5px var(--ink); color: var(--ink); font: 700 15px/1 var(--f-b); cursor: pointer;
    transition: background-color .45s var(--ease-io), color .45s var(--ease-io), box-shadow .45s var(--ease-io); }
  .tw-chip i { width: 36px; height: 36px; border-radius: 50%; background: var(--frost2) center / cover; box-shadow: inset 0 0 0 1.5px var(--ink); }
  .tw-chip em { font-style: normal; font-family: var(--f-m); font-weight: 500; font-size: 11px; color: var(--muted); }
  .tw-chip:hover { box-shadow: inset 0 0 0 2px var(--pdeep); }
  .tw-chip[aria-checked='true'] { background: var(--ink); color: var(--white); box-shadow: inset 0 0 0 1.5px var(--ink), 4px 4px 0 var(--powder); }
  .tw-chip[aria-checked='true'] em { color: var(--powder); }
  .tw-chip:focus-visible { outline: 3px solid var(--pdeep); outline-offset: 3px; }
  .tw-card { position: relative; width: min(760px, 100%); margin: 40px 0 0; padding: 34px 40px 28px; background: var(--white); border-radius: 6px; box-shadow: inset 0 0 0 1.5px var(--ink), 10px 10px 0 var(--powder); text-align: center; }
  .tw-stars { width: 100px; height: 16px; }
  .tw-card blockquote { margin: 14px 0 0; font-family: var(--f-h); font-weight: 800; font-size: 26px; line-height: 1.25; letter-spacing: -.01em; color: var(--ink); }
  .tw-card figcaption { margin-top: 14px; font-family: var(--f-m); font-weight: 500; font-size: 12px; letter-spacing: .04em; color: var(--muted); }
  .tw-two { margin-top: 20px; padding-top: 16px; border-top: 1px dashed rgb(22 19 15 / .25); font-size: 16px; line-height: 1.4; color: var(--ink); }
  .tw-two span { display: block; margin-top: 4px; font-family: var(--f-m); font-size: 11px; color: var(--muted); }
  .pb-pills { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 34px; }
  .pb-pills a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px; border-radius: 22px; background: var(--white); box-shadow: inset 0 0 0 1.5px var(--ink); color: var(--ink); font-size: 15px; text-decoration: none; }
  .pb-pills a:hover { box-shadow: inset 0 0 0 2px var(--pdeep); }
  @media (prefers-reduced-motion: reduce) { .tw-l, .tw-chip { transition: none; } }
  @media (min-width: 768px) and (max-width: 1279px) { .tw-l { font-size: clamp(64px, 9vw, 108px); } }
  @media (max-width: 767px) {
    .trev { padding: 64px 0 60px; }
    .tw { margin-top: 26px; }
    .tw-l { font-size: 52px; -webkit-text-stroke-width: 1px; }
    .tw-chips { gap: 8px; margin-top: 20px; }
    .tw-chip { min-height: 44px; font-size: 13px; padding-right: 12px; }
    .tw-chip i { width: 30px; height: 30px; }
    .tw-chip em { display: none; }
    .tw-card { margin-top: 26px; padding: 24px 18px 20px; box-shadow: inset 0 0 0 1.5px var(--ink), 6px 6px 0 var(--powder); }
    .tw-card blockquote { font-size: 20px; }
    .pb-pills { margin-top: 22px; }
    .pb-pills a { font-size: 14px; }
  }
</style>
