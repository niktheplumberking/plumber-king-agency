---
// /areas/seminole "Reviews" (fix round B rebuild: the R2 quote-left / three-photos-right left an empty field, and the
// "The Glass brothers, Largo." band put that label beside one crew face; both merged here). Frost, meniscus rise.
// A centred JOB BOARD: Cody Weaver's Seminole review on a big white slip in the middle, David Peek's line on a smaller
// slip tucked over its corner (the only place "the Glass brothers" appears: inside his quoted review), four of his own
// job photos pinned around them at slight angles. Scroll drifts each photo at its own speed (kit/scrub.ts data-scrub-y,
// so the scroll drives it, never a clock); hover straightens a photo and lifts it. Two Google profile pills
// (104 and 77, never summed). Phones: slips first, photos as a swipe strip (the drift wrapper is display: contents there,
// so the scrub skips it). 21st.dev sajad/scattered-about (copy in the middle, photos in fixed slots drifting at their
// own speed; phones a swipe strip), re-skinned with Glass slips and powder offset shadows.
// No crew faces here (no names on faces). Captions say "· Pinellas": which jobs were in Seminole waits for Kody.
import Seam from '../kit/Seam.astro';
import Head from '../areas/Head.astro';
import Img from '../ui/Img.astro';
import { quote, STARS } from '../areas/reviews';
import { SITE } from '../../data/site';
const q = quote('Cody Weaver', 'Kody came out and fixed my shower in Seminole that refused to drain. He was efficient and professional throughout the whole experience.');
const q2 = quote('David Peek', 'The Glass brothers with Glass Plumbing Services are the best!');
const photos = [
  { name: 'valve', cap: 'Shower valve trim · Pinellas', alt: 'A black shower valve trim on a tiled wall', slot: 'a', y: -90, r: -5 },
  { name: 'tankless-pair', cap: 'Tankless pair · Pinellas', alt: 'Two tankless water heaters mounted side by side on a brick wall', slot: 'b', y: 60, r: 4 },
  { name: 'water-filters', cap: 'Whole-house filters · Pinellas', alt: 'A row of blue whole-house water filter housings plumbed on a wall', slot: 'c', y: -60, r: 5 },
  { name: 'kitchen-faucet-2', cap: 'Kitchen faucet · Pinellas', alt: 'A brushed-steel pull-down kitchen faucet over a sink after install', slot: 'd', y: 90, r: -3 },
];
---
<section class="trev" data-m-section aria-labelledby="trev-h">
  <Seam from="var(--ink)" to="var(--frost)" flip d={40} dm={32} />
  <div class="wrap">
    <div class="tr-head">
      <Head eyebrow="From a Seminole customer" l1="Said in Seminole." l2="Shown in photos." size={52} sizeM={30} id="trev-h" />
    </div>
    <div class="pb" data-scrub data-no-px data-start="top bottom" data-end="bottom top">
      <figure class="pb-slip" data-t="3">
        <svg class="pb-stars" viewBox="0 0 80 13" fill="#F9B50D" role="img" aria-label="5 out of 5 stars" set:html={STARS} />
        <blockquote><p>“{q}”</p></blockquote>
        <figcaption>Cody Weaver · Google · Seminole</figcaption>
        <i class="pb-pin" aria-hidden="true"></i>
      </figure>
      <figure class="pb-note" data-t="5" data-fx="pop">
        <blockquote><p>“{q2}”</p></blockquote>
        <figcaption>David Peek · Google</figcaption>
      </figure>
      <ul class="pb-photos" role="list" aria-label="Job photos" tabindex="0">
        {photos.map((p) => (
          <li class:list={['pb-ph', `pb-ph--${p.slot}`]} style={`--r:${p.r}deg`}>
            <span class="pb-dr" data-scrub-y={p.y}>
              <figure class="pb-fig">
                <span class="pb-img"><Img name={p.name} alt={p.alt} sizes="(min-width:1280px) 240px, (min-width:768px) 18vw, 180px" box={240 / 280} boxM={180 / 220} widths={[180, 240, 360, 480]} /></span>
                <figcaption>{p.cap}</figcaption>
                <i class="pb-tack" aria-hidden="true"></i>
              </figure>
            </span>
          </li>
        ))}
      </ul>
    </div>
    <p class="pb-pills" data-t="3">
      <a href={SITE.google.a.url} target="_blank" rel="noopener"><b>{SITE.google.a.value}</b> · {SITE.google.a.count} Google reviews<span class="sr-only"> on our first Google profile (opens in a new tab)</span></a>
      <a href={SITE.google.b.url} target="_blank" rel="noopener"><b>{SITE.google.b.value}</b> · {SITE.google.b.count} Google reviews<span class="sr-only"> on our second Google profile (opens in a new tab)</span></a>
    </p>
  </div>
</section>

<style>
  .trev { position: relative; background: var(--frost); padding: 120px 0 110px; }
  .tr-head { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .tr-head :global(.ah-eb) { justify-content: center; }

  .pb { position: relative; height: 640px; margin-top: 40px; }
  .pb-slip { position: absolute; z-index: 2; left: 50%; top: 110px; width: 560px; margin: 0 0 0 -280px; padding: 40px 40px 34px; background: var(--white); border-radius: 4px; box-shadow: inset 0 0 0 1.5px var(--ink), 12px 12px 0 var(--powder); }
  .pb-pin { position: absolute; left: 50%; top: -11px; width: 22px; height: 22px; margin-left: -11px; border-radius: 50%; background: var(--pdeep); box-shadow: inset 0 -3px 0 rgb(0 0 0 / .25), 0 0 0 2px var(--ink); }
  .pb-stars { display: block; width: 105px; height: 18px; }
  .pb-slip blockquote { margin: 18px 0 0; font-family: var(--f-h); font-weight: 700; font-size: 30px; line-height: 1.2; letter-spacing: -.02em; color: var(--ink); }
  .pb-slip figcaption { margin-top: 20px; font-family: var(--f-m); font-weight: 500; font-size: 11px; letter-spacing: .02em; color: var(--pdeep); }
  .pb-note { position: absolute; z-index: 3; left: 50%; top: 470px; width: 300px; margin: 0 0 0 150px; padding: 20px 22px 18px; background: var(--cream); border-radius: 2px; box-shadow: inset 0 0 0 1.5px var(--ink), 6px 6px 0 var(--ink); rotate: 3deg; }
  .pb-note blockquote { margin: 0; font-style: italic; font-weight: 600; font-size: 17px; line-height: 1.4; color: var(--ink); }
  .pb-note figcaption { margin-top: 10px; font-family: var(--f-m); font-weight: 500; font-size: 10px; letter-spacing: .02em; color: var(--ink); }

  .pb-photos { margin: 0; padding: 0; list-style: none; }
  .pb-ph { position: absolute; z-index: 1; width: 240px; }
  .pb-ph--a { left: 0; top: 10px; } .pb-ph--b { left: 50px; top: 360px; width: 210px; }
  .pb-ph--c { right: 10px; top: 0; width: 220px; } .pb-ph--d { right: 0; top: 330px; }
  .pb-dr { display: block; }
  .pb-fig { position: relative; margin: 0; padding: 10px 10px 12px; background: var(--white); border-radius: 3px; box-shadow: inset 0 0 0 1.5px var(--ink), 8px 8px 0 var(--ink); rotate: var(--r);
    transition: rotate .6s var(--ease-io), scale .6s var(--ease-io), box-shadow .6s var(--ease-io); }
  .pb-ph:hover { z-index: 4; }
  .pb-fig:hover { rotate: 0deg; scale: 1.06; box-shadow: inset 0 0 0 1.5px var(--ink), 12px 12px 0 var(--pdeep); }
  .pb-img { position: relative; display: block; aspect-ratio: 240 / 280; overflow: hidden; border-radius: 2px; background: var(--frost2); }
  .pb-img :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .pb-fig figcaption { margin-top: 8px; font-family: var(--f-m); font-weight: 500; font-size: 10px; letter-spacing: .02em; color: var(--muted); }
  .pb-tack { position: absolute; left: 50%; top: -7px; width: 14px; height: 14px; margin-left: -7px; border-radius: 50%; background: var(--steel); box-shadow: inset 0 0 0 1.5px var(--ink); }

  .pb-pills { display: flex; justify-content: center; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .pb-pills a { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 18px; border-radius: 22px; background: var(--white); box-shadow: inset 0 0 0 1.5px var(--ink); color: var(--ink); font-weight: 600; font-size: 15px; text-decoration: none; transition: background-color .4s var(--ease-io); }
  .pb-pills a:hover { background: var(--powder); }
  .pb-pills b { font-family: var(--f-h); font-weight: 800; }
  @media (prefers-reduced-motion: reduce) { .pb-fig { transition: none; } }

  @media (min-width: 768px) and (max-width: 1279px) {
    .pb { height: 700px; }
    .pb-slip { width: min(480px, 56%); margin-left: max(-240px, -28%); top: 150px; padding: 32px 30px 28px; }
    .pb-slip blockquote { font-size: clamp(22px, 2.6vw, 28px); }
    .pb-note { top: 520px; width: 260px; margin-left: 40px; }
    .pb-ph, .pb-ph--b, .pb-ph--c { width: clamp(150px, 19vw, 210px); }
    .pb-ph--b { left: 0; top: 420px; } .pb-ph--d { top: 400px; }
  }
  @media (max-width: 767px) {
    .trev { padding: 64px 0 60px; }
    .pb { height: auto; margin-top: 28px; }
    .pb-slip, .pb-note { position: relative; left: auto; top: auto; width: auto; margin: 0; }
    .pb-slip { padding: 26px 20px 22px; box-shadow: inset 0 0 0 1.5px var(--ink), 6px 6px 0 var(--powder); }
    .pb-stars { width: 85px; height: 14px; }
    .pb-slip blockquote { margin-top: 12px; font-size: 21px; line-height: 1.24; }
    .pb-note { width: 86%; margin: -6px 0 0 auto; padding: 16px 16px 14px; }
    .pb-note blockquote { font-size: 15px; }
    .pb-photos { display: flex; gap: 14px; margin: 26px calc(-1 * var(--gutter)) 0; padding: 12px var(--gutter) 18px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter); scrollbar-width: none; overscroll-behavior-x: contain; }
    .pb-photos::-webkit-scrollbar { display: none; }
    .pb-photos:focus-visible { outline: 3px solid var(--pdeep); outline-offset: -3px; }
    .pb-ph, .pb-ph--b, .pb-ph--c { position: relative; left: auto; right: auto; top: auto; flex: none; width: 180px; scroll-snap-align: start; }
    .pb-dr { display: contents; }
    .pb-fig { rotate: calc(var(--r) * .5); box-shadow: inset 0 0 0 1.5px var(--ink), 5px 5px 0 var(--ink); }
    .pb-pills { margin-top: 18px; }
    .pb-pills a { font-size: 14px; }
  }
</style>
