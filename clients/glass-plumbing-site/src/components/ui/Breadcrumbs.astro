---
// BreadcrumbList JSON-LD only (revision round 2, Nick 20 Nov: "Can we please not do that again?"). No visible breadcrumb
// row anywhere on the site. The props are kept so every page still compiles: items: [{ label, href }] excluding Home
// (added), last item = current page. `dark`, `class` and `t` are accepted and ignored (they styled the old visible row).
interface Props { items: { label: string; href: string }[]; dark?: boolean; class?: string; t?: string | false }
const { items } = Astro.props;
const all = [{ label: 'Home', href: '/' }, ...items];
const site = (import.meta.env.SITE as string || 'https://glass-plumbing-largo.vercel.app').replace(/\/$/, '');
const ld = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: all.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.label, item: site + (c.href === '/' ? '' : c.href) })) };
---
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
