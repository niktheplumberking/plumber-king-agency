---
// Prevention tips (Figma 719:437 y 6720 h 772 / mobile y 7145 h 942): the "Annual care tag". The tag swings in on scroll
// (rotate -3 deg to 0, spring, motion only). Tick a box: the task strikes through, the counter updates and "Last done" fills
// with today's date. Saved in this browser only (localStorage, try/catch). Starts at 0 of 3 (the Figma's 1 of 3 is an example).
import Eyebrow from '../kit/Eyebrow.astro';
import Btn from '../kit/Btn.astro';
const T = [
  { id: 'flush', t: 'Flush the tank', d: 'Turn off power or gas. Hook a hose to the drain valve at the bottom and run it until the water comes out clear.' },
  { id: 'relief', t: 'Test the relief valve', d: 'Lift the lever for a second, then let it snap back. If it keeps dripping after, call us.' },
  { id: 'shutoff', t: 'Know your shut-off', d: 'Find the cold valve on top of the heater and the main for the house. Show everyone at home.', dm: 'Find the cold valve on top of the heater and the main for the house.' },
];
---
<section class="cr" data-m-section>
  <div class="wrap cr-grid">
    <div class="cr-l">
      <Eyebrow text="Make it last" />
      <h2 class="h2 cr-h" data-t="2" style="--h2:52px;--h2m:36px">Three things<br /><span class="tone">to do once a year.</span></h2>
      <p class="cr-lead" data-t="3">Pinellas water is hard: 217 ppm on average (Pinellas County Utilities, 2025). Scale settles at the bottom of the tank. <span class="d">These three keep it working longer.</span></p>
      <Btn label="Rather we do it? Call" sub="(727) 512-0673" w={320} h={60} class="cr-btn cr-btn-d" t="4" />
    </div>
    <div class="cr-tag" data-care>
      <i class="cr-hole" aria-hidden="true"></i><i class="cr-rv" aria-hidden="true"></i><i class="cr-rv" aria-hidden="true"></i><i class="cr-rv" aria-hidden="true"></i><i class="cr-rv" aria-hidden="true"></i>
      <div class="cr-top">
        <h3 class="cr-title" id="cr-title"><span class="d">Annual care tag · water heater</span><span class="m">Annual care tag</span></h3>
        <p class="cr-count" aria-live="polite"><span data-care-n>0</span> of 3 done</p>
      </div>
      <ul class="cr-list" role="list" aria-labelledby="cr-title">
        {T.map((t, i) => (
          <li class="cr-it" data-care-it={t.id}>
            <input class="cr-cb" type="checkbox" id={`cr-${t.id}`} data-care-cb />
            <label class="cr-lab" for={`cr-${t.id}`}>
              <span class="cr-box" aria-hidden="true"><svg viewBox="0 0 21 15" width="18" height="12" aria-hidden="true" focusable="false"><path d="M1.3 7.3L7.3 13.3L19.3 1.3" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
              <span class="cr-t">0{i + 1}&nbsp;&nbsp;{t.t}</span>
            </label>
            <p class="cr-d">{t.dm ? <><span class="d">{t.d}</span><span class="m">{t.dm}</span></> : t.d}</p>
            <p class="cr-last">Last done: <span data-care-date>_ _ / _ _</span></p>
          </li>
        ))}
      </ul>
    </div>
    <Btn label="Rather we do it? Call" sub="(727) 512-0673" block h={60} class="cr-btn cr-btn-m" />
  </div>
</section>
<style>
  .cr { background: var(--frost); padding: 96px 0 120px; }
  .cr-grid { display: grid; grid-template-columns: 460px 600px; grid-template-areas: 'l tag'; justify-content: space-between; padding-right: 80px; align-items: start; }
  .cr-l { grid-area: l; padding-top: 24px; }
  .cr-h { margin-top: 16px; }
  .cr-lead { margin-top: 20px; max-width: 440px; font-size: 17px; line-height: 1.5; color: var(--muted); }
  .cr :global(.cr-btn-d) { margin-top: 28px; }
  .cr :global(.cr-btn-m) { display: none; }
  .cr-tag { grid-area: tag; position: relative; padding: 62px 36px 22px; border-radius: 10px; background: var(--steel); box-shadow: inset 0 0 0 1.5px var(--steel2), 8px 8px 0 var(--ink); transform-origin: 50% 28px; }
  :global(html.motion) .cr-tag:not(.in) { rotate: -3deg; }
  .cr-tag { transition: rotate 1.1s cubic-bezier(.34, 1.56, .64, 1); }
  .cr-hole { position: absolute; left: 50%; top: 14px; width: 28px; height: 28px; margin-left: -14px; border-radius: 50%; background: var(--frost); box-shadow: inset 0 0 0 2px var(--steel2); }
  .cr-rv { position: absolute; width: 10px; height: 10px; border-radius: 50%; background: var(--steel2); }
  .cr-rv:nth-of-type(2) { left: 14px; top: 14px; } .cr-rv:nth-of-type(3) { right: 14px; top: 14px; }
  .cr-rv:nth-of-type(4) { left: 14px; bottom: 14px; } .cr-rv:nth-of-type(5) { right: 14px; bottom: 14px; }
  .cr-top { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding-bottom: 9px; border-bottom: 1.5px solid rgba(22,19,15,.4); }
  .cr-title { font-family: var(--f-m); font-weight: 700; font-size: 13px; line-height: 17px; letter-spacing: .1em; text-transform: uppercase; }
  .cr-count { font-family: var(--f-m); font-weight: 700; font-size: 11px; line-height: 15px; letter-spacing: .06em; text-transform: uppercase; color: #275468; white-space: nowrap; } /* pdeep darkened: 5.2:1 on the steel tag */
  .cr-list { margin: 0; padding: 0; list-style: none; }
  .cr-it { position: relative; padding: 16px 0 14px 52px; border-top: 1px solid rgba(22,19,15,.2); }
  .cr-it:first-child { border-top: 0; }
  @media (min-width: 768px) {
    .cr-it:first-child { padding-top: 24px; }
    .cr-it:last-child { padding-bottom: 36px; }
    .cr-it:not(:first-child) .cr-cb, .cr-it:not(:first-child) .cr-box { top: 20px; }
  }
  .cr-cb { position: absolute; left: 0; top: 28px; width: 32px; height: 32px; margin: 0; opacity: 0; cursor: pointer; z-index: 1; }
  .cr-lab { display: block; cursor: pointer; }
  .cr-box { position: absolute; left: 0; top: 28px; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 4px; background: var(--white); box-shadow: inset 0 0 0 2px var(--ink); transition: background-color .25s var(--ease-io); }
  .cr-box svg { opacity: 0; scale: .6; transition: opacity .25s var(--ease-io), scale .3s var(--ease-io); }
  .cr-cb:checked + .cr-lab .cr-box { background: var(--ink); }
  .cr-cb:checked + .cr-lab .cr-box svg { opacity: 1; scale: 1; }
  .cr-cb:focus-visible + .cr-lab .cr-box { outline: 3px solid var(--pdeep); outline-offset: 3px; }
  .cr-t { display: inline-block; padding-top: 4px; font-family: var(--f-h); font-weight: 800; font-size: 24px; line-height: 1.04; letter-spacing: -.02em; white-space: pre-wrap; text-decoration: line-through; text-decoration-color: transparent; text-decoration-thickness: 2px; transition: color .3s var(--ease-io), text-decoration-color .3s var(--ease-io); }
  .cr-cb:checked + .cr-lab .cr-t { color: rgba(22,19,15,.6); text-decoration-color: rgba(22,19,15,.6); }
  .cr-d { margin-top: 13px; font-family: var(--f-m); font-weight: 500; font-size: 12px; line-height: 1.55; letter-spacing: .01em; }
  .cr-last { margin-top: 12px; font-family: var(--f-m); font-weight: 700; font-size: 10px; line-height: 13px; letter-spacing: .06em; text-transform: uppercase; color: #4A4E50; } /* muted darkened: 5.3:1 on steel */
  @media (min-width: 768px) and (max-width: 1279px) {
    .cr-grid { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'l' 'tag'; gap: 48px; padding-right: 0; }
    .cr-tag { max-width: 600px; }
  }
  @media (max-width: 767px) {
    .cr { padding: 64px 0 90px; }
    .cr-grid { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'l' 'tag'; padding-right: 0; }
    .cr-l { padding-top: 0; }
    .cr-h { margin-top: 12px; }
    .cr-lead { margin-top: 16px; font-size: 15px; }
    .cr :global(.cr-btn-d) { display: none; }
    .cr :global(.cr-btn-m) { display: flex; margin-top: 28px; }
    .cr-tag { margin-top: 28px; padding: 50px 20px 10px; box-shadow: inset 0 0 0 1.5px var(--steel2), 6px 6px 0 var(--ink); }
    .cr-hole { top: 12px; width: 24px; height: 24px; margin-left: -12px; }
    .cr-rv { display: none; }
    .cr-title { font-size: 11px; line-height: 15px; letter-spacing: .06em; }
    .cr-count { font-size: 10px; line-height: 13px; }
    .cr-top { padding-bottom: 7px; }
    .cr-it { padding: 20px 0 16px 42px; }
    .cr-cb, .cr-box { top: 22px; width: 28px; height: 28px; }
    .cr-box svg { width: 15px; height: 10px; }
    .cr-t { padding-top: 2px; font-size: 18px; }
    .cr-d { margin-top: 8px; font-size: 11px; }
    .cr-last { margin-top: 10px; font-size: 9px; line-height: 12px; }
  }
</style>
<script>
  const root = document.querySelector<HTMLElement>('[data-care]');
  if (root) {
    const KEY = 'glass-care-tag-v1';
    type S = Record<string, string>;
    let st: S = {};
    try { st = JSON.parse(localStorage.getItem(KEY) || '{}') || {}; } catch { st = {}; }
    const items = [...root.querySelectorAll<HTMLElement>('[data-care-it]')];
    const n = root.querySelector<HTMLElement>('[data-care-n]')!;
    const fmt = (iso: string) => { const d = new Date(iso); return isNaN(+d) ? '_ _ / _ _' : `${String(d.getMonth() + 1).padStart(2, '0')} / ${String(d.getDate()).padStart(2, '0')}`; };
    const paint = () => {
      let done = 0;
      items.forEach((it) => {
        const id = it.dataset.careIt!; const cb = it.querySelector<HTMLInputElement>('[data-care-cb]')!; const dt = it.querySelector<HTMLElement>('[data-care-date]')!;
        cb.checked = !!st[id]; if (st[id]) done++;
        dt.textContent = st[id] ? fmt(st[id]) : '_ _ / _ _';
      });
      n.textContent = String(done);
    };
    items.forEach((it) => it.querySelector<HTMLInputElement>('[data-care-cb]')!.addEventListener('change', (e) => {
      const id = it.dataset.careIt!;
      if ((e.target as HTMLInputElement).checked) st[id] = new Date().toISOString(); else delete st[id];
      try { localStorage.setItem(KEY, JSON.stringify(st)); } catch { /* private mode: still works for this visit */ }
      paint();
    }));
    paint();
    // Swing in on scroll (motion only; the CSS start state is -3deg under html.motion, 0 otherwise).
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { root.classList.add('in'); io.disconnect(); } }), { rootMargin: '0px 0px -20% 0px' });
      io.observe(root);
    } else root.classList.add('in');
  }
</script>
