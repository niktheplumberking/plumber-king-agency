---
// What it costs, R2 rebuild (Nick 20 Nov: text left + six items right = slop; every section interactive).
// "Build your work order": no prices (facts rule), so the visitor flips the six things that apply to their house on a
// steel work-order plate. Each switch that goes on writes its line onto the order and raises the water in the "job"
// housing a sixth; the counter reads "3 of 6 apply". The promise line and the call button close the order.
// 21st.dev: "Plan Add-on Selector" (cnippet-dev, id 24942: checkbox rows with a live total) re-skinned as a Glass work
// order: steel plate with rivets, mono labels, housing gauge instead of a price total, powder offset shadow.
// No JS / reduced motion: the switches are real checkboxes (labels always show their line); the gauge just follows.
import Eyebrow from '../kit/Eyebrow.astro';
import Housing from '../kit/Housing.astro';
import Btn from '../kit/Btn.astro';
import Seam from '../kit/Seam.astro';
const F = [
  { t: 'Tank or tankless', d: 'Tankless units cost more to fit.', q: 'Going tankless?' },
  { t: 'Gas or electric', d: 'Gas adds venting and gas-line work.', q: 'Gas heater?' },
  { t: 'Size', d: 'More bathrooms, bigger unit.', q: 'Several bathrooms at once?' },
  { t: 'Venting', d: 'Gas units need a safe vent path.', q: 'Needs a vent path?' },
  { t: 'Permit', d: 'Needed for a replacement in Pinellas.', q: 'Replacing it?' },
  { t: 'Access', d: 'Attic, closet or garage changes the job.', q: 'Attic, closet or garage?' },
];
---
<section class="pc seam-host" data-m-section data-pc>
  <Seam from="var(--frost)" to="var(--white)" d={48} dm={32} />
  <div class="wrap">
    <div class="pc-top">
      <Eyebrow text="What it costs" />
      <h2 class="h2 pc-h" data-t="2" style="--h2:52px;--h2m:28px">No price list.<br /><span class="tone">Here’s what changes it.</span></h2>
      <p class="pc-lead" data-t="3"><span class="d">Every house is different, so we don’t post prices. </span>We give you the price before any work starts.</p>
    </div>
    <div class="pc-order" data-t="4">
      <i class="pc-rv" aria-hidden="true"></i><i class="pc-rv" aria-hidden="true"></i><i class="pc-rv" aria-hidden="true"></i><i class="pc-rv" aria-hidden="true"></i>
      <fieldset class="pc-set">
        <legend class="pc-lg">Work order · water heater · <span class="pc-ask">flip what applies to your house</span></legend>
        <ul class="pc-list" role="list">
          {F.map((f, i) => (
            <li>
              <label class="pc-row">
                <input type="checkbox" value={i} />
                <span class="pc-sw" aria-hidden="true"><span></span></span>
                <span class="pc-tx"><span class="pc-t">{f.t}<span class="pc-q"> · {f.q}</span></span><span class="pc-d">{f.d}</span></span>
              </label>
            </li>
          ))}
        </ul>
      </fieldset>
      <div class="pc-gauge">
        <Housing w={120} h={220} wm={84} hm={150} r={30} rm={22} tone="frost" fill={1} shadow={8} shadowm={6} class="pc-hs" />
        <p class="pc-c" aria-live="polite"><b data-pc-n>0</b> of 6 apply</p>
        <p class="pc-cs">No price list. You hear the price before any work starts.</p>
      </div>
    </div>
    <div class="pc-cta" data-t="3"><Btn sub="Get your price" size="l" w={300} /></div>
  </div>
</section>
<style>
  .pc { position: relative; background: var(--white); padding: 110px 0 104px; }
  .pc-top { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .pc-h { margin-top: 16px; }
  .pc-lead { margin-top: 20px; max-width: 520px; font-size: 17px; line-height: 1.5; }

  .pc-order { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 40px; max-width: 1000px; margin: 52px auto 0; padding: 36px 40px 40px; border-radius: 6px; background: var(--steel); box-shadow: inset 0 0 0 1px var(--steel2), 10px 10px 0 var(--ink); }
  .pc-rv { position: absolute; width: 10px; height: 10px; border-radius: 50%; background: var(--steel2); }
  .pc-rv:nth-of-type(1) { left: 12px; top: 12px; } .pc-rv:nth-of-type(2) { right: 12px; top: 12px; } .pc-rv:nth-of-type(3) { left: 12px; bottom: 12px; } .pc-rv:nth-of-type(4) { right: 12px; bottom: 12px; }
  .pc-set { min-width: 0; margin: 0; padding: 0; border: 0; }
  .pc-lg { width: 100%; padding: 0 0 12px; font: 700 12px/1.3 var(--f-m); letter-spacing: .06em; text-transform: uppercase; border-bottom: 1px solid rgba(22,19,15,.3); }
  .pc-ask { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  .pc-list { margin: 0; padding: 0; list-style: none; }
  .pc-list li { border-bottom: 1px solid rgba(22,19,15,.16); }
  .pc-row { position: relative; display: grid; grid-template-columns: 52px minmax(0, 1fr); gap: 16px; align-items: center; min-height: 66px; padding: 10px 6px; cursor: pointer; border-radius: 4px; transition: background-color .4s var(--ease-io); }
  .pc-row:hover { background: rgba(255,255,255,.35); }
  .pc-row input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .pc-sw { position: relative; width: 48px; height: 28px; border-radius: 14px; background: var(--white); box-shadow: inset 0 0 0 1.5px var(--ink); transition: background-color .45s var(--ease-io); }
  .pc-sw span { position: absolute; left: 4px; top: 4px; width: 20px; height: 20px; border-radius: 50%; background: var(--ink); transition: translate .45s var(--ease-io), background-color .45s var(--ease-io); }
  .pc-row input:checked + .pc-sw { background: var(--pdeep); }
  .pc-row input:checked + .pc-sw span { translate: 20px 0; background: var(--white); }
  .pc-row input:focus-visible + .pc-sw { outline: 3px solid var(--pdeep); outline-offset: 3px; }
  .pc-tx { display: flex; flex-direction: column; gap: 3px; }
  .pc-t { font: 800 19px/1.1 var(--f-h); letter-spacing: -.02em; }
  .pc-q { font: 500 14px/1.1 var(--f-b); letter-spacing: 0; color: var(--ink); }
  .pc-d { font: 500 12px/1.45 var(--f-m); color: var(--ink); }
  .pc-row input:checked ~ .pc-tx .pc-d { font-weight: 700; }
  .pc-row input:checked ~ .pc-tx .pc-d::before { content: '+ '; color: var(--pdeep); font-weight: 700; }

  .pc-gauge { display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 20px 16px; border-radius: 6px; background: var(--white); box-shadow: inset 0 0 0 1.5px var(--ink); }
  .pc-gauge :global(.pc-hs) { --lvl: var(--on, 0) !important; }
  .pc-gauge :global(.pc-hs .hs-water) { transition: height .7s var(--ease-io), translate 1.2s var(--ease-io); }
  .pc-c { margin-top: 22px; font: 700 12px/1 var(--f-m); letter-spacing: .06em; text-transform: uppercase; }
  .pc-c b { font: 800 34px/1 var(--f-h); letter-spacing: -.02em; margin-right: 6px; color: var(--pdeep); }
  .pc-cs { margin-top: 12px; font-size: 14px; line-height: 1.45; color: var(--muted); }
  .pc-cta { display: flex; justify-content: center; margin-top: 44px; }

  @media (max-width: 1023px) { .pc-order { grid-template-columns: minmax(0, 1fr); } .pc-gauge { flex-direction: row; gap: 20px; text-align: left; } .pc-c { margin-top: 0; } }
  @media (max-width: 767px) {
    .pc { padding: 64px 0 60px; }
    .pc-h { margin-top: 10px; }
    .pc-lead { margin-top: 12px; font-size: 15px; }
    .pc-order { margin-top: 28px; padding: 22px 16px 18px; gap: 18px; box-shadow: inset 0 0 0 1px var(--steel2), 6px 6px 0 var(--ink); }
    .pc-lg { font-size: 10px; }
    .pc-row { grid-template-columns: 46px minmax(0, 1fr); gap: 12px; padding: 10px 2px; }
    .pc-sw { width: 44px; height: 26px; } .pc-sw span { width: 18px; height: 18px; } .pc-row input:checked + .pc-sw span { translate: 18px 0; }
    .pc-t { font-size: 16px; } .pc-q { display: none; }
    .pc-gauge { flex-wrap: wrap; justify-content: flex-start; }
    .pc-cs { flex-basis: 100%; margin-top: 4px; }
    .pc-cta :global(a) { width: 100%; }
  }
</style>
<script>
  const root = document.querySelector<HTMLElement>('[data-pc]');
  if (root) {
    const boxes = [...root.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')];
    const n = root.querySelector<HTMLElement>('[data-pc-n]')!;
    const hs = root.querySelector<HTMLElement>('.pc-hs')!;
    const upd = () => { const k = boxes.filter((b) => b.checked).length; n.textContent = String(k); hs.style.setProperty('--on', String(Math.max(0.04, k / 6))); };
    boxes.forEach((b) => b.addEventListener('change', upd));
    upd();
  }
</script>
