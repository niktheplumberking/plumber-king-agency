---
// What it costs, fix round 3 (E, RECHECK BLOCKER 2: the flip-what-applies work order with "N OF 6 APPLY" and the "Every
// house is different, so there is no price list here" line were Khinda's SvPricing). New idea, THE JOB, TAKEN APART: an
// exploded view. One water-heater job is a stack of six slabs lying flat (isometric planes); as the section scrolls they
// lift apart (kit/scrub.ts data-scrub-tw, the scroll drives it) and each slab's leader line and label slide out, left and
// right in turn, so the stack sits in the middle with the labels balanced on both sides. Point at a slab or its label and
// the pair lights. No counter, no checkboxes, no "no price list" sentence; the close is "text a photo of the label" + call.
// Copy per layer: the page's earlier factor copy (hedged "usually"), FACTS-CHECK services (tank, tankless, gas, electric).
// 21st.dev: hello_54e122be "Hairline Exploded" (an isometric stack that separates into labelled layers), rebuilt with CSS
// 3D planes and the kit scrub engine, re-skinned with Glass tokens (ink hairlines, powder / steel / cream slabs).
// No JS / reduced motion: the stack shows fully exploded with every label out.
import Eyebrow from '../kit/Eyebrow.astro';
import Btn from '../kit/Btn.astro';
import Seam from '../kit/Seam.astro';
const L = [
  { t: 'The unit', d: 'Tank or tankless. Tankless usually costs more to fit.', c: 'var(--white)' },
  { t: 'Gas or electric', d: 'Gas can add venting and gas-line work.', c: 'var(--powder)' },
  { t: 'Size', d: 'More bathrooms at once usually means a bigger unit.', c: 'var(--frost)' },
  { t: 'Venting', d: 'Gas units usually need a safe vent path.', c: 'var(--steel)' },
  { t: 'Where it sits', d: 'Attic, closet or garage can change the job.', c: 'var(--cream)' },
  { t: 'Permit', d: 'Usually needed for a replacement; the office depends on your address.', c: 'var(--frost2)' },
];
---
<section class="pc seam-host" data-m-section aria-labelledby="pc-h">
  <Seam from="var(--frost)" to="var(--white)" d={48} dm={32} />
  <div class="wrap">
    <div class="pc-top">
      <Eyebrow text="What sets the price" />
      <h2 class="h2 pc-h" id="pc-h" data-t="2" style="--h2:52px;--h2m:28px">One heater,<br /><span class="tone">six layers of job.</span></h2>
      <p class="pc-lead" data-t="3">Scroll to take the job apart. Your house decides each layer.</p>
    </div>
    <ol class="ex" role="list" data-scrub data-start="top 80%" data-end="center 45%" data-start-m="top 85%" data-end-m="center 50%" data-t="4">
      {L.map((l, i) => (
        <li class:list={['ex-r', i % 2 ? 'ex-rt' : 'ex-lt']} style={`--i:${i};--c:${l.c}`}>
          <span class="ex-slab" aria-hidden="true" data-scrub-tw={JSON.stringify({ y: (2.5 - i) * 72 })}><span class="ex-pl"><b>0{i + 1}</b></span></span>
          <span class="ex-lab" data-scrub-tw={JSON.stringify({ opacity: 0, x: i % 2 ? -40 : 40 })} data-win={`${0.3 + i * 0.1},${0.6 + i * 0.07}`}>
            <span class="ex-ln" aria-hidden="true"></span>
            <span class="ex-tx"><span class="ex-n">Layer 0{i + 1}</span><span class="ex-t">{l.t}</span><span class="ex-d">{l.d}</span></span>
          </span>
        </li>
      ))}
    </ol>
    <div class="pc-close" data-t="3">
      <p class="pc-cl">Text a photo of your heater label. We tell you the price for your layers on the call.</p>
      <Btn sub="Get your price" size="l" w={300} />
    </div>
  </div>
</section>

<style>
  .pc { position: relative; background: var(--white); padding: 110px 0 104px; overflow-x: clip; }
  .pc-top { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .pc-h { margin-top: 16px; }
  .pc-lead { margin-top: 18px; max-width: 520px; font-size: 17px; line-height: 1.5; color: var(--muted); }
  /* The stack: each row is [label | slab | label]; the label sits on the left for even rows and the right for odd ones. */
  .ex { position: relative; display: grid; gap: 0; max-width: 1080px; margin: 40px auto 0; padding: 0; list-style: none; }
  .ex-r { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) 300px minmax(0, 1fr); align-items: center; height: 96px; z-index: calc(10 - var(--i)); }
  .ex-slab { grid-column: 2; display: grid; place-items: center; height: 96px; perspective: 900px; }
  .ex-pl { position: relative; display: grid; place-items: center; width: 220px; height: 220px; background: var(--c); border-radius: 14px; box-shadow: inset 0 0 0 2px var(--ink), 8px 8px 0 var(--ink);
    transform: rotateX(62deg) rotateZ(-45deg); transition: background-color .4s var(--ease-io), box-shadow .4s var(--ease-io); }
  .ex-pl b { font: 800 46px/1 var(--f-h); color: var(--ink); rotate: 45deg; opacity: .85; }
  .ex-lab { display: flex; align-items: center; gap: 0; min-width: 0; }
  .ex-lt .ex-lab { grid-column: 1; grid-row: 1; flex-direction: row-reverse; text-align: right; }
  .ex-rt .ex-lab { grid-column: 3; grid-row: 1; }
  .ex-ln { flex: 0 0 64px; height: 1.5px; background: var(--ink); position: relative; }
  .ex-ln::before { content: ''; position: absolute; top: -4px; width: 9px; height: 9px; border-radius: 50%; background: var(--ink); }
  .ex-lt .ex-ln::before { right: -4px; } .ex-rt .ex-ln::before { left: -4px; }
  .ex-tx { display: grid; gap: 3px; max-width: 320px; padding: 0 14px; }
  .ex-n { font: 700 10px/1.2 var(--f-m); letter-spacing: .1em; text-transform: uppercase; color: var(--pdeep); }
  .ex-t { font: 800 22px/1.1 var(--f-h); letter-spacing: -.02em; color: var(--ink); }
  .ex-d { font-size: 15px; line-height: 1.45; color: var(--ink); }
  .ex-r:hover .ex-pl, .ex-r:focus-within .ex-pl { background: var(--ink); }
  .ex-r:hover .ex-pl b { color: var(--white); }
  .ex-r:hover .ex-t { color: var(--pdeep); }
  .pc-close { display: flex; flex-direction: column; align-items: center; gap: 18px; margin-top: 70px; text-align: center; }
  .pc-cl { max-width: 520px; font-weight: 700; font-size: 19px; line-height: 1.45; color: var(--ink); }
  @media (min-width: 768px) and (max-width: 1279px) {
    .ex-r { grid-template-columns: minmax(0, 1fr) 220px minmax(0, 1fr); }
    .ex-pl { width: 170px; height: 170px; }
    .ex-ln { flex-basis: 36px; }
    .ex-tx { padding: 0 10px; }
    .ex-d { font-size: 14px; }
  }
  @media (max-width: 767px) {
    .pc { padding: 60px 0 64px; }
    .pc-lead { font-size: 15px; }
    .ex { margin-top: 26px; }
    .ex-r { grid-template-columns: 112px minmax(0, 1fr); height: auto; min-height: 92px; }
    .ex-slab { grid-column: 1; grid-row: 1; height: 92px; }
    .ex-pl { width: 84px; height: 84px; border-radius: 8px; }
    .ex-pl { box-shadow: inset 0 0 0 1.5px var(--ink), 4px 4px 0 var(--ink); }
    .ex-pl b { font-size: 24px; }
    .ex-lt .ex-lab, .ex-rt .ex-lab { grid-column: 2; grid-row: 1; flex-direction: row; text-align: left; }
    .ex-lt .ex-ln::before { right: auto; left: -4px; }
    .ex-ln { flex-basis: 16px; }
    .ex-tx { padding: 6px 0 6px 10px; }
    .ex-t { font-size: 18px; }
    .ex-d { font-size: 14px; }
    .pc-close { margin-top: 40px; }
    .pc-cl { font-size: 16px; }
  }
</style>
