---
// "From a photo to hot water", R4 (independent re-check R3 MAJOR 1: the R3 pipe run with five valves repeated the home
// Process pipe, and both were Mike's home Process device). New idea, THE STORYBOARD: the water-heater job as a four-panel
// strip, the way a job is sketched before it is shot: 01 a phone over the heater's label, 02 the van at the curb, 03 the
// heater on its stand with a wrench (swap or repair), 04 an open tap. Each panel's line drawing draws itself, stroke by
// stroke, as the strip scrolls through the screen (kit/scrub.ts data-scrub-path, one window per panel: 01 first, 04
// last), and its caption plate lifts in when its drawing completes. Pointing at (or focusing) a panel lifts it.
// 21st.dev: "Line Draw SVG" (@pulkitxm, id 18352: a path that draws itself on scroll) + "Sketchbook Reveal Card"
// (@dhileepkumargm, id 7217: hand-drawn card content drawn in as you scroll), rebuilt on the kit scrub engine (no React,
// no per-frame code of its own), re-skinned: ink strokes on frost panels, ink comic gutters, steel caption plates.
// Nearest match: Glass home Process (now a job pad of pages you turn: nothing drawn, nothing scroll-driven), Glass
// WhRelated / WhDiy (pipes), Mike home Process (water along a pipe), Mike water-heater CaseFile (case lines light up),
// Khinda SvProcess (a cable pulled through studs, pinned). None is a strip of panels whose drawings draw themselves.
// Facts: 03 keeps the permit hedge ("usually", "depends on your address") and the next-day label ("3 of the 16 reviews we
// hold"); 02 keeps Parker L's estimate line as a review mention.
// No JS / reduced motion: every drawing is complete and every caption shows.
import Eyebrow from '../kit/Eyebrow.astro';
// Small path helpers so every shape is a <path> (pathLength="1" is drawn by the kit).
const R = (x: number, y: number, w: number, h: number, r = 0) => r
  ? `M${x + r} ${y}h${w - 2 * r}a${r} ${r} 0 0 1 ${r} ${r}v${h - 2 * r}a${r} ${r} 0 0 1 -${r} ${r}h-${w - 2 * r}a${r} ${r} 0 0 1 -${r} -${r}v-${h - 2 * r}a${r} ${r} 0 0 1 ${r} -${r}z`
  : `M${x} ${y}h${w}v${h}h-${w}z`;
const C = (cx: number, cy: number, r: number) => `M${cx - r} ${cy}a${r} ${r} 0 1 0 ${2 * r} 0a${r} ${r} 0 1 0 -${2 * r} 0z`;
const S = [
  { k: 'Photo of the label', d: 'Text a photo of the heater’s label, or ask for a visit. The label shows the size and type.',
    art: [R(30, 30, 90, 110, 6), 'M42 52h66M42 66h50M42 80h58M42 94h36', R(118, 18, 52, 96, 9), R(126, 32, 36, 58, 2), C(144, 102, 5), 'M98 56l20 6M98 92l20-6'] },
  { k: 'The visit', d: 'We come out and look at the heater and the space around it. One review: an estimate the same day, the work the next.',
    art: ['M14 112h172', R(30, 50, 96, 54, 6), 'M126 66h30l22 22v16h-52', 'M140 72h18l12 14h-30z', C(56, 110, 12), C(150, 110, 12), 'M44 66h56M44 78h36'] },
  { k: 'Swap or repair', d: 'A part, or a new heater. A replacement usually needs a permit; the office depends on your address. Not promised for every job: 3 of the 16 reviews we hold mention the next day.',
    art: [R(60, 26, 64, 98, 14), R(54, 18, 76, 12, 3), 'M78 18v-8M106 18v-8', R(48, 124, 88, 10, 2), 'M74 50h36M74 62h24', 'M150 40l20-20a8 8 0 0 1 10 10l-20 20M150 40l-6 6 10 10 6-6'] },
  { k: 'Test', d: 'Hot water on, no leaks, then we leave.',
    art: ['M24 40h76a18 18 0 0 1 18 18v18', 'M24 30v20', R(56, 22, 30, 10, 3), 'M71 22v-8M60 14h22', 'M118 92c0 6-5 10-5 15a5 5 0 0 0 10 0c0-5-5-9-5-15z', 'M106 118c0 5-4 8-4 12a4 4 0 0 0 8 0c0-4-4-7-4-12zM132 116c0 5-4 8-4 12a4 4 0 0 0 8 0c0-4-4-7-4-12z', 'M70 140h96'] },
];
const N = S.length;
const pad = (i: number) => String(i + 1).padStart(2, '0');
---
<section class="ps" data-m-section aria-labelledby="ps-h">
  <div class="wrap">
    <div class="ps-top">
      <Eyebrow text="How the job goes" />
      <h2 class="h2 ps-h" id="ps-h" data-t="2" style="--h2:52px;--h2m:28px">From a photo<br /><span class="tone">to hot water.</span></h2>
      <p class="ps-lead" data-t="3">Four panels, in the order it happens.</p>
    </div>
    <ol class="sb" role="list" data-scrub data-start="top 80%" data-end="bottom 80%" data-start-m="top 85%" data-end-m="bottom 88%" data-lag="0.5">
      {S.map((s, i) => {
        const a = (i / N) * 0.9, b = a + 0.9 / N;
        return (
          <li class="sb-p" data-stop data-at={b.toFixed(3)}>
            <div class="sb-art" aria-hidden="true">
              <span class="sb-n">{pad(i)}</span>
              <svg viewBox="0 0 200 150">
                {s.art.map((d, j) => <path d={d} pathLength="1" data-scrub-path data-win={`${(a + (j / s.art.length) * (b - a) * 0.75).toFixed(3)},${(a + ((j + 1) / s.art.length) * (b - a)).toFixed(3)}`} />)}
              </svg>
            </div>
            <div class="sb-cap">
              <i></i><i></i>
              <h3 class="sb-k"><span class="sr-only">Panel {i + 1} of {N}: </span>{s.k}</h3>
              <p class="sb-d">{s.d}</p>
            </div>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<style>
  .ps { background: var(--white); padding: 110px 0 120px; }
  .ps-top { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .ps-h { margin-top: 16px; }
  .ps-lead { margin-top: 16px; font-size: 17px; color: var(--muted); }
  /* The strip: four panels inside one ink frame with white gutters, like a comic page. */
  .sb { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin: 52px 0 0; padding: 14px; list-style: none; border-radius: 10px; background: var(--ink); box-shadow: 12px 12px 0 var(--powder); }
  .sb-p { display: flex; flex-direction: column; border-radius: 4px; background: var(--white); transition: translate .5s var(--ease-io); }
  .sb-art { position: relative; aspect-ratio: 4 / 3; margin: 10px 10px 0; border-radius: 3px; background: var(--frost); box-shadow: inset 0 0 0 1.5px var(--ink); }
  .sb-art svg { position: absolute; inset: 8% 6%; width: 88%; height: 84%; fill: none; stroke: var(--ink); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; overflow: visible; }
  .sb-n { position: absolute; left: 10px; top: 10px; display: grid; place-items: center; min-width: 34px; height: 26px; padding: 0 6px; border-radius: 4px; background: var(--ink); color: var(--white); font: 700 12px/1 var(--f-m); letter-spacing: .06em; }
  .sb-cap { position: relative; flex: 1; margin: 12px 10px 10px; padding: 16px 16px 14px; border-radius: 3px; background: var(--steel); box-shadow: inset 0 0 0 1px var(--steel2);
    transition: opacity .5s var(--ease-io), translate .5s var(--ease-io); }
  .sb-cap i { position: absolute; top: 6px; width: 5px; height: 5px; border-radius: 50%; background: var(--steel2); }
  .sb-cap i:first-child { left: 6px; } .sb-cap i:nth-child(2) { right: 6px; }
  .sb-k { font: 800 20px/1.1 var(--f-h); letter-spacing: -.01em; color: var(--ink); }
  .sb-d { margin-top: 8px; font-size: 15px; line-height: 1.45; color: var(--ink); }
  .sb-p:hover, .sb-p:focus-within { translate: 0 -6px; }
  /* Motion: the caption waits until its panel's drawing is done (class-mode stop at the end of its window). */
  :global(html.motion) .sb:not(.is-scrub) .sb-cap, :global(html.motion) .sb.is-scrub .sb-p:not(.is-on) .sb-cap { opacity: 0; translate: 0 12px; }
  @media (prefers-reduced-motion: reduce) { .sb-p, .sb-cap { transition: none; } }
  @media (min-width: 768px) and (max-width: 1279px) {
    .sb { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 767px) {
    .ps { padding: 60px 0 64px; }
    .ps-lead { font-size: 15px; }
    .sb { grid-template-columns: 1fr; gap: 10px; margin-top: 28px; padding: 10px; box-shadow: 6px 6px 0 var(--powder); }
    .sb-p { display: grid; grid-template-columns: 120px minmax(0, 1fr); align-items: stretch; }
    .sb-art { aspect-ratio: auto; min-height: 104px; margin: 8px 0 8px 8px; }
    .sb-n { left: 6px; top: 6px; min-width: 28px; height: 22px; font-size: 10px; }
    .sb-cap { margin: 8px; padding: 12px 12px 10px; }
    .sb-k { font-size: 17px; }
    .sb-d { margin-top: 6px; font-size: 14px; }
  }
</style>
