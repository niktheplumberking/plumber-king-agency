---
// Quick answer, fix round 3 (E, RECHECK MAJOR 3: the "tank is dry / tank leaks" two-way switch with REPAIR | tank |
// REPLACE verdicts read like Mike's RepairInstall). New idea, SORT THE SYMPTOMS: the visitor's symptom is a chip on the
// bench; tap it and it slides (FLIP) into the pile it usually belongs to (Usually a repair / It depends / Usually a
// replacement), turning over to show why. Three steel trays, symmetric, the "it depends" pile in the middle because that
// is the honest answer for two of them. Copy per symptom is the page's own Problems copy (WhProblems), hedged "usually /
// often"; the full quick answer stays as one readable paragraph under the trays (AI-overview text, with its source).
// 21st.dev: diceui "Kanban" (cards that move between columns, keyboard operable) + ddoemonn "Reorder List" (FLIP card
// motion), rebuilt in vanilla TS (tap / Enter instead of drag), re-skinned with Glass steel trays, ink chips, powder shadow.
// No JS: every chip shows its pile and reason in place on the bench; reduced motion: chips move without the slide.
import Eyebrow from '../kit/Eyebrow.astro';
const C = [
  { t: 'No hot water', p: 'rep', w: 'Element, pilot or thermostat. Often a part, not the tank.' },
  { t: 'Rusty water', p: 'rep', w: 'Often the anode rod is used up.' },
  { t: 'Runs out fast', p: 'dep', w: 'A failing element, or a tank too small for the house.' },
  { t: 'Relief valve dripping', p: 'rep', w: 'A safety part. For a licensed plumber.' },
  { t: 'Rumbling and popping', p: 'dep', w: 'Scale at the bottom. Pinellas water is hard.' },
  { t: 'The tank itself leaks', p: 'rpl', w: 'If the tank shell leaks, it usually needs replacing.' },
];
const P = [
  { k: 'rep', l: 'Usually a repair' },
  { k: 'dep', l: 'It depends' },
  { k: 'rpl', l: 'Usually a replacement' },
];
---
<section class="qa" data-m-section data-qs aria-labelledby="qa-h">
  <div class="wrap">
    <div class="qa-top">
      <Eyebrow text="Quick answer · repair or replace" />
      <h2 class="h2 qa-h" id="qa-h" data-t="2" style="--h2:52px;--h2m:30px">Sort your symptom.<br /><span class="tone">See which pile it lands in.</span></h2>
      <p class="qa-lead" data-t="3">Tap what your heater is doing.</p>
    </div>
    <div class="qs-bench" data-t="4">
      <p class="qs-bl" aria-hidden="true">On the bench</p>
      <ul class="qs-chips" role="list" data-qs-bench>
        {C.map((c) => (
          <li class="qs-it" data-p={c.p}>
            <button type="button" class="qs-c" aria-expanded="false">
              <span class="qs-t">{c.t}</span>
              <span class="qs-w"><b>{P.find((p) => p.k === c.p)!.l}.</b> {c.w}</span>
            </button>
          </li>
        ))}
      </ul>
    </div>
    <div class="qs-trays" data-t="4">
      {P.map((p) => (
        <div class:list={['qs-tray', `qs-${p.k}`]}>
          <i class="qs-rv" aria-hidden="true"></i><i class="qs-rv" aria-hidden="true"></i>
          <h3 class="qs-tl">{p.l}</h3>
          <ul class="qs-pile" role="list" data-qs-pile={p.k} aria-live="polite"></ul>
        </div>
      ))}
    </div>
    <p class="qs-reset-w"><button type="button" class="qs-reset" data-qs-reset hidden>Put them back on the bench</button></p>
    <div class="qa-ans" data-t="3">
      <p class="qa-a">If the tank is dry and the problem is a part, like an element, thermostat or valve, a repair is usually enough. A tank that leaks usually needs replacing. A replacement usually needs a permit: Pinellas County lists a “Water Heater Equal Change Out, Tank or Tankless” express permit for unincorporated areas, and Clearwater requires water heater permits. In Largo or another city, check with the city’s permit office.</p>
      <p class="qa-src"><span class="d">Source: pinellas.gov express permits · myclearwater.com, read 17 Nov 2026</span><span class="m">Source: pinellas.gov, read 17 Nov 2026</span></p>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-qs]').forEach((root) => {
    root.classList.add('qs-js');
    const bench = root.querySelector<HTMLElement>('[data-qs-bench]')!;
    const reset = root.querySelector<HTMLButtonElement>('[data-qs-reset]')!;
    const items = [...root.querySelectorAll<HTMLElement>('.qs-it')];
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // FLIP: measure, move in the DOM, measure again, play the difference (only on a tap, never on scroll).
    const move = (it: HTMLElement, to: HTMLElement) => {
      const a = it.getBoundingClientRect();
      to.appendChild(it);
      if (still) return;
      const b = it.getBoundingClientRect();
      it.animate([{ translate: `${a.left - b.left}px ${a.top - b.top}px`, rotate: '-3deg' }, { translate: '0 0', rotate: '0deg' }], { duration: 650, easing: 'cubic-bezier(.65,0,.35,1)' });
    };
    items.forEach((it) => {
      const b = it.querySelector<HTMLButtonElement>('.qs-c')!;
      b.addEventListener('click', () => {
        if (it.parentElement === bench) {
          move(it, root.querySelector<HTMLElement>(`[data-qs-pile="${it.dataset.p}"]`)!);
          b.setAttribute('aria-expanded', 'true'); it.classList.add('is-in');
          reset.hidden = false; b.focus();
        }
      });
    });
    reset.addEventListener('click', () => {
      items.forEach((it) => { if (it.parentElement !== bench) { move(it, bench); it.classList.remove('is-in'); it.querySelector('.qs-c')!.setAttribute('aria-expanded', 'false'); } });
      reset.hidden = true; items[0].querySelector<HTMLButtonElement>('.qs-c')!.focus();
    });
  });
</script>

<style>
  .qa { background: var(--frost); padding: 100px 0 110px; }
  .qa-top { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .qa-h { margin-top: 16px; }
  .qa-lead { margin-top: 16px; font-size: 17px; color: var(--muted); }
  .qs-bench { position: relative; max-width: 1000px; margin: 40px auto 0; padding: 26px 24px 22px; border-radius: 8px; background: var(--white); box-shadow: inset 0 0 0 1.5px var(--ink), 8px 8px 0 var(--powder); }
  .qs-bl { position: absolute; left: 22px; top: -11px; padding: 3px 10px; border-radius: 4px; background: var(--ink); color: var(--white); font: 700 10px/1.3 var(--f-m); letter-spacing: .1em; text-transform: uppercase; }
  .qs-chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; min-height: 52px; margin: 0; padding: 0; list-style: none; }
  .qs-js .qs-chips:empty::after { content: 'All sorted.'; align-self: center; font: 700 13px/1 var(--f-m); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .qs-it { display: flex; }
  .qs-c { display: grid; gap: 6px; min-height: 48px; padding: 12px 18px; border: 0; border-radius: 24px; background: var(--white); color: var(--ink); box-shadow: inset 0 0 0 1.5px var(--ink); font: 700 15px/1.2 var(--f-b); text-align: left; cursor: pointer;
    transition: background-color .45s var(--ease-io), color .45s var(--ease-io), box-shadow .45s var(--ease-io), border-radius .45s var(--ease-io); }
  .qs-c:hover { box-shadow: inset 0 0 0 2px var(--pdeep), 4px 4px 0 var(--powder); }
  .qs-c:focus-visible { outline: 3px solid var(--pdeep); outline-offset: 3px; }
  .qs-w { display: block; font: 500 13px/1.45 var(--f-b); }
  .qs-w b { font-weight: 800; }
  .qs-js .qs-chips .qs-w { display: none; }
  .qs-js .qs-chips .qs-c::after { content: 'Tap to sort'; font: 500 10px/1 var(--f-m); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .qs-pile .qs-it, .qs-pile .qs-c { width: 100%; }
  .qs-pile .qs-c { border-radius: 6px; cursor: default; background: var(--ink); color: var(--white); box-shadow: 4px 4px 0 var(--powder); }
  .qs-pile .qs-w b { display: none; }
  /* Three trays, symmetric. */
  .qs-trays { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; max-width: 1000px; margin: 30px auto 0; }
  .qs-tray { position: relative; min-height: 160px; padding: 22px 18px 20px; border-radius: 6px; background: var(--steel); box-shadow: inset 0 0 0 1px var(--steel2), inset 0 10px 0 rgb(22 19 15 / .06); }
  .qs-rv { position: absolute; top: 8px; width: 6px; height: 6px; border-radius: 50%; background: var(--steel2); }
  .qs-rv:nth-of-type(1) { left: 8px; } .qs-rv:nth-of-type(2) { right: 8px; }
  .qs-tl { padding-bottom: 10px; border-bottom: 1.5px dashed rgb(22 19 15 / .35); font: 800 20px/1.1 var(--f-h); letter-spacing: -.01em; text-align: center; color: var(--ink); }
  .qs-dep .qs-tl { color: var(--ink); }
  .qs-rpl .qs-tl::before, .qs-rep .qs-tl::before, .qs-dep .qs-tl::before { content: ''; display: block; width: 26px; height: 6px; margin: 0 auto 10px; border-radius: 3px; background: var(--powder); box-shadow: inset 0 0 0 1.5px var(--ink); }
  .qs-dep .qs-tl::before { background: var(--cream); } .qs-rpl .qs-tl::before { background: var(--pdeep); }
  .qs-pile { display: grid; gap: 10px; margin: 14px 0 0; padding: 0; list-style: none; }
  .qs-reset-w { display: flex; justify-content: center; min-height: 44px; margin-top: 18px; }
  .qs-reset { min-height: 44px; padding: 0 18px; border: 0; border-radius: 22px; background: none; box-shadow: inset 0 0 0 1.5px var(--ink); color: var(--ink); font: 700 14px/1 var(--f-b); cursor: pointer; }
  .qs-reset[hidden] { display: none; }
  .qs-reset:focus-visible { outline: 3px solid var(--pdeep); outline-offset: 3px; }
  .qa-ans { max-width: 820px; margin: 40px auto 0; text-align: center; }
  .qa-a { font-weight: 500; font-size: 19px; line-height: 1.55; }
  .qa-src { margin-top: 16px; font-family: var(--f-m); font-weight: 500; font-size: 10px; line-height: 13px; letter-spacing: .02em; color: var(--muted); }
  .qa-src .m { display: none; }
  @media (prefers-reduced-motion: reduce) { .qs-c { transition: none; } }
  @media (max-width: 767px) {
    .qa { padding: 56px 0 64px; }
    .qa-h { margin-top: 10px; }
    .qa-lead { font-size: 15px; }
    .qs-bench { margin-top: 28px; padding: 22px 12px 14px; box-shadow: inset 0 0 0 1.5px var(--ink), 5px 5px 0 var(--powder); }
    .qs-chips { gap: 8px; }
    .qs-c { padding: 10px 14px; font-size: 14px; }
    .qs-trays { grid-template-columns: minmax(0, 1fr); gap: 14px; margin-top: 22px; }
    .qs-tray { min-height: 0; padding: 18px 12px 14px; }
    .qs-js .qs-pile:empty { min-height: 24px; }
    .qs-tl { font-size: 17px; }
    .qa-ans { margin-top: 28px; text-align: left; }
    .qa-a { font-size: 16px; }
    .qa-src { font-size: 9px; line-height: 12px; }
    .qa-src .d { display: none; } .qa-src .m { display: inline; }
  }
</style>
