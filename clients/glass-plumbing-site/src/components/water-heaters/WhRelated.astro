---
// Related services (Figma 719:437 y 8514 h 300 / mobile y 8921 h 310). Their own pages are not built in this preview, so
// each links to its family card on /services (BUILD-BRIEF section 2).
import { ARROW } from '../services/glyphs';
const R = [
  { t: 'Tankless water heaters', d: 'On-demand hot water, single or paired.', href: '/services#hot-water' },
  { t: 'Water softeners & filtration', d: 'For Pinellas hard water.', href: '/services#hot-water' },
  { t: 'Leak repair', d: 'If the leak is not the heater.', href: '/services#leaks-lines' },
];
---
<section class="rl" data-m-section aria-labelledby="rl-h">
  <div class="wrap">
    <h2 class="rl-h" id="rl-h" data-t="1">Related services</h2>
    <ul class="rl-list" role="list" data-t="2" data-stagger>
      {R.map((r) => (
        <li><a class="rl-c" href={r.href}><span class="rl-t">{r.t}</span><span class="rl-d">{r.d}</span><span class="rl-ar" set:html={ARROW} /></a></li>
      ))}
    </ul>
  </div>
</section>
<style>
  .rl { background: var(--frost); padding: 72px 0 64px; }
  .rl-h { font-family: var(--f-m); font-weight: 700; font-size: 11px; line-height: 15px; letter-spacing: .06em; text-transform: uppercase; }
  .rl-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin: 21px 0 0; padding: 0; list-style: none; }
  .rl-c { position: relative; display: flex; flex-direction: column; justify-content: space-between; height: 128px; padding: 24px 60px 23px 24px; border-radius: 4px; background: var(--white); box-shadow: inset 0 0 0 1.5px var(--ink); transition: translate .3s var(--ease-io), box-shadow .3s var(--ease-io); }
  .rl-t { font-family: var(--f-h); font-weight: 800; font-size: 20px; line-height: 1.04; letter-spacing: -.02em; }
  .rl-d { font-size: 14px; line-height: 1.5; color: var(--muted); }
  .rl-ar { position: absolute; right: 26px; top: 28px; width: 12px; height: 10px; transition: translate .3s var(--ease-io); }
  .rl-ar :global(svg) { display: block; width: 12px; height: 10px; }
  .rl-c:hover { translate: 0 -3px; box-shadow: inset 0 0 0 1.5px var(--ink), 4px 4px 0 var(--powder); }
  .rl-c:hover .rl-ar { translate: 6px 0; }
  @media (min-width: 768px) and (max-width: 1279px) { .rl-c { height: auto; min-height: 128px; gap: 16px; } }
  @media (max-width: 767px) {
    .rl { padding: 40px 0 40px; }
    .rl-list { grid-template-columns: minmax(0, 1fr); gap: 10px; margin-top: 15px; }
    .rl-c { height: 60px; padding: 0 40px 0 18px; justify-content: center; }
    .rl-t { font-size: 16px; }
    .rl-d { display: none; }
    .rl-ar { right: 20px; top: 24px; }
  }
</style>
