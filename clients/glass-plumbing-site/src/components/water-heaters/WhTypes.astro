---
// Tank vs tankless, fix round 3 (E, RECHECK MAJOR 2: the drag compare slider matched Khinda's SvCompare). New idea,
// "WHAT RUNS AT ONCE": the FAQ answer on this page says the choice "depends on how much hot water you use at once", so the
// visitor turns on what their house runs at the same time (shower, second shower, kitchen sink, dishwasher, washer: real
// toggle buttons). Two steel stations answer side by side, symmetric under the switches: the TANK (Glass's own Rheem
// install) shows its stored hot water dropping a step for each thing running; the TANKLESS (Glass's own Rinnai pair) lights
// one segment of its "heating now" meter per thing running, with a marker where a single unit usually tops out, so the
// pair reads as the answer for a busy house. No numbers (no gallons, no flow rates, no prices): only "usually" wording
// backed by the page copy and FACTS-CHECK services (tank + tankless, single units and pairs).
// RECHECK minor: the tank photo is water-heater-softener-nolabel (the EnergyGuide figure that read like a price, "$489",
// is blurred in that copy).
// 21st.dev: kuratlielia "Usage Meter" (an allowance broken into categories with a segmented bar that warns near the limit)
// + aadilghani1 "Usage Meter" (a gauge that climbs as you press a key), rebuilt in vanilla TS with Glass housings and plates.
// No JS / reduced motion: one shower on (the default state, server-rendered); levels change without easing under reduced motion.
import Eyebrow from '../kit/Eyebrow.astro';
import Plate from '../kit/Plate.astro';
import Img from '../ui/Img.astro';
const FIX = [
  { k: 'shower', l: 'Shower', on: true },
  { k: 'shower2', l: 'Second shower' },
  { k: 'sink', l: 'Kitchen sink' },
  { k: 'dish', l: 'Dishwasher' },
  { k: 'washer', l: 'Washer' },
];
---
<section class="ty" id="types" data-m-section data-ty>
  <div class="wrap">
    <div class="ty-top">
      <Eyebrow text="Tank or tankless?" />
      <h2 class="h2 ty-h" data-t="2" style="--h2:52px;--h2m:28px">It depends on<br /><span class="tone">what runs at once.</span></h2>
      <p class="ty-lead" data-t="3">Turn on what your house uses at the same time.</p>
    </div>
    <div class="ty-sw" role="group" aria-label="Running at the same time" data-t="5">
      {FIX.map((f) => <button type="button" class="ty-b" aria-pressed={f.on ? 'true' : 'false'} data-fx-k={f.k}><i aria-hidden="true"></i>{f.l}</button>)}
    </div>
    <div class="ty-st" data-t="4" data-n="1">
      <article class="st st-tank">
        <div class="st-ph"><Img name="water-heater-softener-nolabel" alt="A tank water heater Glass installed on a platform, a water softener below it" focus="50% 30%" sizes="(min-width:1280px) 260px, (min-width:768px) 24vw, 40vw" box={260 / 340} boxM={0.8} widths={[260, 400, 520, 780]} /></div>
        <div class="st-body">
          <h3 class="st-h">Tank</h3>
          <p class="st-k">Stored hot water</p>
          <div class="st-tankg" aria-hidden="true"><span class="st-cap"></span><span class="st-glass"><span class="st-water"></span></span></div>
          <p class="st-out" aria-live="polite" data-tank-out>Plenty in store.</p>
          <Plate rows={[['Stores', 'Hot water in the tank'], ['Seen', 'Rheem 40 gal, Holdrite platform']]} size={10} kx={60} pitch={19} pad={12} shadow="pdeep" />
        </div>
      </article>
      <article class="st st-tl">
        <div class="st-ph"><Img name="tankless-pair" alt="Two tankless water heaters Glass mounted side by side on a brick wall" focus="55% 45%" sizes="(min-width:1280px) 260px, (min-width:768px) 24vw, 40vw" box={260 / 340} boxM={0.8} widths={[260, 400, 520, 780]} /></div>
        <div class="st-body">
          <h3 class="st-h">Tankless</h3>
          <p class="st-k">Heating now</p>
          <div class="st-seg" aria-hidden="true">{FIX.map((_, i) => <span class:list={['sg', i === 2 && 'sg-lim']}></span>)}<em>single unit</em></div>
          <p class="st-out" aria-live="polite" data-tl-out>One unit keeps up.</p>
          <Plate rows={[['Heats', 'Water on demand'], ['Seen', 'Rinnai RE199E pair']]} size={10} kx={60} pitch={19} pad={12} shadow="pdeep" />
        </div>
      </article>
    </div>
    <p class="ty-foot" data-t="3">Gas or electric matters too. Text a photo of your heater label and we tell you which fits on the call.</p>
  </div>
</section>

<script>
  // Tank: the stored level drops a step per fixture running. Tankless: one segment per fixture; past the third, a single
  // unit usually falls short, so the readout points to a pair. Words only, no numbers.
  const TANK = ['Full and waiting.', 'Plenty in store.', 'Draining faster.', 'Can run short on a long run.', 'Usually runs short.', 'Usually runs short.'];
  const TL = ['Off until a tap opens.', 'One unit keeps up.', 'One unit keeps up.', 'Near what one unit does.', 'A pair, like this one, usually covers it.', 'A pair, like this one, usually covers it.'];
  document.querySelectorAll<HTMLElement>('[data-ty]').forEach((ty) => {
    const st = ty.querySelector<HTMLElement>('.ty-st')!;
    const btns = [...ty.querySelectorAll<HTMLButtonElement>('.ty-b')];
    const segs = [...ty.querySelectorAll<HTMLElement>('.sg')];
    const tOut = ty.querySelector<HTMLElement>('[data-tank-out]')!, lOut = ty.querySelector<HTMLElement>('[data-tl-out]')!;
    const upd = () => {
      const n = btns.filter((b) => b.getAttribute('aria-pressed') === 'true').length;
      st.dataset.n = String(n);
      st.style.setProperty('--lv', String(1 - n * 0.17));
      segs.forEach((s, i) => s.classList.toggle('is-on', i < n));
      tOut.textContent = TANK[n]; lOut.textContent = TL[n];
    };
    btns.forEach((b) => b.addEventListener('click', () => { b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true')); upd(); }));
    upd();
  });
</script>

<style>
  .ty { background: var(--frost); padding: 110px 0 100px; }
  .ty-top { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .ty-h { margin-top: 16px; }
  .ty-lead { margin-top: 16px; font-size: 17px; color: var(--muted); }
  .ty-sw { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 30px; }
  .ty-b { display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 18px 0 12px; border: 0; border-radius: 24px; background: var(--white); color: var(--ink); box-shadow: inset 0 0 0 1.5px var(--ink); font: 700 15px/1 var(--f-b); cursor: pointer;
    transition: background-color .45s var(--ease-io), color .45s var(--ease-io), box-shadow .45s var(--ease-io); }
  .ty-b i { position: relative; width: 30px; height: 18px; border-radius: 9px; background: var(--frost2); box-shadow: inset 0 0 0 1.5px var(--ink); }
  .ty-b i::after { content: ''; position: absolute; left: 3px; top: 3px; width: 12px; height: 12px; border-radius: 50%; background: var(--ink); transition: translate .45s var(--ease-io), background-color .45s var(--ease-io); }
  .ty-b[aria-pressed='true'] { background: var(--ink); color: var(--white); box-shadow: inset 0 0 0 1.5px var(--ink), 4px 4px 0 var(--powder); }
  .ty-b[aria-pressed='true'] i { background: var(--powder); }
  .ty-b[aria-pressed='true'] i::after { translate: 12px 0; background: var(--white); }
  .ty-b:hover { box-shadow: inset 0 0 0 2px var(--pdeep); }
  .ty-b:focus-visible { outline: 3px solid var(--pdeep); outline-offset: 3px; }

  .ty-st { --lv: .83; display: grid; grid-template-columns: repeat(2, minmax(0, 560px)); justify-content: center; gap: 32px; margin-top: 40px; }
  .st { display: grid; grid-template-columns: 220px 1fr; gap: 24px; padding: 20px; background: var(--white); border-radius: 8px; box-shadow: inset 0 0 0 1.5px var(--ink), 10px 10px 0 var(--powder); }
  .st-ph { height: 300px; overflow: hidden; border-radius: 6px; box-shadow: inset 0 0 0 1.5px var(--ink); }
  .st-body { display: flex; flex-direction: column; gap: 10px; }
  .st-h { font-family: var(--f-h); font-weight: 800; font-size: 32px; letter-spacing: -.02em; color: var(--ink); }
  .st-k { font-family: var(--f-m); font-weight: 700; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--pdeep); }
  .st-out { min-height: 44px; font-weight: 700; font-size: 16px; line-height: 1.35; color: var(--ink); }
  /* Tank gauge: a lying housing whose water drops with --lv. */
  .st-tankg { display: flex; align-items: center; height: 44px; }
  .st-cap { width: 12px; height: 44px; border-radius: 4px 0 0 4px; background: var(--ink); }
  .st-glass { position: relative; flex: 1; height: 34px; overflow: hidden; border-radius: 0 17px 17px 0; background: var(--frost); box-shadow: inset 0 0 0 1.5px var(--ink); }
  .st-water { position: absolute; inset: 3px auto 3px 3px; width: calc((100% - 6px) * var(--lv)); border-radius: 0 14px 14px 0; background: var(--pdeep); transition: width .8s var(--ease-io); }
  /* Tankless meter: five segments, the third marked as where a single unit usually tops out. */
  .st-seg { position: relative; display: grid; grid-template-columns: repeat(5, 1fr); gap: 5px; height: 44px; padding-bottom: 12px; }
  .sg { border-radius: 4px; background: var(--frost); box-shadow: inset 0 0 0 1.5px var(--ink); transition: background-color .5s var(--ease-io); }
  .sg.is-on { background: var(--powder); }
  .sg.is-on:nth-child(n + 4) { background: var(--pdeep); }
  .sg-lim { position: relative; }
  .sg-lim::after { content: ''; position: absolute; right: -4px; top: -6px; bottom: -6px; width: 3px; background: var(--ink); }
  .st-seg em { position: absolute; left: 60%; bottom: -6px; translate: -50% 0; font-style: normal; font-family: var(--f-m); font-weight: 700; font-size: 9px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink); white-space: nowrap; }
  .ty-foot { max-width: 620px; margin: 36px auto 0; text-align: center; font-size: 16px; line-height: 1.5; color: var(--ink); }
  @media (prefers-reduced-motion: reduce) { .st-water, .sg, .ty-b, .ty-b i::after { transition: none; } }
  @media (min-width: 768px) and (max-width: 1279px) {
    .ty-st { grid-template-columns: 1fr; max-width: 620px; margin-inline: auto; }
  }
  @media (max-width: 767px) {
    .ty { padding: 60px 0 64px; }
    .ty-lead { font-size: 15px; }
    .ty-sw { gap: 8px; margin-top: 22px; }
    .ty-b { min-height: 44px; font-size: 14px; padding: 0 14px 0 10px; }
    .ty-st { grid-template-columns: 1fr; gap: 22px; margin-top: 26px; }
    .st { grid-template-columns: 116px 1fr; gap: 14px; padding: 14px; box-shadow: inset 0 0 0 1.5px var(--ink), 6px 6px 0 var(--powder); }
    .st-ph { height: 180px; }
    .st-h { font-size: 24px; }
    .st-out { font-size: 14px; min-height: 38px; }
  }
</style>
