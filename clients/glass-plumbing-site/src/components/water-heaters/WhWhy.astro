---
// Why Glass (Figma 719:437 y 5848 h 872 / mobile y 6191 h 954): four reasons with a proof panel. Tap or hover a reason: it
// fills ink and the panel swaps its photo and proof (cross-fade 0.4 s). Auto-advances every 6 s with a progress line, only
// while the section is in view; the Pause button stops it (WCAG 2.2.2), and so does any hover, focus or tap on a reason.
// DOM order is reason 1, panel 1, reason 2, panel 2 ... so phones show the open panel right under its reason; on desktop a
// grid puts every panel in the right column (stacked in one cell). Panel 03 is the Figma's; 01, 02 and 04 use site facts
// and reviews word for word (handoff/qa/services/REPORT.md). Starts on 03, the state the Figma shows.
import Eyebrow from '../kit/Eyebrow.astro';
import Housing from '../kit/Housing.astro';
import Plate from '../kit/Plate.astro';
import Img from '../ui/Img.astro';
import { SITE } from '../../data/site';
type Panel = {
  n: string; t: string; s: string; photo: string; alt: string; h: string; p: string; pm?: string; chips?: string[];
  plate: { title?: string; rows: [string, string | { text: string; href: string; external?: boolean }][] }; link: { text: string; href: string; external?: boolean };
};
const L = SITE.licence;
const R: Panel[] = [
  { n: '01', t: 'Licensed', s: `Florida ${L.number}, active.`, photo: 'business-card', alt: 'Kody Glass’s Glass Plumbing Services business card',
    h: 'Licensed.', p: `Florida certified plumbing contractor, licence ${L.number}, active until ${L.expires}. Licensed and insured.`,
    plate: { title: 'Florida DBPR lookup', rows: [['Licence', L.number], ['Type', 'Certified Plumbing Contractor'], ['Expires', L.expires]] },
    link: { text: 'Check it yourself →', href: L.url, external: true } },
  { n: '02', t: 'Next-day installs', s: 'From our reviews, not a promise for every job.', photo: 'van-night', alt: 'The Glass Plumbing van parked at night',
    h: 'Next-day installs.', p: 'From our reviews, not a promise for every job. One customer wrote: “called and had one installed the next day”.',
    plate: { title: 'From our reviews', rows: [['Install', 'Next day (Kevin K.)'], ['Estimate', 'Same day (Parker L.)']] },
    link: { text: 'All 16 reviews →', href: '/reviews' } },
  { n: '03', t: 'Tank and tankless', s: 'Single units and pairs.', photo: 'crew-water-heater-tank', alt: 'A Glass plumber with a new tank water heater',
    h: 'Tank and tankless.', p: 'Gas or electric, a single unit or a pair. Which one fits usually depends on how many bathrooms run at once.',
    pm: 'Gas or electric, single or paired. Size depends on how many bathrooms run at once.', chips: ['Tank', 'Tankless', 'Single', 'Paired'],
    plate: { title: 'From the job photos', rows: [['Brands', 'State, Rinnai'], ['Seen on', 'his own posts'], ['Install', 'Next day, often']] },
    link: { text: 'Tank vs tankless, explained ↑', href: '#types' } },
  { n: '04', t: 'Clean up after', s: 'Named in 2 of 16 reviews.', photo: 'shower-remodel', alt: 'A finished walk-in shower left clean',
    h: 'Clean up after.', p: 'Named in 2 of 16 reviews. One customer wrote: “He even went above and beyond to clean the bathroom spotless after!”',
    plate: { title: 'From our reviews', rows: [['Named in', '2 of 16 reviews'], ['Source', 'Google, read 17 Nov 2026']] },
    link: { text: 'All 16 reviews →', href: '/reviews' } },
];
const START = 2;
---
<section class="wy" data-m-section data-why>
  <div class="wrap wy-grid">
    <div class="wy-head">
      <Eyebrow text="Why Glass" />
      <h2 class="h2 wy-h" data-t="2" style="--h2:52px;--h2m:36px">Four reasons<br /><span class="tone">people call back.</span></h2>
    </div>
    <div class="wy-list" data-t="3">
      {R.map((r, i) => (
        <>
          <button class:list={['wy-r', i === START && 'on']} type="button" id={`wy-t-${r.n}`} aria-controls={`wy-p-${r.n}`}
            aria-expanded={i === START ? 'true' : 'false'} data-wy-r={i} style={`--o:${i}`}>
            <span class="wy-n">{r.n}</span>
            <span class="wy-tx"><span class="wy-t">{r.t}</span><span class="wy-s">{r.s}</span></span>
            <svg class="wy-ar" viewBox="0 0 18 14" width="18" height="14" aria-hidden="true" focusable="false"><path d="M1 7h16M11 1l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <i class="wy-prog" aria-hidden="true"></i>
          </button>
          <div class:list={['wy-p', i === START && 'on']} id={`wy-p-${r.n}`} role="region" aria-labelledby={`wy-t-${r.n}`} data-wy-p={i} style={`--o:${i}`} hidden={i !== START}>
            <Housing w={236} h={432} wm={120} hm={250} cap={30} capm={18} r={30} rm={20} tone="photo" class="wy-hs">
              {r.photo === 'business-card'
                ? <span class="wy-bc"><span class="wy-bcf"><Img name="business-card" alt={r.alt} sizes="(min-width:768px) 220px, 120px" fit="contain" widths={[240, 360, 480, 720]} /></span></span>
                : <Img name={r.photo} alt={r.alt} sizes="(min-width:768px) 236px, 120px" box={236 / 404} boxM={120 / 234} widths={[240, 360, 480, 720]} />}
            </Housing>
            <p class="wy-src">From the crew’s posts</p>
            <div class="wy-body">
              <p class="wy-k">{r.n} · Proof</p>
              <h3 class="wy-ph">{r.h}</h3>
              <p class="wy-pp">{r.pm ? <><span class="d">{r.p}</span><span class="m">{r.pm}</span></> : r.p}</p>
              {r.chips && <ul class="wy-chips" role="list">{r.chips.map((c) => <li>{c}</li>)}</ul>}
              <Plate class="wy-pl" title={r.plate.title} rows={r.plate.rows} shadow="powder" pad={12} size={10} tsize={12} kx={92} pitch={19} padm={10} sizem={9} tsizem={10} kxm={70} pitchm={18} t={false} />
              <a class="wy-link" href={r.link.href} {...(r.link.external ? { target: '_blank', rel: 'noopener' } : {})}>{r.link.text}{r.link.external && <span class="sr-only"> (opens in a new tab)</span>}</a>
            </div>
          </div>
        </>
      ))}
      <button class="wy-pause" type="button" aria-pressed="false" data-wy-pause>
        <i class="wy-pi" aria-hidden="true"></i><span data-wy-pause-label>Pause</span><span class="sr-only"> the rotating reasons</span>
      </button>
    </div>
  </div>
</section>
<style>
  /* The business-card photo is the front and back stacked (1385x1628): show the front face only, cropped to the card's own
     edges (front y 30-795, x 22-1363; same technique as home/Crew.astro), centred on ink so the logo is whole. */
  .wy-bc { position: absolute; inset: 0; display: grid; place-items: center; background: var(--ink); }
  .wy-bcf { position: relative; display: block; width: 90%; aspect-ratio: 1341 / 765; overflow: hidden; border-radius: 4px; rotate: -6deg; box-shadow: 6px 6px 0 var(--powder); }
  .wy-bcf :global(img) { position: absolute; left: -1.64%; top: -3.92%; width: 103.28%; height: auto; max-width: none; }
  .wy { background: var(--white); padding: 110px 0 120px; }
  .wy-grid { display: grid; grid-template-columns: 520px 620px; grid-template-areas: 'head .' 'list list'; justify-content: space-between; }
  .wy-head { grid-area: head; }
  .wy-h { margin-top: 16px; }
  .wy-list { grid-area: list; display: grid; grid-template-columns: 520px 620px; grid-template-rows: repeat(4, 92px) 1fr; row-gap: 12px; justify-content: space-between; margin-top: 40px; }
  .wy-r {
    grid-column: 1; grid-row: calc(var(--o) + 1); position: relative; display: flex; align-items: flex-start; gap: 34px; height: 92px; padding: 20px 24px; overflow: hidden;
    border: 0; border-radius: 6px; background: var(--white); box-shadow: inset 0 0 0 1.5px var(--frost3); text-align: left; cursor: pointer; color: var(--ink);
    transition: background-color .35s var(--ease-io), color .35s var(--ease-io), box-shadow .35s var(--ease-io);
  }
  .wy-r:hover { box-shadow: inset 0 0 0 1.5px var(--ink); }
  .wy-r.on { background: var(--ink); color: var(--white); box-shadow: 8px 8px 0 var(--powder); }
  .wy-r:focus-visible { outline: 3px solid var(--pdeep); outline-offset: 3px; }
  .wy-n { flex: none; width: 14px; margin-top: 18px; font-family: var(--f-m); font-weight: 700; font-size: 11px; line-height: 15px; letter-spacing: .06em; color: var(--pdeep); }
  .wy-r.on .wy-n { color: var(--powder); }
  .wy-tx { display: flex; flex-direction: column; gap: 9px; min-width: 0; }
  .wy-t { font-family: var(--f-h); font-weight: 800; font-size: 22px; line-height: 1.04; letter-spacing: -.02em; }
  .wy-s { font-size: 14px; line-height: 1.5; color: var(--muted); }
  .wy-r.on .wy-s { color: rgba(255,255,255,.8); }
  .wy-ar { position: absolute; right: 22px; top: 38px; opacity: 0; translate: -8px 0; transition: opacity .35s var(--ease-io), translate .35s var(--ease-io); }
  .wy-r.on .wy-ar { opacity: 1; translate: 0 0; }
  .wy-prog { position: absolute; left: 24px; right: 24px; bottom: 3px; height: 3px; background: var(--powder); transform-origin: 0 50%; scale: 0 1; }
  .wy-r.on .wy-prog { scale: var(--p, 0) 1; }

  .wy-p { grid-column: 2; grid-row: 1 / -1; align-self: start; position: relative; display: grid; grid-template-columns: 236px minmax(0, 1fr); column-gap: 32px; height: 520px; margin-top: -56px; padding: 44px 30px 18px 32px; border-radius: 8px; background: var(--frost); box-shadow: inset 0 0 0 1.5px var(--ink); }
  .wy-p[hidden] { display: none; }
  .wy-p :global(.wy-hs) { grid-column: 1; grid-row: 1; }
  .wy-src { grid-column: 1; grid-row: 2; margin-top: 14px; font-family: var(--f-m); font-weight: 500; font-size: 9px; line-height: 12px; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
  .wy-body { grid-column: 2; grid-row: 1 / 3; display: flex; flex-direction: column; align-items: flex-start; padding-top: 4px; }
  .wy-k { font-family: var(--f-m); font-weight: 700; font-size: 11px; line-height: 15px; letter-spacing: .06em; text-transform: uppercase; color: var(--pdeep); }
  .wy-ph { margin-top: 11px; font-family: var(--f-h); font-weight: 800; font-size: 32px; line-height: 1.04; letter-spacing: -.02em; }
  .wy-pp { margin-top: 17px; font-size: 16px; line-height: 1.5; color: var(--muted); }
  .wy-chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 22px 0 0; padding: 0; list-style: none; }
  .wy-chips li { height: 33px; padding: 0 14px; display: inline-flex; align-items: center; border-radius: 16.5px; background: var(--white); box-shadow: inset 0 0 0 1.2px var(--ink); font-weight: 600; font-size: 13px; line-height: 1.5; }
  .wy-body :global(.wy-pl) { width: 288px; max-width: 100%; margin-top: 25px; }
  .wy-link { margin-top: auto; padding: 11px 0; font-weight: 700; font-size: 15px; line-height: 1.5; color: var(--pdeep); }
  .wy-link:hover { text-decoration: underline; text-underline-offset: 3px; }

  .wy-pause { grid-column: 1; grid-row: 5; align-self: start; display: inline-flex; align-items: center; gap: 8px; width: max-content; min-height: 44px; margin-top: 4px; padding: 0 8px 0 0; border: 0; background: none; cursor: pointer; font-family: var(--f-m); font-weight: 700; font-size: 10px; line-height: 13px; letter-spacing: .06em; text-transform: uppercase; color: var(--ink); }
  .wy-pi { position: relative; width: 24px; height: 24px; border-radius: 50%; box-shadow: inset 0 0 0 1.4px var(--ink); }
  .wy-pi::before, .wy-pi::after { content: ''; position: absolute; top: 7px; width: 2.5px; height: 10px; background: var(--ink); }
  .wy-pi::before { left: 8px; } .wy-pi::after { left: 13.5px; }
  .wy-pause[aria-pressed='true'] .wy-pi::before { left: 9px; top: 7px; width: 0; height: 0; background: none; border-left: 8px solid var(--ink); border-top: 5px solid transparent; border-bottom: 5px solid transparent; }
  .wy-pause[aria-pressed='true'] .wy-pi::after { display: none; }
  .wy-pause:focus-visible { outline: 3px solid var(--pdeep); outline-offset: 2px; }
  html:not(.js) .wy-pause { display: none; }

  @media (min-width: 768px) and (max-width: 1279px) {
    .wy-grid, .wy-list { grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); column-gap: 32px; }
    .wy-p { grid-template-columns: 160px minmax(0, 1fr); column-gap: 20px; height: auto; min-height: 520px; padding: 32px 20px 18px; }
    .wy-p :global(.wy-hs) { width: 160px; height: 293px; }
    .wy-ph { font-size: 26px; }
  }
  @media (max-width: 767px) {
    .wy { padding: 64px 0 90px; }
    .wy-grid { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'head' 'list'; }
    .wy-h { margin-top: 12px; }
    .wy-list { display: flex; flex-direction: column; gap: 10px; margin-top: 24px; }
    .wy-r { height: auto; min-height: 72px; gap: 23px; padding: 14px 16px; }
    .wy-r.on { min-height: 80px; padding-top: 16px; box-shadow: 5px 5px 0 var(--powder); }
    .wy-n { margin-top: 14px; font-size: 10px; line-height: 13px; }
    .wy-tx { gap: 7px; }
    .wy-t { font-size: 18px; }
    .wy-s { font-size: 13px; }
    .wy-ar { display: none; }
    .wy-prog { left: 16px; right: 16px; }
    .wy-p { grid-template-columns: 120px minmax(0, 1fr); column-gap: 16px; height: auto; margin: 0 0 4px; padding: 28px 16px 16px; }
    .wy-p :global(.wy-hs) { grid-row: 1 / 3; }
    .wy-src { grid-column: 2; grid-row: 2; align-self: end; margin: 16px 0 0; }
    .wy-body { grid-row: 1; padding-top: 0; }
    .wy-k { display: none; }
    .wy-ph { margin-top: 0; font-size: 20px; }
    .wy-pp { margin-top: 10px; font-size: 13px; }
    .wy-chips { display: none; }
    .wy-body :global(.wy-pl) { width: 100%; margin-top: 20px; }
    .wy-body :global(.wy-pl .pl-title) { display: none; }
    .wy-body :global(.wy-pl .pl-title + .pl-rows) { margin-top: 0; }
    .wy-body :global(.wy-pl .pl-row:nth-child(n+3)) { display: none; }
    .wy-link { display: none; }
    .wy-pause { margin-top: -8px; }
  }
</style>
<script>
  const root = document.querySelector<HTMLElement>('[data-why]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-wy-r]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-wy-p]')];
    const pause = root.querySelector<HTMLButtonElement>('[data-wy-pause]')!;
    const label = root.querySelector<HTMLElement>('[data-wy-pause-label]')!;
    const motion = () => document.documentElement.classList.contains('motion');
    const DUR = 6000;
    let cur = tabs.findIndex((t) => t.classList.contains('on'));
    let paused = false, hovering = false, inView = false, t0 = 0, elapsed = 0, raf = 0;
    const show = (n: number, focus = false) => {
      if (n === cur) { if (focus) tabs[n].focus(); return; }
      const old = panels[cur], next = panels[n];
      tabs.forEach((t, i) => { const on = i === n; t.classList.toggle('on', on); t.setAttribute('aria-expanded', String(on)); t.style.removeProperty('--p'); });
      if (focus) tabs[n].focus();
      cur = n; elapsed = 0; t0 = performance.now();
      next.hidden = false; next.classList.add('on');
      if (motion()) {
        next.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 400, easing: 'ease-in-out' });
        const a = old.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 400, easing: 'ease-in-out' });
        old.style.zIndex = '0'; next.style.zIndex = '1';
        // Phones show the panel under its reason (in the flow), so the old one must leave at once there.
        if (getComputedStyle(old).gridColumnStart !== '2') { a.cancel(); old.hidden = true; old.classList.remove('on'); }
        else a.onfinish = () => { if (cur !== +old.dataset.wyP!) { old.hidden = true; old.classList.remove('on'); } };
      } else { old.hidden = true; old.classList.remove('on'); }
    };
    const tick = (now: number) => {
      raf = 0;
      if (paused || hovering || !inView) return;
      elapsed += now - t0; t0 = now;
      const p = Math.min(1, elapsed / DUR);
      tabs[cur].style.setProperty('--p', String(p));
      if (p >= 1) show((cur + 1) % tabs.length);
      raf = requestAnimationFrame(tick);
    };
    const run = () => { if (!raf && !paused && !hovering && inView) { t0 = performance.now(); raf = requestAnimationFrame(tick); } };
    const stop = (user = false) => {
      if (user) { paused = true; pause.setAttribute('aria-pressed', 'true'); label.textContent = 'Play'; tabs[cur].style.removeProperty('--p'); }
      cancelAnimationFrame(raf); raf = 0;
    };
    pause.addEventListener('click', () => {
      if (paused) { paused = false; pause.setAttribute('aria-pressed', 'false'); label.textContent = 'Pause'; elapsed = 0; run(); } else stop(true);
    });
    tabs.forEach((b, i) => {
      b.addEventListener('click', () => { stop(true); show(i); });
      b.addEventListener('mouseenter', () => { if (matchMedia('(hover: hover) and (pointer: fine)').matches) { hovering = true; stop(); show(i); } });
      b.addEventListener('mouseleave', () => { hovering = false; elapsed = 0; run(); });
      b.addEventListener('keydown', (e) => {
        let n = -1;
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') n = (i + 1) % tabs.length; else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') n = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') n = 0; else if (e.key === 'End') n = tabs.length - 1;
        if (n < 0) return; e.preventDefault(); stop(true); show(n, true);
      });
    });
    // Reduced motion: no auto-advance at all (nothing moves on its own); the reasons still switch on tap.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      new IntersectionObserver((es) => es.forEach((e) => { inView = e.isIntersecting; if (inView) run(); else stop(); }), { threshold: 0.35 }).observe(root);
    } else { pause.hidden = true; }
  }
</script>
