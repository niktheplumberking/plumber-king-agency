---
// Why Glass, fix round 3 (E, RECHECK MAJOR 8: four reason buttons + a proof panel on a 6 s autoplay). New idea, THE
// LEAFLET: the four reasons are the four panels of one folded paper leaflet. It arrives folded flat like a zig-zag
// (accordion fold) and opens as the section scrolls: one custom property (--f, 1 = folded, 0 = open) is scrubbed by the
// scroll (kit/scrub.ts data-scrub-tw) and every panel turns on its crease from it (rotateY on desktop, rotateX on phones,
// where the panels stack). Each panel holds its proof: the DBPR licence, review counts with a quote word for word
// ("3 of the 16 reviews we hold mention the next day"; cleaning up: 2 of 16, Jacob Gars + Michael Marks), and the job
// photos' brands. No autoplay any more, so nothing moves on its own.
// 21st.dev: shadcnspace "Origami Fold" (panels that fold on creases) + kedhareswer "3D fold" (scroll-driven unfold),
// rebuilt as CSS 3D + the kit scrub engine, re-skinned as a Glass leaflet: white / frost paper, ink hairline, powder shadow.
// No JS / reduced motion: the leaflet shows open (--f: 0), every panel flat and readable.
import Eyebrow from '../kit/Eyebrow.astro';
import { SITE } from '../../data/site';
import { quote } from '../areas/reviews';
const L = SITE.licence;
const R = [
  { n: '01', t: 'Licensed', p: `Florida certified plumbing contractor, licence ${L.number}, active until ${L.expires}.`, q: '', by: '',
    link: { text: 'Check it on DBPR', href: L.url, ext: true }, g: 'M12 2l7 3v6c0 5-3 8-7 10-4-2-7-5-7-10V5zM8.5 12l2.5 2.5 4.5-5' },
  { n: '02', t: 'The next day, often', p: 'Not promised for every job: 3 of the 16 reviews we hold mention the next day.', q: quote('Kevin Kelleman', 'called and had one installed the next day'), by: 'Kevin Kelleman · Google',
    link: { text: 'Read the reviews', href: '/reviews' }, g: 'M4 6h16v14H4zM4 10h16M8 3v5M16 3v5M9 15l2 2 4-4' },
  { n: '03', t: 'Tank and tankless', p: 'Gas or electric, a single unit or a pair. State and Rinnai units show in the crew’s own job posts.', q: '', by: '',
    link: { text: 'Tank or tankless, above', href: '#types' }, g: 'M8 3h8v16a2 2 0 0 1-2 2h-4a2 2 0 0 1-2-2zM7 3h10M12 8v8' },
  { n: '04', t: 'Clean up after', p: 'Cleaning up is named in 2 of the 16 reviews we hold.', q: quote('Jacob Gars', 'He even went above and beyond to clean the bathroom spotless after!'), by: 'Jacob Gars · Google',
    link: { text: 'Read the reviews', href: '/reviews' }, g: 'M14 3l-4 10M6 13h12l-1 8H7zM9 17v2M12 17v2M15 17v2' },
];
---
<section class="wy" data-m-section aria-labelledby="wy-h">
  <div class="wrap">
    <div class="wy-top">
      <Eyebrow text="Why Glass" />
      <h2 class="h2 wy-h" id="wy-h" data-t="2" style="--h2:52px;--h2m:32px">Four reasons,<br /><span class="tone">one leaflet. Open it.</span></h2>
      <p class="wy-lead" data-t="3">Scroll and it unfolds. Each panel carries its proof.</p>
    </div>
    <div class="lf-w" data-scrub data-start="top 85%" data-end="center 55%" data-start-m="top 90%" data-end-m="bottom 70%" data-t="4">
      <ol class="lf" role="list" data-scrub-tw='{"--f":1}'>
        {R.map((r, i) => (
          <li class="lf-p" style={`--k:${i}`}>
            <svg class="lf-g" viewBox="0 0 24 24" aria-hidden="true"><path d={r.g} /></svg>
            <p class="lf-n">Reason {r.n}</p>
            <h3 class="lf-t">{r.t}</h3>
            <p class="lf-d">{r.p}</p>
            {r.q && <blockquote class="lf-q"><p>“{r.q}”</p><footer>{r.by}</footer></blockquote>}
            <a class="lf-a" href={r.link.href} {...(r.link.ext ? { target: '_blank', rel: 'noopener' } : {})}>{r.link.text} →{r.link.ext && <span class="sr-only"> (opens in a new tab)</span>}</a>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .wy { background: var(--white); padding: 110px 0 120px; overflow-x: clip; }
  .wy-top { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .wy-h { margin-top: 16px; }
  .wy-lead { margin-top: 16px; font-size: 17px; color: var(--muted); }
  .lf-w { margin-top: 48px; }
  /* --f: 1 folded, 0 open. Panels alternate their crease direction, so the strip zig-zags like a folded leaflet. */
  .lf { --f: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); max-width: 1120px; margin: 0 auto; padding: 0; list-style: none; perspective: 1600px; filter: drop-shadow(10px 10px 0 var(--powder)); }
  .lf-p { position: relative; display: flex; flex-direction: column; align-items: flex-start; min-height: 400px; padding: 30px 24px 24px; background: var(--white); box-shadow: inset 0 0 0 1.5px var(--ink); color: var(--ink);
    transform-origin: calc(50% + (50% * var(--s, 1))) 50%; --s: 1;
    transform: rotateY(calc(var(--f) * 72deg * var(--d, 1))) translateX(calc(var(--f) * var(--k) * -40%)); }
  .lf-p:nth-child(odd) { --d: 1; } .lf-p:nth-child(even) { --d: -1; background: var(--frost); }
  .lf-p:first-child { border-radius: 8px 0 0 8px; } .lf-p:last-child { border-radius: 0 8px 8px 0; }
  .lf-p::after { content: ''; position: absolute; inset: 0; pointer-events: none; border-radius: inherit; background: linear-gradient(90deg, rgb(22 19 15 / calc(var(--f) * .22)), transparent 60%); }
  .lf-p:nth-child(even)::after { background: linear-gradient(270deg, rgb(22 19 15 / calc(var(--f) * .22)), transparent 60%); }
  .lf-p + .lf-p { margin-left: -1.5px; }
  .lf-g { width: 44px; height: 44px; fill: none; stroke: var(--pdeep); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .lf-n { margin-top: 18px; font: 700 11px/1.2 var(--f-m); letter-spacing: .1em; text-transform: uppercase; color: var(--pdeep); }
  .lf-t { margin-top: 8px; font: 800 26px/1.05 var(--f-h); letter-spacing: -.02em; }
  .lf-d { margin-top: 12px; font-size: 15px; line-height: 1.5; }
  .lf-q { margin: 16px 0 0; padding: 12px 14px; border-radius: 4px; background: var(--steel); box-shadow: inset 0 0 0 1px var(--steel2); }
  .lf-q p { font-weight: 700; font-size: 15px; line-height: 1.4; }
  .lf-q footer { margin-top: 6px; font: 500 10px/1.3 var(--f-m); letter-spacing: .04em; color: rgb(22 19 15 / .75); }
  .lf-a { display: inline-flex; align-items: center; min-height: 44px; margin-top: auto; padding-top: 12px; font-weight: 700; font-size: 15px; color: var(--pdeep); }
  .lf-a:hover { text-decoration: underline; text-underline-offset: 3px; }
  @media (min-width: 768px) and (max-width: 1279px) {
    .lf { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 720px; }
    .lf-p { min-height: 360px; }
    .lf-p:nth-child(1) { border-radius: 8px 0 0 0; } .lf-p:nth-child(2) { border-radius: 0 8px 0 0; }
    .lf-p:nth-child(3) { border-radius: 0 0 0 8px; margin-left: 0; margin-top: -1.5px; } .lf-p:nth-child(4) { border-radius: 0 0 8px 0; margin-top: -1.5px; }
    .lf-p { transform: rotateY(calc(var(--f) * 60deg * var(--d, 1))); }
  }
  @media (max-width: 767px) {
    .wy { padding: 60px 0 64px; }
    .wy-lead { font-size: 15px; }
    .lf-w { margin-top: 28px; }
    .lf { perspective: 1000px; }
    .lf { grid-template-columns: minmax(0, 1fr); filter: drop-shadow(6px 6px 0 var(--powder)); }
    .lf-p { min-height: 0; padding: 20px 18px 14px; transform-origin: 50% 0; transform: rotateX(calc(var(--f) * -70deg * var(--d, 1))); }
    .lf-p + .lf-p { margin-left: 0; margin-top: -1.5px; }
    .lf-p:first-child { border-radius: 8px 8px 0 0; } .lf-p:last-child { border-radius: 0 0 8px 8px; }
    .lf-p::after, .lf-p:nth-child(even)::after { background: linear-gradient(180deg, rgb(22 19 15 / calc(var(--f) * .22)), transparent 60%); }
    .lf-g { width: 34px; height: 34px; }
    .lf-n { margin-top: 10px; }
    .lf-t { font-size: 22px; }
    .lf-d, .lf-q p { font-size: 14px; }
  }
</style>
