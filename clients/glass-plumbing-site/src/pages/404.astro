---
// 404. No Figma frame: built from the Glass system (white page, eyebrow, two-tone H1, an empty housing, the hero button
// pair, mono link list). Loader off, noindex. Every link hits a built route.
import Base from '../layouts/Base.astro';
import Btn from '../components/kit/Btn.astro';
import Eyebrow from '../components/kit/Eyebrow.astro';
import Housing from '../components/kit/Housing.astro';
import { SITE } from '../data/site';
const links = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/services/water-heaters', label: 'Water heaters' },
  { href: '/areas', label: 'Areas we cover' },
  { href: '/reviews', label: 'Reviews' },
  { href: '/faq', label: 'FAQ' },
  { href: '/contact', label: 'Contact' },
];
---
<Base title={`Page not found | ${SITE.name}`} description="That page isn't here. Call or text Glass Plumbing Services in Largo, FL, or head back to the home page." path="/404" noindex loader={false}>
  <section class="nf" data-m-section data-m-hero>
    <div class="wrap nf-in">
      <div class="nf-copy">
        <Eyebrow text="Error 404 · Wrong line" />
        <h1 class="h1 nf-h" data-t="2">This pipe runs <span class="tone">dry.</span></h1>
        <p class="lead nf-p" data-t="3">The page you were after isn't here. If water is where it shouldn't be, skip the menus: close your main shut-off valve and call us.</p>
        <div class="nf-cta" data-t="3">
          <Btn sub="Call now · 24/7" size="l" w={280} wm={350} />
          <Btn look="line" icon="camera" label="Text us a photo" sub={`To ${SITE.phone}`} arrow size="l" w={280} wm={350} />
        </div>
        <nav class="nf-links" aria-label="Popular pages" data-t="3">
          <p class="mono-b nf-lh">Or try one of these</p>
          <ul role="list">{links.map((l) => <li><a href={l.href}>{l.label}<span aria-hidden="true"> →</span></a></li>)}</ul>
        </nav>
      </div>
      <div class="nf-art" data-t="4">
        <Housing w={240} h={340} wm={150} hm={212} fill={0.06} shadow={12} shadowm={8} label="An empty filter housing: nothing here" />
      </div>
    </div>
  </section>
</Base>
<style>
  .nf { background: var(--white); }
  .nf-in { display: grid; grid-template-columns: minmax(0, 1fr) 360px; align-items: center; gap: 48px; padding: 96px 0 120px; }
  .nf-h { margin-top: 32px; }
  .nf-p { max-width: 560px; margin-top: 24px; }
  .nf-cta { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 32px; }
  .nf-links { margin-top: 48px; }
  .nf-lh { color: var(--muted); }
  .nf-links ul { display: flex; flex-wrap: wrap; gap: 4px 24px; margin: 12px 0 0; padding: 0; list-style: none; }
  .nf-links a { display: inline-block; padding: 10px 0; font-weight: 600; font-size: 16px; line-height: 24px; text-decoration: underline; text-decoration-color: var(--powder); text-decoration-thickness: 2px; text-underline-offset: 6px; transition: color .25s, text-decoration-color .25s; }
  .nf-links a:hover { color: var(--pdeep); text-decoration-color: var(--pdeep); }
  .nf-art { display: grid; place-items: center; }
  @media (max-width: 1023px) { .nf-in { grid-template-columns: 1fr; } .nf-art { justify-items: start; } }
  @media (max-width: 767px) {
    .nf-in { padding: 32px 0 64px; gap: 40px; }
    .nf-h { margin-top: 16px; }
    .nf-p { margin-top: 16px; }
    .nf-cta { margin-top: 24px; gap: 12px; }
    .nf-cta :global(.btn) { width: 100%; }
    .nf-art { order: -1; }
  }
</style>
