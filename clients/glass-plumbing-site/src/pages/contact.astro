---
// /contact (Figma 724:1091 desktop, 725:701 mobile). ContactPage + BreadcrumbList + FAQPage (the three flip cards).
// The form is data-estimate-form (forms.ts) at #estimate (the mobile call bar's "Free estimate" target).
import Base from '../layouts/Base.astro';
import ConHero from '../components/contact/ConHero.astro';
import ConWays from '../components/contact/ConWays.astro';
import ConForm from '../components/contact/ConForm.astro';
import ConShop from '../components/contact/ConShop.astro';
import ConOther from '../components/contact/ConOther.astro';
import ConFaq from '../components/contact/ConFaq.astro';
import TownsStrip from '../components/global/TownsStrip.astro';
import { contactPageSchema } from '../lib/schema';
import { crumbsLd, faqLd } from '../components/contact/ld';
import { CONTACT_FAQ } from '../components/contact/faqs';
const path = '/contact';
---
<Base title="Contact Glass Plumbing Services · Largo, FL"
  description="Call or text (727) 512-0673, 24/7 for emergencies, or send the job with a photo. Glass Plumbing Services, Largo, FL. All of Pinellas County."
  path={path} og="van-night" ogAlt="The Glass Plumbing Services van with the phone number on its side"
  jsonld={[contactPageSchema(path), crumbsLd('Contact', path), faqLd(CONTACT_FAQ)]} estimate="#estimate">
  <ConHero />
  <ConWays />
  <ConForm />
  <ConShop />
  <ConOther />
  <ConFaq />
  <TownsStrip />
</Base>
