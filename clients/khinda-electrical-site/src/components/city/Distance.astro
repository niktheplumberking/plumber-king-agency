---
// 5.2 Distance (Figma 785:518, 1440x800 white; mobile 793:475). The real Google Maps screenshot with a cable from the
// Surrey base pin to the town (STATES 5.2: the cable draws itself as the section scrolls in; when it arrives the town
// marker pops and the heat-shrink tag lands on the cable). Newton uses the Figma cable; the other towns get the same
// cable drawn in code from the base pin to the town's spot on the screenshot. The tag reads SAME CITY in Surrey and
// NEXT CITY for Delta, Langley and White Rock (no drive distance until Khinda confirms his base).
import Eyebrow from '../kit/Eyebrow.astro';
import Btn from '../kit/Btn.astro';
import Tape from '../kit/Tape.astro';
import Img from '../ui/Img.astro';
import Obj from '../p3/Obj.astro';
import routeD from '../../art/p3/05/route-d.svg?raw';
import bpin from '../../art/p3/05/bpin-d.svg?raw';
import tpin from '../../art/p3/05/tpin-d.svg?raw';
import { SITE } from '../../data/site';
import type { TownData } from '../../data/towns';
interface Props { d: TownData }
const { d } = Astro.props;
const S = { x: 345, y: 130 };
const E = d.newton ? { x: 339, y: 300 } : d.pt;
const dx = E.x - S.x, dy = E.y - S.y;
const c1 = { x: S.x + dx * 0.2 + 110, y: S.y + dy * 0.2 + 20 };
const c2 = { x: E.x + 110, y: E.y - dy * 0.3 - 30 };
const P = `M${S.x} ${S.y}C${c1.x.toFixed(1)} ${c1.y.toFixed(1)} ${c2.x.toFixed(1)} ${c2.y.toFixed(1)} ${E.x} ${E.y}`;
const b = (t: number, a: number, p: number, q: number, e: number) => (1 - t) ** 3 * a + 3 * (1 - t) ** 2 * t * p + 3 * (1 - t) * t * t * q + t ** 3 * e;
const M = { x: b(0.5, S.x, c1.x, c2.x, E.x), y: b(0.5, S.y, c1.y, c2.y, E.y) };
const der = (a: number, p: number, q: number, e: number) => 0.75 * (p - a) + 1.5 * (q - p) + 0.75 * (e - q);
let ang = (Math.atan2(der(S.y, c1.y, c2.y, E.y), der(S.x, c1.x, c2.x, E.x)) * 180) / Math.PI;
if (ang > 90) ang -= 180; if (ang < -90) ang += 180;
const tag = d.newton ? { x: 432, y: 264, r: 62 } : { x: M.x, y: M.y, r: ang };
const lw = 240, lx = Math.max(12, Math.min(700 - lw - 12, E.x - 170)), ly = Math.min(520 - 50, E.y + 18);
const pc = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
const rows = [['Base', 'Surrey, BC'], [d.N, d.where], ['Permits', d.issuer]];
---
<section class="c2 sec p3s" style="--h:800px" data-m-section aria-labelledby="c2-h">
  <div class="c2-l ab" style="--x:120px;--y:170px;--w:440px">
    <Eyebrow text="Distance from the base" data-t="1" />
    <h2 class="h2 c2-h" id="c2-h" data-t="2"><span class="l1">From the Surrey base</span><span class="l2">to your street.</span></h2>
    <p class="lede c2-p" data-t="3">{d.surrey ? `${d.N} sits inside Surrey, the same city he works out of. Same permit office, same code, no crossing into another town.` : `${d.N} is the next city over from his Surrey base. Same code across BC; the electrical permit there comes from Technical Safety BC.`}</p>
    <dl class="c2-rows" data-t="4">{rows.map(([k, v]) => <div><dt class="tech">{k}</dt><dd>{v}</dd></div>)}</dl>
    <div class="c2-b" data-t="3"><Btn v="call" main={`Call from ${d.N}`} sub={`${SITE.phone} · tap to call`} /><a class="lk c2-lk" href={SITE.sms}>Text a photo →</a></div>
  </div>
  <div class="c2-map ab" style="--x:620px;--y:170px" data-t="4">
    <div class="c2-img" data-fx="frame"><div class="c2-iw"><Img name="google-maps-surrey-bc-base" alt={`Google Maps screenshot of Surrey, BC, with the route from the Surrey base to ${d.N}`} sizes="(min-width: 1024px) 1040px, 520px" box={2} boxM={2} /></div></div>
    {d.newton
      ? <Obj svg={routeD} class="c2-route" data-draw="" data-start="top 75%" data-end="top 25%" />
      : <div class="obj c2-route" aria-hidden="true" data-draw="" data-start="top 75%" data-end="top 25%"><svg viewBox="0 0 700 520" fill="none" stroke-linecap="round" stroke-linejoin="round"><path class="cd" d={P} stroke="#0A0B22" stroke-opacity=".55" stroke-width="12" /><path class="cd" d={P} stroke="#C8362F" stroke-width="9" /><path class="cd" d={P} stroke="#fff" stroke-opacity=".35" stroke-width="1.6" /></svg></div>}
    <span class="c2-hs tech" style={`left:${pc(tag.x, 700)};top:${pc(tag.y, 520)};--r:${tag.r.toFixed(1)}deg`} aria-hidden="true">{d.surrey ? 'Same city' : 'Next city'}</span>
    <span class="c2-bp" style={`left:${pc(331, 700)};top:${pc(116, 520)}`} aria-hidden="true"><Fragment set:html={bpin} /></span>
    <span class="c2-tp" style={`left:${pc(E.x - 16, 700)};top:${pc(E.y - 16, 520)}`} aria-hidden="true" data-fx="pop"><Fragment set:html={tpin} /></span>
    <span class="c2-lb tech" style={`left:${pc(367, 700)};top:${pc(92, 520)}`}>Base · Surrey</span>
    <span class="c2-lt tech" style={`left:${pc(lx, 700)};top:${pc(ly, 520)}`}>{d.N} · your street</span>
    <Tape text={d.surrey ? `${d.N} is Surrey.` : 'Next door to Surrey.'} rot={4} size={17.6} class="c2-tape dn-d" />
  </div>
</section>
<style>
  .c2 { background: #fff; z-index: 2; }
  .c2-h { margin: 15px 0 0 -4px; }
  .c2-p { margin-top: 24px; color: var(--ink); }
  .c2-rows { margin-top: 39px; border-top: 1px solid var(--line); }
  .c2-rows div { display: flex; align-items: baseline; height: 46px; padding-top: 12px; border-bottom: 1px solid var(--line); }
  .c2-rows dt { width: 130px; font-size: 10px; line-height: 14px; letter-spacing: .1em; color: var(--steel); }
  .c2-rows dd { margin: 0; font-weight: 600; font-size: 16px; line-height: 20px; color: var(--ink); }
  .c2-b { display: flex; align-items: center; gap: 53px; margin-top: 35px; }
  .c2-map { width: 700px; height: 520px; border-radius: 14px; box-shadow: 0 0 0 8px var(--panel), 0 14px 30px 8px rgba(13, 15, 51, .25); background: var(--deep); }
  .c2-img { position: absolute; inset: 0; overflow: hidden; border-radius: 14px; }
  .c2-iw { position: absolute; left: -24.286%; top: 0; width: 148.571%; height: 100%; }
  .c2 :global(.c2-route) { position: absolute; inset: 0; width: 100%; }
  .c2 :global(.c2-route svg) { width: 100%; height: 100%; }
  .c2-hs { position: absolute; z-index: 2; width: 130px; height: 30px; margin: -15px 0 0 -65px; background: var(--c-yellow); border-radius: 4px; box-shadow: 0 3px 6px rgba(13, 15, 51, .3); font-size: 10px; line-height: 30px; text-align: center; color: var(--ink); transform: rotate(var(--r)); }
  .c2-bp, .c2-tp { position: absolute; z-index: 3; width: 4%; }
  .c2-bp { width: 4%; } .c2-tp { width: 4.571%; }
  .c2-bp :global(svg), .c2-tp :global(svg) { display: block; width: 100%; height: auto; }
  .c2-lb, .c2-lt { position: absolute; z-index: 3; padding: 7px 10px; border-radius: 5px; font-size: 10px; line-height: 14px; letter-spacing: .1em; white-space: nowrap; }
  .c2-lb { background: var(--deep); color: #fff; }
  .c2-lt { padding: 9px 12px; background: var(--amber); color: var(--ink); font-size: 11px; line-height: 16px; }
  @media (max-width: 1023px) {
    .c2 { display: flex; flex-direction: column; padding: 110px 20px 64px; }
    .c2-l { display: contents; }
    .c2-map { order: 5; }
    .c2-b { order: 6; }
    .c2-h { margin: 14px 0 0; font-size: 32px; line-height: 36px; }
    .c2-p { margin-top: 16px; }
    .c2-rows { margin-top: 24px; }
    .c2-rows div { height: 37px; padding-top: 10px; }
    .c2-rows dt { width: 103px; font-size: 11px; line-height: 16px; }
    .c2-rows dd { font-size: 13px; line-height: 16px; }
    .c2-b { flex-direction: column; align-items: flex-start; gap: 16px; margin-top: 28px; }
    .c2-map { position: relative; margin-top: 28px; width: 100%; height: auto; aspect-ratio: 700 / 520; border-radius: 7px; box-shadow: 0 0 0 4px var(--panel), 0 7px 15px 4px rgba(13, 15, 51, .25); }
    .c2-img { border-radius: 7px; }
    .c2-hs { width: 106px; height: 25px; margin: -12px 0 0 -53px; line-height: 25px; font-size: 9px; letter-spacing: .06em; }
    .c2-lb, .c2-lt { padding: 4px 7px; font-size: 9px; line-height: 14px; letter-spacing: .06em; }
    .c2 :global(.c2-tape) { position: absolute; left: 10px; top: -22px; z-index: 4; }
  }
</style>
