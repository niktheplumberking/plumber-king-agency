---
// 5.5 Neighbourhoods (Figma 787:437, 1440x640 white; mobile 794:437). Newton only (the Figma names its 7 areas); other
// towns have no confirmed area list, so the section is left out there. A wire-marker card with one write-on marker per
// area; STATES 5.5: hover / tap peels a marker a few degrees with a deeper shadow, the others stay flat.
import Eyebrow from '../kit/Eyebrow.astro';
import Btn from '../kit/Btn.astro';
import { SITE } from '../../data/site';
import type { TownData } from '../../data/towns';
interface Props { d: TownData }
const { d } = Astro.props;
const H = d.hoods ?? [];
---
<section class="c5 sec p3s" style="--h:640px" data-m-section aria-labelledby="c5-h">
  <div class="ab" style="--x:120px;--y:100px">
    <Eyebrow text={`Neighbourhoods in ${d.N}`} data-t="1" />
    <h2 class="h2 c5-h" id="c5-h" data-t="2"><span class="l1">{d.N}, street by street.</span><span class="l2">Marked like his wires.</span></h2>
  </div>
  <div class="c5-r ab" style="--x:820px;--y:138px;--w:480px" data-t="3">
    <p class="lede c5-p">The {d.N} areas he covers, each on its own wire marker. Not sure your street counts? Call and ask.</p>
    <a class="lk c5-lk" href={SITE.tel}>Call {SITE.phone} →</a>
  </div>
  <div class="c5-card ab" style="--x:120px;--y:286px" data-t="4">
    <p class="c5-hd tech"><span>Wire markers · {d.N} · {H.length}<span class="dn-m"> areas</span></span><span class="dn-m">Khinda Electrical</span></p>
    <ul class="c5-tags" role="list" data-stagger>
      {H.map((h, i) => <li class="c5-t" tabindex="0" data-t="5"><span class="tech">NW-0{i + 1}</span><b>{h}</b></li>)}
      <li class="c5-t c5-x dn-d"><a href={SITE.tel}><span class="tech">Street not here?</span><b class="c5-xc">Call {SITE.phone}</b></a></li>
    </ul>
  </div>
  <div class="ab" style="--x:120px;--y:530px" data-t="3"><Btn v="call" sub="Is my street on it?" /></div>
</section>
<style>
  .c5 { background: #fff; }
  .c5-h { margin: 15px 0 0 -4px; }
  .c5-p { color: var(--ink); }
  .c5-lk { margin-top: 30px; }
  .c5-card { width: 1200px; height: 212px; background: var(--panel); border: 1.5px solid var(--mist); border-radius: 10px; box-shadow: 0 8px 20px rgba(13, 15, 51, .14); overflow: visible; }
  .c5-hd { display: flex; justify-content: space-between; height: 38px; margin: -1.5px -1.5px 0; padding: 11px 24px 0; background: var(--indigo); border-radius: 10px 10px 0 0; font-size: 11px; line-height: 16px; color: #fff; }
  .c5-hd span + span { color: var(--mist); }
  .c5-tags { display: flex; gap: 14px; margin: 0; padding: 18px 0 0 32px; list-style: none; }
  .c5-t { position: relative; display: flex; flex-direction: column; align-items: center; width: 150px; height: 128px; padding: 16px 8px 0; background: #fff; border: 1px solid var(--mist); border-radius: 6px; text-align: center; cursor: default; transform-origin: 20% 0; transition: transform .45s var(--ease-back), box-shadow .35s; }
  .c5-t .tech { font-size: 11px; line-height: 16px; color: var(--steel); }
  .c5-t .tech::after { content: ''; display: block; width: 110px; height: 1px; margin: 10px auto 0; background: var(--line); }
  .c5-t b { display: flex; align-items: center; flex: 1; padding-bottom: 10px; font-family: var(--f-marker); font-weight: 400; font-size: 18px; line-height: 22px; color: var(--ink); }
  .c5-t:hover, .c5-t:focus-visible { z-index: 2; transform: rotate(7deg) translateY(-16px); box-shadow: 0 14px 24px rgba(13, 15, 51, .28); }
  @media (max-width: 1023px) {
    .c5 { padding: 64px 20px; }
    .c5-h { margin: 14px 0 0; font-size: 28px; line-height: 31px; }
    .c5-p { margin-top: 16px; }
    .c5-lk { margin-top: 12px; }
    .c5-card { width: auto; height: auto; margin-top: 20px; padding-bottom: 16px; }
    .c5-hd { height: 32px; padding: 8px 14px 0; }
    .c5-tags { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; padding: 12px 12px 0; }
    .c5-t { width: auto; height: 84px; padding-top: 10px; }
    .c5-t .tech::after { margin-top: 6px; }
    .c5-t b { font-size: 15px; line-height: 18px; padding-bottom: 6px; }
    .c5-x { border-style: dashed; border-color: var(--steel); background: transparent; }
    .c5-x .c5-xc { font-family: var(--f-sans); font-weight: 600; font-size: 12px; }
    .c5-x a { display: flex; flex-direction: column; align-items: center; width: 100%; height: 100%; }
    .c5 .ab:last-child { margin-top: 34px; }
  }
</style>
