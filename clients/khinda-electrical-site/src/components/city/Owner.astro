---
// 5.9 Owner band (Figma 788:475, 1440x660 panel; mobile 794:674). His own photo in a cover plate (layer 1), a tape label
// (layer 2) and the "from his Instagram" strip (layer 3). STATES 5.9: the three layers shift toward the pointer at
// different depths (-10 / +18 / +30 px). No van, no lettering. Mobile: static.
import Eyebrow from '../kit/Eyebrow.astro';
import Btn from '../kit/Btn.astro';
import Screw from '../kit/Screw.astro';
import Img from '../ui/Img.astro';
import { SITE } from '../../data/site';
import { PHOTO, type TownData } from '../../data/towns';
interface Props { d: TownData }
const { d } = Astro.props;
const ph = PHOTO[d.set.band];
---
<section class="c9 sec p3s" style="--h:660px" data-m-section aria-labelledby="c9-h">
  <div class="c9-l ab" style="--x:120px;--y:140px;--w:500px">
    <Eyebrow text={`One electrician · ${d.N}`} data-t="1" />
    <h2 class="h2 c9-h" id="c9-h" data-t="2"><span class="l1">One Surrey electrician.</span><span class="l2">{d.N} included.</span></h2>
    <p class="lede c9-p" data-t="3">Khinda Electrical is a Surrey electrician who posts his own jobs: rough-ins, finished panels, chandeliers and shop fit-outs. On YouTube since January 2018.</p>
    <div class="c9-b" data-t="3"><Btn v="call" main={`Call about a ${d.N} job`} sub={`${SITE.phone} · tap to call`} /><a class="lk" href="/about/">About Khinda →</a></div>
  </div>
  <div class="c9-par ab" style="--x:640px;--y:128px" data-t="4" data-par3>
    <div class="c9-plate" data-depth="-10">
      <div class="c9-ph" data-fx="frame"><Img name={ph.name} alt={ph.alt} sizes="(min-width: 1024px) 612px, calc(100vw - 55px)" box={612 / 372} boxM={335 / 215} /></div>
      <Screw s={10} rot={30} class="c9-s" style="left:6px;top:6px" /><Screw s={10} rot={80} class="c9-s" style="right:6px;top:6px" />
      <Screw s={10} rot={120} class="c9-s" style="left:6px;bottom:6px" /><Screw s={10} rot={15} class="c9-s" style="right:6px;bottom:6px" />
    </div>
    <span class="c9-tape" data-depth="18" aria-hidden="true"><span>{d.bandTape}</span></span>
    <p class="c9-strip" data-depth="30"><span class="tech">From his Instagram</span><a href={SITE.social.instagram} rel="noopener">{SITE.igHandle} · Surrey, BC</a></p>
  </div>
</section>
<style>
  .c9 { background: var(--panel); }
  .c9-h { margin: 15px 0 0 -4px; white-space: nowrap; }
  .c9-p { width: 430px; margin-top: 24px; color: var(--ink); }
  .c9-b { display: flex; flex-direction: column; align-items: flex-start; gap: 24px; margin-top: 53px; }
  .c9-par { width: 660px; height: 460px; }
  .c9-par > * { transition: transform .5s var(--ease-out); }
  .c9-plate { position: absolute; left: 0; top: 22px; width: 640px; height: 400px; background: #fff; border-radius: 10px; box-shadow: 0 16px 36px rgba(13, 15, 51, .25); }
  .c9-ph { position: absolute; inset: 14px; border-radius: 4px; overflow: hidden; background: var(--deep); }
  .c9-plate :global(.c9-s) { position: absolute; }
  .c9-tape { position: absolute; left: 24px; top: 0; }
  .c9-tape span { display: inline-block; padding: 6px 16px; background: var(--tape); font-family: var(--f-marker); font-size: 22px; line-height: 32px; color: var(--ink); white-space: nowrap; box-shadow: 0 2px 4px rgba(0, 0, 0, .2); transform: rotate(3deg); transform-origin: 0 0; }
  .c9-strip { position: absolute; left: 409px; top: 392px; display: flex; flex-direction: column; gap: 2px; width: 247px; height: 52px; padding: 8px 16px 0; background: var(--indigo); border-radius: 8px; box-shadow: 0 8px 18px rgba(13, 15, 51, .3); rotate: -2deg; transform-origin: 0 0; }
  .c9-strip .tech { font-size: 11px; line-height: 16px; letter-spacing: .1em; color: var(--amber); }
  .c9-strip a { font-weight: 600; font-size: 14px; line-height: 18px; color: #fff; white-space: nowrap; }
  .c9-strip a:hover { text-decoration: underline; }
  @media (max-width: 1023px) {
    .c9 { display: flex; flex-direction: column; padding: 64px 20px; }
    .c9-l { display: contents; }
    .c9-h { margin: 14px 0 0; font-size: 32px; line-height: 36px; white-space: normal; }
    .c9-p { width: auto; margin-top: 16px; }
    .c9-par { order: 5; position: relative; width: 100%; height: auto; aspect-ratio: 350 / 270; margin-top: 38px; }
    .c9-plate { top: 13px; width: 100%; height: auto; aspect-ratio: 350 / 230; border-radius: 6px; }
    .c9-ph { inset: 7px 8px; }
    .c9-tape { left: 13px; top: 0; }
    .c9-tape span { padding: 3px 9px; font-size: 12.1px; line-height: 18px; }
    .c9-strip { left: auto; right: -9px; top: auto; bottom: 0; width: 217px; height: 44px; padding: 5px 9px 0; border-radius: 4px; }
    .c9-strip a { font-size: 13px; line-height: 17px; }
    .c9-b { order: 6; gap: 20px; margin-top: 30px; }
  }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-par3]').forEach((w) => {
    const ok = () => matchMedia('(min-width: 1024px) and (pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ls = Array.from(w.querySelectorAll<HTMLElement>('[data-depth]'));
    const host = w.closest('section') || w;
    host.addEventListener('pointermove', (e) => {
      if (!ok()) return;
      const r = w.getBoundingClientRect();
      const x = Math.max(-1, Math.min(1, ((e as PointerEvent).clientX - r.left) / r.width * 2 - 1)), y = Math.max(-1, Math.min(1, ((e as PointerEvent).clientY - r.top) / r.height * 2 - 1));
      ls.forEach((l) => { const k = Number(l.dataset.depth); l.style.transform = `translate(${(x * k).toFixed(1)}px, ${(y * k * 0.6).toFixed(1)}px)`; });
    });
    host.addEventListener('pointerleave', () => ls.forEach((l) => (l.style.transform = '')));
  });
</script>
