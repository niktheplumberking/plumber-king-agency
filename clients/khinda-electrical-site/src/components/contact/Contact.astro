<script>
  // 7.4 copy chips
  document.querySelectorAll<HTMLButtonElement>('.c4-cp[data-copy]').forEach((b) => b.addEventListener('click', async () => {
    const live = document.querySelector<HTMLElement>('[data-copy-live]');
    try {
      await navigator.clipboard.writeText(b.dataset.copy || '');
      b.textContent = 'Copied'; b.classList.add('is-done'); if (live) live.textContent = `Copied ${b.dataset.copy}`;
      setTimeout(() => { b.textContent = 'Copy'; b.classList.remove('is-done'); }, 2000);
    } catch { if (live) live.textContent = 'Copy did not work here. The number is 236-818-2664.'; }
  }));
  // 7.5 drawers: the "What to send" card follows the pointer on hover (desktop); click / tap opens one drawer at a time
  const drawers = [...document.querySelectorAll<HTMLElement>('[data-drawer]')];
  const fine = matchMedia('(min-width: 1024px) and (hover: hover)');
  drawers.forEach((d) => {
    const card = d.querySelector<HTMLElement>('[data-card]')!;
    const btn = d.querySelector<HTMLButtonElement>('.c5-hit')!;
    d.addEventListener('pointermove', (e) => {
      if (!fine.matches || d.classList.contains('is-open')) return;
      const r = d.getBoundingClientRect();
      card.style.setProperty('--cx', `${e.clientX - r.left + 18}px`); card.style.setProperty('--cy', `${e.clientY - r.top + 18}px`);
    });
    btn.addEventListener('click', () => {
      const open = !d.classList.contains('is-open');
      drawers.forEach((o) => { o.classList.remove('is-open'); o.querySelector('.c5-hit')!.setAttribute('aria-expanded', 'false'); });
      if (open) {
        d.classList.add('is-open'); btn.setAttribute('aria-expanded', 'true');
        if (fine.matches) { card.style.setProperty('--cx', `${d.offsetWidth - 230}px`); card.style.setProperty('--cy', '78px'); }
      }
    });
  });
