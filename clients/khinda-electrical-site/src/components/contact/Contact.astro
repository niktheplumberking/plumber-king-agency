  document.querySelectorAll<HTMLElement>('[data-tag]').forEach((t) => {
    const b = t.parentElement!.querySelector<HTMLButtonElement>('.c6-hit')!; const a = t.querySelector<HTMLAnchorElement>('.c6-al')!;
    b.addEventListener('click', () => {
