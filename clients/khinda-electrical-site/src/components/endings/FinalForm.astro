---
// F final form (Figma Home 720:437, 1440x960 deep; mobile 728:485) = the panel schedule on a panel door. Six circuits,
// one row at a time (scripts/forms.ts schedule()): each finished row flips its breaker ON, the readout counts "0n / 06 ON",
// "Next" opens the next row; Send flips the MAIN breaker (top, where the FAQ cables land), the tape says "Schedule received.
// Khinda has it." and the page goes to /thank-you/. Without JS every row is open and the form posts normally.
// Per-page variant: `town` prefills CCT 03 and names the town in the eyebrow (city pages).
import Eyebrow from '../kit/Eyebrow.astro';
import Btn from '../kit/Btn.astro';
import Tape from '../kit/Tape.astro';
import Screw from '../kit/Screw.astro';
import Toggle from '../kit/Toggle.astro';
import Art from '../kit/Art.astro';
import d from '../../art/f-d.svg?raw';
import { SITE } from '../../data/site';
interface Props { town?: string }
const { town } = Astro.props;
const OFF = ['Breaker trips', 'Flicker', 'Bigger panel', 'EV charger', 'New lights', 'Reno', 'Other'];
const TIMES = ['Morning', 'Afternoon', 'Evening'];
const ROWS = [
  { k: 'NAME', q: 'Your name' },
  { k: 'PHONE', q: 'Best number for Khinda' },
  { k: 'TOWN', q: 'Which town is the job in?' },
  { k: "WHAT'S OFF", q: "What's off?" },
  { k: 'PHOTO', q: 'A photo helps (optional)' },
  { k: 'BEST TIME', q: 'Best time to reach you' },
];
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="ff sec on-dark" id="schedule" style="--h:960px" data-m-section aria-labelledby="ff-h">
  <Art svg={d} class="dn-m" />
  <div class="ff-main ab" style="--x:900px;--y:70px" data-main aria-hidden="true">
    <span class="mb"><i></i></span><span class="tech" data-main-t>MAIN · OFF</span>
  </div>
  <div class="ff-l ab" style="--x:120px;--y:130px;--w:460px">
    <Eyebrow text={town ? `Get a price in ${town}` : 'Get a price from Khinda'} data-t="1" />
    <h2 class="h2" id="ff-h" data-t="2"><span class="l1">Fill in the schedule.</span><span class="l2">He takes it from there.</span></h2>
    <p class="lead ff-lead" data-t="3"><span class="dn-m">Six lines on a panel door, one at a time. Each line you fill flips its breaker on. The main breaker sends it straight to Khinda.</span><span class="dn-d">Six lines, one at a time. The main breaker sends it straight to Khinda.</span></p>
    <div class="ff-alt">
      <p class="tech ff-or">Or skip the form</p>
      <a class="ff-ph" href={SITE.tel}>{SITE.phone}</a>
      <p class="ff-tap">Tap to call. Calls and WhatsApp texts.</p>
      <Btn v="text" tone="dark" main="Text a photo of the problem" sub={`WhatsApp · ${SITE.phone}`} href={SITE.whatsapp} class="ff-tb" />
      <Tape text="Fastest way: call." rot={-4} size={22} class="ff-tape" />
    </div>
  </div>
  <div class="ff-door ab" style="--x:600px;--y:120px;--w:720px">
    <Screw s={14} class="ffs ffs1" /><Screw s={14} rot={120} class="ffs ffs2" /><Screw s={14} rot={75} class="ffs ffs3" /><Screw s={14} rot={10} class="ffs ffs4" />
    <i class="hinge h1" aria-hidden="true"></i><i class="hinge h2" aria-hidden="true"></i>
    <div class="ff-ro" aria-live="polite"><b class="tech" data-ro>00 / 06 ON</b><small class="tech" data-ro-now>NOW · CCT 01 NAME</small><span class="ro-bk" aria-hidden="true">{ROWS.map(() => <i></i>)}</span></div>
    <form class="ff-sch" data-estimate-form data-schedule method="post" action="/thank-you/" enctype="multipart/form-data" novalidate>
      <div class="sch-top"><p class="tech sch-t">Panel schedule</p><p class="tech sch-b dn-m">Khinda Electrical · Surrey</p></div>
      {ROWS.map((r, i) => (
        <fieldset class="row" data-row={i + 1}>
          <legend class="rh">
            <span class="tech rn">CCT {pad(i + 1)}</span><span class="tech rk">{r.k}</span>
          </legend>
          <span class="rs tech dn-d" aria-hidden="true" data-rs>{i === 0 ? '' : 'NEXT'}</span>
          <Toggle kind="breaker" on={false} class="rbk" />
          <div class="rb">
            <p class="rq dn-d">{r.q}</p>
            {i === 0 && <input class="fld" name="name" autocomplete="name" placeholder="Your name" aria-label="Your name" required />}
            {i === 1 && <input class="fld" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="e.g. 604-555-0123" aria-label="Phone number" required />}
            {i === 2 && <input class="fld" name="town" autocomplete="address-level2" placeholder="e.g. Newton, Fleetwood" aria-label="Town" value={town} />}
            {i === 3 && <div class="chips">{OFF.map((o) => <label class="chip"><input type="checkbox" name="off" value={o} /><Toggle kind="chip" on={false} /><span>{o}</span></label>)}</div>}
            {i === 4 && <label class="photo"><input type="file" name="photo" accept="image/*" data-photo /><span data-photo-label>Add a photo of the panel or fixture</span></label>}
            {i === 5 && <div class="chips">{TIMES.map((o) => <label class="chip"><input type="radio" name="time" value={o} /><Toggle kind="chip" on={false} /><span>{o}</span></label>)}</div>}
            {i < 5 && <div class="rf"><p class="hint">{i === 2 && town ? `Filled in for ${town}. Change it if needed.` : `${['Type your name.', 'Type your best number.', 'Type your town.', 'Pick what applies.', 'Optional.'][i]} CCT ${pad(i + 2)} opens next.`}</p><button type="button" class="next" data-next>Next →</button></div>}
          </div>
        </fieldset>
      ))}
      <Btn v="call" type="submit" main="Send the schedule" sub="Goes straight to Khinda" class="sch-send" data-send />
      <p class="sch-p">Your number is only used for this job.</p>
      <p class="sch-msg" data-form-msg role="status"></p>
      <Tape text="Schedule received. Khinda has it." rot={-3} size={22} class="sch-done" data-sent-tape hidden />
    </form>
  </div>
</section>
<style>
  .ff { background: var(--deep); z-index: 2; }
  .ff-main { z-index: 3; display: grid; justify-items: center; gap: 6px; width: 120px; height: 76px; padding-top: 10px; background: var(--indigo); border: 1px solid var(--line-d2); border-radius: 8px; box-shadow: 0 8px 16px rgba(0, 0, 13, .4); }
  .ff-main .tech { font-size: 10px; line-height: 14px; color: var(--mist); }
  .mb { position: relative; width: 28px; height: 44px; margin-bottom: -6px; border-radius: 4px; background: var(--deep); }
  .mb i { position: absolute; left: 5px; top: 5px; width: 18px; height: 16px; border-radius: 2px; background: var(--mist); transform: translateY(18px); transition: transform .5s var(--ease-back), background-color .3s; }
  .ff-main.is-on .mb i { transform: none; background: var(--amber); }
  .ff-l .h2 { margin-top: 19px; width: 460px; font-size: 42px; line-height: 48px; }
  .ff-lead { margin-top: 24px; width: 420px; }
  .ff-alt { margin-top: 46px; }
  .ff-or { font-size: 11px; line-height: 16px; letter-spacing: .14em; color: var(--mist); }
  .ff-ph { display: block; margin: 4px 0 0 -4px; font-family: var(--f-display); font-weight: 800; font-size: 52px; line-height: 60px; color: var(--amber); }
  .ff-ph:hover { text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 6px; }
  .ff-tap { margin-top: 4px; font-size: 15px; line-height: 19px; color: var(--mist); }
  .ff-alt :global(.ff-tb) { margin-top: 25px; width: 282px; min-height: 70px; }
  .ff-alt :global(.ff-tape) { display: block; width: max-content; margin: 42px 0 0 8px; }
  .ff-door { position: relative; height: 808px; background: var(--panel); border-radius: 14px; box-shadow: 0 24px 50px rgba(0, 0, 13, .5); color: var(--ink); }
  :global(.ffs) { position: absolute; } :global(.ffs1) { left: 14px; top: 14px; } :global(.ffs2) { right: 14px; top: 14px; } :global(.ffs3) { left: 14px; bottom: 14px; } :global(.ffs4) { right: 14px; bottom: 14px; }
  .hinge { position: absolute; left: -6px; width: 10px; height: 70px; border-radius: 3px; background: #8F95A3; }
  .h1 { top: 120px; } .h2 { top: 590px; }
  .ff-ro { position: absolute; left: 24px; top: 40px; display: grid; gap: 1px; width: 266px; height: 46px; padding: 8px 14px; background: var(--deep); border: 1px solid var(--line-d); border-radius: 6px; }
  .ro-bk { position: absolute; left: 124px; top: 12px; display: flex; gap: 3px; }
  .ro-bk i { width: 7px; height: 12px; border-radius: 1.5px; background: var(--line-d2); transition: background-color .3s; }
  .ro-bk i.on { background: var(--amber); }
  .ff-ro { position: absolute; }
  .js-steps .row.done .rb:has(.fld)::after { content: ''; position: absolute; right: 30px; top: 12px; width: 14px; height: 8px; border-left: 2px solid var(--indigo); border-bottom: 2px solid var(--indigo); transform: rotate(-45deg); }
  .ff-ro b { font-weight: 400; font-size: 14px; line-height: 20px; color: var(--amber); }
  .ff-ro small { font-size: 10px; line-height: 14px; color: var(--mist); }
  .ff-sch { position: absolute; left: 24px; top: 104px; width: 672px; height: 676px; padding: 20px 24px 0; background: #fff; border: 1px solid var(--line); border-radius: 6px; }
  .sch-top { display: flex; justify-content: space-between; align-items: baseline; height: 44px; }
  .sch-t { font-size: 12px; line-height: 17px; letter-spacing: .16em; color: var(--indigo); }
  .sch-b { font-size: 10px; line-height: 14px; color: var(--steel); }
  .row { position: relative; display: grid; grid-template-columns: 108px 44px 1fr; align-items: start; margin: 0 -14px; padding: 0 14px; border-radius: 8px; transition: opacity .4s, background-color .3s, box-shadow .3s; }
  .row + .row { margin-top: 18px; }
  .rh { float: left; display: grid; gap: 4px; padding: 0; grid-column: 1; grid-row: 1; }
  .rn { font-size: 10px; line-height: 14px; color: var(--steel); }
  .rk { font-size: 11px; line-height: 16px; color: var(--indigo); }
  .row :global(.rbk) { grid-column: 2; grid-row: 1; margin-top: 2px; }
  .row :global(.rbk.is-on i) { transform: none; background: var(--amber); }
  .rb { position: relative; grid-column: 3; grid-row: 1; min-width: 0; }
  .fld { width: 100%; height: 38px; padding: 0 14px; background: var(--field); border: 1px solid var(--line); border-radius: 6px; font-size: 15px; color: var(--ink); }
  .fld::placeholder { color: var(--steel); }
  .fld:focus { outline: none; background: #fff; border: 2px solid var(--indigo); }
  .fld[aria-invalid='true'] { border: 2px solid var(--c-red); }
  .rf { display: flex; justify-content: space-between; align-items: center; margin-top: 10px; }
  .hint { font-size: 13px; line-height: 17px; color: var(--steel); }
  .next { height: 36px; padding: 0 18px; border-radius: 6px; background: var(--indigo); font-weight: 600; font-size: 14px; color: #fff; transition: background-color .25s; }
  .next:hover { background: #262a73; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { position: relative; display: inline-flex; align-items: center; gap: 6px; height: 31px; padding: 7px 10px; border-radius: 6px; background: var(--panel); font-weight: 500; font-size: 13px; line-height: 17px; cursor: pointer; transition: background-color .25s, color .25s; }
  .chip input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .chip :global(.tg-chip) { width: 10px; height: 16px; }
  .chip:has(input:checked) { background: var(--indigo); color: #fff; }
  .chip:has(input:checked) :global(.tg) { background: var(--amber); }
  .chip:has(input:checked) :global(.tg i) { background: var(--deep); transform: none; }
  .chip:has(input:focus-visible) { outline: 3px solid var(--indigo); outline-offset: 2px; }
  .photo { position: relative; display: flex; align-items: center; height: 46px; padding: 0 14px 0 38px; background: #F3F4F6; border: 1.5px dashed var(--mist); border-radius: 6px; font-weight: 500; font-size: 15px; color: var(--indigo); cursor: pointer; }
  .photo::before { content: '+'; position: absolute; left: 14px; font-weight: 700; }
  .photo input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .photo:has(input:focus-visible) { outline: 3px solid var(--indigo); outline-offset: 2px; }
  .ff-sch :global(.sch-send) { display: flex; justify-content: center; width: 100%; height: 70px; margin-top: 28px; }
  .ff-sch :global(.sch-send .tg-btn) { width: 24px; height: 36px; }
  .sch-p { margin-top: 6px; font-size: 13px; line-height: 17px; color: var(--steel); }
  .sch-msg { font-size: 13px; line-height: 17px; color: var(--c-red); font-weight: 600; }
  .ff-sch :global(.sch-done) { position: absolute; right: 30px; bottom: 30px; z-index: 2; }
  /* stepper states (forms.ts adds .js-steps) */
  .js-steps .row.pending { opacity: .45; }
  .js-steps .row.pending .rf { display: none; }
  .js-steps .row.active { margin-top: 14px; padding: 14px; background: #fff; box-shadow: 0 0 0 2px var(--amber), 0 10px 24px rgba(0, 0, 13, .22); }
  .js-steps .row.active + .row { margin-top: 32px; }
  .js-steps .row.active :global(.rbk) { box-shadow: 0 0 0 2px var(--amber); }
  .js-steps .row.active .fld { height: 48px; font-size: 16px; }
  .js-steps .row.done .rf, .js-steps .row.done .chips + .rf { display: none; }
  @media (max-width: 1023px) {
    .ff { padding: 60px 20px 52px; display: flex; flex-direction: column; }
    .ff-main { position: relative; align-self: center; order: -1; width: 70px; height: 56px; padding-top: 6px; gap: 2px; border-radius: 6px; margin-bottom: 34px; }
    .ff-main .tech { font-family: var(--f-sans); font-weight: 600; font-size: 11px; letter-spacing: .02em; }
    .mb { width: 20px; height: 32px; margin: 0; } .mb i { left: 3px; top: 3px; width: 14px; height: 12px; transform: translateY(14px); }
    .ff-l { display: contents; }
    .ff-l .h2 { width: auto; margin-top: 8px; font-size: 28px; line-height: 31px; }
    .ff-lead { width: auto; margin-top: 12px; }
    .ff-alt { order: 3; margin-top: 40px; }
    .ff-ph { margin: 0 0 0 -2px; font-size: 40px; line-height: 48px; }
    .ff-tap { font-size: 14px; line-height: 18px; }
    .ff-alt :global(.ff-tb) { width: 100%; min-height: 65px; margin-top: 16px; }
    .ff-alt :global(.ff-tape) { margin: 22px 0 0 6px; font-size: 18px; }
    .ff-door { position: relative; order: 2; width: 100%; height: auto; margin-top: 22px; padding: 28px 20px 28px; border-radius: 12px; }
    :global(.ffs1), :global(.ffs3) { left: 8px; } :global(.ffs2), :global(.ffs4) { right: 8px; } :global(.ffs1), :global(.ffs2) { top: 8px; } :global(.ffs3), :global(.ffs4) { bottom: 8px; }
    :global(.ffs) { width: 12px; height: 12px; }
    .hinge { display: none; }
    .ff-sch { position: static; width: auto; height: auto; padding: 17px 17px 18px; }
    .ro-bk { left: auto; right: 12px; top: 15px; }
    .js-steps .row.done .rb:has(.fld)::after { content: none; }
    .ff-ro { position: relative; width: auto; height: 44px; margin: 0 0 12px; padding: 7px 12px; gap: 0; order: 0; }
  .ff-ro b { font-size: 13px; line-height: 18px; }
    .ff-ro small { font-size: 11px; line-height: 16px; }
    .sch-top { height: auto; margin-bottom: 12px; }
    .sch-t { font-size: 11px; }
    .row { grid-template-columns: 26px 1fr auto; margin: 0; padding: 0; min-height: 38px; align-items: center; }
    .row + .row { margin-top: 2px; }
    .rh { grid-column: 2; display: flex; gap: 0; }
    .rn::after { content: ' · '; white-space: pre; }
    .rn, .rk { font-size: 11px; line-height: 16px; letter-spacing: .1em; color: var(--indigo); }
    .row :global(.rbk) { grid-column: 1; width: 16px; height: 27px; margin: 0; }
    .row :global(.rbk i) { left: 3px; top: 3px; width: 10px; height: 10px; transform: translateY(11px); }
    .rs { grid-column: 3; grid-row: 1; font-size: 11px; color: var(--steel); }
    .rb { grid-column: 1 / -1; grid-row: 2; padding: 6px 0 12px; }
    .rq { margin-bottom: 12px; font-weight: 600; font-size: 18px; line-height: 24px; }
    .js-steps .row:not(.active) .rb { display: none; }
    .js-steps .row.pending { opacity: .5; }
    .js-steps .row.done .rs { color: var(--ink); font-family: var(--f-sans); font-weight: 500; font-size: 13px; letter-spacing: 0; text-transform: none; }
    .js-steps .row.active { margin: 10px -9px; padding: 14px; grid-template-columns: 1fr auto; }
    .js-steps .row.active .rh { grid-column: 1; display: grid; gap: 2px; }
    .js-steps .row.active .rn::after { content: none; }
    .js-steps .row.active .rn { color: var(--steel); }
    .js-steps .row.active .rk { font-size: 12px; }
    .js-steps .row.active :global(.rbk) { grid-column: 2; }
    .js-steps .row.active .rs { display: none; }
    .js-steps .row.active + .row { margin-top: 12px; }
    .rf { flex-direction: column; align-items: stretch; gap: 10px; }
    .next { height: 48px; border-radius: 8px; font-size: 16px; }
    .ff-sch :global(.sch-send) { height: 61px; margin-top: 16px; }
    .sch-p { font-size: 12px; line-height: 17px; }
    .ff-sch :global(.sch-done) { position: static; display: block; width: max-content; margin-top: 12px; font-size: 18px; }
  }
</style>
