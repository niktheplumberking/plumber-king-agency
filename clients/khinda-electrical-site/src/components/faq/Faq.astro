<script>
  // 10.2: tabs (roving tabindex, arrows / Home / End) and one-open-at-a-time breaker questions.
  const root = document.querySelector<HTMLElement>('[data-fq]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const sel = root.querySelector<HTMLElement>('[data-fq-sel]');
    const notch = root.querySelector<HTMLElement>('[data-fq-notch]');
    const pick = (t: HTMLButtonElement, focus = false) => {
      tabs.forEach((o) => { const on = o === t; o.setAttribute('aria-selected', String(on)); o.tabIndex = on ? 0 : -1; document.getElementById(o.getAttribute('aria-controls')!)!.hidden = !on; });
      const cs = getComputedStyle(t);
      if (sel) { sel.style.setProperty('--x', `${parseFloat(cs.getPropertyValue('--nx')) - 20}px`); sel.style.setProperty('--rs', cs.getPropertyValue('--rs')); }
      if (notch) notch.style.setProperty('--x', `${parseFloat(cs.getPropertyValue('--tc')) - 11}px`);
      if (focus) t.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => pick(t));
      t.addEventListener('keydown', (e) => {
        const n = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? i + 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? i - 1 : e.key === 'Home' ? 0 : e.key === 'End' ? tabs.length - 1 : null;
        if (n == null) return;
        e.preventDefault(); pick(tabs[(n + tabs.length) % tabs.length], true);
      });
    });
    root.querySelectorAll<HTMLElement>('[role="tabpanel"]').forEach((p) => {
      const bs = [...p.querySelectorAll<HTMLButtonElement>('.fq2-b')];
      bs.forEach((b) => b.addEventListener('click', () => {
        const open = b.getAttribute('aria-expanded') !== 'true';
        bs.forEach((o) => { const on = o === b && open; o.setAttribute('aria-expanded', String(on)); document.getElementById(o.getAttribute('aria-controls')!)!.hidden = !on; });
      }));
    });
  }
</script>
