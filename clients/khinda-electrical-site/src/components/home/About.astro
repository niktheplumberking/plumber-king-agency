---
// 1.5 About teaser (Figma Home 714:447, 1440x720 white; mobile 724:535). A pile of his job prints (ig11 new build on top,
// the back of a print, ig49 garden lights under) with the door magnet sign "Khinda Electrical · Surrey" over the corner.
// STATE "draggable photo pile": drag or swipe the top print away and let go, it goes to the back ("PHOTO n / 3");
// the counter is also a button for keyboard users. Owner name + photo = "Khinda to confirm" (README).
import { Image } from 'astro:assets';
import Img from '../ui/Img.astro';
import Eyebrow from '../kit/Eyebrow.astro';
import Btn from '../kit/Btn.astro';
import mark from '../../assets/brand/logo-mark-K-bolt.png';
import { SITE } from '../../data/site';
const FACTS = [['Base', 'Surrey, BC'], ['Filming his jobs', 'YouTube since Jan 2018'], ['Work', 'Homes, suites and shops']];
---
<section class="ab5 sec" style="--h:720px" data-m-section aria-labelledby="ab-h">
  <div class="pile" data-pile data-t="3" data-fx="frame">
    <figure class="pr p3" data-card style="--x:64px;--y:150px;--r:7deg;--mx:3.1%;--my:33px;--mr:-6deg">
      <div class="pp"><Img name="garden-light-wiring-surrey" alt="Garden light wiring by Khinda Electrical in Surrey" sizes="(min-width: 1024px) 272px, 200px" box={272 / 340} boxM={200 / 240} widths={[272, 400, 544]} /></div>
      <figcaption class="marker">Garden lights</figcaption>
    </figure>
    <figure class="pr p2" data-card style="--x:410px;--y:64px;--r:6deg;--mx:38.5%;--my:11px;--mr:7deg">
      <div class="pp back"><span class="tech">Print 2 / 3 · back</span></div>
      <figcaption class="marker">Fire alarm panels</figcaption>
    </figure>
    <figure class="pr p1 top" data-card style="--x:120px;--y:110px;--r:1.5deg;--mx:5.1%;--my:12px;--mr:1.5deg">
      <div class="pp big"><Img name="new-build-electrical-rough-in-surrey" alt="New build electrical rough-in by Khinda Electrical in Surrey" sizes="(min-width: 1024px) 660px, calc(100vw - 40px)" box={660 / 520} boxM={350 / 262} widths={[360, 660, 960, 1241]} /></div>
    </figure>
    <p class="cap tech dn-m">New build · rough-in stage</p>
    <div class="sign" aria-hidden="true">
      <div class="si">
        <Image src={mark} alt="" width={84} height={72} loading="lazy" class="sm" />
        <p class="sn"><span>Khinda</span><span class="s2">Electrical</span></p>
        <i class="sr"></i>
        <p class="tech sc">Surrey, BC</p>
        <p class="sp">{SITE.phone}</p>
        <p class="sh">Homes · Shops</p>
      </div>
    </div>
    <button type="button" class="hint tech dn-m" data-pile-next>Photo <span data-pile-n>1</span> / 3</button>
  </div>
  <div class="ab-copy ab" style="--x:860px;--y:130px;--w:470px">
    <Eyebrow text="Who shows up" data-t="1" />
    <h2 class="h2" id="ab-h" data-t="2"><span class="l1">One electrician.</span><span class="l2">Every panel labelled.</span></h2>
    <p class="lead ab-lead" data-t="3">Khinda Electrical works out of Surrey, BC, and has been on YouTube since 2018. His posts show rough-ins, finished panels, chandeliers and shop fit-outs. The work on this page is his.</p>
    <dl class="facts" data-t="4" data-stagger>
      {FACTS.map(([k, v]) => <div><dt class="tech">{k}</dt><dd>{v}</dd></div>)}
    </dl>
    <div class="ab-cta" data-t="4">
      <Btn v="call" main="Talk to him directly" sub={`${SITE.phone} · tap to call`} class="ab-call" />
      <a class="ab-story" href="/about/">His story <svg viewBox="0 0 10 8" width="10" height="8" aria-hidden="true"><path d="M0 4h8.5M5.5 1l3 3-3 3" fill="none" stroke="currentColor" stroke-width="2"/></svg></a>
    </div>
  </div>
</section>
<style>
  .ab5 { background: #fff; z-index: 1; }
  .pile { position: absolute; inset: 0; }
  .pr { position: absolute; left: var(--x); top: var(--y); margin: 0; background: #fff; border-radius: 4px; box-shadow: 0 14px 30px rgba(0, 0, 13, .22); transform: rotate(var(--r)); transform-origin: 0 0; touch-action: pan-y; transition: box-shadow .3s; }
  .p3 { width: 300px; height: 400px; padding: 12px 12px 0; }
  .p3 .pp { width: 272px; height: 340px; overflow: hidden; }
  .p2 { width: 380px; height: 500px; padding: 12px 12px 0; }
  .p2 .pp { width: 352px; height: 438px; background: #F4F1E8; display: grid; place-items: end start; padding: 14px; }
  .p2 .pp span { font-size: 10px; color: var(--steel); letter-spacing: 0; }
  .pr figcaption { margin: 6px 0 0 -10px; font-size: 18px; line-height: 26px; color: var(--ink); }
  .p1 { width: 660px; height: 520px; padding: 0; border: 14px solid #fff; border-radius: 8px; box-shadow: 0 18px 36px rgba(0, 0, 13, .28); cursor: grab; }
  .p1 .pp { position: absolute; inset: 0; border-radius: 2px; overflow: hidden; }
  .pr.dragging { cursor: grabbing; transition: none; }
  .cap { position: absolute; left: 120px; top: 646px; font-size: 10px; line-height: 14px; color: var(--steel); }
  .hint { position: absolute; left: 120px; top: 670px; min-height: 24px; font-size: 10px; line-height: 14px; color: var(--steel); }
  .hint:hover { color: var(--indigo); }
  .sign { position: absolute; left: 470px; top: 520px; z-index: 5; width: 330px; height: 200px; padding: 7px; background: #fff; border: 4px solid var(--indigo); border-radius: 18px; box-shadow: 0 20px 36px rgba(13, 15, 51, .35); transform: rotate(3deg); transform-origin: 0 0; }
  .si { position: relative; height: 100%; border: 2px solid var(--amber); border-radius: 12px; }
  .si :global(.sm) { position: absolute; left: 14px; top: 16px; width: 84px; height: 72px; object-fit: contain; }
  .sn { position: absolute; left: 111px; top: 15px; display: grid; font-family: var(--f-display); font-weight: 800; font-size: 34px; line-height: 38px; color: var(--indigo); }
  .sn .s2 { margin-left: -2px; color: var(--h2b); }
  .sr { position: absolute; left: 10px; top: 104px; width: 278px; height: 2px; background: var(--indigo); }
  .sc { position: absolute; left: 9px; top: 118px; font-size: 11px; line-height: 16px; letter-spacing: .14em; color: var(--indigo); }
  .sp { position: absolute; left: 8px; top: 136px; font-family: var(--f-display); font-weight: 800; font-size: 22px; line-height: 28px; color: var(--indigo); }
  .sh { position: absolute; left: 194px; top: 154px; font-size: 13px; line-height: 17px; color: var(--steel); }
  .ab5 .h2 { margin-top: 19px; }
  .ab-lead { width: 460px; margin-top: 22px; }
  .facts { width: 460px; margin: 10px 0 0; border-top: 1px solid var(--line); }
  .facts div { display: grid; grid-template-columns: 200px 1fr; align-items: center; height: 44px; border-bottom: 1px solid var(--line); }
  .facts dt { font-size: 10px; line-height: 14px; color: var(--steel); }
  .facts dd { font-weight: 600; font-size: 16px; line-height: 20px; color: var(--indigo); }
  .ab-cta { display: flex; align-items: center; gap: 22px; margin-top: 29px; }
  .ab-cta :global(.ab-call) { width: 238px; }
  .ab-story { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; font-size: 16px; line-height: 20px; color: var(--indigo); }
  .ab-story:hover { text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 1023px) {
    .ab5 { padding: 0 20px 52px; }
    .pile { position: relative; inset: auto; height: calc(370 / 390 * 100vw); margin: 0 -20px; container-type: inline-size; }
    .pr { left: var(--mx); top: var(--my); transform: rotate(var(--mr)); transform-origin: 50% 50%; }
    .p3 { width: 56.4cqi; height: 69.2cqi; padding: 2.6cqi 2.6cqi 0; }
    .p3 .pp { width: 100%; height: 56cqi; }
    .p2 { left: auto; right: 5.1cqi; width: 56.4cqi; height: 69.2cqi; padding: 2.6cqi 2.6cqi 0; }
    .p2 .pp { width: 100%; height: 56cqi; }
    .pr figcaption { font-size: 14px; line-height: 20px; margin-left: -4px; }
    .p1 { width: 89.7cqi; height: 67.2cqi; border-width: 10px; }

    .sign { left: auto; right: 6.2cqi; top: 58cqi; width: 236px; height: 144px; padding: 5px; border-width: 3px; border-radius: 14px; }
    .si { border-radius: 10px; }
    .si :global(.sm) { left: 9px; top: 11px; width: 60px; height: 52px; }
    .sn { left: 79px; top: 10px; font-size: 24px; line-height: 27px; }
    .sr { left: 7px; top: 74px; width: 200px; }
    .sc { left: 7px; top: 83px; font-size: 8px; line-height: 11px; }
    .sp { left: 6px; top: 96px; font-size: 16px; line-height: 20px; }
    .sh { left: 140px; top: 109px; font-size: 10px; line-height: 13px; }
    .ab-copy { position: relative; margin-top: 26px; }
    .ab-copy :global(.eyebrow) { font-size: 10px; line-height: 14px; gap: 8px; }
    .ab5 .h2 { margin-top: 10px; }
    .ab-lead { width: auto; margin-top: 14px; }
    .facts { width: auto; margin-top: 34px; }
    .facts div { grid-template-columns: 150px 1fr; height: 42px; }
    .facts dt { font-size: 8px; line-height: 11px; }
    .facts dd { font-size: 15px; line-height: 19px; }
    .ab-cta { flex-direction: column; align-items: flex-start; gap: 18px; margin-top: 23px; }
    .ab-cta :global(.ab-call) { width: 100%; }
    .ab-story { font-size: 15px; line-height: 19px; }
  }
</style>
<script>
  // Photo pile: drag / swipe the top print away; on release it slides back under the pile (z order rotates), "PHOTO n / 3".
  document.querySelectorAll<HTMLElement>('[data-pile]').forEach((pile) => {
    const cards = Array.from(pile.querySelectorAll<HTMLElement>('[data-card]')).reverse(); // top first
    const n = pile.querySelector<HTMLElement>('[data-pile-n]');
    let order = cards.slice();
    const z = () => order.forEach((c, i) => { c.style.zIndex = String(3 - i); c.classList.toggle('top', i === 0); });
    z();
    const next = () => { order.push(order.shift()!); z(); if (n) n.textContent = String(cards.indexOf(order[0]) + 1); };
    pile.querySelector('[data-pile-next]')?.addEventListener('click', next);
    cards.forEach((c) => {
      let x0 = 0, y0 = 0, dx = 0, dy = 0, on = false;
      c.addEventListener('pointerdown', (e) => { if (order[0] !== c) return; on = true; x0 = e.clientX; y0 = e.clientY; dx = dy = 0; c.setPointerCapture(e.pointerId); c.classList.add('dragging'); });
      c.addEventListener('pointermove', (e) => { if (!on) return; dx = e.clientX - x0; dy = e.clientY - y0; c.style.translate = `${dx}px ${dy * 0.4}px`; });
      const up = () => {
        if (!on) return; on = false; c.classList.remove('dragging');
        const far = Math.abs(dx) > 90;
        c.animate([{ translate: `${dx}px ${dy * 0.4}px` }, { translate: '0 0' }], { duration: 520, easing: 'cubic-bezier(.65,0,.35,1)' });
        c.style.translate = '';
        if (far) next();
      };
      c.addEventListener('pointerup', up); c.addEventListener('pointercancel', up);
    });
  });
</script>
