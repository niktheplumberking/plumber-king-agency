---
// 1.11 FAQ (Figma Home 719:1090, 1440x780 panel; mobile 728:437). A 4-gang wall plate of toggle switches; flip one and its
// answer plate slides in, wired to it (blue wire). Ask Khinda card with tape. Three cables (join B) leave the answer plate and
// run down into the F MAIN breaker (art, drawn on scroll). Q02-Q04 answers: src/data/faq.ts (README "Khinda to confirm").
import Eyebrow from '../kit/Eyebrow.astro';
import Btn from '../kit/Btn.astro';
import Tape from '../kit/Tape.astro';
import Screw from '../kit/Screw.astro';
import Art from '../kit/Art.astro';
import d from '../../art/faq-d.svg?raw';
import m from '../../art/faq-m.svg?raw';
import { SITE } from '../../data/site';
import { HOME_FAQ } from '../../data/faq';
---
<section class="faq sec" style="--h:780px" data-m-section aria-labelledby="faq-h" data-faq>
  <Art svg={d} class="dn-m fq-art" data-draw="" data-start="top 30%" data-end="bottom 45%" />
  <Art svg={m} class="dn-d fq-art" data-draw="" data-start="bottom 95%" data-end="bottom 55%" />
  <div class="ab" style="--x:120px;--y:130px;--w:460px">
    <Eyebrow text="Questions" data-t="1" />
    <h2 class="h2" id="faq-h" data-t="2"><span class="l1">Questions Surrey</span><span class="l2">homeowners ask.</span></h2>
    <p class="lead fq-lead" data-t="3"><span class="dn-m">Flip a switch and its answer slides onto the plate. Every answer ends the same way: call or text {SITE.phone}.</span><span class="dn-d">Flip a switch; its answer slides onto the plate below.</span></p>
  </div>
  <div class="plate ab" style="--x:620px;--y:120px" role="tablist" aria-label="Questions" data-t="3" data-fx="frame">
    <Screw s={14} rot={30} class="psc" style="left:117px;top:14px" /><Screw s={14} rot={30} class="psc" style="left:117px;bottom:14px" />
    {HOME_FAQ.map((f, i) => (
      <button type="button" class:list={['sw', i === 0 && 'is-on']} role="tab" id={`fqt-${i}`} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`fqp-${i}`} tabindex={i === 0 ? 0 : -1} data-sw>
        <span class="rk" aria-hidden="true"><i class="sl"></i><i class="sl sl2"></i><b></b></span>
        <span class="sw-n tech">0{i + 1}<span class="sw-on"> · On</span></span>
        <span class="sw-q"><span class="dn-m">{f.k}</span><span class="dn-d">{f.km}</span></span>
      </button>
    ))}
  </div>
  <i class="wire" aria-hidden="true" data-wire></i>
  <div class="ans ab" style="--x:900px;--y:120px" data-t="4" data-fx="frame">
    <Screw s={14} rot={30} class="asc" style="left:16px;top:16px" /><Screw s={14} rot={30} class="asc" style="right:16px;top:16px" />
    <Screw s={14} rot={30} class="asc dn-m" style="left:16px;bottom:16px" /><Screw s={14} rot={30} class="asc dn-m" style="right:16px;bottom:16px" />
    {HOME_FAQ.map((f, i) => (
      <div class="ap" id={`fqp-${i}`} role="tabpanel" aria-labelledby={`fqt-${i}`} hidden={i !== 0} data-ap>
        <p class="ap-b tech">Q0{i + 1} · On</p>
        <h3 class="ap-q">{f.q}</h3>
        <p class="ap-a">{'am' in f ? <><span class="dn-m">{f.a}</span><span class="dn-d">{f.am}</span></> : f.a}</p>
        <i class="ap-r" aria-hidden="true"></i>
        <a class="ap-l" href={SITE.tel}>Ask about your job: {SITE.phone} →</a>
        {'src' in f && <p class="ap-s dn-m">Source: {f.src}</p>}
      </div>
    ))}
  </div>
  <div class="ask ab" style="--x:120px;--y:420px" data-t="4">
    <Tape text="Ask Khinda." size={24} rot={4} class="ask-tape" />
    <h3 class="ask-h">Not on the list?</h3>
    <p class="ask-p">Send your question, with a photo if you can, to the same number.</p>
    <div class="ask-b">
      <Btn v="call" main="Call" sub={SITE.phone} class="ask-call" />
      <Btn v="text" main="Text it" sub="WhatsApp" href={SITE.whatsapp} class="ask-text" />
    </div>
  </div>
</section>
<style>
  .faq { background: var(--panel); z-index: 3; }
  .fq-art { z-index: 0; }
  .faq .h2 { margin-top: 19px; }
  .fq-lead { margin-top: 24px; width: 420px; }
  .plate { z-index: 2; width: 250px; height: 560px; padding: 34px 10px 0; background: #fff; border-radius: 14px; box-shadow: 0 12px 28px rgba(0, 0, 13, .18); }
  .plate :global(.psc), .ans :global(.asc) { position: absolute; }
  .sw { position: relative; display: flex; align-items: flex-start; width: 230px; height: 108px; margin-bottom: 16px; padding: 10px 12px; border-radius: 8px; text-align: left; cursor: pointer; transition: background-color .25s; }
  .sw:hover, .sw:focus-visible { background: #F1F2F5; }
  .sw:focus-visible { outline: 2px solid var(--blue, #2C5FB8); outline-offset: 2px; }
  .rk { position: relative; flex: none; width: 56px; height: 88px; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; }
  .sl { position: absolute; left: 22px; top: 7px; width: 12px; height: 4px; border-radius: 2px; background: var(--line); }
  .sl2 { top: auto; bottom: 7px; }
  .rk b { position: absolute; left: 13px; top: 38px; width: 28px; height: 36px; background: #fff; border: 1px solid #8F95A3; border-radius: 5px; box-shadow: 0 -3px 4px rgba(13, 15, 51, .16); transition: top .35s var(--ease-back), box-shadow .3s; }
  .rk b::before { content: ''; position: absolute; left: 6px; top: 5px; width: 14px; height: 3px; border-radius: 2px; background: var(--amber); opacity: 0; transition: opacity .25s; }
  .sw:hover .rk b { top: 32px; }
  .sw.is-on .rk b { top: 12px; box-shadow: 0 3px 4px rgba(13, 15, 51, .16); }
  .sw.is-on .rk b::before { opacity: 1; }
  .sw-n { position: absolute; left: 82px; top: 18px; font-size: 10px; line-height: 14px; letter-spacing: .12em; color: var(--steel); }
  .sw-on { display: none; }
  .sw.is-on .sw-n { color: var(--indigo); } .sw.is-on .sw-on { display: inline; }
  .sw-q { position: absolute; left: 82px; top: 38px; width: 140px; font-weight: 600; font-size: 15px; line-height: 20px; color: var(--ink); }
  .wire { position: absolute; left: 868px; top: calc(206px + var(--wi, 0) * 124px); width: 34px; height: 5px; border-radius: 3px; background: #2C5FB8; z-index: 1; transition: top .4s var(--ease-io); }
  .ans { z-index: 2; width: 420px; height: 520px; padding: 40px 40px 0; background: #fff; border-radius: 14px; box-shadow: 0 16px 36px rgba(0, 0, 13, .22); }
  .ap { position: relative; }
  .ap.in { animation: apin .5s var(--ease-out); }
  @keyframes apin { from { opacity: 0; transform: translateX(-24px); } }
  .ap-b { display: inline-block; width: 124px; height: 28px; padding: 6px 14px; background: var(--amber); border-radius: 4px; font-size: 11px; line-height: 16px; letter-spacing: .12em; color: var(--ink); }
  .ap-q { margin-top: 20px; font-family: var(--f-display); font-weight: 800; font-size: 28px; line-height: 32px; color: var(--indigo); }
  .ap-a { margin-top: 12px; font-size: 17px; line-height: 27px; }
  .ap-r { display: block; height: 1px; margin-top: 24px; background: var(--line); }
  .ap-l { display: inline-block; margin-top: 19px; font-weight: 600; font-size: 16px; line-height: 20px; color: var(--indigo); }
  .ap-l:hover { text-decoration: underline; text-underline-offset: 3px; }
  .ap-s { margin-top: 16px; font-size: 13px; line-height: 17px; color: var(--steel); }
  .ask { width: 440px; height: 240px; padding: 44px 28px 0; background: #fff; border: 1px solid var(--line); border-radius: 12px; box-shadow: 0 14px 30px rgba(13, 15, 51, .2); }
  .ask :global(.ask-tape) { position: absolute; left: 310px; top: -24px; padding: 6px 16px; line-height: 35px; }
  .ask-h { font-family: var(--f-display); font-weight: 800; font-size: 26px; line-height: 32px; color: var(--indigo); }
  .ask-p { margin-top: 2px; font-size: 16px; line-height: 24px; }
  .ask-b { display: flex; gap: 12px; margin-top: 20px; }
  .ask-b :global(.ask-call) { width: 164px; } .ask-b :global(.ask-text) { width: 108px; }
  @media (max-width: 1023px) {
    .faq { padding: 64px 20px 120px; display: flex; flex-direction: column; }
    .faq :global(.eyebrow) { font-size: 10px; line-height: 14px; gap: 8px; }
    .faq .h2 { margin-top: 10px; font-size: 30px; line-height: 34px; }
    .fq-lead { width: auto; margin-top: 12px; }
    .plate { position: relative; display: flex; justify-content: space-between; width: 100%; height: 150px; margin-top: 18px; padding: 14px 6px 0 12px; border-radius: 12px; }
    .plate :global(.psc) { display: none; }
    .sw { display: block; width: 80px; height: 128px; margin: 0; padding: 0 0 0 10px; }
    .sw:hover { background: none; }
    .rk { display: block; width: 48px; height: 75px; border-radius: 7px; }
    .sl { left: 18px; top: 6px; width: 11px; } .sl2 { bottom: 6px; }
    .rk b { left: 11px; top: 32px; width: 24px; height: 31px; }
    .sw:hover .rk b { top: 32px; }
    .sw.is-on .rk b { top: 10px; }
    .sw-n { left: 10px; top: 84px; letter-spacing: .1em; }
    .sw-q { left: 10px; top: 102px; width: auto; font-size: 13px; line-height: 17px; white-space: nowrap; }
    .wire { left: calc(60px + var(--wi, 0) * ((100% - 378px) / 3 + 80px)); top: 386px; width: 5px; height: 18px; }
    .ans { position: relative; width: 100%; height: auto; min-height: 318px; margin-top: 16px; padding: 32px 24px 24px; border-radius: 12px; }
    .ans :global(.asc) { top: 12px !important; }
    .ap-b { width: 104px; height: 26px; padding: 5px 12px; letter-spacing: .1em; }
    .ap-q { margin-top: 14px; font-size: 22px; line-height: 26px; }
    .ap-a { margin-top: 12px; font-size: 16px; line-height: 24px; }
    .ap-r { display: none; }
    .ap-l { margin-top: 16px; font-size: 15px; line-height: 19px; }
    .ask { position: relative; width: 100%; height: auto; margin-top: 88px; padding: 36px 20px 20px; }
    .ask :global(.ask-tape) { left: 190px; top: -16px; padding: 5px 12px; font-size: 20px; line-height: 29px; }
    .ask-h { font-size: 22px; line-height: 28px; }
    .ask-p { margin-top: 6px; font-size: 15px; line-height: 22px; }
    .ask-b { gap: 10px; margin-top: 18px; }
    .ask-b :global(.btn) { min-height: 61px; padding: 11px 18px; }
    .ask-b :global(.ask-call) { width: 150px; } .ask-b :global(.ask-text) { width: 99px; }
  }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-faq]').forEach((sec) => {
    const sws = Array.from(sec.querySelectorAll<HTMLButtonElement>('[data-sw]'));
    const aps = Array.from(sec.querySelectorAll<HTMLElement>('[data-ap]'));
    const open = (k: number, focus = false) => {
      sws.forEach((s, i) => { const on = i === k; s.classList.toggle('is-on', on); s.setAttribute('aria-selected', String(on)); s.tabIndex = on ? 0 : -1; });
      aps.forEach((p, i) => { const was = !p.hidden; p.hidden = i !== k; if (i === k && !was) { p.classList.remove('in'); void p.offsetWidth; p.classList.add('in'); } });
      sec.style.setProperty('--wi', String(k));
      if (focus) sws[k].focus();
    };
    sws.forEach((s, i) => {
      s.addEventListener('click', () => open(i));
      s.addEventListener('keydown', (e) => {
        const n = sws.length; let k = -1;
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') k = (i + 1) % n;
        else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') k = (i - 1 + n) % n;
        else if (e.key === 'Home') k = 0; else if (e.key === 'End') k = n - 1;
        if (k >= 0) { e.preventDefault(); open(k, true); }
      });
    });
  });
</script>
