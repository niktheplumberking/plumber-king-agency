---
// Panel screw (Figma "screw": grey head, darker rim, slot at its own angle). Decorative.
interface Props { s?: number; rot?: number; class?: string; style?: string }
const { s = 12, rot = 30, class: cls, style } = Astro.props;
---
<svg class:list={['screw', cls]} style={style} viewBox="0 0 12 12" width={s} height={s} aria-hidden="true" focusable="false"><circle cx="6" cy="6" r="5.4" fill="#D7DAE0" stroke="#8F95A3"/><rect x="2.15" y="5" width="7.7" height="2" rx=".4" fill="#6B7282" transform={`rotate(${-rot} 6 6)`}/></svg>
