<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  // 9.2 cable chips: filter the grid (the rest dim out and leave the reading order), live line says what shows.
  const chips = document.querySelectorAll<HTMLButtonElement>('.ow2-chip');
  const cards = document.querySelectorAll<HTMLElement>('[data-ow-grid] > li');
  const live = document.querySelector<HTMLElement>('[data-ow-live]');
  chips.forEach((c) => c.addEventListener('click', () => {
    const k = c.dataset.cat!;
    chips.forEach((o) => o.setAttribute('aria-pressed', String(o === c)));
    let n = 0;
    cards.forEach((card) => { const on = k === 'all' || card.dataset.cat === k; card.classList.toggle('off', !on); card.toggleAttribute('aria-hidden', !on); if (on) n++; });
    if (live) live.textContent = k === 'all' ? `Showing all ${cards.length} jobs.` : `Showing ${n} of ${cards.length} jobs: ${c.textContent}.`;
  }));
  // 9.3 clipboard pile (desktop, motion on): E-02 and E-03 start under E-01 and are dealt out while the section is pinned.
  const pile = document.querySelector<HTMLElement>('[data-ow-pile]');
  const afterHandoff = (f: () => void) => {
    let done = false; const go = () => { if (!done) { done = true; f(); } };
    window.addEventListener('pbp:handoff', go, { once: true }); setTimeout(go, 4000);
  };
  if (pile) afterHandoff(() => {
    if (!document.documentElement.classList.contains('motion')) return;
    gsap.matchMedia().add('(min-width: 1024px) and (prefers-reduced-motion: no-preference)', () => {
      const tl = gsap.timeline({ scrollTrigger: { trigger: pile, start: 'top+=230 top', end: '+=900', pin: true, scrub: 0.6 } });
      // the "before" sheet (E-01) tops the pile until the others are dealt out; then they rest over its edge as in Figma
      tl.fromTo('.ow3-e1', { zIndex: 3 }, { zIndex: 3, duration: 0.01 }, 0).set('.ow3-e1', { zIndex: 1 }, 1.55);
      tl.from('.ow3-e2', { x: 230, y: -510, rotation: -2, ease: 'power2.out', duration: 1 }, 0)
        .from('.ow3-e3', { x: -380, y: -520, rotation: 2.5, ease: 'power2.out', duration: 1 }, 0.6);
      return () => gsap.set('.ow3-e1', { clearProps: 'zIndex' });
    });
  });
</script>
