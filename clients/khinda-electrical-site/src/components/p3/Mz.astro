---
// Part 3 pages 06-10: mobile frames are drawn at Figma's 390 px (see p3.css). Base.astro already zooms the whole page to
// width / 390 from 391 to 1023 px, so the frame only needs its own zoom below 390 (360-389: shrink to fit, no side scroll).
---
<script is:inline>
  (function () {
    var r = document.documentElement;
    function f() { var w = innerWidth / (parseFloat(r.style.zoom) || 1); r.style.setProperty('--mz', w < 1024 ? String(Math.min(1, w / 390)) : '1'); }
    f(); addEventListener('resize', f, { passive: true });
    new MutationObserver(f).observe(r, { attributes: true, attributeFilter: ['style'] });
  })();
</script>
