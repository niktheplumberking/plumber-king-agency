---
// Part 3: a heavy, static drawn object (outlined copy inside the Figma layer) served as its own cached SVG file instead
// of inline markup. `raw` (the ?raw import, build time only) gives the Figma size; `src` is the ?url import. Lazy: the
// copy for the other breakpoint sits in a display:none box and is never fetched. Decorative: empty alt.
interface Props { raw: string; src: string; class?: string; style?: string; eager?: boolean; [k: string]: any }
const { raw, src, class: cls, style = '', eager = false, ...rest } = Astro.props;
const w = raw.match(/<svg[^>]*\swidth="(\d+)"/)?.[1] ?? '100';
const h = raw.match(/<svg[^>]*\sheight="(\d+)"/)?.[1] ?? '100';
---
<div class:list={['obj objimg', cls]} style={`--ow:${w}px;${style}`} aria-hidden="true" {...rest}><img src={src} width={w} height={h} alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" /></div>
<style>
  .obj { width: var(--ow); max-width: 100%; pointer-events: none; }
  .objimg img { display: block; width: 100%; height: auto; overflow: visible; }
</style>
