---
// 3.12 Related · pot-light cutouts (Figma 758:438, 1440x900; mobile 766:529). A dark ceiling with three pot-light cutouts,
// one per related service. STATE "cutouts switch on": hovering one switches it ON (white trim, photo at full strength, a
// flat warm cone below, the "See the page" chip) and dims the others. Mobile: the cutout in view switches on as you scroll.
import Img from '../ui/Img.astro';
import Eyebrow from '../kit/Eyebrow.astro';
import { pad } from './dm';
import type { SvcPage } from '../../data/service-pages';
import { TOWNS } from '../../data/site';
interface Props { p: SvcPage; bg?: string }
const { p, bg } = Astro.props;
const r = p.related;
---
<section class:list={['svl sec on-dark', bg, r.towns && 'has-towns']} style={`--h:${r.towns ? 980 : 900}px`} data-m-section aria-labelledby="svl-h">
  <div class="sv-hd sv-c ab" style="--x:120px;--y:96px;--w:1200px">
    <Eyebrow text="Related services" data-t="1" />
    <h2 class="h2" id="svl-h" data-t="2"><span class="l1">{r.h2[0]}</span><span class="l2">{r.h2[1]}</span></h2>
  </div>
  <div class="svl-ceil ab dn-m" style="--x:120px;--y:260px;--w:1200px" aria-hidden="true"><p class="sv-k">Three more circuits</p></div>
  <ul class="svl-g" role="list" data-cutouts data-stagger data-t="3">
    {r.items.map((it, i) => (
      <li class="svl-i on" style={`--i:${i}`} data-cut>
        <a href={`/services/${it.slug}/`} class="svl-a">
          <span class="svl-bd" aria-hidden="true"><span class="svl-cone"></span><span class="svl-ring"><span class="svl-ph"><Img name={it.photo.name} alt="" sizes="(min-width: 1024px) 232px, 152px" box={1} boxM={1} widths={[232, 320, 464]} /></span></span><span class="svl-chip">See the page →</span></span>
          <span class="sv-k svl-k">Service {pad(i + 1)}</span>
          <span class="svl-t">{it.t}</span>
          <span class="svl-b">{it.b}</span>
          <span class="sv-link amb svl-l" aria-hidden="true">See the page →</span>
        </a>
      </li>
    ))}
  </ul>
  {r.towns && (
    <nav class="svl-towns ab" style="--x:120px;--y:900px;--w:1200px" aria-label="Towns he works in">
      <span class="sv-k">Also in</span>
      <ul role="list">{TOWNS.map((t) => <li><a href={t.href}>{t.name}</a></li>)}</ul>
    </nav>
  )}
</section>
