---
// 2.6 Promises (Figma 740:437, 1440x840; mobile 749:625, 390x1330). Four round inspection stickers, each ticked in marker
// as the section scrolls in; the inspection tag counts up and at 4/4 a strip of tape lands across them: "Job checked out."
// (STATE 2.6). Without motion: all four ticked, tag 4/4, tape on.
import Img from '../ui/Img.astro';
import Eyebrow from '../kit/Eyebrow.astro';
import Btn from '../kit/Btn.astro';
import Screw from '../kit/Screw.astro';
import Tape from '../kit/Tape.astro';
import D from '../service-template/D.astro';
import { PROMISES, PICS } from './hub-data';
import { SITE } from '../../data/site';
const pad = (n: number) => String(n).padStart(2, '0');
// sticker (x, y) and text column x (desktop)
const SD: [number, number, number][] = [[560, 350, 744], [960, 350, 1144], [560, 540, 744], [960, 540, 1144]];
---
<section class="hpr sec" style="--h:840px" data-m-section aria-labelledby="hpr-h" data-stickers>
  <figure class="hpr-plate ab" style="--x:120px;--y:110px;--w:470px" data-t="3" data-fx="frame">
    <span class="hpr-ph"><Img name={PICS.ig57.name} alt={PICS.ig57.alt} sizes="(min-width: 1024px) 442px, calc(100vw - 64px)" box={442 / 572} boxM={326 / 306} widths={[360, 540, 720, 900]} focus={PICS.ig57.focus} /></span>
    <Screw s={12} rot={30} class="hpr-s1" /><Screw s={12} rot={115} class="hpr-s2" /><Screw s={12} rot={75} class="hpr-s3" /><Screw s={12} rot={160} class="hpr-s4" />
    <figcaption class="hpr-cap tech dn-m">Condo hallway · Commercial</figcaption>
  </figure>
  <div class="hpr-hd ab" style="--x:690px;--y:110px;--w:640px">
    <Eyebrow text="What he promises" data-t="1" />
    <h2 class="h2 hpr-h" id="hpr-h" data-t="2"><span class="l1">Four promises.</span><span class="l2">Ticked on every job.</span></h2>
    <p class="lead hpr-lead" data-t="3"><span class="dn-m">Like the inspection sticker on a finished panel: small, round, and only stuck on once the job checks out.</span><span class="dn-d">Small, round, and only stuck on once the job checks out.</span></p>
  </div>
  <ol class="hpr-list" role="list">
    {PROMISES.map((p, i) => (
      <li class="hpr-p on" data-sticker={i} style={`--sx:${SD[i][0]}px;--sy:${SD[i][1]}px;--tx:${SD[i][2]}px;--r:${-p.rot}deg`}>
        <span class="hpr-st" aria-hidden="true">
          <svg viewBox="-80 -80 160 160" width="160" height="160">
            <circle class="ok" r="78.5" fill="#fff" stroke="#15174A" stroke-width="3" />
            <circle class="ok" r="65.1" stroke="#F5A833" stroke-width="5" fill="none" />
            <circle class="nx" r="78" fill="#F3F4F6" stroke="#C9CDD6" stroke-width="3" stroke-dasharray="3 3" />
            <circle class="nx" r="64" fill="none" stroke="#D7DAE0" stroke-width="5" />
            <path class="tk" d="M-31 6L-12 31L36 -11" pathLength="1" />
          </svg>
          <span class="hpr-sn tech">{pad(i + 1)}</span>
          <span class="hpr-nx tech">Next</span>
        </span>
        <h3 class="hpr-t"><span>{p.t[0]}</span> <span>{p.t[1]}</span></h3>
        <p class="hpr-d"><D v={[p.d, p.m]} /></p>
      </li>
    ))}
  </ol>
  <Tape text="Job checked out." size={20} rot={4} class="hpr-done ab" style="--x:745px;--y:500px" aria-hidden="true" data-done />
  <div class="hpr-cta ab" style="--x:690px;--y:724px" data-t="4">
    <Btn v="call" sub="Ask him about your job" class="hpr-call" />
    <a class="sv-link dn-m" href={SITE.sms}>Or text a photo first →</a>
  </div>
  <p class="hpr-tag ab" style="--x:1150px;--y:714px;--w:180px" aria-live="polite">
    <span class="hpr-hole" aria-hidden="true"></span>
    <span class="tech hpr-tk">Inspection</span>
    <span class="hpr-tn"><span data-tick-n>4</span>/4 ticked</span>
    <span class="hpr-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
  </p>
</section>
