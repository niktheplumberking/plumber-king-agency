---
// Base layout: SEO head, site-wide Electrician JSON-LD + per-page JSON-LD, noindex switch, skip link, loader + curtain,
// G1/G2/G3, footer endings (F form, G5 towns strip, G6 footer: passed by the page), sticky mobile call bar, motion.
//   <Base title description path og="residential-electrical-panel-finished-labelled-surrey" jsonld={[...]}>
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SITE } from '../data/site';
import { businessSchema, websiteSchema, webPageSchema, isPageNode, abs } from '../lib/schema';
import { zoomSizes, zoomWidths } from '../components/ui/zoomSizes';
import mark from '../assets/brand/logo-ig-upscaled-600.png';
import UtilityBar from '../components/global/UtilityBar.astro';
import Header from '../components/global/Header.astro';
import EmergencyStrip from '../components/global/EmergencyStrip.astro';
import MobileCallBar from '../components/global/MobileCallBar.astro';
import Loader from '../components/global/Loader.astro';
import Curtain from '../components/kit/Curtain.astro';

interface Props {
  title: string; description: string; path: string; og?: string; ogAlt?: string; jsonld?: object[];
  noindex?: boolean; loader?: boolean; navPath?: string;
  preload?: { name: string; sizes: string; widths: number[] };
}
const { title, description, path, og = 'residential-electrical-panel-finished-labelled-surrey', ogAlt, jsonld = [], noindex, loader = true, navPath, preload } = Astro.props;
const envNoindex = String(import.meta.env.PUBLIC_NOINDEX ?? 'true').toLowerCase() !== 'false';
const robots = noindex || envNoindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const canonical = abs(path);
const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/*.jpg', { eager: true });
const ogSrc = photos[`/src/assets/photos/${og}.jpg`]?.default;
if (!ogSrc) throw new Error(`Base: og photo "${og}" not found`);
const ogImg = await getImage({ src: ogSrc, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 78 });
const ogUrl = new URL(ogImg.src, Astro.site).href;
const logoImg = await getImage({ src: mark, width: 512, format: 'png' });
const logoUrl = new URL(logoImg.src, Astro.site).href;
const entityImg = await getImage({ src: photos['/src/assets/photos/residential-electrical-panel-finished-labelled-surrey.jpg'].default, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 78 });
let lcpSet: string | undefined; let lcpSizes: string | undefined;
if (preload) {
  const src = photos[`/src/assets/photos/${preload.name}.jpg`]?.default;
  if (!src) throw new Error(`Base: preload photo "${preload.name}" not found`);
  const z = zoomSizes(preload.sizes);
  const img = await getImage({ src, widths: zoomWidths(preload.widths, z.slot, src.width), sizes: z.sizes, format: 'avif', quality: 60 });
  lcpSet = img.srcSet.attribute; lcpSizes = z.sizes;
}
const is404 = path === '/404/';
const ownPage = jsonld.find(isPageNode);
const pageNode = noindex || is404 ? [] : [webPageSchema({ path, title, description, image: ogUrl, existing: ownPage })];
const ld = [businessSchema(logoUrl, new URL(entityImg.src, Astro.site).href), websiteSchema(), ...pageNode, ...jsonld.filter((o) => o !== ownPage)];
---
<!doctype html>
<html lang="en-CA" data-loader={loader ? undefined : 'off'}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {!is404 && <link rel="canonical" href={canonical} />}
  <meta name="robots" content={robots} />
  <meta name="theme-color" content="#0D0F33" />
  <meta name="format-detection" content="telephone=no" />
  <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  {lcpSet && <link rel="preload" as="image" type="image/avif" imagesrcset={lcpSet} imagesizes={lcpSizes} fetchpriority="high" />}
  <link rel="preload" href="/fonts/saira-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/onest-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/onest-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/michroma-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:locale" content="en_CA" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {!is404 && <meta property="og:url" content={canonical} />}
  <meta property="og:image" content={ogUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogAlt ?? `${SITE.name}, electrician in Surrey, BC`} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogUrl} />
  <meta name="geo.region" content="CA-BC" />
  <meta name="geo.placename" content="Surrey" />
  <meta name="geo.position" content={`${SITE.geo.lat};${SITE.geo.lng}`} />
  {/* Zoom fit (Mike's Base): from 1024 px up the whole 1440 Figma layout is scaled with CSS zoom = width / 1440, so every
     desktop width keeps Figma proportions (1024-1279 = the tablet pass, same layout smaller). Below 1024: the 390 frames,
     fluid 360-390; 391-1023 renders the 390 layout scaled up (zoom = width / 390), because the mobile art layers are drawn to
     the 390 frame and drift from the reflowed copy on a wider column. */}
  <script is:inline>
    (function () {
      var d = document.documentElement, sb = 0;
      try { var o = d.style.overflowY; d.style.overflowY = 'scroll'; sb = Math.max(0, window.innerWidth - d.clientWidth); d.style.overflowY = o; } catch (e) {}
      function fit() {
        var w = d.clientWidth || window.innerWidth;
        if (!document.body) w = window.innerWidth - sb;
        var z = w >= 1024 ? Math.round(w / 1440 * 10000) / 10000 : w > 390 ? Math.round(w / 390 * 10000) / 10000 : 1;
        var s = z !== 1 ? String(z) : '';
        if (d.style.zoom !== s) { d.style.zoom = s; d.style.setProperty('--zoom', String(z)); }
      }
      fit();
      window.addEventListener('resize', fit);
      document.addEventListener('DOMContentLoaded', function () { fit(); if (window.ResizeObserver) new ResizeObserver(fit).observe(d); });
    })();
  </script>
  {/* Motion on? loader this visit (once per session)? curtain lift after an in-site click? 3.5 s safety: show everything. */}
  <script is:inline>
    (function () {
      var d = document.documentElement; d.classList.add('js');
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) { d.classList.add('no-motion'); return; }
      d.classList.add('motion');
      var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
      var hist = nav && nav.type === 'back_forward';
      var seen = false, internal = false;
      try { seen = sessionStorage.getItem('ke-intro') === '1'; internal = sessionStorage.getItem('ke-nav') === '1'; sessionStorage.removeItem('ke-nav'); } catch (e) {}
      if (!seen && !hist && d.getAttribute('data-loader') !== 'off') d.classList.add('intro', 'cv');
      else if (internal && !hist) { d.classList.add('pt-in'); try { history.scrollRestoration = 'manual'; } catch (e) {} }
      setTimeout(function () { d.classList.remove('cv'); if (!window.__pbpMotion) d.classList.remove('motion', 'intro', 'pt-in'); }, 3500);
    })();
  </script>
  {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  <slot name="head" />
</head>
<body>
  <a href="#main" class="skip">Skip to content</a>
  {loader && <Loader />}
  <Curtain />
  <UtilityBar />
  <Header path={navPath ?? path} />
  <EmergencyStrip home={path === '/'} />
  <main id="main" tabindex="-1"><slot /></main>
  <slot name="end" />
  <MobileCallBar />
  <script>import '../scripts/ui'; import '../scripts/forms'; import '../scripts/motion';</script>
</body>
</html>
