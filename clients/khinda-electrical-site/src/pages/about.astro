---
// About (Figma 06). Endings: F (generic), G5, G6.
import '../components/p3/p3.css';
import Base from '../layouts/Base.astro';
import Mz from '../components/p3/Mz.astro';
import About from '../components/about/About.astro';
import Endings from '../components/endings/Endings.astro';
import { breadcrumbSchema } from '../lib/schema';
const title = 'About Khinda Electrical · Surrey Electrician';
const description = 'Khinda Electrical is an electrician based in Surrey, BC: domestic, commercial work and renovations, filmed on his own Instagram and YouTube since 2018.';
---
<Base title={title} description={description} path="/about/" og="residential-electrical-panel-rough-in-surrey" ogAlt="Residential electrical panel rough-in by Khinda Electrical"
  preload={{ name: 'residential-electrical-panel-rough-in-surrey', sizes: '(min-width: 1024px) 680px, 100vw', widths: [360, 540, 720, 960] }}
  jsonld={[breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'About', path: '/about/' }]), { '@type': 'AboutPage' }]}>
  <Mz />
  <About />
  <Endings slot="end" />
</Base>
