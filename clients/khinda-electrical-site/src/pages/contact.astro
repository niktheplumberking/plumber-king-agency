---
// Contact (Figma 07). 7.3 is the shared F form (inside Contact), so the endings are G5 + G6 only.
import '../components/p3/p3.css';
import Base from '../layouts/Base.astro';
import Mz from '../components/p3/Mz.astro';
import Contact from '../components/contact/Contact.astro';
import Endings from '../components/endings/Endings.astro';
import { breadcrumbSchema } from '../lib/schema';
---
<Base title="Contact Khinda Electrical · Surrey, BC" path="/contact/" navPath="/contact/"
  description="Call or text Khinda Electrical at 236-818-2664, WhatsApp on the same number, or send the panel schedule form. Based in Surrey, BC."
  og="google-maps-surrey-bc-base" ogAlt="Google Maps screenshot of Surrey, BC, where Khinda Electrical is based"
  jsonld={[breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact/' }]), { '@type': 'ContactPage' }]}>
  <Mz />
  <Contact />
  <Endings slot="end" form={false} />
</Base>
