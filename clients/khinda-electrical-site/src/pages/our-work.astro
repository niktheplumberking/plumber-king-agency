---
// Our work (Figma 09). His own job photos from @khinda__electrical only; Instagram numbers dated 17 Nov 2026. Endings: F, G5, G6.
import '../components/p3/p3.css';
import Base from '../layouts/Base.astro';
import Mz from '../components/p3/Mz.astro';
import OurWork from '../components/ourwork/OurWork.astro';
import Endings from '../components/endings/Endings.astro';
import { breadcrumbSchema } from '../lib/schema';
---
<Base title="Recent Electrical Projects in Surrey · Khinda" path="/our-work/"
  description="Recent electrical work by Khinda Electrical across Surrey: chandeliers, pot lights, panels, shop fit-outs and fire alarms. Every photo is his own."
  og="crystal-chandelier-installed-surrey" ogAlt="Crystal chandelier installed by Khinda Electrical"
  jsonld={[breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Our work', path: '/our-work/' }]), { '@type': 'CollectionPage' }]}>
  <Mz />
  <OurWork />
  <Endings slot="end" />
</Base>
<style>
  /* Figma draws this page's mobile buttons 62px high (the other pages: 66) */
  @media (max-width: 1023px) { :global(#main) { --btn-mh: 62px; } }
</style>
