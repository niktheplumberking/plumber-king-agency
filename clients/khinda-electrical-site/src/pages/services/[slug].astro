---
// Service pages: Figma 03 Panel upgrades is the template (1:1 on /services/panel-upgrades/); the other seven reuse it with
// copy from PAGE-SHEET Facts + SEO-PLAN only (src/data/service-pages.ts). A section a service cannot source is left out;
// when two light sections end up side by side, the second one switches white / panel grey so the join still reads.
import Base from '../../layouts/Base.astro';
import Endings from '../../components/endings/Endings.astro';
import SvHero from '../../components/service-template/SvHero.astro';
import SvQuick from '../../components/service-template/SvQuick.astro';
import SvSigns from '../../components/service-template/SvSigns.astro';
import SvDiy from '../../components/service-template/SvDiy.astro';
import SvProcess from '../../components/service-template/SvProcess.astro';
import SvCompare from '../../components/service-template/SvCompare.astro';
import SvPricing from '../../components/service-template/SvPricing.astro';
import SvSignoff from '../../components/service-template/SvSignoff.astro';
import SvWhy from '../../components/service-template/SvWhy.astro';
import SvPrevent from '../../components/service-template/SvPrevent.astro';
import SvFaq from '../../components/service-template/SvFaq.astro';
import SvRelated from '../../components/service-template/SvRelated.astro';
import SvCta from '../../components/service-template/SvCta.astro';
import '../../components/service-template/sv.css';
import { SERVICE_PAGES } from '../../data/service-pages';
import { serviceSchema, faqSchema, breadcrumbSchema } from '../../lib/schema';
export function getStaticPaths() { return SERVICE_PAGES.map((p) => ({ params: { slug: p.slug } })); }
const p = SERVICE_PAGES.find((x) => x.slug === Astro.params.slug)!;
const path = `/services/${p.slug}/`;
// background per section (Figma) and the light-on-light switch
const plan: [string, any, string][] = [
  ['quick', SvQuick, 'p'], ['signs', p.signs && SvSigns, 'w'], ['diy', p.diy && SvDiy, 'd'], ['process', SvProcess, 'p'],
  ['compare', p.compare && SvCompare, 'd'], ['pricing', p.pricing && SvPricing, 'w'], ['signoff', p.signoff && SvSignoff, 'p'],
  ['why', SvWhy, 'd'], ['prevent', p.prevent && SvPrevent, 'w'], ['faq', SvFaq, 'p'], ['related', SvRelated, 'd'], ['cta', SvCta, 'd'],
];
let prev = 'd';
const secs = plan.filter(([, C]) => C).map(([k, C, b]) => {
  let cls: string | undefined;
  if (b !== 'd' && b === prev) { b = b === 'w' ? 'p' : 'w'; cls = b === 'w' ? 'bg-w' : 'bg-p'; }
  prev = b;
  return { k, C, cls };
});
const ans = p.quick.answer;
---
<Base title={p.title} description={p.description} path={path} navPath="/services/" og={p.hero.plate?.name ?? 'residential-electrical-panel-finished-labelled-surrey'}
  ogAlt={p.hero.plate?.alt}
  jsonld={[
    breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Services', path: '/services/' }, { name: p.name, path }]),
    serviceSchema({ name: p.name, path, description: ans }),
    faqSchema(p.faq.items.map((f) => ({ q: f.q, a: f.a }))),
  ]}
  preload={{ name: p.hero.bg.name, sizes: '(min-width: 1024px) 330px, 100vw', widths: [390, 660, 780] }}>
  <SvHero p={p} />
  {secs.map(({ C, cls }) => <C p={p} bg={cls} />)}
  <Endings slot="end" />
</Base>
<script>import '../../components/service-template/sv.ts';</script>
