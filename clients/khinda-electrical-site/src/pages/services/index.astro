---
import Stub from '../../components/stub/Stub.astro';
import { SERVICES } from '../../data/site';
---
<Stub title="Electrical Services in Surrey, BC · Khinda Electrical" path="/services/"
  description="Panels, lighting, EV chargers, renos and commercial fit-outs across Surrey, BC. Call or text Khinda Electrical at 236-818-2664."
  eyebrow="Services · Surrey, BC" h1={['Electrical Services', 'in Surrey']} crumbs={[{ name: 'Services', path: '/services/' }]}
  lead="Panels, lighting, EV chargers, renos and commercial fit-outs across Surrey. Pick the job below, or text a photo of it.">
  <ul class="st-list ab" role="list" style="--x:920px;--y:150px;--w:400px">{SERVICES.map((s) => <li><a href={s.href}>{s.name}</a></li>)}</ul>
</Stub>
<style>
  .st-list { display: grid; gap: 12px; margin: 0; padding: 0; }
  .st-list a { font-weight: 600; font-size: 18px; line-height: 24px; color: #fff; }
  .st-list a:hover { color: var(--amber); }
  @media (max-width: 1023px) { .st-list { margin-top: 36px; } }
</style>
