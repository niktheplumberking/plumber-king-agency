---
// After a form send (no Figma frame; built from the system: indigo hero, main breaker from the F form). Promises nothing
// about timing. The copy follows PUBLIC_FORM_ENDPOINT at build: unset (preview) = the form sent nothing, so the page says so
// and points to the phone.
import '../components/p3/p3.css';
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/kit/Eyebrow.astro';
import Btn from '../components/kit/Btn.astro';
import Endings from '../components/endings/Endings.astro';
import { FORM_ENDPOINT } from '../lib/form';
import { SITE } from '../data/site';
const sent = !!FORM_ENDPOINT;
const NEXT = [
  ['01', 'Have a photo?', 'Text it to the same number: the panel, outlet or fixture, with your town.', SITE.sms, 'Text a photo →'],
  ['02', 'See his work', 'Panels, chandeliers, pot lights and shop fit-outs, all his own photos.', '/our-work/', 'Our work →'],
  ['03', 'Got a question?', 'Permits, panels, EV chargers and booking, answered for Surrey.', '/faq/', 'Read the FAQ →'],
] as const;
---
<Base title="Thanks · Khinda Electrical" path="/thank-you/" description={`Thanks for your message to Khinda Electrical, Surrey, BC. To talk now, call or text ${SITE.phone}.`} noindex>
  <section class="pl-hero ty on-dark p3s" data-m-section data-m-hero aria-labelledby="h1">
    <div class="pl-in">
      <Eyebrow text={sent ? 'Sent · thank you' : 'Thank you'} data-t="1" />
      <h1 class="h1" id="h1" data-t="2"><span class="l1">Thanks.</span><span class="l2">{sent ? 'Main breaker on.' : 'Call or text to talk now.'}</span></h1>
      <p class="lead" data-t="3">{sent
        ? `Your details went to Khinda Electrical. To add anything, or to talk now, call or text ${SITE.phone}.`
        : `This form doesn’t send anything yet, so nothing reached him. Call or text ${SITE.phone} and tell him about the job.`}</p>
      <div class="pl-cta" data-t="4"><Btn v="call" /><Btn v="text" tone="dark" /></div>
      <div class="ty-main" aria-hidden="true"><span class:list={['ty-mb', !sent && 'off']}><i></i></span><span class="tech">Main · {sent ? 'on' : 'off'}</span></div>
    </div>
  </section>
  <section class="pl-field p3s" data-m-section aria-labelledby="ty-n">
    <h2 class="sr-only" id="ty-n">Next, if you like</h2>
    <ul class="ty-next" role="list">
      {NEXT.map(([n, t, p, h, l]) => (
        <li><span class="tech">{n}</span><h3>{t}</h3><p>{p}</p><a href={h}>{l}</a></li>
      ))}
    </ul>
  </section>
  <Endings slot="end" form={false} />
</Base>
<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .ty-main { position: absolute; right: 60px; top: 70px; display: grid; justify-items: center; gap: 12px; padding: 22px 26px 16px; border-radius: 10px; background: var(--deep); box-shadow: 0 18px 40px rgba(13,15,51,.4); }
  .ty-main .tech { font-size: 10px; line-height: 14px; color: var(--mist); white-space: nowrap; }
  .ty-mb { position: relative; width: 44px; height: 70px; border-radius: 6px; background: #1E2160; box-shadow: inset 0 0 0 2px #2B2F73; }
  .ty-mb i { position: absolute; left: 8px; top: 8px; width: 28px; height: 26px; border-radius: 3px; background: var(--amber); }
  .ty-mb.off i { transform: translateY(28px); background: var(--mist); }
  :global(html.motion) .ty-mb:not(.off) i { animation: ty-flip .6s var(--ease-back) .5s both; }
  @keyframes ty-flip { from { transform: translateY(28px); background: var(--mist); } to { transform: none; background: var(--amber); } }
  .ty-next { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; max-width: 1200px; margin: 0 auto; padding: 0; list-style: none; }
  .ty-next li { position: relative; padding: 26px 28px 28px; border-radius: 12px; background: #fff; box-shadow: inset 0 0 0 1px #D9DCE3; }
  .ty-next .tech { font-size: 11px; line-height: 16px; color: var(--steel); }
  .ty-next h3 { margin: 6px 0 0; font-family: var(--f-display); font-weight: 800; font-size: 22px; line-height: 28px; color: var(--indigo); }
  .ty-next p { margin: 8px 0 0; font-size: 16px; line-height: 25px; color: var(--ink); }
  .ty-next a { display: inline-block; margin-top: 14px; font-weight: 600; font-size: 16px; line-height: 20px; color: var(--indigo); }
  .ty-next a::after { content: ''; position: absolute; inset: 0; border-radius: 12px; }
  .ty-next li:hover { box-shadow: inset 0 0 0 2px var(--indigo); }
  .ty-next a:focus-visible { outline: none; } .ty-next li:has(a:focus-visible) { box-shadow: inset 0 0 0 3px var(--indigo); }
  @media (max-width: 1023px) {
    .ty-main { position: static; justify-self: start; display: inline-grid; margin-top: 32px; }
    .ty-next { grid-template-columns: 1fr; gap: 12px; }
  }
</style>
