---
// 7.1 Hero (Figma 669:890 / 670:2287): the ink logo at full size as the centerpiece inside two hex halos, "EST 2025" huge in
// Oswald, H1 + script line left, body right, the commercial-job polaroid hanging over the seam. Positions = the node dump.
import { Image } from 'astro:assets';
import logo from '../../assets/brand/logo-ink.png';
import Img from '../ui/Img.astro';
---
<section class="ah" aria-labelledby="ah-h1" data-m-section data-m-hero>
  <div class="ah-in">
    <svg class="ah-halo" viewBox="0 0 782 542" aria-hidden="true"><path d="M102.15 0.75H679.35L780.75 270.75L679.35 540.75H102.15L0.75 270.75L102.15 0.75Z" /></svg>
    <svg class="ah-halo2" viewBox="0 0 941 641" aria-hidden="true"><path d="M122.7 0.5H818.3L940.5 320.5L818.3 640.5H122.7L0.5 320.5L122.7 0.5Z" /></svg>
    <svg class="ah-halo-m" viewBox="0 0 322 232" aria-hidden="true"><path d="M42.2 0.6H279L320.6 115.6L279 230.6H42.2L0.6 115.6Z" /></svg>
    <p class="ah-eb" data-t="1">About · Family owned &amp; operated</p>
    <div class="ah-logo" data-t="2"><Image src={logo} alt="Mike's Plumbing Services logo, EST 2025" widths={[240, 440, 880]} sizes="(min-width: 768px) 440px, 240px" loading="eager" /></div>
    <p class="ah-est" data-t="2" aria-hidden="true"><span>EST</span> 2025</p>
    <h1 id="ah-h1" class="ah-h1" data-t="3">About Mike's Plumbing Services, Riverside, CA</h1>
    <p class="ah-script" data-t="3">Friendly. Transparent. Proficient.</p>
    <p class="ah-body" data-t="3">Mike's Plumbing Services is Mike Navarro's family-owned and operated plumbing business in Riverside, California. EST 2025. Residential and commercial, across the Inland Empire, Orange County and LA.</p>
    <figure class="ah-card">
      <div class="ah-photo"><Img name="commercial-plumbing-job-vans" alt="Mike's Plumbing Services work vans parked on a commercial job" sizes="(min-width: 768px) 250px, 184px" widths={[250, 500]} /></div>
      <figcaption class="ah-cap">On a commercial job · Mike's IG</figcaption>
    </figure>
    <span class="ah-tape" aria-hidden="true"></span>
  </div>
</section>
<style>
  .ah { position: relative; height: 920px; background: var(--paper); }
  .ah-in { position: relative; width: 1440px; height: 100%; margin: 0 auto; }
  .ah-halo, .ah-halo2, .ah-halo-m { position: absolute; fill: none; stroke: var(--tan); stroke-linejoin: round; }
  .ah-halo { left: 330px; top: 80px; width: 782px; height: 542px; stroke-width: 1.5; }
  .ah-halo2 { left: 250px; top: 30px; width: 941px; height: 641px; stroke-width: 1; stroke-dasharray: 2 8; }
  .ah-halo-m { display: none; }
  .ah-eb { position: absolute; left: 0; right: 0; top: 56px; text-align: center; font-family: var(--f-label); font-weight: 500; font-size: 14px; line-height: 21px; letter-spacing: .14em; text-transform: uppercase; color: var(--tan-dark); }
  .ah-logo { position: absolute; left: 500px; top: 110px; width: 440px; height: 290px; }
  .ah-logo :global(img) { width: 100%; height: 100%; object-fit: contain; }
  .ah-est { position: absolute; left: 0; right: 0; top: 396px; text-align: center; font-family: var(--f-label); font-weight: 700; font-size: 220px; line-height: 220px; letter-spacing: .02em; color: var(--ink); white-space: nowrap; }
  .ah-est span { color: var(--tan-dark); }
  .ah-h1 { position: absolute; left: 120px; top: 686px; width: 560px; font-family: var(--f-display); font-weight: 400; font-size: 44px; line-height: 1.08; color: var(--ink); }
  .ah-script { position: absolute; left: 120px; top: 796px; font-family: var(--f-script); font-size: 32px; line-height: 47px; color: var(--tan-dark); white-space: nowrap; }
  .ah-body { position: absolute; left: 720px; top: 696px; width: 330px; font-size: 16px; line-height: 1.6; color: var(--ink-2); }
  .ah-card { position: absolute; z-index: 5; left: 1086px; top: 640px; width: 270px; height: 340px; margin: 0; padding: 10px; background: var(--bone); transform: rotate(5deg); transform-origin: 0 0; box-shadow: 0 14px 28px rgba(30, 24, 14, .22); }
  .ah-photo { width: 250px; height: 270px; overflow: hidden; }
  .ah-cap { margin: 16px 0 0 2px; font-family: var(--f-label); font-weight: 500; font-size: 10.5px; line-height: 16px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-2); }
  .ah-tape { position: absolute; z-index: 5; left: 1150px; top: 632px; width: 96px; height: 26px; background: rgba(210, 197, 166, .9); transform: rotate(-4deg); transform-origin: 0 0; }

  @media (max-width: 1279px) {
    .ah { height: auto; padding: 28px 0 0; }
    .ah-in { width: calc(100% - 2 * var(--gutter)); max-width: 760px; height: auto; display: flex; flex-direction: column; }
    .ah-halo, .ah-halo2 { display: none; }
    .ah-halo-m { display: block; left: 50%; top: 22px; width: 322px; height: 232px; margin-left: -161px; stroke-width: 1.2; }
    .ah-eb, .ah-logo, .ah-est, .ah-h1, .ah-script, .ah-body, .ah-card { position: relative; left: auto; top: auto; right: auto; }
    .ah-eb { font-size: 12px; line-height: 18px; letter-spacing: .12em; }
    .ah-logo { width: 240px; height: 160px; margin: 24px auto 0; }
    .ah-est { margin-top: 6px; font-size: 96px; line-height: 96px; letter-spacing: 0; }
    .ah-h1 { width: auto; margin-top: 34px; font-size: 32px; line-height: 1.1; }
    .ah-script { margin-top: 8px; font-size: 24px; line-height: 35px; white-space: normal; }
    .ah-body { width: auto; margin-top: 14px; font-size: 15px; line-height: 1.55; }
    .ah-card { align-self: flex-end; width: 200px; height: 250px; margin: 10px 10px -60px 0; padding: 8px; }
    .ah-photo { width: 184px; height: 196px; }
    .ah-cap { margin-top: 12px; font-size: 8px; line-height: 12px; }
    .ah-tape { display: none; }
  }
  @media (min-width: 768px) and (max-width: 1279px) {
    .ah { padding-top: 56px; }
    .ah-halo-m { top: 30px; width: 480px; height: 346px; margin-left: -240px; }
    .ah-logo { width: 340px; height: 226px; margin-top: 40px; }
    .ah-est { font-size: 150px; line-height: 150px; }
    .ah-h1 { font-size: 44px; }
    .ah-body { font-size: 16px; max-width: 520px; }
    .ah-card { width: 250px; height: 310px; margin-top: -120px; padding: 10px; }
    .ah-photo { width: 230px; height: 240px; }
    .ah-cap { font-size: 10px; }
  }
</style>
