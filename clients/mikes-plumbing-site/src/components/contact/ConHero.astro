---
// 10.1 Hero + form (Figma 669:438 y 180-1038 / 670:1594 y 164-~713). Ink field. Left: eyebrow, 4-line H1 (last words tan),
// his flyer line in Yesteryear script, the tan phone tile ("Call Mike Navarro" + the number, tel:), an Oswald meta line.
// Right (desktop) / below (phone): the free-estimate ticket, a bone card that hangs over the wave into the next section:
// step track (1 The problem, 2 The place, 3 You; the track follows the field you are in), hex chips as real checkboxes,
// details, photo, town/ZIP, Home|Business, name, phone, email, submit. forms.ts validates and goes to /thank-you.
import { SITE } from '../../data/site';
import Eyebrow from '../kit-b4/Eyebrow.astro';
const problems = ['Drain or sewer', 'Leak', 'Water heater', 'Toilet, sink or faucet', 'Garbage disposal', 'Water filtration', 'Emergency', 'Something else'];
const steps = [['1', 'The problem'], ['2', 'The place'], ['3', 'You']];
const hex = 'M7 1h26l6 16-6 16H7L1 17z';
---
<section class="ch on-ink" aria-labelledby="ch-h" data-m-section data-m-hero>
  <div class="wrap ch-in">
    <div class="ch-copy">
      <Eyebrow text="Contact · Free estimate" />
      <h1 id="ch-h" class="ch-h1" data-t="2">Get a Free Plumbing Estimate <span class="tn">in Riverside, CA</span></h1>
      <p class="ch-script" data-t="3" data-fx="nudge">Call today for free estimate!</p>
      <a class="ch-tile" href={SITE.tel} data-t="4">
        <span class="ch-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z" fill="currentColor"/></svg></span>
        <span class="ch-tt"><span class="ch-who">Call {SITE.owner}</span><span class="ch-num">{SITE.phone}</span></span>
      </a>
      <p class="ch-meta" data-t="3">{SITE.hoursYelp} <span aria-hidden="true">·</span> Free estimate <span aria-hidden="true">·</span> Family owned &amp; operated <span class="ch-off"><span aria-hidden="true">·</span> {SITE.offer}</span></p>
    </div>
    <form class="ch-form" data-estimate-form method="post" action="/thank-you" novalidate aria-labelledby="ch-fh" data-t="4" data-fx="up" enctype="multipart/form-data">
      <h2 id="ch-fh" class="ch-fh">Free estimate request</h2>
      <ol class="ch-steps" role="list" aria-label="Three short steps">
        {steps.map(([n, l], i) => (
          <li class:list={['ch-step', i === 0 && 'is-on']} data-step={n}>
            <svg viewBox="0 0 40 34" aria-hidden="true"><path d={hex} /></svg><span class="ch-sn" aria-hidden="true">{n}</span><span class="ch-sl">{l}</span>
          </li>
        ))}
      </ol>
      <fieldset class="ch-fs" data-part="1">
        <legend class="ch-q">1 · What's going on?</legend>
        <div class="ch-chips">
          {problems.map((p, i) => (
            <label class="ch-chip"><input type="checkbox" name="problem" value={p} checked={i === 1} /><span>{p}</span></label>
          ))}
        </div>
        <label class="ch-lab" for="ch-more">Tell us more (optional)</label>
        <textarea id="ch-more" name="details" rows="3" placeholder="Where is it, how long has it been going on..."></textarea>
        <label class="ch-photo"><input type="file" name="photo" accept="image/*" data-photo /><span data-photo-label><span aria-hidden="true">+</span> Add a photo (optional)</span></label>
      </fieldset>
      <fieldset class="ch-fs" data-part="2">
        <legend class="ch-q">2 · Where?</legend>
        <div class="ch-row">
          <label class="ch-in"><span class="sr-only">Town or ZIP</span><input type="text" name="town" autocomplete="postal-code" placeholder="Town or ZIP" /></label>
          <div class="ch-seg" role="radiogroup" aria-label="Home or business?">
            <label><input type="radio" name="place" value="Home" checked /><span>Home</span></label>
            <label><input type="radio" name="place" value="Business" /><span>Business</span></label>
          </div>
        </div>
      </fieldset>
      <fieldset class="ch-fs" data-part="3">
        <legend class="ch-q">3 · You</legend>
        <div class="ch-row">
          <label class="ch-in"><span class="sr-only">Name</span><input type="text" name="name" autocomplete="name" placeholder="Name" required /></label>
          <label class="ch-in"><span class="sr-only">Phone</span><input type="tel" name="phone" autocomplete="tel" inputmode="tel" placeholder="Phone" required /></label>
        </div>
        <label class="ch-in ch-full"><span class="sr-only">Email (optional)</span><input type="email" name="email" autocomplete="email" placeholder="Email (optional)" /></label>
      </fieldset>
      <button type="submit" class="ch-go"><span>Get my free estimate</span><span class="ch-c" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><path d="M4 12h15m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></span></button>
      <p class="ch-msg" data-form-msg role="status" aria-live="polite"></p>
      <p class="ch-note">We'll use your details only to reply to you. <a href="/privacy">Privacy policy</a></p>
    </form>
  </div>
</section>
<script>
  // The step track follows the part of the form you are in (visual only; every field stays visible).
  document.querySelectorAll<HTMLFormElement>('.ch-form').forEach((f) => {
    const steps = Array.from(f.querySelectorAll<HTMLElement>('.ch-step'));
    f.addEventListener('focusin', (e) => {
      const part = (e.target as Element).closest<HTMLElement>('[data-part]')?.dataset.part;
      if (part) steps.forEach((s) => s.classList.toggle('is-on', s.dataset.step === part));
    });
  });
</script>
<style>
  .ch { position: relative; height: 858px; background: var(--ink); color: var(--paper); }
  .ch-in { position: relative; height: 100%; }
  .ch-copy { position: absolute; left: 0; top: 84px; width: 560px; }
  .ch-h1 { margin-top: 13px; width: 470px; font-family: var(--f-display); font-weight: 400; font-size: 70px; line-height: 73px; color: var(--paper); }
  .tn { color: var(--tan); }
  .ch-script { margin-top: 18px; font-family: var(--f-script); font-size: 42px; line-height: 50px; color: var(--tan); }
  .ch-tile { display: flex; align-items: center; gap: 24px; width: 540px; height: 150px; margin-top: 30px; padding: 0 24px; border-radius: 4px; background: var(--tan); color: var(--ink); transition: background-color var(--dur-2); }
  .ch-tile:hover { background: var(--paper); }
  .ch-tile:focus-visible { outline-color: var(--tan); }
  .ch-ico { display: grid; place-items: center; flex: none; width: 96px; height: 96px; border-radius: 4px; background: var(--ink); color: var(--tan); }
  .ch-ico svg { width: 44px; height: 44px; }
  .ch-tt { display: grid; gap: 10px; }
  .ch-who { font-weight: 600; font-size: 18px; line-height: 22px; }
  .ch-num { font-family: var(--f-label); font-weight: 500; font-size: 60px; line-height: 56px; letter-spacing: .01em; white-space: nowrap; }
  .ch-meta { margin-top: 31px; font-family: var(--f-label); font-weight: 400; font-size: 16px; line-height: 20px; letter-spacing: .04em; color: var(--mute); }
  .ch-meta > span[aria-hidden] { margin: 0 6px; }
  .ch-off { display: block; margin-top: 6px; }
  .ch-off > span { display: none; }

  .ch-form { position: absolute; z-index: 3; left: 660px; top: 60px; width: 540px; padding: 38px 40px 30px; border-radius: 12px; background: var(--bone); color: var(--ink);
    box-shadow: 0 40px 60px -20px rgba(14, 13, 11, .45), 0 2px 8px rgba(14, 13, 11, .15); }
  .ch-fh { font-family: var(--f-label); font-weight: 500; font-size: 15px; line-height: 20px; letter-spacing: .14em; text-transform: uppercase; color: var(--tan-dark); }
  .ch-steps { position: relative; display: flex; justify-content: space-between; margin: 13px -14px 0; padding: 0; }
  .ch-steps::before { content: ''; position: absolute; left: 50px; right: 50px; top: 17px; border-top: 1.5px dashed #A9A190; }
  .ch-step { position: relative; display: grid; justify-items: center; width: 70px; }
  .ch-step svg { width: 40px; height: 34px; }
  .ch-step path { fill: var(--bone); stroke: var(--ink); stroke-width: 1.5; transition: fill var(--dur-2); }
  .ch-sn { position: absolute; top: 6px; font-family: var(--f-label); font-weight: 600; font-size: 16px; line-height: 22px; }
  .ch-sl { margin-top: 8px; font-size: 12px; line-height: 16px; font-weight: 500; color: var(--ink-2); white-space: nowrap; }
  .ch-step.is-on path { fill: var(--ink); } .ch-step.is-on .ch-sn { color: var(--tan); } .ch-step.is-on .ch-sl { color: var(--ink); font-weight: 600; }
  .ch-fs { border: 0; margin: 0; padding: 0; min-width: 0; }
  .ch-q { padding: 0; margin-top: 34px; font-weight: 600; font-size: 16px; line-height: 20px; }
  .ch-fs[data-part='1'] .ch-q { margin-top: 36px; }
  .ch-chips { display: flex; flex-wrap: wrap; gap: 8px 8px; margin-top: 15px; }
  .ch-chip { position: relative; cursor: pointer; }
  .ch-chip input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .ch-chip span { display: inline-flex; align-items: center; height: 38px; padding: 0 21px; font-weight: 600; font-size: 14px; line-height: 18px; color: var(--ink); background: #fff;
    clip-path: polygon(12px 0, calc(100% - 12px) 0, 100% 50%, calc(100% - 12px) 100%, 12px 100%, 0 50%);
    box-shadow: inset 0 0 0 1px var(--ink); position: relative; }
  .ch-chip span::before { content: ''; position: absolute; inset: 0; background: var(--ink); clip-path: polygon(12px 0, calc(100% - 12px) 0, 100% 50%, calc(100% - 12px) 100%, 12px 100%, 0 50%, 1px 50%, 12.6px calc(100% - 1px), calc(100% - 12.6px) calc(100% - 1px), calc(100% - 1px) 50%, calc(100% - 12.6px) 1px, 12.6px 1px, 1px 50%, 0 50%); }
  .ch-chip input:checked + span { background: var(--ink); color: var(--tan); }
  .ch-chip input:focus-visible + span { outline: 3px solid var(--tan-dark); outline-offset: 2px; }
  .ch-chip:hover span { background: var(--paper); } .ch-chip:hover input:checked + span { background: var(--coal); }
  .ch-lab { display: block; margin-top: 19px; font-size: 13px; line-height: 18px; color: var(--ink-2); }
  .ch-form textarea, .ch-in input { width: 100%; border: 1px solid #9C9893; border-radius: 3px; background: #fff; font-size: 15px; line-height: 20px; color: var(--ink); }
  .ch-form textarea { display: block; height: 84px; margin-top: 8px; padding: 13px 15px; resize: vertical; }
  .ch-form ::placeholder { color: #A39E96; opacity: 1; }
  .ch-in input { height: 50px; padding: 0 15px; }
  .ch-form :is(textarea, input):focus-visible { outline: 3px solid var(--tan-dark); outline-offset: 1px; border-color: var(--ink); }
  .ch-in input[aria-invalid='true'] { border-color: var(--red); box-shadow: inset 0 0 0 1px var(--red); }
  .ch-photo { position: relative; display: grid; place-items: center; height: 62px; margin-top: 16px; border: 1.5px dashed var(--tan-dark); border-radius: 3px; cursor: pointer;
    font-weight: 500; font-size: 15px; color: var(--tan-dark); transition: background-color var(--dur-2); }
  .ch-photo:hover { background: rgba(210, 197, 166, .25); }
  .ch-photo input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .ch-photo:focus-within { outline: 3px solid var(--tan-dark); outline-offset: 2px; }
  .ch-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 18px; }
  .ch-full { display: block; margin-top: 12px; }
  .ch-fs[data-part='3'] .ch-row { margin-top: 18px; }
  .ch-seg { display: grid; grid-template-columns: 1fr 1fr; height: 50px; padding: 3px; border: 1px solid #9C9893; border-radius: 3px; background: #fff; }
  .ch-seg label { position: relative; display: grid; cursor: pointer; }
  .ch-seg input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .ch-seg span { display: grid; place-items: center; border-radius: 2px; font-weight: 600; font-size: 15px; color: var(--ink-2); transition: background-color var(--dur-2), color var(--dur-2); }
  .ch-seg input:checked + span { background: var(--ink); color: var(--paper); }
  .ch-seg input:focus-visible + span { outline: 3px solid var(--tan-dark); outline-offset: 1px; }
  .ch-go { display: flex; align-items: center; justify-content: space-between; width: 100%; height: 62px; margin-top: 28px; padding: 0 18px 0 24px; border-radius: 4px; background: var(--tan); color: var(--ink);
    font-weight: 600; font-size: 18px; transition: background-color var(--dur-2); }
  .ch-go:hover { background: #C8BA98; }
  .ch-c { width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; background: var(--ink); color: var(--paper); transition: rotate var(--dur-2) var(--ease-out); }
  .ch-go:hover .ch-c { rotate: -45deg; }
  .ch-msg:not(:empty) { margin-top: 12px; font-size: 14px; line-height: 20px; color: #A3301F; font-weight: 600; }
  .ch-note { margin-top: 17px; font-size: 13px; line-height: 18px; color: var(--ink-2); }
  .ch-note a { font-weight: 600; color: var(--ink); text-decoration: underline; text-underline-offset: 2px; margin-left: 3px; }

  @media (min-width: 768px) and (max-width: 1279px) {
    .ch { height: auto; padding: 72px 0 0; }
    .ch-in { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 40px; align-items: start; }
    .ch-copy, .ch-form { position: relative; left: auto; top: auto; width: auto; }
    .ch-form { margin-bottom: -180px; padding: 32px 28px 28px; }
    .ch-h1 { width: auto; font-size: clamp(48px, 5.4vw, 70px); line-height: 1.04; }
    .ch-tile { width: 100%; height: auto; padding: 18px; gap: 16px; }
    .ch-ico { width: 72px; height: 72px; } .ch-num { font-size: clamp(34px, 4vw, 60px); line-height: 1; }
    .ch-row { grid-template-columns: 1fr; gap: 12px; }
  }
  @media (max-width: 767px) {
    .ch { height: auto; padding: 42px 0 0; }
    .ch-copy, .ch-form { position: relative; left: auto; top: auto; width: auto; }
    .ch-h1 { width: auto; margin-top: 15px; font-size: 42px; line-height: 42px; }
    .ch-h1 .tn { display: block; }
    .ch-script { margin-top: 4px; font-size: 30px; line-height: 40px; }
    .ch-tile { width: 100%; height: 96px; margin-top: 22px; padding: 0 16px; gap: 16px; }
    .ch-ico { width: 64px; height: 64px; } .ch-ico svg { width: 30px; height: 30px; }
    .ch-tt { gap: 6px; } .ch-who { font-size: 15px; line-height: 18px; } .ch-num { font-size: 38px; line-height: 38px; }
    .ch-meta { margin-top: 24px; font-size: 13px; line-height: 16px; }
    .ch-form { margin: 41px 0 0; padding: 26px 24px 26px; margin-bottom: -950px; }
    .ch-steps { margin: 13px -10px 0; } .ch-steps::before { left: 46px; right: 46px; }
    .ch-step { width: 62px; } .ch-sl { font-size: 11px; }
    .ch-q, .ch-fs[data-part='1'] .ch-q { margin-top: 28px; font-size: 15px; }
    .ch-chips { gap: 10px 8px; margin-top: 14px; }
    .ch-chip span { font-size: 13px; padding: 0 18px; height: 36px; }
    .ch-row { grid-template-columns: 1fr; gap: 10px; margin-top: 14px; }
    .ch-in input, .ch-seg { height: 46px; }
    .ch-full { margin-top: 10px; }
    .ch-go { height: 58px; margin-top: 28px; padding: 0 14px 0 20px; font-size: 17px; }
    .ch-note { font-size: 12px; }
  }
</style>
