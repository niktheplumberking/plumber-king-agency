---
// 10.3 Hours + area (Figma 669:438 y 1800-2540 / 670:1594 y 2438-3301). Ink field. Left: "Based in Riverside, CA" and the
// outlined IE | OC | LA plate. Right: the OPEN sign hangs off a pipe that drops in from the section above (desktop; on phones
// a straight pipe), then "We come to you. No walk-in shop." + payments (Yelp) + service areas link.
// Scroll moment (data-scrub): water runs down and along the pipe; the coupling swells and the sign swings as it passes.
import { SITE } from '../../data/site';
import Eyebrow from '../kit/Eyebrow.astro';
import Wave from '../kit/Wave.astro';
const pipe = 'M780 -40V50C780 63.3 786.67 70 800 70H1300';
const regions = [['IE', 'Inland Empire'], ['OC', 'Orange County'], ['LA', 'Los Angeles']];
const pay = SITE.payments.slice(0, -1).join(', ') + ' or ' + SITE.payments[SITE.payments.length - 1];
---
<section class="hs on-ink" aria-labelledby="hs-h" data-m-section data-scrub data-start="top 80%" data-end="top 15%" data-start-m="top 20%" data-end-m="top -30%">
  <Wave z={1} d={{ a: 18.59, L: 600.5 }} m={{ a: 12.82, L: 300 }} fill="#0E0D0B" above="#F3ECDD" />
  <svg class="hs-pipe" viewBox="0 -60 1440 300" aria-hidden="true" focusable="false">
    <path d={pipe} fill="none" stroke="#6B5C3E" stroke-width="14" stroke-linecap="round" stroke-linejoin="round" />
    <path class="hs-water" d={pipe} pathLength="1" fill="none" stroke="#F3ECDD" stroke-opacity=".38" stroke-width="5" stroke-linecap="round" data-scrub-fill />
    <path d={pipe} fill="none" stroke="#fff" stroke-opacity=".2" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" transform="translate(-1.5 -1.5)" />
    <g data-stop data-rot="0" data-scale="1.12"><path d="M767.42 28h25.16l4.42 14-4.42 14h-25.16L763 42z" fill="#D2C5A6" stroke="#0E0D0B" stroke-width="1.5" stroke-linejoin="round" /></g>
    <path d="M870.75 75V202M1210.75 75V202" stroke="#D2C5A6" stroke-width="1.5" />
  </svg>
  <div class="wrap hs-in">
    <div class="hs-plate" data-t="2">
      <Eyebrow look="page" text="Based in" class="hs-eb" t={false} />
      <h2 id="hs-h" class="hs-h2">Riverside, CA</h2>
      <p class="hs-k">Serving</p>
      <ul class="hs-reg" role="list">
        {regions.map(([a, n], i) => (
          <li><abbr title={n}>{a}</abbr><span class="hs-rn">{n}</span>{i < 2 && <span class="hs-bar" aria-hidden="true">|</span>}</li>
        ))}
      </ul>
    </div>
    <div class="hs-hang">
      <div class="hs-sign" data-stop data-rot="2.5" data-scale="1" data-at=".3" data-at-m=".2">
        <span class="hs-hole" aria-hidden="true"></span><span class="hs-hole hs-hole2" aria-hidden="true"></span>
        <span class="hs-dot" aria-hidden="true"><i data-lit></i></span>
        <p class="hs-open"><span class="hs-o">Open</span> <span class="hs-hrs">24 hours</span> <span class="hs-y">(Yelp)</span></p>
      </div>
      <div class="hs-mpipe" aria-hidden="true"><i class="hs-mw" data-scrub-fill data-axis="x"></i></div>
    </div>
    <div class="hs-txt" data-t="3">
      <Eyebrow look="page" text="Hours · Area" t={false} />
      <h3 class="hs-h3">We come to you.</h3>
      <p class="hs-no">No walk-in shop.</p>
      <p class="hs-pay">Pay by {pay} (Yelp).</p>
      <a class="hs-a" href="/service-areas">See service areas <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
<style>
  .hs { position: relative; height: 740px; background: var(--ink); color: var(--paper); overflow-x: clip; }
  .hs-pipe { position: absolute; z-index: 2; left: 0; top: -60px; width: 1440px; height: 300px; pointer-events: none; overflow: visible; }
  .hs-water { stroke-dasharray: 1; stroke-dashoffset: 0; }
  html:not(.motion) .hs-water { visibility: hidden; }
  .hs-in { position: relative; z-index: 3; height: 100%; }
  .hs-plate { position: absolute; left: 30px; top: 210px; }
  .hs-in :global(.hs-eb) { font-size: 13px; line-height: 19px; letter-spacing: .14em; }
  .hs-h2 { margin-top: 7px; font-family: var(--f-display); font-weight: 400; font-size: 62px; line-height: 84px; color: var(--paper); }
  .hs-k { margin-top: 18px; font-family: var(--f-label); font-weight: 500; font-size: 13px; line-height: 19px; letter-spacing: .14em; text-transform: uppercase; color: var(--tan); }
  .hs-reg { display: flex; margin: -1px 0 0; padding: 0; }
  .hs-reg li { position: relative; display: flex; }
  .hs-reg abbr { display: block; font-family: var(--f-display); font-size: 110px; line-height: 110px; text-decoration: none; color: transparent; -webkit-text-stroke: 2px var(--tan); }
  .hs-rn { position: absolute; left: 3px; top: 116px; font-family: var(--f-label); font-weight: 500; font-size: 12px; line-height: 18px; letter-spacing: .12em; text-transform: uppercase; color: var(--mute); white-space: nowrap; }
  .hs-bar { margin: 20px 22px 0 0; font-family: var(--f-display); font-size: 70px; line-height: 94px; color: var(--red); }
  .hs-hang { position: absolute; left: 680px; top: 186px; width: 480px; height: 190px; rotate: 2deg; transform-origin: 0 0; }
  .hs-sign { position: relative; height: 100%; border-radius: 14px; background: var(--bone); color: var(--ink); transform-origin: 50% -111px; box-shadow: 0 20px 40px -10px rgba(0, 0, 0, .5); }
  .hs-sign::before { content: ''; position: absolute; inset: 10px; border: 2px solid var(--ink); border-radius: 8px; }
  .hs-sign::after { content: ''; position: absolute; left: 70px; right: 69.25px; top: -111px; height: 108px; border: solid var(--tan); border-width: 0 1.5px; }
  .hs-hole { position: absolute; left: 63px; top: -3px; width: 14px; height: 14px; border-radius: 50%; background: var(--ink); z-index: 1; }
  .hs-hole2 { left: 403px; }
  .hs-dot { position: absolute; left: 57px; top: 86px; width: 18px; height: 18px; border-radius: 50%; background: var(--red); }
  .hs-dot i { position: absolute; inset: -9px; border-radius: 50%; background: rgba(217, 65, 43, .28); opacity: 0; }
  .hs-open { margin: 0; }
  .hs-o { position: absolute; left: 92px; top: 42px; font-family: var(--f-display); font-size: 76px; line-height: 103px; text-transform: uppercase; }
  .hs-hrs { position: absolute; left: 344px; top: 66px; font-family: var(--f-label); font-weight: 600; font-size: 24px; line-height: 36px; letter-spacing: .12em; text-transform: uppercase; white-space: nowrap; }
  .hs-y { position: absolute; left: 344px; top: 100px; font-family: var(--f-label); font-size: 16px; line-height: 24px; letter-spacing: .1em; color: var(--tan-dark); }
  .hs-mpipe { display: none; }
  .hs-txt { position: absolute; left: 680px; top: 429px; }
  .hs-h3 { margin-top: 16px; font-family: var(--f-display); font-weight: 400; font-size: 40px; line-height: 44.8px; color: var(--paper); }
  .hs-no { margin-top: 10px; font-style: italic; font-size: 17px; line-height: 18px; color: var(--mute); }
  .hs-pay { margin-top: 8px; font-size: 15px; line-height: 18px; color: var(--mute); }
  .hs-a { display: inline-block; margin-top: 18px; font-weight: 700; font-size: 16px; line-height: 17px; color: var(--tan); text-decoration: underline; text-underline-offset: 4px; }
  .hs-a span { display: inline-block; margin-left: 6px; text-decoration: none; transition: translate var(--dur-2) var(--ease-out); }
  .hs-a:hover span { translate: 4px 0; }
  @media (min-width: 768px) and (max-width: 1279px) {
    .hs { height: auto; padding: 200px 0 120px; }
    .hs-pipe { display: none; }
    .hs-in { display: grid; grid-template-columns: 1fr 1fr; gap: 56px 40px; align-items: start; }
    .hs-plate, .hs-txt { position: static; }
    .hs-plate { grid-row: span 2; }
    .hs-reg abbr { font-size: clamp(64px, 8.4vw, 110px); line-height: 1; }
    .hs-bar { margin: 8px 3vw 0 0; font-size: clamp(44px, 5.4vw, 70px); line-height: 1.3; }
    .hs-rn { top: auto; bottom: -24px; font-size: 11px; }
    .hs-reg { padding-bottom: 28px; }
    .hs-hang { position: relative; left: auto; top: auto; zoom: .66; }
    .hs-sign::after { display: none; }
    .hs-h2 { font-size: clamp(40px, 5.4vw, 62px); line-height: 1.35; }
  }
  @media (min-width: 1024px) and (max-width: 1279px) { .hs-hang { zoom: .9; } }
  @media (max-width: 767px) {
    .hs { height: auto; padding: 153px 0 65px; } /* QA 18 Nov: -20 px for the extra payments line, so the seam lands as in Figma */
    .hs-pipe { display: none; }
    .hs-plate, .hs-txt { position: static; }
    .hs-in :global(.hs-eb) { font-size: 9.36px; line-height: 14px; gap: 7px; }
    .hs-in :global(.hs-eb svg) { width: 15px; height: 11px; }
    .hs-h2 { margin-top: 5px; font-size: 44.64px; line-height: 60px; }
    .hs-k { margin-top: 13px; font-size: 9.36px; line-height: 14px; }
    .hs-reg abbr { font-size: 79px; line-height: 79px; }
    .hs-bar { margin: 14px 16px 0 0; font-size: 50px; line-height: 67px; }
    .hs-rn { top: 83px; font-size: 8.64px; line-height: 13px; }
    .hs-reg { padding-bottom: 17px; }
    .hs-hang { position: relative; left: auto; top: auto; width: 340px; max-width: 100%; height: 140px; margin: 123px auto 0; rotate: none; }
    .hs-sign { rotate: 2deg; transform-origin: 50% -26px; border-radius: 12px; box-shadow: 0 16px 30px -8px rgba(0, 0, 0, .5); }
    .hs-sign::before { inset: 8px; border-radius: 7px; }
    .hs-sign::after { left: 50px; right: 49.25px; top: -24px; height: 24px; }
    .hs-hole { left: 44px; width: 12px; height: 12px; } .hs-hole2 { left: auto; right: 44px; }
    .hs-dot { left: 33px; top: 63px; width: 14px; height: 14px; }
    .hs-o { left: 58px; top: 28px; font-size: 54px; line-height: 73px; }
    .hs-hrs { left: 232px; top: 48px; font-size: 17px; line-height: 25px; letter-spacing: .1em; }
    .hs-y { left: 232px; top: 72px; font-size: 13px; line-height: 19px; letter-spacing: .08em; }
    .hs-mpipe { display: block; position: absolute; left: 15px; right: 15px; top: -31.5px; height: 11px; border-radius: 6px; background: #6B5C3E; overflow: hidden;
      box-shadow: inset 0 -1px 0 rgba(255, 255, 255, .2); }
    .hs-mw { position: absolute; left: 0; top: 3px; width: 100%; height: 5px; border-radius: 3px; background: rgba(243, 236, 221, .38); transform-origin: 0 50%; }
    html:not(.motion) .hs-mw { visibility: hidden; }
    .hs-txt { margin-top: 39px; }
    .hs-h3 { margin-top: 11px; font-size: 28px; line-height: 31.36px; }
    .hs-no { margin-top: 8px; font-size: 15px; line-height: 16px; }
    .hs-pay { margin-top: 8px; font-size: 13px; line-height: 16px; }
    .hs-a { margin-top: 14px; font-size: 15px; line-height: 16px; }
  }
</style>
