---
// 10.4 What happens next (Figma 669:438 y 2540-3154 / 670:1594 y 3301-3761). Paper field; the three steps run on as one
// statement (red Oswald numbers, Abril text, step 2 in tan-dark, step 3 underlined), then the tan call button.
// Scroll moment (data-scrub): as the statement scrolls through, 01, 02, 03 light up in order, swell to 1.08 and turn a little.
import { SITE } from '../../data/site';
import Eyebrow from '../kit-b4/Eyebrow.astro';
import Wave from '../kit-b4/Wave.astro';
const steps = ["You tell us what's going on.", 'We talk it through with you.', 'Free estimate before any work starts.'];
---
<section class="cn" aria-labelledby="cn-h" data-m-section data-scrub data-start="top 65%" data-end="bottom 85%" data-start-m="top 55%" data-end-m="bottom 90%">
  <Wave d={{ a: 18.57, L: 520 }} m={{ a: 12.36, L: 300.5 }} fill="#F3ECDD" above="#0E0D0B" />
  <div class="wrap cn-in">
    <Eyebrow text="After you send it" tone="deep" />
    <h2 id="cn-h" class="cn-h2" data-t="2">What happens next.</h2>
    <ol class="cn-run" role="list" data-t="3">
      {steps.map((s, i) => (
        <li class={`cn-s cn-s${i + 1}`}>{i > 0 && <span class="cn-ar" aria-hidden="true">→ </span>}<span class="cn-n" data-stop data-rot={i % 2 ? '-4' : '4'}><i data-lit aria-hidden="true"></i>0{i + 1}</span>{'\u00a0 '}<span class="cn-t">{s}</span>{' '}</li>
      ))}
    </ol>
    <a class="cn-btn" href={SITE.tel} data-t="4">
      <span class="cn-num">{SITE.phone}</span><span class="cn-sub">Or skip the form and call</span>
      <span class="cn-c" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20"><path d="M4 12h15m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
    </a>
  </div>
</section>
<style>
  .cn { position: relative; height: 614px; background: var(--paper); color: var(--ink); }
  .cn-in { position: relative; padding-top: 129px; }
  .cn-h2 { margin-top: 12px; font-family: var(--f-display); font-weight: 400; font-size: 52px; line-height: 70px; }
  .cn-run { margin: 38px 0 0; padding: 0; font-family: var(--f-display); font-size: 46px; line-height: 56.12px; }
  .cn-s { display: inline; }
  .cn-ar, .cn-n { font-family: var(--f-label); font-weight: 600; font-size: 25px; letter-spacing: .06em; color: var(--red); }
  .cn-ar { line-height: 0; }
  .cn-n { position: relative; display: inline-block; line-height: 0; }
  .cn-n i { position: absolute; inset: -6px -8px; z-index: -1; border-radius: 4px; background: rgba(217, 65, 43, .14); opacity: 0; }
  .cn-s2 .cn-t { color: var(--tan-dark); }
  .cn-s3 .cn-t { text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 7px; }
  .cn-btn { display: grid; grid-template-columns: 1fr auto; align-content: start; width: 360px; height: 64px; margin-top: 48px; padding: 8px 16px 0 22px; border-radius: 6px; background: var(--tan); color: var(--ink); transition: background-color var(--dur-2); }
  .cn-btn:hover { background: #C8BA98; }
  .cn-num { font-family: var(--f-label); font-weight: 600; font-size: 22px; line-height: 33px; letter-spacing: .02em; }
  .cn-sub { grid-row: 2; margin-top: -2px; font-weight: 500; font-size: 12px; line-height: 13px; opacity: .8; }
  .cn-c { grid-row: 1 / 3; grid-column: 2; align-self: center; margin-top: -8px; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: var(--ink); color: var(--tan); transition: rotate var(--dur-2) var(--ease-out); }
  .cn-btn:hover .cn-c { rotate: -45deg; }
  @media (min-width: 768px) and (max-width: 1279px) {
    .cn { height: auto; padding-bottom: 120px; }
    .cn-in { padding-top: 120px; }
    .cn-run { font-size: clamp(32px, 3.8vw, 46px); line-height: 1.22; }
  }
  @media (max-width: 767px) {
    .cn { height: auto; padding-bottom: 60px; }
    .cn-in { padding-top: 63px; }
    .cn-h2 { margin-top: 12px; font-size: 34px; line-height: 46px; }
    .cn-run { margin-top: 24px; font-size: 28px; line-height: 34.16px; }
    .cn-ar, .cn-n { font-size: 15px; }
    .cn-s3 .cn-t { text-decoration-thickness: 2px; text-underline-offset: 5px; }
    .cn-btn { width: 100%; margin-top: 36px; padding-left: 20px; }
  }
</style>
