---
// 10.2 Other ways (Figma 669:438 y 1038-1800 / 670:1594 y ~1734-2438). Paper field; three fanned cards: CALL (ink, tel:),
// INSTAGRAM (tan, "DM me a picture", his IG line word for word), YELP (bone). SITE.email sits under the heading (no slot in
// the frame; it is the business email from his Nextdoor page). Card positions are the frame's (rotated about the top-left).
import { SITE } from '../../data/site';
import Eyebrow from '../kit/Eyebrow.astro';
import Wave from '../kit/Wave.astro';
---
<section class="co" aria-labelledby="co-h" data-m-section>
  <Wave z={1} d={{ a: 20.65, L: 560.5 }} fill="#F3ECDD" above="#0E0D0B" class="co-wave" />
  <div class="wrap co-in">
    <Eyebrow look="page" text="Other ways" tone="deep" />
    <h2 id="co-h" class="co-h2" data-t="2">Rather not<br /> fill in a form?</h2>
    <p class="co-mail" data-t="3">Or email <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
    <ul class="co-cards" role="list" data-t="4" data-stagger>
      <li class="co-c co-call"><a href={SITE.tel}>
        <span class="co-top"><span class="co-ico"><svg viewBox="0 0 40 40" width="26" height="26" aria-hidden="true"><path d="M6.32 0C2.24 0-.82 4.08.2 10.2 3.26 24.5 15.5 36.74 29.8 39.8 35.92 40.82 40 37.76 40 33.68v-5.1c0-2.04-1.02-3.06-3.06-4.09l-7.14-3.06c-2.04-1.02-4.09 0-5.11 2.04l-2.04 3.06C16.53 24.5 13.47 20.4 11.42 15.3l3.07-2.04c2.04-1.02 3.06-3.06 2.04-5.1L13.47 2.04C12.44 0 11.42 0 9.38 0z" fill="currentColor"/></svg></span><span class="co-k">Call</span><span class="co-ar" aria-hidden="true">→</span></span>
        <span class="co-num">{SITE.phone}</span><span class="co-sub">Talk to {SITE.owner}</span></a></li>
      <li class="co-c co-ig"><a href={SITE.social.instagram} target="_blank" rel="noopener">
        <span class="co-top"><span class="co-ico" aria-hidden="true">◎</span><span class="co-k">Instagram</span><span class="co-ar" aria-hidden="true">→</span></span>
        <span class="co-big">{SITE.social.instagramHandle}</span><span class="co-sub co-it">“DM me a picture”</span></a></li>
      <li class="co-c co-yelp"><a href={SITE.social.yelp} target="_blank" rel="noopener">
        <span class="co-top"><span class="co-ico" aria-hidden="true">★</span><span class="co-k">Yelp</span><span class="co-ar" aria-hidden="true">→</span></span>
        <span class="co-big">Mike's Plumbing Services, Riverside</span><span class="co-sub"><span aria-hidden="true">★★★★★&nbsp; </span>{SITE.rating.value} · {SITE.rating.count} reviews<span class="sr-only"> on Yelp</span></span></a></li>
    </ul>
    <p class="co-cap" data-t="5">Mike's Instagram line, word for word.</p>
  </div>
</section>
<style>
  .co { position: relative; height: 762px; background: var(--paper); color: var(--ink); overflow-x: clip; }
  .co-in { position: relative; height: 100%; padding-top: 131px; }
  .co-h2 { margin-top: 10px; font-family: var(--f-display); font-weight: 400; font-size: 52px; line-height: 54px; }
  .co-mail { margin-top: 18px; font-size: 15px; line-height: 20px; color: var(--ink-2); }
  .co-mail a { font-weight: 600; color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  .co-cards { margin: 0; padding: 0; }
  .co-c { position: absolute; width: 330px; height: 220px; transform-origin: 0 0; }
  .co-c a { display: flex; flex-direction: column; height: 100%; padding: 24px; border-radius: 12px; box-shadow: 0 26px 44px -8px rgba(0, 0, 0, .4); transition: translate var(--dur-2) var(--ease-out); }
  .co-c a:hover { translate: 0 -6px; }
  .co-call { left: 130px; top: 352px; rotate: 7deg; } .co-call a { background: var(--ink); color: var(--paper); }
  .co-ig { left: 440px; top: 322px; rotate: -2deg; } .co-ig a { background: var(--tan); color: var(--ink); }
  .co-yelp { left: 750px; top: 362px; rotate: -8deg; } .co-yelp a { background: var(--bone); color: var(--ink); box-shadow: inset 0 0 0 1px rgba(14, 13, 11, .2), 0 26px 44px -8px rgba(0, 0, 0, .4); }
  .co-top { display: flex; align-items: center; gap: 16px; }
  .co-ico { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 8px; background: var(--ink); color: var(--tan); font-size: 24px; line-height: 26px; }
  .co-call .co-ico { background: var(--tan); color: var(--ink); }
  .co-k { font-family: var(--f-label); font-weight: 600; font-size: 13px; line-height: 19px; letter-spacing: .16em; text-transform: uppercase; color: var(--tan); }
  .co-ig .co-k { color: var(--ink); } .co-yelp .co-k { color: var(--tan-dark); }
  .co-ar { margin-left: auto; align-self: flex-start; margin-top: 12px; font-weight: 700; font-size: 20px; line-height: 22px; color: var(--tan); }
  .co-ig .co-ar { color: var(--ink); margin-top: 12px; } .co-yelp .co-ar { color: var(--tan-dark); }
  .co-num { margin-top: 24px; font-family: var(--f-label); font-weight: 600; font-size: 40px; line-height: 48px; }
  .co-big { margin-top: 24px; font-weight: 700; font-size: 20px; line-height: 24px; }
  .co-sub { margin-top: auto; padding-bottom: 11px; font-weight: 500; font-size: 14px; line-height: 15px; opacity: .8; }
  .co-it { font-style: italic; font-weight: 400; padding-bottom: 17px; }
  .co-yelp .co-sub { padding-bottom: 1px; }
  .co-c a:focus-visible { outline-offset: 4px; }
  .co-cap { position: absolute; left: 440px; top: 632px; font-style: italic; font-size: 12px; line-height: 13px; color: rgba(74, 68, 58, .8); }
  @media (min-width: 768px) and (max-width: 1279px) {
    .co { height: auto; padding: 200px 0 120px; }
    .co-in { padding-top: 0; }
    .co-cards { display: flex; justify-content: center; margin-top: 48px; }
    .co-c { position: relative; left: auto; top: auto; flex: none; width: 31%; max-width: 330px; margin: 0 -1%; }
    .co-ig { top: -24px; }
    .co-num { font-size: clamp(28px, 3.4vw, 40px); }
    .co-big { font-size: clamp(15px, 1.9vw, 20px); line-height: 1.2; overflow-wrap: anywhere; }
    .co-cap { position: static; margin-top: 40px; text-align: center; }
  }
  @media (max-width: 767px) {
    .co { height: auto; padding: 0 0 64px; } /* B6: the Yelp card clears the wave by 16 */
    .co :global(.co-wave) { display: none; }
    .co-in { padding-top: 0; }
    .co-h2 { margin-top: 12px; font-size: 34px; line-height: 36px; } .co-h2 br { display: none; }
    .co-mail { margin-top: 10px; font-size: 14px; }
    .co-cards { margin-top: 10px; }
    .co-c { position: relative; left: auto; top: auto; width: 320px; max-width: calc(100% - 10px); height: 180px; margin-top: 0; }
    .co-c + .co-c { margin-top: -2px; }
    .co-call { left: 10px; rotate: 4deg; } .co-ig { left: 20px; rotate: -3deg; } .co-yelp { left: 10px; rotate: 3deg; }
    .co-c a { padding: 20px; box-shadow: 0 20px 36px -8px rgba(0, 0, 0, .4); }
    .co-yelp a { box-shadow: inset 0 0 0 1px rgba(14, 13, 11, .2), 0 20px 36px -8px rgba(0, 0, 0, .4); }
    .co-ico { width: 44px; height: 44px; font-size: 20px; } .co-ico svg { width: 22px; height: 22px; }
    .co-top { gap: 14px; } .co-k { font-size: 12px; line-height: 18px; } .co-ar { display: none; }
    .co-num { margin-top: 18px; font-size: 34px; line-height: 41px; }
    .co-big { margin-top: 18px; font-size: 18px; line-height: 22px; }
    .co-sub { font-size: 13px; line-height: 14px; padding-bottom: 0; } .co-it { padding-bottom: 0; }
    .co-cap { display: none; }
  }
</style>
