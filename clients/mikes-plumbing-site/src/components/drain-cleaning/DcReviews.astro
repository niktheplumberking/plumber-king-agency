---
// 3.5 What customers say (Figma 670:13365 y 3354 h 717, tan; mobile y 3830 h 662). One big Yelp quote with the key words
// underlined, a footnote slip with a second quote. Quotes come from src/data/reviews.ts: every excerpt must appear word for
// word in that review (checked at build time); the meta line names reviewer, town, date and the job from the review.
import Wave from '../services/kit/Wave.astro';
import Eyebrow from '../services/kit/Eyebrow.astro';
import { ab } from '../services/kit/ab';
import { REVIEWS } from '../../data/reviews';
const pick = (name: string, excerpt: string, job: string) => {
  const r = REVIEWS.find((x) => x.name === name);
  if (!r || !r.text.includes(excerpt)) throw new Error(`DcReviews: "${excerpt}" is not in ${name}'s review`);
  const [m, d, y] = r.date.split(' ');
  const town = /\b[A-Z]{2}$/.test(r.town) ? r.town.replace(/ ([A-Z]{2})$/, ', $1') : `${r.town}, CA`;
  return { meta: `${r.name}, ${town} · ${m} ${d}, ${y} · ${job}` };
};
const q1 = ['One thing of note, the entire time he was working he was ', 'extremely conscientious', ' about my lawn and cleaning up any mess.'];
const a = pick('Stuart W.', q1.join(''), 'Water service line leak');
const q2 = 'Very clean, professional, and great communication skills. Highly recommend!';
const b = pick('Sydney H.', q2, 'Kitchen faucet replacement');
---
<section class="dr2 sv-sec sv-tan sv-abs" style="--sh:717px" aria-labelledby="dr2-h" data-m-section>
  <Wave fill="var(--tan)" top={-34} topM={-24} />
  <div class="dr2-in">
    <Eyebrow tone="ink" class="dr2-eb" data-ab style={ab(119.5, 109)}>On Yelp</Eyebrow>
    <h2 id="dr2-h" class="sv-h dr2-h lh-abril" data-t="2" data-ab style={ab(120, 140)}>“Very clean, professional.” <em>In their words.</em></h2>
    <span class="dr2-mark" data-ab style={ab(100, 150)} aria-hidden="true">“</span>
    <figure class="dr2-q" data-t="3" data-ab style={ab(120, 220, 1200)}>
      <blockquote><p><span class="dr2-m">“</span>{q1[0]}<u>{q1[1]}</u>{q1[2]}”<span aria-hidden="true">*</span></p></blockquote>
      <figcaption>{a.meta}</figcaption>
    </figure>
    <figure class="dr2-slip" data-t="4" data-ab style={ab(880, 479, 440, 158, -2)}>
      <p class="dr2-k"><span aria-hidden="true">* </span>And another one</p>
      <blockquote><p>“{q2}”</p></blockquote>
      <figcaption>{b.meta}</figcaption>
    </figure>
  </div>
</section>

<style>
  .dr2-in { position: relative; }
  .dr2-h { margin: 0; font-size: 30px; white-space: nowrap; }
  .dr2-mark { font-family: var(--f-display); font-size: 220px; line-height: 1.344; color: rgba(14, 13, 11, .1); pointer-events: none; }
  .dr2-q { margin: 0; }
  .dr2-q blockquote { margin: 0; }
  .dr2-q p { margin: 0; font-family: var(--f-display); font-size: 56px; line-height: 1.12; color: var(--ink); }
  .dr2-q u { color: #6b5c3e; text-decoration-thickness: 3px; text-underline-offset: 6px; }
  .dr2-m { display: none; }
  .dr2-q figcaption { margin-top: 28px; font-family: var(--f-label); font-weight: 500; font-size: 14px; line-height: 21px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink); }
  .dr2-slip { margin: 0; box-sizing: border-box; padding: 20px 24px 0; background: var(--bone); box-shadow: 0 12px 24px -8px rgba(0, 0, 0, .3); }
  .dr2-k { margin: 0; font-family: var(--f-label); font-weight: 500; font-size: 12px; line-height: 18px; letter-spacing: .12em; text-transform: uppercase; color: var(--red); }
  .dr2-slip blockquote { margin: 6px 0 0; }
  .dr2-slip blockquote p { margin: 0; font-family: var(--f-sans); font-weight: 600; font-size: 17px; line-height: 1.45; color: var(--ink); }
  .dr2-slip figcaption { margin-top: 12px; font-family: var(--f-label); font-weight: 500; font-size: 11px; line-height: 1.4; letter-spacing: .1em; text-transform: uppercase; color: #6b5c3e; }

  @media (max-width: 1279px) {
    .dr2-in { width: calc(100% - 2 * var(--gutter)); margin-inline: auto; display: flex; flex-direction: column; align-items: flex-start; }
    .dr2-mark { display: none; } .dr2-m { display: inline; }
    .dr2-h { white-space: normal; }
    .dr2-slip { rotate: 2deg; transform-origin: 0 0; }
  }
  @media (min-width: 768px) and (max-width: 1279px) {
    .dr2 { padding: 110px 0 100px; }
    .dr2-h { margin-top: 12px; }
    .dr2-q { margin-top: 30px; } .dr2-q p { font-size: clamp(36px, 4.6vw, 56px); }
    .dr2-slip { width: 440px; margin: 48px 0 0 auto; }
  }
  @media (max-width: 767px) {
    .dr2 { padding: 59px 0 62px; }
    .dr2 :global(.dr2-eb) { font-size: 13px; line-height: 19px; }
    .dr2-h { margin-top: 10px; font-size: 24px; }
    .dr2-q { margin-top: 20px; } .dr2-q p { font-size: 30px; line-height: 1.16; }
    .dr2-q u { text-decoration-thickness: 2px; text-underline-offset: 4px; }
    .dr2-q figcaption { margin-top: 18px; font-size: 11.5px; line-height: 1.4; letter-spacing: .1em; }
    .dr2-slip { width: 340px; max-width: calc(100% - 12px); margin: 30px 0 0 6px; padding: 16px 18px 18px; box-shadow: 0 10px 20px -6px rgba(0, 0, 0, .3); }
    .dr2-k { font-size: 11px; line-height: 16px; }
    .dr2-slip blockquote { margin-top: 6px; } .dr2-slip blockquote p { font-size: 15px; }
    .dr2-slip figcaption { margin-top: 10px; font-size: 10px; }
  }
</style>
