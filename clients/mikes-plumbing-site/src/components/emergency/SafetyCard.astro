---
// Steps · laminated safety card (Figma 669:783 y 880 h 680, tan; mobile y 926 h 632). Eyebrow + H2 on the left, a tilted
// laminated card with a red header, lanyard hole and three pictogram steps.
// Scroll moment: the steps light up one after another (1 -> 3) as you scroll past the card, each growing a little and
// turning as it is reached.
import Wave from '../kit/Wave.astro';
import Eyebrow from '../kit/Eyebrow.astro';
import { ab } from '../services/shared/ab';
import { SITE } from '../../data/site';
const steps = [
  { k: 'valve', h: 'Water leaking?', p: 'Shut off the main water valve or the valve under the fixture.' },
  { k: 'leave', h: 'Smell gas?', p: 'Leave the house, then call your gas company from outside.' },
  { k: 'photo', h: 'Take a photo', p: 'of what you see. It helps Mike know what to bring.' },
];
---
<section class="sc sv-sec sv-tan sv-abs" style="--sh:680px" aria-labelledby="sc-h" data-m-section>
  <Wave fill="var(--tan)" rise top={-34} shapeM={[150, 12, -4, 28, 30]} topM={-26} />
  <svg class="sc-drip" data-idle="drip" data-ab style={ab(1300, -14, 16, 24)} viewBox="0 0 16 24" aria-hidden="true"><path d="M8 0C8 0 16 11 16 16 16 21 12 24 8 24 4 24 0 21 0 16 0 11 8 0 8 0Z" fill="#D2C5A6" /></svg>
  <div class="sc-in">
    <Eyebrow look="figma" tone="ink" class="sc-eb" data-ab style={ab(119.5, 109)}>While you call</Eyebrow>
    <h2 id="sc-h" class="sv-h sc-h" data-t="2" data-ab style={ab(120, 146, 460)}>Stop the water.<br class="sc-br" /> Then call.</h2>
    <div class="sc-card" data-t="3" data-scrub data-start="top 70%" data-end="bottom 70%" data-start-m="top 70%" data-end-m="bottom 75%" data-ab style={ab(600, 80, 720, 500, -2.5)}>
      <i class="sc-frame" aria-hidden="true"></i>
      <p class="sc-head">While you call<span aria-hidden="true"> &nbsp;·&nbsp; </span><span class="sr-only">: </span>{SITE.phone}</p>
      <i class="sc-hole" aria-hidden="true"></i>
      <ol class="sc-list" role="list">
        {steps.map((s, i) => (
          <li class="sc-row" data-stop data-dim data-at={(0.12 + i * 0.32).toFixed(2)}>
            <svg class="sc-pic" viewBox="0 0 96 96" aria-hidden="true">
              <rect x="1.5" y="1.5" width="93" height="93" rx="10" fill="none" stroke="#D9412B" stroke-width="3" />
              {s.k === 'valve' && <g stroke="#0E0D0B" fill="none"><circle cx="48" cy="48" r="26.3" stroke-width="5" /><path d="M48 48l20.36 20.36M48 48 27.64 68.36M48 48 27.64 27.64M48 48l20.36-20.36" stroke-width="4" /><circle cx="48" cy="48" r="5.75" fill="#0E0D0B" stroke="none" /><rect x="44" y="76.8" width="8" height="13.4" fill="#0E0D0B" stroke="none" /></g>}
              {s.k === 'leave' && <g fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M17.3 42.2 38.4 23l21.1 19.2v30.7H17.3Z" stroke="#0E0D0B" stroke-width="4" /><path d="M48 49.9h28.8M66.4 59.5l10.4-9.6-10.4-9.6" stroke="#D9412B" stroke-width="5" /></g>}
              {s.k === 'photo' && <g><rect x="15.4" y="28.8" width="65.3" height="44.2" rx="6" fill="none" stroke="#0E0D0B" stroke-width="4" /><rect x="28.8" y="21.1" width="17.3" height="9.6" rx="2" fill="#0E0D0B" /><circle cx="48" cy="50.9" r="10.5" fill="none" stroke="#0E0D0B" stroke-width="4" /><circle cx="69.1" cy="37.4" r="3" fill="#D9412B" /></g>}
            </svg>
            <h3>{s.h}</h3>
            <p>{s.p}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .sc-drip { z-index: 4; }
  .sc-in { position: relative; }
  .sc-h { margin: 0; font-size: 60px; line-height: 1; color: var(--ink); }
  .sc-card { border-radius: 22px; background: var(--bone); box-shadow: 0 24px 40px -10px rgba(0, 0, 0, .3); }
  .sc-frame { position: absolute; inset: 10px; border: 3px solid var(--ink); border-radius: 16px; pointer-events: none; z-index: 1; }
  .sc-head { position: absolute; left: 10px; right: 10px; top: 10px; height: 64px; margin: 0; box-sizing: border-box; padding: 18px 0 0 30px; border-radius: 16px 16px 0 0; background: var(--red);
    font-family: var(--f-label); font-weight: 700; font-size: 20px; line-height: 30px; letter-spacing: .12em; text-transform: uppercase; color: var(--paper); white-space: pre; }
  .sc-hole { display: none; position: absolute; left: 667px; top: 27px; width: 26px; height: 26px; box-sizing: border-box; border: 2px solid var(--ink); border-radius: 50%; background: var(--tan); z-index: 2; }
  .sc-list { position: absolute; left: 40px; top: 100px; width: 640px; margin: 0; padding: 0; list-style: none; }
  .sc-row { position: relative; height: 130px; transform-origin: 48px 48px; --pop-r: -3deg; }
  .sc-row + .sc-row::before { content: ''; position: absolute; left: 0; right: 0; top: -14px; height: 1.2px; background: repeating-linear-gradient(90deg, #a79d88 0 4px, transparent 4px 9px); }
  .sc-pic { position: absolute; left: 0; top: 0; width: 96px; height: 96px; }
  .sc-row h3 { position: absolute; left: 126px; top: 8px; margin: 0; font-family: var(--f-display); font-weight: 400; font-size: 30px; line-height: 40px; color: var(--ink); }
  .sc-row p { position: absolute; left: 126px; top: 52px; width: 500px; margin: 0; font-weight: 500; font-size: 17px; line-height: 1.45; color: var(--ink-2); }

  @media (max-width: 1279px) {
    .sc-drip { display: none; }
    .sc-in { width: calc(100% - 2 * var(--gutter)); margin-inline: auto; display: flex; flex-direction: column; align-items: flex-start; }
    .sc-card { position: relative; width: 100%; max-width: 720px; rotate: 1.5deg; transform-origin: 0 0; }
    .sc-list { position: relative; left: auto; top: auto; width: auto; }
  }
  @media (min-width: 768px) and (max-width: 1279px) {
    .sc { padding: 109px 0 110px; }
    .sc-h { margin-top: 14px; font-size: clamp(44px, 5.4vw, 60px); }
    .sc-card { height: 500px; margin-top: 40px; }
    .sc-list { padding: 100px 40px 0; }
    .sc-hole { left: auto; right: 27px; }
    .sc-row p { width: auto; right: 0; }
  }
  @media (max-width: 767px) {
    .sc { padding: 49px 0 56px; }
    .sc :global(.sc-eb) { font-size: 12.5px; line-height: 19px; }
    .sc-br { display: none; }
    .sc-h { margin-top: 8px; font-size: 36px; line-height: 1.04; }
    .sc-card { height: 396px; margin: 30px 0 0 -6px; width: calc(100% + 12px); border-radius: 18px; box-shadow: 0 18px 30px -8px rgba(0, 0, 0, .3); }
    .sc-frame { inset: 8px; border-width: 2.5px; border-radius: 12px; }
    .sc-head { left: 8px; right: 8px; top: 8px; height: 50px; padding: 14px 0 0 18px; border-radius: 12px 12px 0 0; font-size: 14px; line-height: 21px; letter-spacing: .1em; }
    .sc-hole { display: block; left: auto; right: 20px; top: 22px; width: 16px; height: 16px; border-width: 1.5px; }
    .sc-list { padding: 80px 24px 0; }
    .sc-row { height: 104px; transform-origin: 32px 32px; }
    .sc-row + .sc-row::before { top: -12px; }
    .sc-pic { width: 64px; height: 64px; }
    .sc-row h3 { left: 80px; top: 2px; font-size: 22px; line-height: 30px; }
    .sc-row p { left: 80px; top: 36px; width: auto; right: 0; font-size: 14px; }
  }
</style>
