---
// Emergency strip under the header on every page (Figma Home 631:2037 y 136, 44 px tan; mobile y 104, 60 px).
import { SITE } from '../../data/site';
---
<div class="es">
  <div class="es-in">
    <p class="es-t"><span class="es-dot" aria-hidden="true"></span><span>Water where it shouldn't be?&nbsp; Shut off the main, then call <a href={SITE.tel}>{SITE.phone}</a>. Open 24 hours on Yelp.</span></p>
    <a class="es-l" href="/emergency-plumber">What to do while you wait <svg viewBox="0 0 18 10" width="16" height="10" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M0 5h16M12 1l4 4-4 4"/></svg></a>
  </div>
</div>
<style>
  .es { background: var(--tan); color: var(--ink); }
  .es-in { display: flex; align-items: center; justify-content: space-between; gap: 24px; height: 44px; width: calc(100% - 2 * var(--gutter)); margin-inline: auto; }
  .es-t { display: flex; align-items: center; gap: 12px; font-weight: 700; font-size: 15.6px; line-height: 20px; }
  .es-t a { white-space: nowrap; }
  .es-t a:hover, .es-l:hover { text-decoration: underline; text-underline-offset: 3px; }
  .es-dot { flex: none; width: 10px; height: 10px; border-radius: 50%; background: var(--red); }
  .es-l { display: inline-flex; align-items: center; gap: 6px; margin-right: 29px; font-weight: 600; font-size: 14px; white-space: nowrap; }
  @media (max-width: 1023px) { .es-l { display: none; } }
  @media (max-width: 767px) {
    .es-in { height: 60px; }
    .es-t { align-items: flex-start; gap: 10px; font-size: 13px; line-height: 18px; }
    .es-dot { width: 8px; height: 8px; margin-top: 5px; }
  }
</style>
