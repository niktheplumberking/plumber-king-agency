---
// First-visit-per-session loader (fix round 1, B3). Base: 21st.dev "Swiss Poster Counter Preloader" (id 35248,
// slat-count-preloader by kedhareswer), re-implemented in vanilla TS + GSAP (kit/loader.ts) and translated to Mike:
// ink poster, tan and bone slats that read as pipe sections, counting 000 -> 100 while the page loads; Mike's hex badge
// small top-left; "Friendly · Transparent · Proficient" in Oswald. At 100 the poster splits into 8 horizontal blinds that
// slide off, alternating left and right (the page curtain, kit/Curtain.astro, is the same 8 blinds). Shown only under
// html.intro (Base.astro: once per session, never under reduced motion). Click, tap or any key skips. Max 3.4 s.
import { Image } from 'astro:assets';
import logo from '../../assets/brand/logo-cream.png';
const BLINDS = 8;
const SLOTS = 3;
---
<div class="ld" data-loader aria-hidden="true">
  <div class="ld-blinds">{Array.from({ length: BLINDS }, () => <i class="ld-blind"></i>)}</div>
  <div class="ld-stage">
    <div class="ld-count">
      {Array.from({ length: SLOTS }, () => (
        <span class="ld-slot">{Array.from({ length: 21 }, (_, i) => <i class="ld-slat" style={`--c:${i % 3};--r:${Math.floor(i / 3)}`}></i>)}</span>
      ))}
      <span class="ld-pct">%</span>
    </div>
    <span class="ld-badge"><Image src={logo} alt="" width={216} height={138} loading="eager" fetchpriority="low" /></span>
    <p class="ld-hud ld-tr"><span class="ld-dot"></span><span>Riverside, CA</span><br /><span class="ld-num">000 / 100</span></p>
    <p class="ld-hud ld-bl">Friendly <span>·</span> Transparent <span>·</span> Proficient</p>
    <i class="ld-mark ld-m1"></i><i class="ld-mark ld-m2"></i>
  </div>
  <button type="button" class="ld-skip" data-loader-skip tabindex="-1">Skip intro →</button>
</div>
<style>
  .ld { display: none; }
  :global(html.intro) .ld { display: block; position: fixed; inset: 0; z-index: var(--z-loader); color: var(--paper); overflow: hidden; }
  .ld-blinds { position: absolute; inset: 0; display: flex; flex-direction: column; }
  .ld-blind { position: relative; flex: 1 1 0; margin-bottom: -1px; background: var(--ink); will-change: transform; }
  /* The moving edge of each blind (fix round 2): a band in the slats' tan / bone, just outside the blind, so it is off-screen
     while the poster shows and sweeps across the page as the blinds leave (left-going rows: right edge; right-going: left). */
  .ld-blind::after { content: ''; position: absolute; top: 0; bottom: 0; left: 100%; width: 10px; background: var(--tan); }
  .ld-blind:nth-child(even)::after { left: auto; right: 100%; background: var(--paper); }
  .ld-stage { position: absolute; inset: 0; display: grid; place-items: center; }
  .ld-count {
    --dh: min(34vh, 28vw); --g: calc(var(--dh) * .024); --h: calc((var(--dh) - 6 * var(--g)) / 7); --w: calc(var(--h) * 2);
    position: relative; display: flex; gap: calc(var(--w) * .55);
  }
  .ld-slot { position: relative; width: calc(3 * var(--w) + 2 * var(--g)); height: var(--dh); }
  .ld-slat {
    position: absolute; left: calc(var(--c) * (var(--w) + var(--g))); top: calc(var(--r) * (var(--h) + var(--g)));
    width: var(--w); height: var(--h); border-radius: 2px; background: var(--tan);
    box-shadow: inset 0 calc(var(--h) * .18) 0 rgba(255, 255, 255, .22), inset 0 calc(var(--h) * -.16) 0 rgba(0, 0, 0, .18);
    transform: translate(calc(var(--x, 0) * (100% + var(--g))), calc(var(--y, 0) * (100% + var(--g)))) scaleX(var(--s, 0));
    transition: transform .42s cubic-bezier(.65, 0, .35, 1);
  }
  .ld-slat:nth-child(3n + 2) { background: var(--paper); }
  .ld-pct { position: absolute; left: 100%; top: calc(var(--h) * .2); margin-left: calc(var(--w) * .2); font-family: var(--f-label); font-weight: 600; font-size: max(13px, calc(var(--h) * .7)); line-height: 1; color: var(--tan); }
  .ld-badge { position: absolute; left: clamp(20px, 4vw, 48px); top: clamp(18px, 4vh, 40px); width: clamp(64px, 6vw, 88px); }
  .ld-badge :global(img) { display: block; width: 100%; height: auto; }
  .ld-hud { position: absolute; font-family: var(--f-label); font-weight: 600; font-size: 13px; line-height: 1.5; letter-spacing: .16em; text-transform: uppercase; color: var(--tan); }
  .ld-tr { right: clamp(20px, 4vw, 48px); top: clamp(22px, 4vh, 44px); text-align: right; }
  .ld-num { color: var(--mute); }
  .ld-dot { display: inline-block; width: 7px; height: 7px; margin-right: 8px; background: var(--red); vertical-align: 1px; }
  .ld-bl { left: clamp(20px, 4vw, 48px); bottom: clamp(22px, 4vh, 44px); font-size: clamp(13px, 1.1vw, 16px); }
  .ld-bl span { color: var(--mute); }
  .ld-mark { position: absolute; top: 50%; width: 14px; height: 14px; margin-top: -7px; opacity: .5; }
  .ld-mark::before, .ld-mark::after { content: ''; position: absolute; background: var(--tan); }
  .ld-mark::before { left: 6px; top: 0; width: 2px; height: 14px; }
  .ld-mark::after { top: 6px; left: 0; width: 14px; height: 2px; }
  .ld-m1 { left: clamp(20px, 4vw, 48px); } .ld-m2 { right: clamp(20px, 4vw, 48px); }
  .ld-skip { position: absolute; right: clamp(12px, 4vw, 40px); bottom: clamp(12px, 4vh, 32px); min-height: 44px; padding: 0 8px; font-family: var(--f-label); font-weight: 600; font-size: 13px; letter-spacing: .16em; text-transform: uppercase; color: var(--mute); transition: color .3s; }
  .ld-skip:hover { color: var(--paper); }
  @media (max-width: 767px) { .ld-m1, .ld-m2 { display: none; } .ld-bl { max-width: 60vw; font-size: 12px; bottom: 28px; } .ld-hud { font-size: 11px; } .ld-count { --dh: min(30vh, 25vw); } }
</style>
