---
// First-visit-per-session loader (MOTION.md section 3; shown only under html.intro, set before paint in Base.astro).
// Mike's version of Paul's beats (motion.ts runLoader drives them): a gauge ring draws round his hex badge, the badge
// settles, three flyer rules slide in, the words, then a pipe between two hex nuts fills with water while the page loads
// (min 1.8 s, max 3.4 s). The ink panel lifts with a wave as its trailing edge. Click, tap or any key skips.
import { Image } from 'astro:assets';
import logo from '../../assets/brand/logo-cream.png';
---
<div class="ld" data-loader aria-hidden="true">
  <div class="ld-panel">
    <div class="ld-core">
      <div class="ld-mark">
        <svg class="ld-ring" viewBox="0 0 120 120"><circle cx="60" cy="60" r="57" pathLength="1" /></svg>
        <span class="ld-seal"><Image src={logo} alt="" width={240} height={153} loading="eager" /></span>
      </div>
      <svg class="ld-stripes" viewBox="0 0 120 22" aria-hidden="true">
        <path class="s1" d="M20 0h80v2H20z" fill="#D2C5A6" /><path class="s2" d="M8 9h104v3H8z" fill="#D2C5A6" /><path class="s3" d="M20 19h80v2H20z" fill="#D2C5A6" />
      </svg>
      <p class="ld-word">Friendly <span>·</span> Transparent <span>·</span> Proficient</p>
      <div class="ld-pipe">
        <svg class="ld-nut" viewBox="0 0 22 26"><path d="M5 1h12l4 6v12l-4 6H5l-4-6V7z" /></svg>
        <span class="ld-tube"><span class="ld-water"></span></span>
        <svg class="ld-nut" viewBox="0 0 22 26"><path d="M5 1h12l4 6v12l-4 6H5l-4-6V7z" /></svg>
      </div>
    </div>
    <svg class="ld-edge" viewBox="0 0 1440 60" preserveAspectRatio="none"><path d="M0 0h1440v22c-120 0-200 30-360 30S840 14 720 14 480 44 330 44 120 18 0 18z" fill="#0E0D0B" /></svg>
  </div>
  <button type="button" class="ld-skip" data-loader-skip tabindex="-1">Skip intro</button>
</div>
<style>
  .ld { display: none; }
  :global(html.intro) .ld { display: block; position: fixed; inset: 0; z-index: var(--z-loader); }
  .ld-panel { position: absolute; inset: 0 0 auto 0; height: 100%; background: var(--ink); will-change: transform; }
  .ld-edge { position: absolute; left: 0; top: calc(100% - 1px); width: 100%; height: clamp(36px, 4.2vw, 60px); }
  .ld-core { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 18px; color: var(--paper); }
  .ld-mark { position: relative; width: 168px; height: 168px; }
  .ld-ring { position: absolute; inset: 0; width: 100%; height: 100%; transform: rotate(-90deg); overflow: visible; }
  .ld-ring circle { fill: none; stroke: var(--tan-dark); stroke-width: 1.5; stroke-dasharray: 1; stroke-dashoffset: 1; }
  .ld-seal { position: absolute; left: 24px; right: 24px; top: 50%; translate: 0 -50%; transform: scale(0); }
  .ld-seal :global(img) { width: 100%; height: auto; }
  .ld-stripes { width: 120px; height: 22px; overflow: visible; }
  .ld-stripes path { transform: translateX(-140%); opacity: 0; }
  .ld-word { font-family: var(--f-label); font-weight: 600; font-size: 13px; letter-spacing: .2em; text-transform: uppercase; color: var(--tan); opacity: 0; }
  .ld-word span { color: var(--tan-dark); }
  .ld-pipe { display: flex; align-items: center; width: min(280px, 70vw); margin-top: 4px; opacity: 0; }
  .ld-nut { width: 18px; height: 22px; flex: none; position: relative; z-index: 1; }
  .ld-nut path { fill: var(--tan); stroke: var(--ink); stroke-width: 1.5; }
  .ld-tube { position: relative; flex: 1; height: 12px; margin: 0 -3px; background: #2A2620; box-shadow: inset 0 0 0 1.5px var(--tan-dark); overflow: hidden; }
  .ld-water { position: absolute; inset: 2px; background: linear-gradient(90deg, var(--tan-dark), var(--tan)); transform-origin: left center; transform: scaleX(0); }
  .ld-water::after { content: ''; position: absolute; top: 2px; left: 6px; right: 6px; height: 1.5px; background: rgba(255, 255, 255, .35); }
  .ld-skip { position: absolute; right: 20px; bottom: 20px; min-height: 44px; padding: 0 16px; color: var(--mute); font-weight: 600; font-size: 13px; }
  .ld-skip:hover { color: var(--paper); }
</style>
