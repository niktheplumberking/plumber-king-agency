---
// "Free estimate" call-back bar straddling the hero / reviews edge (Figma 631:2037 y 920-1044; mobile card y 1194-1584).
// Real form: forms.ts validates name + phone and goes to /thank-you (or PUBLIC_FORM_ENDPOINT). Chips are checkboxes.
const CHIPS = ['Leak', 'Clog', 'No hot water', 'Sewer', 'Other'];
---
<div class="eb-wrap">
  <form class="est" data-estimate-form novalidate data-t="4" aria-labelledby="est-h">
    <div class="est-h">
      <h2 id="est-h" class="est-t">Free estimate</h2>
      <p class="est-s">Mike calls you back.</p>
    </div>
    <label class="fld"><span class="sr-only">Your name</span><input name="name" type="text" autocomplete="name" placeholder="Your name" required /></label>
    <label class="fld"><span class="sr-only">Phone</span><input name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="Phone" required /></label>
    <fieldset class="chips">
      <legend>What's going on?</legend>
      <div class="chip-row">
        {CHIPS.map((c, i) => <label class="chip"><input type="checkbox" name="issue" value={c} checked={i === 0} /><span>{c}</span></label>)}
      </div>
    </fieldset>
    <div class="est-go">
      <button type="submit" class="go">Call me back<svg class="go-a" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16"/><path d="m14 6 6 6-6 6"/></svg></button>
      <p class="est-ns">No spam. Just Mike.</p>
    </div>
    <p class="est-msg" data-form-msg role="status" aria-live="polite"></p>
  </form>
</div>
<style>
  .eb-wrap { position: relative; z-index: 3; width: calc(100% - 2 * var(--gutter)); margin: -60px auto 0; }
  .est { position: relative; display: grid; grid-template-columns: 159px 180px 180px auto 1fr; align-items: start; column-gap: 12px; height: 124px; padding: 28px 44px 0 29px; background: var(--paper); border-top: 6px solid var(--tan); box-shadow: 0 30px 60px -20px rgba(14, 13, 11, .45), 0 2px 6px rgba(14, 13, 11, .08); }
  .est-t { margin-top: -2px; font-family: var(--f-script); font-weight: 400; font-size: 31px; line-height: 36px; color: var(--ink); }
  .est-s { margin-top: 5px; font-size: 13px; line-height: 16px; color: var(--ink-2); }
  .fld input { width: 100%; height: 56px; padding: 0 15px; border: 1px solid #CFC4AD; border-radius: 2px; background: #fff; font-size: 15px; color: var(--ink); }
  .fld input::placeholder { color: #8A826F; }
  .fld input:focus { outline: 2px solid var(--tan-dark); outline-offset: 1px; }
  .fld input[aria-invalid='true'] { border-color: var(--red); }
  .chips { margin: -6px 0 0 4px; padding: 0; border: 0; min-width: 0; }
  .chips legend { padding: 0; margin-bottom: 8px; font-family: var(--f-label); font-weight: 600; font-size: 11px; line-height: 14px; letter-spacing: .12em; text-transform: uppercase; color: var(--tan-dark); }
  .chip-row { display: flex; gap: 8px; }
  .chip { position: relative; cursor: pointer; }
  .chip input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .chip span { display: grid; place-items: center; height: 34px; padding: 0 13px; border: 1.5px solid var(--ink); border-radius: 17px; font-weight: 600; font-size: 13px; color: var(--ink); white-space: nowrap; transition: background .25s, color .25s; }
  .chip input:checked + span { background: var(--ink); color: var(--paper); }
  .chip:hover span { background: rgba(14, 13, 11, .06); }
  .chip input:checked:hover + span { background: #2A2620; }
  .chip input:focus-visible + span { outline: 3px solid var(--tan-dark); outline-offset: 2px; }
  .est-go { justify-self: end; display: grid; justify-items: center; gap: 8px; }
  .go { display: inline-flex; align-items: center; justify-content: center; gap: 0; width: 146px; height: 56px; border-radius: 2px; background: var(--ink); color: var(--tan); font-weight: 600; font-size: 15px; transition: background .25s; }
  .go-a { width: 0; opacity: 0; transition: width .3s var(--ease-out), opacity .3s, margin .3s; }
  .go:hover { background: #2A2620; }
  .go:hover .go-a { width: 18px; margin-left: 8px; opacity: 1; }
  .est-ns { font-size: 12px; line-height: 14px; color: var(--ink-2); }
  .est-msg { position: absolute; left: 29px; bottom: 8px; font-size: 13px; font-weight: 600; color: #A3301F; }
  .est-msg:empty { display: none; }

  @media (min-width: 768px) and (max-width: 1279px) {
    .eb-wrap { margin-top: -80px; }
    .est { grid-template-columns: 1fr 1fr 1fr; gap: 16px; height: auto; padding: 24px 28px 36px; }
    .chips { grid-column: 1 / 3; margin: 0; }
    .chip-row { flex-wrap: wrap; }
    .est-go { align-self: end; }
  }
  @media (max-width: 767px) {
    .eb-wrap { margin-top: -40px; }
    .est { display: flex; flex-direction: column; align-items: stretch; height: auto; padding: 22px 20px 20px; gap: 0; border-top-width: 6px; }
    .est-t { font-size: 28px; line-height: 32px; }
    .est-s { margin-top: 2px; }
    .fld:first-of-type { margin-top: 14px; }
    .fld + .fld { margin-top: 10px; }
    .fld input { height: 50px; }
    .chips { margin: 20px 0 0; }
    .chip span { height: 32px; }
    .chip-row { flex-wrap: wrap; }
    .est-go { justify-self: stretch; margin-top: 14px; display: block; }
    .go { width: 100%; height: 50px; }
    .go-a { width: 18px; margin-left: 8px; opacity: 1; }
    .est-ns { display: none; }
    .est-msg { position: static; margin-top: 10px; }
  }
</style>
