---
// Eyebrow: small hex-nut outline + Oswald caps (Figma: every Home section head). `dot` = red live dot instead of the nut.
interface Props { class?: string; dot?: boolean; [k: string]: any }
const { class: cls, dot, ...rest } = Astro.props;
---
<p class:list={['eb', cls]} {...rest}>
  {dot ? <span class="eb-dot" aria-hidden="true"></span> : <svg class="eb-hex" viewBox="0 0 20 15" aria-hidden="true"><path d="M5 1.2h10l3.8 6.3L15 13.8H5L1.2 7.5z" /></svg>}
  <span><slot /></span>
</p>
<style>
  .eb { display: flex; align-items: center; gap: 9px; font-family: var(--f-label); font-weight: 600; font-size: 14px; line-height: 16px; letter-spacing: .1em; text-transform: uppercase; color: var(--tan); }
  .eb-hex { flex: none; width: 20px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linejoin: round; }
  .eb-dot { flex: none; width: 12px; height: 12px; border-radius: 50%; background: var(--red); }
  :global(.on-paper) .eb { color: var(--tan-dark); }
  @media (max-width: 767px) { .eb { font-size: 12px; line-height: 14px; gap: 8px; } .eb-hex { width: 18px; height: 13px; } }
</style>
