---
// Wave seam between two sections (Figma: every "wave seam" node). A sine boundary measured from the Figma frame:
// `c` centre, `a` amplitude, `p` period, `m` x of the crest (the boundary's highest point), all in Figma px over 1440
// (`w` = frame width, 390 on phones). `top` = the colour above the line, `bottom` = below. Sits absolutely at `y`
// (px from the top of the section it is placed in; negative = above it) and is `h` tall. Desktop and mobile variants
// are separate instances (`only`).
interface Props { c: number; a: number; p: number; m: number; h: number; y: number; top: string; bottom: string; w?: number; only?: 'd' | 'm'; class?: string }
const { c, a, p, m, h, y, top, bottom, w = 1440, only, class: cls } = Astro.props;
const pts: string[] = [];
for (let x = 0; x <= w; x += w / 144) {
  const yy = c - a * Math.cos((2 * Math.PI * (x - m)) / p);
  pts.push(`${x.toFixed(1)} ${yy.toFixed(2)}`);
}
const line = 'L' + pts.join(' L');
const below = `M${pts[0]} ${line} V${h} H0 Z`;
const above = `M${pts[0]} ${line} V0 H0 Z`;
---
<svg class:list={['wave', only && `only-${only}`, cls]} viewBox={`0 0 ${w} ${h}`} preserveAspectRatio="none" aria-hidden="true" style={`top:${y}px;height:${h}px`}>
  <path d={above} fill={top} />
  <path d={below} fill={bottom} />
</svg>
<style>
  .wave { position: absolute; left: 0; width: 100%; z-index: 2; pointer-events: none; display: block; }
  @media (max-width: 767px) { .only-d { display: none; } }
  @media (min-width: 768px) { .only-m { display: none; } }
</style>
