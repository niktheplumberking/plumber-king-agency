---
// Work wall "Every job gets the stamp" (Figma 631:2037 y 3920-4800; mobile 640:437 y 5209-6221). Text + IG card left,
// a three-column masonry of his stamped job photos (chamfered tiles), a Yelp quote tile and a "Stamped by Mike" tile.
// The pipe/valve seam below it lives in Diagnosis.astro (it sits above this section).
import Img from '../ui/Img.astro';
import Eyebrow from '../kit/Eyebrow.astro';
import Badge from './Badge.astro';
import Wave from '../kit/Wave.astro';
import { SITE } from '../../data/site';
const arrow = '<svg viewBox="0 0 18 10" width="16" height="10" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M0 5h16M12 1l4 4-4 4"/></svg>';
---
<section class="wk on-ink" aria-labelledby="wk-h" data-m-section>
  <Wave only="d" z={2} top={-30} d={{ path: 'M0 14C80 -4.66667 160 -4.66667 240 14C320 32.6667 400 32.6667 480 14C560 -4.66667 640 -4.66667 720 14C800 32.6667 880 32.6667 960 14C1040 -4.66667 1120 -4.66667 1200 14C1280 32.6667 1360 32.6667 1440 14C1520 -4.66667 1600 -4.66667 1680 14V36H0V14Z', h: 36 }} fill="#0E0D0B" />
  <Wave only="m" z={2} topM={-20} m={{ path: 'M0 9C40 -3 80 -3 120 9C160 21 200 21 240 9C280 -3 320 -3 360 9C400 21 440 21 480 9V26H0V9Z', h: 26, w: 390 }} fill="#0E0D0B" />
  <div class="wk-in">
    <div class="wk-txt">
      <div class="shead">
        <Eyebrow data-t="1">From Mike's Instagram</Eyebrow>
        <h2 id="wk-h" class="h2" data-t="2">Every job <span class="tn">gets the stamp.</span></h2>
      </div>
      <p class="lead" data-t="3">Mike stamps his logo on every job he posts<span class="d">: corroded copper, crawl spaces, slab leaks, commercial kitchens</span>. Real jobs, real mess, real fixes.</p>
      <div class="ig" data-t="4">
        <p class="ig-h">{SITE.social.instagramHandle}</p>
        <p class="ig-s">43 posts · 248 followers · checked 17 Nov 2026</p>
        <a class="ig-b" href={SITE.social.instagram} target="_blank" rel="noopener">Follow the jobs <Fragment set:html={arrow} /><span class="sr-only"> (Instagram, opens in a new tab)</span></a>
      </div>
      <p class="want" data-t="3">Want yours stamped? Call <a href={SITE.tel}>{SITE.phone}</a></p>
    </div>
    <div class="wall" data-t="4" data-stagger>
      <figure class="tile t1"><Img name="water-pressure-regulator-replacement" alt="Pressure regulator replaced on the supply pipes, stamped with Mike's logo" sizes="(min-width: 1024px) 240px, 170px" widths={[240, 351]} /></figure>
      <figure class="tile t2"><Img name="bathroom-plumbing-rough-in" alt="Open framing with new drain and supply rough-in for a bathroom" sizes="(min-width: 1024px) 240px, 170px" widths={[240, 480]} focus="50% 60%" /></figure>
      <figure class="tile t3"><Img name="drain-slime-job-stamp" alt="Utility room job with Mike's green slime stamp" sizes="(min-width: 1024px) 224px, 170px" widths={[240, 351]} /></figure>
      <blockquote class="tile qt">
        <span class="qm" aria-hidden="true">“</span>
        <p><span class="d">Mike did a couple of jobs in my house! </span>He's my first phone call when I need a plumber.</p>
        <footer>Brandon A. · Yelp<span class="d"> · Aug 20, 2026</span></footer>
      </blockquote>
      <figure class="tile t4"><Img name="corroded-copper-pipe-leak" alt="Copper water lines with green corrosion before the repair" sizes="(min-width: 1024px) 240px, 170px" widths={[240, 351]} focus="50% 12%" /></figure>
      <div class="tile st" aria-label="Stamped by Mike, est. 2025">
        <span class="st-hex"><svg viewBox="0 0 184 118" aria-hidden="true"><path d="M30 1h124l29 58-29 58H30L1 59z"/></svg><span class="st-a">Stamped</span><span class="st-b">by Mike</span></span>
        <span class="st-e">Est 2025</span>
      </div>
      <Badge w={150} deg={-14} class="wk-badge" data-t="5" data-idle="thump" />
    </div>
  </div>
</section>
<style>
  .wk { position: relative; z-index: 1; background: var(--ink); color: var(--paper); height: 880px; }
  .wk-in { position: relative; display: grid; grid-template-columns: 460px 1fr; width: calc(100% - 2 * var(--gutter)); margin-inline: auto; }
  .wk-txt { padding-top: 113px; }
  .h2 { margin-top: 15px; font-family: var(--f-display); font-weight: 400; font-size: 56px; line-height: 58px; color: var(--paper); }
  .h2 .tn { display: block; color: var(--tan); }
  .lead { margin-top: 42px; max-width: 400px; font-size: 17px; line-height: 26px; color: #CFC8B8; }
  .ig { width: 400px; margin-top: 74px; padding: 23px 24px 24px; background: var(--tan); color: var(--ink); border-radius: 3px; }
  .ig-h { font-family: var(--f-label); font-weight: 600; font-size: 24px; line-height: 30px; }
  .ig-s { margin-top: 2px; font-size: 14px; line-height: 18px; color: var(--ink-2); }
  .ig-b { display: inline-flex; align-items: center; gap: 8px; width: 220px; height: 46px; margin-top: 22px; padding: 0 20px; background: var(--ink); color: var(--paper); font-weight: 600; font-size: 15px; border-radius: 2px; transition: background .25s; }
  .ig-b:hover { background: #2A2620; }
  .want { margin-top: 30px; font-weight: 700; font-size: 15px; color: var(--tan); }
  .want a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .wall { position: relative; display: grid; grid-template-columns: 240px 240px 224px; grid-template-rows: 250px 152px 18px 222px; column-gap: 18px; row-gap: 0; margin: 102px 0 0 0; justify-content: end; }
  .tile { position: relative; margin: 0; overflow: hidden; background: #1C1A16; clip-path: polygon(20px 0, calc(100% - 20px) 0, 100% 20px, 100% calc(100% - 20px), calc(100% - 20px) 100%, 20px 100%, 0 calc(100% - 20px), 0 20px); }
  .t1 { grid-column: 1; grid-row: 1 / 3; }
  .t4 { grid-column: 1; grid-row: 4; margin-top: 0; }
  .t2 { grid-column: 2; grid-row: 1; }
  .qt { grid-column: 2; grid-row: 2 / 5; margin-top: 18px; display: flex; flex-direction: column; padding: 30px 24px 42px; background: var(--tan); color: var(--ink); clip-path: none; }
  .t3 { grid-column: 3; grid-row: 1 / 3; height: 330px; }
  .st { grid-column: 3; grid-row: 2 / 5; margin-top: 98px; display: grid; place-content: center; justify-items: center; gap: 30px; background: #1C1A16; clip-path: none; }
  .wall { grid-template-rows: 250px 170px 18px 222px; }
  .t1 { height: 420px; }
  .qm { font-family: var(--f-display); font-size: 84px; line-height: 60px; height: 40px; }
  .qt p { margin-top: 24px; font-family: var(--f-display); font-size: 24px; line-height: 28px; }
  .qt footer { margin-top: auto; font-family: var(--f-label); font-weight: 600; font-size: 12px; letter-spacing: .08em; white-space: nowrap; text-transform: uppercase; color: var(--ink-2); }
  .st-hex { position: relative; display: grid; place-content: center; justify-items: center; width: 184px; height: 118px; }
  .st-hex svg { position: absolute; inset: 0; width: 100%; height: 100%; fill: none; stroke: var(--tan); stroke-width: 1.5; }
  .st-a { font-family: var(--f-label); font-weight: 600; font-size: 30px; line-height: 32px; letter-spacing: .16em; text-transform: uppercase; color: var(--tan); }
  .st-b { font-family: var(--f-script); font-size: 28px; line-height: 28px; color: var(--tan); }
  .st-e { font-family: var(--f-label); font-weight: 500; font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: var(--mute); }
  .wall :global(.wk-badge) { position: absolute; left: -36px; top: -54px; z-index: 2; }

  @media (max-width: 1279px) { .wk { height: auto; padding-bottom: 110px; } }
  @media (min-width: 768px) and (max-width: 1279px) {
    .wk-in { grid-template-columns: minmax(0, 36%) 1fr; gap: 40px; }
    .ig { width: 100%; }
    .h2 { font-size: clamp(40px, 4.6vw, 56px); line-height: 1.04; }
    .wall { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 14px; }
  }
  @media (max-width: 1023px) and (min-width: 768px) { .wk-in { grid-template-columns: 1fr; } .wall { margin-top: 64px; } }
  @media (max-width: 767px) {
    .wk { padding-bottom: 56px; }
    .wk-in { display: flex; flex-direction: column; }
    .wk-txt { display: contents; }
    .shead { order: 1; padding-top: 55px; }
    .h2 { margin-top: 9px; font-size: 36px; line-height: 37.4px; }
    .lead { order: 2; margin-top: 12px; font-size: 15px; line-height: 22.5px; color: rgba(243,236,221,.8); }
    .lead .d, .qt .d { display: none; }
    .wall { order: 3; grid-template-columns: 1fr 1fr; grid-template-rows: 190px 102px 140px 92px; gap: 8px; margin-top: 24px; justify-content: stretch; }
    .t1 { grid-column: 1; grid-row: 1 / 3; height: auto; }
    .t2 { grid-column: 2; grid-row: 1; height: auto; }
    .qt { grid-column: 2; grid-row: 2 / 4; margin-top: 0; padding: 0 14px 20px; }
    .qm { font-size: 56px; line-height: 76px; height: 62px; }
    .qt p { margin-top: 0; font-size: 19px; line-height: 22px; }
    .qt footer { font-size: 11px; color: #3A2E1C; }
    .t3 { grid-column: 1; grid-row: 3 / 5; height: auto; margin-top: 0; }
    .t4 { grid-column: 2; grid-row: 4; height: auto; margin-top: 0; }
    .st { display: none; }
    .wall :global(.wk-badge) { left: auto; right: 10px; top: auto; bottom: 8px; width: 110px; }
    .ig { order: 4; width: 100%; margin-top: 26px; padding: 18px 20px 0; height: 146px; }
    .ig-h { font-size: 22px; line-height: 33px; }
    .ig-s { margin-top: 3px; font-size: 12px; line-height: 13px; color: rgba(14,13,11,.8); }
    .ig-b { width: 200px; height: 44px; margin-top: 15px; font-size: 14px; color: var(--tan); }
    .want { display: none; }
    .tile { clip-path: polygon(14px 0, calc(100% - 14px) 0, 100% 14px, 100% calc(100% - 14px), calc(100% - 14px) 100%, 14px 100%, 0 calc(100% - 14px), 0 14px); }
  }
</style>
