---
// VFACT eyebrow: a 20 x 14 chamfered hex-nut outline + Oswald caps label (Figma dumps: Oswald Medium 14 px, tracking 12%; phone 12 px).
// `tone` sets the colour: tan (on ink), deep (tan-dark on paper/tan), ink. `dot` swaps the hex for a red live dot.
interface Props { text: string; tone?: 'tan' | 'deep' | 'ink' | 'mute'; class?: string; dot?: boolean; icon?: boolean; t?: string | false; }
const { text, tone = 'tan', class: cls, dot = false, icon = true, t = '1' } = Astro.props;
---
<p class:list={['eb', `eb-${tone}`, cls]} data-t={t || undefined}>
  {icon && (dot ? <span class="eb-dot" aria-hidden="true"></span> :
    <svg class="eb-hex" viewBox="0 0 20 15" aria-hidden="true" focusable="false"><path d="M3.14.8h13.32l2.34 6.5-2.34 6.5H3.14L.8 7.3z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>)}
  <span>{text}</span>
</p>
<style>
  .eb { display: flex; align-items: center; gap: 10px; margin: 0; font-family: var(--f-label); font-weight: 500; font-size: 14px; line-height: 21px; letter-spacing: .12em; text-transform: uppercase; }
  .eb-hex { width: 20px; height: 15px; flex: none; margin: 0 -1px; }
  .eb-dot { width: 12px; height: 12px; border-radius: 50%; background: var(--red); flex: none; margin-right: 1px; }
  .eb-tan { color: var(--tan); } .eb-deep { color: var(--tan-dark); } .eb-ink { color: var(--ink); } .eb-mute { color: var(--mute); }
  @media (max-width: 767px) { .eb { font-size: 12px; line-height: 18px; gap: 8px; } }
</style>
