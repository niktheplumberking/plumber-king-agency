---
// 8.3 One job up close (Figma 670:7598 / 670:9554): the case file in a manila folder (his post, word for word) and the heater
// photo with three numbered callout pins drawn as pipe tags. Mobile: pins on the photo + a numbered legend below it.
// Scroll moment (Nick's numbered stops): as the photo scrolls through, pins 1, 2, 3 light up in order (scale 1.08, small
// turn) and each one's dashed leader runs out to its pipe tag. Reduced motion / no JS = the Figma state (all leaders drawn).
import logoCream from '../../assets/brand/logo-cream.png';
import Eyebrow from '../b3kit/Eyebrow.astro';
import Wave from '../b3kit/Wave.astro';
import Img from '../ui/Img.astro';
// pin = centre on the 560 x 660 photo (desktop px, used as % for every size); line = leader end in section px; tag = desktop tag box
const PINS = [
  { t: '75-gallon gas water heater', p: [336, 363], line: [1136, 473], tag: [1136, 451], dir: 'l' },
  { t: 'Gas control valve. “simply the gas control valve”', p: [437, 145], line: [1117, 317], tag: [867, 295], dir: 'r' },
  { t: '“was told it needed to be replaced”', p: [157, 568], line: [957, 678], tag: [957, 656], dir: 'l' },
];
const PX = 740, PY = 110, n = PINS.length;
---
<section class="oc on-ink" aria-labelledby="oc-h" data-m-section>
  <Wave d="o2d" m="o2m" top={2886} topM={2744} />
  <div class="oc-in">
    <div class="oc-folder" data-t="4" data-fx="nudge">
      <p class="oc-label">CASE FILE · No. 01</p>
      <Eyebrow>Case file</Eyebrow>
      <h2 id="oc-h" class="oc-h">Diagnosis <span class="tone">matters.</span></h2>
      <blockquote class="oc-q"><p>“...was told it needed to be replaced. After properly diagnosing it, we found the issue was simply the gas control valve.”</p></blockquote>
      <p class="oc-by">Mike Navarro, on his Instagram</p>
      <a class="oc-link" href="/water-heaters">Read the full story <span aria-hidden="true">→</span></a>
      <span class="oc-stamp" aria-hidden="true" style={`--logo:url(${logoCream.src})`}></span>
    </div>
    <div class="oc-stage" data-b3-scrub data-b3-start="top 75%" data-b3-end="bottom 65%">
      <figure class="oc-photo" data-t="4">
        <Img name="water-heater-gas-valve-riverside" alt="The 75-gallon gas water heater and its gas control valve" sizes="(min-width: 768px) 560px, 92vw" box={560 / 660} boxM={362 / 420} />
        {PINS.map((p, i) => (
          <span class="oc-pin" style={`left:${(p.p[0] / 5.6).toFixed(2)}%;top:${(p.p[1] / 6.6).toFixed(2)}%`} data-b3-stop={((i + 0.15) / n).toFixed(3)} aria-hidden="true"><span class="oc-dot">{i + 1}</span></span>
        ))}
      </figure>
      <svg class="oc-leaders" viewBox="0 0 1440 880" aria-hidden="true">
        {PINS.map((p, i) => <path d={`M${PX + p.p[0]} ${PY + p.p[1]} L${p.line[0]} ${p.line[1]}`} pathLength="1" data-b3-path data-b3-from={((i + 0.15) / n).toFixed(3)} data-b3-to={((i + 0.75) / n).toFixed(3)} />)}
      </svg>
      <ol class="oc-tags" role="list" aria-label="Callouts on the photo">
        {PINS.map((p, i) => (
          <li class:list={['oc-tag', `oc-tag--${p.dir}`]} style={`--x:${p.tag[0]}px;--y:${p.tag[1]}px`} data-b3-stop={((i + 0.75) / n).toFixed(3)}>
            <span class="oc-n">{i + 1}</span><span class="oc-tt">{p.t}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
<style>
  .oc { position: relative; height: 880px; background: var(--ink); }
  .oc-in { position: relative; width: 1440px; height: 100%; margin: 0 auto; }
  .oc-folder { position: absolute; left: 96px; top: 110px; width: 560px; height: 640px; padding: 89px 40px 0; }
  .oc-folder::before { content: ''; position: absolute; left: 0; top: 0; width: 250px; height: 41px; background: var(--tan); clip-path: polygon(0 0, 222px 0, 250px 100%, 0 100%); }
  .oc-folder::after { content: ''; position: absolute; left: 0; right: 0; top: 40px; bottom: 0; background: var(--tan); z-index: -1; }
  .oc-folder { isolation: isolate; }
  .oc-label { position: absolute; left: 24px; top: 12px; font-family: var(--f-label); font-weight: 600; font-size: 13px; line-height: 19px; letter-spacing: .14em; color: var(--ink); }
  .oc-h { margin-top: 13px; font-family: var(--f-display); font-weight: 400; font-size: 66px; line-height: 1.02; color: var(--ink); }
  .oc .tone { color: var(--tan-dark); }
  .oc-q { margin: 28px 0 0; width: 470px; }
  .oc-q p { font-style: italic; font-size: 21px; line-height: 1.5; color: var(--ink); }
  .oc-by { margin-top: 18px; font-family: var(--f-label); font-weight: 500; font-size: 12px; line-height: 18px; letter-spacing: .14em; text-transform: uppercase; color: var(--tan-dark); }
  .oc-link { position: absolute; left: 40px; top: 550px; display: inline-flex; gap: 8px; font-weight: 700; font-size: 16px; line-height: 17px; color: var(--ink); text-decoration: underline; text-underline-offset: 4px; }
  .oc-link:hover { color: var(--tan-dark); }
  .oc-stamp { position: absolute; left: 374px; top: 490px; width: 150px; height: 98px; background: rgba(217, 65, 43, .9); -webkit-mask: var(--logo) center / contain no-repeat; mask: var(--logo) center / contain no-repeat; transform: rotate(12deg); transform-origin: 0 0; }

  .oc-stage { position: absolute; inset: 0; }
  .oc-photo { position: absolute; left: 740px; top: 110px; width: 560px; height: 660px; margin: 0; border-radius: 6px; overflow: hidden; }
  .oc-pin { position: absolute; width: 60px; height: 60px; margin: -30px 0 0 -30px; border-radius: 50%; background: rgba(217, 65, 43, .25); display: grid; place-items: center; transition: transform .45s var(--ease-back), background-color .3s; }
  .oc-dot { width: 32px; height: 32px; border-radius: 50%; background: var(--red); box-shadow: inset 0 0 0 2.5px var(--paper); display: grid; place-items: center; font-family: var(--f-label); font-weight: 700; font-size: 16px; line-height: 1; color: var(--paper); }
  .oc-pin.is-on { transform: scale(1.08) rotate(-6deg); background: rgba(217, 65, 43, .4); }
  .oc-leaders { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .oc-leaders path { fill: none; stroke: var(--paper); stroke-width: 1.5; stroke-dasharray: 1; stroke-dashoffset: 0; }
  /* the leaders are dashed (4 4): a mask of dashes over the drawn line keeps the dash while dashoffset draws it */
  .oc-leaders { -webkit-mask: repeating-linear-gradient(90deg, #000 0 4px, transparent 4px 8px); mask: repeating-linear-gradient(90deg, #000 0 4px, transparent 4px 8px); }
  .oc-tags { margin: 0; padding: 0; list-style: none; }
  .oc-tag { position: absolute; left: var(--x); top: var(--y); width: 250px; height: 44px; padding: 6px 12px 0 34px; background: var(--paper); clip-path: polygon(22px 0, 100% 0, 100% 100%, 22px 100%, 0 50%); filter: drop-shadow(0 8px 7px rgba(0, 0, 0, .4)); font-weight: 700; font-size: 12.5px; line-height: 1.25; color: var(--ink); transition: transform .45s var(--ease-back); }
  .oc-tag--r { padding: 6px 34px 0 12px; clip-path: polygon(0 0, 228px 0, 100% 50%, 228px 100%, 0 100%); }
  .oc-tag::before { content: ''; position: absolute; left: 15px; top: 17px; width: 10px; height: 10px; border-radius: 50%; background: var(--ink); }
  .oc-tag--r::before { left: 225px; }
  .oc-tag.is-on { transform: scale(1.04); }
  .oc-n { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }

  @media (max-width: 1279px) {
    .oc { height: auto; padding: 60px 0 81px; }
    .oc-in { width: calc(100% - 2 * var(--gutter)); max-width: 760px; height: auto; }
    .oc-folder { position: relative; left: auto; top: auto; width: auto; height: auto; margin: 0 -6px; padding: 57px 18px 44px; }
    .oc-folder::before { width: 170px; height: 31px; clip-path: polygon(0 0, 150px 0, 170px 100%, 0 100%); }
    .oc-folder::after { top: 30px; }
    .oc-label { left: 14px; top: 10px; font-size: 11px; line-height: 16px; }
    .oc-folder :global(.eb) { font-size: 12px; line-height: 18px; }
    .oc-h { margin-top: 9px; font-size: 40px; }
    .oc-q { width: auto; margin-top: 16px; }
    .oc-q p { font-size: 16px; }
    .oc-by { margin-top: 12px; font-size: 10.5px; line-height: 16px; letter-spacing: .12em; }
    .oc-link { position: static; margin-top: 24px; font-size: 15px; line-height: 16px; }
    .oc-stamp { display: none; }
    .oc-stage { position: relative; inset: auto; margin-top: 28px; }
    .oc-photo { position: relative; left: auto; top: auto; width: calc(100% + 12px); height: auto; margin: 0 -6px; aspect-ratio: 362 / 420; }
    .oc-pin { width: 40px; height: 40px; margin: -20px 0 0 -20px; }
    .oc-dot { width: 24px; height: 24px; box-shadow: inset 0 0 0 2px var(--paper); font-size: 12px; }
    .oc-leaders { display: none; }
    .oc-tags { margin: 16px -4px 0; display: grid; gap: 12px; }
    .oc-tag { position: relative; left: auto; top: auto; width: auto; height: auto; padding: 0 0 0 30px; background: none; clip-path: none; filter: none; font-weight: 500; font-size: 13.5px; line-height: 18px; color: var(--paper); }
    .oc-tag--r { padding: 0 0 0 30px; clip-path: none; }
    .oc-tag::before { display: none; }
    .oc-n { position: absolute; left: 0; top: -1px; width: 20px; height: 20px; overflow: visible; clip-path: none; border-radius: 50%; background: var(--red); display: grid; place-items: center; font-family: var(--f-label); font-weight: 700; font-size: 11px; line-height: 1; color: var(--paper); }
    .oc-tag.is-on { transform: none; }
  }
  @media (min-width: 768px) and (max-width: 1279px) {
    .oc { padding: 100px 0 120px; }
    .oc-folder { padding: 80px 40px 50px; }
    .oc-h { font-size: clamp(48px, 6vw, 64px); }
    .oc-q p { font-size: 19px; }
    .oc-tag { font-size: 15px; line-height: 20px; }
  }
</style>
