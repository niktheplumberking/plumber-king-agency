---
// 9.1 Reviews hero (Figma 670:11578 y 180-1022 / 671:1096 y 164-904; fix round 1 B24 + round 2 reviews 1 and 7).
// Its own structure on the site: a wall of Mike's paper review slips (six real Yelp reviews, word for word, with initials,
// name, town and date) in two columns either side of a centred copy column: eyebrow, H1, rating line, the black 5.0 / 20
// reviews badge and the two buttons. Everything sits in a grid, so the badge never covers a slip and no slip covers
// text. 768-1279 px: copy on top, the slips in rows of three under it. Phones: copy, badge, buttons, then three slips
// stacked full width (the rest are on the list below). Entrance: the slips stagger in (engine); hover: a slip lifts
// (kit [data-hover=lift]); idle: the badge shakes. No AggregateRating anywhere.
import { SITE } from '../../data/site';
import Eyebrow from '../kit/Eyebrow.astro';
import Btn from '../kit/Btn.astro';
import { REVIEWS } from '../../data/reviews';
import { place, when, initials } from './fmt';
const R = SITE.rating;
// Six short reviews shown whole (word for word, from REVIEWS).
const pick = (n: string) => { const r = REVIEWS.find((x) => x.name === n); if (!r) throw new Error(`RevHero: no review from ${n}`); return r; };
const LEFT = ['Brandon A.', 'Janeth H.', 'Erik N.'].map(pick);
const RIGHT = ['Julian T.', 'Isaiah C.', 'Robert U.'].map(pick);
const TILT = [-1.6, 1.2, -0.8, 1.4, -1.2, 0.9];
const star = 'M12 1.6l3.1 7.1 7.7.7-5.8 5.1 1.7 7.6L12 18.1l-6.7 4 1.7-7.6-5.8-5.1 7.7-.7z';
const stars = [-6, 4, -2, 5, -4];
---
<section class="rh on-ink" aria-labelledby="rh-h" data-m-section data-m-hero>
  <div class="rh-in">
    {[LEFT, RIGHT].map((col, c) => (
      <ul class:list={['rh-col', c ? 'rh-col--r' : 'rh-col--l']} role="list" aria-label={c ? 'More Yelp reviews, word for word' : 'Yelp reviews, word for word'} data-t="4" data-stagger>
        {col.map((r, i) => (
          <li class="rh-slip" style={`--r:${TILT[c * 3 + i]}deg`} data-hover="lift">
            <figure>
              <blockquote><p>“{r.text}”</p></blockquote>
              <figcaption><span class="rh-av" aria-hidden="true">{initials(r.name)}</span><span class="rh-who"><b>{r.name}</b>{place(r.town)} · {when(r.date)}</span><span class="rh-st"><span aria-hidden="true">★★★★★</span><span class="sr-only">5 stars on Yelp</span></span></figcaption>
            </figure>
          </li>
        ))}
      </ul>
    ))}
    <div class="rh-copy">
      <Eyebrow look="page" text="Reviews · Yelp" />
      <h1 id="rh-h" class="rh-h1" data-t="2">Mike's Plumbing Services <span class="tn">Reviews</span></h1>
      <p class="rh-sub" data-t="3" data-fx="nudge">{R.value} on {R.source} · {R.count} reviews. Checked {R.checked}.</p>
      <a class="rh-badge" href={SITE.social.yelp} target="_blank" rel="noopener" data-t="5" data-fx="pop" data-idle="shake" aria-label={`${R.value}, ${R.count} reviews on ${R.source} (out of 5). Read them on Yelp (opens in a new tab)`}>
        <svg viewBox="0 0 250 160" preserveAspectRatio="none" aria-hidden="true"><path d="M32 1h186l31 79-31 79H32L1 80z" fill="#0E0D0B" stroke="#D2C5A6" stroke-width="2" vector-effect="non-scaling-stroke" /><path d="M40 10h170l27 70-27 70H40L13 80z" fill="none" stroke="#D2C5A6" stroke-opacity=".35" stroke-width="1.2" vector-effect="non-scaling-stroke" /></svg>
        <span class="rh-bv" aria-hidden="true">{R.value}</span>
        <span class="rh-stars" aria-hidden="true">{stars.map((d) => <svg viewBox="0 0 24 24" style={`rotate:${d}deg`}><path d={star} fill="#D2C5A6" /></svg>)}</span>
        <span class="rh-count" aria-hidden="true">{R.count} reviews on {R.source}</span>
      </a>
      <div class="rh-btns" data-t="3">
        <Btn look="bar" href={SITE.social.yelp} external w={260} arrow>Read them on Yelp</Btn>
        <Btn look="bar" href="/contact" v="line" w={230}>Get a free estimate</Btn>
      </div>
    </div>
  </div>
</section>
<style>
  .rh { position: relative; background: var(--ink); overflow-x: clip; padding: 150px 0 110px; }
  /* desktop: slips | copy | slips. The side columns are offset (left lower, right higher) so it reads as a wall. */
  .rh-in { display: grid; grid-template-columns: minmax(0, 330px) minmax(0, 1fr) minmax(0, 330px); grid-template-areas: 'l c r'; column-gap: 48px; align-items: center;
    width: min(1360px, calc(100% - 80px)); margin: 0 auto; }
  .rh-col { display: grid; gap: 26px; margin: 0; padding: 0; list-style: none; }
  .rh-col--l { grid-area: l; padding-top: 40px; } .rh-col--r { grid-area: r; padding-bottom: 40px; }
  .rh-copy { grid-area: c; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .rh-h1 { margin-top: 14px; font-family: var(--f-display); font-weight: 400; font-size: 68px; line-height: 1.03; color: var(--paper); }
  .tn { color: var(--tan); }
  .rh-sub { margin-top: 18px; font-size: 18px; line-height: 28px; color: #CAC4B7; }
  .rh-btns { display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; margin-top: 30px; }
  .rh-slip { rotate: var(--r); }
  .rh-slip figure { margin: 0; padding: 20px 22px 16px; background: var(--bone); border-top: 6px solid var(--tan); box-shadow: 0 22px 32px -18px rgba(0, 0, 0, .75); }
  .rh-slip blockquote { margin: 0; }
  .rh-slip p { font-family: var(--f-display); font-size: 17px; line-height: 1.3; color: var(--ink); }
  .rh-slip figcaption { display: grid; grid-template-columns: 34px 1fr auto; align-items: center; column-gap: 10px; margin-top: 14px; }
  .rh-av { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--ink); color: var(--tan); font-family: var(--f-label); font-weight: 600; font-size: 12px; letter-spacing: .06em; }
  .rh-who { display: grid; font-family: var(--f-label); font-weight: 500; font-size: 10.5px; line-height: 15px; letter-spacing: .1em; text-transform: uppercase; color: #6b5c3e; }
  .rh-who b { font-weight: 600; font-size: 13px; color: var(--ink); }
  .rh-st { font-size: 12px; letter-spacing: .1em; color: var(--red); }
  /* the badge is part of the copy column (in flow): it can never sit on a slip */
  .rh-badge { position: relative; display: grid; justify-items: center; align-content: center; width: 220px; height: 140px; margin-top: 30px; rotate: -4deg; color: var(--tan); text-decoration: none;
    filter: drop-shadow(0 16px 20px rgba(0, 0, 0, .55)); transition: translate .4s cubic-bezier(.45, 0, .55, 1); }
  .rh-badge > svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .rh-badge > span { position: relative; }
  .rh-bv { font-family: var(--f-display); font-size: 54px; line-height: 1; color: var(--paper); }
  .rh-stars { display: flex; gap: 6px; margin-top: 4px; }
  .rh-stars svg { width: 18px; height: 18px; }
  .rh-count { margin-top: 6px; font-family: var(--f-label); font-weight: 500; font-size: 11px; line-height: 14px; letter-spacing: .16em; text-transform: uppercase; }
  @media (hover: hover) and (pointer: fine) { .rh-badge:hover { translate: 0 -5px; } }
  @media (min-width: 768px) and (max-width: 1279px) {
    .rh { padding: 120px 0 120px; }
    .rh-in { grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-areas: 'c c c' 'l l l' 'r r r'; row-gap: 28px; column-gap: 20px; width: calc(100% - 2 * var(--gutter)); }
    .rh-col { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; align-items: start; padding: 0; }
    .rh-col--l { margin-top: 32px; }
    .rh-h1 { font-size: clamp(48px, 6vw, 68px); }
  }
  @media (max-width: 767px) {
    .rh { padding: 48px 0 66px; }
    .rh-in { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'c' 'l'; row-gap: 36px; }
    .rh-col--r { display: none; }
    .rh-col--l { padding: 0 6px; gap: 18px; }
    .rh-h1 { margin-top: 13px; font-size: 40px; line-height: 1.06; }
    .rh-sub { margin-top: 11px; font-size: 15px; line-height: 20px; }
    .rh-badge { width: 170px; height: 108px; margin-top: 22px; }
    .rh-bv { font-size: 40px; } .rh-stars svg { width: 13px; height: 13px; } .rh-stars { gap: 4px; } .rh-count { font-size: 9px; letter-spacing: .12em; }
    .rh-btns { display: grid; width: 100%; gap: 12px; margin-top: 24px; }
    .rh-btns :global(.bb) { width: 100%; justify-content: center; min-height: 58px; }
    .rh-btns :global(.bb + .bb) { min-height: 54px; }
    .rh-slip p { font-size: 17px; }
  }
</style>
