---
// 9.2 What people keep saying (Figma 670:11578 y 1022-1822 / 671:1096 y 904-1730). Tan field; three ink pipe-marker tapes
// wrapped round a drawn pipe, the customers' own words printed on them. The pipe runs off the left edge, turns down at the
// right (desktop) past a hex nut and ends in a capped stub with a drip, well above the seam (round 2, review 5: it used to
// run through the wave and stop flat inside Spotlight); on phones it runs down the middle behind stacked tapes.
// Scroll moment (data-scrub): water runs along the pipe as you scroll; each tape lights up and swells as the water
// reaches it, then the nut. Quotes are copied word for word from REVIEWS (checked in code, never retyped).
import Eyebrow from '../kit/Eyebrow.astro';
import Wave from '../kit/Wave.astro';
import { REVIEWS } from '../../data/reviews';
const all = REVIEWS.map((r) => r.text).join(' ').toLowerCase();
const q = (s: string) => { if (!all.includes(s.toLowerCase())) throw new Error(`RevPattern: "${s}" is not in REVIEWS`); return s; };
const tapes = [
  { label: 'Communication', words: [q('excellent communicator'), q('communicated well'), q('great communication skills')] },
  { label: 'Fair price', words: [q('reasonably priced'), q('fair and competitive'), q('quite reasonable'), q('fair price'), q('reasonable price')] },
  { label: 'Clean', words: [q('extremely conscientious about my lawn and cleaning up any mess'), q('Very clean')] },
];
---
<section class="rp" aria-labelledby="rp-h" data-m-section data-scrub data-stop-mode="pop" data-start="top 55%" data-end="bottom 35%" data-start-m="top 40%" data-end-m="bottom 60%">
  <Wave z={1} d={{ a: 16.5, L: 560.5 }} m={{ a: 10.3, L: 300.5 }} fill="#D2C5A6" above="#0E0D0B" />
  <div class="wrap rp-in">
    <div class="rp-head">
      <Eyebrow look="page" text="The pattern" tone="deep" />
      <h2 id="rp-h" class="rp-h2" data-t="2">Communication. Fair price. <span class="dk">Clean work.</span></h2>
      <p class="rp-lead" data-t="3">Every phrase on the tape is copied word for word from Mike's Yelp reviews.</p>
    </div>
  </div>
  <svg class="rp-pipe rp-pipe-d" viewBox="0 0 1440 940" aria-hidden="true" focusable="false" data-scrub-track>
    <path d="M-20 518H1308a42 42 0 0 1 42 42V700" fill="none" stroke="#6B5C3E" stroke-width="84" />
    <path d="M-20 493.5H1308a23.5 23.5 0 0 1 23.5 23.5V690" fill="none" stroke="#F3ECDD" stroke-opacity=".25" stroke-width="4" stroke-linecap="round" />
    <path class="rp-water" d="M-20 518H1308a42 42 0 0 1 42 42V700" pathLength="1" fill="none" stroke="#F3ECDD" stroke-opacity=".32" stroke-width="30" data-scrub-path />
    <!-- B25: the nut sits on the pipe's turn: centred on the vertical leg (x 1350, the pipe's centreline) right where the elbow ends (y 560) -->
    <g data-stop data-rot="4" data-idle="nut" style="transform-origin:1350px 590px"><path d="M1311 561h78l15 29-15 29h-78l-15-29z" fill="#D2C5A6" stroke="#0E0D0B" stroke-width="2" /><path data-lit opacity="0" d="M1311 561h78l15 29-15 29h-78l-15-29z" fill="#F3ECDD" stroke="#0E0D0B" stroke-width="2" /></g>
    <!-- end cap + a drip: the run ends here, 60+ px above the Spotlight wave -->
    <rect x="1300" y="696" width="100" height="22" rx="5" fill="#57492F" stroke="#0E0D0B" stroke-width="2" />
    <path class="rp-drip" d="M1350 728c-4 6-7 10-7 13.5a7 7 0 0 0 14 0c0-3.5-3-7.5-7-13.5z" fill="#F3ECDD" fill-opacity=".55" />
  </svg>
  <svg class="rp-pipe rp-pipe-m" viewBox="0 0 390 520" preserveAspectRatio="xMidYMin meet" aria-hidden="true" focusable="false">
    <rect x="167" y="0" width="56" height="440" fill="#6B5C3E" />
    <rect x="160" y="436" width="70" height="14" rx="4" fill="#57492F" stroke="#0E0D0B" stroke-width="1.5" />
    <rect class="rp-water-m" x="183" y="0" width="24" height="436" fill="#F3ECDD" fill-opacity=".32" data-scrub-fill data-axis="y" />
    <g data-stop data-rot="4" style="transform-origin:195px 311px"><path d="M180 292h30l15 19-15 19h-30l-15-19z" fill="#D2C5A6" stroke="#0E0D0B" stroke-width="1.5" /><path data-lit opacity="0" d="M180 292h30l15 19-15 19h-30l-15-19z" fill="#F3ECDD" stroke="#0E0D0B" stroke-width="1.5" /></g>
  </svg>
  <ul class="wrap rp-tapes" role="list" data-t="4" data-stagger>
    {tapes.map((t, i) => (
      <li class="rp-li">
        <div class="rp-tape" data-stop data-rot={i % 2 ? '-1.5' : '1.5'}>
          <span class="rp-lit" data-lit aria-hidden="true"></span>
          <h3 class="rp-lab"><span aria-hidden="true">→</span>{t.label}<span aria-hidden="true">→</span></h3>
          <p class="rp-q">{t.words.map((w, j) => <>{j > 0 && <span class="rp-dot" aria-hidden="true"> · </span>}<q>{w}</q></>)}</p>
        </div>
      </li>
    ))}
  </ul>
</section>
<style>
  .rp { position: relative; height: 800px; background: var(--tan); color: var(--ink); overflow-x: clip; }
  .rp-in { position: relative; z-index: 2; padding-top: 147px; }
  .rp-h2 { margin-top: 10px; font-family: var(--f-display); font-weight: 400; font-size: 64px; line-height: 66.56px; color: var(--ink); }
  .dk { color: var(--tan-dark); }
  .rp-lead { margin-top: 29px; font-size: 17px; line-height: 26px; color: var(--ink-2); }
  .rp-pipe { position: absolute; left: 0; top: 0; z-index: 3; pointer-events: none; overflow: visible; }
  .rp-pipe-d { width: 1440px; height: 940px; }
  .rp-pipe-m { display: none; }
  .rp-water-m { transform-origin: 50% 0; transform-box: fill-box; }
  .rp-tapes { position: absolute; left: 0; right: 0; top: 456px; z-index: 4; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin: 0 auto; padding: 0; }
  .rp-tape { position: relative; height: 124px; padding: 26px 20px 0; background: var(--ink); color: var(--paper);
    background-image: linear-gradient(#21201E 0 10px, transparent 10px calc(100% - 12px), #090807 calc(100% - 12px));
    box-shadow: 0 14px 18px -6px rgba(14, 13, 11, .35); }
  .rp-lit { position: absolute; inset: 0; opacity: 0; box-shadow: inset 0 0 0 2px var(--tan), 0 0 0 1px rgba(210, 197, 166, .4); pointer-events: none; }
  .rp-lab { display: flex; align-items: center; gap: 22px; margin: 0; font-family: var(--f-label); font-weight: 600; font-size: 24px; line-height: 24px; letter-spacing: .06em; text-transform: uppercase; color: var(--tan); }
  .rp-lab span { font-family: var(--f-sans); font-weight: 400; letter-spacing: 0; }
  .rp-q { margin-top: 11px; font-size: 13.5px; line-height: 18px; color: var(--paper); }
  .rp-q q { quotes: '\201C' '\201D'; }
  .rp-dot { color: var(--mute); }
  html.motion .rp-tape { will-change: transform; }
  /* Tablet: the same pipe run, fluid. The drawn elbow is desktop-only; the pipe runs straight behind the tapes. */
  @media (min-width: 768px) and (max-width: 1279px) {
    .rp { height: auto; padding-bottom: 140px; }
    .rp-pipe-d { width: 100%; height: auto; top: auto; bottom: 108px; }
    .rp-tapes { position: relative; top: auto; margin-top: 64px; gap: 16px; }
    .rp-tape { height: auto; min-height: 124px; padding-bottom: 20px; }
    .rp-lab { font-size: 20px; gap: 14px; }
    .rp-h2 { font-size: clamp(44px, 5.4vw, 68px); line-height: 1.03; }
  }
  @media (max-width: 767px) {
    .rp { height: 826px; }
    .rp-in { padding-top: 71px; }
    .rp-h2 { margin-top: 12px; font-size: 40px; line-height: 40px; }
    .rp-lead { margin-top: 11px; font-size: 14px; line-height: 21px; }
    .rp-pipe-d { display: none; }
    .rp-pipe-m { display: block; left: 50%; translate: -50% 0; width: 390px; height: 520px; top: 304px; }
    .rp-tapes { top: 344px; grid-template-columns: 1fr; gap: 50px; }
    .rp-tape { height: 98px; padding: 18px 18px 0; background-image: linear-gradient(#21201E 0 6px, transparent 6px); }
    .rp-lab { font-size: 18px; line-height: 20px; gap: 14px; }
    .rp-q { margin-top: 9px; font-size: 13px; line-height: 18px; }
  }
  @media (max-width: 380px) { .rp-q { font-size: 12px; } }
</style>
<style is:global>
  /* The water only exists while motion runs (scrub.ts); static views show the pipe exactly as in the frame. */
  html:not(.motion) [data-scrub-fill], html:not(.motion) [data-scrub-path] { visibility: hidden; }
</style>
