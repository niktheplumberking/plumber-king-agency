---
// 9.3 Spotlight (Figma 670:11578 y 1822-2742 / 671:1096 y 1730-2494). Paper field; a ruled typewriter sheet, tilted 1.2 deg,
// with a red margin line, Stuart W.'s Yelp review typed out ("extremely conscientious" underlined in tan-deep) and Mike's
// hex badge stamped in red over the bottom-right corner. The quote is cut from REVIEWS (word for word), never retyped:
// the Figma shows the part from "Mike happened" to "any mess."; his full review is in the list below.
import { REVIEWS } from '../../data/reviews';
import { SITE } from '../../data/site';
import Eyebrow from '../kit-b4/Eyebrow.astro';
import Wave from '../kit-b4/Wave.astro';
import Stamp from '../kit-b4/Stamp.astro';
import { place, when } from './fmt';
const r = REVIEWS.find((x) => x.name === 'Stuart W.');
if (!r) throw new Error('RevSpotlight: Stuart W. is not in REVIEWS');
const a = r.text.indexOf('Mike happened'); const b = r.text.indexOf('any mess.') + 'any mess.'.length;
if (a < 0 || b < 9) throw new Error('RevSpotlight: excerpt not found in the review');
const ex = r.text.slice(a, b);
const hl = 'extremely conscientious';
const [pre, post] = ex.split(hl);
---
<section class="rs" aria-labelledby="rs-h" data-m-section>
  <Wave d={{ a: 16.5, L: 521 }} m={{ a: 10.3, L: 300.5 }} fill="#F3ECDD" above="#D2C5A6" />
  <div class="wrap rs-in">
    <h2 id="rs-h" class="sr-only">Spotlight review from {r.name}</h2>
    <Eyebrow text="Spotlight" tone="deep" class="rs-eb" />
    <figure class="rs-sheet" data-t="4">
      <p class="rs-meta" aria-hidden="true">Spotlight <span>·</span> Yelp<i class="rs-d"> review</i> <span>·</span> ★★★★★</p>
      <blockquote class="rs-q" cite={SITE.social.yelp}>
        <p>"{pre}<strong>{hl}</strong>{post}"</p>
      </blockquote>
      <figcaption class="rs-by"><b>{r.name.toUpperCase()}</b><span aria-hidden="true">·</span>{place(r.town)}<span aria-hidden="true">·</span>{when(r.date)}<span aria-hidden="true">·</span>leak on the water service line<span class="sr-only"> (5 stars on Yelp)</span></figcaption>
    </figure>
    <Stamp w={206} deg={17} class="rs-stamp" opacity={0.9} />
  </div>
</section>
<style>
  .rs { position: relative; height: 920px; background: var(--paper); overflow-x: clip; }
  .rs-in { position: relative; height: 100%; }
  .rs-in :global(.rs-eb) { position: absolute; left: 60px; top: 77px; }
  .rs-sheet { position: absolute; left: 53px; top: 159px; width: 1080px; height: 680px; margin: 0; padding: 50px 0 0 68px; rotate: 1.2deg;
    background-color: var(--bone);
    background-image: linear-gradient(90deg, transparent 39px, rgba(217, 65, 43, .38) 39px 41px, transparent 41px),
      repeating-linear-gradient(180deg, transparent 0 35px, #E9E4D9 35px 36px);
    background-size: 100% 100%, calc(100% - 120px) 540px; background-position: 0 0, 60px 113px; background-repeat: no-repeat;
    box-shadow: 0 30px 40px -18px rgba(14, 13, 11, .28), 0 2px 6px rgba(14, 13, 11, .08); }
  .rs-sheet { --tw: 'Courier New', 'Courier Prime', Courier, 'Liberation Mono', 'Nimbus Mono PS', monospace; font-family: var(--tw); color: var(--ink); }
  .rs-meta { font-weight: 700; font-size: 15px; line-height: 20px; letter-spacing: .05em; text-transform: uppercase; color: var(--tan-dark); }
  .rs-meta span { margin: 0 14px; } .rs-meta i { font-style: normal; }
  .rs-q { margin: 29px 0 0; width: 940px; }
  .rs-q p { font-size: 25px; line-height: 41px; letter-spacing: 0; }
  .rs-q strong { font-weight: 700; color: var(--tan-dark); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .rs-by { margin-top: 25px; font-weight: 700; font-size: 15px; line-height: 20px; }
  .rs-by span { margin: 0 14px; }
  .rs-in :global(.rs-stamp) { position: absolute; left: 952px; top: 655px; }
  @media (min-width: 768px) and (max-width: 1279px) {
    .rs { height: auto; padding: 150px 0 140px; }
    .rs-in :global(.rs-eb) { position: static; margin-left: 40px; }
    .rs-sheet { position: relative; left: auto; top: auto; width: auto; height: auto; margin: 40px 20px 0; padding: 50px 48px 120px 68px; }
    .rs-q { width: auto; } .rs-q p { font-size: clamp(18px, 2.2vw, 25px); line-height: 1.64; }
    .rs-in :global(.rs-stamp) { left: auto; right: 10px; top: auto; bottom: -40px; }
  }
  @media (max-width: 767px) {
    .rs { height: 764px; }
    .rs-in { width: 100%; }
    .rs-in :global(.rs-eb) { left: 20px; top: 71px; }
    .rs-sheet { left: 10.5px; top: 106px; width: 362px; height: 602px; padding: 23px 0 0 38px; rotate: 1.07deg;
      background-image: linear-gradient(90deg, transparent 21px, rgba(217, 65, 43, .38) 21px 23px, transparent 23px); background-size: 100% 100%; background-position: 0 0; }
    .rs-meta { font-size: 10px; line-height: 14px; } .rs-meta span { margin: 0 6px; } .rs-d { display: none; }
    .rs-q { margin-top: 19px; width: 302px; } .rs-q p { font-size: 15px; line-height: 23px; }
    .rs-q strong { text-decoration-thickness: 1.5px; text-underline-offset: 3px; }
    .rs-by { margin-top: 17px; width: 296px; font-size: 10.5px; line-height: 17px; } .rs-by span { margin: 0 5px; }
    .rs-in :global(.rs-stamp) { left: 225px; top: 596px; width: 118px; rotate: 17deg; }
  }
</style>
