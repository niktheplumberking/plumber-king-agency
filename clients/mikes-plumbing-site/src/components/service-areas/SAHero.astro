---
// 6.1 Hero (Figma 670:10564 y 180-900 / 670:12818 y 164-964): copy left, the OSM map in a hex window with the Riverside
// hex pin and the town dots. Scroll moment: the routes run out from Riverside to each town as the hero scrolls away.
import Img from '../ui/Img.astro';
import Eyebrow from '../b3kit/Eyebrow.astro';
import CallBtn from '../b3kit/CallBtn.astro';
import GhostBtn from '../b3kit/GhostBtn.astro';
import { MAP_PTS } from '../../data/town-pages';
const W = 700, H = 500, S = 0.73, OX = -44, OY = -28;
const at = (k: string) => [MAP_PTS[k][0] * S + OX, MAP_PTS[k][1] * S + OY];
const [rx, ry] = at('riverside');
const DOTS = ['los-angeles', 'buena-park', 'corona', 'moreno-valley'].map((k) => ({ k, p: at(k) }));
const pc = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
---
<section class="sh" aria-labelledby="sh-h1" data-m-section data-m-hero>
  <div class="wrap sh-grid">
    <div class="sh-copy">
      <Eyebrow>Service areas · Based in Riverside<span class="sh-ca">, CA</span></Eyebrow>
      <h1 id="sh-h1" class="sh-h1" data-t="2">Plumber Serving the <span class="tone">Inland Empire, OC &amp; LA</span></h1>
      <p class="sh-sub" data-t="3" aria-label="IE, OC, LA">
        <span>IE</span><svg viewBox="0 0 46 20" aria-hidden="true"><rect x="0" y="7" width="46" height="6" rx="2" fill="#6B5C3E" /><path d="M14 1h18l6 9-6 9H14l-6-9z" fill="#D2C5A6" stroke="#0E0D0B" stroke-width="1.5" /></svg>
        <span>OC</span><svg viewBox="0 0 46 20" aria-hidden="true"><rect x="0" y="7" width="46" height="6" rx="2" fill="#6B5C3E" /><path d="M14 1h18l6 9-6 9H14l-6-9z" fill="#D2C5A6" stroke="#0E0D0B" stroke-width="1.5" /></svg>
        <span>LA</span>
      </p>
      <p class="sh-body" data-t="3" data-fx="nudge">We're based in Riverside and come to you. Residential and commercial.</p>
      <div class="sh-btns">
        <CallBtn v="ink" />
        <GhostBtn href="/contact" w={210} />
      </div>
    </div>
    <figure class="sh-mapwrap" data-t="4" data-fx="nudge">
      <div class="sh-plate" aria-hidden="true"></div>
      <div class="sh-hex" data-b3-scrub data-b3-start="top 60%" data-b3-end="bottom 30%"><div class="sh-in">
        <div class="sh-tiles" style={`left:${pc(OX, W)};top:${pc(OY, H)};width:${pc(1129 * S, W)};height:${pc(701 * S, H)}`}><Img name="map-inland-empire-orange-county-los-angeles" alt="Map of the Inland Empire, Orange County and Los Angeles with Mike's base in Riverside and the towns he serves" sizes="(min-width: 768px) 830px, 420px" widths={[420, 830, 1129]} priority /></div>
        <svg class="sh-routes" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
          {DOTS.map(({ p }) => <path d={`M${rx.toFixed(1)} ${ry.toFixed(1)} L${p[0].toFixed(1)} ${p[1].toFixed(1)}`} pathLength="1" data-b3-path />)}
        </svg>
        {DOTS.map(({ p }, i) => <span class="sh-dot" style={`left:${pc(p[0], W)};top:${pc(p[1], H)}`} data-b3-stop={(0.25 + i * 0.2).toFixed(2)} aria-hidden="true"></span>)}
        <span class="sh-pin" style={`left:${pc(rx, W)};top:${pc(ry, H)}`} aria-hidden="true"></span>
        <span class="sh-tag" style={`left:${pc(rx - 69, W)};top:${pc(ry - 61, H)}`}>Riverside · Base</span>
      </div></div>
      <figcaption class="sh-cap">Map © OpenStreetMap contributors</figcaption>
    </figure>
  </div>
</section>
<style>
  .sh { position: relative; height: 720px; background: var(--paper); overflow-x: clip; }
  .sh-grid { position: relative; height: 100%; }
  .sh-copy { position: absolute; left: 0; top: 98px; width: 560px; }
  .sh-h1 { margin-top: 12px; font-family: var(--f-display); font-weight: 400; font-size: 62px; line-height: 63.5px; color: var(--ink); }
  .tone { color: var(--tan-dark); }
  .sh-sub { display: flex; align-items: center; gap: 18px; margin-top: 30px; font-family: var(--f-label); font-weight: 600; font-size: 48px; line-height: 50px; color: var(--ink); }
  .sh-sub svg { width: 46px; height: 20px; }
  .sh-body { margin-top: 30px; width: 460px; font-size: 16px; line-height: 28px; color: var(--ink-2); }
  .sh-btns { display: flex; gap: 16px; margin-top: 23px; }

  .sh-mapwrap { --hex: polygon(12.857% 0, 87.143% 0, 100% 50%, 87.143% 100%, 12.857% 100%, 0 50%); position: absolute; left: 580px; top: 80px; width: 700px; height: 500px; margin: 0; }
  .sh-plate { position: absolute; inset: 0; transform: translate(22px, 24px); background: var(--tan-dark); clip-path: var(--hex); }
  .sh-hex { position: absolute; inset: 0; clip-path: var(--hex); background: var(--ink); }
  .sh-in { position: absolute; inset: 3px 4px; clip-path: var(--hex); overflow: hidden; background: #E3DAC6; }
  .sh-tiles { position: absolute; }
  .sh-tiles :global(img) { width: 100%; height: 100%; }
  .sh-routes { position: absolute; inset: 0; width: 100%; height: 100%; }
  .sh-routes path { fill: none; stroke: var(--ink); stroke-width: 2; stroke-dasharray: 1; stroke-dashoffset: 0; opacity: .55; }
  .sh-dot { position: absolute; width: 13px; height: 13px; margin: -6.5px 0 0 -6.5px; border-radius: 50%; background: var(--ink); border: 1.5px solid var(--paper); transition: transform .45s var(--ease-back); }
  .sh-dot.is-on { transform: scale(1.3); }
  .sh-pin { position: absolute; width: 40px; height: 32px; margin: -16px 0 0 -20px; background: var(--red); clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%); box-shadow: 0 0 0 9px rgba(217, 65, 43, .25); }
  .sh-pin::before { content: ''; position: absolute; left: -12px; top: -14px; width: 64px; height: 60px; }
  .sh-tag { position: absolute; padding: 0 12px; height: 29px; display: flex; align-items: center; white-space: nowrap; background: var(--ink); color: var(--paper); font-family: var(--f-label); font-weight: 600; font-size: 12px; letter-spacing: .12em; text-transform: uppercase; border-radius: 2px; }
  .sh-cap { position: absolute; right: 22px; bottom: -26px; font-size: 10px; color: var(--ink-2); }

  @media (min-width: 768px) and (max-width: 1279px) {
    .sh { height: auto; padding: 72px 0 110px; }
    .sh-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; height: auto; align-items: center; }
    .sh-copy { position: static; width: auto; }
    .sh-h1 { font-size: clamp(44px, 5vw, 62px); line-height: 1.03; }
    .sh-sub { font-size: 38px; } .sh-body { width: auto; }
    .sh-btns { flex-wrap: wrap; }
    .sh-mapwrap { position: relative; left: auto; top: auto; width: 100%; height: auto; aspect-ratio: 7 / 5; }
    .sh-cap { right: 0; bottom: -46px; }
  }
  @media (max-width: 767px) {
    .sh { height: auto; padding: 42px 0 22px; }
    .sh-grid { height: auto; }
    .sh-copy { position: static; width: auto; }
    .sh-h1 { margin-top: 14px; max-width: 330px; font-size: 38px; line-height: 40px; }
    .sh-copy :global(.sh-ca) { display: none; }
    .sh-sub { gap: 10px; margin-top: 22px; font-size: 34px; line-height: 40px; }
    .sh-sub svg { width: 38px; height: 17px; }
    .sh-body { width: auto; margin-top: 22px; font-size: 15px; line-height: 23px; }
    .sh-btns { flex-direction: column; gap: 14px; margin-top: 22px; }
    .sh-btns :global(.gb) { width: 100%; height: 56px; }
    .sh-mapwrap { position: relative; left: auto; top: auto; width: calc(100% - 12px); height: auto; aspect-ratio: 7 / 5; margin-top: 28px; }
    .sh-plate { transform: translate(12px, 12px); }
    .sh-pin { width: 28px; height: 22px; margin: -11px 0 0 -14px; box-shadow: 0 0 0 6px rgba(217, 65, 43, .25); }
    .sh-dot { width: 8px; height: 8px; margin: -4px 0 0 -4px; border-width: 1px; }
    .sh-tag { height: 22px; font-size: 10px; padding: 0 8px; }
    .sh-cap { left: 0; right: auto; bottom: -30px; }
    .sh-mapwrap { margin-bottom: 30px; }
  }
</style>
