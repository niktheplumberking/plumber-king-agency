---
// 1.7 Commercial strip (Figma 669:539 y 4880 h 700, photo + ink fade; mobile y 6232 h 671). Van-at-a-job photo behind an ink fade,
// eyebrow, H2, body (his IG jobs), tan call button, ADU rough-in polaroid.
import Wave from '../kit/Wave.astro';
import Eyebrow from '../kit/Eyebrow.astro';
import Btn from '../kit/Btn.astro';
import Img from '../ui/Img.astro';
import { ab } from './shared/ab';
import { SITE } from '../../data/site';
---
<section id="commercial" class="cm sv-sec sv-ink sv-abs" style="--sh:700px" aria-labelledby="cm-h" data-m-section>
  <div class="cm-bg" aria-hidden="true"><Img name="commercial-plumbing-job-vans" alt="" sizes="100vw" /></div>
  <i class="cm-fade" aria-hidden="true"></i>
  {/* B7: the photo meets the wave. The seam is the tan of the section above, drawn as the inverse wave over the top of the
     photo (it fills ABOVE the curve), so below the curve you see the photo itself, with a short ink gradient at its top
     edge. Same curve as the standard seam; the boundary sits 24 px lower than before so the phone above clears it. */}
  <Wave d={{ path: 'M0 16C93.33 37.333 186.67 37.333 280 16C373.33 -5.333 466.67 -5.333 560 16C653.33 37.333 746.67 37.333 840 16C933.33 -5.333 1026.67 -5.333 1120 16C1213.33 37.333 1306.67 37.333 1400 16C1493.33 -5.333 1586.67 -5.333 1680 16V0H0Z', h: 38, w: 1440 }} m={{ path: 'M0 11C50.0 25.667 100.0 25.667 150 11C200.0 -3.667 250.0 -3.667 300 11C350.0 25.667 400.0 25.667 450 11V0H0Z', h: 26, w: 390 }} fill="var(--tan)" top={-10} topM={-24} />
  <div class="cm-in">
    <figure class="cm-pol sv-polaroid" data-t="3" data-ab style={ab(1000, 90, 300, 360, 4)}>
      <div class="cm-ph sv-photo"><Img name="bathroom-plumbing-rough-in" alt="ADU bathroom plumbing rough-in by Mike's Plumbing" sizes="(min-width: 768px) 280px, 156px" box={280 / 300} boxM={156 / 160} /></div>
      <figcaption>ADU rough-in</figcaption>
    </figure>
    <Eyebrow look="figma" tone="tan" class="cm-eb" data-ab style={ab(119.5, 149)}>Residential &amp; commercial</Eyebrow>
    <h2 id="cm-h" class="sv-h cm-h" data-t="2" data-ab style={ab(120, 182, 640)}>Homes, ADUs and <em>commercial kitchens.</em></h2>
    <p class="cm-body" data-t="3" data-ab style={ab(120, 328, 520)}>Jobs on his Instagram include a 100-gallon heater for a restaurant, a grease interceptor baffle tee, a 4-inch gas line rework and an ADU rough-in.</p>
    <div class="cm-btn" data-ab style={ab(120, 443, 330, 64)}>
      <Btn look="figma" v="tan" title={SITE.phone} sub="Call about a commercial job" w={330} />
    </div>
  </div>
</section>

<style>
  .cm-bg { position: absolute; inset: -10px 0 0; } /* B7: runs up behind the wave */
  .cm-bg :global(picture), .cm-bg :global(img) { width: 100%; height: 100%; }
  .cm-bg::after { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 140px; background: linear-gradient(#0E0D0B, rgba(14, 13, 11, 0)); pointer-events: none; }
  @media (max-width: 767px) { .cm-bg { top: -24px; } .cm-bg::after { height: 90px; } }
  .cm-fade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(14, 13, 11, .9) 0%, rgba(14, 13, 11, .8) 60%, rgba(14, 13, 11, .2) 100%); }
  .cm-in { position: relative; }
  .cm-h { margin: 0; font-size: 60px; line-height: 1.04; color: var(--paper); }
  .cm-body { margin: 0; font-size: 17px; line-height: 1.6; color: var(--tan); }
  .cm-btn :global(.sv-btn) { width: 100%; }
  .cm-pol { margin: 0; box-shadow: 0 20px 40px -10px rgba(0, 0, 0, .6); }
  .cm-ph { position: absolute; left: 10px; top: 10px; width: 280px; height: 300px; }
  .cm-pol figcaption { position: absolute; left: 12px; top: 322px; font-family: var(--f-label); font-weight: 500; font-size: 12px; line-height: 18px; letter-spacing: .12em; text-transform: uppercase; color: #4a443a; }

  @media (max-width: 1279px) {
    .cm-in { width: calc(100% - 2 * var(--gutter)); margin-inline: auto; display: flex; flex-direction: column; align-items: flex-start; }
    .cm-pol { position: relative; align-self: flex-end; rotate: -4deg; transform-origin: 0 0; }
  }
  @media (min-width: 768px) and (max-width: 1279px) {
    .cm { padding: 90px 0 120px; }
    .cm-pol { width: 300px; height: 360px; margin-bottom: -200px; }
    .cm-h { margin-top: 12px; max-width: 560px; font-size: clamp(42px, 5vw, 60px); }
    .cm-body { margin-top: 20px; max-width: 520px; }
    .cm-btn { margin-top: 32px; width: 330px; }
    .cm-fade { background: linear-gradient(90deg, rgba(14, 13, 11, .9) 0%, rgba(14, 13, 11, .8) 70%, rgba(14, 13, 11, .45) 100%); }
  }
  @media (max-width: 767px) {
    .cm { padding: 56px 0 65px; }
    .cm-bg { inset: 0 auto auto -200px; width: 790px; height: 820px; }
    .cm-fade { background: rgba(14, 13, 11, .8); }
    .cm-pol { width: 170px; height: 200px; margin-right: 0; box-shadow: 0 14px 28px -8px rgba(0, 0, 0, .6); }
    .cm-ph { left: 7px; top: 7px; width: 156px; height: 160px; }
    .cm-pol figcaption { left: 9px; top: 176px; font-size: 10px; line-height: 15px; letter-spacing: .1em; }
    .cm :global(.cm-eb) { margin-top: 33px; }
    .cm-h { margin-top: 10px; font-size: 36px; line-height: 1.06; }
    .cm-body { margin-top: 16px; font-size: 15px; line-height: 1.55; }
    .cm-btn { margin-top: 24px; width: 100%; }
  }
</style>
