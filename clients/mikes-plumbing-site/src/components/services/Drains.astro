---
// 1.3 Drains & sewer (Figma 669:539 y 1680 h 800, ink; mobile y 2082 h 1008). Eyebrow 01, two-tone H2, body, the hung drain
// pipe with four pipe markers (desktop: horizontal on rods and clevis straps, flange + drips at the end; mobile: a vertical
// stack), clipped roots photo + stamp + caption, link to /drain-cleaning.
// Scroll moment: water runs along the pipe (a shade drains off it, left to right / top to bottom) and each marker lights up,
// pops to 1.08 and turns a little as the water reaches it (kit/scrub.ts). Static final state = the Figma frame.
import { Image } from 'astro:assets';
import logoCream from '../../assets/brand/logo-cream.png';
import Wave from './kit/Wave.astro';
import Eyebrow from './kit/Eyebrow.astro';
import TLink from './kit/TLink.astro';
import Img from '../ui/Img.astro';
import { ab } from './kit/ab';
const markers = [
  { d: ['Drain cleaning, repair', '& new installation'], m: ['Drain cleaning, repair', '& new installation'], tone: 'tan' },
  { d: ['Hydro', 'jetting'], m: ['Hydro jetting'], tone: 'bone' },
  { d: ['Sewer lines · root', 'extraction'], m: ['Sewer lines', 'root extraction'], tone: 'tan' },
  { d: ['Grease interceptors', 'commercial kitchens'], m: ['Grease interceptors', 'commercial kitchens'], tone: 'bone' },
];
const drip = 'M7 0C7 0 14 9 14 13C14 17.4 10.9 20 7 20C3.1 20 0 17.4 0 13C0 9 7 0 7 0Z';
---
<section id="drains" class="dr sv-sec sv-ink sv-abs" style="--sh:800px" aria-labelledby="dr-h" data-m-section>
  <Wave fill="var(--ink)" up top={-34} topM={-24} />
  <div class="dr-in">
    <Eyebrow tone="tan" class="dr-eb" data-ab style={ab(119.5, 109)}>01 · Drains &amp; sewer</Eyebrow>
    <h2 id="dr-h" class="sv-h dr-h" data-t="2" data-ab style={ab(120, 142, 700, 118)}>Slow drain? Backed-up line? <em>Let's clear it.</em></h2>
    <p class="dr-body" data-t="3" data-ab style={ab(880, 150, 440)}>From a kitchen sink that won't drain to a main sewer line full of roots, we clean it, repair it, or put in new. When a line keeps clogging, hydro jetting scours it clean instead of just poking a hole through.</p>

    <div class="dr-run" data-sv-scrub data-start="top 80%" data-end="bottom 55%" data-start-m="top 85%" data-end-m="bottom 60%" data-t="4" data-ab style={ab(-20, 330, 892, 206)}>
      {[160, 420, 680].map((x) => (<><i class="dr-rod" style={`left:${x + 20}px`} aria-hidden="true"></i><i class="dr-strap" style={`left:${x + 6}px`} aria-hidden="true"></i></>))}
      <div class="dr-pipe" aria-hidden="true"><i class="dr-hi"></i><i class="dr-lo"></i><i class="dr-shade" data-sv-fill data-rev data-axis-m="y"></i></div>
      <span class="dr-flange" aria-hidden="true"><i></i><i></i></span>
      <ul class="dr-marks" role="list">
        {markers.map((mk, i) => (
          <li class:list={['dr-mk', `dr-mk--${mk.tone}`]} data-sv-stop data-at={[0.16, 0.4, 0.64, 0.88][i]} style={`--i:${i}`}>
            <i class="dr-mk-bg" aria-hidden="true"></i>
            <span class="dr-mk-t dr-d"><b>{mk.d[0]}</b><span>{mk.d[1]}</span></span>
            <span class="dr-mk-t dr-m"><b>{mk.m[0]}</b>{mk.m[1] && <span>{mk.m[1]}</span>}</span>
          </li>
        ))}
      </ul>
      {[[878, 186, 1], [882, 280, 0.8], [875, 370, 0.6]].map(([x, y, o]) => (
        <svg class="dr-drip" style={`left:${x}px;top:${y}px;opacity:${o}`} viewBox="0 0 14 20" width="14" height="20" aria-hidden="true"><path d={drip} fill="#6B5C3E" /></svg>
      ))}
    </div>

    <TLink href="/drain-cleaning" tone="tan" class="dr-link" data-ab style={ab(120, 580)}>Drain cleaning &amp; hydro jetting</TLink>

    <figure class="dr-fig" data-t="3" data-ab style={ab(900, 300, 420)}>
      <div class="dr-shadow"><div class="dr-photo sv-photo">
        <Img name="tree-roots-in-sewer-line" alt="Tree roots Mike pulled out of a sewer line" sizes="(min-width: 768px) 420px, 350px" box={420 / 380} boxM={350 / 260} />
      </div></div>
      <Image src={logoCream} alt="" width={300} class="dr-stamp" aria-hidden="true" />
      <figcaption class="dr-cap f-osw">Roots pulled from a sewer line · Mike's <span class="dr-d">Instagram</span><span class="dr-m">IG</span></figcaption>
    </figure>
  </div>
</section>

<style>
  .dr-in { position: relative; }
  .dr-h { margin: 0; font-size: 56px; line-height: 1.06; color: var(--paper); }
  .dr-body { margin: 0; font-size: 17px; line-height: 1.6; color: var(--mute); }
  .dr-m, .dr-mk-t.dr-m { display: none; }

  /* the hung pipe (box origin = Figma -20, 330) */
  .dr-run { position: relative; }
  .dr-rod { position: absolute; top: 0; width: 4px; height: 100px; background: #4a443a; }
  .dr-strap { position: absolute; top: 90px; width: 32px; height: 110px; box-sizing: border-box; border: 3px solid #4a443a; border-radius: 14px; }
  .dr-pipe { position: absolute; left: 0; top: 100px; width: 880px; height: 90px; background: #6b5c3e; overflow: hidden; }
  .dr-hi { position: absolute; left: 0; top: 12px; width: 100%; height: 6px; background: rgba(255, 255, 255, .2); }
  .dr-lo { position: absolute; left: 0; top: 76px; width: 100%; height: 8px; background: rgba(14, 13, 11, .3); }
  .dr-shade { position: absolute; inset: 0; background: rgba(14, 13, 11, .55); transform-origin: 100% 50%; }
  .dr-flange { position: absolute; left: 866px; top: 84px; width: 26px; height: 122px; border-radius: 3px; background: var(--tan); }
  .dr-flange i { position: absolute; left: 9px; width: 8px; height: 8px; border-radius: 50%; background: var(--ink); }
  .dr-flange i:first-child { top: 10px; } .dr-flange i:last-child { top: 108px; }
  .dr-drip { position: absolute; }
  .dr-marks { margin: 0; padding: 0; list-style: none; }
  .dr-mk { position: absolute; top: 108px; left: calc(60px + var(--i) * 200px); width: 186px; height: 74px; color: var(--ink); transform-origin: 30% 50%; }
  .dr-mk:nth-child(even) { --pop-r: 2deg; }
  .dr-mk-bg { position: absolute; inset: 0; --tip: 26px; clip-path: polygon(0 0, calc(100% - var(--tip)) 0, 100% 50%, calc(100% - var(--tip)) 100%, 0 100%); }
  .dr-mk--tan .dr-mk-bg { background: var(--tan); } .dr-mk--bone .dr-mk-bg { background: var(--bone); }
  .dr-mk-t { position: absolute; left: 14px; top: 14px; display: flex; flex-direction: column; gap: 3px; font-family: var(--f-label); font-size: 13px; line-height: 19px; letter-spacing: .06em; text-transform: uppercase; white-space: nowrap; }
  .dr-mk-t b { font-weight: 600; }
  .dr-mk-t span { font-weight: 500; opacity: .8; }

  .dr-shadow { filter: drop-shadow(0 20px 20px rgba(0, 0, 0, .45)); }
  .dr-photo { height: 380px; clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px); }
  .dr-fig { margin: 0; }
  .dr-stamp { position: absolute; left: 250px; top: 260px; width: 150px; height: 92px; object-fit: contain; rotate: -12deg; transform-origin: 0 0; opacity: .9; }
  .dr-cap { margin-top: 14px; font-weight: 500; font-size: 11px; line-height: 16px; letter-spacing: .1em; text-transform: uppercase; color: var(--mute); }

  @media (max-width: 1279px) {
    .dr-in { width: calc(100% - 2 * var(--gutter)); margin-inline: auto; display: flex; flex-direction: column; }
  }
  @media (min-width: 768px) and (max-width: 1279px) {
    .dr { padding: 109px 0 120px; }
    .dr-h { margin-top: 12px; max-width: 760px; font-size: clamp(40px, 4.6vw, 56px); }
    .dr-body { margin-top: 20px; max-width: 640px; }
    .dr-run { margin: 48px 0 0 calc(-1 * var(--gutter)); height: 206px; width: calc(100% + var(--gutter)); overflow: hidden; }
    .dr-run .dr-pipe { width: calc(100% - 26px); }
    .dr-run .dr-flange { left: auto; right: 0; }
    .dr-run .dr-drip { display: none; }
    .dr-run .dr-mk { left: calc(var(--gutter) + var(--i) * min(200px, (100% - var(--gutter) - 40px) / 4)); width: min(186px, (100% - var(--gutter) - 40px) / 4 - 10px); }
    .dr-run .dr-rod, .dr-run .dr-strap { display: none; }
    .dr :global(.dr-link) { order: 9; margin-top: 32px; }
    .dr-fig { margin-top: 48px; max-width: 520px; position: relative; }
  }
  @media (max-width: 767px) {
    .dr { padding: 69px 0 59px; }
    .dr :global(.dr-eb) { margin-left: -1px; }
    .dr-h { margin-top: 10px; font-size: 34px; line-height: 1.06; }
    .dr-body { margin-top: 16px; font-size: 15px; line-height: 1.55; }
    .dr-d { display: none !important; } .dr-mk-t.dr-m { display: flex; }
    .dr-cap .dr-m { display: inline; }
    .dr-run { height: 308px; margin-top: 20px; }
    .dr-rod, .dr-strap, .dr-flange, .dr-drip { display: none; }
    .dr-pipe { left: 4px; top: 0; width: 52px; height: 308px; }
    .dr-hi { left: 8px; top: 0; width: 5px; height: 100%; }
    .dr-lo { display: none; }
    .dr-shade { transform-origin: 50% 100%; }
    .dr-mk { left: -4px; top: calc(10px + var(--i) * 72px); width: 260px; height: 52px; transform-origin: 20% 50%; }
    .dr-mk-bg { --tip: 24px; }
    .dr-mk-t { left: 76px; top: 0; bottom: 0; justify-content: center; gap: 1px; }
    .dr-mk-t span { font-size: 12px; line-height: 18px; }
    .dr-fig { order: 5; margin-top: 14px; position: relative; }
    .dr-photo { height: 260px; clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px); }
    .dr-shadow { filter: none; }
    .dr-stamp { left: 220px; top: 176px; width: 110px; height: 68px; opacity: 1; }
    .dr-cap { margin-top: 12px; font-size: 10.5px; }
    .dr :global(.dr-link) { order: 6; margin-top: 20px; font-size: 15px; }
  }
</style>
