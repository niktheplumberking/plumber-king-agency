---
// 1.6 Around the house (Figma 669:539 y 4120 h 760, tan; mobile y 5150 h 1082). His faucet post in a tilted phone frame, eyebrow
// 04, H2, his caption line as a quote, and the receipt list (zigzag bottom, dotted leaders, red ticks).
// Scroll moment: the receipt "prints" its lines in order (each tick lights and pops as the scroll reaches it).
// B17 (fix round 1): a big play button on the phone. The repo has NO clip file (only a still from his post) and we never
// rip video from Instagram, so CLIP below decides what the button does, in this order:
//   CLIP.file  his own clip (public/ path): plays natively inside the phone; on end, or a click while it plays, it replays.
//   CLIP.post  the post's permalink (instagram.com/p/... or /reel/...): the official embed loads inside the phone on the
//              first click (nothing from Instagram loads before it).
//   neither    (today) a labelled "Watch on Instagram ↗" pill opens his Instagram in a new tab (review 8: no bare
//              play triangle that leaves the site). Both are on README "Mike to confirm".
const CLIP = { file: '', poster: '', post: '' };
const embed = CLIP.post ? CLIP.post.replace(/\/?(\?.*)?$/, '') + '/embed' : '';
import Wave from '../kit/Wave.astro';
import Eyebrow from '../kit/Eyebrow.astro';
import Img from '../ui/Img.astro';
import { ab } from './shared/ab';
import { SITE } from '../../data/site';
const items = ['Toilets, sinks & faucets', 'Garbage disposal', 'Water filtration', 'Shower valves', 'Pressure washing'];
// zigzag bottom: teeth `t` wide and `d` deep under a body `h` tall (desktop 560 x 316 + 10, mobile 350 x 282 + 9)
const zig = (w: number, h: number, t: number, d: number) => {
  const p = [`0 0`, `${w}px 0`, `${w}px ${h}px`];
  for (let x = w, up = false; x > 0; ) { x -= t / 2; up = !up; p.push(`${Math.max(0, +x.toFixed(2))}px ${up ? h + d : h}px`); }
  return `polygon(${p.join(', ')})`;
};
---
<section id="around-the-house" class="ho sv-sec sv-tan sv-abs" style={`--sh:760px;--zd:${zig(560, 316, 20, 10)};--zm:${zig(350, 282, 17.5, 9)}`} aria-labelledby="ho-h" data-m-section>
  <Wave fill="var(--tan)" top={-34} topM={-24} />
  <div class="ho-in">
    <figure class="ho-phone-w" data-t="3">
      <div class="ho-phone" data-ab style={ab(170, 90, 300, 600, -4)}>
        <div class="ho-scr sv-photo"><Img name="new-kitchen-faucet-install" alt="Mike's Instagram post of a new faucet install, with his caption" sizes="(min-width: 768px) 276px, 202px" box={276 / 576} boxM={202 / 422} /></div>
        <div class="ho-player" data-ho-player data-file={CLIP.file || undefined} data-poster={CLIP.poster || undefined} data-embed={embed || undefined} aria-live="polite"></div>
        {CLIP.file || embed
          ? <button type="button" class="ho-play" data-ho-play aria-label="Play Mike's faucet clip"><svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg></button>
          : <a class="ho-play ho-play--ig" href={SITE.social.instagram} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg><span>Watch on Instagram <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></span></a>}
        <i class="ho-notch" aria-hidden="true"></i>
      </div>
      <figcaption class="ho-cap" data-ab style={ab(190, 712)}>His post, his caption</figcaption>
    </figure>
    <Eyebrow look="figma" tone="deep" class="ho-eb" data-ab style={ab(639.5, 109)}>04 · Around the house</Eyebrow>
    <h2 id="ho-h" class="sv-h ho-h" data-t="2" data-ab style={ab(640, 142, 720)}>The everyday fixes. <em>Done properly.</em></h2>
    <p class="ho-q" data-t="3" data-ab style={ab(640, 270, 560)}>“We can't fix your love life, but we CAN fix that leaky faucet.”</p>
    <div class="ho-rc-w" data-t="4" data-ab style={ab(640, 333, 560, 326, -1.5)}>
      <div class="ho-rc" data-scrub data-start="top 80%" data-end="bottom 70%">
        <p class="ho-rc-h">Mike's Plumbing Services</p>
        <p class="ho-rc-s"><span class="ho-d">Everyday fixes · </span>No prices, just the work</p>
        <ul class="ho-rc-l" role="list">
          {items.map((s, i) => (
            <li data-stop data-dim data-at={(0.12 + i * 0.19).toFixed(2)}><span>{s}</span><i aria-hidden="true"></i>
              <svg viewBox="0 0 16 16" width="15" height="16" aria-hidden="true"><path d="M2 9.2l4 4.6L14.4 1.6" fill="none" stroke="#D9412B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg></li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .ho-in { position: relative; }
  .ho-phone-w { margin: 0; }
  .ho-phone { border-radius: 44px; background: var(--ink); box-shadow: 0 30px 50px -12px rgba(0, 0, 0, .5); }
  .ho-scr { position: absolute; inset: 12px; border-radius: 34px; }
  /* B17 play button: a big tan disc centred on the screen, ring pulse on hover; the player covers the screen once started */
  .ho-play { position: absolute; z-index: 2; left: 50%; top: 50%; display: grid; place-items: center; width: 88px; height: 88px; margin: -44px 0 0 -44px;
    border: 0; border-radius: 50%; background: var(--tan); color: var(--ink); cursor: pointer; box-shadow: 0 0 0 8px rgba(14, 13, 11, .28), 0 14px 26px -8px rgba(0, 0, 0, .55);
    transition: scale .4s cubic-bezier(.45, 0, .55, 1), box-shadow .4s cubic-bezier(.45, 0, .55, 1), opacity .4s cubic-bezier(.45, 0, .55, 1); }
  .ho-play svg { margin-left: 4px; }
  /* round 2 (review 8): until Mike sends the clip or the post link, the button says where it goes */
  .ho-play--ig { display: flex; align-items: center; gap: 10px; width: max-content; height: 56px; margin: 0; left: 50%; top: auto; bottom: 64px; translate: -50% 0; padding: 0 22px 0 16px; border-radius: 28px;
    font-family: var(--f-sans); font-weight: 700; font-size: 15px; white-space: nowrap; text-decoration: none; }
  .ho-play--ig svg { flex: none; width: 22px; height: 22px; margin: 0; }
  @media (hover: hover) and (pointer: fine) { .ho-play--ig:hover { scale: 1; translate: -50% -4px; } }
  .ho-play:focus-visible { outline: 3px solid var(--ink); outline-offset: 6px; }
  @media (hover: hover) and (pointer: fine) { .ho-play:hover { scale: 1.08; box-shadow: 0 0 0 14px rgba(14, 13, 11, .2), 0 18px 30px -8px rgba(0, 0, 0, .55); } }
  .ho-player { position: absolute; inset: 12px; z-index: 1; border-radius: 34px; overflow: hidden; background: var(--ink); display: none; }
  .ho-player.is-on { display: block; }
  .ho-player :global(video), .ho-player :global(iframe) { display: block; width: 100%; height: 100%; border: 0; object-fit: cover; background: var(--ink); }
  .ho-phone.is-playing .ho-play { opacity: 0; scale: .8; }
  .ho-phone.is-playing .ho-play:focus-visible, .ho-phone.is-ended .ho-play { opacity: 1; scale: 1; }
  .ho-phone.is-embed .ho-play { display: none; }
  .ho-notch { position: absolute; left: 110px; top: 22px; width: 80px; height: 22px; border-radius: 11px; background: var(--ink); }
  .ho-cap { font-family: var(--f-label); font-weight: 500; font-size: 11px; line-height: 16px; letter-spacing: .12em; text-transform: uppercase; color: var(--tan-dark); }
  .ho-h { margin: 0; font-size: 52px; line-height: 1.06; }
  .ho-q { margin: 0; font-family: var(--f-sans); font-style: italic; font-size: 20px; line-height: 1.45; color: var(--ink); }
  .ho-rc-w { filter: drop-shadow(0 14px 13px rgba(0, 0, 0, .25)); }
  .ho-rc { position: relative; box-sizing: border-box; height: 100%; padding: 22px 28px 0; background: var(--bone); clip-path: var(--zd); }
  .ho-rc-h, .ho-rc-s { margin: 0; text-align: center; font-family: var(--f-label); text-transform: uppercase; }
  .ho-rc-h { font-weight: 600; font-size: 15px; line-height: 22px; letter-spacing: .14em; color: var(--ink); }
  .ho-rc-s { margin-top: 2px; font-weight: 400; font-size: 11px; line-height: 16px; letter-spacing: .14em; color: #4a443a; }
  .ho-rc-l { margin: 20px 0 0; padding: 6px 0 0; list-style: none; border-top: 1px dashed rgba(14, 13, 11, .35); display: flex; flex-direction: column; gap: 23px; }
  .ho-rc-l li { display: flex; align-items: flex-end; gap: 10px; transform-origin: 90% 50%; font-family: var(--f-sans); font-weight: 600; font-size: 16px; line-height: 17px; color: var(--ink); }
  .ho-rc-l li:nth-child(odd) { --pop-r: 1.5deg; }
  .ho-rc-l i { flex: 1; margin-bottom: 3px; border-bottom: 1.5px dotted rgba(74, 68, 58, .45); }
  .ho-rc-l svg { flex: none; margin-left: 6px; }
  .ho-m { display: none; }

  @media (max-width: 1279px) {
    .ho-in { width: calc(100% - 2 * var(--gutter)); margin-inline: auto; display: flex; flex-direction: column; }
    .ho-phone-w { position: relative; }
    .ho-phone { position: absolute; }
  }
  @media (min-width: 768px) and (max-width: 1279px) {
    .ho { padding: 90px 0 120px; }
    .ho-phone-w { height: 660px; }
    .ho-phone { left: 40px; top: 0; width: 300px; height: 600px; rotate: 4deg; transform-origin: 0 0; }
    .ho-cap { position: absolute; left: 30px; top: 630px; }
    .ho :global(.ho-eb) { margin-top: 30px; }
    .ho-h { margin-top: 12px; font-size: clamp(40px, 4.6vw, 52px); }
    .ho-q { margin-top: 18px; }
    .ho-rc-w { margin-top: 32px; width: 100%; max-width: 560px; height: 326px; rotate: 1.5deg; }
  }
  @media (max-width: 767px) {
    .ho { padding: 60px 0 61px; }
    .ho-phone-w { height: 450px; }
    .ho-phone { left: 58px; top: 0; width: 220px; height: 440px; rotate: 4deg; transform-origin: 0 0; border-radius: 34px; box-shadow: 0 20px 36px -8px rgba(0, 0, 0, .5); }
    .ho-scr, .ho-player { inset: 9px; border-radius: 26px; }
    .ho-play { width: 68px; height: 68px; margin: -34px 0 0 -34px; } .ho-play svg { width: 24px; height: 24px; }
    .ho-play--ig { width: max-content; height: 44px; margin: 0; bottom: 44px; gap: 6px; padding: 0 12px 0 10px; font-size: 12px; } .ho-play--ig svg { width: 16px; height: 16px; }
    .ho-notch { left: 80px; top: 16px; width: 60px; height: 16px; border-radius: 8px; }
    .ho-cap { display: none; }
    .ho :global(.ho-eb) { margin-top: 29px; }
    .ho-h { margin-top: 10px; font-size: 34px; }
    .ho-q { margin-top: 14px; font-size: 17px; }
    .ho-d { display: none; }
    .ho-rc-w { margin-top: 26px; height: 292px; filter: drop-shadow(0 10px 10px rgba(0, 0, 0, .25)); }
    .ho-rc { padding: 18px 18px 0; clip-path: var(--zm); }
    .ho-rc-h { font-size: 13px; line-height: 19px; letter-spacing: .12em; }
    .ho-rc-s { margin-top: 1px; font-size: 10px; line-height: 15px; letter-spacing: .12em; }
    .ho-rc-l { margin-top: 13px; padding-top: 4px; gap: 22px; }
    .ho-rc-l li { font-size: 14.5px; line-height: 16px; }
    .ho-rc-l svg { width: 13px; height: 14px; margin-left: 4px; }
  }
</style>
<script>
  // B17 player (see CLIP in the frontmatter). Nothing loads until the click.
  document.querySelectorAll<HTMLElement>('[data-ho-player]').forEach((box) => {
    const phone = box.closest<HTMLElement>('.ho-phone');
    const btn = phone?.querySelector<HTMLButtonElement>('button[data-ho-play]');
    if (!phone || !btn) return;
    let video: HTMLVideoElement | null = null;
    btn.addEventListener('click', () => {
      const { file, poster, embed } = box.dataset;
      if (file) {
        if (!video) {
          video = document.createElement('video');
          video.src = file; video.playsInline = true; video.preload = 'auto'; video.controls = false;
          if (poster) video.poster = poster;
          video.setAttribute('aria-label', "Mike's faucet clip");
          video.addEventListener('ended', () => { phone.classList.remove('is-playing'); phone.classList.add('is-ended'); btn.setAttribute('aria-label', 'Replay the clip'); });
          box.append(video); box.classList.add('is-on');
        }
        // A click while it plays (or after it ended) starts it again from the top.
        video.currentTime = 0; void video.play();
        phone.classList.add('is-playing'); phone.classList.remove('is-ended'); btn.setAttribute('aria-label', 'Replay the clip');
      } else if (embed && !box.querySelector('iframe')) {
        const f = document.createElement('iframe');
        f.src = embed; f.title = "Mike's Instagram post"; f.loading = 'eager'; f.allow = 'autoplay; encrypted-media; picture-in-picture'; f.setAttribute('allowfullscreen', '');
        box.append(f); box.classList.add('is-on'); phone.classList.add('is-embed'); f.focus();
      }
    });
  });
</script>
