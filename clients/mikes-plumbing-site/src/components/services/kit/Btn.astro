---
// Buttons from the Figma JSON (btn call / btn ghost): 64 px tall, radius 6, text 22 px in, 36 px arrow disc 16 px from the right.
//   v="tan" (on ink) | "ink" (on paper) | "red": Oswald 600 22 line (`l1`) + Archivo 500 12 sub (`l2`) + arrow disc
//   v="out" (tan outline on ink) | "outInk" (ink outline on paper): Archivo 700 16 title + Archivo 400 12 sub, no disc
// `phone` = l1 is the phone number (tel: link); `big` (default true for solid variants) sets l1 in Oswald.
import { SITE } from '../../../data/site';
interface Props { v?: 'tan' | 'ink' | 'red' | 'out' | 'outInk'; href?: string; l1?: string; l2?: string; w?: number; class?: string; external?: boolean; label?: string; t?: string | false; [k: string]: any }
const { v = 'tan', href = SITE.tel, l1 = SITE.phone, l2, w, class: cls, external, label, t = '3', ...rest } = Astro.props;
const solid = v === 'tan' || v === 'ink' || v === 'red';
// Accessible name = the visible text (WCAG 2.5.3 label in name) + hidden extras: the number on a tel: button that
// does not show it, and the new-tab note. `label` is kept for API compatibility but no longer overrides the name.
void label;
const srExtra = [href.startsWith('tel:') && !`${l1} ${l2 ?? ''}`.includes(SITE.phone) ? `, ${SITE.phone}` : '', external ? ' (opens in a new tab)' : ''].join('');
---
<a href={href} class:list={['sv-btn', `sv-btn--${v}`, cls]} style={w ? `--bw:${w}px` : undefined}
  target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined} data-t={t || undefined} {...rest}>
  <span class="sv-btn-txt"><span class:list={['sv-btn-l1', solid && 'sv-btn-big']}>{l1}</span>{l2 && <span class="sv-btn-l2">{l2}</span>}{srExtra && <span class="sr-only">{srExtra}</span>}</span>
  {solid && <span class="sv-btn-disc" aria-hidden="true"><svg viewBox="0 0 15 12" width="15" height="12"><path d="M0 6h13M8.2 1.2 13 6l-4.8 4.8" fill="none" stroke="currentColor" stroke-width="2" /></svg></span>}
</a>
