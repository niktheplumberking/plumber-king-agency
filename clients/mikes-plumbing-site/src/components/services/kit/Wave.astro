---
// Wave seam (Figma "wave seam" vector nodes, exact path). Desktop node 2240 x 38 (clipped at 1440), mobile 1050 x 26.
// Drawn in px with no viewBox scaling, so the wave keeps its shape at every width.
// The shape under the curve is filled with `fill` (the colour of the section below). Place it inside the LOWER section
// (position: relative) at the seam's Figma y: `top` = seam y - section y (negative, desktop) / `topM` (mobile).
// `up` = the curve rises first from x 0 (Figma phase); else it dips first.
interface Props { fill: string; up?: boolean; upM?: boolean; top?: number; topM?: number; class?: string; z?: number }
const { fill, up = false, upM, top = -34, topM = -24, class: cls, z } = Astro.props;
// Exact Figma vector (wave seam SVG): half-waves of `half` px drawn as cubics with handles at 1/3 and 2/3, peaking at
// mid -/+ (4/3 * amp). Desktop: mid 16, handles -5.333 / 37.333, half 280. Mobile: mid 11, handles -3.667 / 25.667, half 150.
function path(w: number, h: number, half: number, mid: number, lo: number, hi: number, rise: boolean) {
  let d = `M0 ${mid}`;
  for (let x = 0, i = 0; x < w; x += half, i++) {
    const y = (i % 2 === 0) === rise ? lo : hi;
    d += `C${+(x + half / 3).toFixed(2)} ${y} ${+(x + (2 * half) / 3).toFixed(2)} ${y} ${x + half} ${mid}`;
  }
  return `${d}V${h}H0Z`;
}
const dPath = path(2240, 38, 280, 16, -5.333, 37.333, up);
const mPath = path(1050, 26, 150, 11, -3.667, 25.667, upM ?? up);
---
<div class:list={['sv-wave', cls]} aria-hidden="true" style={`--wt:${top}px;--wtm:${topM}px;${z != null ? `z-index:${z};` : ''}`}>
  <svg class="sv-wave-d" width="2240" height="38"><path d={dPath} fill={fill} /></svg>
  <svg class="sv-wave-m" width="1050" height="26"><path d={mPath} fill={fill} /></svg>
</div>
<style>
  .sv-wave { position: absolute; left: 0; right: 0; top: var(--wt); height: 38px; z-index: 3; pointer-events: none; overflow: hidden; }
  .sv-wave svg { max-width: none; display: block; }
  .sv-wave-m { display: none !important; }
  @media (max-width: 767px) {
    .sv-wave { top: var(--wtm); height: 26px; }
    .sv-wave-d { display: none !important; }
    .sv-wave-m { display: block !important; }
  }
</style>
