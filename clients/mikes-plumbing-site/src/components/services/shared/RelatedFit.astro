---
// "More from Mike" (fix round 1 B19; was the "Related" band with three unlabelled pipe fittings, Figma water-heaters 2.7 /
// drain-cleaning 3.7). One component on every service page: a short label and three clear cards, each a real page link with
// a one-line description from PAGES-COPY (the family headlines of the services hub, sections 1.2-1.8). The fittings stay
// only as small decoration in the card corner. Hover (fine pointers): the card lifts (`translate`), its rule and arrow run
// (CSS transitions, ease-in-out 0.4 s). Entrance: the cards rise one after another (data-stagger).
import Wave from '../../kit/Wave.astro';
// `cap` = paper band (drain cleaning); otherwise tan.
interface Props { links: { name: string; href: string; d?: string }[]; cap?: boolean }
const { links, cap } = Astro.props;
// One-line descriptions, word for word from PAGES-COPY (services hub family headlines and the emergency callout).
const DESC: Record<string, string> = {
  '/drain-cleaning': 'Slow drain? Backed-up line? Let’s clear it.',
  '/water-heaters': 'Diagnosis matters. Especially on a water heater.',
  '/emergency-plumber': 'Water where it shouldn’t be? Open 24 hours (Yelp).',
  '/services': 'Everything on the flyer. And more.',
};
const icons = ['elbow', 'tee', 'union'];
---
<nav class:list={['rf sv-sec', cap ? 'sv-paper rf--cap' : 'sv-tan']} aria-labelledby="rf-k" data-m-section>
  <Wave fill={cap ? 'var(--paper)' : 'var(--tan)'} top={-34} topM={-24} />
  <div class="wrap rf-in">
    <h2 id="rf-k" class="rf-k" data-t="1"><svg viewBox="0 0 20 15" aria-hidden="true"><path d="M3.1.8h13.3l2.4 6.5-2.4 6.5H3.1L.8 7.3z" /></svg>More from Mike</h2>
    <ul class="rf-list" role="list" data-t="4" data-stagger>
      {links.map((l, i) => (
        <li><a class="rf-a" href={l.href}>
          <span class="rf-n">{l.name}</span>
          <span class="rf-d">{l.d ?? DESC[l.href] ?? ''}</span>
          <span class="rf-go" aria-hidden="true"><i></i>See the page<svg viewBox="0 0 18 10" width="18" height="10"><path d="M0 5h16M12 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" /></svg></span>
          <span class:list={['rf-ic', `rf-ic--${icons[i % 3]}`]} aria-hidden="true">
            {icons[i % 3] === 'elbow' && <svg viewBox="0 0 60 60"><path d="M7 53V23C7 12.3 12.3 7 23 7H53" fill="none" stroke="currentColor" stroke-width="12" /></svg>}
            {icons[i % 3] === 'tee' && <svg viewBox="0 0 60 60"><path d="M4 18H56M30 18V56" fill="none" stroke="currentColor" stroke-width="12" /></svg>}
            {icons[i % 3] === 'union' && <svg viewBox="0 0 60 60"><path d="M2 30H58" stroke="currentColor" stroke-width="12" /><path d="M20 14H40L46 30 40 46H20L14 30Z" fill="currentColor" /></svg>}
          </span>
        </a></li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .rf { padding: 96px 0 80px; }
  .rf-k { display: flex; align-items: center; gap: 10px; margin: 0; font-family: var(--f-label); font-weight: 500; font-size: 14px; line-height: 21px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink); }
  .rf-k svg { width: 18px; height: 13px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linejoin: round; }
  .rf-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin: 24px 0 0; padding: 0; list-style: none; }
  .rf-a { position: relative; display: grid; align-content: start; height: 100%; min-height: 188px; box-sizing: border-box; padding: 26px 28px 22px; overflow: hidden;
    background: var(--bone); color: var(--ink); text-decoration: none; border-top: 5px solid var(--ink); box-shadow: 0 10px 22px -12px rgba(14, 13, 11, .35);
    transition: translate .4s cubic-bezier(.45, 0, .55, 1), box-shadow .4s cubic-bezier(.45, 0, .55, 1), border-color .4s cubic-bezier(.45, 0, .55, 1); }
  .rf--cap .rf-a { background: #fff9ee; }
  .rf-n { position: relative; z-index: 1; font-family: var(--f-display); font-size: 28px; line-height: 1.1; }
  .rf-d { position: relative; z-index: 1; margin-top: 10px; max-width: 30ch; font-size: 15px; line-height: 22px; color: var(--ink-2); }
  .rf-go { position: relative; z-index: 1; display: inline-flex; align-items: center; gap: 8px; margin-top: 18px; font-family: var(--f-label); font-weight: 500; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--tan-dark); }
  .rf-go i { display: block; width: 18px; height: 1.5px; background: currentColor; transform-origin: 0 50%; transition: scale .4s cubic-bezier(.45, 0, .55, 1); }
  .rf-go svg { transition: translate .4s cubic-bezier(.45, 0, .55, 1); }
  .rf-ic { position: absolute; right: -10px; bottom: -10px; width: 74px; height: 74px; color: rgba(14, 13, 11, .09); transition: rotate .5s cubic-bezier(.45, 0, .55, 1); }
  .rf-ic svg { width: 100%; height: 100%; overflow: visible; }
  .rf-a:focus-visible { outline: 2px solid var(--ink); outline-offset: 4px; }
  @media (hover: hover) and (pointer: fine) {
    .rf-a:hover { translate: 0 -6px; box-shadow: 0 22px 34px -16px rgba(14, 13, 11, .45); border-color: var(--red); }
    .rf-a:hover .rf-go i { scale: 2.2 1; }
    .rf-a:hover .rf-go svg { translate: 20px 0; }
    .rf-a:hover .rf-ic { rotate: -12deg; }
  }

  @media (min-width: 768px) and (max-width: 1279px) { .rf { padding: 80px 0 72px; } .rf-n { font-size: 24px; } }
  @media (max-width: 767px) {
    .rf { padding: 56px 0 56px; }
    .rf-k { font-size: 13px; line-height: 19px; }
    .rf-list { grid-template-columns: 1fr; gap: 14px; margin-top: 18px; }
    .rf-a { min-height: 0; padding: 18px 20px 16px; }
    .rf-n { font-size: 22px; }
    .rf-d { margin-top: 6px; font-size: 14px; line-height: 20px; }
    .rf-go { margin-top: 12px; }
    .rf-ic { width: 56px; height: 56px; }
  }
</style>
