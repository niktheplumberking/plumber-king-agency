---
// 13.1 Confirmation (Figma 670:8742 y 180-901 / 670:8864 y 164-986). Paper field; red live dot eyebrow, the two-line H1,
// the reply line (no timing: Mike to confirm what reply he promises), back-home link. Right (desktop) / below (phone):
// the estimate request printed out of a slot, stamped RECEIVED, his flyer line in script, zigzag tear at the bottom.
import { SITE } from '../../data/site';
import Eyebrow from '../kit-b4/Eyebrow.astro';
import Logo from '../kit-b4/Logo.astro';
const rows = [['Request', 'Free estimate'], ['Status', 'Received'], ['Next', 'Mike gets back to you'], ['Phone', SITE.phone]];
let zig = 'M0 0H400V537.08';
for (let i = 0; i < 28; i++) zig += `L${(400 - (i + 1) * (400 / 28)).toFixed(2)} ${i % 2 ? 537.08 : 552}`;
zig += 'Z';
---
<section class="tyh" aria-labelledby="tyh-h" data-m-section data-m-hero>
  <div class="wrap tyh-in">
    <div class="tyh-copy">
      <Eyebrow text="Message received" tone="deep" dot />
      <h1 id="tyh-h" class="tyh-h1" data-t="2">Thanks.<br /> Mike's Got It.</h1>
      <p class="tyh-p" data-t="3">Your request is in. Mike will get back to you about your free estimate.</p>
      <a class="tyh-home" href="/" data-t="3">Back to the homepage <span aria-hidden="true">→</span></a>
    </div>
    <div class="tyh-rc" data-t="4" data-fx="up">
      <span class="tyh-slot" aria-hidden="true"><i></i></span>
      <div class="tyh-paper">
        <svg class="tyh-bg" viewBox="0 0 400 552" preserveAspectRatio="none" aria-hidden="true"><path d={zig} /></svg>
        <Logo w={100} class="tyh-logo" />
        <h2 class="tyh-t">Free estimate request</h2>
        <dl class="tyh-rows">
          {rows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        </dl>
        <div class="tyh-stamp" aria-hidden="true">
          <svg viewBox="0 0 218 138"><path d="M28.3 2.3h161.4L215.7 69l-26 66.7H28.3L2.3 69z" stroke-width="4.6" /><path d="M36.6 12h144.8l22 57-22 57H36.6l-22-57z" stroke-width="1.725" /></svg>
          <b>Received</b><span>Mike's Plumbing · Est 2025</span>
        </div>
        <p class="tyh-fix">Got plumbing problems? Mike's got the fix!</p>
      </div>
    </div>
  </div>
</section>
<style>
  .tyh { position: relative; height: 721px; background: var(--paper); color: var(--ink); overflow-x: clip; }
  .tyh-in { position: relative; height: 100%; }
  .tyh-copy { position: absolute; left: 0; top: 149px; width: 600px; }
  .tyh-h1 { margin-top: 12px; font-family: var(--f-display); font-weight: 400; font-size: 100px; line-height: 100px; }
  .tyh-p { margin-top: 20px; width: 560px; font-size: 21px; line-height: 32px; color: var(--ink-2); }
  .tyh-home { display: inline-block; margin-top: 34px; font-weight: 700; font-size: 16px; line-height: 17px; color: var(--ink); text-decoration: underline; text-underline-offset: 4px; }
  .tyh-home span { display: inline-block; margin-left: 6px; transition: translate var(--dur-2) var(--ease-out); }
  .tyh-home:hover span { translate: 4px 0; }
  .tyh-rc { position: absolute; left: 740px; top: 56px; width: 440px; height: 575px; }
  .tyh-slot { position: absolute; left: 0; top: 0; width: 440px; height: 30px; border-radius: 15px; background: var(--ink); }
  .tyh-slot i { position: absolute; left: 12px; top: 10px; width: 408px; height: 9px; border-radius: 4px; background: var(--coal); }
  .tyh-paper { position: absolute; left: 20px; top: 15px; width: 400px; height: 552px; padding-top: 31px; text-align: center; filter: drop-shadow(0 14px 13px rgba(0, 0, 0, .22)); }
  .tyh-bg { position: absolute; inset: 0; width: 100%; height: 100%; } .tyh-bg path { fill: var(--bone); }
  .tyh-paper :global(.tyh-logo) { position: relative; display: block; width: 100px; height: auto; margin: 0 auto; }
  .tyh-t { position: relative; margin-top: 14px; font-family: var(--f-label); font-weight: 600; font-size: 14.95px; line-height: 22px; letter-spacing: .14em; text-transform: uppercase; }
  .tyh-rows { position: relative; margin: 15px 24px 0; }
  .tyh-rows div { display: flex; justify-content: space-between; align-items: flex-start; height: 50.67px; padding-top: 9px;
    background: repeating-linear-gradient(90deg, var(--mute) 0 2px, transparent 2px 6px) 0 0 / 100% 1px no-repeat; }
  .tyh-rows dt { padding-top: 2px; font-family: var(--f-label); font-weight: 500; font-size: 12.65px; line-height: 19px; letter-spacing: .12em; text-transform: uppercase; color: var(--tan-dark); }
  .tyh-rows dd { margin: 0; font-weight: 700; font-size: 16.1px; line-height: 18px; }
  .tyh-stamp { position: absolute; left: 91px; top: 327px; width: 218px; height: 138px; color: var(--red); opacity: .9; rotate: 10deg; transform-origin: 0 0; }
  .tyh-stamp svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; } .tyh-stamp path { fill: none; stroke: currentColor; stroke-linejoin: round; }
  .tyh-stamp b { position: absolute; left: 0; right: 0; top: 34px; font-family: var(--f-label); font-weight: 600; font-size: 34.5px; line-height: 51px; letter-spacing: .08em; text-transform: uppercase; }
  .tyh-stamp span { position: absolute; left: 0; right: 0; top: 85px; font-family: var(--f-label); font-weight: 500; font-size: 10.35px; line-height: 15px; letter-spacing: .1em; text-transform: uppercase; }
  .tyh-fix { position: absolute; left: 0; right: 0; top: 499px; font-family: var(--f-script); font-size: 19.55px; line-height: 29px; color: var(--tan-dark); }
  @media (min-width: 768px) and (max-width: 1279px) {
    .tyh { height: auto; padding: 96px 0 120px; }
    .tyh-in { display: flex; justify-content: space-between; gap: 32px; }
    .tyh-copy, .tyh-rc { position: relative; left: auto; top: auto; }
    .tyh-copy { width: auto; flex: 1; padding-top: 40px; }
    .tyh-h1 { font-size: clamp(64px, 7.4vw, 100px); line-height: 1; }
    .tyh-p { width: auto; }
    .tyh-rc { flex: none; zoom: .8; }
  }
  @media (max-width: 767px) {
    .tyh { height: auto; padding: 46px 0 44px; }
    .tyh-in { display: flex; flex-direction: column; align-items: flex-start; }
    .tyh-copy { display: contents; }
    .tyh-rc { position: relative; left: auto; top: auto; }
    .tyh-h1 { margin-top: 8px; font-size: 50px; line-height: 50px; }
    .tyh-p { order: 0; width: auto; margin-top: 14px; font-size: 17px; line-height: 26px; }
    .tyh-home { order: 2; align-self: flex-start; margin-top: 0; font-size: 15px; line-height: 16px; }
    .tyh-rc { order: 1; margin: 53.33px 0 70.67px; zoom: .75; } /* zoomed: real 40 / 53 px */
  }
</style>
