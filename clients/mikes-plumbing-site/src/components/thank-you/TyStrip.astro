---
// 13.2 If it can't wait (Figma 670:8742 y 901-1051 / 670:8864 y 986-1252). Ink strip: pulsing red live dot, the question, the
// Yelp hours line, the tan call button. Its bottom is the next section's paper wave (troughs cut flat by the strip, desktop).
import { SITE } from '../../data/site';
---
<section class="tys on-ink" aria-labelledby="tys-h" data-m-section>
  <div class="wrap tys-in">
    <span class="tys-dot" aria-hidden="true"></span>
    <div class="tys-tx">
      <h2 id="tys-h" class="tys-h" data-t="2">Water on the floor right now?</h2>
      <p class="tys-p" data-t="3">Don't wait on the form. Call {SITE.phone}. {SITE.hoursYelp}.</p>
    </div>
    <a class="tys-btn" href={SITE.tel} data-t="3"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M3.79 0C1.34 0-.49 2.45.12 6.12 1.96 14.7 9.3 22.04 17.88 23.88 21.55 24.49 24 22.66 24 20.21v-3.06c0-1.23-.61-1.84-1.84-2.45l-4.28-1.84c-1.23-.61-2.45 0-3.07 1.22l-1.22 1.84c-3.68-1.22-5.51-3.67-6.74-6.74l1.84-1.22c1.22-.61 1.84-1.84 1.22-3.06L8.08 1.22C7.47 0 6.85 0 5.63 0z" fill="currentColor"/></svg>Call {SITE.phone}</a>
  </div>
</section>
<style>
  .tys { position: relative; height: 144px; background: var(--ink); color: var(--paper); overflow-x: clip; }
  .tys-in { position: relative; display: flex; align-items: center; height: 100%; padding-top: 4px; }
  .tys-dot { position: relative; flex: none; width: 18px; height: 18px; margin: 0 27px 0 3px; border-radius: 50%; background: var(--red); }
  .tys-dot::before { content: ''; position: absolute; inset: -9px; border-radius: 50%; background: rgba(217, 65, 43, .25); animation: tys-pulse 2.4s var(--ease-out) infinite; }
  @keyframes tys-pulse { 0% { transform: scale(.6); opacity: 1; } 70%, 100% { transform: scale(1.25); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .tys-dot::before { animation: none; } }
  .tys-tx { flex: 1; }
  .tys-h { font-family: var(--f-display); font-weight: 400; font-size: 34px; line-height: 46px; color: var(--paper); }
  .tys-p { margin-top: 2px; font-size: 15px; line-height: 16px; color: var(--mute); }
  .tys-btn { display: flex; align-items: center; gap: 14px; width: 320px; height: 64px; padding: 0 22px; border-radius: 6px; background: var(--tan); color: var(--ink);
    font-family: var(--f-label); font-weight: 600; font-size: 22px; line-height: 33px; letter-spacing: .02em; transition: background-color var(--dur-2); }
  .tys-btn:hover { background: var(--paper); }
  @media (min-width: 768px) and (max-width: 1279px) { .tys { height: auto; padding: 40px 0 48px; } .tys-btn { width: auto; flex: none; margin-left: 24px; } .tys-h { font-size: clamp(26px, 3.4vw, 34px); line-height: 1.3; } }
  @media (max-width: 767px) {
    .tys { height: auto; padding: 32px 0 28px; }
    .tys-in { display: grid; grid-template-columns: 30px 1fr; align-items: start; padding-top: 0; }
    .tys-dot { width: 14px; height: 14px; margin: 9px 0 0 1px; } .tys-dot::before { inset: -7px; }
    .tys-h { font-size: 26px; line-height: 28.6px; }
    .tys-p { grid-column: 1 / -1; margin-top: 15px; font-size: 14px; line-height: 21px; }
    .tys-tx { display: contents; }
    .tys-btn { grid-column: 1 / -1; width: 100%; height: 60px; margin-top: 20px; padding: 0 20px; gap: 12px; font-size: 20px; line-height: 30px; }
  }
</style>
