---
// 2.2 Signature · the case file (Figma 670:7700 y 880 h 980, ink; mobile y 1601 h 1072). Manila folder (back + front, tilted)
// with the four case lines, the evidence polaroid on a paper clip and the red DIAGNOSED stamp; Mike's post word for word.
// Scroll moment: the file is "read" line by line (each line lights and pops in turn) and the DIAGNOSED stamp lands last.
import Wave from '../services/kit/Wave.astro';
import Eyebrow from '../services/kit/Eyebrow.astro';
import Img from '../ui/Img.astro';
import { ab } from '../services/kit/ab';
const rows = [
  { k: 'The heater', v: '75-gallon, gas' },
  { k: "What they'd heard", v: 'needs to be replaced' },
  { k: 'What we found', v: 'the gas control valve', red: true },
  { k: 'The point', v: 'find the real problem before replacing anything' },
];
---
<section class="cf sv-sec sv-ink sv-abs" style="--sh:980px" aria-labelledby="cf-h" data-m-section>
  <Wave fill="var(--ink)" up top={-34} topM={-24} />
  <div class="cf-in">
    <Eyebrow tone="tan" class="cf-eb" data-ab style={ab(119.5, 119)}>Case file · 75-gallon gas heater</Eyebrow>
    <h2 id="cf-h" class="sv-h cf-h" data-t="2" data-ab style={ab(120, 152, 760)}>Told to replace it. <em>It needed one part.</em></h2>

    <div class="cf-file" data-sv-scrub data-start="top 70%" data-end="bottom 75%" data-t="3" data-ab style={ab(110, 330, 820, 560, -2)}>
      <svg class="cf-back cf-d" viewBox="0 0 780 540" aria-hidden="true"><path d="M0 18C0 6 6 0 18 0H230C239.3 0 246 4.7 250 14L262 40H762C774 40 780 46 780 58V540H0Z" fill="#C9B37E" /></svg>
      <svg class="cf-back cf-m" viewBox="0 0 340 540" aria-hidden="true"><path d="M0 12C0 4 4 0 12 0H120C125.3 0 129.3 2.7 132 8L140 26H330C336.7 26 340 29.3 340 36V540H0Z" fill="#C9B37E" /></svg>
      <i class="cf-front" aria-hidden="true"></i>
      <p class="cf-tab">Case file &nbsp;·&nbsp; No. 75-gal</p>
      <dl class="cf-rows">
        {rows.map((r, i) => (
          <div class:list={['cf-row', { 'is-red': r.red }]} data-sv-stop data-at={(0.12 + i * 0.2).toFixed(2)}><dt>{r.k}</dt><dd>{r.v}</dd></div>
        ))}
      </dl>
      <figure class="cf-pol sv-polaroid">
        <div class="cf-ph sv-photo"><Img name="water-heater-gas-valve-riverside" alt="Close-up of the heater's gas control valve, the one part it needed" sizes="(min-width: 768px) 210px, 136px" box={210 / 232} boxM={136 / 146} /></div>
        <figcaption>Exhibit A · gas <span class="cf-dn">control </span>valve</figcaption>
      </figure>
      <svg class="cf-clip" viewBox="0 0 20 72" aria-hidden="true"><path d="M1.5 71.2 3.6 11.3C3.8 4.6 6.3 1.3 10.9 1.5 15.6 1.7 17.8 5.1 17.6 11.7L15.9 59.7C15.8 63.7 14 65.7 10.7 65.5 7.4 65.4 5.8 63.4 5.9 59.4L7.4 17.4" fill="none" stroke="#8A8A8A" stroke-width="3" /></svg>
      <p class="cf-stamp" data-sv-stop data-at="0.94" aria-label="Diagnosed">Diagnosed</p>
    </div>

    <p class="cf-k" data-t="3" data-ab style={ab(990, 360)}>Mike's post, word for word</p>
    <p class="cf-qt" data-t="3" data-ab style={ab(990, 390)}>“Diagnosis matters.”</p>
    <blockquote class="cf-q" data-t="3" data-ab style={ab(990, 440, 330)}><p>“...was told it needed to be replaced. After properly diagnosing it, we found the issue was simply the gas control valve.”</p></blockquote>
    <p class="cf-tag" data-t="4" data-ab style={ab(990, 640, 330)}>That's the whole idea. Find the real problem first.</p>
  </div>
</section>

<style>
  .cf-in { position: relative; }
  .cf-h { margin: 0; font-size: 58px; line-height: 1.04; color: var(--paper); }
  .cf-m { display: none; }
  .cf-back { position: absolute; left: 30px; top: 0; width: 780px; height: 540px; }
  .cf-front { position: absolute; left: 0; top: 30px; width: 800px; height: 530px; background: #e3cf9e; box-shadow: 0 20px 40px -10px rgba(0, 0, 0, .6); }
  .cf-tab { position: absolute; left: 60px; top: 8px; margin: 0; font-family: var(--f-label); font-weight: 600; font-size: 14px; line-height: 21px; letter-spacing: .14em; text-transform: uppercase; color: #6b5c3e; }
  .cf-rows { position: absolute; left: 44px; top: 84px; width: 470px; margin: 0; }
  .cf-row { height: 70px; margin-bottom: 22px; border-bottom: 1px solid rgba(14, 13, 11, .3); box-sizing: border-box; transform-origin: 0 50%; --pop-r: -1deg; }
  .cf-row dt { font-family: var(--f-label); font-weight: 500; font-size: 14px; line-height: 21px; letter-spacing: .14em; text-transform: uppercase; color: #6b5c3e; }
  .cf-row dd { margin: 3px 0 0; font-family: var(--f-sans); font-weight: 700; font-size: 24px; line-height: 26px; color: var(--ink); }
  .cf-row.is-red dd { font-size: 28px; line-height: 30px; color: var(--red); }
  .cf-row:last-child dd { width: 470px; }
  .cf-pol { position: absolute; left: 540px; top: 60px; width: 230px; height: 290px; rotate: -4deg; transform-origin: 0 0; margin: 0; box-shadow: 0 12px 24px -6px rgba(0, 0, 0, .3); }
  .cf-ph { position: absolute; left: 10px; top: 10px; width: 210px; height: 232px; }
  .cf-pol figcaption { position: absolute; left: 10px; top: 258px; font-family: var(--f-label); font-weight: 500; font-size: 10.5px; line-height: 16px; letter-spacing: .08em; text-transform: uppercase; color: #4a443a; white-space: nowrap; }
  .cf-clip { position: absolute; left: 607px; top: 39px; width: 20px; height: 72px; }
  .cf-stamp { position: absolute; left: 500px; top: 410px; width: 260px; height: 74px; box-sizing: border-box; margin: 0; border: 4px solid var(--red); border-radius: 6px; rotate: 12deg; transform-origin: 0 0; opacity: .9;
    text-align: center; padding-top: 5px; font-family: var(--f-label); font-weight: 700; font-size: 40px; line-height: 59px; letter-spacing: .1em; text-transform: uppercase; color: var(--red); --pop-r: 14deg; }
  /* the stamp's pop must keep its tilt: animate scale only */
  :global(.sv-scrub-on) .cf-stamp.is-lit { animation-name: cf-thud; }
  @keyframes cf-thud { 0% { scale: 1.35; } 60% { scale: .96; } 100% { scale: 1; } }
  .cf-k { margin: 0; font-family: var(--f-label); font-weight: 500; font-size: 13px; line-height: 19px; letter-spacing: .14em; text-transform: uppercase; color: var(--tan); }
  .cf-qt { margin: 0; font-family: var(--f-label); font-weight: 700; font-size: 30px; line-height: 44px; letter-spacing: .04em; text-transform: uppercase; color: var(--paper); }
  .cf-q { margin: 0; } .cf-q p { margin: 0; font-family: var(--f-sans); font-style: italic; font-size: 20px; line-height: 1.5; color: var(--tan); }
  .cf-tag { margin: 0; font-family: var(--f-display); font-size: 30px; line-height: 1.12; color: var(--paper); }

  @media (max-width: 1279px) {
    .cf-in { width: calc(100% - 2 * var(--gutter)); margin-inline: auto; display: flex; flex-direction: column; align-items: flex-start; }
    .cf-file { position: relative; }
  }
  @media (min-width: 768px) and (max-width: 1279px) {
    .cf { padding: 110px 0 110px; }
    .cf-h { margin-top: 12px; max-width: 680px; font-size: clamp(42px, 5vw, 58px); }
    .cf-file { width: 820px; height: 580px; margin-top: 48px; rotate: 2deg; transform-origin: 0 0; zoom: min(1, calc((100vw - 2 * var(--gutter)) / 840px)); }
    .cf-k { margin-top: 48px; } .cf-qt { margin-top: 10px; } .cf-q { margin-top: 6px; max-width: 520px; } .cf-tag { margin-top: 40px; max-width: 520px; }
  }
  @media (max-width: 767px) {
    .cf { padding: 59px 0 80px; }
    .cf-h { margin-top: 10px; font-size: 34px; line-height: 1.06; }
    .cf-d, .cf-dn { display: none; } .cf-m { display: block; }
    .cf-file { width: 356px; height: 560px; margin: 30px 0 0 -4px; rotate: 1.5deg; transform-origin: 0 0; }
    .cf-back { left: 12px; width: 340px; height: 540px; }
    .cf-front { top: 22px; width: 350px; height: 530px; box-shadow: 0 16px 30px -8px rgba(0, 0, 0, .6); }
    .cf-tab { left: 22px; top: 6px; font-size: 10.5px; line-height: 16px; letter-spacing: .1em; }
    .cf-rows { left: 22px; top: 240px; width: 306px; }
    .cf-row { height: 62px; margin-bottom: 10px; }
    .cf-row dt { font-size: 12px; line-height: 18px; letter-spacing: .12em; }
    .cf-row dd { margin-top: 2px; font-size: 17px; line-height: 18px; }
    .cf-row.is-red dd { font-size: 20px; line-height: 22px; }
    .cf-row:last-child dd { width: 300px; }
    .cf-pol { left: 196px; top: 40px; width: 150px; height: 186px; }
    .cf-ph { left: 7px; top: 7px; width: 136px; height: 146px; }
    .cf-pol figcaption { left: 8px; top: 164px; font-size: 9px; line-height: 13px; }
    .cf-clip { display: none; }
    .cf-stamp { left: 20px; top: 120px; width: 180px; height: 52px; border-width: 3px; border-radius: 5px; padding-top: 4px; font-size: 28px; line-height: 41px; letter-spacing: .08em; }
    .cf-k { margin-top: 20px; font-size: 12px; line-height: 18px; }
    .cf-qt { margin-top: 6px; font-size: 24px; line-height: 36px; }
    .cf-q { margin-top: 8px; } .cf-q p { font-size: 16px; }
    .cf-tag { margin-top: 24px; font-size: 26px; }
  }
</style>
