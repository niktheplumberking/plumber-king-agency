---
// 2.6 Final CTA · gas line into service plate (Figma 670:7700 y 4240 h 560, ink; mobile y 4730 h 622). H2, line, call + form
// buttons, a gas line with a hex nut running into a heater rating plate (service / call / area).
import Wave from '../services/kit/Wave.astro';
import Btn from '../services/kit/Btn.astro';
import { ab } from '../services/kit/ab';
import { SITE } from '../../data/site';
interface Props { h: string; em: string; body: string; service?: string }
const { h, em, body, service = 'Free estimate' } = Astro.props;
---
<section class="pc sv-sec sv-ink sv-abs" style="--sh:560px" aria-labelledby="pc-h" data-m-section>
  <Wave fill="var(--ink)" top={-34} topM={-24} />
  <div class="pc-in">
    <h2 id="pc-h" class="sv-h pc-h" data-t="2" data-ab style={ab(120, 120, 620)}>{h} <em>{em}</em></h2>
    <p class="pc-body" data-t="3" data-ab style={ab(120, 254)}>{body}</p>
    <div class="pc-btns" data-t="4" data-ab style={ab(120, 314, 566, 64)}>
      <Btn v="tan" l2="Call now" w={300} label={`Call ${SITE.phone} now`} />
      <Btn v="out" href="#estimate" l1="Get a free estimate" l2="Fill in the form" w={250} class="pc-ghost" />
    </div>
    <div class="pc-vis" data-t="3">
      <i class="pc-line pc-line--l" data-ab style={ab(720, 277, 140, 6)} aria-hidden="true"></i>
      <svg class="pc-nut" data-ab style={ab(769.3, 267.3, 42, 26)} viewBox="0 0 42 26" aria-hidden="true"><path d="M5.9.7H35.5L40.7 12.7 35.5 24.7H5.9L.7 12.7Z" fill="#D2C5A6" stroke="#0E0D0B" stroke-width="1.4" /></svg>
      <i class="pc-line pc-line--r" aria-hidden="true"></i>
      <div class="pc-plate-w" data-ab style={ab(840, 120, 480, 300)}>
        <div class="pc-plate">
          <i class="pc-in-b" aria-hidden="true"></i>
          {[[11, 11], [459, 11], [11, 279], [459, 279]].map(([x, y]) => <i class="pc-sc" style={`left:${x}px;top:${y}px`} aria-hidden="true"></i>)}
          <p class="pc-ph">Mike's Plumbing Services · Service plate</p>
          <dl>
            <div class="pc-r pc-r1"><dt>Service</dt><dd>{service}</dd></div>
            <div class="pc-r pc-r2"><dt>Call</dt><dd><a href={SITE.tel}>{SITE.phone}</a></dd></div>
            <div class="pc-r pc-r3"><dt>Area</dt><dd>Riverside · IE · OC · LA</dd></div>
          </dl>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pc-in { position: relative; }
  .pc-h { margin: 0; font-size: 56px; line-height: 1.04; color: var(--paper); }
  .pc-body { margin: 0; font-size: 18px; line-height: 20px; color: var(--mute); }
  .pc-btns { display: flex; gap: 16px; }
  .pc-line { display: block; background: rgba(210, 197, 166, .9); }
  .pc-line--r { display: none; }
  .pc-plate { position: relative; width: 480px; height: 300px; border-radius: 8px; background: #bdb5a2; box-shadow: 0 16px 30px -8px rgba(0, 0, 0, .5); color: var(--ink); }
  .pc-in-b { position: absolute; inset: 8px; border: 1.2px solid var(--ink); border-radius: 4px; }
  .pc-sc { position: absolute; width: 10px; height: 10px; border-radius: 50%; background: #4a443a; }
  .pc-ph { position: absolute; left: 0; right: 0; top: 32px; margin: 0; text-align: center; font-family: var(--f-label); font-weight: 600; font-size: 14px; line-height: 21px; letter-spacing: .12em; text-transform: uppercase; }
  .pc-plate dl { margin: 0; }
  .pc-r { position: absolute; left: 30px; width: 420px; border-top: 1px solid #4a443a; }
  .pc-r1 { top: 72px; height: 38px; } .pc-r2 { top: 110px; height: 78px; } .pc-r3 { top: 188px; height: 40px; border-bottom: 0; }
  .pc-r dt { position: absolute; left: 6px; font-family: var(--f-label); font-weight: 500; font-size: 13px; line-height: 19px; letter-spacing: .12em; text-transform: uppercase; color: #4a443a; }
  .pc-r dd { position: absolute; left: 116px; margin: 0; font-family: var(--f-sans); font-weight: 700; font-size: 17px; line-height: 18px; }
  .pc-r1 dt { top: 11px; } .pc-r1 dd { top: 11.5px; }
  .pc-r2 dt { top: 28.5px; } .pc-r2 dd { top: 7px; }
  .pc-r3 dt { top: 11px; } .pc-r3 dd { top: 11.5px; }
  .pc-r2 a { font-family: var(--f-label); font-weight: 700; font-size: 42px; line-height: 62px; color: var(--ink); text-decoration: none; }
  .pc-r2 a:hover { text-decoration: underline; text-decoration-thickness: 2px; }

  @media (max-width: 1279px) {
    .pc-in { width: calc(100% - 2 * var(--gutter)); margin-inline: auto; display: flex; flex-direction: column; align-items: flex-start; }
    .pc-vis { position: relative; width: 100%; order: 3; }
    .pc-btns { order: 4; }
    .pc-nut { display: none; }
    .pc-line--l, .pc-line--r { display: block; position: absolute; top: 105px; width: calc(var(--gutter) + 20px); height: 5px; background: var(--tan); }
    .pc-line--l { left: calc(-1 * var(--gutter)); } .pc-line--r { right: calc(-1 * var(--gutter)); }
  }
  @media (min-width: 768px) and (max-width: 1279px) {
    .pc { padding: 100px 0 110px; }
    .pc-h { max-width: 640px; font-size: clamp(42px, 5vw, 56px); }
    .pc-body { margin-top: 18px; }
    .pc-vis { margin-top: 40px; height: 300px; }
    .pc-line--l, .pc-line--r { top: 147px; }
    .pc-plate-w { position: relative; width: 480px; margin-inline: auto; }
    .pc-btns { margin-top: 40px; }
  }
  @media (max-width: 767px) {
    .pc { padding: 60px 0 46px; }
    .pc-h { font-size: 34px; line-height: 1.06; }
    .pc-body { margin-top: 14px; font-size: 15.5px; line-height: 17px; }
    .pc-vis { margin-top: 30px; height: 215px; }
    .pc-plate-w { position: relative; width: 100%; height: 215px; }
    .pc-plate { zoom: calc(350 / 480); width: 480px; height: 295px; }
    .pc-btns { flex-direction: column; gap: 10px; width: 100%; margin-top: 30px; }
  }
</style>
