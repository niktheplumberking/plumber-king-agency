---
// 2.3 Repair or install (Figma 670:7700 y 1860 h 860, paper; mobile y 2673 h 632). Centered eyebrow + H2, a copper riser with
// a gas valve whose red handle points between "repair" and "install", the two options under it.
// Scroll moment: the valve handle turns from the repair side to its Figma position (install) as you scroll, while the riser
// fills with water from the top (desktop) / the line fills left to right (mobile).
import Wave from '../kit/Wave.astro';
import Eyebrow from '../kit/Eyebrow.astro';
import { ab } from '../services/shared/ab';
---
<section class="ri sv-sec sv-paper sv-abs" style="--sh:860px" aria-labelledby="ri-h" data-m-section>
  <Wave fill="var(--paper)" top={-34} topM={-24} />
  <div class="ri-in" data-sv-scrub data-start="top 65%" data-end="bottom 80%" data-start-m="top 70%" data-end-m="center 40%">
    <Eyebrow look="figma" tone="deep" class="ri-eb" data-ab style={ab(646.5, 109)}>Repair · Install</Eyebrow>
    <h2 id="ri-h" class="sv-h ri-h" data-t="2" data-ab style={ab(220, 142, 1000)}>Fix it when it can be fixed. <em>Replace it when it can't.</em></h2>

    <div class="ri-dia ri-d" aria-hidden="true" data-t="3">
      <div class="ri-pipe" data-ab style={ab(706, 306, 28, 554)}><i class="ri-hi"></i><i class="ri-shade" data-sv-fill data-rev data-axis="y"></i></div>
      <svg data-ab style={ab(685.3, 297.3, 70, 20)} viewBox="0 0 70 20"><path d="M9.54.7H59.86L68.7 9.7 59.86 18.7H9.54L.7 9.7Z" fill="#D2C5A6" stroke="#0E0D0B" stroke-width="1.4" /></svg>
      <svg data-ab style={ab(669, 538, 102, 70)} viewBox="0 0 102 70"><path d="M14 1H88L101 35 88 69H14L1 35Z" fill="#D2C5A6" stroke="#0E0D0B" stroke-width="2" /></svg>
      <i class="ri-dot" data-ab style={ab(708, 561, 24, 24)}></i>
      <span class="ri-pivot" data-ab style={ab(722.4, 572.6, 0, 0)}><i class="ri-handle" data-sv-turn data-from="62" data-to="-20"></i></span>
      <span class="ri-lab sv-script lh-yest" data-ab style={ab(500, 451)}>repair</span>
      <span class="ri-lab sv-script lh-yest" data-ab style={ab(850, 451)}>install</span>
      <svg class="ri-arr" data-ab style={ab(468.9, 497.9, 193, 42)} viewBox="0 0 193 42"><path d="M191.1 40.7C141.1-5.3 71.1-9.3 1.1 18.7M17.1 28.7 1.1 18.7 19.1 2.7" /></svg>
      <svg class="ri-arr" data-ab style={ab(778.9, 497.9, 193, 42)} viewBox="0 0 193 42"><path d="M1.1 40.7C51.1-5.3 121.1-9.3 191.1 18.7M175.1 28.7 191.1 18.7 173.1 2.7" /></svg>
    </div>
    <div class="ri-dia ri-m" aria-hidden="true">
      <div class="ri-mpipe"><i class="ri-hi"></i><i class="ri-shade" data-sv-fill data-rev></i></div>
      <svg class="ri-mvalve" viewBox="0 0 82 72"><path d="M11.4 1H70.6L81 36 70.6 71H11.4L1 36Z" fill="#D2C5A6" stroke="#0E0D0B" stroke-width="2" /></svg>
      <i class="ri-mdot"></i>
      <span class="ri-mpivot"><i class="ri-mhandle" data-sv-turn data-from="-150" data-to="30"></i></span>
      <span class="ri-mlab ri-mlab--l sv-script lh-yest">← repair</span>
      <span class="ri-mlab ri-mlab--r sv-script lh-yest">install →</span>
    </div>

    <div class="ri-opt ri-opt--a" data-t="3" data-ab style={ab(160, 583, 440)}>
      <h3 class="ri-o-h">Water Heater Repair</h3>
      <p>Not heating, leaking or acting up? We diagnose it properly, then tell you what it needs.</p>
    </div>
    <div class="ri-opt ri-opt--b" data-t="3" data-ab style={ab(840, 583, 440)}>
      <h3 class="ri-o-h">Water Heater Install</h3>
      <p>When a new heater is the right call, we install it.</p>
    </div>
  </div>
</section>

<style>
  .ri-in { position: relative; }
  .ri-h { margin: 0; font-size: 54px; line-height: 1.06; text-align: center; }
  .ri-m { display: none; }
  .ri-pipe { background: #6b5c3e; overflow: hidden; }
  .ri-hi { position: absolute; left: 6px; top: 0; width: 5px; height: 100%; background: rgba(255, 255, 255, .2); }
  .ri-shade { position: absolute; inset: 0; background: rgba(14, 13, 11, .45); transform-origin: 50% 100%; }
  .ri-dot { border-radius: 50%; background: var(--ink); }
  .ri-pivot { display: block; }
  .ri-handle { position: absolute; left: 0; top: -7px; width: 120px; height: 14px; border-radius: 7px; background: var(--red); transform-origin: 0 50%; transform: rotate(-20deg); }
  .ri-lab { font-size: 34px; color: var(--red); }
  .ri-arr path { fill: none; stroke: var(--ink); stroke-width: 2.2; }
  .ri-opt h3 { margin: 0; font-family: var(--f-display); font-weight: 400; font-size: 34px; line-height: 46px; color: var(--ink); }
  .ri-opt p { margin: 8px 0 0; font-size: 18px; line-height: 1.6; color: var(--ink-2); }

  @media (max-width: 1279px) {
    .ri-in { width: calc(100% - 2 * var(--gutter)); margin-inline: auto; display: flex; flex-direction: column; align-items: flex-start; }
    .ri-d { display: none; } .ri-m { display: block; }
    .ri-h { text-align: left; }
    .ri-m { position: relative; width: 100%; height: 134px; }
    .ri-mpipe { position: absolute; left: calc(-1 * var(--gutter)); right: calc(-1 * var(--gutter)); top: 44px; height: 22px; background: #6b5c3e; overflow: hidden; }
    .ri-mpipe .ri-hi { left: 0; top: 4px; width: 100%; height: 4px; }
    .ri-mpipe .ri-shade { transform-origin: 100% 50%; }
    .ri-mvalve { position: absolute; left: calc(50% - 41px); top: 19px; width: 82px; height: 72px; }
    .ri-mdot { position: absolute; left: calc(50% - 9px); top: 46px; width: 18px; height: 18px; border-radius: 50%; background: var(--ink); }
    .ri-mpivot { position: absolute; left: 50%; top: 55px; }
    .ri-mhandle { position: absolute; left: 0; top: -6px; width: 90px; height: 12px; border-radius: 6px; background: var(--red); transform-origin: 0 50%; transform: rotate(30deg); }
    .ri-mlab { position: absolute; top: 98px; font-size: 28px; color: var(--red); white-space: nowrap; }
    .ri-mlab--l { left: 0; } .ri-mlab--r { right: 6px; }
    .ri-opt { position: static; }
  }
  @media (min-width: 768px) and (max-width: 1279px) {
    .ri { padding: 109px 0 110px; }
    .ri-h { margin-top: 12px; max-width: 760px; font-size: clamp(40px, 4.6vw, 54px); }
    .ri-m { margin-top: 40px; }
    .ri-opt { margin-top: 32px; max-width: 560px; }
  }
  @media (max-width: 767px) {
    .ri { padding: 59px 0 80px; }
    .ri-h { margin-top: 10px; font-size: 32px; }
    .ri-m { margin-top: 20px; }
    .ri-opt--a { margin-top: 26px; } .ri-opt--b { margin-top: 30px; }
    .ri-opt h3 { font-size: 26px; line-height: 35px; }
    .ri-opt p { margin-top: 5px; font-size: 15.5px; line-height: 1.55; }
  }
</style>
