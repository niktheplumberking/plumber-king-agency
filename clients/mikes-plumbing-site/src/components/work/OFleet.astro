---
// O6 The fleet (Figma O6): sky field, navy text; three framed fleet photos in a loose row (tilted, varied heights) with
// caption plates and the seal on the middle photo's corner; a van-stripe swoosh crosses the bottom join into the reviews.
import SectionHead from '../ui/SectionHead.astro';
import Img from '../ui/Img.astro';
import Caption from '../ui/Caption.astro';
import Seal from '../ui/Seal.astro';
import Swoosh from '../ui/Swoosh.astro';
const ph = [
  // sizes: the desktop crops below draw the photo 2.22x / 1x / 1.7x the frame width; on mobile the frame is 220 x 240
  { n: 'fleet-aerial-van-jobsite', alt: 'Drone view of a Plumbing By Paul van at a waterfront home under construction', cap: 'From above, on a waterfront job.', cls: 'f0', sz: '(min-width: 1024px) 845px, 440px' },
  { n: 'fleet-box-truck-rear-three-quarter', alt: 'The Plumbing By Paul box truck wrapped with the Paul cartoon', cap: 'The box truck.', cls: 'f1', sz: '(min-width: 1024px) 380px, 220px' },
  { n: 'fleet-van-street-4284px', alt: 'A Plumbing By Paul van parked on a residential street', cap: 'Out on the road.', cls: 'f2', sz: '(min-width: 1024px) 646px, 220px' },
];
---
<section class="of" aria-labelledby="of-h" data-m-section>
  <div class="wrap">
    <div class="of-head">
      <SectionHead eyebrow="Spot us on the road" l1="White trucks, blue stripes," l2="one very familiar face" id="of-h" class="of-sh" />
      <p class="of-p" data-t="3">If you've driven through Pinellas, you've been stuck behind Paul at a light. Wave next time.</p>
    </div>
    <ul role="list" class="of-row" data-t="4" data-stagger tabindex="0" aria-label="Our trucks and crew photos">
      {ph.map((p) => (
        <li class:list={['of-i', p.cls]} data-fx="frame">
          <figure class="of-f frame"><Img name={p.n} alt={p.alt} sizes={p.sz} widths={[400, 800, 1440, 1700]} focus="50% 50%" /><figcaption><Caption class="of-cap" small>{p.cap}</Caption></figcaption></figure>
        </li>
      ))}
      <li class="of-seal" aria-hidden="true"><Seal d={88} deg={10} /></li>
    </ul>
  </div>
  <Swoosh class="of-sw" below="#FFFFFF" />
</section>
<style>
  .of { position: relative; background: var(--sky); padding: 96px 0 0; overflow-x: clip; }
  .of-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 40px; }
  .of-head :global(.of-sh .l2) { color: var(--navy); }
  .of-p { flex: 0 1 420px; margin-top: 38px; font-weight: 500; font-size: 18px; line-height: 30px; color: var(--navy); }
  .of-row { position: relative; height: 393px; margin: 49px 0 0; padding: 0; list-style: none; z-index: 3; pointer-events: none; } .of-row > * { pointer-events: auto; } /* z 3 (QA r2): the box-truck frame hangs past the swoosh into the reviews (z 2), which cut it flat; only the row is lifted, the reviews card that rises into the swoosh stays on top of it; the empty part of the row box lets clicks through */
  .of-i { position: absolute; }
  .of-f { width: 100%; height: 100%; margin: 0; border: 8px solid var(--white); border-radius: 24px; box-shadow: 0 28px 56px rgba(17, 16, 50, .22); }
  /* Figma crops (image box relative to the photo inside the 8 px border) */
  .f0 .of-f :global(img) { position: absolute; left: -18.33%; top: -25%; width: 222.22%; height: 125%; max-width: none; }
  .f1 .of-f :global(img) { position: absolute; left: 0; top: -28.93%; width: 100%; height: 168.89%; max-width: none; }
  .f2 .of-f :global(img) { position: absolute; left: -42%; top: -78.53%; width: 170%; height: 226.67%; max-width: none; }
  .of-f :global(img) { display: block; }
  .of-f :global(.of-cap) { position: absolute; left: 16px; bottom: 16px; z-index: 2; }
  .f0 { left: 0; top: 7px; width: 380px; height: 380px; transform: rotate(-2deg); }
  .f1 { left: 410px; top: 57px; width: 380px; height: 300px; transform: rotate(1deg); }
  .f2 { left: 820px; top: 7px; width: 380px; height: 380px; transform: rotate(2deg); }
  .of-seal { position: absolute; left: 746px; top: 13px; z-index: 3; }
  .of :global(.of-sw) { position: relative; z-index: 1; margin-top: -86px; margin-bottom: -1px; }
  @media (max-width: 1199px) { .of-row { transform: scale(.82); transform-origin: left top; height: 330px; } }
  @media (max-width: 1023px) {
    .of { padding-top: 56px; }
    .of-head { display: block; }
    .of-head :global(.of-sh .h2) { font-size: 25px; line-height: 30px; letter-spacing: -.01em; }
    .of-p { margin-top: 14px; font-size: 16px; line-height: 26px; }
    .of-row { display: flex; gap: 16px; height: auto; margin: 20px calc(-1 * var(--gutter)) 0; padding: 10px var(--gutter) 26px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; transform: none; }
    .of-row::-webkit-scrollbar { display: none; }
    .of-i { position: relative; left: auto !important; top: auto !important; flex: 0 0 220px; height: 240px !important; width: auto !important; transform: none; scroll-snap-align: start; }
    .of-i.f1 { margin-top: 24px; }
    .of-f { border-width: 6px; border-radius: 20px; }
    .of-f :global(.of-cap) { left: 10px; bottom: 10px; font-size: 11px; line-height: 15px; padding: 6px 9px; }
    .of-seal { display: none; }
    .of-i .of-f :global(img) { position: static; width: 100%; height: 100%; }
    .of :global(.of-sw) { margin-top: -90px; height: 64px; }
  }
</style>
