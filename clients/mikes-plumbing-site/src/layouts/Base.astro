---
// Base layout: full SEO head, site-wide Plumber JSON-LD, per-page JSON-LD slot, noindex switch, skip link,
// loader + page curtain, header, footer, sticky mobile call bar, motion module. Every page uses it:
//   <Base title="..." description="..." path="/water-heaters" og="hero-05-tech-toilet-repair-pro" jsonld={[...]}>
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SITE } from '../data/site';
import { plumberSchema, websiteSchema, webPageSchema, isPageNode, abs } from '../lib/schema';
import { zoomSizes, zoomWidths } from '../components/ui/zoomSizes';
import logo from '../assets/brand/logo-ink.png';
import UtilityBar from '../components/global/UtilityBar.astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import MobileCallBar from '../components/global/MobileCallBar.astro';
import Loader from '../components/global/Loader.astro';
import Curtain from '../components/kit/Curtain.astro';
import EmergencyStrip from '../components/global/EmergencyStrip.astro';

interface Props {
  title: string; description: string; path: string; og?: string; ogAlt?: string; jsonld?: object[];
  noindex?: boolean; bodyClass?: string; loader?: boolean; type?: 'website' | 'article';
  /** Optional early AVIF preload of the LCP photo: the same name, sizes and widths as its `<Img priority>`. */
  preload?: { name: string; sizes: string; widths: number[] };
  /** Target of the mobile call bar's "Free estimate": the waterline form (#estimate) unless the page has none. */
  estimate?: string;
}
const { title, description, path, og = 'mike-navarro-loading-plumbing-van-riverside', ogAlt, jsonld = [], noindex, bodyClass, loader = true, type = 'website', preload, estimate = '#estimate' } = Astro.props;

// Preview builds are noindex unless PUBLIC_NOINDEX is exactly "false" (launch build only).
const envNoindex = String(import.meta.env.PUBLIC_NOINDEX ?? 'true').toLowerCase() !== 'false';
const robots = noindex || envNoindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const canonical = abs(path);

const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/*.jpg', { eager: true });
const ogSrc = photos[`/src/assets/photos/${og}.jpg`]?.default;
if (!ogSrc) throw new Error(`Base: og photo "${og}" not found`);
const ogImg = await getImage({ src: ogSrc, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 78 });
const ogUrl = new URL(ogImg.src, Astro.site).href;
const logoImg = await getImage({ src: logo, width: 512, format: 'png' });
const logoUrl = new URL(logoImg.src, Astro.site).href;

// Same options as Img.astro's AVIF <source> (quality 60 for priority images), so the preloaded files are the ones the page uses.
let lcpSet: string | undefined;
let lcpSizes: string | undefined;
if (preload) {
  const src = photos[`/src/assets/photos/${preload.name}.jpg`]?.default;
  if (!src) throw new Error(`Base: preload photo "${preload.name}" not found`);
  const z = zoomSizes(preload.sizes);
  const img = await getImage({ src, widths: zoomWidths(preload.widths, z.slot, src.width), sizes: z.sizes, format: 'avif', quality: 60 });
  lcpSet = img.srcSet.attribute; lcpSizes = z.sizes;
}
const gtm = import.meta.env.PUBLIC_GTM_ID as string | undefined;
const ga = import.meta.env.PUBLIC_GA_ID as string | undefined;
// The site-wide Plumber entity carries the same image on every page (entity data stays constant).
const entityImg = await getImage({ src: photos['/src/assets/photos/mike-navarro-loading-plumbing-van-riverside.jpg'].default, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 78 });
const is404 = path === '/404';
// Graph on every page: the business, the site, and this page (isPartOf the site, about the business). A page type the page
// sends itself (AboutPage, ContactPage, CollectionPage) becomes the page node; noindex pages get no page node.
const ownPage = jsonld.find(isPageNode);
const pageNode = noindex || is404 ? [] : [webPageSchema({ path, title, description, image: ogUrl, existing: ownPage })];
const ld = [plumberSchema(logoUrl, new URL(entityImg.src, Astro.site).href), websiteSchema(), ...pageNode, ...jsonld.filter((o) => o !== ownPage)];
---
<!doctype html>
<html lang="en-US" data-loader={loader ? undefined : 'off'}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {!is404 && <link rel="canonical" href={canonical} />}
  <meta name="robots" content={robots} />
  <meta name="theme-color" content="#0E0D0B" />
  <meta name="format-detection" content="telephone=no" />
  <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  {lcpSet && preload && <link rel="preload" as="image" type="image/avif" imagesrcset={lcpSet} imagesizes={lcpSizes} fetchpriority="high" />}
  <link rel="preload" href="/fonts/abril-fatface-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/archivo-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/oswald-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/yesteryear-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {!is404 && <meta property="og:url" content={canonical} />}
  <meta property="og:image" content={ogUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogAlt ?? `${SITE.name}, family plumber in Riverside, CA`} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogUrl} />
  <meta name="geo.region" content="US-CA" />
  <meta name="geo.placename" content="Riverside" />
  <meta name="geo.position" content={`${SITE.geo.lat};${SITE.geo.lng}`} />
  {/* Inline scripts ship as written (no minifier), so their comments live here, outside the page (QA round 2: Home HTML size).
     Wide screens: from 1280 px up the whole 1440 Figma layout is scaled up with CSS zoom, so proportions hold at any desktop
     width (same idea as United). Zoom re-lays out text and vectors at the new size, so nothing is blurred. Set here, before
     first paint. The width is the viewport minus the classic scrollbar (measured once by forcing it on for a moment), and
     a ResizeObserver re-fits when the scrollbar comes or goes (Lenis stopped under the loader). --zoom feeds the CSS
     tokens that use vw (tokens.css --vw100: use it instead of 100vw). Below 1280 px nothing changes (tablet and phone layouts).
     In <head> there is no body yet: the page will scroll, so fit() leaves room for its scrollbar. */}
  <script is:inline>
    (function () {
      var d = document.documentElement, sb = 0;
      try { var o = d.style.overflowY; d.style.overflowY = 'scroll'; sb = Math.max(0, window.innerWidth - d.clientWidth); d.style.overflowY = o; } catch (e) {}
      function fit() {
        var w = d.clientWidth || window.innerWidth;
        if (!document.body) w = window.innerWidth - sb;
        var z = w >= 1280 ? Math.round(w / 1440 * 10000) / 10000 : 1;
        var s = z !== 1 ? String(z) : '';
        if (d.style.zoom !== s) { d.style.zoom = s; d.style.setProperty('--zoom', String(z)); }
      }
      fit();
      window.addEventListener('resize', fit);
      document.addEventListener('DOMContentLoaded', function () { fit(); if (window.ResizeObserver) new ResizeObserver(fit).observe(d); });
    })();
  </script>
  {/* Decide before first paint (MOTION.md): motion on? loader this visit? curtain lift after an in-site click? (then the
     browser must not restore an old scroll position under the cover: kit/curtain.ts puts the page at the top and sets
     scrollRestoration back to 'auto' after the lift, so back/forward stay native). Safety: if the motion module never
     boots within 3.5 s, show everything. */}
  <script is:inline>
    (function () {
      var d = document.documentElement; d.classList.add('js');
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) { d.classList.add('no-motion'); return; }
      d.classList.add('motion');
      var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
      var hist = nav && nav.type === 'back_forward';
      var seen = false, internal = false;
      try { seen = sessionStorage.getItem('mps-intro') === '1'; internal = sessionStorage.getItem('mps-nav') === '1'; sessionStorage.removeItem('mps-nav'); } catch (e) {}
      if (!seen && !hist && d.getAttribute('data-loader') !== 'off') d.classList.add('intro');
      else if (internal && !hist) { d.classList.add('pt-in'); try { history.scrollRestoration = 'manual'; } catch (e) {} }
      setTimeout(function () { if (!window.__pbpMotion) d.classList.remove('motion', 'intro', 'pt-in'); }, 3500);
    })();
  </script>
  {gtm && <script is:inline define:vars={{ gtm }}>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtm);</script>}
  {!gtm && ga && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga}`}></script>}
  {!gtm && ga && <script is:inline define:vars={{ ga }}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config',ga);</script>}
  {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  <slot name="head" />
</head>
<body class={bodyClass}>
  {gtm && <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${gtm}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>}
  <a href="#main" class="skip">Skip to content</a>
  {loader && <Loader />}
  <Curtain />
  <UtilityBar />
  <Header path={path} estimate={estimate} />
  <EmergencyStrip />
  <main id="main" tabindex="-1"><slot /></main>
  <Footer />
  <MobileCallBar estimate={estimate} />
  <script>import '../scripts/ui'; import '../scripts/forms'; import '../scripts/motion'; import '../components/kit/scrub';</script>
</body>
</html>
