---
// About (Figma 669:863 desktop / 670:2272 mobile, PAGES-COPY section 7). AboutPage JSON-LD about the business, Mike as founder.
import Base from '../layouts/Base.astro';
import AHero from '../components/about/AHero.astro';
import AQuote from '../components/about/AQuote.astro';
import AVan from '../components/about/AVan.astro';
import AWork from '../components/about/AWork.astro';
import AFamily from '../components/about/AFamily.astro';
import ANext from '../components/about/ANext.astro';
import { BUSINESS_ID, abs } from '../lib/schema';
import { SITE } from '../data/site';
const path = '/about';
const ld = [
  { '@context': 'https://schema.org', '@type': 'AboutPage', url: abs(path), name: `About ${SITE.name}`,
    about: { '@id': BUSINESS_ID() },
    mainEntity: { '@type': 'Plumber', '@id': BUSINESS_ID(), name: SITE.name, foundingDate: String(SITE.founded), slogan: SITE.tagline,
      founder: { '@type': 'Person', name: SITE.owner } } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
    { '@type': 'ListItem', position: 2, name: 'About', item: abs(path) } ] },
];
---
<Base title="About Mike's Plumbing Services | Riverside, CA"
  description="Meet Mike Navarro and Mike's Plumbing Services: family owned and operated in Riverside, CA since 2025. Friendly. Transparent. Proficient."
  path={path} og="mike-navarro-loading-plumbing-van-riverside" ogAlt="Mike Navarro at his plumbing van in Riverside, CA" jsonld={ld} estimate="/contact">
  <AHero />
  <AQuote />
  <AVan />
  <AWork />
  <AFamily />
  <ANext />
</Base>
<script>import '../components/b3kit/scrub';</script>
