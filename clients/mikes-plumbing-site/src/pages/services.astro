---
// /services: the services hub (Figma 669:539 desktop, 670:4039 mobile; PAGES-COPY section 1). Builder 2.
import Base from '../layouts/Base.astro';
import '../components/services/shared/services.css';
import Hero from '../components/services/Hero.astro';
import FlyerList from '../components/services/FlyerList.astro';
import Drains from '../components/services/Drains.astro';
import Leaks from '../components/services/Leaks.astro';
import Heaters from '../components/services/Heaters.astro';
import House from '../components/services/House.astro';
import Commercial from '../components/services/Commercial.astro';
import Callout from '../components/services/Callout.astro';
import FinalCta from '../components/services/FinalCta.astro';
import { serviceSchema } from '../lib/schema';
import { SITE } from '../data/site';
const description = `Drains, sewer lines, hydro jetting, leaks, water heaters, toilets, sinks and faucets. Family owned in Riverside. Free estimate: ${SITE.phone}.`;
---
<Base title="Plumbing Services Riverside CA | Mike's Plumbing" description={description} path="/services"
  og="mikes-plumbing-flyer-services-list" ogAlt="Mike's Plumbing Services flyer listing his plumbing services in Riverside, CA"
  jsonld={[serviceSchema({ name: 'Plumbing services in Riverside, CA', serviceType: 'Plumbing', path: '/services', description })]}>
  <Hero />
  <FlyerList />
  <Drains />
  <Leaks />
  <Heaters />
  <House />
  <Commercial />
  <Callout />
  <FinalCta />
</Base>
