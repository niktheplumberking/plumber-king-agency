---
// First-visit-per-session intro: a horizon line draws across the Gulf, the coral sun rises with its rays, the wordmark
// comes up, then the sun opens into a growing window that reveals the page. Skipped on in-site navigation, for reduced
// motion, and if scripts fail (3.5 s safety in Base.astro).
const N = 11;
const rays = Array.from({ length: N }, (_, i) => {
  const a = Math.PI * (0.06 + (0.88 * i) / (N - 1));
  const r1 = 122, r2 = i % 2 ? 150 : 170;
  return { x1: 180 - Math.cos(a) * r1, y1: 180 - Math.sin(a) * r1, x2: 180 - Math.cos(a) * r2, y2: 180 - Math.sin(a) * r2 };
});
---
<div class="intro" data-intro-root aria-hidden="true">
  <div class="intro-sky">
    <div class="intro-above">
      <svg class="intro-rays" viewBox="0 0 360 180">{rays.map((l) => <line x1={l.x1.toFixed(1)} y1={l.y1.toFixed(1)} x2={l.x2.toFixed(1)} y2={l.y2.toFixed(1)} />)}</svg>
      <span class="intro-sun"></span>
    </div>
    <span class="intro-horizon"></span>
    <div class="intro-below">
      <p class="intro-word"><span>Plumbing</span> <span class="c-coral">by Paul</span></p>
      <p class="intro-tag">Pinellas with heart</p>
    </div>
  </div>
</div>
<style>
  .intro { display: none; }
  :global(html.intro) .intro { display: block; position: fixed; inset: 0; z-index: 200; pointer-events: none; }
  .intro-sky { --hole: 0px; position: absolute; inset: 0; background: var(--deep);
    -webkit-mask-image: radial-gradient(circle at 50% 50%, transparent calc(var(--hole) - 1px), #000 var(--hole));
    mask-image: radial-gradient(circle at 50% 50%, transparent calc(var(--hole) - 1px), #000 var(--hole)); }
  .intro-above { position: absolute; left: 50%; bottom: 50%; width: min(360px, 78vw); aspect-ratio: 2 / 1; transform: translateX(-50%); overflow: hidden; }
  .intro-rays { position: absolute; inset: 0; width: 100%; height: 100%; }
  .intro-rays line { stroke: var(--sun); stroke-width: 4; stroke-linecap: round; }
  .intro-sun { position: absolute; left: 50%; bottom: 0; width: 62%; aspect-ratio: 2 / 1; margin-left: -31%; border-radius: 999px 999px 0 0; background: var(--coral); transform: translateY(100%); }
  .intro-horizon { position: absolute; left: 8%; right: 8%; top: 50%; height: 3px; margin-top: -1px; border-radius: 3px; background: var(--tide); transform: scaleX(0); }
  .intro-below { position: absolute; left: 0; right: 0; top: 50%; padding-top: 30px; text-align: center; color: var(--shell); }
  .intro-word { font-family: var(--display); font-size: clamp(34px, 6vw, 60px); line-height: 1.1; overflow: hidden; }
  .intro-word span { display: inline-block; transform: translateY(110%); }
  .intro-tag { margin-top: 10px; font-size: 13px; font-weight: 700; letter-spacing: .22em; text-transform: uppercase; color: var(--tide); opacity: 0; }
  /* Start states match the first frame, so nothing shows finished before the script runs. */
  .intro-rays line { stroke-dasharray: 60; stroke-dashoffset: 60; }
</style>
