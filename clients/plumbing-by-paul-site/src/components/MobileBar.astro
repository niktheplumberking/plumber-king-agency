---
import Icon from './Icon.astro';
import { SITE } from '../data/site';
interface Props { estimateHref?: string }
const { estimateHref = '#estimate' } = Astro.props;
---
<nav class="mbar" data-mbar aria-label="Call or get an estimate">
  <a href={SITE.phoneHref} class="mbar-call" data-btn><span class="btn-fill" aria-hidden="true"></span><Icon name="phone" size={20} /><span>Call now</span></a>
  <a href={estimateHref} class="mbar-est" data-btn><span class="btn-fill" aria-hidden="true"></span><Icon name="calendar" size={19} /><span>Free estimate</span></a>
</nav>
<style>
  .mbar { display: none; }
  @media (max-width: 760px) {
    .mbar { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; position: fixed; z-index: 55; left: 0; right: 0; bottom: 0; padding: 10px 12px max(10px, env(safe-area-inset-bottom)); background: var(--deep-3); border-top: 1px solid var(--line-dark); box-shadow: 0 -14px 34px -14px rgba(0,0,0,.55); transform: translateY(110%); transition: transform .5s var(--ease-out); }
    .mbar.is-on { transform: none; }
    .mbar a { position: relative; overflow: hidden; isolation: isolate; display: flex; align-items: center; justify-content: center; gap: 9px; height: 54px; border-radius: 999px; font-family: var(--display); font-size: 18px; white-space: nowrap; }
    .mbar-call { background: var(--coral); color: var(--ink); }
    .mbar-est { color: var(--shell); box-shadow: inset 0 0 0 2px rgba(251,245,233,.85); }
    .mbar .btn-fill { position: absolute; z-index: -1; width: 40px; height: 40px; border-radius: 50%; transform: translate(-50%,-50%) scale(0); background: rgba(255,255,255,.3); }
    :global(body) { padding-bottom: 0; }
    :global(footer.ftr) { padding-bottom: 84px; }
  }
</style>
