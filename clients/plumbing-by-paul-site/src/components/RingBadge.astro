---
// Round "sticker": the mascot from the trucks inside a slowly turning ring of text. Decorative (aria-hidden).
import { Image } from 'astro:assets';
import mascot from '../assets/img/mascot-badge.png';
interface Props { text?: string; size?: number; tone?: 'shell' | 'deep' | 'coral'; class?: string }
const { text = 'Plumbing Pinellas with heart · Family owned · ', size = 168, tone = 'shell', class: cls = '' } = Astro.props;
const uid = 'ring' + Math.random().toString(36).slice(2, 8);
---
<span class={`ring ring-${tone} ${cls}`} style={`--s:${size}px`} aria-hidden="true">
  <svg viewBox="0 0 200 200" class="ring-txt">
    <defs><path id={uid} d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0" /></defs>
    <text><textPath href={`#${uid}`} textLength="484" lengthAdjust="spacing">{text.toUpperCase()}</textPath></text>
  </svg>
  <Image src={mascot} alt="" width={200} height={200} class="ring-face" />
</span>
<style>
  .ring { position: relative; display: grid; place-items: center; width: var(--s); height: var(--s); border-radius: 50%; background: var(--shell); color: var(--ink); box-shadow: 0 18px 40px -18px rgba(4,42,48,.55); }
  .ring-deep { background: var(--deep); color: var(--shell); }
  .ring-coral { background: var(--coral); color: var(--ink); }
  .ring-txt { position: absolute; inset: 0; width: 100%; height: 100%; animation: ring-spin 28s linear infinite; }
  .ring-txt text { font: 700 15.5px var(--body); letter-spacing: .08em; fill: currentColor; }
  .ring-face { width: 56%; height: 56%; border-radius: 50%; object-fit: cover; }
  @keyframes ring-spin { to { transform: rotate(360deg); } }
</style>
