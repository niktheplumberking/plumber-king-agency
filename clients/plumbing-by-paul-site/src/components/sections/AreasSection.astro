---
import Icon from '../Icon.astro';
import Eyebrow from '../Eyebrow.astro';
import Btn from '../Btn.astro';
import AreaMap from './AreaMap.astro';
import { BASE, TOWNS, townHref } from '../../data/towns';
import { SITE } from '../../data/site';
interface Props { eyebrow?: string; line1?: string; line2?: string; lead?: string; focus?: string }
const { eyebrow = 'Where we work', line1 = 'One county.', line2 = 'All of it.', focus = '',
  lead = 'Our shop is on 64th Way N in St. Petersburg, in the middle of the county. From there the trucks cover every town in Pinellas, from Tarpon Springs down to St. Pete Beach.' } = Astro.props;
const places = [BASE, ...TOWNS];
---
<section class="ar section dark">
  <div class="wrap ar-grid">
    <div class="ar-copy">
      <Eyebrow>{eyebrow}</Eyebrow>
      <h2 class="h-display h2" data-split>{line1} <span class="c-coral">{line2}</span></h2>
      <p class="lead ar-lead" data-reveal="up">{lead}</p>
      <ul class="ar-chips" data-stagger="up">
        {places.map((t) => { const h = townHref(t); const on = t.name === focus; return (
          <li>{h && !on
            ? <a href={h} class="ar-chip is-link"><Icon name="pin" size={15} />{t.name}<Icon name="arrow" size={14} class="ar-go" /></a>
            : <span class:list={['ar-chip', { on }]}><Icon name="pin" size={15} />{t.name}</span>}</li>
        ); })}
      </ul>
      <div class="ar-cta" data-reveal="up">
        <Btn href={SITE.phoneHref} icon="phone">Call {SITE.phone}</Btn>
        <p><Icon name="pin" size={16} />{SITE.street}, {SITE.city}, {SITE.region} {SITE.zip}</p>
      </div>
    </div>
    <div class="ar-map" data-reveal="up"><AreaMap focus={focus} /></div>
  </div>
</section>
<style>
  .ar-grid { display: grid; grid-template-columns: 640fr 520fr; gap: clamp(36px, 5vw, 80px); align-items: center; }
  .ar-lead { margin-top: 18px; max-width: 560px; }
  .ar-chips { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }
  .ar-chip { display: inline-flex; align-items: center; gap: 7px; min-height: 44px; padding: 0 16px; border-radius: 999px; border: 1px solid var(--line-dark); font-size: 15px; font-weight: 500; color: var(--on-dark); background: rgba(251,245,233,.04); }
  .ar-chip :global(.icon) { color: var(--tide); }
  .ar-chip.is-link { border-color: var(--tide); font-weight: 600; transition: background .25s, color .25s, transform .3s var(--ease-out); }
  .ar-chip.is-link:hover { background: var(--tide); color: var(--ink); transform: translateY(-2px); }
  .ar-chip.is-link:hover :global(.icon) { color: var(--ink); }
  .ar-chip.on { background: var(--coral); border-color: var(--coral); color: var(--ink); font-weight: 700; }
  .ar-chip.on :global(.icon) { color: var(--ink); }
  .ar-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 24px; margin-top: 34px; }
  .ar-cta p { display: inline-flex; align-items: center; gap: 8px; font-size: 15px; color: var(--on-dark-2); }
  .ar-cta p :global(.icon) { color: var(--tide); flex: none; }
  .ar-map { max-width: 520px; width: 100%; justify-self: end; }
  @media (max-width: 980px) {
    .ar-grid { grid-template-columns: 1fr; }
    .ar-map { justify-self: center; max-width: 460px; }
  }
</style>
