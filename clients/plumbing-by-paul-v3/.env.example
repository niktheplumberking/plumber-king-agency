# Canonical origin. Leave unset to use https://plumbingbypaulllc.com (previews keep the live canonical; they are noindex).
SITE_URL=
# Preview builds are noindex unless this is exactly "false". Set PUBLIC_NOINDEX=false ONLY for the launch build.
PUBLIC_NOINDEX=true
# Form endpoint (POST, multipart/form-data). Unset = forms validate, then go to /thank-you (preview behaviour).
PUBLIC_FORM_ENDPOINT=
# Analytics. None found on Paul's current site (source-site-text); set at launch if Paul has them.
PUBLIC_GTM_ID=
PUBLIC_GA_ID=
