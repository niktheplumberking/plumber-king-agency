---
// B5 Paul and Alycia (Figma B5): text left with a script aside; right, two portrait team cards with opposite tilts that
// overlap by 24 px, name patches over their bottom-left, a tint disc behind; Dorinne's Google line (word for word) below.
import SectionHead from '../ui/SectionHead.astro';
import Button from '../ui/Button.astro';
import TextLink from '../ui/TextLink.astro';
import Img from '../ui/Img.astro';
import Patch from '../ui/Patch.astro';
import Stars from '../ui/Stars.astro';
import GoogleG from '../ui/GoogleG.astro';
import { SITE } from '../../data/site';
const cards = [
  { photo: 'about-paul-portrait-web', alt: 'Portrait of Paul Alves outdoors in a black polo and cap', name: 'Paul Alves', role: 'Owner', patch: 'Paul', deg: -2 },
  { photo: 'about-alycia-portrait-web', alt: 'Portrait of Alycia Hernandez Alves outdoors', name: 'Alycia Hernandez Alves', role: 'Co-owner', patch: 'Alycia', deg: 2 },
];
---
<section class="bo" aria-labelledby="bo-h" data-m-section>
  <div class="wrap bo-in">
    <div class="bo-copy">
      <SectionHead eyebrow="The owners" l1="Meet Paul" l2="and Alycia" id="bo-h" />
      <p class="bo-p" data-t="3">Paul is the face on the truck and still the first to tell you what he'd do if it were his house. Alycia co-owns the company and keeps it running, and if you've called the office there's a good chance you've met her already. They're married, they work together, and somehow that works.</p>
      <div class="bo-row" data-t="3">
        <Button href="#crew" v="sec" arrow magnetic={false}>Meet the crew</Button>
        <TextLink href={SITE.tel} lead="phone" icon={false}>{SITE.phone}</TextLink>
      </div>
      <p class="script bo-sc" aria-hidden="true" data-t="5" data-fx="pop">married, and it works</p>
    </div>
    <div class="bo-side">
      <span class="bo-disc" aria-hidden="true"></span>
      <ul role="list" class="bo-cards" data-t="4" data-stagger>
        {cards.map((c) => (
          <li class="bo-card" style={`--deg:${c.deg}deg`} data-fx="toss">
            <div class="bo-ph"><Img name={c.photo} alt={c.alt} sizes="(min-width: 1024px) 311px, 45vw" widths={[320, 640]} focus="50% 30%" /></div>
            <span class="bo-pw"><Patch name={c.patch} label="Owner" deg={-4} t={false} /></span>
            <p class="bo-n">{c.name}</p>
            <p class="label bo-r">{c.role}</p>
            <span class="bo-tick" aria-hidden="true"></span>
          </li>
        ))}
      </ul>
      <figure class="bo-q" data-t="5">
        <p class="bo-qh"><Stars size={14} /><span class="label">A customer on meeting Paul</span></p>
        <blockquote><p>"Honestly, I was not sure what was going to happen when Paul came today, but I was very pleased he was clean, cut, looking very well mannered I’m very happy now I called your service so when someone’s looking for a plumber, I will definitely recommend your company."</p></blockquote>
        <figcaption><GoogleG size={14} />Dorinne · Google review · a month ago</figcaption>
      </figure>
    </div>
  </div>
</section>
<style>
  .bo { position: relative; background: var(--white); padding: 120px 0 104px; overflow-x: clip; }
  .bo-in { display: grid; grid-template-columns: minmax(0, 460fr) minmax(0, 658fr); column-gap: 82px; align-items: start; }
  .bo-p { margin-top: 24px; font-size: 17px; line-height: 29px; color: var(--slate); }
  .bo-row { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; margin-top: 28px; }
  .bo-sc { margin-top: 40px; font-size: 38px; line-height: 1.1; color: var(--blue); transform: rotate(-5deg); transform-origin: left; }
  .bo-side { position: relative; margin-top: -4px; }
  .bo-disc { position: absolute; left: 158px; top: -56px; width: 420px; height: 420px; border-radius: 50%; background: var(--tint); }
  .bo-cards { position: relative; display: flex; margin: 0; padding: 0 0 0 2px; }
  .bo-card { position: relative; flex: 0 0 335px; padding: 10px 10px 22px; border-radius: 22px; background: var(--white); box-shadow: inset 0 0 0 1px var(--line), var(--sh-3); transform: rotate(var(--deg)); }
  .bo-card + .bo-card { margin-left: -23px; margin-top: 13px; }
  .bo-ph { height: 330px; overflow: hidden; border-radius: 16px; }
  .bo-ph :global(img) { display: block; }
  .bo-pw { position: absolute; left: 14px; top: 300px; }
  .bo-n { margin: 36px 12px 0; font-weight: 800; font-size: 20px; line-height: 24px; }
  .bo-r { margin: 4px 12px 0; color: var(--press); }
  .bo-tick { position: absolute; right: 22px; bottom: 26px; width: 22px; height: 12px; background: linear-gradient(var(--sky) 0 3px, transparent 3px 4.5px, var(--blue) 4.5px 7.5px, transparent 7.5px 9px, var(--navy) 9px 12px); transform: skewX(-20deg); }
  .bo-q { margin: 36px 0 0 -2px; padding: 22px 28px 20px; border-radius: 18px; background: var(--tint); }
  .bo-qh { display: flex; align-items: center; gap: 10px; }
  .bo-qh .label { color: var(--press); font-size: 10px; }
  .bo-q blockquote { margin: 12px 0 0; font-weight: 500; font-size: 15px; line-height: 24px; color: var(--navy); }
  .bo-q figcaption { display: flex; align-items: center; gap: 8px; margin-top: 10px; font-size: 12px; color: var(--slate); }
  @media (max-width: 1279px) { .bo-card { flex-basis: 290px; } .bo-ph { height: 290px; } .bo-pw { top: 266px; } }
  @media (max-width: 1023px) {
    .bo { padding: 56px 0 64px; }
    .bo-in { grid-template-columns: 1fr; row-gap: 36px; }
    .bo-p { margin-top: 18px; font-size: 15px; line-height: 26px; }
    .bo-row, .bo-sc { display: none; }
    .bo-side { padding-top: 0; }
    .bo-disc { left: auto; right: -60px; top: -30px; width: 260px; height: 260px; }
    .bo-card { flex: 0 0 calc(50% + 4px); padding: 6px 6px 14px; border-radius: 16px; }
    .bo-card + .bo-card { margin-left: -8px; margin-top: 8px; }
    .bo-ph { height: 170px; border-radius: 12px; }
    .bo-pw { left: 6px; top: 146px; transform: scale(.6); transform-origin: left top; }
    .bo-n { margin: 24px 6px 0; font-size: 14px; line-height: 18px; }
    .bo-r { margin: 2px 6px 0; font-size: 9px; }
    .bo-tick { display: none; }
    .bo-q { margin-top: 28px; padding: 18px 18px; }
    .bo-q blockquote { font-size: 14px; line-height: 22px; }
  }
</style>
