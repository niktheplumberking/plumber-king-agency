---
// K1 Hero (Figma 432:4882 / mobile 433:8451). Mist wash; copy left, framed office photo on a sky offset block right with two
// OFFICE patches on its lower edge and a floating "A real person picks up" chip. The three contact cards straddle the hero's
// bottom edge. Mobile order: copy, cards (call first), photo.
// STICKY 5: Paul to confirm who is in the photo and which office names go on the patches (Missy, Melissa are from reviews).
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Underline from '../ui/Underline.astro';
import RatingPill from '../ui/RatingPill.astro';
import Chip from '../ui/Chip.astro';
import Img from '../ui/Img.astro';
import Patch from '../ui/Patch.astro';
import Icon from '../ui/Icon.astro';
import TextLink from '../ui/TextLink.astro';
import FlowLines from '../ui/FlowLines.astro';
import { SITE } from '../../data/site';
---
<section class="kh" aria-labelledby="kh-h" data-m-section data-m-hero>
  <FlowLines variant="hero" class="fl-d" />
  <FlowLines variant="heroM" class="fl-m" />
  <div class="wrap kh-in">
    <div class="kh-copy">
      <Breadcrumbs items={[{ label: 'Contact', href: '/contact' }]} />
      <Eyebrow text="Contact" class="kh-eb" />
      <h1 class="h1 kh-h" id="kh-h" data-t="2"><span class="hl">Talk to a</span> <span class="hl">real person</span> <span class="hl l2"><span class="ul-wrap">at Paul's<Underline class="ul" w={372} /></span></span></h1>
      <p class="lead kh-lead" data-t="3" data-fx="nudge">No phone tree, no call center. The people in this photo answer the phone.</p>
      <div class="kh-proof" data-t="3"><RatingPill /><Chip icon="badge" v="white">Lic. {SITE.licence}</Chip></div>
    </div>
    <div class="kh-media">
      <span class="kh-blk" aria-hidden="true"></span>
      <div class="kh-frame frame" data-t="4" data-fx="frame">
        <Img name="office-team-with-paul" alt="The office team with Paul at the shop, in front of the Plumbing By Paul logo wall" sizes="(min-width: 1024px) 460px, calc(100vw - 52px)" focus="50% 30%" priority widths={[460, 700, 920]} />
      </div>
      <p class="kh-chip" data-t="5" data-fx="pop"><span class="kc-i"><Icon name="phone" size={16} /></span><span><b>A real person picks up</b><small class="label">No phone tree</small></span></p>
      <Patch name="Missy" label="OFFICE" deg={-4} class="kh-p1" />
      <Patch name="Melissa" label="OFFICE" deg={3} class="kh-p2" />
    </div>
    <ul role="list" class="kh-cards" data-t="4" data-stagger>
      <li class="kc kc-call">
        <span class="kc-ic pri"><Icon name="phone" size={24} /></span>
        <div class="kc-b">
          <p class="kc-t">Call us</p>
          <a class="kc-ph num" href={SITE.tel}>{SITE.phone}</a>
          <p class="kc-d">{SITE.hours.office}</p>
        </div>
        <span class="kc-open" data-open-now hidden><i aria-hidden="true"></i><span data-open-text>Open now</span></span>
      </li>
      <li class="kc">
        <span class="kc-ic"><Icon name="clipboard" size={24} /></span>
        <div class="kc-b">
          <h2 class="kc-t">Request an estimate</h2>
          <p class="kc-d">Fill in the form below. We call you back.</p>
          <TextLink href="#request" icon="down" size={15}>Go to the form</TextLink>
        </div>
      </li>
      <li class="kc">
        <span class="kc-ic"><Icon name="pin" size={24} /></span>
        <div class="kc-b">
          <h2 class="kc-t">Come by the shop</h2>
          <p class="kc-d">{SITE.address.street}, {SITE.address.city}</p>
          <TextLink href={SITE.google.mapsUrl} icon="external" size={15} external>Open in Google Maps</TextLink>
        </div>
      </li>
    </ul>
  </div>
</section>
<script>
  // "Open now" only when the shop is open (every day 8 AM to 5 PM, St. Petersburg time). Closed: says when it opens.
  const el = document.querySelector<HTMLElement>('[data-open-now]');
  if (el) {
    const h = Number(new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', hour: 'numeric', hourCycle: 'h23' }).format(new Date()));
    const open = h >= 8 && h < 17;
    const t = el.querySelector('[data-open-text]');
    if (t && !open) { t.textContent = 'Opens 8 AM'; el.classList.add('closed'); }
    el.hidden = false;
  }
</script>
<style>
  .kh { position: relative; z-index: 3; overflow-x: clip; background: linear-gradient(180deg, var(--mist), var(--white) 92%); padding: 40px 0 0; }
  .kh :global(.fl-m) { display: none; }
  .kh-in { position: relative; z-index: 2; display: grid; grid-template-columns: minmax(0, 1fr) 486px; column-gap: 40px; }
  .kh-copy { padding-bottom: 40px; }
  .kh :global(.kh-eb) { margin-top: 20px; }
  .kh-h { margin-top: 16px; font-size: var(--fz-h1); line-height: 1.067; letter-spacing: -0.025em; }
  .hl { display: block; }
  .ul-wrap { position: relative; display: inline-block; }
  .ul-wrap :global(.ul) { position: absolute; left: 2px; bottom: -8px; width: calc(100% + 4px); }
  .kh-lead { margin-top: 30px; max-width: 500px; font-size: 18px; line-height: 30px; }
  .kh-proof { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 28px; }
  .kh-media { position: relative; width: 460px; height: 400px; margin: 24px 0 0 auto; }
  .kh-blk { position: absolute; inset: 26px -26px -26px 26px; border-radius: 40px; background: var(--sky); }
  .kh-frame { position: absolute; inset: 0; border-radius: 40px; box-shadow: 0 0 0 6px var(--white), var(--sh-3); }
  .kh-chip { position: absolute; left: -80px; top: 54px; z-index: 3; display: flex; align-items: center; gap: 10px; height: 52px; padding: 0 16px 0 12px; border-radius: 14px; background: var(--white); box-shadow: var(--sh-2); }
  .kc-i { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: var(--tint); color: var(--blue); }
  .kh-chip b { display: block; font-size: 13px; line-height: 16px; }
  .kh-chip small { display: block; font-size: 10px; line-height: 14px; color: var(--press); }
  .kh-media :global(.kh-p1), .kh-media :global(.kh-p2) { position: absolute; z-index: 3; }
  .kh-media :global(.kh-p1) { left: 26px; bottom: -36px; }
  .kh-media :global(.kh-p2) { left: 202px; bottom: -42px; }

  .kh-cards { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin: 72px 0 -75px; padding: 0; position: relative; z-index: 4; }
  .kc { position: relative; display: flex; align-items: flex-start; gap: 18px; min-height: 150px; padding: 28px 24px; border-radius: 20px; background: var(--white); box-shadow: inset 0 0 0 1px var(--line), var(--sh-2); }
  .kc-call { box-shadow: inset 0 0 0 1px var(--line), var(--sh-stripe); padding-top: 34px; }
  .kc-call::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 6px; border-radius: 20px 20px 0 0; background: var(--sky); }
  .kc-ic { display: grid; place-items: center; width: 56px; height: 56px; flex: none; border-radius: 50%; background: var(--tint); color: var(--blue); }
  .kc-ic.pri { background: var(--press); color: var(--white); }
  .kc-b { display: grid; gap: 4px; min-width: 0; }
  .kc-t { font-weight: 700; font-size: 18px; line-height: 24px; color: var(--navy); }
  .kc-call .kc-t { font-size: 16px; line-height: 20px; }
  .kc-ph { font-size: 28px; line-height: 34px; color: var(--press); text-decoration: none; }
  .kc-d { font-size: 14px; line-height: 21px; color: var(--slate); }
  .kc-call .kc-d { font-weight: 500; font-size: 13px; line-height: 18px; }
  .kc-b :global(.tlink) { margin-top: 8px; justify-self: start; }
  .kc-open { position: absolute; right: 20px; top: 22px; display: inline-flex; align-items: center; gap: 6px; height: 28px; padding: 0 10px; border-radius: 999px; background: var(--tint); font-weight: 700; font-size: 12px; color: var(--navy); }
  .kc-open i { position: relative; width: 12px; height: 12px; border-radius: 50%; background: rgba(97,173,203,.35); }
  .kc-open i::after { content: ''; position: absolute; inset: 3px; border-radius: 50%; background: var(--blue); }
  .kc-open.closed i::after { background: var(--soft); }

  @media (max-width: 1199px) { .kh-in { grid-template-columns: minmax(0, 1fr) 420px; } .kh-media { width: 400px; height: 360px; } .kh-media :global(.kh-p2) { left: 170px; } .kh-chip { left: -40px; } }
  @media (max-width: 1023px) {
    .kh { padding: 20px 0 0; }
    .kh :global(.fl-d) { display: none; } .kh :global(.fl-m) { display: block; }
    .kh-in { grid-template-columns: minmax(0, 1fr); }
    .kh-copy { padding-bottom: 0; }
    .kh :global(.kh-eb) { margin-top: 14px; }
    .kh-h { margin-top: 10px; }
    .ul-wrap :global(.ul) { bottom: -6px; }
    .kh-lead { margin-top: 22px; font-size: 16px; line-height: 26px; }
    .kh-proof { display: none; }
    .kh-cards { grid-template-columns: minmax(0, 1fr); gap: 12px; margin: 26px 0 0; }
    .kc { min-height: 0; padding: 22px 16px; gap: 14px; }
    .kc-call { padding-top: 28px; }
    .kc-ic { width: 46px; height: 46px; }
    .kc-ph { font-size: 24px; line-height: 30px; }
    .kc-t { font-size: 16px; line-height: 22px; }
    .kc-d { font-size: 13px; line-height: 19px; }
    .kc-open { right: 14px; top: 16px; }
    .kh-media { order: 3; width: calc(100% - 26px); height: auto; aspect-ratio: 300 / 262; margin: 44px 0 64px 0; }
    .kh-blk { inset: 14px -14px -14px 14px; border-radius: 28px; }
    .kh-frame { border-radius: 28px; }
    .kh-chip { left: 10px; top: -18px; height: 36px; padding: 0 12px 0 8px; gap: 6px; }
    .kc-i { width: 22px; height: 22px; background: none; }
    .kh-chip small { display: none; }
    .kh-chip b { font-size: 12px; }
    .kh-media :global(.patch) { zoom: .78; }
    .kh-media :global(.kh-p1) { left: 14px; bottom: -34px; }
    .kh-media :global(.kh-p2) { left: auto; right: -6px; bottom: -36px; }
  }
</style>
