---
// Waterline CTA, phone-first variant for /contact (Figma ctaPhone, 432:4882): no form (the full form is above). Navy top,
// drifting water, "The office line" card on the waterline (day circles M to S, Open now), seal on its corner.
// Kept in contact/ so the shared WaterlineCTA stays untouched. STICKY 1: hours (8 to 5 daily vs a 24/7 line).
import Eyebrow from '../ui/Eyebrow.astro';
import Icon from '../ui/Icon.astro';
import Seal from '../ui/Seal.astro';
import CallButton from '../ui/CallButton.astro';
import Button from '../ui/Button.astro';
import GoogleG from '../ui/GoogleG.astro';
import FlowLines from '../ui/FlowLines.astro';
import Water from '../ui/Water.astro';
import Swoosh from '../ui/Swoosh.astro';
import { SITE } from '../../data/site';
interface Props { l1?: string; l2?: string; lead?: string; back?: string; backHref?: string; }
const { l1 = 'Easier to just talk?', l2 = `Call ${SITE.phone}.`, lead = 'A real person at our St. Pete shop picks up. No phone tree, no call center.', back = 'Back to the form', backHref = '#request' } = Astro.props;
const days = [['M', 'Monday'], ['T', 'Tuesday'], ['W', 'Wednesday'], ['T', 'Thursday'], ['F', 'Friday'], ['S', 'Saturday'], ['S', 'Sunday']];
const facts = [
  { icon: 'clock', a: 'Open 7 days', b: '8 AM to 5 PM', m: SITE.hours.line },
  { icon: 'badge', a: 'Licensed', b: `Lic. ${SITE.licence}`, m: `Lic. ${SITE.licence}` },
  { icon: 'g', a: `${SITE.rating.value} on Google`, b: `from ${SITE.rating.count} reviews`, m: `${SITE.rating.value} from ${SITE.rating.count} Google reviews` },
];
---
<section class="pc on-navy" aria-labelledby="pc-h" data-m-section>
  <FlowLines variant="cta" />
  <Water class="pc-water" />
  <div class="wrap pc-in">
    <div class="pc-copy">
      <Eyebrow text="Ready when you are" dark />
      <h2 class="h2 sz-cta" id="pc-h" data-t="2"><span class="l1">{l1}</span> <span class="l2">{l2}</span></h2>
      <p class="lead" data-t="3">{lead}</p>
      <div class="pc-btns" data-t="3" data-stagger>
        <CallButton v="priN" l2="Tap to call · a real person answers" />
        <Button href={backHref} v="secN" h64>{back}</Button>
      </div>
      <ul role="list" class="pc-facts" data-t="5" data-stagger>
        {facts.map((f) => (
          <li><span class="fi">{f.icon === 'g' ? <GoogleG size={20} /> : <Icon name={f.icon} size={20} />}</span>
            <span class="fd"><b>{f.a}</b><small>{f.b}</small></span><span class="fm">{f.m}</span></li>
        ))}
      </ul>
    </div>
    <div class="pc-card" data-t="4">
      <div class="olc">
        <p class="olc-top"><span class="label">The office line</span><span class="olc-open" data-open-now2 hidden><i aria-hidden="true"></i><span data-open-text>Open now</span></span></p>
        <a class="olc-ph num" href={SITE.tel}>{SITE.phone}</a>
        <p class="olc-h">{SITE.hours.office}</p>
        <ul role="list" class="olc-days" aria-label="Open Monday to Sunday">{days.map(([d, full]) => <li title={full}><span aria-hidden="true">{d}</span><span class="sr-only">{full}</span></li>)}</ul>
        <ul role="list" class="olc-notes">
          <li><span class="ni"><Icon name="users" size={18} /></span>A real person at our St. Pete shop picks up.</li>
          <li><span class="ni"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H10l-4.5 4v-4h0A1.5 1.5 0 0 1 4 14.5z" /></svg></span>Not sure what it's called? Tell us what you see. We'll know.</li>
        </ul>
        <Button href={SITE.tel} icon="phone" block>Call {SITE.phone}</Button>
      </div>
      <Seal d={120} deg={8} class="pc-seal" />
    </div>
  </div>
  <Swoosh class="pc-sw" h={110} above="transparent" />
</section>
<script>
  const el = document.querySelector<HTMLElement>('[data-open-now2]');
  if (el) {
    const h = Number(new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', hour: 'numeric', hourCycle: 'h23' }).format(new Date()));
    const t = el.querySelector('[data-open-text]');
    if (t && !(h >= 8 && h < 17)) { t.textContent = 'Opens 8 AM'; el.classList.add('closed'); }
    el.hidden = false;
  }
</script>
<style>
  .pc { position: relative; overflow: hidden; background: linear-gradient(var(--navy) 0 0) top / 100% 56% no-repeat, var(--sky); color: var(--white); padding: 92px 0 0; }
  .pc :global(.flow) { height: 62%; }
  .pc :global(.pc-water) { top: calc(56% - 28px); }
  .pc-in { position: relative; z-index: 2; display: grid; grid-template-columns: minmax(0, 1fr) 448px; gap: 48px; align-items: start; }
  .pc-copy { display: grid; gap: 16px; justify-items: start; }
  .pc-copy .h2 .l1, .pc-copy .h2 .l2 { display: block; }
  .pc-copy .lead { max-width: 560px; margin-top: 4px; }
  .pc-btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 12px; }
  .pc-facts { display: flex; flex-wrap: wrap; gap: 12px; margin: 96px 0 0; padding: 0; }
  .pc-facts li { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-radius: 14px; background: rgba(255,255,255,.92); color: var(--navy); }
  .fi { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 10px; background: var(--tint); color: var(--blue); flex: none; }
  .fd { display: grid; } .fd b { font-weight: 700; font-size: 15px; line-height: 20px; } .fd small { font-weight: 500; font-size: 13px; line-height: 18px; color: var(--slate); }
  .fm { display: none; }
  .pc-card { position: relative; margin-top: -12px; }
  .pc-card :global(.pc-seal) { position: absolute; right: -46px; top: -54px; z-index: 3; }
  .olc { position: relative; display: grid; gap: 14px; padding: 32px; border-radius: var(--r-lg); background: var(--white); color: var(--navy); box-shadow: var(--sh-stripe); }
  .olc::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 6px; border-radius: 20px 20px 0 0; background: var(--sky); }
  .olc-top { display: flex; align-items: center; gap: 10px; }
  .olc-top .label { color: var(--press); font-size: 13px; }
  .olc-open { display: inline-flex; align-items: center; gap: 6px; height: 26px; padding: 0 10px; border-radius: 999px; background: var(--tint); font-weight: 700; font-size: 12px; color: var(--navy); }
  .olc-open i { position: relative; width: 12px; height: 12px; border-radius: 50%; background: rgba(97,173,203,.35); }
  .olc-open i::after { content: ''; position: absolute; inset: 3px; border-radius: 50%; background: var(--blue); }
  .olc-open.closed i::after { background: var(--soft); }
  .olc-ph { font-size: 40px; line-height: 46px; color: var(--press); text-decoration: none; }
  .olc-h { font-weight: 700; font-size: 16px; line-height: 22px; }
  .olc-days { display: flex; gap: 10px; margin: 2px 0 0; padding: 0 0 18px; border-bottom: 1px solid var(--line); }
  .olc-days li { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--sky); color: var(--navy); font-family: var(--f-num); font-size: 13px; }
  .olc-notes { display: grid; gap: 14px; margin: 4px 0 6px; padding: 0; }
  .olc-notes li { display: flex; align-items: flex-start; gap: 12px; font-weight: 500; font-size: 14px; line-height: 20px; color: var(--slate); }
  .ni { display: grid; place-items: center; width: 32px; height: 32px; flex: none; border-radius: 8px; background: var(--tint); color: var(--blue); }
  .pc :global(.pc-sw) { position: relative; z-index: 1; margin-top: 70px; }
  @media (max-width: 1199px) { .pc-in { grid-template-columns: minmax(0, 1fr) 400px; gap: 32px; } .pc-card :global(.pc-seal) { right: -10px; } .olc-days { gap: 6px; } }
  @media (max-width: 1023px) {
    .pc { padding-top: 64px; background: linear-gradient(var(--navy) 0 0) top / 100% 44% no-repeat, var(--sky); }
    .pc :global(.pc-water) { top: calc(44% - 28px); }
    .pc-in { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    .pc-copy { display: contents; }
    .pc-copy > :global(*) { justify-self: start; }
    .pc-btns { display: grid; width: 100%; gap: 10px; margin-top: 0; }
    .pc-btns :global(.btn) { width: 100%; }
    .pc-btns :global(.btn-secN) { min-height: 56px; }
    .pc-facts { order: 3; display: grid; width: 100%; margin: 0; gap: 8px; }
    .pc-card { order: 2; margin-top: 16px; }
    .pc-card :global(.pc-seal) { --d: 72px !important; right: -6px; top: -32px; }
    .olc { padding: 26px 18px 20px; gap: 12px; }
    .olc-ph { font-size: 30px; line-height: 36px; }
    .olc-h { font-size: 14px; }
    .olc-days { justify-content: space-between; gap: 4px; }
    .olc-days li { width: 34px; height: 34px; font-size: 12px; }
    .olc-notes li { font-size: 13px; line-height: 19px; }
    .pc-facts li { padding: 8px 12px; gap: 10px; border-radius: 10px; }
    .pc-facts .fi { width: auto; height: auto; background: none; }
    .fd { display: none; } .fm { display: block; font-weight: 700; font-size: 14px; }
    .pc :global(.pc-sw) { margin-top: 40px; }
  }
</style>
