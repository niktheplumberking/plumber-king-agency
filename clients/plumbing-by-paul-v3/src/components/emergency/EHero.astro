---
// E1 Hero (Figma 433:9350 desktop / 439:3279 mobile): the only navy hero on the site. Full-bleed van photo under navy
// scrims, H1 white + sky, the white call card overlapping the hero's bottom edge, a big swoosh across the join.
// STICKY 1 (hours): if Paul confirms 24/7 the eyebrow becomes "24/7 EMERGENCY PLUMBING".
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Img from '../ui/Img.astro';
import Icon from '../ui/Icon.astro';
import Swoosh from '../ui/Swoosh.astro';
import Seal from '../ui/Seal.astro';
import RatingPill from '../ui/RatingPill.astro';
import Chip from '../ui/Chip.astro';
import { SITE } from '../../data/site';
---
<section class="eh on-navy" aria-labelledby="eh-h" data-m-section data-m-hero>
  <div class="eh-top">
  <div class="eh-ph" data-t="4" data-fx="frame">
    <Img name="fleet-van-street-4284px" alt="The wrapped Plumbing By Paul van parked on a residential street" sizes="(min-width: 1024px) 70vw, 100vw" focus="50% 52%" priority widths={[480, 800, 1100, 1500, 2000]} data-parallax="0.06" />
  </div>
  <div class="wrap eh-in">
    <Breadcrumbs items={[{ label: 'Emergency plumbing', href: '/emergency-plumbing' }]} dark class="eh-crumbs" />
    <Eyebrow text="Emergency plumbing · St. Petersburg and Pinellas" dark dot class="eh-eb eh-ebd" />
    <Eyebrow text="Emergency plumbing · Pinellas" dark dot class="eh-eb eh-ebm" t={false} />
    <h1 class="display eh-h1" id="eh-h" data-t="2">
      <span class="hl">Burst pipe?</span>
      <span class="hl">Backed-up sewer?</span>
      <span class="hl l2">Call Paul now.</span>
    </h1>
    <p class="lead eh-lead" data-t="3" data-fx="nudge">First, shut off the water at the main valve by your meter. Then call. We'll talk you through the rest while a truck heads your way.</p>
  </div>
  <p class="eh-chip" data-t="5" data-fx="pop">
    <span class="ec-i"><Icon name="siren" size={18} /></span>
    <span><b>Water where it shouldn't be?</b><small class="label">Shut it off, then call</small></span>
  </p>
  <Swoosh class="eh-sw" below="#FFFFFF" />
  </div>
  <div class="wrap eh-cardrow">
    <div class="eh-card" data-t="3">
      <div class="ec-txt">
        <p class="label ec-l">Emergency line</p>
        <a href={SITE.tel} class="num ec-ph">{SITE.phone}</a>
        <p class="ec-d">A real person answers. Tell them it's an emergency.</p>
      </div>
      <a href={SITE.tel} class="btn ec-btn" data-magnetic><Icon name="phone" size={20} /><span>Call now</span></a>
      <Seal d={84} deg={8} class="ec-seal" />
    </div>
    <div class="eh-under" data-t="5" data-stagger>
      <RatingPill />
      <Chip icon="badge">Lic. {SITE.licence}</Chip>
    </div>
  </div>
</section>
<style>
  .eh { position: relative; z-index: 2; background: var(--white); }
  .eh-top { position: relative; background: var(--navy); color: var(--white); padding-top: 64px; }
  .eh-ph { position: absolute; top: 0; right: 0; width: 69.5%; height: 574px; overflow: hidden; }
  .eh-ph :global(img) { transform: scale(1.08); }
  .eh-ph::before, .eh-ph::after { content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none; }
  .eh-ph::before { background: linear-gradient(90deg, var(--navy) 0%, rgba(17,16,50,.5) 42%, rgba(17,16,50,.08) 100%); }
  .eh-ph::after { bottom: auto; height: 170px; background: linear-gradient(rgba(17,16,50,.85), rgba(17,16,50,0)); }
  .eh-in { position: relative; z-index: 2; display: grid; justify-items: start; }
  .eh-in :global(.eh-eb) { margin-top: 22px; }
  .eh-in :global(.eh-ebm) { display: none; }
  .eh-h1 { margin-top: 18px; max-width: 600px; color: var(--white); line-height: 1.0667; }
  .hl { display: block; } .hl.l2 { color: var(--sky); }
  .eh-lead { margin-top: 20px; max-width: 560px; color: var(--tint); }
  .eh-chip { position: absolute; z-index: 3; top: 36px; right: max(var(--gutter), calc((100% - 1200px) / 2)); display: flex; align-items: center; gap: 10px; height: 52px; padding: 0 14px; border-radius: 14px; background: var(--white); color: var(--navy); box-shadow: var(--sh-2); }
  .ec-i { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: var(--tint); color: var(--blue); }
  .eh-chip b { display: block; font-weight: 700; font-size: 13px; line-height: 16px; }
  .eh-chip small { display: block; font-size: 10px; letter-spacing: .08em; color: var(--press); }
  .eh :global(.eh-sw) { position: relative; z-index: 1; margin-top: 10px; margin-bottom: -1px; }
  .eh-cardrow { position: relative; z-index: 3; margin-top: -86px; }
  .eh-card { position: relative; display: block; width: 588px; max-width: 100%; min-height: 150px; padding: 26px 28px 24px; border-radius: var(--r-lg); background: var(--white); color: var(--navy); box-shadow: inset 0 0 0 1px var(--line), var(--sh-stripe); }
  .eh-card::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 6px; border-radius: var(--r-lg) var(--r-lg) 0 0; background: var(--sky); }
  .ec-l { color: var(--press); font-size: 12px; }
  .ec-ph { display: block; margin-top: 4px; font-size: 40px; line-height: 46px; color: var(--navy); letter-spacing: -.01em; white-space: nowrap; }
  .ec-d { margin-top: 10px; font-weight: 500; font-size: 14px; line-height: 20px; color: var(--slate); }
  .ec-btn { position: absolute; right: 28px; top: 40px; width: 156px; padding: 0 20px; }
  .eh-card :global(.ec-seal) { position: absolute; right: -36px; top: -44px; }
  .eh-under { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 20px; }
  .eh-under :global(.chip) { min-height: 40px; }
  @media (max-width: 1023px) {
    .eh-top { padding-top: 0; }
    .eh-ph { position: relative; width: 100%; height: 250px; }
    .eh-ph::before { background: linear-gradient(180deg, rgba(17,16,50,.25) 0%, rgba(17,16,50,.35) 45%, var(--navy) 100%); }
    .eh-ph::after { height: 110px; background: linear-gradient(rgba(17,16,50,.7), rgba(17,16,50,0)); }
    .eh-in { margin-top: -250px; }
    .eh-in :global(.eh-crumbs) { margin-top: 36px; }
    .eh-in :global(.eh-eb) { margin-top: 158px; }
    .eh-in :global(.eh-ebd) { display: none; } .eh-in :global(.eh-ebm) { display: flex; }
    .eh-h1 { margin-top: 12px; font-size: 34px; line-height: 38px; letter-spacing: -.02em; }
    .eh-lead { margin-top: 16px; font-size: 16px; line-height: 26px; }
    .eh-chip { display: none; }
    .eh :global(.eh-sw) { margin-top: 36px; height: 64px; }
    .eh-cardrow { margin-top: -50px; }
    .eh-card { display: grid; gap: 16px; width: 100%; padding: 22px 20px 20px; }
    .ec-ph { font-size: 36px; line-height: 42px; }
    .ec-btn { position: static; width: 100%; min-height: 60px; margin: 0; }
    .eh-card :global(.ec-seal) { --d: 64px !important; right: -6px; top: -36px; }
    .eh-under { margin-top: 24px; gap: 8px; }
  }
</style>
