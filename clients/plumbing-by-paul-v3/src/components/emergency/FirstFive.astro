---
// E2 The first five minutes (Figma 433:9390 / 439:3304): numbered rail of four steps over a pipe run, Yellowtail numeral
// stickers on each card's top-left. Steps 1 to 3 are from Paul's own FAQ (PAUL TO CONFIRM the wording). Emits HowTo JSON-LD for the four steps.
import SectionHead from '../ui/SectionHead.astro';
import TextLink from '../ui/TextLink.astro';
import Icon from '../ui/Icon.astro';
import NumSticker from './NumSticker.astro';
import { SITE } from '../../data/site';
const FIRST_FIVE = [
  { t: 'Shut off the water.', d: 'The main valve is usually outside, near your water meter. Turn it clockwise until it stops.', i: 'droplets' },
  { t: 'Stay away from electrics.', d: "If water is near outlets or the breaker panel, keep clear and don't touch anything electrical.", i: 'zap' },
  { t: 'Open a tap.', d: "With the main off, run a faucet to drain what's left in the pipes.", i: 'drop' },
  { t: `Call ${SITE.phone}.`, d: "Tell us what you see. We'll tell you what to do next.", i: 'phone' },
];
const howTo = { '@context': 'https://schema.org', '@type': 'HowTo', name: 'What to do in the first five minutes of a plumbing emergency', step: FIRST_FIVE.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.t, text: s.d })) };
---
<section class="ff" aria-labelledby="ff-h" data-m-section>
  <div class="wrap ff-head">
    <SectionHead eyebrow="Before we get there" l1="What to do in" l2="the first five minutes" id="ff-h" />
    <TextLink href="#em-faq" class="ff-link" data-t="3" data-no-curtain>What counts as an emergency?</TextLink>
  </div>
  <div class="wrap ff-stage">
    <span class="ff-pipe" aria-hidden="true"><span></span></span>
    <ol role="list" class="ff-list" data-t="4" data-stagger>
      {FIRST_FIVE.map((s, i) => (
        <li class:list={['ff-card', i === 3 && 'nv']}>
          <NumSticker n={i + 1} v={i === 3 ? 'sky' : 'white'} class="ff-num" t={false} />
          <span class="well well-round ff-ic"><Icon name={s.i} size={22} /></span>
          <h3 class="ff-t"><span class="sr-only">Step {i + 1}: </span>{s.t}</h3>
          <p class="ff-d">{s.d}</p>
          {i === 3
            ? <a href={SITE.tel} class="btn btn-priN btn-block ff-call"><Icon name="phone" size={20} /><span>Call now</span></a>
            : <p class="label ff-step" aria-hidden="true">Step {i + 1} of 4</p>}
        </li>
      ))}
    </ol>
  </div>
</section>
<script type="application/ld+json" set:html={JSON.stringify(howTo)} />
<style>
  .ff { position: relative; background: var(--white); padding: 52px 0 112px; }
  .ff-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; }
  .ff-head :global(.ff-link) { margin-bottom: 4px; }
  .ff-stage { position: relative; margin-top: 72px; }
  .ff-pipe { position: absolute; left: calc(-1 * max(var(--gutter), (100vw - 1200px) / 2)); right: calc(-1 * max(var(--gutter), (100vw - 1200px) / 2)); top: 115px; height: 14px; border-radius: 7px; background: var(--navy); }
  .ff-pipe span { position: absolute; inset: 2px; border-radius: 5px; background: var(--sky); }
  .ff-pipe span::after { content: ''; position: absolute; left: 4px; right: 4px; top: 2px; height: 2px; border-radius: 1px; background: rgba(255,255,255,.55); }
  .ff-list { position: relative; display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin: 0; padding: 0; }
  .ff-card { position: relative; display: flex; flex-direction: column; min-height: 252px; padding: 68px 24px 22px; border-radius: var(--r-lg); background: var(--white); box-shadow: inset 0 0 0 1px var(--line), var(--sh-1); transition: transform .5s var(--ease-out), box-shadow .5s var(--ease-out); }
  .ff-card:hover { transform: translateY(-4px); box-shadow: inset 0 0 0 1px var(--line), var(--sh-2); }
  .ff-card.nv { background: var(--navy); color: var(--white); box-shadow: var(--sh-3); }
  .ff-card :global(.ff-num) { position: absolute; left: -2px; top: -36px; }
  .ff-ic { position: absolute; right: 24px; top: 20px; }
  .nv .ff-ic { background: var(--navy-2); color: var(--sky); }
  .ff-t { font-weight: 700; font-size: 20px; line-height: 26px; }
  .ff-d { margin-top: 8px; font-size: 15px; line-height: 23px; color: var(--slate); }
  .nv .ff-d { color: var(--tint); }
  .ff-step { margin-top: auto; padding-top: 16px; color: var(--press); }
  .ff-call { margin-top: auto; min-height: 52px; }
  @media (max-width: 1199px) { .ff-list { gap: 16px; } .ff-card { padding-inline: 18px; } }
  @media (max-width: 1023px) {
    .ff { padding: 40px 0 64px; }
    .ff-head { display: block; }
    .ff-head :global(.ff-link) { display: none; }
    .ff-stage { margin-top: 36px; }
    .ff-pipe { left: 16px; right: auto; top: 30px; bottom: 120px; width: 14px; height: auto; }
    .ff-list { grid-template-columns: 1fr; gap: 14px; padding-left: 62px; }
    .ff-card { min-height: 0; padding: 18px 18px 20px; }
    .ff-card :global(.ff-num) { --d: 48px !important; left: -64px; top: 6px; }
    .ff-ic, .ff-step { display: none; }
    .ff-t { font-size: 17px; line-height: 22px; }
    .ff-d { margin-top: 6px; font-size: 14px; line-height: 21px; }
    .ff-call { margin-top: 16px; }
  }
</style>
