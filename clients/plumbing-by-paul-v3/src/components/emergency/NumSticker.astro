---
// Numeral sticker (Figma lib.js numS): a round white sticker with a sky rim and a Yellowtail numeral. Tier 5 by default.
// v="sky" = sky disc, navy numeral (used on the navy card).
interface Props { n: string | number; d?: number; deg?: number; v?: 'white' | 'sky'; class?: string; t?: string | false; }
const { n, d = 64, deg = -6, v = 'white', class: cls, t = '5' } = Astro.props;
---
<span class:list={['nst', v, cls]} style={`--d:${d}px;--deg:${deg}deg`} data-t={t === false ? undefined : t} data-fx="pop" aria-hidden="true">{n}</span>
<style>
  .nst { display: grid; place-items: center; width: var(--d); height: var(--d); border-radius: 50%; background: var(--white); box-shadow: inset 0 0 0 2px var(--sky), var(--sh-sticker); transform: rotate(var(--deg)); font-family: var(--f-script); font-size: calc(var(--d) * .62); line-height: 1; color: var(--blue); padding-top: .06em; flex: none; }
  .sky { background: var(--sky); color: var(--navy); box-shadow: inset 0 0 0 2px var(--white), var(--sh-sticker); }
</style>
