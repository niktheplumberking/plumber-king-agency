---
// Page-transition curtain for in-site navigation (MOTION.md "Curtain"): a navy panel with the swoosh on its top edge rises
// over the page, the next page lowers it away and plays its hero. Skipped for reduced motion, new tabs, modified clicks.
import Tick from '../ui/Tick.astro';
import Swoosh from '../ui/Swoosh.astro';
---
<div class="pt" data-pt aria-hidden="true">
  <div class="pt-panel">
    <Swoosh class="pt-edge" below="#111032" h={120} draw={false} />
    <span class="pt-mark"><Tick dark scale={1.6} /><span class="script">by Paul</span></span>
  </div>
</div>
<style>
  .pt { position: fixed; inset: 0; z-index: var(--z-curtain); pointer-events: none; visibility: hidden; }
  .pt.is-on, :global(html.pt-in) .pt { visibility: visible; }
  .pt-panel { position: absolute; inset: 0; background: var(--navy); transform: translateY(105%); will-change: transform; }
  :global(html.pt-in) .pt-panel { transform: none; }
  .pt-panel :global(.pt-edge) { position: absolute; left: 0; bottom: calc(100% - 2px); width: 100%; height: clamp(64px, 8.3vw, 120px); }
  .pt-mark { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; gap: 14px; color: var(--white); font-size: 54px; }
</style>
