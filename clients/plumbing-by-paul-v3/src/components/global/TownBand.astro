---
// Town band: sky strip, one line of towns separated by droplets, slow marquee that pauses on hover and speeds with scroll
// (data-marquee). The 48-56 px seal is pinned at the left end over the band's top edge. Static list without JS / reduced motion.
import Icon from '../ui/Icon.astro';
import Seal from '../ui/Seal.astro';
import { TOWN_BAND } from '../../data/towns';
const items = [...TOWN_BAND, 'Plumbing Pinellas|with Heart'];
---
<div class="tband" data-m-section>
  <Seal d={56} deg={-6} class="tb-seal" />
  <div class="tb-clip" data-marquee>
    <ul role="list" class="tb-track" aria-label="Towns we serve across Pinellas County">
      {items.map((t) => (
        <li>{t.includes('|') ? <span class="pp">{t.split('|')[0]} <span class="script">{t.split('|')[1]}</span></span> : t}<Icon name="drop" size={13} /></li>
      ))}
    </ul>
    <ul role="list" class="tb-track" aria-hidden="true">
      {items.map((t) => (
        <li>{t.includes('|') ? <span class="pp">{t.split('|')[0]} <span class="script">{t.split('|')[1]}</span></span> : t}<Icon name="drop" size={13} /></li>
      ))}
    </ul>
  </div>
</div>
<style>
  .tband { position: relative; z-index: 3; height: 64px; background: var(--sky); }
  .tband :global(.tb-seal) { position: absolute; left: max(16px, calc(50% - 664px)); top: -8px; z-index: 2; }
  .tb-clip { display: flex; height: 100%; overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent 0 96px, #000 150px, #000 calc(100% - 60px), transparent); mask-image: linear-gradient(90deg, transparent 0 96px, #000 150px, #000 calc(100% - 60px), transparent); }
  .tb-track { display: flex; align-items: center; gap: 18px; margin: 0; padding: 0 18px 0 0; flex: none; white-space: nowrap; }
  .tb-track:first-child { padding-left: 132px; }
  .tb-track li { display: inline-flex; align-items: center; gap: 18px; font-weight: 700; font-size: 16px; color: var(--navy); }
  .tb-track :global(svg) { color: var(--navy); }
  .pp .script { font-size: 28px; color: var(--white); margin-left: 4px; }
  @media (max-width: 767px) {
    .tband { height: 52px; }
    .tband :global(.tb-seal) { --d: 48px !important; left: 22px; top: -4px; }
    .tb-track:first-child { padding-left: 84px; }
    .tb-track li { font-size: 14px; gap: 14px; } .tb-track { gap: 14px; }
    .tb-clip { -webkit-mask-image: linear-gradient(90deg, transparent 0 64px, #000 96px); mask-image: linear-gradient(90deg, transparent 0 64px, #000 96px); }
  }
</style>
