---
// H7 Who shows up (Figma 427:3092): wide crew photo, six sewn name patches along its bottom edge (buttons), and the active
// review bubble. Tapping a patch swaps the bubble (ui.ts [data-crew]). Noah's quote is not pulled yet: labelled stand-in.
// STICKY 5: patches are not placed on faces until Paul matches names to people; JR count approximate.
import SectionHead from '../ui/SectionHead.astro';
import Img from '../ui/Img.astro';
import PhotoTag from '../ui/PhotoTag.astro';
import Stars from '../ui/Stars.astro';
import GoogleG from '../ui/GoogleG.astro';
import TextLink from '../ui/TextLink.astro';
import { CREW } from '../../data/reviews';
const first = CREW[0];
---
<section class="crew" aria-labelledby="crew-h" data-m-section>
  <div class="wrap" data-crew>
    <SectionHead eyebrow="Who shows up" l1="You'll probably meet" l2="one of these guys" center id="crew-h"
      lead="Our customers keep naming the same people in their Google reviews. So we sewed the names on." />
    <div class="cr-stage">
      <div class="cr-photo frame" data-t="4" data-fx="frame">
        <Img name="hero-02-crew-16-two-trucks" alt="The Plumbing By Paul crew in their blue shirts in front of two wrapped trucks" sizes="(min-width: 1280px) 1200px, calc(100vw - 40px)" focus="50% 78%" widths={[400, 700, 1000, 1400, 1800]} data-parallax="0.05" />
        <PhotoTag class="cr-tag">The crew · St. Petersburg</PhotoTag>
      </div>
      <figure class="cr-card" aria-live="polite" data-t="4" data-fx="rise" data-crew-card>
        <div class="cc-real" data-crew-real>
          <Stars size={16} />
          <blockquote class="cc-q"><p data-crew-q>“{first.quote}”</p></blockquote>
          <figcaption class="cc-by">
            <span class="av num" aria-hidden="true" data-crew-av>{first.by![0]}</span>
            <span class="nm"><span class="n" data-crew-by>{first.by}</span><span class="m" data-crew-meta>{first.meta}</span></span>
            <GoogleG size={18} />
          </figcaption>
        </div>
        <div class="cc-stand" data-crew-stand hidden>
          <p class="label">Review to pull: Noah</p>
          <p>Stand-in. A real Google review that names Noah goes here before launch.</p>
        </div>
        <span class="cc-tail" aria-hidden="true"></span>
      </figure>
      <ul role="list" class="cr-rail" aria-label="Crew names from our Google reviews" data-t="5" data-stagger>
        {CREW.map((c, i) => (
          <li>
            <button type="button" class="cr-btn" aria-pressed={i === 0 ? 'true' : 'false'} data-crew-btn
              data-q={c.quote ? `“${c.quote}”` : ''} data-by={c.by ?? ''} data-meta={c.meta ?? ''} style={`--deg:${i % 2 ? 3 : -3}deg`}>
              <span class="patch-b"><span class="label pl">Crew</span><span class="pn">{c.name}</span></span>
              <span class="cr-cnt">{i === 0 && <><span class="cr-named">named </span>in </>}{c.count} reviews</span>
            </button>
          </li>
        ))}
      </ul>
    </div>
    <div class="cr-foot" data-t="3">
      <p class="caption">Counts are from the 170 most relevant Google reviews we read on 13 Nov 2026. The real numbers are higher.</p>
      <TextLink href="/reviews">Read reviews by technician</TextLink>
    </div>
  </div>
</section>
<style>
  .crew { background: var(--white); padding: 104px 0; }
  .cr-stage { position: relative; margin-top: 48px; }
  .cr-photo { height: 470px; border-radius: var(--r-xl); box-shadow: var(--sh-2); }
  .cr-photo :global(img) { transform: scale(1.08); }
  .cr-photo :global(.cr-tag) { position: absolute; left: 24px; top: 24px; z-index: 2; }
  .cr-card { position: absolute; left: 24px; top: calc(470px - 218px); z-index: 3; width: 380px; margin: 0; padding: 24px; border-radius: var(--r-lg); background: var(--white); box-shadow: var(--sh-3); }
  .cc-real { display: grid; gap: 10px; }
  .cc-q { margin: 0; font-weight: 700; font-size: 26px; line-height: 32px; color: var(--navy); }
  .cc-q p { transition: opacity .3s; }
  .cc-q.long { font-size: 17px; line-height: 26px; font-weight: 600; }
  .cc-by { display: flex; align-items: center; gap: 10px; }
  .av { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: var(--tint); color: var(--press); font-size: 15px; flex: none; }
  .nm { flex: 1; display: grid; } .n { font-weight: 600; font-size: 14px; line-height: 20px; } .m { font-weight: 500; font-size: 12px; line-height: 16px; color: var(--slate-2); }
  .cc-stand[hidden], .cc-real[hidden] { display: none; }
  .cc-stand { display: grid; gap: 8px; padding: 18px; border-radius: 14px; border: 2px dashed var(--blue); background: var(--tint); }
  .cc-stand .label { color: var(--press); } .cc-stand p:last-child { font-size: 14px; line-height: 21px; color: var(--slate); }
  .cc-tail { position: absolute; left: 85px; bottom: -11px; width: 22px; height: 22px; border-radius: 4px; background: var(--white); transform: rotate(45deg); transition: left .5s var(--ease-out); }
  .cr-rail { display: grid; grid-template-columns: repeat(6, 1fr); margin: -28px 0 0; padding: 0; position: relative; z-index: 4; }
  .cr-rail li { display: grid; justify-items: center; }
  .cr-btn { display: grid; justify-items: center; gap: 10px; padding: 0; border-radius: 999px; }
  .patch-b { position: relative; display: inline-grid; place-content: center; justify-items: center; width: 148px; height: 56px; border-radius: 999px; background: var(--white); box-shadow: inset 0 0 0 2px var(--navy), var(--sh-sticker); transform: rotate(var(--deg)); transition: transform .5s var(--ease-back), box-shadow .3s; color: var(--navy); }
  .patch-b::before { content: ''; position: absolute; inset: 5px; border-radius: inherit; border: 1.5px dashed var(--sky); }
  .pl { font-size: 9px; line-height: 10px; color: var(--press); margin-top: 2px; }
  .pn { font-family: var(--f-script); font-size: 30px; line-height: 30px; margin-top: -2px; }
  .cr-btn:hover .patch-b { transform: rotate(calc(var(--deg) * -1)) translateY(-3px); }
  .cr-btn[aria-pressed='true'] .patch-b { box-shadow: inset 0 0 0 3px var(--blue), var(--sh-sticker); }
  .cr-cnt { font-weight: 600; font-size: 13px; line-height: 18px; color: var(--slate); }
  .cr-btn[aria-pressed='true'] .cr-cnt { color: var(--press); }
  .cr-foot { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; margin-top: 36px; }
  .cr-foot .caption { max-width: 640px; }
  @media (max-width: 1199px) { .cr-rail { grid-template-columns: repeat(3, 1fr); gap: 24px 0; } .cr-card { top: auto; bottom: 120px; } }
  @media (max-width: 1023px) {
    .crew { padding: 64px 0; }
    .cr-stage { margin-top: 32px; display: flex; flex-direction: column; }
    .cr-photo { order: 1; } .cr-rail { order: 2; } .cr-card { order: 3; }
    .cr-photo { height: auto; aspect-ratio: 350 / 240; }
    .cr-rail { display: flex; gap: 14px; margin: -22px calc(-1 * var(--gutter)) 0; padding: 0 var(--gutter) 8px; overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: none; }
    .cr-rail::-webkit-scrollbar { display: none; }
    .cr-rail li { flex: none; scroll-snap-align: start; padding-top: 4px; }
    .patch-b { width: 120px; height: 46px; } .pn { font-size: 25px; line-height: 25px; } .pl { font-size: 8px; }
    .cr-card { position: relative; left: auto; top: auto; bottom: auto; width: 100%; margin-top: 24px; }
    .cc-tail { top: -11px; bottom: auto; }
    .cr-named, .cr-photo :global(.cr-tag) { display: none; }
    .cc-q { font-size: 22px; line-height: 28px; }
    .cr-foot { display: grid; margin-top: 24px; gap: 16px; }
  }
</style>
