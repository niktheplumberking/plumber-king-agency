---
// H10 Emergency band (Figma 427:3564): navy with the van photo full-bleed right under navy scrims. STICKY 1 (24/7 vs 8-5).
// The shut-off and outlet rows come from Paul's own FAQ.
import SectionHead from '../ui/SectionHead.astro';
import CallButton from '../ui/CallButton.astro';
import TextLink from '../ui/TextLink.astro';
import Icon from '../ui/Icon.astro';
import Img from '../ui/Img.astro';
const rows = [
  { i: 'droplets', t: 'Your main shut-off is usually outside, near the water meter. Turn it clockwise until it stops.' },
  { i: 'zap', t: 'Water near outlets or the breaker panel? Stay clear of it and tell us when you call.' },
];
---
<section class="em on-navy" aria-labelledby="em-h" data-m-section>
  <div class="em-ph" data-t="4" data-fx="fade">
    <Img name="fleet-van-street-4284px" alt="The Plumbing By Paul van parked on a St. Petersburg street at dusk" sizes="(min-width: 1024px) 64vw, 100vw" focus="50% 56%" widths={[480, 800, 1200, 1600]} data-parallax="0.08" />
  </div>
  <div class="wrap em-in">
    <SectionHead eyebrow="Water where it shouldn't be?" dot l1="Shut off the water." l2="Then call Paul." dark id="em-h" class="em-head"
      lead="Burst pipe, sewage backing up, a water heater letting go. Don't wait and see. The sooner we know, the less it costs you." />
    <div class="em-cta" data-t="3">
      <CallButton v="priN" l2="24/7 emergency line" size="lg" />
      <TextLink href="/emergency-plumbing" dark>What to do in the first five minutes</TextLink>
    </div>
    <ul role="list" class="em-rows" data-t="4" data-stagger>
      {rows.map((r) => <li><span class="ri"><Icon name={r.i} size={20} /></span><p>{r.t}</p></li>)}
    </ul>
  </div>
</section>
<style>
  .em { position: relative; background: var(--navy); color: var(--white); padding: 96px 0 96px; overflow: hidden; min-height: 720px; }
  .em-ph { position: absolute; top: 0; right: 0; bottom: 0; width: 64%; overflow: hidden; }
  .em-ph :global(img) { transform: scale(1.1); }
  .em-ph::before, .em-ph::after { content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none; }
  .em-ph::before { background: linear-gradient(90deg, var(--navy) 0%, rgba(17,16,50,.45) 50%, rgba(17,16,50,.1) 100%); }
  .em-ph::after { bottom: auto; height: 160px; background: linear-gradient(var(--navy), rgba(17,16,50,0)); opacity: .9; }
  .em-in { position: relative; z-index: 2; display: grid; justify-items: start; }
  .em-in :global(.em-head) { max-width: 600px; }
  .em-in :global(.em-head .h2) { font-size: clamp(2rem, 1.905vw + 24.6px, 3.25rem); line-height: 1.115; }
  .em-in :global(.em-head .lead) { max-width: 520px; }
  .em-cta { display: flex; align-items: center; gap: 24px; margin-top: 28px; }
  .em-rows { display: grid; gap: 12px; width: min(560px, 100%); margin: 30px 0 0; padding: 0; }
  .em-rows li { display: flex; align-items: center; gap: 14px; padding: 12px 16px; border-radius: 14px; background: rgba(28,27,69,.92); box-shadow: inset 0 0 0 1px var(--navy-3); }
  .ri { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 10px; background: var(--navy); color: var(--sky); flex: none; }
  .em-rows p { font-weight: 500; font-size: 14px; line-height: 21px; color: var(--tint); }
  @media (max-width: 1023px) {
    .em { padding: 0 0 200px; min-height: 0; }
    .em-ph { position: relative; width: 100%; height: 220px; }
    .em-ph::before { background: linear-gradient(180deg, rgba(17,16,50,.1) 40%, var(--navy) 100%); }
    .em-ph::after { display: none; }
    .em-in { margin-top: -28px; }
    .em-cta { display: contents; }
    .em-cta :global(.btn) { order: 1; width: 100%; margin-top: 24px; }
    .em-cta :global(.tlink) { order: 3; margin-top: 24px; }
    .em-rows { order: 2; width: 100%; margin-top: 20px; }
    .em-rows li { align-items: flex-start; }
  }
</style>
