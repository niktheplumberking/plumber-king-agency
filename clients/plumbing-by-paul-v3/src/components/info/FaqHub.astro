---
// FAQ hub F1 + F2 (Figma 441:3483 / mobile 441:4314). Hero (mist, centred) with the search card straddling its bottom edge
// and the seal on its left end; then a sticky category list + help card left and the grouped accordion right (mobile:
// category chips that scroll sideways). Search and categories filter the list client-side; without JS every answer shows.
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Icon from '../ui/Icon.astro';
import Seal from '../ui/Seal.astro';
import TextLink from '../ui/TextLink.astro';
import CallButton from '../ui/CallButton.astro';
import Swoosh from '../ui/Swoosh.astro';
import Tick from '../ui/Tick.astro';
import FlowLines from '../ui/FlowLines.astro';
import FaqTipItem from './FaqTipItem.astro';
import { GROUPS } from './faqData';
import { SITE } from '../../data/site';
const total = GROUPS.reduce((n, g) => n + g.items.length, 0);
const cats = [{ id: 'all', cat: 'All', n: total }, ...GROUPS.map((g) => ({ id: g.id, cat: g.cat, n: g.items.length }))];
---
<section class="fh" aria-labelledby="fh-h" data-m-section data-m-hero>
  <FlowLines variant="hero" class="fl-d" />
  <FlowLines variant="heroM" class="fl-m" />
  <div class="wrap fh-in">
    <Breadcrumbs items={[{ label: 'FAQ', href: '/faq' }]} />
    <Eyebrow text="Plumbing FAQs" class="fh-eb" />
    <h1 class="h1 fh-h" id="fh-h" data-t="2"><span class="l1">Got questions?</span> <span class="l2">We've got answers.</span></h1>
    <p class="lead fh-lead" data-t="3" data-fx="nudge">The things we get asked most, answered the way we'd answer on the phone.</p>
  </div>
</section>
<section class="fq" aria-label="Questions by category" data-m-section data-faq-hub>
  <div class="wrap">
    <div class="fs-wrap">
      <form class="fs" role="search" aria-label="Search the FAQ" data-t="3" data-faq-search>
        <label for="faq-q" class="sr-only">Search the questions</label>
        <Icon name="search" size={22} class="fs-i" />
        <input id="faq-q" type="search" name="q" class="fs-in" placeholder={'Try "running toilet" or "shut off water"'} autocomplete="off" enterkeyhint="search" />
        <button type="submit" class="btn btn-navy fs-b"><span class="fs-bt">Search</span><Icon name="search" size={20} class="fs-bi" /></button>
      </form>
      <Seal d={112} deg={-8} class="fs-seal" />
    </div>
    <p class="fs-help" data-t="3"><span>Can't find it?</span> <TextLink href={SITE.tel} icon="phone" size={15}>Call {SITE.phone}</TextLink></p>

    <div class="fq-in">
      <aside class="fq-side">
        <nav class="cats" aria-label="Categories">
          <p class="cats-h label"><Tick />Categories</p>
          <ul role="list">
            {cats.map((c, i) => <li><button type="button" class="cat" data-cat={c.id} aria-pressed={i === 0 ? 'true' : 'false'}><span>{c.cat}</span><span class="cn num">{c.n}</span></button></li>)}
          </ul>
        </nav>
        <div class="help on-navy">
          <p class="help-t">Rather just ask a person?</p>
          <p class="help-d">The office is open every day, 8 AM to 5 PM.</p>
          <CallButton v="priN" l2="A real person picks up" class="help-btn" />
          <Swoosh class="help-sw" w={282} h={44} draw={false} />
        </div>
      </aside>
      <div class="fq-main">
        <p class="fq-status" role="status" aria-live="polite" data-faq-status></p>
        {GROUPS.map((g, gi) => (
          <section class="grp" aria-labelledby={`g-${g.id}`} data-group={g.id}>
            <div class="grp-h" data-t="3">
              <span class="grp-i" aria-hidden="true"><Icon name={g.icon} size={22} /></span>
              <h2 id={`g-${g.id}`}>{g.cat}</h2>
              <span class="grp-n label">{g.items.length} answers</span>
            </div>
            <div class="grp-l" data-t="4" data-stagger>
              {g.items.map((it) => <FaqTipItem {...it} name={`fq-${g.id}`} />)}
            </div>
          </section>
        ))}
        <p class="fq-none" data-faq-none hidden>Nothing matches that yet. Try another word, or call {SITE.phone} and ask a person.</p>
      </div>
    </div>
  </div>
  <Swoosh class="fq-sw" flip below="var(--navy)" h={110} />
</section>
<script>
  const hub = document.querySelector<HTMLElement>('[data-faq-hub]');
  if (hub) {
    const form = hub.querySelector<HTMLFormElement>('[data-faq-search]');
    const input = hub.querySelector<HTMLInputElement>('#faq-q');
    const cats = Array.from(hub.querySelectorAll<HTMLButtonElement>('[data-cat]'));
    const groups = Array.from(hub.querySelectorAll<HTMLElement>('[data-group]'));
    const status = hub.querySelector<HTMLElement>('[data-faq-status]');
    const none = hub.querySelector<HTMLElement>('[data-faq-none]');
    let cat = 'all';
    const norm = (s: string) => s.toLowerCase().replace(/[^a-z0-9 ]+/g, ' ');
    const apply = (announce: boolean) => {
      const words = norm(input?.value ?? '').split(/\s+/).filter((w) => w.length > 1);
      let shown = 0; let total = 0;
      groups.forEach((g) => {
        let inGroup = 0;
        g.querySelectorAll<HTMLDetailsElement>('[data-faq-item]').forEach((d) => {
          total++;
          const text = norm(d.textContent ?? '');
          const ok = (cat === 'all' || g.dataset.group === cat) && words.every((w) => text.includes(w));
          d.hidden = !ok;
          if (ok) { inGroup++; shown++; }
          if (ok && words.length && !d.open) d.open = true;
        });
        g.hidden = inGroup === 0;
      });
      if (none) none.hidden = shown > 0;
      if (status) status.textContent = announce ? (shown === total ? '' : `Showing ${shown} of ${total} questions.`) : '';
    };
    form?.addEventListener('submit', (e) => { e.preventDefault(); apply(true); });
    let t = 0;
    input?.addEventListener('input', () => { clearTimeout(t); t = window.setTimeout(() => apply(true), 180); });
    cats.forEach((b) => b.addEventListener('click', () => {
      cat = b.dataset.cat || 'all';
      cats.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      apply(true);
      window.dispatchEvent(new Event('resize'));
    }));
  }
</script>
<style>
  .fh { position: relative; overflow: clip; background: linear-gradient(180deg, var(--mist), var(--white)); padding: 40px 0 92px; }
  .fh :global(.fl-m) { display: none; }
  .fh-in { position: relative; z-index: 2; display: grid; justify-items: center; text-align: center; }
  .fh-in :global(.crumbs ol) { justify-content: center; }
  .fh :global(.fh-eb) { margin-top: 16px; }
  .fh-h { margin-top: 14px; letter-spacing: -0.025em; line-height: 1.1; }
  .fh-h .l1, .fh-h .l2 { display: block; }
  .fh-lead { margin-top: 18px; max-width: 700px; font-size: 18px; line-height: 30px; }

  .fq { position: relative; background: var(--white); padding: 0 0 190px; }
  .fs-wrap { position: relative; width: min(720px, 100%); margin: -36px auto 0; z-index: 3; }
  .fs { position: relative; display: flex; align-items: center; height: 72px; padding: 10px 10px 10px 84px; border-radius: 20px; background: var(--white); box-shadow: inset 0 0 0 1px var(--line), var(--sh-3); }
  .fs:focus-within { box-shadow: inset 0 0 0 2px var(--blue), var(--sh-3); }
  .fs :global(.fs-i) { position: absolute; left: 84px; color: var(--blue); pointer-events: none; }
  .fs-in { flex: 1; min-width: 0; height: 52px; padding: 0 12px 0 36px; border: 0; background: none; font-size: 17px; color: var(--navy); }
  .fs-in::placeholder { color: var(--slate-2); opacity: 1; }
  .fs-in:focus { outline: none; }
  .fs-b { min-height: 52px; padding: 0 24px; }
  .fs :global(.fs-bi) { display: none; }
  .fs-wrap :global(.fs-seal) { position: absolute; left: -30px; top: calc(50% - 56px); }
  .fs-help { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 4px 10px; margin-top: 20px; font-weight: 500; font-size: 15px; color: var(--slate); }

  .fq-in { display: grid; grid-template-columns: 282px minmax(0, 894px); justify-content: space-between; gap: 24px; margin-top: 56px; align-items: start; }
  .fq-side { position: sticky; top: calc(var(--header-h) + 24px); display: grid; gap: 20px; transition: top .45s var(--ease-out); }
  :global(body:has(.hdr.is-hidden)) .fq-side { top: 24px; }
  .cats { padding: 18px; border-radius: 20px; background: var(--white); box-shadow: inset 0 0 0 1px var(--line), var(--sh-2); }
  .cats-h { display: flex; align-items: center; gap: 8px; padding: 0 6px 10px; font-size: 12px; color: var(--navy); }
  .cats ul { display: grid; gap: 2px; margin: 0; padding: 0; }
  .cat { position: relative; display: flex; justify-content: space-between; align-items: center; width: 100%; min-height: 44px; padding: 0 12px; border-radius: 8px; overflow: hidden; font-weight: 500; font-size: 15px; color: var(--slate); text-align: left; transition: background var(--dur-2), color var(--dur-2); }
  .cat:hover { background: var(--mist); color: var(--navy); }
  .cat[aria-pressed='true'] { background: var(--tint); color: var(--navy); font-weight: 700; }
  .cat[aria-pressed='true']::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--blue); }
  .cn { font-size: 15px; color: var(--blue); }
  .help { position: relative; min-height: 264px; padding: 32px 22px 70px; border-radius: 20px; background: var(--navy); color: var(--white); box-shadow: var(--sh-3); }
  .help :global(.help-sw) { position: absolute; left: 0; right: 0; bottom: 0; width: 100%; border-radius: 0 0 20px 20px; overflow: hidden; }
  .help-t { max-width: 190px; font-weight: 800; font-size: 19px; line-height: 25px; }
  .help-d { margin-top: 10px; font-weight: 500; font-size: 13px; line-height: 19px; color: var(--tint); }
  .help :global(.help-btn) { position: relative; z-index: 1; margin-top: 18px; }

  .fq-main { display: grid; gap: 40px; min-width: 0; }
  .fq-status:empty { display: none; }
  .fq-status { font-weight: 600; font-size: 14px; color: var(--slate); margin-bottom: -24px; }
  .grp { display: grid; gap: 12px; scroll-margin-top: calc(var(--header-h) + 24px); }
  .grp-h { display: flex; align-items: center; gap: 12px; padding-bottom: 4px; }
  .grp-i { display: grid; place-items: center; width: 44px; height: 44px; flex: none; border-radius: 50%; background: var(--sky); color: var(--navy); }
  .grp-h h2 { flex: 1; font-weight: 800; font-size: 26px; line-height: 32px; color: var(--navy); }
  .grp-n { font-size: 12px; color: var(--press); }
  .grp-l { display: grid; gap: 12px; }
  .fq-none { padding: 24px; border-radius: 20px; background: var(--mist); font-weight: 500; color: var(--navy); }
  .fq :global(.fq-sw) { position: absolute; left: 0; right: 0; bottom: -1px; }

  @media (max-width: 1199px) { .fq-in { grid-template-columns: 250px minmax(0, 1fr); } }
  @media (max-width: 1023px) {
    .fh { padding: 20px 0 76px; }
    .fh :global(.fl-d) { display: none; } .fh :global(.fl-m) { display: block; }
    .fh-in { justify-items: start; text-align: left; }
    .fh-in :global(.crumbs ol) { justify-content: flex-start; }
    .fh-lead { margin-top: 12px; font-size: 15px; line-height: 24px; }
    .fq { padding-bottom: 110px; }
    .fs-wrap { margin-top: -32px; }
    .fs { height: 64px; padding: 8px 8px 8px 60px; border-radius: 18px; }
    .fs :global(.fs-i) { display: none; }
    .fs-in { padding-left: 4px; font-size: 15px; }
    .fs-b { width: 48px; min-height: 48px; padding: 0; border-radius: 12px; }
    .fs-bt { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .fs :global(.fs-bi) { display: block; }
    .fs-wrap :global(.fs-seal) { left: -14px; top: -4px; --d: 72px !important; }
    .fs-help { justify-content: flex-start; font-size: 14px; }
    .fq-in { grid-template-columns: minmax(0, 1fr); margin-top: 24px; gap: 28px; }
    .fq-side { position: static; min-width: 0; grid-template-columns: minmax(0, 1fr); }
    .cats { margin: 0 calc(-1 * var(--gutter)); padding: 0; border-radius: 0; background: none; box-shadow: none; }
    .cats-h, .help { display: none; }
    .cats ul { display: flex; gap: 8px; padding: 2px var(--gutter); overflow-x: auto; scrollbar-width: none; }
    .cats ul::-webkit-scrollbar { display: none; }
    .cat { gap: 8px; white-space: nowrap; padding: 0 14px; border-radius: 999px; box-shadow: inset 0 0 0 1.5px var(--line); font-weight: 600; font-size: 14px; color: var(--navy); }
    .cat[aria-pressed='true'] { background: var(--navy); color: var(--white); box-shadow: none; }
    .cat[aria-pressed='true']::before { display: none; }
    .cat[aria-pressed='true'] .cn { color: var(--sky); }
    .cn { font-size: 13px; }
    .fq-main { gap: 28px; }
    .grp-i { width: 36px; height: 36px; }
    .grp-h h2 { font-size: 20px; line-height: 26px; }
  }
</style>
