---
// R2 What people mention (Figma 443:2783). Navy band; the chart card (navy, 1 px sky border) overlaps the hero's bottom
// edge by 48 px and the top bar's value breaks out of the card on a sky tag. One colour; bar length carries the data.
// Counts are Google's topic chips on the listing, read 13 Nov 2026 (refresh at build).
import SectionHead from '../ui/SectionHead.astro';
import GoogleG from '../ui/GoogleG.astro';
import { TOPICS } from './data';
const max = TOPICS[0][1];
---
<section class="rvm on-navy" aria-labelledby="rvm-h" data-m-section>
  <div class="wrap rvm-in">
    <div class="rvm-copy">
      <SectionHead eyebrow="In Google's words" l1="What people" l2="bring up most" dark id="rvm-h" />
      <p class="rvm-p" data-t="3">Google groups our reviews by the topics customers mention. These are its counts, not ours.</p>
      <p class="rvm-src" data-t="5" data-fx="pop"><GoogleG size={18} />From our Google listing</p>
    </div>
    <figure class="chart">
      <ul role="list" class="bars" data-t="4" data-stagger>
        {TOPICS.map(([t, v], i) => (
          <li class:list={['bar', i === 0 && 'top']} style={`--w:${Math.max(3, (v / max) * 100)}%`}>
            <span class="bl">{t}</span>
            <span class="bt"><span class="bf"></span>
              {i === 0 ? <span class="tag"><b class="num">{v}</b> mentions</span> : <span class="bv num">{v}</span>}
            </span>
          </li>
        ))}
      </ul>
      <figcaption class="cap">Topic counts shown on our Google listing, 13 Nov 2026.</figcaption>
    </figure>
  </div>
</section>
<style>
  .rvm { position: relative; z-index: 3; background: var(--navy); color: var(--white); padding: 104px 0; }
  .rvm-in { display: grid; grid-template-columns: minmax(0, 384px) minmax(0, 792px); justify-content: space-between; align-items: start; column-gap: 24px; }
  .rvm-p { max-width: 360px; margin-top: 20px; font-weight: 500; font-size: 17px; line-height: 28px; color: var(--tint); }
  .rvm-src { display: inline-flex; align-items: center; gap: 8px; height: 44px; margin-top: 26px; padding: 0 14px; border-radius: 12px; background: var(--navy-2); box-shadow: inset 0 0 0 1px var(--navy-3); font-weight: 600; font-size: 14px; }
  .chart { position: relative; margin: -152px 0 0; padding: 40px 36px 28px; border-radius: 28px; background: var(--navy); box-shadow: inset 0 0 0 1px var(--sky), var(--sh-3); }
  .bars { display: grid; gap: 16px; margin: 0; padding: 0; }
  .bar { display: grid; grid-template-columns: 232px 1fr; align-items: center; }
  .bl { font-weight: 600; font-size: 14px; line-height: 28px; color: var(--white); }
  .bt { position: relative; display: flex; align-items: center; gap: 12px; height: 28px; margin-right: 64px; border-radius: 6px; background: var(--navy-2); }
  .bf { height: 100%; width: var(--w); border-radius: 6px; background: var(--sky); flex: none; }
  .bv { font-size: 20px; line-height: 28px; color: var(--sky); }
  .tag { position: absolute; right: -88px; top: -6px; display: inline-flex; align-items: center; gap: 6px; height: 40px; padding: 0 14px; border-radius: 10px; background: var(--sky); color: var(--navy); box-shadow: var(--sh-sticker); font-weight: 700; font-size: 12px; }
  .tag b { font-size: 22px; line-height: 26px; font-weight: 400; }
  .cap { margin-top: 26px; font-weight: 500; font-size: 13px; line-height: 18px; color: var(--soft); }
  @media (max-width: 1199px) { .rvm-in { grid-template-columns: minmax(0, 320px) minmax(0, 1fr); } .bar { grid-template-columns: 200px 1fr; } }
  @media (max-width: 1023px) {
    .rvm { padding: 56px 0 64px; }
    .rvm-in { grid-template-columns: 1fr; row-gap: 28px; }
    .rvm-p { font-size: 15px; line-height: 24px; margin-top: 14px; }
    .rvm-src { display: none; }
    .chart { margin: 0; padding: 22px 16px 18px; border-radius: 20px; }
    .bars { gap: 12px; }
    .bar { grid-template-columns: 1fr; gap: 4px; }
    .bl { font-size: 13px; line-height: 18px; }
    .bt { height: 22px; margin-right: 0; }
    .bv { font-size: 16px; }
    .tag { position: static; height: 32px; padding: 0 10px; margin-left: auto; flex: none; }
    .tag b { font-size: 18px; }
    .bt:has(.tag) { margin-right: 0; }
    .top .bf { width: auto; flex: 1 1 0; min-width: 0; } /* the top topic is the 100% bar: it fills what the tag leaves */
    .cap { font-size: 12px; margin-top: 18px; }
  }
</style>
