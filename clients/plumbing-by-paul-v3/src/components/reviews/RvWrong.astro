---
// R8 If we get it wrong (Figma 443:3471). One centred white card with the in-bar; the seal overlaps its top-left corner.
// STICKY: Paul and Alycia to approve this wording and the named contact.
import Seal from '../ui/Seal.astro';
import Button from '../ui/Button.astro';
import { SITE } from '../../data/site';
---
<section class="rvx" aria-labelledby="rvx-h" data-m-section>
  <div class="wrap">
    <div class="rvx-card" data-t="4" data-fx="rise">
      <Seal d={112} deg={-8} class="rvx-seal" />
      <h2 class="rvx-h" id="rvx-h" data-t="2">Not every job goes perfectly. <span class="l2">Here's what happens when one doesn't.</span></h2>
      <p class="rvx-p" data-t="3">We read every review, including the hard ones, and we answer them. If something we did isn't right, call the office at {SITE.phone} and ask for Alycia. We'd rather fix it than explain it.</p>
      <div class="rvx-row" data-t="3">
        <Button href={SITE.tel} icon="phone">Call the office</Button>
        <span class="rvx-sc script" aria-hidden="true">Ask for Alycia</span>
      </div>
    </div>
  </div>
</section>
<style>
  .rvx { position: relative; background: var(--tint); padding: 96px 0 104px; }
  .rvx-card { position: relative; max-width: 960px; margin: 0 auto; padding: 44px 56px 44px 120px; border-radius: 24px; background: var(--white); box-shadow: inset 6px 0 0 var(--blue), var(--sh-2); }
  .rvx-card :global(.rvx-seal) { position: absolute; left: -40px; top: -42px; }
  .rvx-h { max-width: 784px; font-weight: 800; font-size: 28px; line-height: 36px; letter-spacing: -0.018em; color: var(--navy); }
  .rvx-h .l2 { color: var(--blue); }
  .rvx-p { max-width: 784px; margin-top: 16px; font-size: 17px; line-height: 29px; color: var(--slate); }
  .rvx-row { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; margin-top: 16px; }
  .rvx-sc { font-size: 32px; line-height: 36px; color: var(--blue); }
  @media (max-width: 1023px) {
    .rvx { padding: 72px 0 64px; }
    .rvx-card { padding: 52px 22px 24px; border-radius: 20px; }
    .rvx-card :global(.rvx-seal) { --d: 72px !important; left: 8px; top: -40px; }
    .rvx-h { font-size: 20px; line-height: 26px; }
    .rvx-p { font-size: 15px; line-height: 25px; }
    .rvx-row { display: grid; }
    .rvx-row :global(.btn) { width: 100%; }
    .rvx-sc { display: none; }
  }
</style>
