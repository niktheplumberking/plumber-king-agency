---
// See it for yourself (Figma 04 D6): tint band, copy + two link buttons left; right a dashed slot for the photo Paul
// still has to send (labelled exactly as in Figma), a framed photo with a tag, and a review card over both.
import SectionHead from '../ui/SectionHead.astro';
import Icon from '../ui/Icon.astro';
import Img from '../ui/Img.astro';
import PhotoTag from '../ui/PhotoTag.astro';
import ReviewCard from '../ui/ReviewCard.astro';
import type { SvcPage } from '../../data/service-pages';
import { sid } from './fmt';
interface Props { f: NonNullable<SvcPage['feature']>; slug: string; }
const { f, slug } = Astro.props;
const id = sid(slug, 'feature');
---
<section class="ft" aria-labelledby={id} data-m-section>
  <div class="wrap ft-grid">
    <div class="ft-copy">
      <SectionHead eyebrow={f.eyebrow} l1={f.l1} l2={f.l2} lead={f.p} id={id} />
      <div class="ft-links" data-t="3" data-stagger>
        {f.links.map((l) => <a href={l.href} class="ft-link">{l.t}<Icon name="arrow" size={18} /></a>)}
      </div>
    </div>
    <div class:list={['ft-media', !f.placeholder && 'nop']}>
      {f.placeholder && (
        <div class="ft-slot" data-t="4" data-fx="fade"><Icon name="camera" size={26} /><p class="label">{f.placeholder}</p></div>
      )}
      <div class="ft-ph frame" data-t="4" data-fx="frame">
        <Img name={f.photo.name} alt={f.photo.alt} focus={f.photo.focus} sizes="(min-width: 1024px) 300px, 180px" widths={[320, 480, 640]} />
        <PhotoTag class="ft-tag">{f.tag}</PhotoTag>
      </div>
      <ReviewCard r={f.review.r} class="ft-rv" t="5" />
    </div>
  </div>
</section>
<style>
  .ft { position: relative; background: var(--tint); padding: 112px 0 220px; }
  .ft-grid { display: grid; grid-template-columns: minmax(0, 520px) minmax(0, 620px); justify-content: space-between; column-gap: 60px; align-items: start; }
  .ft-links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .ft-link { display: inline-flex; align-items: center; gap: 18px; min-height: 56px; padding: 0 20px 0 18px; border-radius: 14px; background: var(--white); box-shadow: inset 0 0 0 1px var(--line); color: var(--navy); font-weight: 700; font-size: 16px; line-height: 22px; transition: box-shadow var(--dur-2); }
  .ft-link :global(svg) { color: var(--blue); transition: transform var(--dur-2) var(--ease-out); }
  .ft-link:hover { box-shadow: inset 0 0 0 1px var(--blue), var(--sh-1); }
  .ft-link:hover :global(svg) { transform: translateX(4px); }
  .ft-media { position: relative; height: 420px; }
  .ft-slot { position: absolute; left: 20px; top: 20px; width: 264px; height: 112px; display: grid; justify-items: center; align-content: center; gap: 8px; padding: 10px 16px; border-radius: 18px; border: 2px dashed var(--blue); color: var(--press); text-align: center; }
  .ft-slot .label { font-size: 11px; line-height: 15px; }
  .ft-ph { position: absolute; right: 0; top: 0; width: 300px; height: 400px; border-radius: var(--r-xl); }
  .nop .ft-ph { width: 380px; }
  .ft-ph :global(.ft-tag) { position: absolute; left: 22px; top: 22px; z-index: 2; }
  .ft-media :global(.ft-rv) { position: absolute; left: 0; top: 146px; width: 460px; z-index: 2; box-shadow: var(--sh-3); }
  @media (max-width: 1199px) and (min-width: 1024px) { .ft-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 500px); } .ft-media :global(.ft-rv) { width: 380px; } .ft-ph { width: 250px; } .ft-slot { width: 220px; } }
  @media (max-width: 1023px) {
    .ft { padding: 64px 0 72px; }
    .ft-grid { grid-template-columns: minmax(0, 1fr); row-gap: 40px; }
    .ft-links { display: grid; gap: 10px; margin-top: 24px; }
    .ft-link { justify-content: space-between; min-height: 52px; }
    .ft-media { height: auto; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; align-items: start; }
    .ft-slot { position: relative; left: auto; top: auto; width: auto; height: 170px; margin-top: 30px; }
    .ft-ph, .nop .ft-ph { position: relative; width: auto; height: 240px; border-radius: 20px; }
    .nop .ft-ph { grid-column: 1 / -1; }
    .ft-ph :global(.ft-tag) { display: none; }
    .ft-media :global(.ft-rv) { position: relative; left: auto; top: auto; width: auto; grid-column: 1 / -1; margin-top: -30px; }
  }
</style>
