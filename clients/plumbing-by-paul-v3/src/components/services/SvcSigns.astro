---
// Signs (Figma 03 W3): tint band, head left + a call line right, four numbered cards in a 2x2 grid joined by short
// pipe couplings. Mobile: one column on a vertical pipe.
import SectionHead from '../ui/SectionHead.astro';
import Icon from '../ui/Icon.astro';
import { SITE } from '../../data/site';
import type { SvcPage } from '../../data/service-pages';
import { sid } from './fmt';
interface Props { s: NonNullable<SvcPage['signs']>; slug: string; }
const { s, slug } = Astro.props;
const id = sid(slug, 'signs');
---
<section class="sg" aria-labelledby={id} data-m-section>
  <div class="wrap">
    <div class="sg-head">
      <SectionHead eyebrow={s.eyebrow} l1={s.l1} l2={s.l2} id={id} />
      <a href={SITE.tel} class="sg-call" data-t="3"><Icon name="phone" size={18} />Seeing one of these? Call {SITE.phone}</a>
    </div>
    <ol class="sg-grid" role="list" data-t="4" data-stagger>
      {s.items.map((c, i) => (
        <li class="sg-card">
          <span class="sg-n num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          {i % 2 === 1 && <span class="sg-coup" aria-hidden="true"></span>}
          <div class="sg-txt">
            <h3 class="sg-t">{c.t}</h3>
            <p class="sg-d">{c.d}</p>
          </div>
          <span class="well sg-w"><Icon name={c.icon} size={24} /></span>
        </li>
      ))}
    </ol>
    <a href={SITE.tel} class="sg-call sg-call-m"><Icon name="phone" size={18} />Seeing one of these? Call {SITE.phone}</a>
  </div>
</section>
<style>
  .sg { position: relative; background: var(--tint); padding: 104px 0; }
  .sg-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; }
  .sg-call { display: inline-flex; align-items: center; gap: 8px; color: var(--press); font-weight: 700; font-size: 16px; line-height: 24px; padding-bottom: 6px; }
  .sg-call:hover { text-decoration: underline; text-underline-offset: 4px; }
  .sg-call-m { display: none; }
  .sg-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 44px 40px; margin: 72px 0 0; padding: 0; }
  .sg-card { position: relative; display: flex; justify-content: space-between; gap: 20px; min-height: 168px; padding: 44px 28px 28px 52px; border-radius: var(--r-lg); background: var(--white); box-shadow: var(--sh-2); transition: transform .5s var(--ease-out); }
  .sg-card:hover { transform: translateY(-4px); }
  .sg-n { position: absolute; left: -22px; top: -24px; display: grid; place-items: center; width: 60px; height: 60px; border-radius: 50%; background: var(--sky); color: var(--navy); font-size: 20px; box-shadow: 0 0 0 4px var(--white), var(--sh-2); }
  .sg-t { font-weight: 700; font-size: 21px; line-height: 28px; }
  .sg-d { margin-top: 8px; font-size: 15px; line-height: 24px; color: var(--slate); }
  .sg-w { width: 64px; height: 64px; border-radius: 14px; }
  .sg-coup { position: absolute; left: -40px; top: 72px; width: 40px; height: 22px; background:
    linear-gradient(var(--navy), var(--navy)) 0 0 / 6px 100% no-repeat, linear-gradient(var(--navy), var(--navy)) 100% 0 / 6px 100% no-repeat,
    linear-gradient(var(--navy), var(--navy)) 0 3px / 100% 16px no-repeat; border-radius: 2px; }
  .sg-coup::after { content: ''; position: absolute; left: 6px; right: 6px; top: 6px; height: 10px; background: var(--sky); }
  @media (max-width: 1023px) {
    .sg { padding: 64px 0; }
    .sg-head > .sg-call { display: none; }
    .sg-grid { position: relative; grid-template-columns: minmax(0, 1fr); gap: 20px; margin-top: 44px; padding-left: 22px; }
    .sg-grid::before { content: ''; position: absolute; left: 22px; top: 20px; bottom: 20px; width: 12px; border-radius: 6px; background: var(--sky); box-shadow: inset 0 0 0 3px var(--navy); }
    .sg-card { min-height: 0; padding: 22px 18px 22px 44px; }
    .sg-n { left: -24px; top: 12px; width: 48px; height: 48px; font-size: 16px; }
    .sg-t { font-size: 18px; line-height: 24px; }
    .sg-d { font-size: 14px; line-height: 22px; }
    .sg-w, .sg-coup { display: none; }
    .sg-call-m { display: inline-flex; margin-top: 28px; padding: 0; font-size: 15px; }
  }
</style>
