---
// Types (Figma 03 W5): navy band, head left, three cards that rise over the band's top edge (sky number tab, icon,
// "best for" box), and a bordered bar with the lead and a call line. Mobile: the cards become a swipe rail with dots.
// id="types" is the target of the hub's "Tankless water heaters" link (there is no tankless page).
import SectionHead from '../ui/SectionHead.astro';
import Icon from '../ui/Icon.astro';
import FlowLines from '../ui/FlowLines.astro';
import { SITE } from '../../data/site';
import type { SvcPage } from '../../data/service-pages';
import { sid } from './fmt';
interface Props { t: NonNullable<SvcPage['types']>; slug: string; }
const { t, slug } = Astro.props;
const id = sid(slug, 'types-h');
const n = t.cards.length;
---
<section class="ty on-navy" id="types" aria-labelledby={id} data-m-section>
  <FlowLines variant="navy" class="ty-fl" />
  <div class="wrap ty-in">
    <SectionHead eyebrow={t.eyebrow} l1={t.l1} l2={t.l2} dark id={id} class="ty-head" />
    <div class="ty-rail" data-carousel>
      <ul class="ty-cards" role="list" data-track tabindex="0" aria-label="Types, scroll sideways for more" style={`--n:${n}`} data-t="4" data-stagger>
        {t.cards.map((c, i) => (
          <li class:list={['ty-card', i === 1 && 'alt']} data-slide>
            <span class="ty-num num">{c.num}</span>
            <span class="ty-ic"><Icon name={c.icon} size={30} stroke={1.5} /></span>
            <p class="label ty-sub">{c.sub}</p>
            <h3 class="ty-t">{c.t}</h3>
            <p class="ty-d">{c.d}</p>
            <p class="ty-best"><span class="label">Best for</span><b>{c.best}</b></p>
          </li>
        ))}
      </ul>
      <div class="ty-dots" aria-hidden="true">{t.cards.map((_, i) => <i data-dot class:list={[i === 0 && 'on']}></i>)}<span><span data-count-now>1</span> of {n} · swipe</span></div>
    </div>
  </div>
  <div class="wrap">
    <div class="ty-bar" data-t="3">
      {t.lead && <p>{t.lead}</p>}
      <a href={SITE.tel} class="ty-call"><Icon name="phone" size={18} />{t.link}: {SITE.phone}</a>
    </div>
  </div>
</section>
<style>
  .ty { position: relative; z-index: 1; background: var(--navy); color: var(--white); padding: 104px 0 88px; margin-top: 40px; }
  .ty :global(.ty-fl) { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .ty-in { position: relative; display: grid; grid-template-columns: minmax(0, 340px) minmax(0, 820px); justify-content: space-between; column-gap: 40px; align-items: start; }
  .ty-in :global(.ty-head) { padding-top: 0; }
  .ty-rail { margin-top: -146px; }
  .ty-cards { display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 20px; margin: 0; padding: 0; }
  .ty-card { position: relative; display: flex; flex-direction: column; padding: 70px 28px 28px; border-radius: 22px; background: var(--white); color: var(--navy); box-shadow: var(--sh-3); }
  .ty-card.alt { background: var(--tint); }
  .ty-num { position: absolute; left: 20px; top: -26px; padding: 6px 16px 8px; border-radius: 12px; background: var(--sky); color: var(--navy); font-size: 34px; line-height: 44px; box-shadow: 0 6px 0 var(--blue); }
  .ty-ic { position: absolute; right: 26px; top: 20px; color: var(--sky); }
  .ty-sub { color: var(--press); font-size: 11px; min-height: 30px; }
  .ty-t { margin-top: 8px; font-weight: 800; font-size: 26px; line-height: 32px; }
  .ty-d { margin-top: 12px; font-size: 15px; line-height: 24px; color: var(--slate); flex: 1; }
  .ty-best { display: grid; gap: 2px; margin-top: 18px; padding: 12px 12px; border-radius: 12px; background: var(--mist); }
  .alt .ty-best { background: var(--white); }
  .ty-best .label { font-size: 10px; color: var(--press); }
  .ty-best b { font-weight: 700; font-size: 15px; line-height: 20px; }
  .ty-dots { display: none; }
  .ty-bar { position: relative; display: flex; justify-content: space-between; align-items: center; gap: 32px; margin-top: 32px; padding: 26px 28px; border-radius: var(--r-lg); background: var(--navy-2); box-shadow: inset 0 0 0 1px var(--navy-3); }
  .ty-bar p { max-width: 560px; font-weight: 500; font-size: 17px; line-height: 28px; color: var(--tint); }
  .ty-call { display: inline-flex; align-items: center; gap: 8px; flex: none; color: var(--sky); font-weight: 700; font-size: 16px; line-height: 24px; }
  .ty-call:hover { text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 1199px) and (min-width: 1024px) { .ty-in { grid-template-columns: minmax(0, 260px) minmax(0, 1fr); } .ty-card { padding: 64px 20px 22px; } }
  @media (max-width: 1023px) {
    .ty { padding: 64px 0 64px; margin-top: 0; }
    .ty-in { grid-template-columns: minmax(0, 1fr); }
    .ty-rail { margin-top: 0; order: 3; }
    .ty-cards { display: flex; gap: 14px; margin: 44px calc(-1 * var(--gutter)) 0; padding: 30px var(--gutter) 8px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
    .ty-cards::-webkit-scrollbar { display: none; }
    .ty-card { flex: 0 0 min(262px, 76vw); scroll-snap-align: start; scroll-margin-left: var(--gutter); padding: 60px 22px 22px; }
    .ty-num { font-size: 28px; line-height: 36px; }
    .ty-dots { display: flex; align-items: center; gap: 6px; margin-top: 16px; font-size: 12px; color: var(--soft); }
    .ty-dots i { width: 8px; height: 8px; border-radius: 4px; background: var(--navy-3); transition: width .4s var(--ease-out), background .4s; }
    .ty-dots i:global(.on) { width: 22px; background: var(--sky); }
    .ty-dots span { margin-left: 6px; }
    .ty-bar { display: grid; gap: 18px; margin-top: 24px; padding: 0; background: none; box-shadow: none; }
    .ty-bar p { font-size: 15px; line-height: 25px; }
    .ty-call { font-size: 15px; flex: 1; align-items: flex-start; }
    .ty-call :global(svg) { margin-top: 3px; }
  }
</style>
