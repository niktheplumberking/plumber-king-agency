---
// Static two-layer wave (soft behind, sky in front) for the top edge of a sky band. Sits above the band (bottom: 100%).
// A local, motion-free cousin of ui/Water.astro, whose drifting layers left gaps in full-page captures of short bands.
interface Props { class?: string; }
const { class: cls } = Astro.props;
const w = 1440, h = 40;
const wave = (y: number, amp: number, len: number, ph: number) => {
  let d = `M0 ${h} L0 ${y}`;
  for (let x = 0; x <= w; x += 20) d += ` L${x} ${(y + amp * Math.sin(((x + ph) / len) * Math.PI * 2)).toFixed(1)}`;
  return d + ` L${w} ${h} Z`;
};
---
<svg class:list={['wave', cls]} viewBox={`0 0 ${w} ${h}`} preserveAspectRatio="none" aria-hidden="true">
  <path fill="#A9D3E4" d={wave(16, 7, 520, 90)} />
  <path fill="#61ADCB" d={wave(26, 6, 640, 0)} />
</svg>
<style>
  .wave { position: absolute; left: 0; bottom: calc(100% - 1px); width: 100%; height: 40px; display: block; pointer-events: none; }
</style>
