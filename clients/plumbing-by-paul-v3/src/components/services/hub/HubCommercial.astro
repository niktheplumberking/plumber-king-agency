---
// S6 Commercial and gas (Figma 02): navy band; copy, two rows, a sky call button and proof chips left; a framed photo on a
// sky block, a tilted snapshot over it and Stefan's review card (patches JR + Elvis) breaking out of the band's foot.
import SectionHead from '../../ui/SectionHead.astro';
import Icon from '../../ui/Icon.astro';
import Img from '../../ui/Img.astro';
import PhotoTag from '../../ui/PhotoTag.astro';
import CallButton from '../../ui/CallButton.astro';
import ProofChips from '../../ui/ProofChips.astro';
import ReviewCard from '../../ui/ReviewCard.astro';
import FlowLines from '../../ui/FlowLines.astro';
import { STEFAN } from './hub';
---
<section class="cm" aria-labelledby="cm-h" data-m-section>
  <div class="cm-band on-navy"><FlowLines variant="navy" class="cm-fl" /></div>
  <div class="wrap cm-grid">
    <div class="cm-copy on-navy">
      <SectionHead eyebrow="Commercial and residential" l1="It says so" l2="on the side of the truck" dark id="cm-h"
        lead="Offices, church halls, rentals and new builds get the same crew and the same manners as a family kitchen. We work around your opening hours and keep the place clean while we do it." />
      <ul role="list" class="cm-rows" data-t="4" data-stagger>
        <li><span class="cm-i"><Icon name="building" size={22} /></span><span><b>Businesses and property managers.</b> One number, one crew that already knows your building.</span></li>
        <li><span class="cm-i"><Icon name="zap" size={22} /></span><span><b>Gas lines.</b> New lines, appliance hookups and leak checks.</span></li>
      </ul>
      <div data-t="3" class="cm-cta"><CallButton v="priN" l2="Ask for a commercial estimate" /></div>
      <ProofChips v="dark" class="cm-chips" />
    </div>
    <div class="cm-media">
      <span class="cm-back" aria-hidden="true"></span>
      <div class="cm-ph frame" data-t="4" data-fx="frame">
        <Img name="crew-three-techs-at-van" alt="Three Plumbing By Paul technicians at the open side door of a work van" sizes="(min-width: 1024px) 440px, calc(100vw - 40px)" focus="50% 35%" widths={[400, 600, 880]} />
        <PhotoTag class="cm-tag">Commercial and residential</PhotoTag>
      </div>
      <div class="cm-sn snap" data-t="4" data-fx="toss">
        <Img name="service-tech-threading-pipe-truck" alt="A technician threading pipe beside the wrapped Plumbing By Paul truck" sizes="180px" focus="50% 50%" widths={[180, 360]} />
      </div>
      <ReviewCard r={STEFAN} class="cm-rv" t="4" />
    </div>
  </div>
</section>
<style>
  .cm { position: relative; background: var(--white); padding: 104px 0 0; }
  .cm-band { position: absolute; left: 0; right: 0; top: 0; bottom: 48px; background: var(--navy); overflow: hidden; }
  .cm-band :global(.cm-fl) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .cm-grid { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 580px) minmax(0, 520px); justify-content: space-between; column-gap: 60px; }
  .cm-copy { padding-bottom: 96px; }
  .cm-rows { display: grid; gap: 12px; margin: 32px 0 0; padding: 0; }
  .cm-rows li { display: flex; align-items: center; gap: 16px; padding: 16px 20px 16px 16px; border-radius: 16px; background: var(--navy-2); box-shadow: inset 0 0 0 1px var(--navy-3); color: var(--tint); font-size: 15px; line-height: 22px; }
  .cm-rows b { display: block; color: var(--white); font-weight: 700; font-size: 16px; }
  .cm-i { display: grid; place-items: center; flex: none; width: 44px; height: 44px; border-radius: 12px; background: var(--sky); color: var(--navy); }
  .cm-cta { margin-top: 28px; }
  .cm-copy :global(.cm-chips) { margin-top: 24px; }
  .cm-media { position: relative; min-height: 640px; }
  .cm-back { position: absolute; left: 40px; right: -20px; top: 20px; height: 420px; border-radius: var(--r-xl); background: var(--sky); }
  .cm-ph { position: absolute; left: 30px; right: 0; top: 0; height: 400px; border-radius: var(--r-xl); }
  .cm-ph :global(.cm-tag) { position: absolute; left: 22px; top: 22px; z-index: 2; }
  .cm-sn { position: absolute; left: -110px; top: 210px; z-index: 2; width: 180px; height: 250px; transform: rotate(-5deg); }
  .cm-media :global(.cm-rv) { position: absolute; left: 0; right: 0; top: 300px; z-index: 3; box-shadow: var(--sh-3); }
  @media (max-width: 1199px) and (min-width: 1024px) { .cm-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 440px); } .cm-sn { left: -60px; } }
  @media (max-width: 1023px) {
    .cm { padding: 64px 0 0; }
    .cm-band { bottom: 120px; }
    .cm-grid { grid-template-columns: minmax(0, 1fr); }
    .cm-copy { padding-bottom: 40px; }
    .cm-copy :global(.cm-chips) { display: none; }
    .cm-cta :global(.btn) { width: 100%; }
    .cm-media { min-height: 0; display: grid; }
    .cm-back { left: 16px; right: -10px; top: 14px; height: 270px; }
    .cm-ph { position: relative; left: auto; height: 270px; margin-right: 6px; border-radius: 20px; }
    .cm-ph :global(.cm-tag) { display: none; }
    .cm-sn { left: auto; right: 0; top: 180px; width: 110px; height: 150px; }
    .cm-media :global(.cm-rv) { position: relative; top: auto; margin-top: 30px; }
  }
</style>
