---
// A6 In the community (Figma A6): bento of three photos with caption plates; a sky text cell overlaps the large photo's
// corner (navy text on sky, never white). Mobile: text cell first, then the photos.
import SectionHead from '../ui/SectionHead.astro';
import TextLink from '../ui/TextLink.astro';
import Img from '../ui/Img.astro';
import Caption from '../ui/Caption.astro';
import Icon from '../ui/Icon.astro';
---
<section class="ac" aria-labelledby="ac-h" data-m-section>
  <div class="wrap">
    <div class="ac-head">
      <SectionHead eyebrow="More than fixing pipes" l1="Family-owned." l2="Community-focused." id="ac-h" />
      <TextLink href="/about" class="ac-all">More about us</TextLink>
    </div>
    <div class="ac-bento" data-t="4" data-stagger>
      <figure class="ac-f ac-big frame" data-fx="frame">
        <Img name="community-classroom-visit" alt="Paul with a class of elementary school children holding up blue gifts" sizes="(min-width: 1024px) 660px, calc(100vw - 40px)" widths={[400, 700, 1000, 1320]} focus="50% 45%" />
        <figcaption><Caption class="ac-cap" small>Paul with an elementary class.</Caption></figcaption>
      </figure>
      <figure class="ac-f ac-s1 frame" data-fx="frame">
        <Img name="community-toy-drive-team" alt="The Plumbing By Paul team with a pile of donated toys" sizes="(min-width: 1024px) 246px, 50vw" widths={[260, 500]} focus="50% 40%" />
        <figcaption><Caption class="ac-cap" small>The team with donated toys.</Caption></figcaption>
      </figure>
      <figure class="ac-f ac-s2 frame" data-fx="frame">
        <Img name="community-branded-tent" alt="The blue Plumbing By Paul tent set up at an outdoor event" sizes="(min-width: 1024px) 246px, 50vw" widths={[260, 500]} focus="50% 50%" />
        <figcaption><Caption class="ac-cap" small>The blue tent.</Caption></figcaption>
      </figure>
      <div class="ac-cell" data-fx="rise">
        <p class="label ac-eb"><Icon name="heart" size={16} />Plumbing Pinellas <span class="script">with Heart</span></p>
        <p class="ac-t">We sponsor the teams, show up at the school and set up the blue tent at local events. Pinellas isn't our market. It's where our kids go to school.</p>
      </div>
    </div>
    <TextLink href="/about" class="ac-allm">More about us</TextLink>
  </div>
</section>
<style>
  .ac { position: relative; background: var(--white); padding: 104px 0 128px; }
  .ac-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; }
  .ac-head :global(.ac-all) { margin-bottom: 6px; }
  .ac-bento { position: relative; display: grid; grid-template-columns: 660fr 24fr 246fr 24fr 246fr; grid-template-rows: 250px 24px 156px; margin-top: 56px; }
  .ac-f { position: relative; margin: 0; }
  .ac-f :global(img) { display: block; }
  .ac-big { grid-column: 1; grid-row: 1 / 4; }
  .ac-s1 { grid-column: 3; grid-row: 1; border-radius: var(--r-lg); }
  .ac-s2 { grid-column: 5; grid-row: 1; border-radius: var(--r-lg); }
  .ac-f :global(.ac-cap) { position: absolute; left: 16px; top: 16px; z-index: 2; }
  .ac-cell { position: relative; z-index: 3; grid-column: 1 / 6; grid-row: 3; justify-self: end; width: 580px; margin-top: -10px; margin-bottom: -17px; padding: 26px 32px 28px; border-radius: 22px; background: var(--sky); color: var(--navy); box-shadow: var(--sh-3); }
  .ac-eb { display: flex; align-items: center; gap: 8px; color: var(--navy); }
  .ac-eb .script { font-size: 18px; text-transform: none; letter-spacing: 0; margin-left: 4px; }
  .ac-t { margin-top: 12px; font-weight: 600; font-size: 16px; line-height: 26px; }
  .ac :global(.ac-allm) { display: none; }
  @media (max-width: 1023px) {
    .ac { padding: 56px 0 64px; }
    .ac-head { display: block; }
    .ac-head :global(.ac-all) { display: none; }
    .ac-bento { grid-template-columns: 1fr 1fr; grid-template-rows: auto 220px 180px; gap: 12px; margin-top: 28px; }
    .ac-cell { grid-column: 1 / 3; grid-row: 1; width: auto; justify-self: stretch; margin: 0 0 4px; padding: 20px 18px 22px; border-radius: 18px; box-shadow: var(--sh-2); }
    .ac-t { font-size: 14px; line-height: 23px; }
    .ac-big { grid-column: 1 / 3; grid-row: 2; border-radius: var(--r-lg); }
    .ac-s1 { grid-column: 1; grid-row: 3; border-radius: var(--r-md); }
    .ac-s2 { grid-column: 2; grid-row: 3; border-radius: var(--r-md); }
    .ac-f :global(.ac-cap) { left: 10px; top: auto; bottom: 10px; max-width: calc(100% - 20px); font-size: 11px; line-height: 15px; }
    .ac :global(.ac-allm) { display: inline-flex; margin-top: 28px; }
  }
</style>
