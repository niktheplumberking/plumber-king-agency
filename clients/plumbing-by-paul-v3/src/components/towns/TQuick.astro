---
// C2 Quick answer + route card (Figma 440:2489 / 440:3544). The route card overlaps the hero's bottom edge by 48 px.
// Drive time is a labelled stand-in until measured on Google Maps (never guessed).
import QuickAnswer from '../ui/QuickAnswer.astro';
import RatingPill from '../ui/RatingPill.astro';
import TextLink from '../ui/TextLink.astro';
import Icon from '../ui/Icon.astro';
import RouteMap from './RouteMap.astro';
import { SITE } from '../../data/site';
import type { TownPageData } from '../../data/town-pages';
interface Props { t: TownPageData }
const { t } = Astro.props;
---
<section class="tq" aria-label={`Quick answer: plumber in ${t.name}`} data-m-section>
  <div class="wrap tq-in">
    <QuickAnswer class="tq-qa">
      <p set:html={t.quick} />
      <div class="tq-row"><RatingPill /><TextLink href={SITE.tel} icon="phone" size={15}>Call {SITE.phone}</TextLink></div>
    </QuickAnswer>
    <div class="tq-card" data-t="4" data-fx="rise">
      <RouteMap route={t.route.path} vb={t.route.vb} dest={t.route.dest} destLabel={t.route.destLabel} class="tq-map" />
      <p class="label tq-l">From our shop</p>
      <p class="tq-from">5565 64th Way N, St. Petersburg <span class="tq-to"><Icon name="arrow" size={16} />{t.name}</span></p>
      <p class="tq-slot"><Icon name="truck" size={16} /><span>[Drive time: measure on Google Maps before build]</span></p>
      <p class="tq-hours"><Icon name="clock" size={16} />{SITE.hours.office}</p>
    </div>
  </div>
</section>
<style>
  .tq { position: relative; z-index: 3; background: var(--white); padding: 0 0 96px; }
  .tq-in { display: grid; grid-template-columns: minmax(0, 664fr) minmax(0, 488fr); gap: 48px; align-items: start; }
  .tq-in :global(.tq-qa) { margin-top: 88px; padding: 28px 36px 28px 40px; }
  .tq-in :global(.tq-qa .qb) { font-size: 18px; line-height: 32px; }
  .tq-in :global(.tq-qa strong) { font-weight: 700; }
  .tq-row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; margin-top: 14px; }
  .tq-card { position: relative; margin-top: -48px; padding: 10px 10px 28px; border-radius: 24px; background: var(--white); box-shadow: var(--sh-3); }
  .tq-l { margin: 22px 18px 0; color: var(--press); }
  .tq-from { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; margin: 8px 18px 0; font-weight: 700; font-size: 16px; line-height: 24px; }
  .tq-to { display: inline-flex; align-items: center; gap: 8px; color: var(--press); }
  .tq-slot { display: flex; align-items: center; gap: 10px; margin: 14px 18px 0; padding: 8px 14px; border-radius: 12px; border: 1.5px dashed var(--blue); background: var(--mist); color: var(--press); font-weight: 600; font-size: 12px; line-height: 17px; }
  .tq-slot :global(svg) { flex: none; }
  .tq-hours { display: flex; align-items: center; gap: 10px; margin: 16px 18px 0; font-weight: 600; font-size: 14px; }
  .tq-hours :global(svg) { color: var(--blue); }
  @media (max-width: 1023px) {
    .tq { padding-bottom: 64px; }
    .tq-in { grid-template-columns: 1fr; gap: 32px; }
    .tq-card { order: 1; margin-top: -40px; }
    .tq-in :global(.tq-qa) { order: 2; margin-top: 0; padding: 22px 20px 22px 24px; }
    .tq-in :global(.tq-qa .qb) { font-size: 15px; line-height: 25px; }
    .tq-row :global(.tlink) { display: none; }
    .tq-from { font-size: 15px; }
  }
</style>
