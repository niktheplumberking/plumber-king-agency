---
// Round arrow (36-40 px). Decorative: put it inside the link it belongs to.
import Icon from './Icon.astro';
interface Props { d?: number; v?: 'navy' | 'press' | 'tint'; class?: string; icon?: string; }
const { d = 40, v = 'navy', class: cls, icon = 'arrow' } = Astro.props;
---
<span class:list={['adot', v, cls]} style={`--d:${d}px`} aria-hidden="true"><Icon name={icon} size={Math.round(d * 0.5)} /></span>
<style>
  .adot { display: grid; place-items: center; width: var(--d); height: var(--d); border-radius: 50%; flex: none; transition: transform var(--dur-2) var(--ease-out), background var(--dur-2); }
  .navy { background: var(--navy); color: var(--white); }
  .press { background: var(--press); color: var(--white); }
  .tint { background: var(--tint); color: var(--navy); }
</style>
