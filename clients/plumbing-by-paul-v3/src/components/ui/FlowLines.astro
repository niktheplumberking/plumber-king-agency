---
// Faint sky flow lines (hero, trust bento, waterline). Decorative. variant picks the Figma formula (flowLines.ts); the
// drawing is a cached static file, not inline SVG (QA round 2: Home HTML size and mobile LCP). The variant that a
// breakpoint hides with display: none is never fetched (lazy).
import { flowName, type FlowVariant } from './flowLines';
interface Props { variant?: FlowVariant; class?: string; opacity?: number; }
const { variant = 'hero', class: cls, opacity } = Astro.props;
---
<img class:list={['flow', cls]} src={`/flow/${flowName(variant, opacity)}.svg`} alt="" aria-hidden="true" loading="lazy" decoding="async" data-flow />
<style> .flow { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; pointer-events: none; } </style>
