---
// Responsive photo: AVIF + JPEG fallback via astro:assets <Picture>, srcset widths, `sizes`, and a focal point. No WebP
// source (QA round 2): AVIF covers current browsers; the rest get the JPEG, same picture. The WebP list cost ~0.8 KB
// (brotli) of Home HTML, part of what pushed mobile LCP to 2.6 s.
//   <Img name="hero-01-family-house-yard-signs-truck" alt="..." sizes="(min-width:1024px) 572px, 92vw" focus="100% 60%" />
// `name` = file name in src/assets/photos without .jpg. `priority` = the LCP image (eager + fetchpriority high, no lazy).
// The <img> fills its parent (object-fit: cover): size the parent, not the image.
// `box` / `boxM` = the rendered box's width / height on desktop (min-width slots) / on mobile (the fallback slot). When the
// photo is wider than its box, cover scales it past the box width, so `sizes` (a width) under-asks: those slots are multiplied
// by photo/box aspect (max 3) so the browser picks a file that is sharp after the crop (round 2: tall frames of landscape
// photos were 1.3-2.7x short on retina).
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { zoomSizes, zoomWidths, cropSizes } from './zoomSizes';
const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/*.{jpg,jpeg,png}', { eager: true });
interface Props {
  name: string; alt: string; sizes: string; focus?: string; priority?: boolean; widths?: number[]; class?: string;
  fit?: 'cover' | 'contain'; box?: number; boxM?: number; [k: string]: any;
}
const { name, alt, sizes, focus = '50% 50%', priority = false, widths, class: cls, fit = 'cover', box, boxM, ...rest } = Astro.props;
const key = Object.keys(photos).find((k) => k.split('/').pop()!.replace(/\.(jpe?g|png)$/, '') === name);
if (!key) throw new Error(`Img: no photo named "${name}" in src/assets/photos`);
const src = photos[key].default;
const cropOf = (b?: number) => (b == null || fit !== 'cover' ? 1 : Math.min(3, Math.max(1, src.width / src.height / b)));
const crop = cropOf(box), cropM = cropOf(boxM);
const z = zoomSizes(sizes);
const zs = crop > 1.02 || cropM > 1.02 ? cropSizes(z.sizes, crop, cropM) : z.sizes;
const w = zoomWidths(widths ?? [360, 540, 720, 960, 1280, 1600, 2000], z.slot, src.width);
if (crop > 1.02 && z.slot) { const need = Math.min(src.width, Math.ceil((z.slot * crop * 2) / 40) * 40); if (need > Math.max(...w)) w.push(need); }
---
<Picture src={src} alt={alt} widths={w} sizes={zs} formats={['avif']} fallbackFormat="jpg" quality={priority ? 60 : 62}
  loading={priority ? 'eager' : 'lazy'} decoding={priority ? 'sync' : 'async'} fetchpriority={priority ? 'high' : 'auto'}
  class:list={['img', cls]} style={`object-fit:${fit};object-position:${focus}`} {...rest} />
<style>
  :global(picture:has(> .img)) { display: contents; }
  .img { width: 100%; height: 100%; }
</style>
