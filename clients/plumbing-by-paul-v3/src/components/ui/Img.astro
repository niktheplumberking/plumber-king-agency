---
// Responsive photo: AVIF + WebP + JPEG fallback via astro:assets <Picture>, srcset widths, `sizes`, and a focal point.
//   <Img name="hero-01-family-house-yard-signs-truck" alt="..." sizes="(min-width:1024px) 572px, 92vw" focus="100% 60%" />
// `name` = file name in src/assets/photos without .jpg. `priority` = the LCP image (eager + fetchpriority high, no lazy).
// The <img> fills its parent (object-fit: cover): size the parent, not the image.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/*.{jpg,jpeg,png}', { eager: true });
interface Props {
  name: string; alt: string; sizes: string; focus?: string; priority?: boolean; widths?: number[]; class?: string;
  fit?: 'cover' | 'contain'; [k: string]: any;
}
const { name, alt, sizes, focus = '50% 50%', priority = false, widths, class: cls, fit = 'cover', ...rest } = Astro.props;
const key = Object.keys(photos).find((k) => k.split('/').pop()!.replace(/\.(jpe?g|png)$/, '') === name);
if (!key) throw new Error(`Img: no photo named "${name}" in src/assets/photos`);
const src = photos[key].default;
const w = (widths ?? [360, 540, 720, 960, 1280, 1600, 2000]).filter((x) => x <= src.width);
if (!w.length) w.push(src.width);
---
<Picture src={src} alt={alt} widths={w} sizes={sizes} formats={['avif', 'webp']} fallbackFormat="jpg" quality={priority ? 60 : 62}
  loading={priority ? 'eager' : 'lazy'} decoding={priority ? 'sync' : 'async'} fetchpriority={priority ? 'high' : 'auto'}
  class:list={['img', cls]} style={`object-fit:${fit};object-position:${focus}`} {...rest} />
<style>
  :global(picture:has(> .img)) { display: contents; }
  .img { width: 100%; height: 100%; }
</style>
