---
// Icon medallion: sky circle, white ring, navy icon, sticker shadow. Overlaps a photo/body seam.
import Icon from './Icon.astro';
interface Props { icon: string; d?: number; class?: string; style?: string; }
const { icon, d = 64, class: cls, style = '' } = Astro.props;
---
<span class:list={['medal', cls]} style={`--d:${d}px;${style}`} data-t="5" data-fx="pop" aria-hidden="true"><Icon name={icon} size={Math.round(d * 0.44)} /></span>
<style>
  .medal { display: grid; place-items: center; width: var(--d); height: var(--d); border-radius: 50%; background: var(--sky); color: var(--navy); box-shadow: 0 0 0 4px var(--white), var(--sh-sticker); }
</style>
