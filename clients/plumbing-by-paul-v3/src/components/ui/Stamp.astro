---
// Paul's promise stamp: navy disc, dashed sky ring, Russo text running round it, the seal in the middle.
// The text is Paul's own claim (STICKY 2: warranty terms). Decorative: the same promise is always in nearby text.
import Seal from './Seal.astro';
interface Props { d?: number; deg?: number; class?: string; text?: string; t?: string | false; }
const { d = 150, deg = -8, class: cls, text = "PAUL'S PROMISE · PRICE FIRST · 1-YEAR WARRANTY · ", t = '5' } = Astro.props;
const r = 50 - 10; // text radius in a 100 viewBox
const id = `stamp-${Math.random().toString(36).slice(2, 8)}`;
---
<span class:list={['stamp', cls]} style={`--d:${d}px;--deg:${deg}deg`} data-t={t === false ? undefined : t} data-fx="spin" aria-hidden="true">
  <svg viewBox="0 0 100 100" class="ring">
    <circle cx="50" cy="50" r="50" fill="#111032" />
    <circle cx="50" cy="50" r="46.5" fill="none" stroke="#61ADCB" stroke-width=".7" stroke-dasharray="2 2" />
    <defs><path id={id} d={`M50 50 m0 -${r} a${r} ${r} 0 1 1 0 ${2 * r} a${r} ${r} 0 1 1 0 -${2 * r}`} /></defs>
    <text font-family="Russo One, sans-serif" font-size="7.6" fill="#FFFFFF" letter-spacing=".4"><textPath href={`#${id}`} textLength={2 * Math.PI * r - 2}>{text}</textPath></text>
  </svg>
  <Seal d={d - 52} flat t={false} class="core" />
</span>
<style>
  .stamp { position: relative; display: block; width: var(--d); height: var(--d); border-radius: 50%; transform: rotate(var(--deg)); box-shadow: var(--sh-sticker); flex: none; }
  .ring { position: absolute; inset: 0; width: 100%; height: 100%; }
  /* In proportion, so a page can resize the stamp with --d (the core is 66 % of the disc, inside the ring text). */
  .stamp :global(.core) { position: absolute; left: 17%; top: 17%; width: 66%; height: 66%; }
</style>
