---
// The waterline: two wave layers (soft behind, sky in front) that drift slowly (CSS, paused for reduced motion).
// Each layer is a div with a seamless 720 px wave tile as a repeating background, one tile wider than the band, moved by
// transform only. (QA: the earlier 200%-wide animated SVGs were left part-painted by Chrome, which showed a light
// rectangle in the front wave behind the call buttons.)
interface Props { class?: string; amp?: number; }
const { class: cls, amp = 14 } = Astro.props;
const tile = 720, wl = 360, h = 120;
const wave = (y0: number, fill: string) => {
  let d = `M0 ${h} L0 ${y0}`; const half = wl / 2; let up = true;
  for (let x = 0; x < tile; x += half) { d += ` Q${x + half / 2} ${y0 + (up ? -amp : amp)} ${x + half} ${y0}`; up = !up; }
  d += ` L${tile} ${h}Z`;
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${tile} ${h}" preserveAspectRatio="none"><path fill="${fill}" d="${d}"/></svg>`;
  return `url("data:image/svg+xml,${encodeURIComponent(svg)}")`;
};
---
<div class:list={['water', cls]} aria-hidden="true" data-water>
  <div class="w w1" style={`background-image:${wave(amp + 2, '#A9D3E4')};background-position:-90px 0`}></div>
  <div class="w w2" style={`background-image:${wave(amp + 14, '#61ADCB')}`}></div>
</div>
<style>
  .water { position: absolute; left: 0; right: 0; height: 120px; overflow: hidden; pointer-events: none; }
  .w { position: absolute; top: 0; left: 0; width: calc(100% + 720px); height: 100%; background-repeat: repeat-x; background-size: 720px 100%; }
  :global(html.motion) .w1 { animation: drift 11s linear infinite; }
  :global(html.motion) .w2 { animation: drift 7.5s linear infinite reverse; }
  @keyframes drift { to { transform: translateX(-720px); } }
</style>
