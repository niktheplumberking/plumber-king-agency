---
// O1 Our work hero (Figma 439:5903 O1): centred breadcrumb, eyebrow, H1, lead and buttons over flow lines; an "all ours"
// script note and a "Shot on the job" chip float either side; four framed job photos fan out below (-5, -2, 2, 5 deg),
// overlapping each other and the gallery's top edge, with the seal on the join of the middle two.
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import CallButton from '../ui/CallButton.astro';
import Button from '../ui/Button.astro';
import Img from '../ui/Img.astro';
import Icon from '../ui/Icon.astro';
import Seal from '../ui/Seal.astro';
import FlowLines from '../ui/FlowLines.astro';
const fan = [
  { n: 'service-tech-under-bath-vanity', alt: 'A tech lying on a bathroom floor working under a vanity', deg: -5, f: '50% 50%' },
  { n: 'service-tech-logo-shirt-framing', alt: 'A tech in a Plumbing By Paul shirt working among new wall framing', deg: -2, f: '50% 40%' },
  { n: 'fleet-van-at-coastal-stilt-house', alt: 'A Plumbing By Paul van parked at a raised coastal house', deg: 2, f: '50% 60%' },
  { n: 'service-two-techs-vanity-install', alt: 'Two techs kneeling to install a bathroom vanity', deg: 5, f: '50% 50%' },
];
---
<section class="oh" aria-labelledby="oh-h" data-m-section data-m-hero>
  <FlowLines variant="hero" class="oh-fl" />
  <div class="wrap oh-in">
    <div class="oh-bc"><Breadcrumbs items={[{ label: 'Our work', href: '/our-work' }]} /></div>
    <Eyebrow text="Our work" class="oh-eb" />
    <h1 class="display oh-h1" id="oh-h" data-t="2"><span class="hl">Real jobs,</span> <span class="hl l2">real Pinellas homes</span></h1>
    <p class="lead oh-lead" data-t="3" data-fx="nudge">No stock photos. Every picture on this page was taken by our crew, on a job, with a phone.</p>
    <div class="oh-btns" data-t="3" data-stagger>
      <CallButton />
      <Button href="#estimate" v="sec" icon="clipboard" h64 magnetic={false}>Get a free estimate</Button>
    </div>
    <p class="script oh-ours" aria-hidden="true" data-t="5" data-fx="pop">all ours</p>
    <p class="oh-chip" aria-hidden="true" data-t="5" data-fx="pop"><Icon name="camera" size={16} />Shot on the job</p>
  </div>
  <ul role="list" class="oh-fan" data-t="4" data-stagger aria-label="Four job photos">
    {fan.map((p, i) => (
      <li class:list={['oh-p', `p${i}`]} style={`--deg:${p.deg}deg`} data-fx="frame">
        <div class="oh-ph frame"><Img name={p.n} alt={p.alt} focus={p.f} priority={i === 1} sizes="(min-width: 1024px) 298px, 44vw" widths={[300, 600]} /></div>
      </li>
    ))}
    <li class="oh-seal" aria-hidden="true"><Seal d={111} deg={-6} /></li>
  </ul>
</section>
<style>
  .oh { position: relative; z-index: 2; background: var(--white); padding: 60px 0 0; height: 740px; }
  .oh :global(.oh-fl) { position: absolute; inset: 0; overflow: hidden; }
  .oh-in { position: relative; z-index: 1; display: grid; justify-items: center; text-align: center; }
  .oh-in :global(.oh-eb) { margin-top: 12px; }
  .oh-h1 { margin-top: 14px; line-height: 1.0667; }
  .hl { display: block; } .hl.l2 { color: var(--blue); }
  .oh-lead { margin-top: 20px; max-width: 520px; }
  .oh-btns { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 28px; }
  .oh-ours { position: absolute; left: 119px; top: 248px; font-size: 40px; color: var(--blue); transform: rotate(-10deg); }
  .oh-chip { position: absolute; left: 952px; top: 239px; display: inline-flex; align-items: center; gap: 8px; height: 44px; padding: 0 16px; border-radius: 12px; background: var(--white); box-shadow: var(--sh-2); font-weight: 700; font-size: 14px; color: var(--navy); transform: rotate(4deg); }
  .oh-chip :global(svg) { color: var(--blue); }
  .oh-fan { position: absolute; left: 50%; top: 476px; width: 1041px; height: 352px; margin: 0 0 0 -520px; padding: 0; list-style: none; }
  .oh-p { position: absolute; top: 0; transform: rotate(var(--deg)); }
  .oh-ph { width: 100%; height: 100%; border-radius: var(--r-xl); box-shadow: 0 0 0 7px var(--white), var(--sh-3); }
  .oh-ph :global(img) { display: block; }
  .p0 { left: 0; top: 25px; width: 298px; height: 352px; z-index: 1; }
  .p1 { left: 246px; top: 0; width: 281px; height: 339px; z-index: 2; }
  .p2 { left: 496px; top: -10px; width: 281px; height: 339px; z-index: 1; }
  .p3 { left: 743px; top: 2px; width: 298px; height: 352px; z-index: 2; }
  .oh-seal { position: absolute; left: 466px; top: -46px; z-index: 3; }
  @media (max-width: 1199px) { .oh-ours, .oh-chip { display: none; } .oh-fan { transform: scale(.9); transform-origin: top center; } }
  @media (max-width: 1023px) {
    .oh { height: auto; padding: 32px 0 0; overflow-x: clip; }
    .oh :global(.oh-fl) { display: none; }
    .oh-in { justify-items: start; text-align: left; }
    .oh-bc { justify-self: start; }
    .oh-h1 { font-size: 40px; line-height: 44px; }
    .oh-lead { margin-top: 16px; font-size: 16px; line-height: 26px; }
    .oh-btns { display: grid; width: 100%; gap: 10px; margin-top: 24px; }
    .oh-btns :global(.btn) { width: 100%; }
    .oh-btns :global(.btn-sec) { min-height: 56px; }
    .oh-fan { position: relative; left: 50%; top: auto; width: 620px; height: 260px; margin: 44px 0 -96px -310px; transform: none; }
    .p0 { left: 0; top: 18px; width: 166px; height: 210px; }
    .p1 { left: 150px; top: 0; width: 160px; height: 200px; }
    .p2 { left: 300px; top: -4px; width: 160px; height: 200px; }
    .p3 { left: 450px; top: 6px; width: 166px; height: 210px; }
    .oh-seal { left: 276px; top: -34px; }
    .oh-seal :global(.seal) { --d: 64px !important; }
  }
</style>
