---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logo from '../assets/img/logo-united.png';
import { SITE } from '../data/site';
import { SERVICES } from '../data/services';
import { TOWNS } from '../data/towns';
const year = 2026;
---
<footer class="ftr dark" data-footer>
  <div class="wrap ftr-grid">
    <div class="ftr-brand" data-reveal="up">
      <a href="/" class="ftr-logo" aria-label="United Plumbing home"><Image src={logo} alt="United Plumbing logo" width={240} height={182} /></a>
      <p class="h-display ftr-name">United Plumbing</p>
      <p class="ftr-blurb">24/7 plumbing for Pomona and the Inland Empire. Family run by the Galvez brothers.</p>
      <div class="ftr-soc">
        <a href={SITE.instagram} target="_blank" rel="noopener" aria-label="Instagram @plumblord1"><Icon name="instagram" size={18} /></a>
        <a href={SITE.facebook} target="_blank" rel="noopener" aria-label="Facebook"><Icon name="facebook" size={18} /></a>
      </div>
    </div>
    <nav class="ftr-col" aria-label="Footer menu" data-reveal="up">
      <p class="ftr-h">Menu</p>
      <ul><li><a href="/">Home</a></li><li><a href="/services/">Services</a></li><li><a href="/about/">About</a></li><li><a href="/areas/">Areas</a></li><li><a href="/reviews/">Reviews</a></li><li><a href="/our-work/">Our work</a></li></ul>
    </nav>
    <nav class="ftr-col" aria-label="Footer services" data-reveal="up">
      <p class="ftr-h">Services</p>
      <ul>{SERVICES.slice(0, 6).map((s) => <li><a href={`/${s.slug}/`}>{s.nav}</a></li>)}</ul>
    </nav>
    <div class="ftr-col ftr-contact" data-reveal="up">
      <p class="ftr-h">Contact</p>
      <ul>
        <li><a href={SITE.phoneHref}><span class="fi"><Icon name="phone" size={14} /></span>{SITE.phone} (24/7)</a></li>
        <li><a href={SITE.backupHref}><span class="fi"><Icon name="phone" size={14} /></span>Backup: {SITE.backupPhone}</a></li>
        <li><span class="fi"><Icon name="clock" size={14} /></span>Open 24 hours, 7 days</li>
        <li><a href="/contact/"><span class="fi"><Icon name="pin" size={14} /></span>Pomona, CA · Inland Empire</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap ftr-lic"><span class="licline" title="Placeholder: to be filled before launch">[CSLB line: Jim's state contractor status goes here. Jim to confirm before launch]</span></div>
  <div class="ftr-bottom">
    <div class="wrap ftr-bottom-in">
      <span class="ftr-copy">© {year} United Plumbing</span><span aria-hidden="true" class="ftr-dot1">·</span>
      <span>Website by <a href="https://plumberkingagency.com" target="_blank" rel="noopener">Plumber King Agency</a></span><span aria-hidden="true">·</span>
      <a href="/privacy/">Privacy</a><span aria-hidden="true">·</span><a href="/terms/">Terms</a>
    </div>
  </div>
</footer>
<style>
  /* Figma 232:560 (homepage footer): 420 tall incl. 50 px cobalt bar; columns at x 80 / 520 / 740 / 1000 */
  .ftr.dark { background: #070a12; padding-top: 70px; }
  .ftr-grid { display: grid; grid-template-columns: 440fr 220fr 260fr 360fr; gap: 0; }
  .ftr-logo { display: grid; place-items: center; width: 110px; height: 88px; border-radius: 10px; background: #fff; }
  .ftr-logo img { width: 98px; height: 80px; object-fit: contain; }
  .ftr-name { font-size: 24px; line-height: 29px; letter-spacing: .02em; color: #fff; margin-top: 18px; }
  .ftr-blurb { color: #a3aec6; margin-top: 5px; font-size: 14px; line-height: 1.5; max-width: 320px; }
  .ftr-soc { display: flex; gap: 10px; margin-top: 20px; }
  .ftr-soc a { position: relative; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 6px; background: var(--cobalt); color: #fff; transition: transform .3s var(--ease-out), background .3s; }
  .ftr-soc a::after { content: ''; position: absolute; inset: -5px; }
  .ftr-soc a:hover { transform: translateY(-3px); background: #3a68ee; }
  .ftr-col { padding-top: 4px; }
  .ftr-h { font-weight: 700; color: #fff; font-size: 18px; line-height: 23px; margin-bottom: 11px; }
  .ftr-col ul { display: grid; gap: 10px; }
  .ftr-col a, .ftr-col li { color: #a3aec6; font-size: 14px; line-height: 18px; }
  .ftr-col a { display: inline-flex; align-items: center; gap: 12px; transition: color .2s; }
  .ftr-col a:hover { color: var(--cyan); }
  .ftr-contact ul { gap: 12px; }
  .ftr-contact li { display: flex; align-items: center; gap: 12px; min-height: 28px; color: #fff; }
  .ftr-contact a { color: #fff; }
  .fi { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--cobalt); color: #fff; flex: none; }
  .ftr-lic { padding: 19px 0 18px; line-height: 1; }
  .ftr-bottom { background: var(--cobalt); color: #fff; font-size: 13px; line-height: 17px; font-weight: 500; }
  .ftr-bottom-in { display: flex; justify-content: center; flex-wrap: wrap; gap: 4px 10px; min-height: 50px; align-items: center; padding: 8px 0; text-align: center; }
  .ftr-bottom a { text-underline-offset: 3px; }
  .ftr-bottom a:hover { text-decoration: underline; }
  @media (max-width: 1100px) { .ftr-grid { grid-template-columns: 1fr 1fr 1fr; gap: 40px 20px; } .ftr-brand { grid-column: 1 / -1; } }
  /* Figma 236:702 (phone footer): 590 tall incl. 64 px cobalt bar and 80 px kept free for the sticky call bar */
  @media (max-width: 640px) {
    .ftr.dark { padding-top: 40px; padding-bottom: 80px; }
    .ftr-grid { grid-template-columns: 1fr; gap: 0; }
    .ftr-brand { display: contents; }
    .ftr-col:not(.ftr-contact) { display: none; }
    .ftr-logo { order: 1; width: 90px; height: 72px; border-radius: 8px; }
    .ftr-logo img { width: 80px; height: 64px; }
    .ftr-name { order: 2; margin-top: 14px; font-size: 22px; line-height: 26px; }
    .ftr-blurb { order: 3; margin-top: 6px; font-size: 14px; line-height: 20px; max-width: none; }
    .ftr-contact { order: 4; padding-top: 18px; }
    .ftr-contact .ftr-h { display: none; }
    .ftr-contact li, .ftr-contact a { gap: 10px; }
    .ftr-soc { order: 5; gap: 8px; margin-top: 22px; }
    .ftr-lic { padding: 14px 0; line-height: 1.3; }
    .ftr-bottom { font-size: 12px; line-height: 18px; }
    .ftr-bottom-in { min-height: 64px; gap: 0 8px; padding: 12px 0 10px; }
    .ftr-copy { flex-basis: 100%; }
    .ftr-dot1 { display: none; }
  }
</style>
