---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Btn from './Btn.astro';
import logo from '../assets/img/logo-united.jpg';
import { SITE } from '../data/site';
import { SERVICES, FAMILIES } from '../data/services';
const path = Astro.url.pathname;
const fams = (Object.keys(FAMILIES) as (keyof typeof FAMILIES)[]).map((k) => ({ k, ...FAMILIES[k], items: SERVICES.filter((s) => s.family === k) }));
const nav = [
  { href: '/about/', label: 'About' },
  { href: '/areas/', label: 'Areas' },
  { href: '/reviews/', label: 'Reviews' },
  { href: '/contact/', label: 'Contact' },
];
---
<div class="topbar" data-intro="topbar">
  <div class="wrap topbar-in">
    <p class="tb-alert"><Icon name="alert" size={16} /><span class="tb-long">Burst pipe or no hot water? Call now. A real person answers 24/7.</span><span class="tb-short">Burst pipe? A real person answers 24/7</span>
      <a href={SITE.phoneHref} class="tb-phone"><Icon name="phone" size={14} />{SITE.phone}</a></p>
    <div class="tb-right">
      <span class="tb-lang"><Icon name="globe" size={15} /><span class="tb-long">Hablamos Español</span><span class="tb-short">ES</span></span>
      <a href={SITE.instagram} aria-label="Instagram @plumblord1" target="_blank" rel="noopener" class="tb-soc"><Icon name="instagram" size={17} /></a>
      <a href={SITE.facebook} aria-label="Facebook: Jim United Plumbing Official" target="_blank" rel="noopener" class="tb-soc"><Icon name="facebook" size={16} /></a>
    </div>
  </div>
</div>
<header class="hdr" data-header>
  <div class="hdr-bar">
    <div class="wrap hdr-in">
      <a href="/" class="brand" aria-label="United Plumbing home" data-intro="brand">
        <span class="brand-panel" aria-hidden="true"></span>
        <Image src={logo} alt="United Plumbing logo" width={160} height={113} class="brand-logo" loading="eager" />
        <span class="brand-txt"><strong>United Plumbing</strong><small>Pomona, CA · Inland Empire</small></span>
      </a>
      <nav class="nav" aria-label="Main">
        <ul class="nav-list">
          <li class="has-mega" data-intro="nav">
            <a href="/services/" class:list={["nav-a", { on: path.startsWith('/services') || SERVICES.some((s) => path.includes(s.slug)) }]} aria-haspopup="true">Services <Icon name="chevronDown" size={14} /></a>
            <div class="mega" role="menu">
              <div class="mega-grid">
                {fams.map((f) => (
                  <div class="mega-col">
                    <p class="mega-h"><span class="led">{f.num}</span> {f.name}</p>
                    <ul>{f.items.map((s) => <li><a role="menuitem" href={`/${s.slug}/`}>{s.name}<Icon name="arrow" size={14} /></a></li>)}</ul>
                  </div>
                ))}
              </div>
              <a href="/services/" class="mega-all">See all 13 services <Icon name="arrow" size={16} /></a>
            </div>
          </li>
          {nav.map((n) => <li data-intro="nav"><a href={n.href} class:list={["nav-a", { on: path.startsWith(n.href) }]}>{n.label}</a></li>)}
        </ul>
      </nav>
      <div class="hdr-cta">
        <span data-intro="nav"><Btn href={SITE.smsHref} variant="outline-cyan" icon="message" size="md" class="hdr-text">Text a photo</Btn></span>
        <span data-intro="nav"><Btn href={SITE.phoneHref} variant="yellow" icon="phone" size="md" sub="Tap to call · 24/7" class="hdr-call">{SITE.phone}</Btn></span>
        <a href={SITE.phoneHref} class="m-call" aria-label={`Call ${SITE.phone}`}><Icon name="phone" size={22} /></a>
        <button class="m-menu" aria-label="Open menu" aria-expanded="false" aria-controls="mnav" data-menu-open><Icon name="menu" size={22} /></button>
      </div>
    </div>
  </div>
</header>

<div class="mnav" id="mnav" data-mnav hidden>
  <div class="mnav-in">
    <div class="mnav-top">
      <span class="h-display mnav-title">Menu</span>
      <button class="m-menu" aria-label="Close menu" data-menu-close><Icon name="close" size={22} /></button>
    </div>
    <ul class="mnav-list">
      <li><a href="/">Home</a></li>
      <li><a href="/services/">Services</a></li>
      <li><a href="/areas/">Areas</a></li>
      <li><a href="/about/">About</a></li>
      <li><a href="/our-work/">Our work</a></li>
      <li><a href="/reviews/">Reviews</a></li>
      <li><a href="/contact/">Contact</a></li>
    </ul>
    <div class="mnav-svc">
      <p class="eyebrow on-dark">Popular services</p>
      <div class="mnav-chips">{SERVICES.slice(0, 8).map((s) => <a href={`/${s.slug}/`}>{s.nav}</a>)}</div>
    </div>
    <div class="mnav-cta">
      <Btn href={SITE.phoneHref} icon="phone" full size="md">Call {SITE.phone}</Btn>
      <Btn href={SITE.smsHref} variant="outline-cyan" icon="message" full size="md">Text a photo</Btn>
    </div>
  </div>
</div>

<style>
  .topbar { background: var(--yellow); color: var(--ink); font-size: 13px; font-weight: 600; position: relative; z-index: 61; }
  .topbar-in { display: flex; align-items: center; justify-content: space-between; min-height: 44px; gap: 16px; }
  .tb-alert { display: flex; align-items: center; gap: 8px; }
  .tb-phone { display: inline-flex; align-items: center; gap: 6px; margin-left: 14px; font-weight: 700; }
  .tb-phone:hover, .tb-soc:hover { text-decoration: underline; opacity: .75; }
  .tb-right { display: flex; align-items: center; gap: 14px; }
  .tb-lang { display: inline-flex; align-items: center; gap: 6px; }
  .tb-short { display: none; }
  .tb-soc { display: grid; place-items: center; min-width: 24px; min-height: 24px; transition: opacity .2s; }

  .hdr { position: sticky; top: 0; z-index: 60; transition: transform .45s var(--ease-out); }
  .hdr.is-hidden { transform: translateY(-100%); }
  .hdr-bar { background: var(--night); position: relative; transition: box-shadow .3s; }
  .hdr.is-scrolled .hdr-bar { box-shadow: 0 12px 40px -18px rgba(0,0,0,.6); }
  .hdr-in { display: flex; align-items: center; gap: 28px; min-height: 96px; transition: min-height .35s var(--ease-out); }
  .hdr.is-scrolled .hdr-in { min-height: 80px; }
  .brand { position: relative; display: flex; align-items: center; gap: 14px; align-self: stretch; padding-right: 64px; isolation: isolate; }
  .brand-panel { position: absolute; z-index: -1; top: 0; bottom: 0; right: 0; left: -100vw; background: #fff; clip-path: polygon(0 0, 100% 0, calc(100% - 46px) 100%, 0 100%); }
  .brand-panel::after { content: ''; }
  .brand::after { content: ''; position: absolute; z-index: -2; top: 0; bottom: 0; right: -14px; width: 60px; background: var(--cyan); clip-path: polygon(46px 0, 60px 0, 14px 100%, 0 100%); }
  .brand-logo { width: 76px; height: auto; border-radius: 6px; }
  .brand-txt { display: grid; line-height: 1.1; color: var(--ink); }
  .brand-txt strong { font-family: var(--display); font-weight: 900; font-size: 26px; text-transform: uppercase; letter-spacing: .01em; }
  .brand-txt small { font-size: 12px; color: var(--ink-2); margin-top: 3px; }
  .nav { margin-left: auto; }
  .nav-list { display: flex; gap: 6px; }
  .nav-a { position: relative; display: inline-flex; align-items: center; gap: 4px; padding: 12px 12px; color: #fff; font-weight: 500; font-size: 15px; }
  .nav-a::after { content: ''; position: absolute; left: 12px; right: 12px; bottom: 6px; height: 2px; background: var(--cyan); transform: scaleX(0); transform-origin: right; transition: transform .35s var(--ease-out); }
  .nav-a:hover::after, .nav-a.on::after, .has-mega:focus-within > .nav-a::after { transform: scaleX(1); transform-origin: left; }
  .has-mega { position: relative; }
  .has-mega .nav-a .icon { transition: transform .3s; }
  .has-mega:hover .nav-a .icon, .has-mega:focus-within .nav-a .icon { transform: rotate(180deg); }
  .mega { position: absolute; left: -40px; top: calc(100% + 18px); width: 760px; background: var(--night2); border: 1px solid var(--line-dark); border-radius: 16px; padding: 26px; box-shadow: 0 40px 80px -30px rgba(0,0,0,.7); opacity: 0; visibility: hidden; transform: translateY(10px); transition: opacity .3s, transform .4s var(--ease-out), visibility .3s; }
  .mega::before { content: ''; position: absolute; left: 0; right: 0; top: -20px; height: 20px; }
  .has-mega:hover .mega, .has-mega:focus-within .mega { opacity: 1; visibility: visible; transform: none; }
  .mega-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .mega-h { font-family: var(--display); font-weight: 800; text-transform: uppercase; color: #fff; font-size: 18px; margin-bottom: 10px; }
  .mega-h .led { color: var(--yellow); font-size: 16px; }
  .mega-col a { display: flex; justify-content: space-between; align-items: center; gap: 6px; padding: 7px 0; color: var(--on-dark-2); font-size: 14px; border-bottom: 1px solid rgba(255,255,255,.06); transition: color .2s, padding .3s var(--ease-out); }
  .mega-col a .icon { opacity: 0; transform: translateX(-6px); transition: .3s var(--ease-out); color: var(--cyan); }
  .mega-col a:hover { color: #fff; padding-left: 4px; }
  .mega-col a:hover .icon { opacity: 1; transform: none; }
  .mega-all { margin-top: 18px; display: inline-flex; align-items: center; gap: 8px; color: var(--yellow); font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: 18px; }
  .hdr-cta { display: flex; align-items: center; gap: 14px; }
  .hdr-cta :global(.btn) { --bh: 60px; }
  .m-call, .m-menu { display: none; }
  @media (max-width: 1240px) { .hdr-text { display: none !important; } }
  @media (max-width: 1060px) {
    .nav, .hdr-cta > span { display: none; }
    .hdr-cta { margin-left: auto; gap: 10px; }
    .m-call, .m-menu { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 10px; }
    .m-call { background: var(--yellow); color: var(--ink); }
    .m-menu { color: #fff; box-shadow: inset 0 0 0 1.5px rgba(255,255,255,.5); }
  }
  @media (max-width: 720px) {
    .tb-long { display: none; } .tb-short { display: inline; } .tb-phone, .tb-soc { display: none; }
    .topbar { font-size: 12px; } .topbar-in { min-height: 36px; }
    .hdr-in, .hdr.is-scrolled .hdr-in { min-height: 72px; }
    .brand { padding-right: 46px; gap: 10px; }
    .brand-logo { width: 60px; }
    .brand-txt strong { font-size: 20px; line-height: .95; max-width: 90px; }
    .brand-txt small { display: none; }
  }
  .mnav { position: fixed; inset: 0; z-index: 90; background: var(--night); color: #fff; overflow-y: auto; }
  .mnav[hidden] { display: none; }
  .mnav-in { min-height: 100%; padding: 18px var(--gutter) 40px; display: flex; flex-direction: column; gap: 28px; }
  .mnav-top { display: flex; justify-content: space-between; align-items: center; }
  .mnav-title { font-size: 28px; color: var(--yellow); }
  .mnav .m-menu { display: grid; }
  .mnav-list a { display: block; font-family: var(--display); font-weight: 900; text-transform: uppercase; font-size: 46px; line-height: 1.08; padding: 2px 0; }
  .mnav-list a:hover { color: var(--cyan); }
  .mnav-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .mnav-chips a { padding: 9px 12px; border: 1px solid var(--line-dark); border-radius: 8px; font-size: 14px; font-weight: 600; background: var(--night2); }
  .mnav-cta { display: grid; gap: 12px; margin-top: auto; }
</style>
