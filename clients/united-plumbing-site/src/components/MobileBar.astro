---
import Icon from './Icon.astro';
import { SITE } from '../data/site';
---
<div class="mbar" data-mbar>
  <a href={SITE.phoneHref} class="mbar-call" data-btn><span class="btn-fill" aria-hidden="true"></span><Icon name="phone" size={22} /><span>Call now · 24/7</span></a>
  <a href={SITE.smsHref} class="mbar-text" data-btn><span class="btn-fill" aria-hidden="true"></span><Icon name="message" size={20} /><span>Text</span></a>
</div>
<style>
  .mbar { display: none; }
  @media (max-width: 760px) {
    .mbar { display: grid; grid-template-columns: 1fr auto; gap: 10px; position: fixed; z-index: 55; left: 12px; right: 12px; bottom: max(12px, env(safe-area-inset-bottom)); transform: translateY(140%); transition: transform .5s var(--ease-out); }
    .mbar.is-on { transform: none; }
    .mbar a { position: relative; overflow: hidden; isolation: isolate; display: flex; align-items: center; justify-content: center; gap: 10px; height: 58px; border-radius: 12px; font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: 24px; }
    .mbar-call { background: var(--yellow); color: var(--ink); box-shadow: 0 14px 30px -10px rgba(0,0,0,.5); }
    .mbar-text { padding: 0 20px; background: var(--night); color: var(--cyan); box-shadow: inset 0 0 0 2px var(--cyan), 0 14px 30px -10px rgba(0,0,0,.5); }
    .mbar .btn-fill { position: absolute; z-index: -1; width: 40px; height: 40px; border-radius: 50%; transform: translate(-50%,-50%) scale(0); background: rgba(255,255,255,.35); }
  }
</style>
