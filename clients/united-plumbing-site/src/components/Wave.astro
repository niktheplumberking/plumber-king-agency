---
// Brand motif: wave edge with the cyan "water line". `from` = colour above, `to` = colour below.
interface Props { from: string; to: string; flip?: boolean }
const { from, to, flip = false } = Astro.props;
const d = flip
  ? 'M0,50 C240,10 480,10 720,32 C960,54 1200,62 1440,22'
  : 'M0,22 C240,62 480,54 720,32 C960,10 1200,10 1440,50';
---
<svg class="wave" viewBox="0 0 1440 72" preserveAspectRatio="none" aria-hidden="true" style={`background:${from}`}>
  <path d={`${d} L1440,72 L0,72 Z`} fill={to} />
  <path class="wave-line" d={d} data-draw vector-effect="non-scaling-stroke" />
</svg>
