---
// Visible breadcrumb for the company pages (the JSON-LD BreadcrumbList comes from Base).
interface Props { items: { name: string; href: string }[] }
const { items } = Astro.props;
---
<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    {items.map((c, i) => (
      <li>{i === items.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}</li>
    ))}
  </ol>
</nav>
<style>
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 6px; font-size: 13px; font-weight: 500; color: var(--on-dark-2); }
  .crumbs li + li::before { content: '/'; margin-right: 6px; opacity: .6; }
  .crumbs a { display: inline-block; padding: 4px 0; transition: color .2s; }
  .crumbs a:hover { color: #fff; }
  .crumbs [aria-current] { color: var(--cyan); }
</style>
