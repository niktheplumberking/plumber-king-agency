---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import Eyebrow from '../Eyebrow.astro';
import CallbackForm from './CallbackForm.astro';
import bg from '../../assets/img/night-pipes.jpg';
import { SITE } from '../../data/site';
interface Props { line1?: string; line2?: string; text?: string; id?: string }
const { line1 = 'Need a plumber?', line2 = 'Call Jim now.', text = "Burst pipe, backed-up drain or no hot water? Call or text any hour. Or leave your number and Jim's team calls you back.", id = 'contact' } = Astro.props;
---
<section class="ct dark" id={id}>
  <div class="ct-bg" aria-hidden="true"><Image src={bg} alt="" widths={[720, 1344]} sizes="100vw" data-parallax="0.18" /></div>
  <div class="wrap ct-grid">
    <div class="ct-left">
      <Eyebrow>Get in touch</Eyebrow>
      <h2 class="h-display h2 ct-h" data-split><span class="c-white">{line1}</span><br /><span class="c-yellow">{line2}</span></h2>
      <p class="lead ct-p" data-reveal="up">{text}</p>
      <a href={SITE.phoneHref} class="ledbox" data-reveal="up" aria-label={`Tap to call ${SITE.phone}`}>
        <span class="ledbox-top led"><span>TAP TO CALL</span><span>·</span><span>24/7</span><span class="hide-m">·</span><span class="hide-m">ESPAÑOL</span></span>
        <span class="ledbox-dot" aria-hidden="true"></span>
        <span class="ledbox-num led">{SITE.phone}</span>
      </a>
      <div class="ct-minis" data-stagger="up">
        <a href={SITE.smsHref} class="ct-mini"><span class="ct-mi"><Icon name="camera" size={18} /></span><small>Get a price range</small><strong>Text a photo</strong></a>
        <a href={SITE.phoneHref} class="ct-mini"><span class="ct-mi"><Icon name="globe" size={18} /></span><small>Ask for Jim</small><strong>Hablamos Español</strong></a>
        <a href="/areas/" class="ct-mini"><span class="ct-mi"><Icon name="pin" size={18} /></span><small>28 towns covered</small><strong>Pomona &amp; the IE</strong></a>
      </div>
    </div>
    <div class="ct-right" data-reveal="right"><CallbackForm variant="card" id={`${id}-form`} /></div>
  </div>
</section>
<style>
  .ct { position: relative; overflow: hidden; padding-block: clamp(80px, 9vw, 120px); }
  .ct-bg { position: absolute; inset: -10% 0; opacity: .5; }
  .ct-bg img { width: 100%; height: 100%; object-fit: cover; }
  .ct::before { content: ''; position: absolute; inset: 0; z-index: 1; background: linear-gradient(90deg, rgba(11,15,26,.97) 0%, rgba(11,15,26,.85) 45%, rgba(11,15,26,.55) 100%); }
  .ct-grid { position: relative; z-index: 2; display: grid; grid-template-columns: 1.1fr .9fr; gap: 60px; align-items: start; }
  .ct-h { margin-top: 16px; font-size: clamp(54px, 7vw, 92px); }
  .ct-p { margin-top: 22px; max-width: 520px; }
  .ledbox { position: relative; display: block; margin-top: 34px; max-width: 560px; padding: 20px 24px 22px; border: 2px solid var(--cobalt); border-radius: 12px; background: #070a12; box-shadow: 0 0 40px -10px rgba(31,79,216,.6), inset 0 0 30px rgba(31,79,216,.15); transition: transform .4s var(--ease-out), box-shadow .4s; }
  .ledbox:hover { transform: translateY(-3px); box-shadow: 0 0 60px -6px rgba(31,79,216,.8), inset 0 0 30px rgba(31,79,216,.2); }
  .ledbox-top { display: flex; gap: 14px; color: var(--cyan); font-size: 14px; letter-spacing: .12em; }
  .ledbox-dot { position: absolute; right: 24px; top: 22px; width: 12px; height: 12px; border-radius: 50%; background: #ff3b3b; box-shadow: 0 0 12px #ff3b3b; animation: blink 1.4s steps(2) infinite; }
  @keyframes blink { 50% { opacity: .25; } }
  .ledbox-num { display: block; margin-top: 8px; color: var(--yellow); font-size: clamp(40px, 5.6vw, 64px); line-height: 1; text-shadow: 0 0 18px rgba(255,210,31,.6); white-space: nowrap; }
  .ct-minis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 18px; max-width: 560px; }
  .ct-mini { display: grid; gap: 2px; padding: 16px; border-radius: 12px; background: rgba(19,27,46,.8); border: 1px solid var(--line-dark); transition: transform .35s var(--ease-out), border-color .3s; }
  .ct-mini:hover { transform: translateY(-4px); border-color: var(--cyan); }
  .ct-mi { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 8px; background: var(--cobalt); color: #fff; margin-bottom: 8px; }
  .ct-mini small { color: var(--on-dark-2); font-size: 12px; }
  .ct-mini strong { color: #fff; font-size: 14px; }
  @media (max-width: 1000px) { .ct-grid { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .ct-mini small { display: none; } .ct-mini { padding: 12px; } .hide-m { display: none; } }
</style>
