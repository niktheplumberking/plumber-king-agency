---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import Eyebrow from '../Eyebrow.astro';
import CallbackForm from './CallbackForm.astro';
import bg from '../../assets/img/night-pipes.jpg';
import { SITE } from '../../data/site';
interface Props { line1?: string; line2?: string; text?: string; id?: string }
const { line1 = 'Need a plumber?', line2 = 'Call Jim now.', text, id = 'contact' } = Astro.props;
---
<section class="ct dark" id={id}>
  <div class="ct-bg" aria-hidden="true"><Image src={bg} alt="" widths={[720, 1344]} sizes="100vw" data-parallax="0.18" /></div>
  <div class="wrap ct-grid">
    <div class="ct-left">
      <Eyebrow>Get in touch</Eyebrow>
      <h2 class="h-display h2 ct-h" data-split><span class="c-white">{line1}</span><br /><span class="c-yellow">{line2}</span></h2>
      <p class="lead ct-p" data-reveal="up">{text ?? <><span class="hide-m">Burst pipe, backed-up drain or no hot water? </span>Call or text any hour. Or leave your number and Jim's team calls you back.</>}</p>
      <a href={SITE.phoneHref} class="ledbox" data-reveal="up" aria-label={`Tap to call ${SITE.phone}`}>
        <span class="ledbox-top led"><span>TAP TO CALL</span><span>·</span><span>24/7</span><span class="hide-m">·</span><span class="hide-m">ESPAÑOL</span></span>
        <span class="ledbox-dot" aria-hidden="true"></span>
        <span class="ledbox-num led">{SITE.phone}</span>
      </a>
      <div class="ct-minis" data-stagger="up">
        <a href={SITE.smsHref} class="ct-mini"><span class="ct-mi"><Icon name="camera" size={18} /></span><small>Get a price range</small><strong>Text a photo</strong></a>
        <a href={SITE.phoneHref} class="ct-mini"><span class="ct-mi"><Icon name="globe" size={18} /></span><small>Ask for Jim</small><strong><span class="hide-m">Hablamos </span>Español</strong></a>
        <a href="/areas/" class="ct-mini"><span class="ct-mi"><Icon name="pin" size={18} /></span><small>28 towns covered</small><strong>Pomona &amp; <span class="hide-m">the </span>IE</strong></a>
      </div>
    </div>
    <div class="ct-right" data-reveal="right"><CallbackForm variant="card" id={`${id}-form`} /></div>
  </div>
</section>
<style>
  /* Figma 232:437 (homepage): 800 tall; copy column 80-700, form card 500 wide at 860 */
  .ct { position: relative; overflow: hidden; padding-block: 96px 119px; }
  .ct-bg { position: absolute; inset: -10% 0; }
  .ct-bg img { width: 100%; height: 100%; object-fit: cover; }
  .ct::before { content: ''; position: absolute; inset: 0; z-index: 1; background: linear-gradient(180deg, #0b0f1a 0, rgba(11,15,26,0) 140px), linear-gradient(90deg, rgba(11,15,26,.97) 0%, rgba(11,15,26,.85) 50%, rgba(11,15,26,.35) 100%); }
  .ct-grid { position: relative; z-index: 2; display: grid; grid-template-columns: 1fr 500px; gap: 60px; align-items: start; }
  .ct-h { margin-top: 11px; font-size: clamp(54px, 6.389vw, 92px); line-height: .86; letter-spacing: 0; }
  .ct-p { margin-top: 18px; max-width: 600px; font-size: 17px; line-height: 1.55; color: #c3ccdd; }
  .ledbox { position: relative; display: block; margin-top: 39px; max-width: 620px; height: 150px; padding: 16px 22px 0; border: 3px solid var(--cobalt); border-radius: 14px; background: #05070d; transition: transform .4s var(--ease-out), box-shadow .4s; }
  .ledbox:hover { transform: translateY(-3px); box-shadow: 0 0 60px -6px rgba(31,79,216,.8); }
  .ledbox-top { display: flex; gap: 17px; padding-left: 2px; color: var(--cyan); font-size: 16px; line-height: 19px; letter-spacing: .06em; text-shadow: 0 0 10px rgba(51,214,255,.5); }
  .ledbox-dot { position: absolute; right: 38px; top: 18px; width: 14px; height: 14px; border-radius: 50%; background: #ff4d4d; box-shadow: 0 0 10px rgba(255,77,77,.8); animation: blink 1.4s steps(2) infinite; }
  @keyframes blink { 50% { opacity: .25; } }
  .ledbox-num { display: block; margin-top: 5px; color: var(--yellow); font-size: clamp(40px, 5.278vw, 76px); line-height: 91px; letter-spacing: .04em; text-shadow: 0 0 22px rgba(255,210,31,.7); white-space: nowrap; }
  .ct-minis { display: grid; grid-template-columns: repeat(3, 200px); gap: 12px; margin-top: 20px; }
  .ct-mini { position: relative; display: block; height: 92px; padding: 14px; border-radius: 12px; background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.16); transition: transform .35s var(--ease-out), border-color .3s; }
  .ct-mini:hover { transform: translateY(-4px); border-color: var(--cyan); }
  .ct-mi { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 8px; background: var(--cobalt); color: #fff; }
  .ct-mini small { position: absolute; left: 60px; top: 22px; color: #a3aec6; font-size: 12px; line-height: 16px; font-weight: 500; }
  .ct-mini strong { display: block; margin-top: 6px; color: #fff; font-size: 15px; line-height: 20px; }
  .ct-right :global(.cbf-card-title) { max-width: 260px; text-wrap: balance; }
  @media (max-width: 1000px) { .ct-grid { grid-template-columns: 1fr; } }
  /* Figma 236:583 (phone): 1123 tall; photo only behind the top 620 px, LED box 350 x 112, three 110 x 78 tiles, stacked form */
  @media (max-width: 640px) {
    .hide-m, .ct-mini small { display: none; }
    .ct { padding-block: 50px; }
    .ct-bg { inset: 0 auto auto 50%; width: 1100px; height: 620px; margin-left: -625px; }
    .ct::before { background: linear-gradient(180deg, rgba(11,15,26,.7) 0, rgba(11,15,26,.8) 320px, #0b0f1a 610px); }
    .ct-grid { gap: 24px; }
    .ct-h { margin-top: 10px; font-size: 57px; }
    .ct-p { margin-top: 14px; font-size: 15px; line-height: 23px; }
    .ledbox { margin-top: 30px; height: 112px; padding: 13px 15px 0; border-radius: 12px; }
    .ledbox-top { gap: 9px; font-size: 13px; line-height: 16px; }
    .ledbox-dot { right: 17px; top: 15px; width: 12px; height: 12px; }
    .ledbox-num { margin-top: 10px; text-align: center; font-size: 40px; line-height: 48px; }
    .ct-minis { grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 14px; }
    .ct-mini { height: 78px; padding: 11px; border-radius: 10px; }
    .ct-mi { width: 30px; height: 30px; border-radius: 7px; }
    .ct-mi :global(.icon) { width: 16px; height: 16px; }
    .ct-mini strong { margin-top: 8px; font-size: 13px; line-height: 16px; }
  }
</style>
