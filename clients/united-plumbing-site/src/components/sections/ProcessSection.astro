---
import Icon from '../Icon.astro';
import Eyebrow from '../Eyebrow.astro';
import Btn from '../Btn.astro';
import { SITE } from '../../data/site';
const steps: { t: string; d: string; dm?: string; i: string }[] = [
  { t: 'Call or text', d: 'Call 909-587-0711 or text a photo of the problem, any hour.', i: 'phone' },
  { t: 'Clear price', d: 'You hear what it costs before any work starts.', i: 'tag' },
  { t: 'We show up', d: 'A Galvez brother comes out with the tools for the job.', i: 'truck' },
  { t: 'Fix it', d: 'We fix it and walk you through what we did, in plain words.', dm: 'We fix it and walk you through what we did.', i: 'wrench' },
  { t: 'Check, then pay', d: 'Look over the finished job, then pay.', i: 'checkCircle' },
];
---
<section class="pr dark">
  <div class="pr-glow" aria-hidden="true"></div>
  <div class="wrap pr-head head-center">
    <Eyebrow>How it works</Eyebrow>
    <h2 class="h-display h2 pr-h" data-split><span class="c-white">From first call </span><br class="pr-mbr" /><span class="pr-to">to </span><span class="c-cyan">final fix</span></h2>
    <p class="lead" data-reveal="up">Five steps. No guessing, no surprise bill<span class="pr-dt"> at the end</span>.</p>
  </div>
  <div class="pr-band">
    <div class="wrap pr-rail">
      <div class="pr-pipe" aria-hidden="true"><span class="pr-pipe-fill" data-progress></span></div>
      <ol class="pr-steps" data-stagger="up">
        {steps.map((s, i) => (
          <li class:list={['pr-step', { last: i === 4 }]} data-tilt>
            <span class="pr-node" aria-hidden="true"><i></i></span>
            <div class="pr-top"><span class="led pr-num">{String(i + 1).padStart(2, '0')}</span><span class="pr-ico"><Icon name={s.i} size={22} /></span></div>
            <h3 class="h-display pr-t">{s.t}</h3>
            <p class="pr-d">{s.dm ? <><span class="pr-dt">{s.d}</span><span class="pr-mt">{s.dm}</span></> : s.d}</p>
            <p class="pr-lbl">Step {String(i + 1).padStart(2, '0')}{i === 4 ? '  ·  Done' : ''}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
  <div class="wrap pr-cta" data-reveal="up">
    <span class="pr-cta-l">Step 01 starts here:</span>
    <Btn href={SITE.phoneHref} icon="phone" size="md">Call {SITE.phone}</Btn>
    <Btn href={SITE.smsHref} variant="outline-cyan" icon="message" size="md">Text a photo</Btn>
  </div>
</section>
<style>
  /* Figma 231:484 (homepage): 850 px + wave; 232 x 300 cards, 32 px gaps, pipe at 320, yellow band 470-700 */
  .pr { position: relative; overflow: hidden; padding-top: 70px; padding-bottom: 30px; }
  .pr-glow { position: absolute; left: 50%; top: -180px; width: 900px; height: 400px; transform: translateX(-50%); border-radius: 50%; background: rgba(31,79,216,.35); filter: blur(80px); pointer-events: none; }
  .pr-head { position: relative; }
  .pr-h { margin-top: 13px; font-size: clamp(38px, 5.278vw, 76px); line-height: .92; letter-spacing: 0; }
  .pr-head .lead { margin-top: 14px; font-size: 18px; line-height: 23px; color: #a3aec6; }
  .pr-band { position: relative; margin-top: 103px; }
  .pr-band::after { content: ''; position: absolute; left: 0; right: 0; top: 160px; height: 230px; background: var(--yellow); z-index: 0; }
  .pr-rail { position: relative; z-index: 1; }
  .pr-pipe { position: absolute; left: 0; right: 0; top: 12px; height: 20px; border-radius: 10px; background: var(--cobalt); }
  .pr-pipe-fill { position: absolute; left: 0; right: 0; top: 4px; height: 4px; border-radius: 2px; background: rgba(51,214,255,.8); }
  .pr-steps { position: relative; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 32px; margin-right: -8px; padding-top: 100px; }
  .pr-step { position: relative; padding: 13px 19px 0; height: 300px; border-radius: 14px; background: var(--night2); border: 1.5px solid rgba(255,255,255,.12); box-shadow: 0 16px 15px rgba(0,0,0,.35); display: flex; flex-direction: column; }
  .pr-step.last { background: var(--cobalt); border-color: var(--cyan); }
  .pr-node { position: absolute; left: 50%; top: -101.5px; width: 44px; height: 44px; margin-left: -22px; display: grid; place-items: center; border: 3px solid var(--cyan); border-radius: 8px; background: var(--night); }
  .pr-node::after { content: ''; position: absolute; left: 50%; top: 100%; width: 4px; height: 56px; margin: 3px 0 0 -2px; border-radius: 2px; background: var(--cyan); }
  .pr-node i { width: 18px; height: 18px; border-radius: 50%; background: var(--yellow); }
  .pr-top { display: flex; justify-content: space-between; align-items: start; }
  .pr-num { font-size: 72px; line-height: 86px; letter-spacing: .02em; color: var(--yellow); text-shadow: 0 0 18px rgba(255,210,31,.55); }
  .pr-ico { display: grid; place-items: center; width: 44px; height: 44px; margin-top: 10px; border-radius: 10px; background: var(--cobalt); color: #fff; }
  .pr-ico :global(.icon) { width: 22px; height: 22px; }
  .last .pr-ico { background: var(--yellow); color: var(--ink); }
  .pr-t { font-size: 32px; line-height: 38px; letter-spacing: 0; color: #fff; margin-top: 18px; white-space: nowrap; }
  .pr-d { color: #a3aec6; font-size: 15px; line-height: 1.55; margin-top: 4px; max-width: 190px; }
  .last .pr-d { color: #dce6ff; }
  .pr-lbl { position: absolute; left: 19px; top: 259px; color: var(--cyan); font-size: 11px; line-height: 14px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; white-space: pre; }
  .last .pr-lbl { color: var(--yellow); }
  .pr-cta { position: relative; display: flex; justify-content: center; align-items: center; flex-wrap: wrap; gap: 14px; margin-top: 50px; }
  .pr-cta-l { color: #fff; font-weight: 600; font-size: 20px; line-height: 26px; margin-right: 6px; }
  .pr-cta :global(.btn) { --bh: 60px; padding: 0 24px; gap: 10px; letter-spacing: .02em; }
  .pr-cta :global(.btn .icon) { width: 20px; height: 20px; }
  .pr-cta :global(.btn-yellow) { font-size: 24px; }
  .pr-cta :global(.btn-outline-cyan) { font-size: 22px; }
  @media (max-width: 1060px) {
    .pr-pipe { left: 16px; right: auto; top: 0; bottom: 40px; width: 12px; height: auto; }
    .pr-pipe-fill { transform-origin: top !important; }
    .pr-steps { grid-template-columns: 1fr; padding-top: 0; padding-left: 64px; gap: 18px; }
    .pr-node { left: -48px; top: 20px; margin-left: 0; }
    .pr-node::after { left: 100%; top: 50%; width: 14px; height: 2px; }
    .pr-band::after { left: auto; width: 50%; height: auto; top: 30%; }
    .pr-step { min-height: 0; height: auto; padding-bottom: 20px; }
    .pr-lbl { position: static; margin-top: auto; padding-top: 18px; }
    .pr-steps { margin-right: 0; }
    .pr-cta { flex-direction: column; align-items: stretch; } .pr-cta-l { text-align: center; }
  }
  .pr-mt, .pr-mbr { display: none; }
  .pr-to { color: #fff; }
  /* Figma 236:483 (phone): 1332 + 50 wave; 302 x 170 cards every 186 from 220, pipe at x24, yellow block 160 wide */
  @media (max-width: 640px) {
    .pr-dt, .pr-lbl, .pr-cta-l { display: none; }
    .pr-mt { display: inline; }
    .pr { padding-top: 50px; padding-bottom: 40px; }
    .pr-glow { width: 500px; height: 300px; top: -150px; }
    .pr-h { margin-top: 10px; font-size: 47px; }
    .pr-head .lead { margin-top: 10px; font-size: 15px; line-height: 20px; }
    .pr-band { margin-top: 30px; }
    .pr-band::after { left: auto; right: 0; width: 160px; top: 40px; height: 834px; }
    .pr-pipe { left: 4px; top: 0; bottom: 0; width: 20px; border-radius: 10px; }
    .pr-pipe-fill { left: 5px; right: auto; top: 0; bottom: 0; width: 4px; height: auto; }
    .pr-steps { padding-left: 48px; gap: 16px; }
    .pr-step { height: 170px; padding: 10px 16px 0 18px; border-radius: 12px; }
    .pr-node { left: -52px; top: 20px; width: 36px; height: 36px; border-width: 3px; border-radius: 7px; }
    .pr-node::after { left: 100%; top: 50%; width: 16px; height: 4px; margin: -2px 0 0 0; }
    .pr-node i { width: 14px; height: 14px; }
    .pr-num { font-size: 48px; line-height: 58px; }
    .pr-ico { width: 36px; height: 36px; margin-top: 6px; border-radius: 8px; }
    .pr-ico :global(.icon) { width: 18px; height: 18px; }
    .pr-t { margin-top: 4px; font-size: 26px; line-height: 31px; }
    .pr-d { margin-top: 3px; max-width: 266px; font-size: 13px; line-height: 20px; }
    .pr-mbr { display: inline; }
    .pr-to { color: var(--cyan); }
    .pr-cta { gap: 12px; margin-top: 30px; }
    .pr-cta :global(.btn) { --bh: 58px; justify-content: center; }
  }
</style>
