---
// Call-back card with service-specific problem choices (dropdown, or tap chips like the Water heaters design).
// Same field names as the shared CallbackForm, so motion.ts initForms() handles it.
import Icon from '../Icon.astro';
import Btn from '../Btn.astro';
interface Props { id: string; title: string; sub: string; label: string; options: string[]; chips?: boolean; badge?: boolean; footer?: boolean; zipLabel?: string; zipPlaceholder?: string; selectPlaceholder?: string; selectPlaceholderShort?: string; zipLabelShort?: string; class?: string }
const { id, title, sub, label, options, chips = false, badge = true, footer = true, zipLabel = 'Town or ZIP', zipPlaceholder = '91767', selectPlaceholder = 'Pick one', selectPlaceholderShort, zipLabelShort, class: cls = '' } = Astro.props;
---
<form class={`sf card ${cls}`} data-callback novalidate aria-labelledby={`${id}-t`}>
  {badge && <span class="sf-badge"><i></i>Answered 24/7</span>}
  <h2 id={`${id}-t`} class="h-display sf-title">{title}</h2>
  <p class="sf-sub">{sub}</p>
  <div class={`sf-grid ${chips ? 'is-chips' : ''}`}>
    <label class="field sf-span"><span class="field-label">Name</span><input class="input" name="name" autocomplete="name" placeholder="Your name" required /><Icon name="user" size={18} /></label>
    <label class="field sf-span"><span class="field-label">Phone</span><input class="input" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="(909) 000-0000" required /><Icon name="phone" size={18} /></label>
    <label class={`field ${chips ? 'sf-span' : ''}`}><span class="field-label">{zipLabelShort ? <><span class="sf-lg">{zipLabel}</span><span class="sf-sm">{zipLabelShort}</span></> : zipLabel}</span><input class="input" name="zip" autocomplete="postal-code" placeholder={zipPlaceholder} /><Icon name="pin" size={18} /></label>
    {chips ? (
      <fieldset class="sf-chips sf-span">
        <legend class="field-label">{label}</legend>
        <div class="sf-chiprow">
          {options.map((o, i) => <label class="sf-chip"><input type="radio" name="problem" value={o} checked={i === 0} /><span>{o}</span></label>)}
        </div>
      </fieldset>
    ) : (
      <label class="field"><span class="field-label">{label}</span><select class="input" name="problem"><option value="" data-short={selectPlaceholderShort}>{selectPlaceholder}</option>{options.map((o) => <option>{o}</option>)}</select><Icon name="chevronDown" size={18} /></label>
    )}
  </div>
  <Btn type="submit" variant="ink" icon="phone" size="md" full>Call me back</Btn>
  <p class="form-note center sf-note">We call you back. No spam.</p>
  <p class="form-error center" data-form-msg role="status" hidden></p>
  {footer && <p class="sf-foot">Rather talk now? Call <a href="tel:+19095870711">909-587-0711</a></p>}
</form>
<script>
  // Phones get the shorter placeholder from the design (the long one would be cut off in the narrow select).
  const mq = window.matchMedia('(max-width: 640px)');
  const swap = () => document.querySelectorAll<HTMLOptionElement>('.sf option[data-short]').forEach((o) => {
    o.dataset.long ??= o.textContent ?? '';
    o.textContent = mq.matches ? o.dataset.short! : o.dataset.long;
  });
  swap();
  mq.addEventListener('change', swap);
</script>
<style>
  .sf { position: relative; padding: 28px 28px 22px; border-top: 7px solid var(--yellow); color: var(--ink); }
  .sf-badge { display: inline-flex; align-items: center; gap: 8px; padding: 5px 11px; border-radius: 99px; background: #eef7ef; color: #14532d; font-size: 12px; font-weight: 700; }
  .sf-badge i { width: 8px; height: 8px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 4px rgba(34,197,94,.2); animation: sfping 1.8s infinite; }
  @keyframes sfping { 50% { box-shadow: 0 0 0 7px rgba(34,197,94,0); } }
  .sf-title { font-size: 44px; margin-top: 12px; color: var(--ink); line-height: .92; }
  .sf-sub { color: var(--ink-2); font-size: 14px; margin-top: 8px; }
  .sf-grid { display: grid; grid-template-columns: 1fr 1.3fr; gap: 14px 14px; margin: 18px 0 18px; }
  .sf-span { grid-column: 1 / -1; }
  .sf .input { height: 50px; }
  .sf .field :global(.icon) { bottom: 15px; }
  .sf-chips { border: 0; margin: 0; padding: 0; min-width: 0; }
  .sf-chiprow { display: flex; flex-wrap: wrap; gap: 8px; }
  .sf-chip { position: relative; }
  .sf-chip input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .sf-chip span { display: inline-flex; align-items: center; min-height: 44px; padding: 0 14px; border-radius: 99px; border: 1px solid #d8dfeb; background: #f5f8fc; font-size: 13px; font-weight: 600; transition: background .2s, color .2s, border-color .2s; }
  .sf-chip:hover span { border-color: var(--cobalt); }
  .sf-chip input:checked + span { background: var(--cobalt); border-color: var(--cobalt); color: #fff; }
  .sf-chip input:focus-visible + span { outline: 3px solid var(--cyan); outline-offset: 2px; }
  .sf-note { margin-top: 10px; }
  .sf-foot { margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--line); text-align: center; font-weight: 600; font-size: 14px; }
  .sf-foot a { color: var(--cobalt); text-decoration: underline; text-underline-offset: 3px; }
  .form-error { margin-top: 8px; }
  .form-error :global(a) { color: var(--cobalt); }
  .sf-sm { display: none; }
  @media (max-width: 640px) {
    .sf-lg { display: none; } .sf-sm { display: inline; }
    .sf { padding: 24px 20px 20px; } .sf-title { font-size: 34px; }
    .sf-grid { grid-template-columns: 1fr 1.25fr; }
  }
  @media (max-width: 360px) { .sf-grid { grid-template-columns: 1fr; } }
</style>
