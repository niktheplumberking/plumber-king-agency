  .cp-s { color: var(--on-dark-2); font-size: 13px; }
  .cp-rows > div { display: grid; grid-template-columns: 150px 1fr; gap: 16px; align-items: center; min-height: 52px; padding: 10px 0; border-bottom: 1px solid var(--line-dark); }
  .cp-rows > div:last-child { border-bottom: 0; }
  .cp-rows dt { font: 700 10.5px/1.3 var(--body); letter-spacing: .14em; text-transform: uppercase; color: var(--on-dark-2); }
  .cp-rows dd { margin: 0; color: #fff; font-weight: 600; font-size: 15px; }
  .cp-vs { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); display: grid; place-items: center; width: 56px; height: 56px; border-radius: 50%; background: var(--yellow); color: var(--ink); font-size: 22px; box-shadow: 0 0 0 6px var(--night); }
  .cp-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 18px; margin-top: 34px; }
  .cp-foot p { color: #fff; font-weight: 700; font-size: 17px; }

  /* CTA BAND */
  .cb { position: relative; overflow: hidden; padding-block: clamp(60px, 7vw, 90px); }
  .cb-glow { position: absolute; right: -10%; top: -20%; width: 70%; height: 140%; background: radial-gradient(closest-side, rgba(31,79,216,.6), transparent); pointer-events: none; }
  .cb-grid { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  .cb-h { margin-top: 14px; font-size: clamp(46px, 5.4vw, 76px); }
  .cb-p { margin-top: 18px; color: var(--on-dark); font-size: 17px; }
  .cb-btns { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 18px; }
  .cb-btns :global(.btn) { padding: 0 14px; }
  .cb-backup { margin-top: 12px; color: var(--on-dark-2); font-size: 13px; }
  .cb-backup a { color: #fff; font-weight: 600; }

  /* RELATED */
  .rl { overflow: hidden; }
  .rl-head { display: flex; justify-content: space-between; align-items: end; gap: 20px; }
  .rl-h { margin-top: 14px; }
  .rl-a { color: var(--ink); } .rl-b { color: var(--cobalt); }
  .dark .rl-a { color: #fff; } .dark .rl-b { color: var(--cyan); }
  .rl-line { color: var(--ink-2); font-size: 15px; max-width: 380px; text-align: right; }
  .dark .rl-line { color: var(--on-dark-2); }
  .rl-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 40px; }
  .rl-card { border-radius: 12px; overflow: hidden; background: #fff; border: 1px solid var(--line); box-shadow: 0 20px 40px -28px rgba(11,15,26,.4); transition: box-shadow .4s; }
  .dark .rl-card { background: var(--night2); border-color: var(--line-dark); }
  .rl-card:hover { box-shadow: 0 30px 60px -26px rgba(31,79,216,.55); }
  .rl-link { position: relative; display: flex; flex-direction: column; height: 100%; }
  .rl-img { position: relative; display: block; overflow: hidden; clip-path: polygon(0 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%); }
  .rl-img img { width: 100%; aspect-ratio: 16/10; object-fit: cover; transition: transform .8s var(--ease-out); }
