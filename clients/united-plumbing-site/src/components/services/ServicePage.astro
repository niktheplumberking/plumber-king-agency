  .cl-ico { position: absolute; right: 18px; top: 18px; display: grid; place-items: center; width: 50px; height: 50px; border-radius: 10px; background: var(--cobalt); transition: transform .5s var(--ease-out); }
  .cl-card:hover .cl-ico { transform: rotate(-10deg) scale(1.06); }
