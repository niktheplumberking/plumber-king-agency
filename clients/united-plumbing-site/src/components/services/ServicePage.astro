  .cl-card { position: relative; display: flex; flex-direction: column; border-radius: 12px; background: #fff; box-shadow: 0 20px 50px -30px rgba(11,15,26,.45); border: 1px solid var(--line); transition: box-shadow .4s; }
  .cl-card:hover { box-shadow: 0 30px 60px -26px rgba(31,79,216,.45); }
  .cl-card + .cl-card::before { content: ''; position: absolute; left: -26px; top: 76px; width: 26px; height: 4px; background: var(--cobalt); }
  .cl-top { position: relative; padding: 20px 20px 18px; border-radius: 12px 12px 0 0; background: var(--night); color: #fff; min-height: 162px; }
