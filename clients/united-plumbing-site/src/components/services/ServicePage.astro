---
// The service page template (Figma "Drain cleaning" 316:987 / 322:437, with the "Water heaters" 306:1039 / 316:437
// variations driven by data: status panel, hero job photo, tank/tankless style comparison, family-crew block).
// Used by src/pages/[service].astro (13 services) and src/pages/emergency-plumber-pomona.astro.
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import Btn from '../Btn.astro';
import Eyebrow from '../Eyebrow.astro';
import Wave from '../Wave.astro';
import Ticker from '../Ticker.astro';
import FaqSection from '../sections/FaqSection.astro';
import ContactSection from '../sections/ContactSection.astro';
import AreasSection from '../sections/AreasSection.astro';
import Crumbs from './Crumbs.astro';
import LedPhone from './LedPhone.astro';
import ServiceForm from './ServiceForm.astro';
import VideoReviews from './VideoReviews.astro';
import FamilyCrew from './FamilyCrew.astro';
import WhyUnited from './WhyUnited.astro';
import { SITE } from '../../data/site';
import { SERVICES, bySlug } from '../../data/services';
import { CONTENT, type ServiceContent } from '../../data/service-content';

interface Crumb { name: string; href: string }
interface Props { c: ServiceContent; crumbs?: Crumb[] }
const { c, crumbs = [{ name: 'Services', href: '/services/' }, { name: c.name, href: `/${c.slug}/` }] } = Astro.props;
const NIGHT = '#0B0F1A', WHITE = '#FFFFFF', PAPER = '#F3F6FB', YELLOW = '#FFD21F';

const longH1 = (c.h1[0] + c.h1[1]).length > 34;
const clearBg = c.status ? PAPER : WHITE;
const reviewsDark = c.crew === 'why';
const relatedDark = c.crew === 'why';
const crewBg = c.crew === 'why' ? WHITE : YELLOW;
const related = c.related.map((s) => {
  const svc = bySlug(s); const cc = CONTENT[s];
  const img = svc.img ? { src: svc.img, alt: `${svc.name} (stand-in photo)`, standIn: !!svc.standIn, real: false } : { ...cc.why.photo, alt: cc.why.photo.alt };
  return { svc, cc, img };
});
const statusLabel = { new: 'New one', check: 'Check', repair: 'Repair' } as const;
const tocItems = c.guide.sections.map((s) => ({ id: s.id, label: s.toc }));
---
{c.safety && (
  <div class="safety" role="note">
    <div class="wrap safety-in"><Icon name="alert" size={18} /><strong>{c.safety}</strong><a href={SITE.phoneHref}>Then call us: {SITE.phone}</a></div>
  </div>
)}

<!-- HERO -->
<section class:list={['sh dark', { 'has-photo': !!c.hero.photo }]}>
  <div class="sh-bg" aria-hidden="true">
    <Image src={c.hero.bg.src} alt="" widths={[768, 1344]} sizes="100vw" loading="eager" fetchpriority="high" style={c.hero.bg.pos ? `object-position:${c.hero.bg.pos}` : undefined} />
  </div>
  {c.hero.bg.standIn && <span class="standin sh-standin">Stand-in photo</span>}
  <div class="wrap sh-grid">
    <div class="sh-copy">
      <Crumbs items={crumbs} hero="1" />
      <p class="eyebrow on-dark sh-eb" data-hero="2" data-hero-fx="up"><Icon name="drop" size={14} stroke={2.5} /><span>{c.eyebrow}</span></p>
      <h1 class:list={['h-display sh-h', { 'is-long': longH1 }]} data-hero="3" data-hero-fx="lines">{c.h1[0]}<br /><span class="c-yellow">{c.h1[1]}</span></h1>
      <p class="sh-sub" data-hero="4" data-hero-fx="up">{c.sub}</p>
      <p class="sh-plabel" data-hero="5" data-hero-fx="up">{c.problemsLabel}</p>
      <ul class:list={['sh-probs', { 'is-warn': !!c.status }]} data-hero="6" data-hero-fx="pop" data-hero-children>
        {c.problems.map((p) => <li><Icon name={c.status ? 'alert' : 'drop'} size={15} />{p}</li>)}
      </ul>
      <div class="btn-row sh-btns" data-hero="7" data-hero-fx="up" data-hero-children>
        <Btn href={SITE.phoneHref} icon="phone" size="md">Call {SITE.phone}</Btn>
        <Btn href={SITE.smsHref} variant="outline-cyan" icon="message" size="md">Text a photo</Btn>
      </div>
      <ul class="sh-chips" data-hero="8" data-hero-fx="up" data-hero-children>
        <li><Icon name="clock" size={14} />Answered 24/7</li>
        <li><Icon name="globe" size={14} />Hablamos Español</li>
        <li><Icon name="tag" size={14} />Clear price first</li>
      </ul>
    </div>
    <div class="sh-side">
      {c.hero.photo ? (
        <figure class="sh-photo" data-hero="3" data-hero-fx="pop" data-hero-at="0.35">
          <Image src={c.hero.photo.src} alt={c.hero.photo.alt} widths={[320, 560]} sizes="(max-width: 1200px) 80vw, 280px" loading="eager" />
          <figcaption class="sh-real"><Icon name="camera" size={13} />Real job · @plumblord1</figcaption>
        </figure>
      ) : (
        <figure class="sh-mphoto" aria-hidden="true">
          <Image src={c.hero.bg.src} alt="" widths={[480, 768]} sizes="90vw" style={c.hero.bg.pos ? `object-position:${c.hero.bg.pos}` : undefined} />
          {c.hero.bg.standIn && <span class="standin">Stand-in photo</span>}
        </figure>
      )}
      <div class="sh-form" data-hero="9" data-hero-fx="up" data-hero-at="0.3">
        <ServiceForm id={`${c.slug}-hero`} title={c.form.title} sub={c.form.sub} label={c.form.label} options={c.form.options} chips={c.form.chips} footer={!c.form.chips} zipPlaceholder={c.form.chips ? 'Pomona, 91767' : '91767'} />
      </div>
    </div>
  </div>
</section>
<Wave from={NIGHT} to={clearBg} flip />

{c.doNow && (
  <section class="dn">
    <div class="wrap dn-in" data-reveal="up">
      <p class="h-display dn-h"><Icon name="alert" size={26} />{c.doNow.title}</p>
      <ol class="dn-steps">{c.doNow.steps.map((s, i) => <li><span class="led">{i + 1}</span>{i === c.doNow!.steps.length - 1 ? <a href={SITE.phoneHref}>{s}</a> : s}</li>)}</ol>
    </div>
  </section>
)}

<!-- WHAT WE CLEAR / SIGNS -->
{c.status ? (
  <section class="st light section">
    <div class="wrap st-grid">
      <div>
        <Eyebrow>{c.clear.eyebrow}</Eyebrow>
        <h2 class="h-display h2 st-h" data-split>{c.clear.h[0]}<br /><span class="c-cobalt">{c.clear.h[1]}</span></h2>
        {c.clear.lead && <p class="lead st-lead" data-reveal="up">{c.clear.lead}</p>}
        <ul class="st-list" data-stagger="up">
          {c.clear.cards.map((k, i) => (
            <li class:list={['st-item', { y: i === 1 }]}>
              <span class="st-ico"><Icon name={k.icon} size={22} /></span>
              <div><h3 class="st-t">{k.title}</h3><p set:html={k.fix} /></div>
            </li>
          ))}
        </ul>
      </div>
      <div class="sp" data-reveal="right">
        <p class="sp-bar led"><span class="sp-dots" aria-hidden="true"><i></i><i></i><i></i></span>Status check · {c.name}</p>
        <div class="sp-body">
          <h3 class="h-display sp-h">{c.status.title}</h3>
          <ul class="sp-rows">
            {c.status.rows.map((r) => <li class={`sp-row v-${r.v}`}><span class="sp-led" aria-hidden="true"></span><span class="sp-t">{r.t}</span><span class="sp-v led">{statusLabel[r.v]}</span></li>)}
          </ul>
          <p class="sp-legend">{c.status.legend}</p>
          <div class="sp-foot"><p>{c.status.foot}</p><Btn href={SITE.phoneHref} icon="phone" size="sm">Call {SITE.phone}</Btn></div>
        </div>
      </div>
    </div>
  </section>
) : (
  <section class="cl white section">
    <div class="wrap head-center">
      <Eyebrow>{c.clear.eyebrow}</Eyebrow>
      <h2 class="h-display h2 cl-h" data-split>{c.clear.h[0]}<br /><span class="c-cobalt">{c.clear.h[1]}</span></h2>
    </div>
    <ol class="wrap cl-grid" data-stagger="up">
      {c.clear.cards.map((k, i) => (
        <li class="cl-card" data-tilt>
          <div class="cl-top"><span class="led cl-n">{String(i + 1).padStart(2, '0')}</span><span class="cl-ico"><Icon name={k.icon} size={22} /></span><h3 class="h-display cl-t">{k.title}</h3></div>
          <div class="cl-body">
            <p class="cl-k">You notice</p>
            <ul class="cl-notice">{k.notice.map((n) => <li>{n}</li>)}</ul>
            <span class="cl-sep" aria-hidden="true"><Icon name="chevronDown" size={14} stroke={3} /></span>
            <div class="cl-fix"><p class="cl-k">What we do</p><p set:html={k.fix} /></div>
          </div>
        </li>
      ))}
    </ol>
    {c.clear.foot && <p class="wrap cl-foot" data-reveal="up" set:html={c.clear.foot} />}
  </section>
)}
<Wave from={clearBg} to={NIGHT} />

<!-- WHY US -->
<section class="wu dark section">
  <div class="wu-glow" aria-hidden="true"></div>
  <div class="wrap wu-grid">
    <div class="wu-media">
      {!c.why.tag && <span class="wu-block" data-reveal="clipx" aria-hidden="true"></span>}
      <figure class="wu-photo" data-reveal="clip">
        <Image src={c.why.photo.src} alt={c.why.photo.alt} widths={[420, 800]} sizes="(max-width: 900px) 100vw, 540px" data-parallax="0.08" style={c.why.photo.pos ? `object-position:${c.why.photo.pos}` : undefined} />
        {c.why.photo.standIn && <span class="standin">Stand-in photo</span>}
        {c.why.photo.real && <span class="realjob">Real job · @plumblord1</span>}
      </figure>
      <div class="wu-stat" data-reveal="pop"><span class="led wu-big">{c.why.stat.big}</span><span class="wu-small">{c.why.stat.small}</span></div>
    </div>
    <div class="wu-copy">
      <Eyebrow>Why us</Eyebrow>
      <h2 class="h-display h2 wu-h" data-split><span class="c-white">{c.why.h[0]}</span><br /><span class="c-cyan">{c.why.h[1]}</span></h2>
      {c.why.tag && <p class="h-display wu-tag" data-reveal="up">{c.why.tag}</p>}
      <p class="lead wu-body" data-reveal="up" set:html={c.why.body} />
      <ol class="wu-list" data-stagger="up">
        {c.why.bullets.map((b, i) => <li><span class="led wu-n">{String(i + 1).padStart(2, '0')}</span><p><strong>{b.b}</strong> <span set:html={b.t} /></p></li>)}
      </ol>
      <div class="btn-row wu-btns" data-reveal="up">
        <Btn href={SITE.phoneHref} icon="phone" size="md">Call {SITE.phone}</Btn>
        <Btn href={SITE.smsHref} variant="outline-cyan" icon="message" size="md">Text a photo</Btn>
      </div>
    </div>
  </div>
</section>
<Wave from={NIGHT} to={WHITE} flip />

<!-- FULL GUIDE -->
<section class="gd white section">
  <div class="wrap gd-grid">
    <article class="gd-main">
      <Eyebrow>{c.guide.eyebrow}</Eyebrow>
      <h2 class="h-display h2 gd-h" data-split>{c.guide.h[0]}<br /><span class="c-cobalt">{c.guide.h[1]}</span></h2>
      <p class="gd-intro" data-reveal="up">{c.guide.intro}</p>
      <div class="gd-mcard">
        <p class="h-display gd-mt">{c.aside.title}</p>
        <LedPhone size="sm" top={['Tap to call', '24/7']} dot={false} />
        <Btn href={SITE.phoneHref} icon="phone" size="md" full>Call now</Btn>
      </div>
      {c.guide.sections.map((s) => (
        <div class="gd-sec" id={s.id}>
          {s.title && <h3 class="h-display gd-h3" data-reveal="up">{s.title}</h3>}
          {s.blocks.map((b) => (
            b.type === 'p' ? <p class="gd-p" set:html={b.html} /> :
            b.type === 'towns' ? <p class="gd-p gd-towns" set:html={b.html} /> :
            b.type === 'steps' ? (
              <ol class="gd-steps" data-stagger="up">{b.items.map((it, i) => <li><span class="led">{String(i + 1).padStart(2, '0')}</span><p><strong>{it.b}</strong> <span set:html={it.t} /></p></li>)}</ol>
            ) :
            b.type === 'numbered' ? (
              <ol class="gd-num">{b.items.map((it, i) => <li><span>{i + 1}</span><p set:html={it} /></li>)}</ol>
            ) :
            b.type === 'alert' ? (
              <div class="gd-alert" data-reveal="up">
                <p class="h-display gd-at"><span class="gd-ai"><Icon name="alert" size={20} /></span>{b.title}</p>
                <ul>{b.items.map((it) => <li>{it}</li>)}</ul>
                {b.note && <p class="gd-an">{b.note}</p>}
              </div>
            ) :
            b.type === 'checks' ? (
              <ul class="gd-checks" data-stagger="up">{b.items.map((it) => <li><Icon name="checkCircle" size={18} /><span set:html={it} /></li>)}</ul>
            ) :
            b.type === 'tip' ? (
              <div class="gd-tip" data-reveal="up"><Icon name={b.icon ?? 'wrench'} size={22} /><div><p class="h-display gd-tt">{b.title}</p><p set:html={b.html} /></div></div>
            ) :
            b.type === 'cards' ? (
              <ul class="gd-cards" data-stagger="up">{b.items.map((it) => <li><span class="gd-ci"><Icon name={it.icon} size={18} /></span><div><strong>{it.t}</strong><p set:html={it.d} /></div></li>)}</ul>
            ) :
            b.type === 'wait' ? (
              <div class="gd-wait" data-reveal="up">
                <p class="h-display gd-wt">{b.title}</p>
                <ol>{b.items.map((it, i) => <li><span class="led">{String(i + 1).padStart(2, '0')}</span><strong>{it.k}</strong><p set:html={it.t} /></li>)}</ol>
              </div>
            ) : null
          ))}
        </div>
      ))}
    </article>
    <aside class="gd-aside" aria-label={`${c.name}: call United Plumbing`}>
      <div class="gd-stick">
        <div class="ac">
          <p class="h-display ac-h">{c.aside.title}</p>
          <p class="ac-sub">{c.aside.sub}</p>
          <LedPhone size="sm" top={['Tap to call', '24/7']} dot={false} />
          <div class="ac-btns">
            <Btn href={SITE.phoneHref} icon="phone" size="md" full>Call now</Btn>
            <Btn href={SITE.smsHref} variant="outline-cyan" icon="message" size="md" full>Text a photo</Btn>
          </div>
          <p class="ac-k">On this page</p>
          <ul class="ac-toc">{tocItems.map((t) => <li><a href={`#${t.id}`}>{t.label}<Icon name="arrow" size={14} /></a></li>)}</ul>
          <p class="ac-backup">Backup line <a href={SITE.backupHref}>(909) 667-6555</a></p>
        </div>
      </div>
      <div class="gd-extras">
        <div class="slot gd-slot" data-reveal="up"><Icon name="instagram" size={24} /><span>Job photo from @plumblord1 goes here</span></div>
        <a href={c.aside.tip.href} class="gd-tipcard" data-reveal="up" data-tilt>
          <span class="gd-tci"><Icon name={c.aside.tip.icon} size={20} /></span>
          <strong class="h-display">{c.aside.tip.title}</strong>
          <span class="gd-tct">{c.aside.tip.text}</span>
          <span class="gd-tcl">{c.aside.tip.label} <Icon name="arrow" size={14} /></span>
        </a>
      </div>
    </aside>
  </div>
</section>

<!-- COMPARE (optional) -->
{c.compare && (
  <>
    <Wave from={WHITE} to={NIGHT} />
    <section class="cp dark section">
      <div class="cp-glow" aria-hidden="true"></div>
      <div class="wrap head-center cp-head">
        <Eyebrow>{c.compare.eyebrow}</Eyebrow>
        <h2 class="h-display h2" data-split><span class="c-white">{c.compare.h[0]}</span><br /><span class="c-cyan">{c.compare.h[1]}</span></h2>
      </div>
      <div class="wrap cp-grid">
        {[c.compare.left, c.compare.right].map((side, si) => (
          <div class:list={['cp-card', { r: si === 1 }]} data-reveal={si === 0 ? 'left' : 'right'}>
            <div class="cp-top"><span class="cp-ico"><Icon name={side.icon} size={24} /></span><div><h3 class="h-display cp-t">{side.title}</h3><p class="cp-s">{side.sub}</p></div></div>
            <dl class="cp-rows">{c.compare!.labels.map((l, i) => <div><dt>{l}</dt><dd>{side.rows[i]}</dd></div>)}</dl>
          </div>
        ))}
        <span class="cp-vs led" aria-hidden="true">VS</span>
      </div>
      <div class="wrap cp-foot" data-reveal="up">
        <p>{c.compare.note}</p>
        <div class="btn-row"><Btn href={SITE.phoneHref} icon="phone" size="md">Call {SITE.phone}</Btn><Btn href={SITE.smsHref} variant="outline-cyan" icon="message" size="md">Text a photo</Btn></div>
      </div>
    </section>
    {!reviewsDark && <Wave from={NIGHT} to={PAPER} flip />}
  </>
)}
{!c.compare && <Wave from={WHITE} to={reviewsDark ? NIGHT : PAPER} />}

<!-- REVIEWS -->
<VideoReviews theme={reviewsDark ? 'dark' : 'light'} layout={reviewsDark ? 'center' : 'split'} />

<!-- CREW -->
{c.crew === 'why' ? <><Wave from={NIGHT} to={WHITE} flip /><WhyUnited /></> : <FamilyCrew line={c.crewLine} eyebrow="Why homeowners choose us" />}

<!-- CTA BAND -->
<Wave from={crewBg} to={NIGHT} />
<section class="cb dark">
  <div class="cb-glow" aria-hidden="true"></div>
  <div class="wrap cb-grid">
    <div>
      <Eyebrow>{c.cta.eyebrow}</Eyebrow>
      <h2 class="h-display h2 cb-h" data-split><span class="c-white">{c.cta.h[0]}</span><br /><span class="c-yellow">{c.cta.h[1]}</span></h2>
      <p class="cb-p" data-reveal="up">{c.cta.sub}</p>
    </div>
    <div class="cb-right" data-reveal="right">
      <LedPhone size="lg" top={['Tap to call', '24/7', 'Español']} />
      <div class="cb-btns">
        <Btn href={SITE.phoneHref} icon="phone" size="md">Call {SITE.phone}</Btn>
        <Btn href="#contact" variant="outline-white" icon="user" size="md">Get a call back</Btn>
      </div>
      <p class="cb-backup">Backup line <a href={SITE.backupHref}>(909) 667-6555</a></p>
    </div>
  </div>
</section>
<Wave from={NIGHT} to={WHITE} flip />

<!-- FAQ -->
<FaqSection faqs={c.faqs} line1="Things people" line2="usually ask." line3="" intro={c.faqIntro} />

<!-- RELATED -->
<Wave from={WHITE} to={relatedDark ? NIGHT : PAPER} />
<section class:list={['rl section', relatedDark ? 'dark' : 'light']}>
  <div class="wrap rl-head">
    <div>
      <Eyebrow>{c.relatedEyebrow}</Eyebrow>
      <h2 class="h-display h2 rl-h" data-split><span class="rl-a">Related</span><br /><span class="rl-b">services</span></h2>
    </div>
    <p class="rl-line" data-reveal="up">{c.relatedLine}</p>
  </div>
  <ul class="wrap rl-grid" data-stagger="up">
    {related.map(({ svc, cc, img }) => (
      <li class="rl-card" data-tilt>
        <a href={`/${svc.slug}/`} class="rl-link">
          <span class="rl-img">
            <Image src={img.src} alt={img.alt} widths={[320, 600]} sizes="(max-width: 700px) 70vw, 300px" />
            {img.standIn && <span class="standin">Stand-in photo</span>}
            {img.real && <span class="realjob">Real job</span>}
          </span>
          <span class="rl-ico"><Icon name={svc.icon} size={20} /></span>
          <span class="rl-body">
            <span class="h-display rl-t">{svc.name}</span>
            <span class="rl-d">{cc.hubLine}</span>
            <span class="rl-more">See page <Icon name="arrow" size={14} /></span>
          </span>
        </a>
      </li>
    ))}
    <li class="rl-all" data-tilt>
      <a href="/services/" class="rl-alllink">
        <span class="led rl-13">13</span>
        <span class="rl-go" aria-hidden="true"><Icon name="arrow" size={18} /></span>
        <span class="h-display rl-allt">See all 13 services</span>
        <span class="rl-alld">Drains, water heaters, leaks, gas lines and more.</span>
      </a>
    </li>
  </ul>
</section>
{!relatedDark && <Wave from={PAPER} to={NIGHT} flip />}

<div class="ct-wrap"><ContactSection id="contact" line1={c.contact.line1} line2={c.contact.line2} text={c.contact.text} /></div>
<Ticker items={['CALL 909-587-0711', '24/7', 'HABLAMOS ESPAÑOL', 'POMONA', 'CLAREMONT', 'CHINO', 'ONTARIO', 'UPLAND']} cyan reverse />
<AreasSection />

<style>
  /* ContactSection's background image is absolutely positioned but .ct has no position: contain it here. */
  .ct-wrap { position: relative; overflow: hidden; }
  /* FAQ heading is two words per line here (Figma), so it needs a smaller size than the shared default. */
  :global(section.faq .faq-h) { font-size: clamp(44px, 4.2vw, 58px); }
  :global(section.faq .faq-h .c-cobalt br) { display: none; }

  /* SAFETY BAR (gas pages) */
  .safety { background: #b3261e; color: #fff; }
  .safety-in { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; padding-block: 12px; font-size: 14px; }
  .safety a { margin-left: auto; font-weight: 700; text-decoration: underline; text-underline-offset: 3px; min-height: 24px; }

  /* HERO */
  .sh { position: relative; overflow: hidden; padding: 34px 0 70px; }
  .sh-bg { position: absolute; inset: 0; z-index: 0; }
  .sh-bg img { width: 100%; height: 100%; object-fit: cover; }
  .sh-bg::after { content: ''; position: absolute; inset: 0; background:
    linear-gradient(90deg, rgba(11,15,26,.97) 0%, rgba(11,15,26,.88) 38%, rgba(11,15,26,.45) 70%, rgba(11,15,26,.25) 100%),
    radial-gradient(60% 70% at 0% 100%, rgba(31,79,216,.55), transparent 70%); }
  .sh-standin { left: auto; right: var(--gutter); top: auto; bottom: 64px; }
  .sh-grid { position: relative; z-index: 2; display: grid; grid-template-columns: 1fr 440px; gap: 48px; align-items: start; }
  .has-photo .sh-grid { grid-template-columns: 1fr 640px; gap: 28px; }
  .sh-eb { margin-top: 18px; }
  .sh-h { margin-top: 14px; color: #fff; font-size: clamp(52px, 7.2vw, 104px); line-height: .88; }
  .sh-h.is-long { font-size: clamp(46px, 5.4vw, 78px); }
  .sh-sub { margin-top: 22px; color: var(--on-dark); font-size: 18px; max-width: 560px; }
  .sh-plabel { margin-top: 22px; font: 700 11px/1 var(--body); letter-spacing: .18em; text-transform: uppercase; color: var(--on-dark-2); }
  .sh-probs { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; margin-top: 12px; }
