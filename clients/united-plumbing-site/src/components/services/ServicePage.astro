  .sh-probs li { display: inline-flex; align-items: center; gap: 10px; min-height: 40px; padding: 6px 16px; border-radius: 99px; border: 1.5px solid rgba(255,210,31,.7); background: rgba(11,15,26,.55); color: #fff; font-weight: 600; font-size: 14px; }
