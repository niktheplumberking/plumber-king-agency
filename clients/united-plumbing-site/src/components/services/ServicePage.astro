  .gd-wait li p { color: var(--on-dark-2); }
  .gd-aside { display: flex; flex-direction: column; gap: 40px; }
  .gd-stick { flex: 1; }
  .ac { position: sticky; top: 110px; padding: 26px 22px 20px; border-radius: 14px; border-top: 6px solid var(--yellow); background: var(--night); color: #fff; box-shadow: 0 40px 70px -30px rgba(11,15,26,.6); }
  .ac-h { font-size: 34px; line-height: .95; }
  .ac-sub { margin: 6px 0 16px; color: var(--on-dark-2); font-size: 13.5px; }
  .ac-btns { display: grid; gap: 10px; margin-top: 14px; }
  .ac-k { margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--line-dark); font: 700 11px/1 var(--body); letter-spacing: .18em; text-transform: uppercase; color: var(--cyan); }
  .ac-toc { margin-top: 8px; }
  .ac-toc a { display: flex; align-items: center; justify-content: space-between; gap: 10px; min-height: 40px; border-bottom: 1px solid var(--line-dark); color: var(--on-dark); font-size: 13.5px; transition: color .2s, padding .3s var(--ease-out); }
  .ac-toc a:hover { color: var(--yellow); padding-left: 4px; }
  .ac-backup { margin-top: 14px; color: var(--on-dark-2); font-size: 12.5px; }
  .ac-backup a { color: #fff; font-weight: 600; }
  .gd-extras { display: grid; gap: 22px; }
  .gd-slot { min-height: 200px; }
  .gd-tipcard { display: grid; gap: 10px; padding: 22px 22px; border-radius: 14px; background: var(--cobalt); color: #fff; transition: box-shadow .4s; }
  .gd-tipcard:hover { box-shadow: 0 24px 50px -20px rgba(31,79,216,.7); }
  .gd-tci { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 8px; background: var(--yellow); color: var(--ink); }
  .gd-tipcard strong { font-size: 26px; line-height: 1; }
  .gd-tct { font-size: 13.5px; color: #dfe6fb; }
  .gd-tcl { display: inline-flex; align-items: center; gap: 6px; color: var(--yellow); font-weight: 700; font-size: 14px; }
  .gd-tcl :global(.icon) { transition: transform .3s var(--ease-out); }
  .gd-tipcard:hover .gd-tcl :global(.icon) { transform: translateX(4px); }

  /* COMPARE */
  .cp { overflow: hidden; }
  .cp-glow { position: absolute; left: 50%; top: -120px; width: 1000px; height: 520px; transform: translateX(-50%); background: radial-gradient(closest-side, rgba(31,79,216,.5), transparent); pointer-events: none; }
  .cp-head { position: relative; }
  .cp-grid { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 56px; margin-top: 46px; }
  .cp-card { padding: 26px 24px 10px; border-radius: 14px; background: #070a12; border: 1px solid var(--line-dark); }
  .cp-card.r { background: #0e1a3d; border: 2px solid var(--cyan); box-shadow: 0 0 50px -20px rgba(51,214,255,.5); }
  .cp-top { display: flex; gap: 16px; align-items: center; padding-bottom: 20px; border-bottom: 1px solid var(--line-dark); }
  .cp-ico { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 10px; background: var(--yellow); color: var(--ink); }
  .r .cp-ico { background: var(--cyan); }
