  .cl-body { flex: 1; display: flex; flex-direction: column; padding: 20px 14px 14px; }
  .cl-k { padding-inline: 6px; font: 700 11px/1 var(--body); letter-spacing: .18em; text-transform: uppercase; color: var(--ink-3); }
  .cl-notice { display: grid; gap: 8px; margin: 12px 0 0; padding-inline: 6px; font-size: 14px; color: var(--ink-2); }
  .cl-notice li { position: relative; padding-left: 18px; }
  .cl-notice li::before { content: ''; position: absolute; left: 0; top: .55em; width: 7px; height: 7px; border-radius: 50%; background: #e5484d; }
  .cl-sep { position: relative; display: flex; justify-content: flex-end; margin: 18px 6px 16px; }
  .cl-sep::before { content: ''; position: absolute; left: 0; right: 34px; top: 50%; height: 1px; background: var(--line); }
  .cl-sep :global(.icon) { box-sizing: content-box; padding: 4px; border-radius: 50%; background: var(--yellow); color: var(--ink); }
  .cl-fix { margin-top: auto; padding: 16px; border-radius: 8px; background: var(--yellow); font-size: 14px; color: var(--ink); }
  .cl-fix .cl-k { padding: 0; color: var(--ink); margin-bottom: 8px; }
  .cl-fix :global(.ph) { font-size: 12.5px; }
  .cl-foot { margin-top: 40px; text-align: center; font-weight: 600; font-size: 16px; }
  .cl-foot :global(a) { color: var(--cobalt); font-weight: 700; }

  /* STATUS (water heater style) */
  .st-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .st-h { margin-top: 14px; font-size: clamp(40px, 4.4vw, 62px); }
  .st-lead { margin-top: 20px; font-size: 16px; max-width: 520px; }
  .st-list { display: grid; gap: 14px; margin-top: 30px; max-width: 560px; }
  .st-item { display: flex; gap: 18px; align-items: flex-start; padding: 20px 22px; border-radius: 10px; background: #fff; border: 1px solid var(--line); box-shadow: inset 4px 0 0 var(--cobalt); transition: transform .35s var(--ease-out); }
  .st-item:hover { transform: translateX(6px); }
  .st-item.y { box-shadow: inset 4px 0 0 var(--yellow); }
  .st-ico { flex: none; display: grid; place-items: center; width: 50px; height: 50px; border-radius: 10px; background: var(--cobalt); color: #fff; }
  .st-item.y .st-ico { background: var(--yellow); color: var(--ink); }
  .st-t { font-size: 17px; font-weight: 700; }
  .st-item p { color: var(--ink-2); font-size: 14px; margin-top: 4px; }
  .sp { border-radius: 16px; overflow: hidden; background: var(--night); color: #fff; box-shadow: 0 40px 80px -30px rgba(11,15,26,.7); }
  .sp-bar { display: flex; align-items: center; gap: 14px; padding: 16px 22px; background: var(--night2); color: var(--cyan); font-size: 18px; text-transform: uppercase; }
  .sp-dots { display: flex; gap: 6px; } .sp-dots i { width: 9px; height: 9px; border-radius: 50%; background: #ff5f57; } .sp-dots i:nth-child(2) { background: var(--yellow); } .sp-dots i:nth-child(3) { background: var(--cyan); }
  .sp-body { padding: 26px 22px 24px; background: linear-gradient(180deg, rgba(31,79,216,.28), transparent 40%); }
  .sp-h { font-size: 40px; line-height: .92; max-width: 340px; }
  .sp-rows { display: grid; gap: 10px; margin-top: 22px; }
  .sp-row { display: flex; align-items: center; gap: 14px; min-height: 52px; padding: 10px 16px; border-radius: 8px; background: var(--night2); border: 1px solid var(--line-dark); font-size: 14px; }
  .sp-led { flex: none; width: 12px; height: 12px; border-radius: 50%; }
  .sp-t { flex: 1; }
  .sp-v { font-size: 15px; text-transform: uppercase; }
  .v-new .sp-led { background: #ff5f57; box-shadow: 0 0 10px #ff5f57; } .v-new .sp-v { color: #ff7a73; }
  .v-check .sp-led { background: var(--yellow); box-shadow: 0 0 10px var(--yellow); } .v-check .sp-v { color: var(--yellow); }
  .v-repair .sp-led { background: var(--cyan); box-shadow: 0 0 10px var(--cyan); } .v-repair .sp-v { color: var(--cyan); }
  .sp-legend { margin-top: 14px; color: var(--on-dark-2); font-size: 12px; }
  .sp-foot { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--line-dark); font-weight: 700; font-size: 14px; }

  /* WHY US */
  .wu { overflow: hidden; }
  .wu-glow { position: absolute; left: -10%; top: 10%; width: 60%; height: 80%; background: radial-gradient(closest-side, rgba(31,79,216,.35), transparent); pointer-events: none; }
  .wu-grid { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: center; }
  .wu-media { position: relative; }
  .wu-block { position: absolute; left: -100vw; right: 40%; top: 14%; bottom: -8%; background: var(--cobalt); }
  .wu-photo { position: relative; overflow: hidden; border-radius: 14px; aspect-ratio: 5 / 5.4; box-shadow: 0 40px 80px -30px rgba(0,0,0,.7); }
  .wu-photo img { width: 100%; height: 115%; object-fit: cover; }
  .wu-stat { position: absolute; right: -24px; bottom: 40px; min-width: 250px; max-width: 300px; padding: 18px 20px; border-radius: 10px; background: var(--yellow); color: var(--ink); box-shadow: 0 24px 50px -20px rgba(0,0,0,.6); }
  .wu-big { display: block; font-size: 44px; line-height: 1; text-transform: uppercase; white-space: nowrap; }
  .wu-small { display: block; margin-top: 8px; font-size: 13px; font-weight: 600; }
  .wu-h { margin-top: 14px; font-size: clamp(40px, 4.4vw, 60px); }
  .wu-tag { margin-top: 20px; color: var(--yellow); font-size: clamp(24px, 2.2vw, 30px); line-height: 1.05; text-transform: none; font-weight: 800; }
  .wu-body { margin-top: 14px; font-size: 16px; }
  .wu-list { margin-top: 22px; border-top: 1px solid var(--line-dark); }
  .wu-list li { display: flex; gap: 22px; align-items: baseline; padding: 14px 0; border-bottom: 1px solid var(--line-dark); }
  .wu-n { color: var(--cyan); font-size: 22px; width: 30px; flex: none; }
  .wu-list p { color: var(--on-dark-2); font-size: 14px; }
  .wu-list strong { color: #fff; font-size: 15px; display: block; }
  .wu-btns { margin-top: 26px; }

  /* GUIDE */
  .gd-grid { display: grid; grid-template-columns: 1fr 340px; gap: 80px; align-items: stretch; }
  .gd-main { max-width: 720px; }
  .gd-h { margin-top: 14px; font-size: clamp(42px, 4.6vw, 64px); }
  .gd-intro { margin-top: 22px; color: var(--ink-2); font-size: 16px; }
  .gd-mcard { display: none; }
  .gd-sec { margin-top: 40px; scroll-margin-top: 120px; }
  .gd-h3 { position: relative; padding-left: 18px; font-size: clamp(28px, 2.6vw, 34px); line-height: 1; margin-bottom: 16px; }
  .gd-h3::before { content: ''; position: absolute; left: 0; top: 2px; bottom: 4px; width: 5px; border-radius: 2px; background: var(--yellow); }
  .gd-p { color: var(--ink-2); font-size: 15.5px; }
  .gd-p + .gd-p { margin-top: 16px; }
  .gd-p :global(strong) { color: var(--ink); }
  .gd-main :global(a:not(.btn)) { color: var(--cobalt); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .gd-steps { display: grid; gap: 10px; }
  .gd-steps li { display: flex; gap: 18px; padding: 16px 18px; border-radius: 10px; background: var(--paper); transition: transform .35s var(--ease-out), background .3s; }
  .gd-steps li:hover { transform: translateX(6px); background: #e9eff9; }
  .gd-steps .led { color: var(--cobalt); font-size: 22px; flex: none; width: 30px; }
  .gd-steps p { color: var(--ink-2); font-size: 14.5px; }
  .gd-steps strong { color: var(--ink); }
  .gd-num { display: grid; gap: 12px; margin: 18px 0; }
  .gd-num li { display: flex; gap: 14px; align-items: baseline; color: var(--ink-2); font-size: 15px; }
  .gd-num span { flex: none; display: grid; place-items: center; width: 24px; height: 24px; border-radius: 5px; background: var(--cobalt); color: #fff; font-size: 13px; font-weight: 700; transform: translateY(5px); }
  .gd-alert { margin-top: 6px; padding: 24px 26px; border-radius: 14px; background: var(--night); color: var(--on-dark); }
  .gd-at { display: flex; align-items: center; gap: 14px; color: #fff; font-size: 28px; line-height: 1; }
  .gd-ai { flex: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--yellow); color: var(--ink); }
  .gd-alert ul { display: grid; gap: 8px; margin: 16px 0 0 54px; font-size: 14.5px; }
  .gd-alert li { position: relative; padding-left: 16px; }
  .gd-alert li::before { content: ''; position: absolute; left: 0; top: .6em; width: 6px; height: 6px; border-radius: 50%; background: var(--yellow); }
  .gd-an { margin: 16px 0 0 54px; color: var(--yellow); font-weight: 700; font-size: 14.5px; }
  .gd-checks { display: grid; gap: 10px; }
  .gd-checks li { display: flex; gap: 12px; color: var(--ink-2); font-size: 15px; }
  .gd-checks :global(.icon) { flex: none; color: var(--cobalt); margin-top: 3px; }
  .gd-tip { display: flex; gap: 16px; margin-top: 20px; padding: 20px 22px; border-radius: 10px; background: var(--paper); box-shadow: inset 4px 0 0 var(--yellow); color: var(--ink-2); font-size: 14.5px; }
  .gd-tip > :global(.icon) { flex: none; color: var(--cobalt); margin-top: 2px; }
  .gd-tt { color: var(--ink); font-size: 22px; line-height: 1; margin-bottom: 6px; }
  .gd-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .gd-cards li { display: flex; gap: 14px; padding: 16px; border-radius: 10px; border: 1px solid var(--line); background: #fff; transition: transform .35s var(--ease-out), box-shadow .35s; }
  .gd-cards li:hover { transform: translateY(-3px); box-shadow: 0 16px 30px -20px rgba(11,15,26,.4); }
  .gd-ci { flex: none; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 8px; background: #e8eefc; color: var(--cobalt); }
  .gd-cards strong { font-size: 14.5px; }
  .gd-cards p { color: var(--ink-2); font-size: 13px; margin-top: 2px; }
  .gd-wait { margin-top: 20px; padding: 22px 24px; border-radius: 14px; background: var(--night); color: var(--on-dark); }
  .gd-wt { color: var(--yellow); font-size: 28px; line-height: 1; }
  .gd-wait ol { display: grid; gap: 14px; margin-top: 16px; }
  .gd-wait li { display: grid; grid-template-columns: 34px 130px 1fr; gap: 10px; align-items: baseline; font-size: 14px; }
  .gd-wait .led { color: var(--cyan); font-size: 18px; }
