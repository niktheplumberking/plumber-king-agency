  .dn-steps li { display: flex; align-items: center; gap: 10px; }
  .dn-steps .led { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--ink); color: var(--yellow); font-size: 18px; }
  .dn-steps a { text-decoration: underline; text-underline-offset: 3px; }

  /* CLEAR CARDS */
  .cl-h { margin-top: 14px; font-size: clamp(40px, 4.8vw, 64px); }
