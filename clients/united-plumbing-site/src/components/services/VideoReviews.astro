---
// "Hear it from them": 3 Instagram video-review slots + 2 review placeholders. No names, stars or counts until Jim supplies them.
import Icon from '../Icon.astro';
import Eyebrow from '../Eyebrow.astro';
import { SITE } from '../../data/site';
interface Props { theme?: 'light' | 'dark' | 'white'; layout?: 'center' | 'split' }
const { theme = 'white', layout = 'center' } = Astro.props;
const vids = [1, 2, 3];
const wh = theme === 'light' && layout === 'split'; // water-heater template look (Figma 313:860)
---
<section class:list={['vr section', theme, wh && 'is-wh']}>
  <div class={`wrap vr-head ${layout === 'split' ? 'is-split' : 'head-center'}`}>
    <div>
      <Eyebrow>Real customers</Eyebrow>
      <h2 class="h-display h2 vr-h" data-split><span class="vr-a">Hear it</span><br /><span class="vr-b">from them</span></h2>
    </div>
    {layout === 'split' && <p class="vr-intro" data-reveal="up">Real customers on camera, from Jim's Instagram. Written reviews go here once Jim's review profile is live.</p>}
    {wh && <a href="/reviews/" class="vr-pill" data-reveal="up"><Icon name="instagram" size={18} />Watch all video reviews <Icon name="arrow" size={16} /></a>}
  </div>
  <div class="wrap vr-grid">
    <div class="vr-vids" data-carousel>
      <div class="vr-track" data-track data-stagger="up">
        {vids.map((n) => (
          <a href={SITE.instagram} target="_blank" rel="noopener" class="vr-vid" data-tilt aria-label={`Video review ${n} on Instagram (opens Instagram)`}>
            <span class="vr-tag"><Icon name="instagram" size={wh ? 16 : 26} />Video review · Instagram</span>
            {wh && <span class="vr-thumb" aria-hidden="true">Video thumbnail from @plumblord1 goes here</span>}
            <span class="vr-play" aria-hidden="true"><Icon name="play" size={34} /></span>
            <span class="vr-cap"><span class:list={['vr-n', wh && 'led']}>Video {n}</span><em class="ph">Customer first name, town: Jim to confirm</em></span>
          </a>
        ))}
      </div>
      <div class="vr-dots" aria-hidden="true">{vids.map((_, k) => <span data-dot class:list={{ on: k === 0 }}></span>)}</div>
    </div>
    <div class="vr-g" data-stagger="up">
      {[0, 1].map(() => (
        <article class="vr-gc">
          <div class="vr-gtop"><Icon name="quote" size={28} class="vr-q" /><span class="vr-gtag">Review goes here</span></div>
          <div class="vr-lines" aria-hidden="true"><i></i><i></i><i class="s"></i></div>
          <div class="vr-who"><span class="vr-av" aria-hidden="true"></span><span><strong>Customer name</strong><small>{wh ? 'Town' : 'After the profile is live'}</small></span></div>
        </article>
      ))}
    </div>
  </div>
  {!wh && <div class="wrap vr-more" data-reveal="up"><a href="/reviews/" class="vr-link h-display">Watch all reviews <Icon name="arrow" size={18} /></a></div>}
</section>
<style>
  /* Figma 310:695: 820 tall; 4 columns of 302 (3 video tiles 420 tall + 2 review cards 202 tall) */
  .vr { overflow: hidden; padding-block: 98px 39px; }
  .vr :global(.eyebrow) { font-size: 13px; letter-spacing: .14em; }
  .vr :global(.eyebrow .icon) { width: 16px; height: 16px; }
  .vr-h { margin-top: 5px; font-size: 64px; line-height: .92; letter-spacing: 0; }
  .vr-a { color: var(--ink); } .vr-b { color: var(--cobalt); }
  .dark .vr-a, .dark2 .vr-a { color: #fff; } .dark .vr-b, .dark2 .vr-b { color: var(--cyan); }
  .vr-head.is-split { display: grid; grid-template-columns: auto 1fr; gap: 40px 80px; align-items: end; }
  .vr-intro { color: var(--ink-2); font-size: 15px; max-width: 440px; }
  .vr-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; margin-top: 42px; }
  .vr-vids { grid-column: span 3; }
  .vr-track { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .vr-vid { position: relative; display: block; height: 420px; border-radius: 18px; overflow: hidden; color: #fff;
    background: radial-gradient(150px 150px at 50% 50%, rgba(31,79,216,.75), rgba(31,79,216,0)), #0b0f1a; box-shadow: 0 24px 50px -28px rgba(11,15,26,.6); transition: transform .4s var(--ease-out), box-shadow .4s; }
  .vr-vid:hover { box-shadow: 0 30px 60px -24px rgba(31,79,216,.6); }
  .vr-tag { position: absolute; left: 20px; top: 20px; display: inline-flex; align-items: center; gap: 10px; font: 700 12px/1 var(--body); letter-spacing: .1em; text-transform: uppercase; }
  .vr-play { position: absolute; left: 50%; top: 192px; transform: translate(-50%, -50%); display: grid; place-items: center; width: 84px; height: 84px; border-radius: 50%; background: var(--yellow); color: var(--ink); box-shadow: 0 0 0 0 rgba(255,210,31,.5); transition: transform .4s var(--ease-out), box-shadow .4s; }
  .vr-play :global(.icon) { margin-left: 4px; }
  .vr-vid:hover .vr-play { transform: translate(-50%, -50%) scale(1.1); box-shadow: 0 0 0 12px rgba(255,210,31,.18); }
  .vr-cap { position: absolute; left: 20px; right: 20px; top: 340px; display: grid; gap: 8px; }
  .vr-n { justify-self: start; height: 26px; padding: 0 10px; border-radius: 6px; background: #000; font: 700 12px/26px var(--body); }
  .vr-cap .ph { color: var(--cyan); font-size: 13px; font-weight: 600; justify-self: start; }
  .vr-dots { display: none; }
  .vr-g { display: grid; gap: 16px; align-content: start; }
  .vr-gc { position: relative; height: 202px; padding: 20px; border-radius: 18px; background: #fff; border: 1px solid #dce3ee; }
  .light .vr-gc { background: #fff; } .white .vr-gc { background: var(--paper); }
  .dark .vr-gc, .dark2 .vr-gc { background: var(--night2); border-color: var(--line-dark); }
  .vr-gtop { display: flex; align-items: center; gap: 19px; height: 30px; }
  .vr-gtop :global(.vr-q) { color: var(--cobalt); }
  .dark .vr-gtop :global(.vr-q) { color: var(--cyan); }
  .vr-gtag { transform: rotate(2deg); height: 26px; background: var(--yellow); color: var(--ink); font: 800 12px/26px var(--display); text-transform: uppercase; letter-spacing: .04em; padding: 0 10px; border-radius: 4px; }
  .vr-lines { display: grid; gap: 10px; margin-top: 22px; }
  .vr-lines i { width: 258px; max-width: 100%; height: 10px; border-radius: 5px; background: #dce3ee; } .vr-lines i:nth-child(2) { width: 240px; } .vr-lines i.s { width: 170px; }
  .dark .vr-lines i { background: #26304a; }
  .vr-who { display: flex; align-items: flex-start; gap: 10px; margin-top: 22px; }
  .vr-who strong { display: block; font-size: 14px; font-weight: 600; line-height: 18px; } .vr-who small { display: block; margin-top: 2px; color: #475569; font-size: 12px; line-height: 16px; }
  .dark .vr-who strong { color: #fff; } .dark .vr-who small { color: var(--on-dark-2); }
  .vr-av { width: 36px; height: 36px; border-radius: 50%; background: #dce3ee; flex: none; }
  .dark .vr-av { background: #26304a; }
  .vr-more { display: flex; justify-content: center; margin-top: 27px; }
  .vr-link { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-size: 22px; font-weight: 800; letter-spacing: 0; color: var(--cobalt); }
  .dark .vr-link { color: var(--cyan); }
  .vr-link :global(.icon) { transition: transform .3s var(--ease-out); }
  .vr-link:hover :global(.icon) { transform: translateX(5px); }
  @media (max-width: 1000px) { .vr-grid { grid-template-columns: minmax(0, 1fr); } .vr-vids { grid-column: auto; min-width: 0; } .vr-g { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 700px) {
    .vr-head.is-split { grid-template-columns: 1fr; gap: 16px; }
    .vr-vids { margin-inline: calc(var(--gutter) * -1); }
    .vr-track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding: 0 var(--gutter) 6px; gap: 14px; }
    .vr-track::-webkit-scrollbar { display: none; }
    /* Figma 313:1385: 224x340 tiles, one review card 350x180 */
    .vr { padding-block: 52px 35px; }
    .vr :global(.eyebrow) { font-size: 11px; }
    .vr :global(.eyebrow .icon) { width: 14px; height: 14px; }
    .vr-h { margin-top: 3px; font-size: 40px; }
    .vr-grid { gap: 20px; margin-top: 24px; }
    .vr-track { gap: 12px; }
    .vr-vid { flex: none; width: 224px; height: 340px; scroll-snap-align: start; }
    .vr-tag { left: 16px; top: 16px; gap: 8px; font-size: 10px; }
    .vr-tag :global(.icon) { width: 22px; height: 22px; }
    .vr-play { top: 164px; width: 68px; height: 68px; }
    .vr-play :global(.icon) { width: 28px; height: 28px; }
    .vr-cap { left: 16px; right: 16px; top: 262px; gap: 8px; }
    .vr-n { height: 24px; padding: 0 8px; font-size: 11px; line-height: 24px; }
    .vr-cap .ph { font-size: 12px; }
    .vr-gc { height: 180px; padding: 18px; }
    .vr-gtop { gap: 16px; }
    .vr-lines { gap: 9px; margin-top: 16px; }
    .vr-lines i { width: 314px; height: 9px; } .vr-lines i:nth-child(2) { width: 290px; } .vr-lines i.s { width: 200px; }
    .vr-who { margin-top: 19px; }
    .vr-av { width: 32px; height: 32px; }
    .vr-who strong { font-size: 13px; line-height: 17px; } .vr-who small { margin-top: 2px; font-size: 11px; line-height: 14px; }
    .vr-more { margin-top: 15px; }
    .vr-link { font-size: 20px; }
    .vr-dots { display: flex; justify-content: center; gap: 8px; margin-top: 6px; }
    .vr-dots span { width: 8px; height: 8px; border-radius: 9px; background: #c7d0e0; transition: width .3s, background .3s; }
    .vr-dots span.on { width: 20px; background: var(--cobalt); }
    .vr-g { grid-template-columns: 1fr; }
    .vr-g > :nth-child(2) { display: none; }
  }
  /* Service template, dark (Figma 320:437): 860 tall, #131b2e, bordered tiles */
  .vr.dark { background: #131b2e; padding-block: 100px 66px; }
  .vr.dark .vr-grid { margin-top: 52px; }
  .vr.dark .vr-vid, .vr.dark .vr-gc { border: 1px solid #24304a; background-color: #0b0f1a; }
  .vr.dark .vr-vid { background: radial-gradient(150px 150px at 50% 47%, rgba(31,79,216,.75), rgba(31,79,216,0)), #0b0f1a; }
  .vr.dark .vr-more { margin-top: 30px; }
  /* Water-heater template (Figma 313:860): 890 tall, paper, split head + pill, tiles 300x470 with caption bar */
  .vr.is-wh { padding-block: 100px 120px; background: var(--paper); }
  .is-wh .vr-head.is-split { grid-template-columns: 440px 520px 1fr; gap: 0; align-items: start; }
  .is-wh .vr-intro { margin-top: 76px; max-width: 520px; color: #475569; font-size: 17px; line-height: 1.5; }
  .vr-pill { justify-self: end; margin-top: 76px; display: inline-flex; align-items: center; gap: 10px; height: 44px; padding: 0 18px; border-radius: 8px; background: var(--ink); color: #fff; font-size: 15px; font-weight: 700; transition: background .3s; }
  .vr-pill:hover { background: var(--cobalt); }
  .vr-pill :global(.icon:first-child) { color: var(--cyan); }
  .is-wh .vr-grid { grid-template-columns: 300px 300px 300px 320px; gap: 20px; margin-top: 52px; }
  .is-wh .vr-vids { grid-column: span 3; }
  .is-wh .vr-track { grid-template-columns: repeat(3, 300px); gap: 20px; }
  .is-wh .vr-vid { height: 470px; border-radius: 14px; background: radial-gradient(130px 130px at 50% 49%, rgba(31,79,216,.75), rgba(31,79,216,0)), #0b0f1a; box-shadow: 0 24px 40px -24px rgba(11,15,26,.55); }
  .is-wh .vr-tag { left: 16px; top: 16px; gap: 8px; height: 28px; padding: 0 12px; border-radius: 6px; background: rgba(0,0,0,.6); font: 600 12px/1 var(--body); letter-spacing: 0; text-transform: none; }
  .is-wh .vr-play { top: 215px; width: 80px; height: 80px; }
  .vr-thumb { position: absolute; left: 20px; right: 20px; top: 272px; color: #a3aec6; font-size: 12px; text-align: center; }
  .is-wh .vr-cap { left: 0; right: 0; top: 370px; bottom: 0; align-content: start; gap: 6px; padding: 18px 20px 0; background: #131b2e; }
  .is-wh .vr-n { height: auto; padding: 0; background: none; color: var(--cyan); font: 900 22px/24px var(--led); text-transform: uppercase; }
  .is-wh .vr-cap .ph { font-size: 13px; }
  .is-wh .vr-g { gap: 20px; }
  .is-wh .vr-gc { height: 225px; padding: 22px; border-radius: 14px; background: #fff; }
  .is-wh .vr-gtop :global(.vr-q) { color: var(--yellow); }
  .is-wh .vr-lines { margin-top: 26px; }
  .is-wh .vr-who { margin-top: 28px; }
  @media (max-width: 1360px) {
    .is-wh .vr-head.is-split { grid-template-columns: auto 1fr auto; gap: 0 40px; }
    .is-wh .vr-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .is-wh .vr-track { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 700px) {
    .vr.dark { padding-block: 52px 35px; }
    .vr.dark .vr-grid { margin-top: 24px; }
    .vr.dark .vr-more { margin-top: 15px; }
    .vr.is-wh { padding-block: 52px 52px; }
    .is-wh .vr-head.is-split { grid-template-columns: 1fr; }
    .is-wh .vr-intro, .vr-pill { margin-top: 12px; justify-self: start; }
    .is-wh .vr-grid { grid-template-columns: minmax(0, 1fr); margin-top: 24px; }
    .is-wh .vr-vids { grid-column: auto; }
    .is-wh .vr-track { grid-template-columns: none; }
    .is-wh .vr-vid { height: 400px; }
    .is-wh .vr-cap { top: 300px; }
    .is-wh .vr-play { top: 170px; }
    .vr-thumb { top: 222px; }
  }
</style>