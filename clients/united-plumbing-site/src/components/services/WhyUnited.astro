---
// "Why Pomona calls United" (white, Jim + van). Same block as the homepage, reused on the drain-family service pages.
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import Eyebrow from '../Eyebrow.astro';
import van from '../../assets/img/jim-van.jpg';
---
<section class="wy white section">
  <div class="wrap wy-grid">
    <div>
      <Eyebrow>Why choose United</Eyebrow>
      <h2 class="h-display h2 wy-h" data-split>Why Pomona<br /><span class="c-cobalt">calls United</span></h2>
      <p class="lead wy-p" data-reveal="up">When a pipe bursts at 2 AM, you want someone who picks up, speaks your language and tells you the price before touching anything. That is how the Galvez brothers work.</p>
      <ul class="wy-list" data-stagger="left">
        <li><span><Icon name="clock" size={18} /></span>A real person answers, 24/7</li>
        <li><span><Icon name="globe" size={18} /></span>Hablamos Español</li>
        <li><span><Icon name="tag" size={18} /></span>Clear price before any work starts</li>
        <li><span><Icon name="users" size={18} /></span>Family crew, all trained by Jim</li>
        <li><span><Icon name="camera" size={18} /></span>Text a photo, get a price range</li>
      </ul>
    </div>
    <figure class="wy-photo" data-reveal="clip">
      <Image src={van} alt="Jaime “Jim” Galvez standing next to the United Plumbing work truck" widths={[500, 900]} sizes="(max-width: 900px) 100vw, 640px" data-parallax="0.1" />
      <figcaption class="wy-name"><strong class="h-display">Jaime "Jim" Galvez</strong><small>Owner · United Plumbing</small></figcaption>
    </figure>
  </div>
</section>
<style>
  /* Figma 320:519: 750 + 90 wave; copy 580 at x80, photo 640x620 at x720 */
  .wy.section { padding: 100px 0 30px; }
  .wy-grid { display: grid; grid-template-columns: 580px 640px; justify-content: space-between; align-items: start; }
  .wy :global(.eyebrow) { font-size: 13px; letter-spacing: .14em; }
  .wy-h { margin-top: 5px; font-size: 64px; line-height: .92; }
  .wy-p { margin-top: 20px; font-size: 17px; line-height: 1.55; color: #475569; max-width: 580px; }
  .wy-list { display: grid; gap: 12px; margin-top: 29px; }
  .wy-list li { display: flex; align-items: center; gap: 16px; height: 58px; padding: 8px; border-radius: 6px; background: var(--ink); color: #fff; font-weight: 600; font-size: 17px; transition: transform .35s var(--ease-out), background .3s; }
  .wy-list li:hover { transform: translateX(8px); background: var(--night3); }
  .wy-list li span { flex: none; display: grid; place-items: center; width: 42px; height: 42px; border-radius: 5px; background: var(--yellow); color: var(--ink); }
  .wy-list li span :global(.icon) { width: 22px; height: 22px; }
  .wy-photo { position: relative; overflow: hidden; border-radius: 10px; height: 620px; }
  .wy-photo img { width: 100%; height: 110%; object-fit: cover; object-position: 82% 50%; }
  .wy-photo::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 200px; background: linear-gradient(180deg, rgba(11,15,26,0), rgba(11,15,26,.92)); }
  .wy-name { position: absolute; z-index: 2; left: 24px; bottom: 24px; width: min(360px, calc(100% - 48px)); height: 64px; padding: 8px 18px; border-radius: 6px; background: var(--cobalt); color: #fff; }
  .wy-name strong { display: block; font-size: 24px; line-height: 29px; } .wy-name small { display: block; margin-top: 1px; font-size: 13px; font-weight: 500; color: #dce6ff; }
  @media (max-width: 1360px) { .wy-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 56px; } }
  @media (max-width: 900px) { .wy-grid { grid-template-columns: 1fr; gap: 40px; } .wy-photo { height: 420px; } .wy-photo img { object-position: 78% 40%; } }
  @media (max-width: 640px) {
    .wy.section { padding: 56px 0 40px; }
    .wy-grid { gap: 24px; }
    .wy :global(.eyebrow) { font-size: 11px; }
    .wy-h { margin-top: 10px; font-size: 44px; }
    .wy-p { margin-top: 14px; font-size: 14px; line-height: 1.5; }
    .wy-list { gap: 10px; margin-top: 20px; }
    .wy-list li { height: 50px; gap: 12px; padding: 6px; font-size: 15px; }
    .wy-list li span { width: 38px; height: 38px; }
    .wy-list li span :global(.icon) { width: 20px; height: 20px; }
    .wy-photo { height: 400px; border-radius: 10px; }
    .wy-name { left: 16px; bottom: 16px; width: calc(100% - 32px); }
  }
</style>
