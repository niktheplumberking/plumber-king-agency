---
// Small LED-screen label used for drive times and stats (the Doto font = the brand's LED sign look).
interface Props { text: string; tone?: 'cyan' | 'yellow'; size?: 'sm' | 'md' | 'lg'; class?: string }
const { text, tone = 'cyan', size = 'md', class: cls = '' } = Astro.props;
---
<span class={`ledt ledt-${tone} ledt-${size} led ${cls}`}>{text}</span>
<style>
  .ledt { display: inline-flex; align-items: center; justify-content: center; background: #05070d; border-radius: 6px; white-space: nowrap; letter-spacing: .04em; }
  .ledt-cyan { color: var(--cyan); text-shadow: 0 0 10px rgba(51,214,255,.45); }
  .ledt-yellow { color: var(--yellow); text-shadow: 0 0 10px rgba(255,210,31,.45); }
  .ledt-sm { font-size: 11px; padding: 5px 8px; border-radius: 4px; }
  .ledt-md { font-size: 20px; padding: 10px 14px; }
  .ledt-lg { font-size: 34px; padding: 16px 18px; }
</style>
