---
// Town template: generates the 27 town pages (/plumber-claremont/ to /plumber-anaheim/).
// Figma: Claremont 321:437 (desktop) / 331:437 (mobile). Copy: site-copy/05-location-claremont.md + 00-sitemap.md.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Btn from '../components/Btn.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Wave from '../components/Wave.astro';
import Ticker from '../components/Ticker.astro';
import CallbackForm from '../components/sections/CallbackForm.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import Crumbs from '../components/towns/Crumbs.astro';
import LedTile from '../components/towns/LedTile.astro';
import VideoReviews from '../components/towns/VideoReviews.astro';
import { TOWNS } from '../data/towns';
import { SERVICES } from '../data/services';
import { SITE } from '../data/site';
import { townPage, mapView, type ProblemKey } from '../data/town-content';
import dusk from '../assets/img/dusk-street.jpg';
import pipes from '../assets/img/night-pipes.jpg';
import map from '../assets/img/map-service-area.jpg';
import snake from '../assets/img/job-drain-snake.jpg';
import crawl from '../assets/img/job-crawlspace.jpg';
import whReal from '../assets/img/job-water-heater.jpg';
import whStand from '../assets/img/standin-water-heater.jpg';
import drainStand from '../assets/img/standin-drain.jpg';
import gasStand from '../assets/img/standin-gas.jpg';
import camStand from '../assets/img/standin-sewer-camera.jpg';

export function getStaticPaths() {
  return TOWNS.map((t) => ({ params: { town: t.slug } }));
}

const slug = Astro.params.town as string;
const p = townPage(slug);
const { town: t } = p;
// Doorway-page guard: only towns with real, checked local content are indexed. Add a slug here once Jim supplies local jobs/photos for it.
const INDEXED_TOWNS = ['plumber-claremont'];
const n = t.name;
const site = Astro.site!.toString().replace(/\/$/, '');
const countyShort = t.county.replace(' County', '').replace('Los Angeles', 'LA');
const countyCode: Record<string, string> = { 'Los Angeles County': 'LA CO', 'San Bernardino County': 'SB CO', 'Riverside County': 'RIV CO', 'Orange County': 'OC' };

// Problem card photos: real job photos where they fit, labelled stand-ins otherwise, an empty slot for slab leaks.
const photo: Record<ProblemKey, { img?: ImageMetadata; alt: string; standin?: boolean; real?: boolean }> = {
  roots: { img: snake, alt: 'Jim feeding a drain snake into a backed-up line', real: true },
  oldpipes: { img: crawl, alt: 'A Galvez brother working on old drain pipes in a crawl space', real: true },
  hardwater: { img: whStand, alt: 'Water heater with mineral build-up (stand-in photo)', standin: true },
  heater: { img: whReal, alt: 'Installing a new water heater outside a home', real: true },
  grease: { img: drainStand, alt: 'Clearing a clogged kitchen drain (stand-in photo)', standin: true },
  mainline: { img: camStand, alt: 'Sewer camera inspection of a main line (stand-in photo)', standin: true },
  gas: { img: gasStand, alt: 'Gas line connection being checked (stand-in photo)', standin: true },
  slab: { alt: '' },
  fixtures: { alt: '' },
  adu: { alt: '' },
};

const shortName: Record<string, string> = { 'Sewer Camera Inspection': 'Sewer Camera', 'Copper Pipe & Repiping': 'Repiping', 'Gas Line Installation': 'Gas Line Install' };
const order = ['drain-cleaning-pomona', 'water-heater-pomona', 'leak-detection-pomona', 'rooter-service-pomona', 'hydro-jetting-pomona', 'sewer-camera-inspection-pomona', 'main-line-repair-pomona', 'repiping-pomona', 'gas-line-repair-pomona', 'gas-line-installation-pomona', 'residential-plumbing-pomona', 'adu-plumbing-pomona', 'plumbing-repair-pomona'];
const services = order.map((s) => SERVICES.find((x) => x.slug === s)!);

const glance = [
  p.zip
    ? { led: p.zip, icon: 'pin', t: 'ZIP code', d: `All of ${n}, from the Village to the foothills.` }
    : { led: countyCode[t.county] ?? countyShort.toUpperCase(), icon: 'pin', t: t.county, d: `All of ${n}, plus the towns around it.` },
  { led: `~${t.drive} MIN`, icon: 'truck', t: 'From our Pomona base', d: `${p.route} Approximate, normal traffic.` },
  p.glanceLed
    ? { led: p.glanceLed, icon: 'home', t: p.glanceTitle!, d: p.glanceText! }
    : { led: 'ES · EN', icon: 'globe', t: 'Hablamos Español', d: 'Ask for Jim. English or Spanish.' },
  { led: '24/7', icon: 'clock', t: `Since ${SITE.since}`, d: 'Family owned. A real person picks up, day or night.' },
];

const gmaps = `https://www.google.com/maps/dir/${encodeURIComponent('Pomona, CA 91767')}/${encodeURIComponent(`${n}, CA`)}`;
const nearby = [{ name: 'Pomona', href: '/', led: 'HOME BASE', home: true }, ...p.neighbours.map((x) => ({ name: x.name, href: `/${x.slug}/`, led: `~${x.drive} MIN`, home: false }))];
const alsoNearby = [{ name: 'Pomona', href: '/' }, ...p.neighbours.slice(0, 4).map((x) => ({ name: x.name, href: `/${x.slug}/` }))];

const { BASE, at, mapStyle, baseLabel, townLabel } = mapView(p.map);

const schema = [
  {
    '@context': 'https://schema.org', '@type': 'Service', '@id': `${site}/${slug}/#service`,
    name: `Plumber in ${n}, CA`, serviceType: 'Plumbing', url: `${site}/${slug}/`,
    provider: { '@id': `${site}/#business` },
    areaServed: { '@type': 'City', name: `${n}, CA`, containedInPlace: { '@type': 'AdministrativeArea', name: `${t.county}, CA` } },
    hasOfferCatalog: { '@type': 'OfferCatalog', name: `Plumbing services in ${n}`, itemListElement: services.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.name, url: `${site}/${s.slug}/` } })) },
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: p.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })),
  },
];
---
<Base title={t.title} description={t.description} crumbs={[{ name: 'Areas', href: '/areas/' }, { name: n, href: `/${slug}/` }]} schema={schema} noindex={!INDEXED_TOWNS.includes(slug)}>

  <!-- HERO -->
  <section class="th dark">
    <div class="th-bg" aria-hidden="true"><Image src={dusk} alt="" widths={[768, 1344]} sizes="100vw" loading="eager" fetchpriority="high" data-parallax="0.15" /></div>
    <div class="wrap th-grid">
      <div class="th-copy">
        <Crumbs items={[{ name: 'Areas', href: '/areas/' }, { name: n, href: `/${slug}/` }]} />
        <p class="eyebrow on-dark th-eye" data-hero="1" data-hero-fx="up"><Icon name="drop" size={14} stroke={2.5} /><span>Plumber · {n}, CA{p.zip ? ` ${p.zip}` : ''}</span></p>
        <h1 class:list={["h-display th-h", { long: n.length > 12 }]} data-hero="2" data-hero-fx="lines"><span class="c-white">Plumber in</span> <br /><span class="c-yellow">{n}, CA</span></h1>
        <p class="th-sub" data-hero="3" data-hero-fx="up">About {t.drive} minutes from our base in Pomona. A real person picks up 24/7.</p>
        <div class="th-drive" data-hero="4" data-hero-fx="up" aria-label={`Approximate drive: ${t.drive} minutes from Pomona 91767 to ${n}`}>
          <span class="th-pt"><span class="th-pi cob"><Icon name="home" size={18} /></span><span><span class="led th-pn">POMONA 91767</span><small>Our base</small></span></span>
          <span class="th-line" aria-hidden="true"></span>
          <LedTile text={`~${t.drive} MIN`} tone="yellow" class="th-min" />
          <span class="th-line" aria-hidden="true"></span>
          <span class="th-pt"><span class="th-pi yel"><Icon name="pin" size={18} /></span><span><span class="led th-pn c-yellow">{n.toUpperCase()}{p.zip ? ` ${p.zip}` : ''}</span><small>Approximate drive time</small></span></span>
        </div>
        <p class="th-k" data-hero="5" data-hero-fx="up">What we see most in {n}</p>
        <ul class="th-probs" data-hero="5" data-hero-fx="pop" data-hero-children>
          {p.heroChips.map((c) => <li><Icon name="alert" size={15} />{c}</li>)}
        </ul>
        <div class="btn-row th-btns" data-hero="6" data-hero-fx="up" data-hero-children>
          <Btn href={SITE.phoneHref} icon="phone" size="md">Call {SITE.phone}</Btn>
          <Btn href={SITE.smsHref} variant="outline-cyan" icon="message" size="md">Text a photo</Btn>
        </div>
        <ul class="th-chips" data-hero="7" data-hero-fx="up" data-hero-children>
          <li><Icon name="clock" size={14} />Answered 24/7</li>
          <li><Icon name="globe" size={14} />Hablamos Español</li>
          <li><Icon name="tag" size={14} />Clear price first</li>
        </ul>
      </div>
      <div class="th-form" id="callback" data-hero="3" data-hero-fx="up">
        <CallbackForm variant="card" id="town-cb" title={`Get a call back in ${n}`} zipLabel="ZIP code" zipPlaceholder={t.slug === "plumber-claremont" ? "91711" : "ZIP code"} problemLabel="What's going on?" />
      </div>
    </div>
  </section>

  <Wave from="#0B0F1A" to="#F3F6FB" />

  <!-- CLOSE BY -->
  <section class="cb light">
    <div class="wrap cb-head">
      <div>
        <Eyebrow>Close by</Eyebrow>
        <h2 class="h-display h2 cb-h" data-split>{p.closeHead[0]}<br /><span class="c-cobalt">{p.closeHead[1]}</span></h2>
      </div>
      <div class="cb-r">
        <p class="lead" data-reveal="up">{p.close}</p>
        <p class="cb-tag" data-reveal="up"><Icon name="pin" size={14} />{n} at a glance</p>
      </div>
    </div>
    <ul class="wrap cb-tiles" data-stagger="up">
      {glance.map((g) => (
        <li class="cb-tile" data-tilt>
          <span class="cb-screen"><span class="led cb-led">{g.led}</span><Icon name={g.icon} size={16} class="cb-ico" /></span>
          <span class="cb-txt"><strong>{g.t}</strong><span>{g.d}</span></span>
        </li>
      ))}
    </ul>
  </section>

  <Wave from="#F3F6FB" to="#0B0F1A" flip />

  <!-- PROBLEMS -->
  <section class="pr dark">
    <div class="pr-glow glow" aria-hidden="true"></div>
    <div class="wrap pr-head">
      <div>
        <Eyebrow>Know your home</Eyebrow>
        <h2 class="h-display h2 pr-h" data-split><span class="c-white">{p.problemsHead[0]}</span><br /><span class="c-cyan">{p.problemsHead[1]}</span></h2>
      </div>
      <div data-reveal="left" class="pr-cta"><Btn href={SITE.phoneHref} icon="phone" size="md">Call {SITE.phone}</Btn></div>
    </div>
    <ul class="wrap pr-grid" data-stagger="up">
      {p.problems.map((pb, i) => {
        const ph = photo[pb.key];
        return (
          <li class="pr-card" data-tilt>
            <div class="pr-img">
              {ph.img ? <Image src={ph.img} alt={ph.alt} widths={[320, 640]} sizes="(max-width: 700px) 80vw, 300px" /> : <div class="slot pr-slot"><Icon name="instagram" size={22} />Job photo from @plumblord1 goes here</div>}
              {ph.standin && <span class="standin">Stand-in photo</span>}
              <span class="pr-tag led">{pb.tag}</span>
              <span class="pr-num led">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <div class="pr-body">
              <h3 class="h-display pr-t">{pb.title}</h3>
              <p>{pb.text}</p>
            </div>
          </li>
        );
      })}
    </ul>
    <div class="wrap pr-mcta"><Btn href={SITE.phoneHref} icon="phone" size="md" full>Call {SITE.phone}</Btn></div>
  </section>

  <Wave from="#0B0F1A" to="#FFFFFF" />

  <!-- WHERE WE WORK -->
  <section class="ww white">
    <div class="wrap ww-grid">
      <div class="ww-copy">
        <Eyebrow>{p.zip ? `All over ${p.zip}` : `Where we work`}</Eyebrow>
        <h2 class="h-display h2 ww-h" data-split>{p.areaHead[0]}<br /><span class="c-cobalt">{p.areaHead[1]}</span></h2>
        <p class="lead ww-p" data-reveal="up">{p.areaText}</p>
        {p.areaChips ? (
          <ul class="ww-chips" data-stagger="pop">{p.areaChips.map((c) => <li><Icon name="pin" size={14} />{c}</li>)}</ul>
        ) : (
          <ul class="ww-chips" data-stagger="pop">
            <li><Icon name="pin" size={14} />All of {n}</li>
            <li><Icon name="pin" size={14} />{t.county}</li>
            <li><Icon name="clock" size={14} />Answered 24/7</li>
            <li><Icon name="truck" size={14} />~{t.drive} min from Pomona</li>
          </ul>
        )}
        <p class="ww-near" data-reveal="up">Also nearby: {alsoNearby.map((x, i) => <><span class="nw"><a href={x.href}>{x.name}</a>{i < alsoNearby.length - 1 ? ',' : ''}</span>{' '}</>)}</p>
      </div>
      <figure class="ww-map" data-reveal="clip">
        <div class="ww-mapimg">
          <Image src={map} alt={p.map ? `Map of the area around Pomona showing ${n} and our Pomona base` : `Map of the area around our Pomona base, the starting point for calls to ${n}`} widths={[1000]} sizes="1000px" style={mapStyle} class="ww-zoom" />
          <span class={`mk mk-base lab-${baseLabel}`} style={at(BASE)}><span class="mk-pin"><Icon name="home" size={16} /></span><span class="mk-l">Our base: Pomona 91767</span></span>
          {p.map && <span class={`mk mk-town lab-${townLabel}`} style={at(p.map)}><span class="mk-pin"><Icon name="pin" size={16} /></span><span class="mk-l">{n}{p.zip ? ` ${p.zip}` : ''}</span></span>}
          <span class="ww-led"><span class="led">~{t.drive} MIN</span><small>from Pomona, approximate</small></span>
        </div>
        <figcaption class="ww-cap"><span>Map: Google Maps screenshot</span><a href={gmaps} target="_blank" rel="noopener" class="ww-gm">Open in Google Maps <Icon name="arrow" size={14} /></a></figcaption>
      </figure>
    </div>
  </section>

  <Wave from="#FFFFFF" to="#131B2E" flip />

  <!-- GUIDE (SEO body) -->
  <section class="gd dark2">
    <div class="gd-glow glow" aria-hidden="true"></div>
    <div class="wrap">
      <Eyebrow>The {n} guide</Eyebrow>
      <h2 class="h-display h2 gd-h" data-split><span class="c-white">{p.guideHead[0]}</span><br /><span class="c-cyan">{p.guideHead[1]}</span></h2>
      <p class="gd-intro" data-reveal="up">{p.guideIntro}</p>
      <ol class="gd-list" data-stagger="up">
        {p.guide.map((g, i) => (
          <li>
            <span class="led gd-n">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="h-display gd-t">{g.t}</h3>
              <p>{g.d}</p>
              {g.links && <p class="gd-links">{g.links.map((l) => <a href={l.href}>{l.label} <Icon name="arrow" size={13} /></a>)}</p>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Wave from="#131B2E" to="#F3F6FB" />

  <!-- SERVICES -->
  <section class="sg light">
    <div class="wrap sg-head">
      <div>
        <Eyebrow>Services in {n}</Eyebrow>
        <h2 class="h-display h2" data-split>What we do<br /><span class="c-cobalt">in {n}</span></h2>
      </div>
      <p class="lead" data-reveal="up">Every service links to its own page. Same family crew, same straight answers.</p>
    </div>
    <ul class="wrap sg-grid" data-stagger="up">
      {services.map((s) => (
        <li><a href={`/${s.slug}/`} class="sg-card"><span class="sg-ico"><Icon name={s.icon} size={18} /></span><Icon name="arrow" size={16} class="sg-arr" /><span class="h-display sg-t">{shortName[s.name] ?? s.name}</span></a></li>
      ))}
      <li><a href="/services/" class="sg-card sg-all"><span class="sg-ico"><Icon name="arrow" size={18} /></span><Icon name="arrow" size={16} class="sg-arr" /><span class="h-display sg-t">All services</span></a></li>
    </ul>
  </section>

  <!-- REVIEWS -->
  <section class="rv white">
    <div class="wrap rv-grid">
      <div class="rv-l">
        <Eyebrow>Real customers</Eyebrow>
        <h2 class="h-display h2" data-split>Hear it<br /><span class="c-cobalt">from them</span></h2>
        <p class="lead rv-p" data-reveal="up">Neighbors on camera, from Jim's Instagram. Video reviews only: nothing here is a Google review.</p>
        <div data-reveal="up" class="rv-btn"><Btn href="/reviews/" variant="ink" icon="instagram" size="sm" arrow>Watch the video reviews</Btn></div>
      </div>
      <VideoReviews />
    </div>
  </section>

  <!-- WHY -->
  <section class="wy yellowbg">
    <div class="wrap">
      <p class="wy-k" data-reveal="up">Why homeowners choose us</p>
      <h2 class="h-display wy-h" data-split>Family crew. Straight answers.</h2>
      <ul class="wy-grid" data-stagger="up">
        <li data-tilt><span class="wy-top"><span class="wy-ico"><Icon name="users" size={18} /></span><span class="led">BROS</span></span><strong class="h-display">Built by brothers</strong><span>Jim trained each brother himself, job by job.</span></li>
        <li data-tilt><span class="wy-top"><span class="wy-ico"><Icon name="clock" size={18} /></span><span class="led">24/7</span></span><strong class="h-display">Open 24/7</strong><span>Nights, weekends and holidays.</span></li>
        <li data-tilt><span class="wy-top"><span class="wy-ico"><Icon name="tag" size={18} /></span><span class="led">1ST</span></span><strong class="h-display">Price before we start</strong><span>You say yes before any work starts.</span></li>
        <li data-tilt><span class="wy-top"><span class="wy-ico"><Icon name="globe" size={18} /></span><span class="led">ES·EN</span></span><strong class="h-display">Hablamos español</strong><span>Ask for Jim.</span></li>
      </ul>
    </div>
  </section>

  <!-- EMERGENCY -->
  <section class="em dark">
    <div class="em-bg" aria-hidden="true"><Image src={pipes} alt="" widths={[720, 1344]} sizes="100vw" data-parallax="0.12" /></div>
    <div class="wrap em-grid">
      <div>
        <span class="em-ico" data-reveal="pop"><Icon name="alert" size={24} /></span>
        <h2 class="h-display h2 em-h" data-split><span class="c-white">Burst pipe</span><br /><span class="c-yellow">in {n}?</span></h2>
        <p class="em-p" data-reveal="up">Turn off the main water valve. Then call us. Day or night.</p>
        <div data-reveal="up"><Btn href={SITE.phoneHref} icon="phone" size="md">Call {SITE.phone}</Btn></div>
      </div>
      <ol class="em-steps" data-stagger="left">
        <li><span class="led">01</span><div><strong class="h-display">Shut off the water</strong><p>The main valve is usually where the line enters the house, often near the front hose bib, or at the meter by the street.</p></div></li>
        <li><span class="led">02</span><div><strong class="h-display">Water heater off</strong><p>If the leak is on the hot side, turn off the water heater too.</p></div></li>
        <li><span class="led">03</span><div><strong class="h-display">Stop using drains</strong><p>If the sewer is backing up, stop running water.</p></div></li>
        <li class="hot"><span class="led">04</span><div><strong class="h-display">Call {SITE.phone}</strong><p>A real person picks up, day or night. Smell gas? Leave first and call SoCalGas from outside.</p></div></li>
      </ol>
    </div>
    <span class="standin em-si">Stand-in photo (background)</span>
  </section>

  <Wave from="#0B0F1A" to="#FFFFFF" flip />
  <div class="tfaq"><FaqSection faqs={p.faqs} line1="Things people" line2="usually ask." line3="" intro={`What ${n} homeowners ask us most. Anything else, just call.`} /></div>
  <Wave from="#FFFFFF" to="#F3F6FB" />

  <!-- NEARBY TOWNS -->
  <section class="nb light">
    <div class="wrap nb-head">
      <div>
        <Eyebrow>Nearby towns</Eyebrow>
        <h2 class="h-display h2" data-split>Nearby towns<br /><span class="c-cobalt">we also cover</span></h2>
      </div>
      <div data-reveal="left" class="nb-all"><Btn href="/areas/" variant="cobalt" size="sm" arrow>See all 28 areas</Btn></div>
    </div>
    <ul class="wrap nb-grid" data-stagger="up">
      {nearby.map((x) => (
        <li><a href={x.href} class="nb-card" data-tilt><LedTile text={x.led} tone={x.home ? 'yellow' : 'cyan'} size="sm" class="nb-led" /><span class="h-display nb-t">{x.name}</span><Icon name="arrow" size={16} class="nb-arr" /></a></li>
      ))}
    </ul>
    <p class="wrap nb-note" data-reveal="up">Drive times are approximate, from 91767 in normal traffic.</p>
    <div class="wrap nb-mall"><Btn href="/areas/" variant="cobalt" size="md" full>See all 28 areas</Btn></div>
  </section>

  <Wave from="#F3F6FB" to="#0B0F1A" flip />
  <ContactSection line1="Need a plumber" line2={`in ${n}?`} text={`Call now. Or send the form and we'll call you back. Backup line ${SITE.backupPhone}.`} />
  <Ticker items={['CALL 909-587-0711', '24/7', 'HABLAMOS ESPAÑOL', 'POMONA', n.toUpperCase(), ...p.neighbours.slice(0, 3).map((x) => x.name.toUpperCase())]} cyan reverse />
</Base>

<style>
  /* HERO */
  .th { position: relative; overflow: hidden; padding: 36px 0 90px; }
  .th-bg { position: absolute; inset: -10% 0 0; z-index: 0; }
  .th-bg img { width: 100%; height: 100%; object-fit: cover; object-position: 60% 50%; }
  .th-bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(11,15,26,.95) 0%, rgba(11,15,26,.82) 45%, rgba(11,15,26,.5) 100%), linear-gradient(0deg, rgba(11,15,26,.8), transparent 45%); }
  .th-grid { position: relative; z-index: 2; display: grid; grid-template-columns: 1fr 360px; gap: 60px; align-items: start; }
  .th-eye { margin-top: 14px; }
  .th-h { margin-top: 12px; font-size: clamp(56px, 7vw, 100px); line-height: .86; }
  .th-sub { margin-top: 18px; font-size: 18px; color: var(--on-dark); }
  .th-drive { display: flex; align-items: center; gap: 12px; margin-top: 30px; max-width: 600px; padding: 16px 18px; border-radius: 12px; background: rgba(11,15,26,.75); border: 1px solid var(--line-dark); backdrop-filter: blur(6px); }
  .th-pt { display: flex; align-items: center; gap: 10px; flex: none; }
  .th-pi { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; }
  .th-pi.cob { background: var(--cobalt); color: #fff; } .th-pi.yel { background: var(--yellow); color: var(--ink); }
