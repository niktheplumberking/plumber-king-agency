<script>
  // Swipe rows on phones: light the dot of the card nearest the left edge.
  document.querySelectorAll<HTMLElement>('[data-swipe]').forEach((row) => {
    const dots = row.parentElement?.querySelectorAll('[data-dots] i');
    if (!dots?.length) return;
    const update = () => {
      const kids = [...row.children] as HTMLElement[];
      const x = row.scrollLeft;
      let best = 0;
      kids.forEach((k, i) => { if (Math.abs(k.offsetLeft - row.offsetLeft - x) < Math.abs(kids[best].offsetLeft - row.offsetLeft - x)) best = i; });
      if (row.scrollLeft + row.clientWidth >= row.scrollWidth - 4) best = kids.length - 1;
      dots.forEach((d, i) => d.classList.toggle('on', i === best));
    };
    row.addEventListener('scroll', update, { passive: true });
  });
</script>

