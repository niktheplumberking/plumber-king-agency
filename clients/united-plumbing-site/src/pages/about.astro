---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Btn from '../components/Btn.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Wave from '../components/Wave.astro';
import Ticker from '../components/Ticker.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import PageHero from '../components/company/PageHero.astro';
import HeroChips from '../components/company/HeroChips.astro';
import VideoTile from '../components/company/VideoTile.astro';
import { SITE } from '../data/site';
import jim from '../assets/img/jim-cutout.png';
import roof from '../assets/img/job-roof.jpg';
import crawl from '../assets/img/job-crawlspace.jpg';

const base = String(Astro.site).replace(/\/$/, '');
const timeline = [
  { y: null, t: 'Jim learns the trade', d: 'Jaime "Jim" Galvez learned plumbing on the job, one call at a time.' },
  { y: null, t: 'The brothers join', d: 'Brothers join and work side by side. Jim trains every new hire himself.' },
  { y: '2018', t: 'United Plumbing starts', d: 'Family owned since 2018. Brothers side by side, taking any job and doing it right.', hl: true },
  { y: null, t: 'More trucks on the road', d: 'today', more: true },
  { y: 'Today', t: 'Still a family business', d: 'LA County, the Inland Empire and Orange County. When you call, you talk to us.' },
];
const rules = [
  { n: '01', t: 'Pick up the phone.', d: 'Day or night. A real person answers.', i: 'phone', c: 'cyan' },
  { n: '02', t: 'Say the price first.', d: 'You know the cost before we start, explained in plain words.', i: 'tag', c: 'yellow' },
  { n: '03', t: 'Fix it right.', d: 'Not a patch that brings us back next week.', i: 'wrench', c: 'cyan' },
  { n: '04', t: 'Leave it clean.', d: "It's your home. We clean up before we leave.", i: 'home', c: 'cyan' },
];
const stats = [
  { v: '2018', l: 'Family owned since', c: 'yellow' },
  { v: '24/7', l: 'Phone answered', c: 'cyan' },
  { v: '13', l: 'Plumbing services', c: 'white', count: 13 },
  { v: '28', l: 'Towns we cover', c: 'white', count: 28 },
];
const crewSlots = [
  { n: '[BROTHER NAME]', r: 'Manager' }, { n: '[BROTHER NAME]', r: 'Lead tech' }, { n: '[TECH NAME]', r: 'Plumber' },
  { n: '[NAME]', r: 'Apprentice' }, { n: '[NAME]', r: 'Office', r2: ' / marketing' },
];
const schema = [{
  '@context': 'https://schema.org', '@type': 'AboutPage', name: 'About United Plumbing', url: `${base}/about/`,
  about: { '@id': `${base}/#business` },
  description: 'Meet Jim Galvez and the brothers behind United Plumbing in Pomona, CA. Family owned since 2018.',
}];
---
<Base title="About United Plumbing | Family Owned Since 2018 | Pomona" description="Meet Jim Galvez and the brothers behind United Plumbing in Pomona, CA. Family owned since 2018. Call or text (909) 587-0711." crumbs={[{ name: 'About', href: '/about/' }]} schema={schema}>

  <PageHero crumbs={[{ name: 'About', href: '/about/' }]} class="ab-hero">
    <div class="abh-grid">
      <div class="abh-copy">
        <p class="hpill-red" data-hero="1" data-hero-fx="pop"><Icon name="users" size={14} />About us · Built by brothers</p>
        <h1 class="h-display abh-h" data-hero="2" data-hero-fx="lines"><span class="c-yellow">Family.</span><br />Pomona's plumbing brothers.</h1>
        <p class="abh-p" data-hero="3" data-hero-fx="up">United Plumbing is a family business. Brothers built it. Jim runs it. Since 2018.</p>
        <div class="btn-row abh-btns" data-hero="4" data-hero-fx="up" data-hero-children>
          <Btn href={SITE.phoneHref} icon="phone" size="lg">Call {SITE.phone}</Btn>
          <Btn href="#contact" variant="outline-cyan" icon="message" size="lg">Get a call back</Btn>
        </div>
        <HeroChips order="5" />
      </div>
      <div class="abh-jim" data-hero="1" data-hero-fx="right" data-hero-at="0.15">
        <span class="abh-glow" aria-hidden="true"></span>
        <span class="abh-dash" aria-hidden="true"></span>
        <span class="abh-ring" aria-hidden="true"></span>
        <Image src={jim} alt="Jaime “Jim” Galvez, owner of United Plumbing" widths={[400, 640, 900]} sizes="(max-width: 900px) 80vw, 520px" loading="eager" format="webp" quality={82} class="abh-img" />
        <p class="abh-est" data-hero="6" data-hero-fx="pop"><small>Family owned</small><span class="led">EST. 2018</span></p>
        <p class="abh-tag" data-hero="7" data-hero-fx="pop"><strong class="h-display">Jim</strong><small>Galvez · Owner</small></p>
      </div>
    </div>
  </PageHero>

  <!-- OUR STORY -->
  <section class="section light st">
    <div class="wrap st-grid">
      <div class="st-left">
        <Eyebrow>Our story</Eyebrow>
        <h2 class="h-display h2 st-h" data-split>It started with<br /><span class="c-cobalt">brothers and a truck.</span></h2>
        <div class="st-body" data-reveal="up">
          <p>United Plumbing started in 2018 with family. Brothers working side by side, taking any job they could get, and doing it right so people would call again.</p>
          <p>Today we run <em class="ph">[NUMBER]</em> trucks out of Pomona and cover LA County, the Inland Empire and Orange County.</p>
          <p>We're still a family business. When you call, you talk to us.</p>
        </div>
        <div class="st-sig" data-reveal="up">
          <span class="st-sig-box">Jim's signature goes here</span>
          <p class="h-display">Jim Galvez, Owner</p>
        </div>
        <div class="st-photos">
          <span class="st-block" data-reveal="clipx" aria-hidden="true"></span>
          <figure class="st-main" data-reveal="clip"><Image src={roof} alt="The United Plumbing crew carrying equipment up a ladder to a roof" widths={[400, 700]} sizes="(max-width: 900px) 70vw, 300px" data-parallax="0.08" /></figure>
          <figure class="st-small" data-reveal="pop"><Image src={crawl} alt="A Galvez brother working on drain pipes in a crawl space" widths={[300, 500]} sizes="190px" /></figure>
        </div>
      </div>
      <ol class="tl">
        <span class="tl-pipe" aria-hidden="true"><span class="tl-fill" data-progress-y></span></span>
        {timeline.map((s) => (
          <li class:list={['tl-item', { hl: s.hl }]} data-reveal="left">
            <span class="tl-node" aria-hidden="true"><Icon name={s.hl ? 'home' : 'drop'} size={16} /></span>
            <div class="tl-card" data-tilt>
              <span class="led tl-y">{s.y ?? <em class="ph">[YEAR]</em>}</span>
              <div>
                <h3 class="h-display tl-t">{s.t}</h3>
                <p class="tl-d">{s.more ? <>Today <em class="ph">[NUMBER]</em> trucks run out of Pomona.</> : s.d}</p>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Wave from="#F3F6FB" to="#0B0F1A" />

  <!-- STATS -->
  <section class="stats dark">
    <div class="stats-glow" aria-hidden="true"></div>
    <ul class="wrap stats-grid" data-stagger="up">
      {stats.map((s) => (
        <li class={`stat stat-${s.c}`} data-tilt>
          <span class="led stat-v">{s.count ? <span data-count={s.count}>{s.v}</span> : s.v}</span>
          <span class="stat-l">{s.l}</span>
        </li>
      ))}
    </ul>
  </section>

  <Wave from="#0B0F1A" to="#F3F6FB" flip />

  <!-- CREW -->
  <section class="section light crew">
    <div class="wrap head-center">
      <Eyebrow>The crew</Eyebrow>
      <h2 class="h-display h2" data-split>The people<br /><span class="c-cobalt">at your door.</span></h2>
      <p class="lead" data-reveal="up">Family first. Every person on the crew is someone Jim knows and trusts.</p>
    </div>
    <ul class="wrap crew-grid" data-stagger="up">
      <li class="crew-card crew-jim" data-tilt>
        <div class="crew-ph crew-ph-jim"><span class="crew-badge">Owner</span><Image src={jim} alt="Jim Galvez, owner of United Plumbing" widths={[300, 500]} sizes="(max-width: 700px) 45vw, 280px" format="webp" /></div>
        <h3 class="h-display crew-n">Jim Galvez</h3>
        <p class="crew-r c-cobalt">Owner</p>
      </li>
      {crewSlots.map((c) => (
        <li class="crew-card">
          <div class="crew-ph slot"><Icon name="camera" size={40} /><span>Crew photo<span class="d-only"> + name + role</span><br />goes here</span></div>
          <h3 class="h-display crew-n"><em class="ph">{c.n}</em></h3>
          <p class="crew-r"><em class="ph">[ROLE<span class="d-only">: Jim to confirm</span>]</em><span class="d-only"> ·</span> e.g. {c.r}{c.r2 && <span class="d-only">{c.r2}</span>}</p>
        </li>
      ))}
      <li class="crew-train"><Icon name="wrench" size={22} /><span class="h-display">Jim trains every new plumber himself.</span></li>
    </ul>
    <div class="wrap"><p class="crew-bar h-display" data-reveal="up"><Icon name="wrench" size={26} />Jim trains every new plumber himself.</p></div>
  </section>

  <Wave from="#F3F6FB" to="#0B0F1A" />

  <!-- RULES -->
  <section class="section dark rules">
    <div class="rules-glow" aria-hidden="true"></div>
    <div class="wrap rules-head">
      <div>
        <Eyebrow>How we work</Eyebrow>
        <h2 class="h-display h2" data-split><span class="c-white">Four rules</span><br /><span class="c-cyan">on every job.</span></h2>
      </div>
      <p class="lead" data-reveal="up">The way Jim runs every truck. Simple, and the same on every job.</p>
    </div>
    <div class="wrap rules-grid">
      <figure class="rules-photo" data-reveal="clip">
        <Image src={roof} alt="Two plumbers carrying equipment up a ladder onto a roof" widths={[500, 900]} sizes="(max-width: 900px) 100vw, 440px" data-parallax="0.1" />
        <figcaption class="h-display">On the roof, on the job.</figcaption>
      </figure>
      <div>
        <ul class="rules-cards" data-stagger="up">
          {rules.map((r) => (
            <li class="rule" data-tilt>
              <div class="rule-top"><span class={`led rule-n c-${r.c}`}>{r.n}</span><span class="rule-ico"><Icon name={r.i} size={18} /></span></div>
              <h3 class="h-display rule-t">{r.t}</h3>
              <p class="rule-d">{r.d}</p>
            </li>
          ))}
        </ul>
        <p class="rules-es" data-reveal="up"><Icon name="message" size={18} />Hablamos español</p>
      </div>
    </div>
  </section>

  <Wave from="#0B0F1A" to="#F3F6FB" flip />

  <!-- PROOF ON CAMERA -->
  <section class="proof light">
    <div class="wrap head-center">
      <Eyebrow>Real customers</Eyebrow>
      <h2 class="h-display h2" data-split>Our customers<br /><span class="c-cobalt">say it on camera.</span></h2>
      <p class="lead" data-reveal="up">Anyone can type a review. Our customers look into the camera and say it. Watch them on Instagram.</p>
    </div>
    <div class="film" data-reveal="up">
      <div class="film-track">
        <div class="film-lead">
          <span class="led film-rec">REC<i></i></span>
          <p class="h-display">Video reviews<br />on Instagram</p>
          <small>Filmed on the job</small>
        </div>
        <VideoTile town="Pomona" />
        <VideoTile town="Chino" job="Leak repair" />
        <VideoTile town="West Covina" />
        <a href={SITE.instagram} target="_blank" rel="noopener" class="film-more">
          <Icon name="instagram" size={48} />
          <span class="h-display">More on<br />@plumblord1</span>
          <small>{SITE.instagramFollowers} followers</small>
          <Icon name="arrow" size={26} class="film-arr" />
        </a>
      </div>
    </div>
    <p class="film-swipe" aria-hidden="true">Swipe for more <Icon name="arrow" size={14} /></p>
    <div class="wrap">
      <figure class="pq" data-reveal="up">
        <Icon name="quote" size={40} class="pq-ico" />
        <div>
          <blockquote class="h-display">“Very honest, very helpful, and they’re <span class="c-cobalt">not out to beat you.</span>”</blockquote>
          <figcaption>Customer, video review · Instagram, 10 Jan 2026</figcaption>
        </div>
      </figure>
      <div class="pq-cta" data-reveal="up"><Btn href={SITE.instagram} target="_blank" icon="instagram" size="md">Follow @plumblord1</Btn></div>
      <p class="pq-fol">{SITE.instagramFollowers} followers on Instagram</p>
    </div>
  </section>

  <Wave from="#F3F6FB" to="#0B0F1A" />
  <ContactSection line1="Want the family" line2="on your job?" />
  <Ticker items={['CALL 909-587-0711', '24/7', 'HABLAMOS ESPAÑOL', 'POMONA', 'CLAREMONT', 'CHINO', 'ONTARIO', 'UPLAND']} cyan reverse />
</Base>

<style>
  /* Shared ContactSection has no positioning context, so its photo leaks to the page top: contain it here. */
  :global(section.ct) { position: relative; isolation: isolate; }
  /* HERO (Figma 323:482: 1440 x 820, positions below are Figma px measured from the section top) */
  :global(.phero.ab-hero) { padding: 63px 0 0; min-height: 820px; }
  :global(.ab-hero .phero-bg::after) { background: linear-gradient(90deg, rgba(11,15,26,.97) 0%, rgba(11,15,26,.88) 50%, rgba(11,15,26,.6) 100%); }
  :global(.ab-hero .phero-glow) { display: none; }
  .abh-grid { position: relative; margin-top: 29px; }
  .abh-copy { position: relative; z-index: 2; max-width: 680px; }
  .hpill-red { display: inline-flex; align-items: center; gap: 8px; padding: 7px 14px; border-radius: 99px; background: rgba(51,214,255,.12); color: var(--cyan); font: 700 13px/17px var(--body); letter-spacing: .12em; text-transform: uppercase; }
  .hpill-red :global(.icon) { width: 16px; height: 16px; }
  .abh-h { margin-top: 13px; font-size: 104px; line-height: .86; letter-spacing: 0; color: #fff; }
  .abh-p { margin-top: 24px; max-width: 520px; font-size: 20px; line-height: 1.5; color: #c9d2e3; }
  .abh-btns { margin-top: 34px; gap: 16px; }
  .abh-btns :global(.btn) { --bh: 72px; height: 72px; border-radius: 10px; font-size: 26px; letter-spacing: .02em; }
  .abh-btns :global(.btn:first-child) { width: 330px; }
  .abh-btns :global(.btn-outline-cyan) { width: 270px; font-size: 24px; border-width: 2px; background: transparent; }
  .abh-copy :global(.hchips) { margin-top: 32px; }
  /* Jim column: a 600 x 600 box at Figma (800, 120); everything inside is placed from that box. */
  .abh-jim { position: absolute; right: -40px; top: -8px; width: 600px; height: 600px; z-index: 1; }
  .abh-glow { position: absolute; left: 20px; top: 20px; width: 560px; height: 560px; border-radius: 50%; background: radial-gradient(closest-side, rgba(31,79,216,.55), rgba(31,79,216,.18) 70%, transparent); }
  .abh-dash { position: absolute; inset: 0; border-radius: 50%; border: 2px dotted rgba(51,214,255,.28); }
  .abh-ring { position: absolute; left: 30px; top: 30px; width: 540px; height: 540px; border-radius: 50%; border: 4px solid var(--cyan); box-shadow: 0 0 40px -6px rgba(51,214,255,.6), inset 0 0 40px -6px rgba(51,214,255,.35); }
  .abh-img { position: absolute; left: 70px; top: -28px; width: 466px; height: 733px; max-width: none; object-fit: contain; filter: drop-shadow(0 30px 40px rgba(0,0,0,.5)); }
  .abh-est { position: absolute; left: 338px; top: 20px; z-index: 2; width: 222px; height: 92px; padding: 10px 14px; border-radius: 14px; background: #05070d; border: 2px solid #2a3a66; box-shadow: 0 20px 40px -14px rgba(0,0,0,.7); }
  .abh-est small { display: block; color: var(--cyan); font: 700 11px/14px var(--body); letter-spacing: .12em; text-transform: uppercase; }
  .abh-est .led { display: block; margin-top: 6px; color: var(--yellow); font-size: 34px; line-height: 41px; letter-spacing: 0; text-shadow: 0 0 14px rgba(255,209,31,.5); white-space: nowrap; }
  .abh-tag { position: absolute; left: -34px; top: 422px; z-index: 3; width: 330px; height: 140px; border-radius: 70px; background: #fff; border: 6px solid var(--cobalt); color: var(--cobalt); text-align: center; transform: rotate(-6deg); box-shadow: 0 14px 30px rgba(0,0,0,.4); }
  .abh-tag::before { content: ''; position: absolute; inset: 6px; border-radius: 58px; border: 2px dashed #9db2e6; pointer-events: none; }
  .abh-tag strong { display: block; margin-top: 2px; font-size: 84px; line-height: 101px; letter-spacing: 0; }
  .abh-tag small { position: absolute; left: 0; right: 0; top: 90px; color: var(--ink); font: 700 16px/21px var(--body); letter-spacing: .14em; text-transform: uppercase; }

  /* STORY (Figma 323:539: content 1248 tall, then the wave) */
  .st { overflow: hidden; padding: 100px 0 0; min-height: 1232px; }
  .st :global(.eyebrow), .crew :global(.eyebrow), .rules :global(.eyebrow), .proof :global(.eyebrow) { display: flex; font-size: 13px; line-height: 17px; letter-spacing: .14em; }
  .crew :global(.eyebrow), .proof :global(.eyebrow) { justify-content: center; }
  .st :global(.eyebrow .icon), .crew :global(.eyebrow .icon), .rules :global(.eyebrow .icon), .proof :global(.eyebrow .icon) { width: 16px; height: 16px; }
  .st-grid { display: grid; grid-template-columns: 540px 1fr; gap: 50px; }
  .st-h { margin-top: 13px; font-size: 60px; line-height: .92; letter-spacing: 0; }
  .st-body { margin-top: 20px; max-width: 520px; color: #475569; font-size: 18px; line-height: 1.6; }
  .st-body p + p { margin-top: 28.8px; }
  .st-sig { position: relative; margin-top: 69px; width: 380px; height: 130px; border-radius: 14px; background: #fff; border: 1px solid #dce3ee; }
  .st-sig-box { position: absolute; left: 18px; top: 16px; width: 340px; height: 56px; padding: 16px 12px; border: 1.5px dashed #9db2e6; border-radius: 8px; background: #f7f9fd; font: 600 13px/17px var(--body); color: #475569; }
  .st-sig p { position: absolute; left: 18px; top: 84px; font: 800 20px/24px var(--display); text-transform: none; color: var(--ink); }
  .st-photos { position: relative; height: 451px; margin-top: 40px; }
  .st-block { position: absolute; left: -40px; top: 30px; width: 300px; height: 380px; background: var(--cobalt); }
  .st-main { position: absolute; left: 0; top: 0; width: 400px; height: 330px; overflow: hidden; border-radius: 16px; }
  .st-main img { width: 100%; height: 115%; object-fit: cover; }
  .st-small { position: absolute; left: 240px; top: 220px; width: 250px; height: 220px; overflow: hidden; border: 6px solid #fff; border-radius: 14px; background: #fff; transform: rotate(5deg); box-shadow: 0 24px 50px -16px rgba(0,0,0,.45); transition: transform .5s var(--ease-out); }
  .st-small:hover { transform: rotate(0) scale(1.04); }
  .st-small img { width: 100%; height: 100%; object-fit: cover; }
  .tl { position: relative; display: grid; align-content: start; align-self: start; gap: 34px; margin-top: 20px; padding-left: 110px; }
  .tl-pipe { position: absolute; left: 24px; top: 10px; bottom: -34px; width: 12px; border-radius: 6px; background: var(--ink); }
  .tl-fill { position: absolute; left: 4px; right: 4px; top: 0; bottom: 0; border-radius: 2px; background: var(--cyan); }
  .tl-item { position: relative; }
  .tl-node { position: absolute; left: -110px; top: 38px; z-index: 1; display: grid; place-items: center; width: 60px; height: 60px; border-radius: 50%; background: var(--ink); color: var(--cyan); border: 4px solid var(--cyan); }
  .tl-node :global(.icon) { width: 24px; height: 24px; }
  .tl-node::after { content: ''; position: absolute; left: 100%; top: 50%; width: 54px; height: 4px; margin: -2px 0 0 4px; border-radius: 2px; background: var(--cyan); }
  .hl .tl-node { background: var(--yellow); color: var(--ink); border-color: var(--ink); }
  .hl .tl-node::after { background: var(--yellow); }
  .tl-card { position: relative; overflow: hidden; display: grid; grid-template-columns: 188px minmax(0, 330px); height: 180px; padding: 24px 0 0 30px; border-radius: 18px; background: #fff; border: 1px solid #dce3ee; transition: box-shadow .4s; }
  .tl-card:hover { box-shadow: 0 20px 40px -24px rgba(31,79,216,.45); }
  .tl-y { color: var(--cobalt); font-size: 40px; line-height: 48px; letter-spacing: 0; white-space: nowrap; text-transform: uppercase; }
  .tl-y .ph { background: none; padding: 0; }
  .tl-y .ph { font-family: var(--led); }
  .tl-t { margin-top: 4px; font-size: 30px; line-height: 36px; letter-spacing: 0; color: var(--ink); }
  .tl-d { margin-top: 4px; font-size: 16px; line-height: 1.5; color: #475569; }
  .hl .tl-card { grid-template-columns: 218px minmax(0, 300px); padding: 25px 0 0 31px; background: radial-gradient(260px 260px at 490px 50px, rgba(31,79,216,.55), transparent 70%), #0b0f1a; border: 0; }
  .hl .tl-y { color: var(--yellow); font-size: 56px; line-height: 67px; text-shadow: 0 0 16px rgba(255,209,31,.5); }
  .hl .tl-t { margin-top: 11px; color: #fff; } .hl .tl-d { color: #c9d2e3; }

  /* STATS (Figma 326:437: content 398 tall, then the wave) */
  .stats { position: relative; min-height: 382px; padding: 70px 0 0; overflow: hidden; }
  .stats-glow { position: absolute; left: 380px; top: -240px; width: 740px; height: 540px; background: radial-gradient(closest-side, rgba(31,79,216,.5), transparent); }
  .stats-grid { position: relative; display: grid; grid-template-columns: repeat(4, 1fr); gap: 40px; }
  .stat { position: relative; overflow: hidden; display: block; height: 220px; border-radius: 16px; background: #131b2e; border: 1.5px solid #24304a; text-align: center; }
  .stat::before { content: ''; position: absolute; left: -1.5px; right: -1.5px; top: -1.5px; height: 4px; background: var(--cobalt); }
  .stat-yellow::before { background: var(--yellow); } .stat-cyan::before { background: var(--cyan); }
  .stat-v { display: block; margin-top: 34.5px; font-size: 84px; line-height: 1; letter-spacing: 0; color: #fff; }
  .stat-yellow .stat-v { color: var(--yellow); text-shadow: 0 0 16px rgba(255,210,31,.45); }
  .stat-cyan .stat-v { color: var(--cyan); text-shadow: 0 0 16px rgba(51,214,255,.45); }
  .stat-l { display: block; margin-top: 36px; color: #a3aec6; font: 700 14px/18px var(--body); letter-spacing: .14em; text-transform: uppercase; }

  /* CREW (Figma 326:471: content 1288 tall, then the wave) */
  .crew { padding: 90px 0 0; min-height: 1272px; }
  .crew .h2 { margin-top: 13px; font-size: 72px; line-height: .92; letter-spacing: 0; }
