---
// Areas hub. Figma: 337:437 (desktop) / 339:437 (mobile). Copy: site-copy/06-areas.md.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Btn from '../components/Btn.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Wave from '../components/Wave.astro';
import Ticker from '../components/Ticker.astro';
import CallbackForm from '../components/sections/CallbackForm.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import Crumbs from '../components/towns/Crumbs.astro';
import LedTile from '../components/towns/LedTile.astro';
import VideoReviews from '../components/towns/VideoReviews.astro';
import { TOWNS } from '../data/towns';
import { COUNTY_GROUPS } from '../data/town-content';
import { SITE } from '../data/site';
import dusk from '../assets/img/dusk-street.jpg';
import map from '../assets/img/map-service-area.jpg';

const site = Astro.site!.toString().replace(/\/$/, '');
const groups = COUNTY_GROUPS.map((g) => {
  const towns = TOWNS.filter((t) => t.county === g.county).map((t) => ({ name: t.name, href: `/${t.slug}/`, led: `~${t.drive} MIN`, home: false }));
  const list = g.id === 'la-county' ? [{ name: 'Pomona', href: '/', led: 'BASE', home: true }, ...towns] : towns;
  return { ...g, list };
});
const claremont = TOWNS.find((t) => t.slug === 'plumber-claremont')!;

const faqs = [
  { q: 'Do you charge more for farther towns?', a: 'You hear the full price before any work starts, wherever you are. <em class="ph">Travel fee: Jim to confirm</em>' },
  { q: 'Are you open 24/7 in every town?', a: 'Yes, the phone is answered 24/7. Drive time depends on distance.' },
  { q: 'Do you go to Los Angeles city?', a: 'Call and tell us where you are, and we tell you straight if we can get there. <em class="ph">LA city: Jim to confirm</em>' },
];
const schema = [
  {
    '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Areas we serve', url: `${site}/areas/`,
    about: { '@id': `${site}/#business` },
    mainEntity: { '@type': 'ItemList', itemListElement: [{ name: 'Pomona', url: `${site}/` }, ...TOWNS.map((t) => ({ name: t.name, url: `${site}/${t.slug}/` }))].map((x, i) => ({ '@type': 'ListItem', position: i + 1, name: `Plumber in ${x.name}, CA`, url: x.url })) },
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: [faqs[1]].map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
const gmaps = 'https://www.google.com/maps/place/Pomona,+CA+91767';
---
<Base title="Plumber Near Pomona | LA, OC & Inland Empire Towns" description="United Plumbing serves Pomona and 27 nearby towns in LA County, the Inland Empire and Orange County. Find your town. Call (909) 587-0711." crumbs={[{ name: 'Areas we serve', href: '/areas/' }]} schema={schema}>

  <!-- HERO -->
  <section class="ah dark">
    <div class="ah-bg" aria-hidden="true"><Image src={dusk} alt="" widths={[768, 1344]} sizes="100vw" loading="eager" fetchpriority="high" data-parallax="0.15" /></div>
    <div class="wrap ah-grid">
      <div class="ah-copy">
        <Crumbs items={[{ name: 'Areas we serve', href: '/areas/' }]} />
        <p class="eyebrow on-dark ah-eye" data-hero="1" data-hero-fx="up"><Icon name="drop" size={14} stroke={2.5} /><span>Areas we cover</span></p>
        <h1 class="h-display ah-h" data-hero="2" data-hero-fx="lines"><span class="c-yellow">Nearby?</span> <br /><span class="c-white">Plumber near Pomona</span></h1>
        <p class="ah-sub" data-hero="3" data-hero-fx="up">Based in Pomona 91767. We cover 28 towns in LA County, the Inland Empire and Orange County.</p>
        <dl class="ah-stats" data-hero="4" data-hero-fx="up">
          <div><dt class="led c-cyan">28</dt><dd>Towns</dd></div>
          <div><dt class="led c-yellow">4</dt><dd>Counties</dd></div>
          <div><dt class="led c-cyan">24/7</dt><dd>Phone answered</dd></div>
          <div><dt class="led c-yellow">~{claremont.drive}</dt><dd>Min to Claremont</dd></div>
        </dl>
        <div class="btn-row ah-btns" data-hero="5" data-hero-fx="up" data-hero-children>
          <Btn href={SITE.phoneHref} icon="phone" size="md">Call {SITE.phoneDisplay}</Btn>
          <Btn href="#callback" variant="outline-cyan" icon="message" size="md">Get a call back</Btn>
        </div>
        <ul class="ah-chips" data-hero="6" data-hero-fx="up" data-hero-children>
          <li><Icon name="clock" size={14} />Answered 24/7</li>
          <li><Icon name="globe" size={14} />Hablamos Español</li>
          <li><Icon name="tag" size={14} />Clear price first</li>
        </ul>
        <p class="ah-k" data-hero="7" data-hero-fx="up">Jump to your county</p>
        <ul class="ah-jump" data-hero="7" data-hero-fx="pop" data-hero-children>
          {groups.map((g) => <li><a href={`#${g.id}`}><Icon name="pin" size={15} /><span>{g.short} · {g.list.length}<span class="hide-s"> towns</span></span></a></li>)}
        </ul>
      </div>
      <div class="ah-form" id="callback" data-hero="3" data-hero-fx="up">
        <CallbackForm variant="card" id="areas-cb" title="Get a call back in your town" zipLabel="Town or ZIP" problemLabel="What's going on?" />
      </div>
    </div>
  </section>

  <Wave from="#0B0F1A" to="#FFFFFF" />

  <!-- ONE BASE -->
  <section class="ob white">
    <div class="wrap ob-head">
      <div>
        <Eyebrow>Our base: Pomona, CA 91767</Eyebrow>
        <h2 class="h-display h2 ob-h" data-split>One base.<br /><span class="c-cobalt">Four counties.</span></h2>
      </div>
      <p class="lead" data-reveal="up">Pomona sits where LA County, San Bernardino County, Riverside County and Orange County come close together. That makes it a good base: a short drive gets us to the foothill towns, the 909 cities, Riverside County and north Orange County.</p>
    </div>
    <figure class="wrap ob-map" data-reveal="clip">
      <div class="ob-mapimg">
        <div class="ob-zoom">
        <Image src={map} alt="Map of Pomona and the surrounding area: LA County, San Bernardino County, Riverside County and Orange County" widths={[600, 1000]} sizes="(max-width: 1340px) 100vw, 1280px" />
        <span class="ob-ring" aria-hidden="true"></span>
        <span class="ob-pin" style="left:33%;top:33.5%"><span class="ob-pinb"><Icon name="home" size={18} /></span><span class="ob-pinl"><Icon name="home" size={13} />Our base: Pomona, CA 91767</span></span>
        <span class="ob-co" style="left:17%;top:30%">LA County</span>
        <span class="ob-co" style="left:66%;top:21%">San Bernardino Co.</span>
        <span class="ob-co" style="left:72%;top:76%">Riverside Co.</span>
        <span class="ob-co" style="left:31%;top:95%">Orange Co.</span>
        </div>
        <span class="ob-led"><span class="led">28 TOWNS</span><small>Pomona + 27 nearby</small></span>
      </div>
      <figcaption class="ob-cap"><span>Map: Google Maps screenshot</span><span class="ob-cap2">County labels are approximate.</span><a href={gmaps} target="_blank" rel="noopener" class="ob-gm">Open in Google Maps <Icon name="arrow" size={14} /></a></figcaption>
    </figure>
  </section>

  <Wave from="#FFFFFF" to="#F3F6FB" flip />

  <!-- TOWN LISTS -->
  <section class="tl light">
    <div class="wrap tl-head">
      <div>
        <Eyebrow>Find your town</Eyebrow>
        <h2 class="h-display h2" data-split>Is your town<br /><span class="c-cobalt">on the list?</span></h2>
      </div>
      <p class="lead" data-reveal="up">Tap your town to see what we do there and how fast we can usually get to you. Drive times are rough, from 91767 in normal traffic.</p>
    </div>
    <ul class="wrap tl-tabs" aria-label="Counties">
      {groups.map((g, i) => <li><a href={`#${g.id}`} class:list={{ on: i === 0 }}>{g.short}</a></li>)}
    </ul>
    <div class="wrap tl-grid" data-stagger="up">
      {groups.map((g) => (
        <section class="tl-card" id={g.id} aria-labelledby={`${g.id}-h`}>
          <header class="tl-top">
            <h3 class="h-display tl-t" id={`${g.id}-h`}>{g.short}</h3>
            <p class="tl-sub">{g.sub}</p>
            <span class:list={['tl-n led', { y: g.id === 'la-county' }]}>{g.list.length} towns</span>
          </header>
          <ul class="tl-list">
            {g.list.map((x) => (
              <li><a href={x.href} class:list={{ home: x.home }}><Icon name={x.home ? 'home' : 'pin'} size={16} class="tl-ico" /><span class="tl-name">{x.name}</span><LedTile text={x.led} tone={x.home ? 'yellow' : 'cyan'} size="sm" /><Icon name="arrow" size={16} class="tl-arr" /></a></li>
            ))}
          </ul>
          {g.id !== 'la-county' && (
            <a href={SITE.instagram} target="_blank" rel="noopener" class="tl-vid" aria-label="Video review on Instagram (opens Instagram)">
              <span class="tl-vb"><Icon name="instagram" size={13} />Video review · Instagram</span>
              <span class="tl-vp" aria-hidden="true"><Icon name="play" size={18} /></span>
              <span class="led tl-vt">{g.short}</span>
              <em class="ph">Name + OK to use: ask Jim</em>
            </a>
          )}
          <a href={SITE.phoneHref} class="tl-call">Town not here? Call {SITE.phone} <Icon name="arrow" size={14} /></a>
        </section>
      ))}
    </div>
    <div class="wrap">
      <div class="tl-miss" data-reveal="up">
        <span class="tl-mi"><Icon name="pin" size={24} /></span>
        <div><p class="h-display tl-mh">Don't see your town?</p><p class="tl-mp">Call anyway. If we can get there, we'll tell you.</p></div>
        <Btn href={SITE.phoneHref} icon="phone" size="md">Call {SITE.phoneDisplay}</Btn>
      </div>
      <p class="tl-note" data-reveal="up">Drive times are rough, from 91767 in normal traffic.</p>
    </div>
  </section>

  <Wave from="#F3F6FB" to="#0B0F1A" />

  <!-- HOW FAST -->
  <section class="hf dark">
    <div class="hf-glow glow" aria-hidden="true"></div>
    <div class="wrap hf-head">
      <div>
        <Eyebrow>How fast can we get there</Eyebrow>
        <h2 class="h-display h2" data-split><span class="c-white">Closer means</span><br /><span class="c-cyan">faster</span></h2>
      </div>
      <p class="lead" data-reveal="up">Every call starts with a real person on the phone, 24/7. How fast we get there depends on how far you are from Pomona.</p>
    </div>
    <ul class="wrap hf-grid" data-stagger="up">
      <li class="hf-card hot" data-tilt>
        <span class="hf-screen"><span class="led c-yellow">~1 HR</span><span class="hf-bars b3" aria-hidden="true"><i></i><i></i><i></i></span></span>
        <strong class="h-display">Pomona &amp; next door</strong>
        <small>Claremont, La Verne, Montclair</small>
        <p>About an hour or less in most cases.</p>
      </li>
      <li class="hf-card" data-tilt>
        <span class="hf-screen"><span class="led c-cyan">ON CALL</span><span class="hf-bars b2" aria-hidden="true"><i></i><i></i><i></i></span></span>
        <strong class="h-display">Rest of the 909 &amp; east LA County</strong>
        <small>Upland, Ontario, Chino, San Dimas, Covina and more</small>
        <p>We'll give you a time on the phone.</p>
      </li>
      <li class="hf-card" data-tilt>
        <span class="hf-screen"><span class="led c-cyan">CALL 1ST</span><span class="hf-bars b1" aria-hidden="true"><i></i><i></i><i></i></span></span>
        <strong class="h-display">Riverside County &amp; OC</strong>
        <small>Corona, Riverside, Brea, Fullerton and more</small>
        <p>Call first. We'll tell you honestly how long.</p>
      </li>
    </ul>
  </section>

  <Wave from="#0B0F1A" to="#FFFFFF" flip />

  <!-- REVIEWS -->
  <section class="ar-rv white">
    <div class="wrap ar-rvh">
      <div>
        <Eyebrow>Trusted by homeowners</Eyebrow>
        <h2 class="h-display h2" data-split>Neighbors all<br /><span class="c-cobalt">over the map</span></h2>
      </div>
      <div data-reveal="left"><Btn href="/reviews/" variant="ink" icon="instagram" size="sm" arrow>Watch the video reviews</Btn></div>
    </div>
    <div class="wrap ar-rvb"><VideoReviews layout="row" /></div>
    <p class="wrap ar-rvn" data-reveal="up">Video reviews from @plumblord1 on Instagram. Instagram reviews only: nothing here is a Google review.</p>
  </section>

  <Wave from="#FFFFFF" to="#131B2E" />

  <!-- SEO BODY -->
  <section class="ab2 dark2">
    <div class="ab2-glow glow" aria-hidden="true"></div>
    <div class="wrap">
      <Eyebrow>About our area</Eyebrow>
      <h2 class="h-display h2 ab2-h" data-split><span class="c-white">Every town has its own</span><br /><span class="c-cyan">kind of plumbing problem</span></h2>
      <div class="ab2-cols" data-reveal="up">
        <div>
          <p>United Plumbing is a family-owned plumbing company based in Pomona, California. Pomona sits where Los Angeles County, San Bernardino County, Riverside County and Orange County come close together. That makes it a good base: in a short drive we can reach the foothill towns like <a href="/plumber-claremont/">Claremont</a>, <a href="/plumber-la-verne/">La Verne</a>, <a href="/plumber-san-dimas/">San Dimas</a> and <a href="/plumber-glendora/">Glendora</a>; the 909 cities like <a href="/plumber-montclair/">Montclair</a>, <a href="/plumber-upland/">Upland</a>, <a href="/plumber-ontario/">Ontario</a>, <a href="/plumber-chino/">Chino</a> and <a href="/plumber-rancho-cucamonga/">Rancho Cucamonga</a>; the Riverside County towns like <a href="/plumber-eastvale/">Eastvale</a>, <a href="/plumber-norco/">Norco</a>, <a href="/plumber-corona/">Corona</a> and <a href="/plumber-riverside/">Riverside</a>; and north Orange County towns like <a href="/plumber-brea/">Brea</a>, <a href="/plumber-yorba-linda/">Yorba Linda</a>, <a href="/plumber-fullerton/">Fullerton</a> and <a href="/plumber-anaheim/">Anaheim</a>.</p>
          <p class="ab2-strong">Pick your town above to see what we do there, what problems we see most, and how fast we can usually get to you. Or just call {SITE.phoneDisplay}. The phone is answered 24/7.</p>
        </div>
        <div>
          <p>Older neighborhoods in Pomona, Claremont, Upland, Ontario, Riverside and Fullerton often have clay sewer lines and cast-iron drains, so tree roots and cracked pipes are common. Hillside tracts in Diamond Bar, Walnut, Chino Hills and Yorba Linda were often built on concrete slabs with copper pipe underneath, so slab leaks show up as homes get older. Newer communities like Eastvale see more water heater and fixture calls. And across the whole region, the water is hard, which wears out water heaters, faucets and pipes faster.</p>
          <p class="ab2-links"><a href="/services/">All 13 services <Icon name="arrow" size={14} /></a><a href="/contact/">Contact us <Icon name="arrow" size={14} /></a></p>
        </div>
      </div>
    </div>
  </section>

  <Wave from="#131B2E" to="#FFFFFF" flip />
  <div class="afaq"><FaqSection faqs={faqs} line1="Things people" line2="usually ask." line3="" intro="Questions about where we go. Anything else, just call." /></div>
  <Wave from="#FFFFFF" to="#0B0F1A" />
  <ContactSection line1="Need a plumber" line2="near you?" text={`Call ${SITE.phoneDisplay} or get a call back. Backup line ${SITE.backupPhone}.`} />
  <Ticker items={['CALL 909-587-0711', '24/7', 'HABLAMOS ESPAÑOL', 'POMONA', 'CLAREMONT', 'CHINO', 'ONTARIO', 'CORONA', 'BREA']} cyan reverse />
</Base>

<style>
  /* HERO */
  .ah { position: relative; overflow: hidden; padding: 36px 0 90px; }
  .ah-bg { position: absolute; inset: -10% 0 0; z-index: 0; }
  .ah-bg img { width: 100%; height: 100%; object-fit: cover; object-position: 60% 50%; }
  .ah-bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(11,15,26,.95) 0%, rgba(11,15,26,.82) 45%, rgba(11,15,26,.5) 100%), linear-gradient(0deg, rgba(11,15,26,.8), transparent 45%); }
  .ah-grid { position: relative; z-index: 2; display: grid; grid-template-columns: 1fr 360px; gap: 60px; align-items: start; }
  .ah-eye { margin-top: 14px; }
  .ah-h { margin-top: 12px; font-size: clamp(56px, 6.6vw, 96px); line-height: .86; }
  .ah-sub { margin-top: 18px; max-width: 640px; font-size: 18px; color: var(--on-dark); }
  .ah-stats { display: grid; grid-template-columns: repeat(4, 1fr); margin: 28px 0 0; max-width: 680px; padding: 18px 0; border-radius: 12px; background: rgba(11,15,26,.75); border: 1px solid var(--line-dark); backdrop-filter: blur(6px); }
  .ah-stats div { padding: 0 20px; border-left: 1px solid var(--line-dark); }
  .ah-stats div:first-child { border-left: 0; }
  .ah-stats dt { font-size: 32px; line-height: 1; }
  .ah-stats dd { margin: 10px 0 0; font-size: 10px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--on-dark-2); }
  .ah-btns { margin-top: 26px; }
  .ah-btns :global(.btn) { min-width: 220px; }
  .ah-btns :global(.btn-outline-cyan) { background: rgba(11,15,26,.5); }
  .ah-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; }
  .ah-chips li { display: inline-flex; align-items: center; gap: 7px; padding: 6px 10px; border-radius: 6px; background: rgba(19,27,46,.85); border: 1px solid rgba(255,255,255,.14); font-size: 12px; font-weight: 600; color: #fff; }
  .ah-chips :global(.icon) { color: var(--cyan); }
  .ah-k { margin-top: 30px; font-size: 11px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--on-dark-2); }
  .ah-jump { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
  .ah-jump a { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 14px; border-radius: 6px; background: rgba(26,36,64,.85); border: 1px solid rgba(255,255,255,.14); color: #fff; font-size: 14px; font-weight: 600; transition: border-color .3s, transform .3s var(--ease-out); }
  .ah-jump a:hover { border-color: var(--cyan); transform: translateY(-2px); }
  .ah-jump :global(.icon) { color: var(--yellow); }
  .ah-form { margin-top: 6px; }
  .ah-form :global(.cbf-card-title) { font-size: 34px; }

  /* ONE BASE */
  .ob { padding: clamp(60px, 7vw, 100px) 0 clamp(70px, 8vw, 110px); }
  .ob-head { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: end; }
  .ob-head .lead { font-size: 15.5px; }
  .ob-h { margin-top: 14px; }
  .ob-map { margin-top: 50px; border-radius: 16px; overflow: hidden; background: var(--night); box-shadow: 0 30px 70px -30px rgba(11,15,26,.55); padding: 0; }
  .ob-mapimg { position: relative; aspect-ratio: 1000/700; overflow: hidden; }
  .ob-zoom { position: absolute; left: 0; top: 0; width: 100%; aspect-ratio: 1000/700; }
  .ob-zoom img { width: 100%; height: 100%; object-fit: cover; }
  .ob-ring { position: absolute; left: 33%; top: 33.5%; width: 26%; aspect-ratio: 1; transform: translate(-50%, -50%); border-radius: 50%; border: 2px dashed rgba(31,79,216,.8); background: rgba(31,79,216,.08); }
  .ob-pin { position: absolute; z-index: 2; transform: translate(-50%, -100%); }
  .ob-pinb { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50% 50% 50% 0; transform: rotate(-45deg); background: var(--yellow); color: var(--ink); box-shadow: 0 8px 18px -6px rgba(0,0,0,.5); }
  .ob-pinb :global(.icon) { transform: rotate(45deg); }
  .ob-pinl { position: absolute; left: 52px; top: 6px; display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; padding: 6px 10px; border-radius: 4px; background: var(--night); color: var(--yellow); font-size: 12px; font-weight: 700; }
  .ob-co { position: absolute; transform: translate(-50%, -50%); padding: 5px 9px; border-radius: 3px; background: var(--night); color: #fff; font-size: 11px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; white-space: nowrap; }
  .ob-led { position: absolute; right: 18px; top: 18px; display: grid; gap: 4px; padding: 12px 16px; border-radius: 8px; background: var(--night); border: 2px solid var(--cyan); }
  .ob-led .led { color: var(--yellow); font-size: 32px; line-height: 1; }
  .ob-led small { color: var(--on-dark-2); font-size: 11px; }
  .ob-cap { display: flex; align-items: center; gap: 24px; padding: 14px 18px; color: var(--on-dark-2); font-size: 12px; }
  .ob-cap2 { opacity: .7; }
  .ob-gm { margin-left: auto; display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 14px; border-radius: 6px; background: var(--cobalt); color: #fff; font-weight: 700; font-size: 13px; transition: background .3s; }
  .ob-gm:hover { background: #3a68ee; }

  /* TOWN LISTS */
  .tl { padding: clamp(60px, 7vw, 100px) 0 clamp(70px, 8vw, 100px); }
  .tl-head { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: end; }
  .tl-head .lead { font-size: 15.5px; }
  .tl-tabs { display: none; }
  .tl-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 56px; align-items: stretch; }
  .tl-card { display: flex; flex-direction: column; border-radius: 14px; overflow: hidden; background: #fff; box-shadow: 0 20px 50px -30px rgba(11,15,26,.4); scroll-margin-top: 110px; }
  .tl-top { padding: 18px 16px 14px; color: #fff; background: radial-gradient(130% 160% at 100% 0%, #1f4fd8 0%, #10173a 50%, #0b0f1a 85%); }
  .tl-t { font-size: 30px; }
  .tl-sub { font-size: 12px; color: var(--on-dark-2); margin-top: 4px; }
  .tl-n { display: inline-block; margin-top: 8px; padding: 3px 7px; border-radius: 3px; background: var(--cobalt); color: #fff; font-size: 11px; text-transform: uppercase; }
  .tl-n.y { background: var(--yellow); color: var(--ink); }
  .tl-list { display: grid; gap: 6px; padding: 12px 8px 4px; }
  .tl-list a { display: flex; align-items: center; gap: 10px; min-height: 44px; padding: 4px 8px 4px 10px; border-radius: 8px; font-size: 14px; font-weight: 600; color: var(--ink); transition: background .25s; }
  .tl-list li:nth-child(odd) a { background: var(--paper); }
  .tl-list a:hover { background: #e4ebf8; }
  .tl-list :global(.tl-ico) { color: var(--ink-3); flex: none; }
  .tl-list a.home :global(.tl-ico) { color: var(--cobalt); }
