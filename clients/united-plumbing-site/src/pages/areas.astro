---
// Areas hub. Figma: 337:437 (desktop) / 339:437 (mobile). Copy: site-copy/06-areas.md.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Btn from '../components/Btn.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Wave from '../components/Wave.astro';
import Ticker from '../components/Ticker.astro';
import CallbackForm from '../components/sections/CallbackForm.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import Crumbs from '../components/towns/Crumbs.astro';
import LedTile from '../components/towns/LedTile.astro';
import VideoReviews from '../components/towns/VideoReviews.astro';
import { TOWNS } from '../data/towns';
import { COUNTY_GROUPS } from '../data/town-content';
import { SITE } from '../data/site';
import dusk from '../assets/img/dusk-street.jpg';
import map from '../assets/img/map-service-area.jpg';

const site = Astro.site!.toString().replace(/\/$/, '');
const groups = COUNTY_GROUPS.map((g) => {
  const towns = TOWNS.filter((t) => t.county === g.county).sort((a, b) => a.drive - b.drive).map((t) => ({ name: t.name, href: `/${t.slug}/`, led: `~${t.drive} MIN`, home: false }));
  const list = g.id === 'la-county' ? [{ name: 'Pomona', href: '/', led: 'BASE', home: true }, ...towns] : towns;
  return { ...g, list };
});
const vidTown: Record<string, string> = { 'san-bernardino': 'Ontario', riverside: 'Riverside', 'orange-county': 'Yorba Linda' };
const claremont = TOWNS.find((t) => t.slug === 'plumber-claremont')!;

const faqs = [
  { q: 'Do you charge more for farther towns?', a: 'You hear the full price before any work starts, wherever you are. <em class="ph">Travel fee: Jim to confirm</em>' },
  { q: 'Are you open 24/7 in every town?', a: 'Yes, the phone is answered 24/7. Drive time depends on distance.' },
  { q: 'Do you go to Los Angeles city?', a: 'Call and tell us where you are, and we tell you straight if we can get there. <em class="ph">LA city: Jim to confirm</em>' },
];
const schema = [
  {
    '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Areas we serve', url: `${site}/areas/`,
    about: { '@id': `${site}/#business` },
    mainEntity: { '@type': 'ItemList', itemListElement: [{ name: 'Pomona', url: `${site}/` }, ...TOWNS.map((t) => ({ name: t.name, url: `${site}/${t.slug}/` }))].map((x, i) => ({ '@type': 'ListItem', position: i + 1, name: `Plumber in ${x.name}, CA`, url: x.url })) },
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: [faqs[1]].map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
const gmaps = 'https://www.google.com/maps/place/Pomona,+CA+91767';
---
<Base title="Plumber Near Pomona | LA, OC & Inland Empire Towns" description="United Plumbing serves Pomona and 27 nearby towns in LA County, the Inland Empire and Orange County. Find your town. Call (909) 587-0711." crumbs={[{ name: 'Areas we serve', href: '/areas/' }]} schema={schema}>

  <!-- HERO -->
  <section class="ah dark">
    <div class="ah-bg" aria-hidden="true"><Image src={dusk} alt="" widths={[768, 1344]} sizes="100vw" loading="eager" fetchpriority="high" data-parallax="0.15" /></div>
    <div class="ah-glow glow" aria-hidden="true"></div>
    <div class="wrap ah-grid">
      <div class="ah-copy">
        <Crumbs items={[{ name: 'Areas we serve', href: '/areas/' }]} />
        <p class="eyebrow on-dark ah-eye" data-hero="1" data-hero-fx="up"><Icon name="drop" size={16} stroke={2.5} /><span>Areas we cover</span></p>
        <h1 class="h-display ah-h" data-hero="2" data-hero-fx="lines"><span class="c-yellow">Nearby?</span> <br /><span class="c-white">Plumber<br class="ah-mbr" /> near Pomona</span></h1>
        <p class="ah-sub" data-hero="3" data-hero-fx="up">Based in Pomona 91767. We cover 28 towns in LA County, the Inland Empire and Orange County.</p>
        <dl class="ah-stats" data-hero="4" data-hero-fx="up">
          <div><dt class="led c-cyan">28</dt><dd>Towns</dd></div>
          <div><dt class="led c-yellow">4</dt><dd>Counties</dd></div>
          <div><dt class="led c-cyan">24/7</dt><dd>Phone answered</dd></div>
          <div><dt class="led c-yellow">~{claremont.drive}</dt><dd>Min to Claremont</dd></div>
        </dl>
        <div class="btn-row ah-btns" data-hero="5" data-hero-fx="up" data-hero-children>
          <Btn href={SITE.phoneHref} icon="phone" class="ah-call">Call {SITE.phoneDisplay}</Btn>
          <Btn href="#callback" variant="outline-cyan" icon="message" class="ah-text">Get a call back</Btn>
        </div>
        <ul class="ah-chips" data-hero="6" data-hero-fx="up" data-hero-children>
          <li><Icon name="clock" size={16} />Answered 24/7</li>
          <li><Icon name="globe" size={16} />Hablamos Español</li>
          <li><Icon name="tag" size={16} />Clear price first</li>
        </ul>
        <p class="ah-k" data-hero="7" data-hero-fx="up">Jump to your county</p>
        <ul class="ah-jump" data-hero="7" data-hero-fx="pop" data-hero-children>
          {groups.map((g) => <li><a href={`#${g.id}`}><Icon name="pin" size={16} /><span>{g.short}<span class="ah-dot">·</span>{g.list.length}<span class="hide-s"> towns</span></span></a></li>)}
        </ul>
      </div>
      <div class="ah-form" id="callback" data-hero="3" data-hero-fx="up">
        <CallbackForm variant="town" id="areas-cb" title="Get a call back in your town" zipLabel="Town or ZIP" zipPlaceholder="Pomona, 91767" problemLabel="What's going on?" />
      </div>
    </div>
  </section>

  <Wave from="#0B0F1A" to="#FFFFFF" />

  <!-- ONE BASE -->
  <section class="ob white">
    <div class="wrap ob-head">
      <div>
        <Eyebrow>Our base: Pomona, CA 91767</Eyebrow>
        <h2 class="h-display ar-h2" data-split>One base.<br /> <span class="c-cobalt">Four counties.</span></h2>
      </div>
      <p class="ob-lead" data-reveal="up">Pomona sits where LA County, San Bernardino County, Riverside County and Orange County come close together. <span class="ob-ld">That makes it a good base: a short drive gets us to the foothill towns, the 909 cities, Riverside County and north Orange County.</span><span class="ob-lm">A short drive gets us to all four.</span></p>
    </div>
    <figure class="wrap ob-map" data-reveal="clip">
      <div class="ob-mapimg">
        <div class="ob-zoom">
          <Image src={map} alt="Map of Pomona and the surrounding area: LA County, San Bernardino County, Riverside County and Orange County" widths={[600, 1000]} sizes="(max-width: 1340px) 100vw, 1280px" />
          <span class="ob-ring" aria-hidden="true"></span>
          <span class="ob-pin"><span class="ob-pinb"><Icon name="home" size={22} /></span><span class="ob-pinl"><Icon name="home" size={16} />Our base: Pomona, CA 91767</span></span>
          <span class="ob-co co-la">LA County</span>
          <span class="ob-co co-sb">San Bernardino Co.</span>
          <span class="ob-co co-rv">Riverside Co.</span>
          <span class="ob-co co-oc">Orange Co.</span>
        </div>
        <span class="ob-fade" aria-hidden="true"></span>
        <span class="ob-led"><span class="led">28 TOWNS</span><small>Pomona + 27<span class="ob-ld"> nearby</span></small></span>
      </div>
      <figcaption class="ob-cap"><span>Map: Google Maps screenshot, 4 Nov 2026</span><span class="ob-cap2">County labels are approximate.</span><a href={gmaps} target="_blank" rel="noopener" class="ob-gm">Open in Google Maps <Icon name="arrow" size={14} class="ob-gma" /></a></figcaption>
    </figure>
  </section>

  <Wave from="#FFFFFF" to="#F3F6FB" flip />

  <!-- TOWN LISTS -->
  <section class="tl light">
    <div class="wrap tl-head">
      <div>
        <Eyebrow>Find your town</Eyebrow>
        <h2 class="h-display ar-h2" data-split>Is your town<br /> <span class="c-cobalt">on the list?</span></h2>
      </div>
      <p class="ob-lead" data-reveal="up">Tap your town to see what we do there<span class="ob-ld"> and how fast we can usually get to you</span>. Drive times are rough, from 91767 in normal traffic.</p>
    </div>
    <ul class="wrap tl-tabs" aria-label="Counties">
      {groups.map((g, i) => <li><a href={`#${g.id}`} class:list={{ on: i === 0 }}>{g.short}</a></li>)}
    </ul>
    <div class="wrap tl-grid" data-stagger="up">
      {groups.map((g) => (
        <section class="tl-card" id={g.id} aria-labelledby={`${g.id}-h`}>
          <header class="tl-top">
            <span class="tl-glow" aria-hidden="true"></span>
            <h3 class="h-display tl-t" id={`${g.id}-h`}>{g.short}</h3>
            <p class="tl-sub">{g.sub}</p>
            <span class:list={['tl-n led', { y: g.id === 'la-county' }]}>{g.list.length} towns</span>
          </header>
          <ul class="tl-list">
            {g.list.map((x) => (
              <li><a href={x.href} class:list={{ home: x.home, long: x.name.length > 14 }}><Icon name={x.home ? 'home' : 'pin'} size={16} class="tl-ico" /><span class="tl-name">{x.name}</span><LedTile text={x.led} tone={x.home ? 'yellow' : 'cyan'} size="sm" /><Icon name="arrow" size={16} class="tl-arr" /></a></li>
            ))}
          </ul>
          {g.id !== 'la-county' && (
            <a href={SITE.instagram} target="_blank" rel="noopener" class="tl-vid" aria-label="Video review on Instagram (opens Instagram)">
              <span class="tl-glow" aria-hidden="true"></span>
              <span class="tl-vb"><Icon name="instagram" size={13} />Video review · Instagram</span>
              <span class="tl-vp" aria-hidden="true"><Icon name="play" size={18} /></span>
              <span class="led tl-vt">From {vidTown[g.id]}</span>
              <em class="ph">Name + OK to use: ask Jim</em>
            </a>
          )}
          <a href={SITE.phoneHref} class="tl-call">Town not here? Call {SITE.phone} <Icon name="arrow" size={16} /></a>
        </section>
      ))}
    </div>
    <div class="wrap">
      <div class="tl-miss" data-reveal="up">
        <span class="tl-glow" aria-hidden="true"></span>
        <span class="tl-mi"><Icon name="pin" size={30} /></span>
        <div><p class="h-display tl-mh">Don't see your town?</p><p class="tl-mp">Call anyway. If we can get there, we'll tell you.</p></div>
        <Btn href={SITE.phoneHref} icon="phone" class="tl-mb">Call {SITE.phoneDisplay}</Btn>
      </div>
      <p class="tl-note" data-reveal="up">Drive times are rough, from 91767 in normal traffic.</p>
    </div>
  </section>

  <Wave from="#F3F6FB" to="#0B0F1A" />

  <!-- HOW FAST -->
  <section class="hf dark">
    <div class="hf-glow glow" aria-hidden="true"></div>
    <div class="wrap hf-head">
      <div>
        <Eyebrow>How fast can we get there</Eyebrow>
        <h2 class="h-display ar-h2" data-split><span class="c-white">Closer means</span><br /> <span class="c-cyan">faster</span></h2>
      </div>
      <p class="ob-lead hf-lead" data-reveal="up">Every call starts with a real person on the phone, 24/7. How fast we get there depends on how far you are from Pomona.</p>
    </div>
    <ul class="wrap hf-grid" data-stagger="up">
      <li class="hf-card hot" data-tilt>
        <span class="hf-screen"><span class="led c-yellow">~1 HR</span><span class="hf-bars b3" aria-hidden="true"><i></i><i></i><i></i></span></span>
        <strong class="h-display">Pomona &amp; next door</strong>
        <small>Claremont, La Verne, Montclair</small>
        <p>About an hour or less in most cases.</p>
      </li>
      <li class="hf-card" data-tilt>
        <span class="hf-screen"><span class="led c-cyan">ON CALL</span><span class="hf-bars b2" aria-hidden="true"><i></i><i></i><i></i></span></span>
        <strong class="h-display">Rest of the 909 &amp; east LA County</strong>
        <small>Upland, Ontario, Chino, San Dimas, Covina and more</small>
        <p>We'll give you a time on the phone.</p>
      </li>
      <li class="hf-card" data-tilt>
        <span class="hf-screen"><span class="led c-cyan">CALL 1ST</span><span class="hf-bars b1" aria-hidden="true"><i></i><i></i><i></i></span></span>
        <strong class="h-display">Riverside County &amp; OC</strong>
        <small>Corona, Riverside, Brea, Fullerton and more</small>
        <p>Call first. We'll tell you honestly how long.</p>
      </li>
    </ul>
  </section>

  <Wave from="#0B0F1A" to="#FFFFFF" flip />

  <!-- REVIEWS -->
  <section class="ar-rv white">
    <div class="wrap ar-rvh">
      <div>
        <Eyebrow>Trusted by homeowners</Eyebrow>
        <h2 class="h-display ar-h2" data-split>Neighbors all<br /> <span class="c-cobalt">over the map</span></h2>
      </div>
      <div class="ar-watch" data-reveal="left"><Btn href="/reviews/" variant="ink" icon="instagram" size="sm" arrow>Watch the video reviews</Btn></div>
    </div>
    <p class="wrap ar-rvl">Real customers on camera, from Jim's Instagram (@plumblord1).</p>
    <div class="wrap ar-rvb"><VideoReviews layout="row" towns={['Pomona', 'West Covina', 'Chino']} /></div>
    <div class="wrap ar-watch-m"><Btn href="/reviews/" variant="ink" icon="instagram" full>Watch the video reviews</Btn></div>
    <p class="wrap ar-rvn" data-reveal="up"><span class="ob-ld">Video reviews from @plumblord1 on Instagram. </span>Instagram reviews only: nothing here is a Google review.</p>
  </section>

  <Wave from="#FFFFFF" to="#131B2E" />

  <!-- SEO BODY -->
  <section class="ab2 dark2">
    <div class="ab2-glow glow" aria-hidden="true"></div>
    <div class="wrap">
      <Eyebrow>About our area</Eyebrow>
      <h2 class="h-display ab2-h" data-split><span class="c-white">Every town has <span class="ab2-io">its own</span></span><br class="ab2-br" /> <span class="c-cyan">kind of plumbing problem</span></h2>
      <div class="ab2-cols" data-reveal="up">
        <div>
          <p>United Plumbing is a family-owned plumbing company based in Pomona, California. Pomona sits where Los Angeles County, San Bernardino County, Riverside County and Orange County come close together. That makes it a good base: in a short drive we can reach the foothill towns like <a href="/plumber-claremont/">Claremont</a>, <a href="/plumber-la-verne/">La Verne</a>, <a href="/plumber-san-dimas/">San Dimas</a> and <a href="/plumber-glendora/">Glendora</a>; the 909 cities like <a href="/plumber-montclair/">Montclair</a>, <a href="/plumber-upland/">Upland</a>, <a href="/plumber-ontario/">Ontario</a>, <a href="/plumber-chino/">Chino</a> and <a href="/plumber-rancho-cucamonga/">Rancho Cucamonga</a>; the Riverside County towns like <a href="/plumber-eastvale/">Eastvale</a>, <a href="/plumber-norco/">Norco</a>, <a href="/plumber-corona/">Corona</a> and <a href="/plumber-riverside/">Riverside</a>; and north Orange County towns like <a href="/plumber-brea/">Brea</a>, <a href="/plumber-yorba-linda/">Yorba Linda</a>, <a href="/plumber-fullerton/">Fullerton</a> and <a href="/plumber-anaheim/">Anaheim</a>.</p>
          <p class="ab2-strong">Pick your town above to see what we do there, what problems we see most, and how fast we can usually get to you. Or just call {SITE.phoneDisplay}. The phone is answered 24/7.</p>
        </div>
        <div>
          <p>Older neighborhoods in Pomona, Claremont, Upland, Ontario, Riverside and Fullerton often have clay sewer lines and cast-iron drains, so tree roots and cracked pipes are common. Hillside tracts in Diamond Bar, Walnut, Chino Hills and Yorba Linda were often built on concrete slabs with copper pipe underneath, so slab leaks show up as homes get older. Newer communities like Eastvale see more water heater and fixture calls. And across the whole region, the water is hard, which wears out water heaters, faucets and pipes faster.</p>
          <p class="ab2-links"><a href="/services/">All 13 services <Icon name="arrow" size={14} /></a><a href="/contact/">Contact us <Icon name="arrow" size={14} /></a></p>
        </div>
      </div>
    </div>
  </section>

  <Wave from="#131B2E" to="#FFFFFF" flip />
  <div class="afaq"><FaqSection faqs={faqs} line1="Things people" line2="usually ask." line3="" intro="Questions about where we go. Anything else, just call." /></div>
  <Wave from="#FFFFFF" to="#0B0F1A" />
  <ContactSection line1="Need a plumber" line2="near you?" text={`Call ${SITE.phoneDisplay} or get a call back. Backup line ${SITE.backupPhone}.`} />
  <Ticker items={['CALL 909-587-0711', '24/7', 'HABLAMOS ESPAÑOL', 'POMONA', 'CLAREMONT', 'CHINO', 'ONTARIO', 'CORONA', 'BREA']} cyan reverse />
</Base>

<style>
  /* HERO (Figma 337:482: 957 tall incl. 90 wave) */
  .ah { position: relative; overflow: hidden; padding: 42px 0 74px; min-height: 867px; }
  .ah-bg { position: absolute; inset: -10% 0 0; z-index: 0; }
  .ah-bg img { width: 100%; height: 100%; object-fit: cover; object-position: 60% 50%; }
  .ah-bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(11,15,26,.95) 20%, rgba(11,15,26,.3) 75%), rgba(11,15,26,.8); }
  .ah-glow { z-index: 1; left: 560px; top: 120px; width: 500px; height: 500px; background: rgba(31,79,216,.4); filter: blur(110px); }
  .ah-grid { position: relative; z-index: 2; display: grid; grid-template-columns: 1fr 370px; gap: 50px; align-items: start; }
  .ah-copy { min-width: 0; }
  .ah-copy :global(.crumbs ol) { font-size: 14px; font-weight: 500; line-height: 18px; color: #a3aec6; }
  .ah-copy :global(.crumbs li + li::before) { margin: 0 12px; }
  .ah-eye { margin-top: 20px; font-size: 13px; line-height: 17px; letter-spacing: .14em; }
  .ah-eye :global(.icon) { width: 16px; height: 16px; }
  .ah-h { margin-top: 6px; font-size: 90px; line-height: .86; letter-spacing: 0; white-space: nowrap; }
  .ah-sub { margin-top: 15px; max-width: 760px; font-size: 20px; line-height: 1.5; color: #d5dceb; }
  .ah-stats { display: grid; grid-template-columns: repeat(4, 200px) 1fr; align-items: center; width: 820px; max-width: 100%; height: 96px; margin: 28px 0 0; border-radius: 14px; background: var(--night); border: 1px solid #2b3a5c; }
  .ah-stats div { position: relative; height: 96px; padding: 12px 0 0 22px; }
  .ah-stats div + div::before { content: ''; position: absolute; left: -1px; top: 18px; width: 1px; height: 56px; background: #2b3a5c; }
  .ah-stats dt { font-size: 40px; line-height: 50px; }
  .ah-stats dd { margin: 0; font-size: 11px; line-height: 14px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: #a3aec6; }
  .ah-btns { gap: 12px; margin-top: 28px; }
  .ah-btns :global(.btn) { letter-spacing: .02em; padding: 0 28px; }
  .ah-btns :global(.ah-call) { width: 320px; }
  .ah-btns :global(.ah-text) { width: 280px; color: #fff; }
  .ah-btns :global(.ah-text .icon) { color: var(--cyan); }
  .ah-chips { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 26px; }
  .ah-chips li { display: inline-flex; align-items: center; gap: 8px; height: 35px; padding: 0 12px; border-radius: 8px; background: #16223d; border: 1px solid #2b3a5c; font-size: 13px; font-weight: 600; line-height: 1; color: #fff; }
  .ah-chips :global(.icon) { color: var(--cyan); flex: none; }
  .ah-k { margin-top: 40px; font-size: 12px; line-height: 16px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #a3aec6; }
  .ah-jump { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 10px; max-width: 820px; }
  .ah-jump a { display: inline-flex; align-items: center; gap: 8px; height: 44px; padding: 0 14px; border-radius: 8px; background: #1a2647; border: 1px solid #33456f; color: #fff; font-size: 15px; font-weight: 600; line-height: 1; transition: border-color .3s, transform .3s var(--ease-out); }
  .ah-jump a:hover { border-color: var(--cyan); transform: translateY(-2px); }
  .ah-jump :global(.icon) { color: var(--yellow); flex: none; }
  .ah-dot { margin: 0 8px; }
  .ah-form { margin-top: 18px; }

  /* shared section heads (Figma: eyebrow 13/17 .14em, H2 64/.92, 13px gap) */
  :is(.ob, .tl, .hf, .ar-rv, .ab2, .afaq) :global(.eyebrow) { display: flex; font-size: 13px; line-height: 17px; letter-spacing: .14em; }
  :is(.ob, .tl, .hf, .ar-rv, .ab2, .afaq) :global(.eyebrow .icon) { width: 16px; height: 16px; }
  .ar-h2 { margin-top: 13px; font-size: 64px; line-height: .92; }

  /* ONE BASE (Figma 337:578: 1240 incl. wave) */
  .ob { padding: 90px 0 100px; }
  .ob-head { display: grid; grid-template-columns: 1fr 600px; gap: 60px; align-items: start; }
  .ob-lead { padding-top: 60px; font-size: 17px; line-height: 1.6; color: #475569; }
  .ob-map { position: relative; margin-top: 71px; border-radius: 22px; overflow: hidden; background: var(--night); box-shadow: 0 18px 44px rgba(0,0,0,.3); padding: 0; }
  .ob-mapimg { position: relative; aspect-ratio: 1280/640; overflow: hidden; }
  .ob-zoom { position: absolute; left: 0; top: -14.0625%; width: 100%; aspect-ratio: 1280/896; }
  .ob-zoom img { width: 100%; height: 100%; object-fit: cover; }
  .ob-fade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(11,15,26,0) 75%, rgba(11,15,26,.55)); pointer-events: none; }
  .ob-ring { position: absolute; left: 32.11%; top: 33.71%; width: 28.125%; aspect-ratio: 1; transform: translate(-50%, -50%); border-radius: 50%; border: 2px dashed rgba(31,79,216,.85); background: rgba(31,79,216,.1); }
  .ob-pin { position: absolute; z-index: 2; left: 32.11%; top: 33.71%; }
  .ob-pinb { position: absolute; left: -26px; top: -63px; display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50% 50% 50% 0; transform: rotate(-45deg); background: var(--yellow); color: var(--ink); box-shadow: 0 8px 18px -6px rgba(0,0,0,.5); }
  .ob-pinb :global(.icon) { transform: rotate(45deg); }
  .ob-pinl { position: absolute; left: 34px; top: -62px; display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; padding: 8px 12px; border-radius: 8px; background: var(--night); color: var(--yellow); font-size: 15px; line-height: 19px; font-weight: 700; }
  .ob-co { position: absolute; padding: 6px 10px; border-radius: 6px; background: var(--night); color: #fff; font-size: 12px; line-height: 16px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; white-space: nowrap; }
