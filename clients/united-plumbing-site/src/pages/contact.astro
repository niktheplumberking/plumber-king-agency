---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Btn from '../components/Btn.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Wave from '../components/Wave.astro';
import Ticker from '../components/Ticker.astro';
import PageHero from '../components/company/PageHero.astro';
import HeroChips from '../components/company/HeroChips.astro';
import { SITE } from '../data/site';
import { SERVICES } from '../data/services';
import van from '../assets/img/jim-van.jpg';
import map from '../assets/img/map-service-area.jpg';

const base = String(Astro.site).replace(/\/$/, '');
const problems = [...SERVICES.map((s) => s.name), 'Not sure / something else'];
const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
const next = [
  { t: 'We pick up', d: 'A real person answers, day or night.' },
  { t: 'Quick questions', d: 'What is wrong, where and how bad. A photo helps.' },
  { t: 'Clear price', d: 'You hear the price before any work starts.' },
  { t: 'Fix + clean up', d: 'We fix it, explain it in plain words and clean up.' },
];
const schema = [{
  '@context': 'https://schema.org', '@type': 'ContactPage', name: 'Contact United Plumbing', url: `${base}/contact/`,
  description: 'Call (909) 587-0711, text, or send the form. United Plumbing, Pomona CA 91767. Open 24/7.',
  about: { '@id': `${base}/#business` },
  mainEntity: { '@id': `${base}/#business` },
}];
---
<Base title="Contact United Plumbing | Pomona Plumber | Open 24/7" description="Call (909) 587-0711, text, or send the form. United Plumbing, Pomona CA 91767. Open 24/7." crumbs={[{ name: 'Contact', href: '/contact/' }]} schema={schema}>

  <PageHero crumbs={[{ name: 'Contact', href: '/contact/' }]} class="ch-hero">
    <div class="ch-grid">
      <div>
        <p class="ch-pill" data-hero="1" data-hero-fx="pop"><i></i>Line open now · 24/7</p>
        <h1 class="h-display ch-h" data-hero="2" data-hero-fx="lines">Call.<br /><span class="c-yellow">We pick up 24/7.</span></h1>
        <p class="ch-p" data-hero="3" data-hero-fx="up">Fastest way is the phone. A real person answers, day or night. Tell us what is wrong and get a clear price before any work starts.</p>
        <div class="btn-row ch-btns" data-hero="4" data-hero-fx="up" data-hero-children>
          <Btn href={SITE.phoneHref} icon="phone" size="lg">Call {SITE.phone}</Btn>
          <Btn href={SITE.smsHref} variant="outline-cyan" icon="camera" size="lg">Text a photo</Btn>
        </div>
        <HeroChips order="5" />
      </div>
      <div class="board-wrap" data-hero="2" data-hero-fx="right">
        <a href={SITE.phoneHref} class="board" aria-label={`Tap to call Jim at ${SITE.phone}`}>
          <span class="board-top led"><span><i></i>Now answering</span><span class="c-cyan">24/7</span></span>
          <span class="board-row"><small>Area</small><span class="led">909</span></span>
          <span class="board-row"><small>Prefix</small><span class="led">587</span></span>
          <span class="board-row"><small>Line</small><span class="led">0711</span></span>
          <span class="board-btn h-display"><Icon name="phone" size={26} />Tap to call Jim<Icon name="arrow" size={26} class="board-arr" /></span>
        </a>
        <a href={SITE.backupHref} class="board-backup led">Busy? Backup<span class="d-only"> line</span> {SITE.backupPhone}</a>
      </div>
    </div>
  </PageHero>

  <!-- 3 WAYS -->
  <section class="ways light">
    <div class="wrap head-center">
      <Eyebrow>3 ways to reach us</Eyebrow>
      <h2 class="h-display h2" data-split>Pick the fastest<br /><span class="c-cobalt">way to reach Jim</span></h2>
      <p class="lead" data-reveal="up">Every message lands with the Galvez family, not a call center.</p>
    </div>
    <ul class="wrap ways-grid" data-stagger="up">
      <li class="way way-call" data-tilt>
        <div class="way-top"><span class="led way-n">01</span><span class="way-ico y"><Icon name="phone" size={30} /></span></div>
        <h3 class="h-display way-t">Call 24/7</h3>
        <p class="way-d">Best for leaks, floods, gas smell or no hot water. Days, nights and weekends.</p>
        <a href={SITE.phoneHref} class="way-led led" aria-label={`Call ${SITE.phone}`}>{SITE.phone}<i aria-hidden="true"></i></a>
        <Btn href={SITE.phoneHref} icon="phone" size="md" full>Call now</Btn>
      </li>
      <li class="way" data-tilt>
        <div class="way-top"><span class="led way-n">02</span><span class="way-ico"><Icon name="camera" size={26} /></span></div>
        <h3 class="h-display way-t">Text a photo</h3>
        <div class="way-chat" aria-hidden="true"><span class="way-pic"><Icon name="image" size={28} /></span><span class="way-b"><i>Leak under my sink</i><i class="me">Jim calls you now</i></span></div>
        <p class="way-d">Text it to {SITE.phone}.</p>
        <Btn href={SITE.smsHref} variant="outline-cobalt" icon="camera" size="md" full>Text a photo</Btn>
      </li>
      <li class="way" data-tilt>
        <div class="way-top"><span class="led way-n">03</span><span class="way-ico"><Icon name="message" size={26} /></span></div>
        <h3 class="h-display way-t">WhatsApp</h3>
        <p class="way-d">Message us in English or Spanish. Send photos or a short video of the problem.</p>
        <p class="way-ph"><em class="ph way-tag">Number to confirm</em></p>
        <Btn href="https://wa.me/19095870711" target="_blank" variant="outline-cobalt" icon="message" size="md" full>Open WhatsApp</Btn>
      </li>
    </ul>
    <div class="wrap">
      <ul class="strip" data-reveal="up">
        <li><a href={SITE.backupHref}><span class="strip-ico"><Icon name="phone" size={20} /></span><span class="strip-t"><small>Backup line</small><span><strong>{SITE.backupPhone}</strong><em>If the main line is busy</em></span></span></a></li>
        <li><a href={`mailto:${SITE.email}`}><span class="strip-ico"><Icon name="mail" size={20} /></span><span class="strip-t"><small>Email</small><span><strong>{SITE.email}</strong><em>Photos, quotes. Not for emergencies.</em></span></span></a></li>
        <li><a href={SITE.instagram} target="_blank" rel="noopener"><span class="strip-ico"><Icon name="instagram" size={20} /></span><span class="strip-t"><small>Instagram</small><span><strong>{SITE.instagramHandle}</strong><em>Message us or watch our jobs</em></span></span></a></li>
      </ul>
      <p class="ways-es" lang="es" data-reveal="up">Hablamos español.</p>
    </div>
  </section>

  <Wave from="#F3F6FB" to="#0B0F1A" flip />

  <!-- FORM -->
  <section class="fm dark" id="form">
    <div class="fm-glow" aria-hidden="true"></div>
    <div class="wrap fm-grid">
      <div class="fm-left">
        <Eyebrow>Send us the details</Eyebrow>
        <h2 class="h-display h2 fm-h" data-split><span class="c-white">Tell us</span><br /><span class="c-cyan">what is wrong.</span></h2>
        <p class="lead fm-p" data-reveal="up">Fill this in and the Galvez family calls you back. Add a photo and we can usually give you a price range on the first call.</p>
        <ol class="fm-steps" data-stagger="up">
          <li><span class="led">01</span><span><strong>Tell us the problem</strong><small>A few words is enough.</small></span></li>
          <li><span class="led">02</span><span><strong>Add a photo if you can</strong><small>Leaks, drains, the water heater label.</small></span></li>
          <li><span class="led">03</span><span><strong>We call you back</strong><small>With a clear price before any work.</small></span></li>
        </ol>
        <a href={SITE.phoneHref} class="fm-led" data-reveal="up"><small>Prefer to talk? Tap to call</small><span class="led">{SITE.phone}</span></a>
        <figure class="fm-van" data-reveal="clip">
          <Image src={van} alt="Jim Galvez next to the United Plumbing work truck in Pomona" widths={[500, 900]} sizes="(max-width: 900px) 100vw, 400px" />
          <figcaption>Our truck · Pomona</figcaption>
        </figure>
      </div>
      <form class="cf card" data-callback novalidate aria-labelledby="cf-t" data-reveal="right">
        <span class="cf-badge"><i></i>Answered 24/7</span>
        <h2 id="cf-t" class="h-display cf-title">Rather we call you?</h2>
        <p class="cf-sub">Leave your number. Jim's team calls you back.</p>
        <div class="cf-grid">
          <label class="field"><span class="field-label">Name <span aria-hidden="true">*</span></span><input class="input" name="name" autocomplete="name" placeholder="Your name" required /><Icon name="user" size={18} /></label>
          <label class="field"><span class="field-label">Phone <span aria-hidden="true">*</span></span><input class="input" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="(909) 000-0000" required /><Icon name="phone" size={18} /></label>
          <label class="field"><span class="field-label">Email (optional)</span><input class="input" name="email" type="email" autocomplete="email" placeholder="you@email.com" /><Icon name="mail" size={18} /></label>
          <label class="field"><span class="field-label">Town or ZIP <span aria-hidden="true">*</span></span><input class="input" name="zip" autocomplete="postal-code" placeholder="91767" required /><Icon name="pin" size={18} /></label>
          <label class="field span2"><span class="field-label">What do you need?</span><select class="input" name="problem"><option value="">Pick one of 13 services, or "Not sure"</option>{problems.map((p) => <option>{p}</option>)}</select><Icon name="chevronDown" size={18} /></label>
          <label class="field span2"><span class="field-label">Tell us more</span><textarea class="input" name="message" rows="4" placeholder="What is going on? Where is the problem? How long has it been happening?"></textarea></label>
          <div class="span2">
            <span class="field-label" id="cf-photo-l">Photo (optional)</span>
            <label class="cf-drop">
              <span class="cf-cam"><Icon name="camera" size={26} /></span>
              <span class="cf-drop-t"><strong>Add a photo of the problem</strong><small data-file-name>Tap to upload or drag it here. JPG or PNG.</small></span>
              <span class="cf-browse h-display" aria-hidden="true">Browse</span>
              <input type="file" name="photo" accept="image/jpeg,image/png" class="cf-file" aria-labelledby="cf-photo-l" />
            </label>
          </div>
          <label class="cf-check span2"><input type="checkbox" name="emergency" value="yes" /><span class="cf-box" aria-hidden="true"><Icon name="check" size={14} stroke={3} /></span><strong>It's an emergency</strong><small>We call you first.</small></label>
        </div>
        <Btn type="submit" icon="phone" size="md" full class="cf-submit">Call me back</Btn>
        <p class="form-error center" data-form-msg role="status" hidden></p>
        <p class="form-note center cf-note">We call you back. No spam. Emergency? Call <a href={SITE.phoneHref}>{SITE.phoneDisplay}</a> instead.</p>
        <p class="cf-consent center">By sending this form you agree we can call or text you about your request. See our <a href="/privacy/">Privacy Policy</a>.</p>
      </form>
    </div>
  </section>

  <Wave from="#0B0F1A" to="#F3F6FB" />

  <!-- WHERE AND WHEN -->
  <section class="ww light">
    <div class="wrap ww-head">
      <div>
        <Eyebrow>Where and when</Eyebrow>
        <h2 class="h-display h2" data-split>Based in Pomona.<br /><span class="c-cobalt">Out across LA, OC &amp; the IE.</span></h2>
      </div>
      <p class="lead" data-reveal="up">Based in Pomona, CA 91767. We come to you: Los Angeles, Orange County and the Inland Empire, at any hour.</p>
    </div>
    <div class="wrap ww-grid">
      <figure class="ww-map" data-reveal="clip">
        <Image src={map} alt="Map of the area United Plumbing covers from Pomona: Los Angeles County, Orange County and the Inland Empire" widths={[600, 1000]} sizes="(max-width: 900px) 100vw, 780px" />
        <span class="ww-src">Map: Google Maps</span>
        <figcaption><span class="ww-pin"><Icon name="pin" size={24} /></span><span><small>Our base</small><strong class="h-display">Pomona, CA 91767</strong></span></figcaption>
      </figure>
      <div class="hours" data-reveal="up">
        <span class="hours-ico"><Icon name="clock" size={24} /></span>
        <h3 class="h-display hours-h"><span class="c-white">Open 24 hours,</span><br /><span class="c-yellow">7 days a week.</span></h3>
        <ul class="hours-list" aria-label="Opening hours">
          {days.map((d) => <li><span class="led hd">{d.toUpperCase()}</span><span class="hbar" aria-hidden="true"></span><span class="led hh">24H</span><span class="sr-only">{d}: open 24 hours</span></li>)}
        </ul>
        <Btn href={SITE.phoneHref} icon="phone" size="md" full>Call {SITE.phone}</Btn>
      </div>
    </div>
    <div class="wrap ww-chips" data-reveal="up">
      <ul>
        {['Los Angeles County', 'Orange County', 'Inland Empire', 'San Bernardino County'].map((c) => <li><Icon name="pin" size={16} />{c}</li>)}
      </ul>
      <a href="/areas/" class="textlink">See every town we serve <Icon name="arrow" size={16} /></a>
    </div>
  </section>

  <Wave from="#F3F6FB" to="#FFD21F" flip />

  <!-- WHAT HAPPENS NEXT -->
  <section class="nx yellowbg">
    <div class="wrap nx-grid">
      <div>
        <p class="eyebrow nx-eb" data-reveal="up"><Icon name="drop" size={14} stroke={2.5} />After you call</p>
        <h2 class="h-display h2 nx-h" data-split>What<br /><span class="c-cobalt">happens next.</span></h2>
        <p class="nx-p" data-reveal="up">No call center and no runaround. Here is what a call to United Plumbing looks like.</p>
      </div>
      <ol class="nx-steps" data-stagger="up">
        {next.map((s, i) => (
          <li class:list={{ last: i === 3 }}>
            <span class="nx-node led">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="h-display">{s.t}</h3>
            <p>{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
    <div class="wrap nx-cta" data-reveal="up">
      <span>Step 01 starts here:</span>
      <Btn href={SITE.phoneHref} variant="ink" icon="phone" size="md">Call {SITE.phone}</Btn>
      <a href={SITE.smsHref} class="btn btn-md nx-out" data-btn><span class="btn-fill" aria-hidden="true"></span><Icon name="camera" size={22} /><span>Text a photo</span></a>
    </div>
  </section>

  <Ticker items={['CALL 909-587-0711', '24/7', 'HABLAMOS ESPAÑOL', 'POMONA', 'CLAREMONT', 'CHINO', 'ONTARIO', 'UPLAND']} cyan reverse />
</Base>

<script>
  document.querySelectorAll<HTMLInputElement>('.cf-file').forEach((inp) => {
    inp.addEventListener('change', () => {
      const out = inp.closest('.cf-drop')?.querySelector('[data-file-name]');
      if (out && inp.files?.[0]) out.textContent = `Added: ${inp.files[0].name}`;
    });
  });
</script>

<style>
  /* Measurements follow Figma 298:577 (desktop 1440) and 312:529 (mobile 390). */

  /* HERO (800 tall at 1440) */
  :global(.phero.ch-hero) { padding: 68px 0 22px; min-height: 800px; }
  .ch-grid { display: grid; grid-template-columns: minmax(0, 1fr) 500px; gap: 60px; align-items: start; margin-top: 24px; }
  .ch-pill { display: inline-flex; align-items: center; gap: 8px; padding: 7px 14px; border-radius: 999px; background: rgba(51,214,255,.12); color: var(--cyan); font: 700 13px/17px var(--body); letter-spacing: .12em; text-transform: uppercase; }
  .ch-pill i { width: 8px; height: 8px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 8px rgba(34,197,94,.7); }
  .ch-h { margin-top: 13px; font-size: 108px; line-height: .86; letter-spacing: 0; color: #fff; white-space: nowrap; }
  .ch-p { margin-top: 28px; max-width: 600px; font-size: 20px; line-height: 1.5; color: #c9d2e3; }
  .ch-btns { margin-top: 36px; gap: 16px; }
  .ch-btns :global(.btn) { --bh: 72px; padding: 0 28px; font-size: 26px; letter-spacing: .02em; }
  .ch-btns :global(.btn-yellow) { width: 330px; }
  .ch-btns :global(.btn-outline-cyan) { width: 250px; font-size: 24px; background: transparent; }
  .ch-btns :global(.btn .icon) { width: 22px; height: 22px; }
  .ch-grid :global(.hchips) { margin-top: 32px; }
  .board-wrap { display: grid; margin-top: -32px; }
  .board { --pad: 30px; position: relative; display: grid; padding: 0 var(--pad) 22px; border-radius: 24px; background: radial-gradient(rgba(255,255,255,.05) 1px, transparent 1.3px) 0 0/12px 12px, #05070d; border: 2px solid #2a3a66; box-shadow: 14px 14px 0 rgba(31,79,216,.9), 0 40px 80px -30px rgba(0,0,0,.8); transition: transform .45s var(--ease-out), box-shadow .45s; }
  .board:hover { transform: translate(-4px, -4px); box-shadow: 18px 18px 0 rgba(31,79,216,.9), 0 40px 80px -30px rgba(0,0,0,.8); }
  .board-top { display: flex; justify-content: space-between; align-items: flex-start; height: 82px; padding-top: 28px; border-bottom: 2px solid #1c2847; color: var(--cyan); font-size: 22px; line-height: 26px; letter-spacing: .06em; text-transform: uppercase; }
  .board-top span:first-child { display: inline-flex; align-items: center; gap: 12px; }
  .board-top i { width: 12px; height: 12px; border-radius: 50%; background: #ff3b3b; box-shadow: 0 0 10px #ff3b3b; animation: bblink 1.4s steps(2) infinite; }
  @keyframes bblink { 50% { opacity: .25; } }
  .board-row { position: relative; display: flex; justify-content: space-between; align-items: flex-start; height: 136px; border-bottom: 1px solid #141e36; }
  .board-row:nth-of-type(2) { height: 149px; }
  .board-row:nth-of-type(4) { height: 155px; border-bottom: 0; }
  .board-row small { margin-top: 23px; color: #5b6b91; font: 700 13px/17px var(--body); letter-spacing: .16em; text-transform: uppercase; }
  .board-row:nth-of-type(2) small { margin-top: 36px; }
  .board-row .led { margin-top: -3px; color: var(--yellow); font-size: 138px; line-height: 1; letter-spacing: 0; text-shadow: 0 0 24px rgba(255,209,31,.55); }
  .board-row:nth-of-type(2) .led { margin-top: 10px; }
  .board-btn { display: flex; align-items: center; gap: 14px; margin: 0 -8px; padding: 0 28px; height: 72px; border-radius: 14px; background: var(--yellow); color: var(--ink); font-size: 30px; font-weight: 800; letter-spacing: .03em; }
  .board-btn :global(.board-arr) { margin-left: auto; transition: transform .3s var(--ease-out); }
  .board:hover .board-btn :global(.board-arr) { transform: translateX(5px); }
  .board-backup { justify-self: end; margin-top: 32px; color: var(--cyan); font-size: 20px; line-height: 24px; letter-spacing: .04em; text-transform: uppercase; padding: 2px 0; }
  .board-backup:hover { text-shadow: 0 0 10px var(--cyan); }

  /* WAYS (section 888 + wave) */
  .ways { padding: 94px 0 22px; }
  .ways .h2 { margin-top: 6px; font-size: 64px; line-height: .92; letter-spacing: 0; }
  .ways .lead { margin-top: 23px; font-size: 18px; line-height: 23px; color: #475569; }
  .ways-grid { display: grid; grid-template-columns: 520fr 356fr 356fr; gap: 24px; margin-top: 31px; }
  .way { position: relative; overflow: hidden; display: flex; flex-direction: column; height: 400px; padding: 29px 31px 31px; border-radius: 20px; background: #fff; border: 1px solid #dce3ee; }
  .way-call { padding: 30px 36px 36px; background: radial-gradient(160px 160px at 460px 80px, rgba(31,79,216,.75), transparent 100%), radial-gradient(rgba(255,255,255,.05) 1px, transparent 1.3px) 0 0/12px 12px, var(--night); color: #fff; border: 0; }
  .way-top { display: flex; justify-content: space-between; align-items: start; height: 78px; }
  .way-n { font-size: 44px; line-height: 53px; letter-spacing: 0; color: var(--cobalt); }
  .way-call .way-n { color: var(--cyan); }
  .way-ico { display: grid; place-items: center; width: 56px; height: 56px; margin-top: 2px; border-radius: 14px; background: #e3eafb; color: var(--cobalt); }
  .way-ico.y { width: 64px; height: 64px; border-radius: 16px; background: var(--yellow); color: var(--ink); }
  .way-t { font-size: 44px; line-height: 53px; letter-spacing: 0; color: var(--ink); }
  .way-call .way-t { font-size: 52px; line-height: 62px; color: #fff; }
  .way-d { margin-top: 9px; font-size: 16px; line-height: 1.5; color: #475569; }
  .way-call .way-d { margin-top: 2px; max-width: 420px; font-size: 17px; color: #c9d2e3; }
  .way :global(.btn) { --bh: 56px; margin-top: auto; font-size: 22px; letter-spacing: .02em; }
  .way :global(.btn-outline-cobalt) { background: transparent; }
  .way-led { display: flex; justify-content: space-between; align-items: center; height: 56px; margin: 12px 0 16px; padding: 0 18px 0 17px; border-radius: 10px; background: #05070d; border: 1px solid #24304a; color: var(--yellow); font-size: 32px; letter-spacing: 0; }
  .way-led i { width: 10px; height: 10px; border-radius: 50%; background: #ff3b3b; box-shadow: 0 0 8px #ff3b3b; }
  .way-chat { display: flex; gap: 12px; margin-top: 9px; }
  .way-pic { display: grid; place-items: center; flex: none; width: 120px; height: 92px; border-radius: 12px; background: var(--night); color: var(--cyan); }
  .way-b { display: grid; gap: 12px; flex: 1; }
  .way-b i { display: flex; align-items: center; height: 40px; padding: 0 12px; border-radius: 12px; background: #e9eef6; color: var(--ink); font-style: normal; font-size: 13px; font-weight: 500; }
  .way-b i.me { background: var(--cobalt); color: #fff; }
  .way-chat + .way-d { margin-top: 14px; font-size: 15px; line-height: 1.4; font-weight: 500; }
  .way-ph { margin: 0; }
  .way-tag { display: inline-flex; align-items: center; height: 28px; margin-top: 49px; padding: 0 10px; border: 0; border-radius: 6px; background: #fff4c2; color: #6b5600; font: 700 12px/1 var(--body); letter-spacing: .06em; text-transform: uppercase; }
  .strip { display: grid; grid-template-columns: 358fr 520fr 402fr; margin-top: 24px; height: 72px; border-radius: 14px; background: #fff; border: 1px solid #dce3ee; }
  .strip li + li { border-left: 1px solid #dce3ee; }
  .strip li:nth-child(2) a, .strip li:nth-child(3) a { padding-left: 24px; }
  .strip a { display: flex; align-items: center; gap: 16px; height: 100%; padding: 0 16px 0 23px; border-radius: 14px; transition: background .3s; }
  .strip a:hover { background: var(--paper); }
  .strip-ico { display: grid; place-items: center; flex: none; width: 40px; height: 40px; border-radius: 10px; background: #e3eafb; color: var(--cobalt); }
  .strip-t { display: grid; gap: 3px; }
  .strip-t > span { display: flex; align-items: baseline; gap: 12px; }
