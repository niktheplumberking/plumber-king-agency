---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Btn from '../components/Btn.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Wave from '../components/Wave.astro';
import Ticker from '../components/Ticker.astro';
import CallbackForm from '../components/sections/CallbackForm.astro';
import ReviewSlots from '../components/sections/ReviewSlots.astro';
import ProcessSection from '../components/sections/ProcessSection.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import AreasSection from '../components/sections/AreasSection.astro';
import { SITE } from '../data/site';
import { SERVICES } from '../data/services';
import dusk from '../assets/img/dusk-street.jpg';
import jim from '../assets/img/jim-cutout.png';
import crawl from '../assets/img/job-crawlspace.jpg';
import roof from '../assets/img/job-roof.jpg';
import logo from '../assets/img/logo-united.jpg';
import snake from '../assets/img/job-drain-snake.jpg';
import wh from '../assets/img/job-water-heater.jpg';
import van from '../assets/img/jim-van.jpg';

const top6 = SERVICES.slice(0, 6);
const more = SERVICES.slice(6);
const shortName: Record<string, string> = { 'Sewer Camera Inspection': 'Sewer Camera', 'Copper Pipe & Repiping': 'Repiping', 'Gas Line Installation': 'Gas Line Install', 'Main Line Repair': 'Main Line Repair' };
const faqs = [
  { q: 'Do you really answer at night?', a: 'Yes. Call 909-587-0711 any hour, nights and weekends too. If the line is busy, call our backup line, 909-667-6555.' },
  { q: 'How much will it cost?', a: 'We look at the job, tell you the price, and you say yes before we start. Text a photo first and we can give you a price range.' },
  { q: '¿Hablan español?', a: 'Sí. Hablamos español. Pregunte por Jim.' },
  { q: 'Can I text a photo instead of calling?', a: 'Yes. Snap the drip, the puddle or the label on your water heater and text it to 909-587-0711. We text back what it is and what it takes to fix it.' },
  { q: 'Which areas do you cover?', a: 'Pomona and 27 towns around it in LA County, the Inland Empire and Orange County. See the full list on our <a href="/areas/">Areas page</a>.' },
  { q: 'Do you take small jobs too?', a: 'Yes. A dripping faucet is a real job to us. Call or text and tell us what you see.' },
];
const schema = [{
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })),
}];
---
<Base title="Plumber Pomona CA | Family Owned Since 2018 | Open 24/7" description="Plumber in Pomona, CA. Family owned and built by brothers. Drains, water heaters, leaks and sewer lines. Open 24/7. Call (909) 587-0711." schema={schema}>

  <!-- HERO -->
  <section class="hero dark">
    <div class="hero-bg" aria-hidden="true">
      <Image src={dusk} alt="" widths={[768, 1344]} sizes="100vw" loading="eager" fetchpriority="high" data-parallax="0.2" />
    </div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <div class="hero-pills" data-hero="1" data-hero-fx="pop" data-hero-children>
          <a href={SITE.instagram} target="_blank" rel="noopener" class="hpill"><Icon name="instagram" size={20} /><span><strong><span>{SITE.instagramFollowers}</span> followers</strong><small>@plumblord1 · verified</small></span></a>
          <a href={SITE.facebook} target="_blank" rel="noopener" class="hpill"><Icon name="facebook" size={18} /><span><strong>{SITE.facebookFollowers} followers</strong><small>Jim United Plumbing Official</small></span></a>
        </div>
        <h1 class="h-display hero-h" data-hero="2" data-hero-fx="lines">24/7 Plumber<br />in <span class="c-yellow">Pomona, CA</span></h1>
        <p class="hero-serve" data-hero="3" data-hero-fx="up">Serving Pomona, Claremont, Chino, Ontario, Upland &amp; the whole Inland Empire</p>
        <span class="hero-rule" data-hero="4" data-hero-fx="clipx" aria-hidden="true"></span>
        <p class="hero-p" data-hero="5" data-hero-fx="up">Pipe burst? Drain backed up? No hot water? Call Jim and the Galvez brothers any hour. A real person picks up, and you get a clear price before any work starts.</p>
        <div class="btn-row hero-btns" data-hero="6" data-hero-fx="up" data-hero-children>
          <Btn href={SITE.phoneHref} icon="phone" size="lg" sub="Answered 24/7 · English o Español">Call {SITE.phone}</Btn>
          <Btn href={SITE.smsHref} variant="outline-white" icon="message" size="lg" sub="We reply with a price range">Text us a photo</Btn>
        </div>
        <ul class="chips hero-chips" data-hero="7" data-hero-fx="up" data-hero-children>
          <li class="chip"><span class="chip-ico"><Icon name="clock" size={16} /></span>Answered 24/7</li>
          <li class="chip"><span class="chip-ico"><Icon name="globe" size={16} /></span>Hablamos Español</li>
          <li class="chip"><span class="chip-ico"><Icon name="tag" size={16} /></span>Clear price first</li>
        </ul>
      </div>
      <div class="hero-jim" data-hero="1" data-hero-fx="right" data-hero-at="0.15">
        <div class="hero-glow" aria-hidden="true"></div>
        <Image src={jim} alt="Jaime “Jim” Galvez, owner of United Plumbing, in his work shirt" widths={[420, 640, 900]} sizes="(max-width: 900px) 90vw, 560px" loading="eager" class="hero-jim-img" format="webp" quality={82} />
        <p class="hero-tag h-display" data-hero="8" data-hero-fx="pop"><span>Jim Galvez</span><span class="hero-tag-dot"> · </span><small>Owner &amp; Plumber</small></p>
      </div>
    </div>
    <div class="wrap hero-form" data-hero="9" data-hero-fx="up"><CallbackForm variant="bar" id="hero-cb" /></div>
  </section>

  <!-- REVIEWS (placeholders until the Google profile is live) -->
  <section class="rev light">
    <div class="wrap head-center">
      <Eyebrow>What neighbors say</Eyebrow>
      <h2 class="h-display h2 rev-h" data-split>Trusted by homeowners<br /><span class="c-cobalt">across the Inland Empire</span></h2>
    </div>
    <div class="wrap"><hr class="rev-hr" data-reveal="clipx" /></div>
    <div class="rev-car" data-reveal="up"><ReviewSlots /></div>
  </section>

  <Ticker items={['BURST PIPE', 'CLOGGED DRAIN', 'NO HOT WATER', 'GAS LINE', 'SEWER BACKUP', 'SLAB LEAK', 'TREE ROOTS']} />

  <!-- ABOUT -->
  <section class="ab dark2 section">
    <div class="wrap ab-grid">
      <div class="ab-collage">
        <span class="ab-block" data-reveal="clipx" aria-hidden="true"></span>
        <figure class="ab-main" data-reveal="clip"><Image src={crawl} alt="A Galvez brother working on drain pipes in a crawl space" widths={[400, 800]} sizes="(max-width: 900px) 80vw, 380px" data-parallax="0.08" /></figure>
        <figure class="ab-tilt" data-reveal="pop"><Image src={roof} alt="The United Plumbing crew carrying equipment up a ladder to a roof" widths={[300, 600]} sizes="220px" /></figure>
        <span class="ab-badge" data-reveal="pop"><Image src={logo} alt="" width={180} height={127} /></span>
      </div>
      <div class="ab-copy">
        <Eyebrow>About United Plumbing</Eyebrow>
        <h2 class="h-display h2 ab-h" data-split><span class="c-white">Built by brothers.</span><br /><span class="c-cyan">Trusted by neighbors.</span></h2>
        <ul class="ab-list" data-stagger="up">
          <li><strong>How it started</strong><p>Jaime "Jim" Galvez learned the trade first. Then he trained each of his brothers himself, job by job, until they could run a call on their own.</p></li>
          <li><strong>Who shows up</strong><p>A small family crew, all trained the same way. When you call United, you get the Galvez family, not a stranger off an app.</p></li>
          <li><strong>How we treat you</strong><p>A clear price before we start. No hidden fees, no surprise charges, and we explain the fix in plain words, in English or Spanish.</p></li>
        </ul>
        <div class="btn-row" data-reveal="up">
          <Btn href={SITE.phoneHref} icon="phone" size="md">Call Jim {SITE.phone}</Btn>
          <Btn href="/our-work/" variant="outline-white" size="md">See our work</Btn>
        </div>
      </div>
    </div>
  </section>

  <Wave from="#131B2E" to="#F3F6FB" />

  <!-- SERVICES -->
  <section class="sv light">
    <div class="wrap head-center">
      <Eyebrow>What we fix</Eyebrow>
      <h2 class="h-display h2" data-split>Plumbing services in<br /><span class="c-cobalt">Pomona &amp; the Inland Empire</span></h2>
      <p class="lead" data-reveal="up">Big jobs and small ones. Tap a service to call about it now, or text us a photo of the problem and get a price range.</p>
    </div>
    <div class="wrap sv-grid" data-stagger="up">
      {top6.map((s) => (
        <article class="sv-card" data-tilt>
          <a href={`/${s.slug}/`} class="sv-img" aria-label={`${s.name}: see the page`}>
            {s.img && <Image src={s.img} alt={`${s.name} (stand-in photo)`} widths={[400, 700]} sizes="(max-width: 700px) 90vw, 400px" />}
            {s.standIn && <span class="standin">Stand-in photo</span>}
          </a>
          <span class="sv-ico"><Icon name={s.icon} size={24} /></span>
          <div class="sv-body">
            <h3 class="h-display sv-t"><a href={`/${s.slug}/`}>{shortName[s.name] ?? s.name}</a></h3>
            <p class="sv-d">{s.short}</p>
            <Btn href={SITE.phoneHref} variant="cobalt" size="sm" arrow>{s.cta}</Btn>
          </div>
        </article>
      ))}
    </div>
    <div class="wrap">
      <div class="sv-more" data-reveal="up">
        <div class="sv-more-l"><p class="led sv-more-n">+7 more</p><p class="sv-more-k">Also on the truck</p><p class="sv-more-s">13 services in total.</p></div>
        <ul class="sv-more-chips" data-stagger="pop">
          {more.map((s) => <li><a href={`/${s.slug}/`}>{shortName[s.name] ?? s.name}<Icon name="arrow" size={15} /></a></li>)}
        </ul>
        <Btn href="/services/" size="md" arrow class="sv-more-btn">See all 13 services</Btn>
      </div>
    </div>
  </section>

  <Wave from="#F3F6FB" to="#0B0F1A" flip />

  <!-- LATEST WORK -->
  <section class="wk dark">
    <div class="wrap wk-head">
      <div>
        <Eyebrow>Recent jobs</Eyebrow>
        <h2 class="h-display h2" data-split><span class="c-white">Our </span><span class="c-cyan">latest work</span></h2>
      </div>
      <a href="/our-work/" class="textlink" data-reveal="left">See all jobs <Icon name="arrow" size={16} /></a>
    </div>
    <div class="wrap wk-grid">
      <figure class="wk-a" data-reveal="clip"><Image src={snake} alt="Jim feeding a drain snake into a clogged line" widths={[400, 700]} sizes="(max-width: 800px) 50vw, 300px" /><span class="realjob">Real job · @plumblord1</span></figure>
      <figure class="wk-b" data-reveal="clip" data-delay="0.1"><Image src={wh} alt="Installing a new water heater outside a Pomona home" widths={[600, 1000]} sizes="(max-width: 800px) 100vw, 600px" data-parallax="0.08" /><span class="realjob">Real job · @plumblord1</span></figure>
      <div class="wk-c slot" data-reveal="up"><Icon name="instagram" size={24} /><span>Next job photo from<br />@plumblord1 goes here</span></div>
      <div class="wk-d slot" data-reveal="up"><Icon name="instagram" size={24} /><span>Next job photo from<br />@plumblord1 goes here</span></div>
      <a href={SITE.instagram} target="_blank" rel="noopener" class="wk-e" data-reveal="up" data-tilt>
        <Icon name="instagram" size={30} />
        <span class="wk-e-n h-display" data-count="1156">1,156</span>
        <span class="wk-e-t">people follow Jim's jobs on Instagram</span>
        <span class="btn btn-ink btn-sm">Follow @plumblord1 <Icon name="arrow" size={16} /></span>
      </a>
    </div>
  </section>

  <!-- WHY -->
  <section class="why white section">
    <div class="wrap why-grid">
      <div>
        <Eyebrow>Why choose United</Eyebrow>
        <h2 class="h-display h2 why-h" data-split>Why Pomona<br /><span class="c-cobalt">calls United</span></h2>
        <p class="lead why-p" data-reveal="up">When a pipe bursts at 2 AM, you want someone who picks up, speaks your language and tells you the price before touching anything. That is how the Galvez brothers work.</p>
        <ul class="why-list" data-stagger="left">
          <li><span><Icon name="clock" size={18} /></span>A real person answers, 24/7</li>
          <li><span><Icon name="globe" size={18} /></span>Hablamos Español</li>
          <li><span><Icon name="tag" size={18} /></span>Clear price before any work starts</li>
          <li><span><Icon name="users" size={18} /></span>Family crew, all trained by Jim</li>
          <li><span><Icon name="camera" size={18} /></span>Text a photo, get a price range</li>
        </ul>
      </div>
      <figure class="why-photo" data-reveal="clip">
        <Image src={van} alt="Jaime “Jim” Galvez standing next to the United Plumbing work truck" widths={[500, 900]} sizes="(max-width: 900px) 100vw, 640px" data-parallax="0.1" />
        <figcaption class="why-name" data-reveal="left"><strong class="h-display">Jaime "Jim" Galvez</strong><small>Owner · United Plumbing</small></figcaption>
      </figure>
    </div>
  </section>

  <Wave from="#FFFFFF" to="#0B0F1A" />
  <ProcessSection />
  <Wave from="#0B0F1A" to="#FFFFFF" flip />
  <FaqSection faqs={faqs} />
  <Wave from="#FFFFFF" to="#0B0F1A" />
  <ContactSection />
  <Ticker items={['CALL 909-587-0711', '24/7', 'HABLAMOS ESPAÑOL', 'POMONA', 'CLAREMONT', 'CHINO', 'ONTARIO', 'UPLAND']} cyan reverse />
  <AreasSection />
</Base>

<style>
  /* HERO */
  .hero { position: relative; overflow: hidden; padding-top: 56px; padding-bottom: 0; }
  .hero::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 120px; background: var(--paper); z-index: 1; }
  .hero-bg { position: absolute; inset: -12% 0 0; z-index: 0; }
  .hero-bg img { width: 100%; height: 100%; object-fit: cover; object-position: 60% 50%; }
  .hero-bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(11,15,26,.96) 0%, rgba(11,15,26,.8) 40%, rgba(11,15,26,.25) 75%, rgba(11,15,26,.45) 100%), linear-gradient(0deg, rgba(11,15,26,.7), transparent 40%); }
  .hero-grid { position: relative; z-index: 2; display: grid; grid-template-columns: 1.15fr .85fr; gap: 20px; }
  .hero-copy { padding: 24px 0 60px; }
  .hero-pills { display: flex; flex-wrap: wrap; gap: 10px; }
  .hpill { display: inline-flex; align-items: center; gap: 12px; padding: 10px 16px; border: 1px solid rgba(255,255,255,.22); border-radius: 8px; background: rgba(11,15,26,.55); backdrop-filter: blur(6px); color: #fff; transition: border-color .3s, transform .3s var(--ease-out); }
  .hpill:hover { border-color: var(--cyan); transform: translateY(-2px); }
  .hpill strong { display: block; font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: 20px; line-height: 1; }
  .hpill small { display: block; font-size: 11px; color: var(--on-dark-2); margin-top: 3px; }
  .hero-h { margin-top: 18px; font-size: clamp(60px, 8.6vw, 124px); color: #fff; line-height: .86; }
  .hero-serve { margin-top: 26px; color: var(--cyan); font-weight: 600; font-size: 18px; }
  .hero-rule { display: block; width: 88px; height: 4px; margin-top: 18px; background: var(--yellow); border-radius: 2px; }
  .hero-p { margin-top: 26px; color: var(--on-dark); font-size: 17px; max-width: 560px; }
  .hero-btns { margin-top: 34px; }
  .hero-btns :global(.btn) { --bh: 72px; }
  .hero-btns :global(.btn-outline-white) { background: rgba(11,15,26,.5); }
  .hero-chips { margin-top: 30px; color: #fff; }
  .hero-jim { position: relative; align-self: end; display: flex; justify-content: center; }
  .hero-jim-img { position: relative; z-index: 1; width: min(560px, 100%); margin-bottom: 0; filter: drop-shadow(0 30px 40px rgba(0,0,0,.45)); }
  .hero-glow { position: absolute; left: 10%; right: 10%; top: 20%; bottom: 10%; background: radial-gradient(closest-side, rgba(31,79,216,.85), rgba(31,79,216,0)); filter: blur(30px); }
  .hero-tag { position: absolute; z-index: 2; right: -14px; top: 26%; writing-mode: vertical-rl; transform: rotate(180deg); background: var(--cobalt); color: #fff; padding: 22px 12px; border-radius: 6px; font-size: 22px; letter-spacing: .02em; box-shadow: 0 0 0 1px rgba(51,214,255,.5), 0 20px 40px -12px rgba(31,79,216,.8); }
  .hero-tag small { font-size: 22px; }
  .hero-form { position: relative; z-index: 3; margin-top: -24px; }

  /* REVIEWS */
  .rev { padding-top: clamp(64px, 8vw, 100px); padding-bottom: 60px; overflow: hidden; }
  .rev-h { margin-top: 14px; font-size: clamp(34px, 5.6vw, 70px); }
  .rev-hr { border: 0; height: 1px; background: #d9e0ec; margin: 34px 0 28px; }
  .rev-car :global(.car-track) { padding-inline: max(var(--gutter), calc((100vw - var(--wrap)) / 2)); }

  /* ABOUT */
  .ab-grid { display: grid; grid-template-columns: 1fr 1.05fr; gap: 80px; align-items: center; }
  .ab-collage { position: relative; min-height: 500px; }
  .ab-block { position: absolute; left: -100vw; right: 18%; top: 50px; bottom: -30px; background: var(--cobalt); }
  .ab-main { position: absolute; left: 0; top: 0; width: 76%; height: 92%; overflow: hidden; border-radius: 4px; box-shadow: 0 30px 60px -20px rgba(0,0,0,.6); }
  .ab-main img { width: 100%; height: 115%; object-fit: cover; }
  .ab-tilt { position: absolute; right: 0; bottom: -20px; width: 44%; padding: 8px; background: #fff; border-radius: 8px; transform: rotate(4deg); box-shadow: 0 30px 60px -20px rgba(0,0,0,.7); transition: transform .5s var(--ease-out); }
  .ab-tilt:hover { transform: rotate(0deg) scale(1.03); }
  .ab-tilt img { width: 100%; aspect-ratio: 3/4; object-fit: cover; border-radius: 4px; }
  .ab-badge { position: absolute; left: 60%; top: -24px; width: 100px; height: 100px; border-radius: 50%; background: #fff; display: grid; place-items: center; padding: 10px; box-shadow: 0 16px 30px -10px rgba(0,0,0,.6); }
  .ab-badge img { border-radius: 50%; }
  .ab-h { margin-top: 14px; font-size: clamp(42px, 4.6vw, 66px); }
  .ab-list { margin: 34px 0 34px; display: grid; gap: 22px; }
  .ab-list li { padding-left: 18px; border-left: 3px solid var(--yellow); }
  .ab-list strong { color: #fff; font-size: 15px; }
  .ab-list p { color: var(--on-dark-2); font-size: 14.5px; margin-top: 4px; max-width: 520px; }

  /* SERVICES */
  .sv { padding-top: clamp(60px, 7vw, 90px); padding-bottom: clamp(70px, 8vw, 110px); }
  .sv-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; margin-top: 50px; }
  .sv-card { position: relative; background: #fff; box-shadow: 0 20px 50px -30px rgba(11,15,26,.35); border-bottom: 3px solid var(--cobalt); transition: box-shadow .4s; }
  .sv-card:hover { box-shadow: 0 30px 60px -26px rgba(31,79,216,.45); }
  .sv-img { position: relative; display: block; overflow: hidden; clip-path: polygon(0 0, calc(100% - 48px) 0, 100% 48px, 100% 100%, 0 100%); }
  .sv-img img { width: 100%; aspect-ratio: 400/250; object-fit: cover; transition: transform .8s var(--ease-out); }
  .sv-card:hover .sv-img img { transform: scale(1.07); }
  .sv-ico { position: absolute; left: 22px; top: calc((100% - 0px) * 0 + 0px); }
  .sv-ico { top: auto; margin-top: -34px; position: relative; display: grid; place-items: center; width: 64px; height: 64px; margin-left: 22px; border-radius: 50%; background: var(--cobalt); color: #fff; border: 4px solid #fff; box-shadow: 0 10px 24px -8px rgba(31,79,216,.6); transition: transform .5s var(--ease-out); }
  .sv-card:hover .sv-ico { transform: rotate(-12deg) scale(1.06); }
  .sv-body { padding: 14px 24px 22px; }
  .sv-t { font-size: 32px; color: var(--ink); }
  .sv-t a:hover { color: var(--cobalt); }
  .sv-d { color: var(--ink-2); font-size: 14px; margin: 8px 0 18px; min-height: 44px; }
  .sv-more { display: grid; grid-template-columns: auto 1fr auto; gap: 34px; align-items: center; margin-top: 44px; padding: 26px 28px; border-radius: 14px; background: var(--night2); }
  .sv-more-n { text-transform: uppercase; color: var(--yellow); font-size: 40px; line-height: 1; text-shadow: 0 0 14px rgba(255,210,31,.5); }
  .sv-more-k { color: var(--cyan); font-weight: 700; font-size: 12px; letter-spacing: .16em; text-transform: uppercase; margin-top: 10px; }
  .sv-more-s { color: var(--on-dark-2); font-size: 13px; }
  .sv-more-chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .sv-more-chips a { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 14px; border-radius: 6px; background: var(--night); border: 1px solid var(--line-dark); color: #fff; font-weight: 600; font-size: 14px; transition: border-color .3s, transform .3s var(--ease-out); }
  .sv-more-chips a .icon { color: var(--cyan); transition: transform .3s var(--ease-out); }
  .sv-more-chips a:hover { border-color: var(--cyan); transform: translateY(-2px); }
  .sv-more-chips a:hover .icon { transform: translateX(3px); }

  /* WORK */
  .wk { padding-top: clamp(60px, 7vw, 90px); padding-bottom: clamp(70px, 8vw, 110px); }
  .wk-head { display: flex; justify-content: space-between; align-items: end; gap: 20px; }
  .wk-head .h2 { margin-top: 14px; }
  .wk-grid { display: grid; grid-template-columns: 1fr 2fr 1fr; grid-template-rows: 300px 300px; gap: 20px; margin-top: 50px; }
  .wk-grid figure { position: relative; overflow: hidden; border-radius: 6px; }
  .wk-grid img { width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ease-out); }
  .wk-grid figure:hover img { transform: scale(1.05); }
  .wk-a { grid-column: 1; grid-row: 1; }
  .wk-b { grid-column: 2; grid-row: 1 / 3; }
  .wk-b img { height: 115%; }
  .wk-c { grid-column: 3; grid-row: 1; }
  .wk-d { grid-column: 1; grid-row: 2; }
  .wk-e { grid-column: 3; grid-row: 2; display: flex; flex-direction: column; justify-content: end; gap: 6px; padding: 24px; border-radius: 6px; background: var(--yellow); color: var(--ink); }
  .wk-e > .icon { margin-bottom: auto; }
  .wk-e-n { font-size: 72px; line-height: .9; }
  .wk-e-t { font-weight: 700; font-size: 15px; margin-bottom: 12px; }
