---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Btn from '../components/Btn.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Wave from '../components/Wave.astro';
import Ticker from '../components/Ticker.astro';
import CallbackForm from '../components/sections/CallbackForm.astro';
import ReviewSlots from '../components/sections/ReviewSlots.astro';
import ProcessSection from '../components/sections/ProcessSection.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import AreasSection from '../components/sections/AreasSection.astro';
import { SITE } from '../data/site';
import { SERVICES } from '../data/services';
import dusk from '../assets/img/dusk-street.jpg';
import jim from '../assets/img/jim-cutout.png';
import crawl from '../assets/img/job-crawlspace.jpg';
import roof from '../assets/img/job-roof.jpg';
import logo from '../assets/img/logo-united.png';
import snake from '../assets/img/job-drain-snake.jpg';
import wh from '../assets/img/job-water-heater.jpg';
import van from '../assets/img/jim-van.jpg';

const top6 = SERVICES.slice(0, 6);
const more = SERVICES.slice(6);
const shortName: Record<string, string> = { 'Sewer Camera Inspection': 'Sewer Camera', 'Copper Pipe & Repiping': 'Repiping', 'Gas Line Installation': 'Gas Line Install', 'Main Line Repair': 'Main Line Repair' };
const faqs = [
  { q: 'Do you really answer at night?', a: 'Yes. Call 909-587-0711 any hour, nights and weekends too. If the line is busy, call our backup line, 909-667-6555.' },
  { q: 'How much will it cost?', a: 'We look at the job, tell you the price, and you say yes before we start. Text a photo first and we can give you a price range.' },
  { q: '¿Hablan español?', a: 'Sí. Hablamos español. Pregunte por Jim.' },
  { q: 'Can I text a photo instead of calling?', qm: 'Can I text a photo instead?', a: 'Yes. Snap the drip, the puddle or the label on your water heater and text it to 909-587-0711. We text back what it is and what it takes to fix it.' },
  { q: 'Which areas do you cover?', a: 'Pomona and 27 towns around it in LA County, the Inland Empire and Orange County. See the full list on our <a href="/areas/">Areas page</a>.' },
  { q: 'Do you take small jobs too?', a: 'Yes. A dripping faucet is a real job to us. Call or text and tell us what you see.' },
];
const schema = [{
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })),
}];
---
<Base title="Plumber Pomona CA | Family Owned Since 2018 | Open 24/7" description="Plumber in Pomona, CA. Family owned and built by brothers. Drains, water heaters, leaks and sewer lines. Open 24/7. Call (909) 587-0711." schema={schema}>

  <!-- HERO -->
  <section class="hero dark">
    <div class="hero-bg" aria-hidden="true">
      <Image src={dusk} alt="" widths={[768, 1344]} sizes="100vw" loading="eager" fetchpriority="high" data-parallax="0.2" />
    </div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <div class="hero-pills" data-hero="1" data-hero-fx="pop" data-hero-children>
          <a href={SITE.instagram} target="_blank" rel="noopener" class="hpill"><Icon name="instagram" size={22} /><span><strong><span>{SITE.instagramFollowers}</span> followers</strong><small>@plumblord1 · verified</small></span></a>
          <a href={SITE.facebook} target="_blank" rel="noopener" class="hpill"><Icon name="facebook" size={22} /><span><strong>{SITE.facebookFollowers} followers</strong><small>Jim United Plumbing Official</small></span></a>
        </div>
        <h1 class="h-display hero-h" data-hero="2" data-hero-fx="lines">24/7 Plumber<br />in <span class="c-yellow">Pomona, CA</span></h1>
        <p class="hero-serve" data-hero="3" data-hero-fx="up">Serving Pomona, Claremont, Chino, Ontario, Upland &amp; the whole Inland Empire</p>
        <span class="hero-rule" data-hero="4" data-hero-fx="clipx" aria-hidden="true"></span>
        <p class="hero-p" data-hero="5" data-hero-fx="up">Pipe burst? Drain backed up? No hot water? Call Jim and the Galvez brothers any hour. <span class="d-only">A real person picks up, and you</span><span class="m-only">You</span> get a clear price before any work starts.</p>
        <div class="btn-row hero-btns" data-hero="6" data-hero-fx="up" data-hero-children>
          <Btn href={SITE.phoneHref} icon="phone" size="lg" sub="Answered 24/7 · English o Español">Call {SITE.phone}</Btn>
          <Btn href={SITE.smsHref} variant="outline-white" icon="message" size="lg" sub="We reply with a price range">Text us a photo</Btn>
        </div>
        <ul class="chips hero-chips" data-hero="7" data-hero-fx="up" data-hero-children>
          <li class="chip"><span class="chip-ico"><Icon name="clock" size={18} /></span><span><span class="d-only">Answered </span>24/7</span></li>
          <li class="chip"><span class="chip-ico"><Icon name="globe" size={18} /></span>Hablamos Español</li>
          <li class="chip"><span class="chip-ico"><Icon name="tag" size={18} /></span><span><span class="d-only">Clear price first</span><span class="m-only">Price first</span></span></li>
        </ul>
      </div>
      <div class="hero-jim" data-hero="1" data-hero-fx="right" data-hero-at="0.15">
        <div class="hero-glow" aria-hidden="true"></div>
        <Image src={jim} alt="Jaime “Jim” Galvez, owner of United Plumbing, in his work shirt" widths={[420, 640, 900]} sizes="(max-width: 900px) 90vw, 560px" loading="eager" class="hero-jim-img" format="webp" quality={82} />
        <p class="hero-tag h-display" data-hero="8" data-hero-fx="pop"><span class="hero-tag-n">Jim Galvez</span><span class="hero-tag-dot">  ·  </span><small>Owner &amp; Plumber</small></p>
      </div>
    </div>
    <div class="wrap hero-form" data-hero="9" data-hero-fx="up"><CallbackForm variant="bar" id="hero-cb" /></div>
  </section>

  <!-- REVIEWS (placeholders until the Google profile is live) -->
  <section class="rev light">
    <div class="wrap head-center">
      <Eyebrow>What neighbors say</Eyebrow>
      <h2 class="h-display h2 rev-h" data-split>Trusted by homeowners<br /><span class="c-cobalt">across the Inland Empire</span></h2>
    </div>
    <div class="wrap"><hr class="rev-hr" data-reveal="clipx" /></div>
    <div class="rev-car" data-reveal="up"><ReviewSlots /></div>
  </section>

  <Ticker items={['BURST PIPE', 'CLOGGED DRAIN', 'NO HOT WATER', 'GAS LINE', 'SEWER BACKUP', 'SLAB LEAK', 'TREE ROOTS']} />

  <!-- ABOUT -->
  <section class="ab dark2 section">
    <div class="wrap ab-grid">
      <div class="ab-collage">
        <span class="ab-block" data-reveal="clipx" aria-hidden="true"></span>
        <figure class="ab-main" data-reveal="clip"><Image src={crawl} alt="A Galvez brother working on drain pipes in a crawl space" widths={[400, 800]} sizes="(max-width: 900px) 80vw, 470px" data-parallax="0.06" /></figure>
        <figure class="ab-tilt" data-reveal="pop"><Image src={roof} alt="The United Plumbing crew carrying equipment up a ladder to a roof" widths={[300, 600]} sizes="220px" /></figure>
        <span class="ab-badge" data-reveal="pop"><Image src={logo} alt="" width={200} height={152} /></span>
      </div>
      <div class="ab-copy">
        <Eyebrow>About United Plumbing</Eyebrow>
        <h2 class="h-display h2 ab-h" data-split><span class="c-white">Built by brothers.</span><br /><span class="c-cyan">Trusted by neighbors.</span></h2>
        <ul class="ab-list" data-stagger="up">
          <li><strong>How it started</strong><p>Jaime "Jim" Galvez learned the trade first. Then he trained each of his brothers himself, job by job<span class="d-only">, until they could run a call on their own</span>.</p></li>
          <li><strong>Who shows up</strong><p>A small family crew, all trained the same way. <span class="d-only">When you call United, you</span><span class="m-only">You</span> get the Galvez family, not a stranger off an app.</p></li>
          <li><strong>How we treat you</strong><p>A clear price before we start. No hidden fees, <span class="d-only">no surprise charges, and we explain the fix</span><span class="m-only">and the fix explained</span> in plain words, in English or Spanish.</p></li>
        </ul>
        <div class="btn-row ab-btns" data-reveal="up">
          <Btn href={SITE.phoneHref} icon="phone" size="md">Call Jim {SITE.phone}</Btn>
          <Btn href="/our-work/" variant="outline-white" size="md" class="d-only">See our work</Btn>
        </div>
      </div>
    </div>
  </section>

  <Wave from="#131B2E" to="#F3F6FB" flip />

  <!-- SERVICES -->
  <section class="sv light">
    <div class="wrap head-center">
      <Eyebrow>What we fix</Eyebrow>
      <h2 class="h-display h2" data-split>Plumbing services in<br /><span class="c-cobalt">Pomona &amp; the Inland Empire</span></h2>
      <p class="lead" data-reveal="up"><span class="d-only">Big jobs and small ones. </span>Tap a service to call about it now, or text us a photo of the problem<span class="d-only"> and get a price range</span>.</p>
    </div>
    <div class="wrap sv-grid" data-stagger="up">
      {top6.map((s) => (
        <article class="sv-card" data-tilt>
          <a href={`/${s.slug}/`} class="sv-img" aria-label={`${s.name}: see the page`}>
            {s.img && <Image src={s.img} alt={`${s.name} (stand-in photo)`} widths={[400, 700]} sizes="(max-width: 700px) 90vw, 400px" />}
            {s.standIn && <span class="standin">Stand-in photo</span>}
          </a>
          <span class="sv-ico"><Icon name={s.icon} size={24} /></span>
          <div class="sv-body">
            <h3 class="h-display sv-t"><a href={`/${s.slug}/`}>{shortName[s.name] ?? s.name}</a></h3>
            <p class="sv-d">{s.short}</p>
            <Btn href={SITE.phoneHref} variant="cobalt" size="sm" arrow>{s.cta}</Btn>
          </div>
        </article>
      ))}
    </div>
    <div class="wrap">
      <div class="sv-more" data-reveal="up">
        <div class="sv-more-l"><p class="led sv-more-n">+7 more</p><p class="sv-more-k">Also on the truck<span class="m-only"> · 13 services in total</span></p><p class="sv-more-s">13 services in total.</p></div>
        <ul class="sv-more-chips" data-stagger="pop">
          {more.map((s) => <li><a href={`/${s.slug}/`}>{shortName[s.name] ?? s.name}<Icon name="arrow" size={16} /></a></li>)}
        </ul>
        <Btn href="/services/" size="md" arrow class="sv-more-btn">See all 13 services</Btn>
      </div>
    </div>
  </section>

  <Wave from="#F3F6FB" to="#0B0F1A" />

  <!-- LATEST WORK -->
  <section class="wk dark">
    <div class="wrap wk-head">
      <div>
        <Eyebrow>Recent jobs</Eyebrow>
        <h2 class="h-display h2" data-split><span class="c-white">Our </span><span class="c-cyan">latest work</span></h2>
      </div>
      <a href="/our-work/" class="textlink" data-reveal="left">See all jobs <Icon name="arrow" size={16} /></a>
    </div>
    <div class="wrap wk-grid">
      <figure class="wk-a" data-reveal="clip"><Image src={snake} alt="Jim feeding a drain snake into a clogged line" widths={[400, 700]} sizes="(max-width: 800px) 50vw, 300px" /></figure>
      <figure class="wk-b" data-reveal="clip" data-delay="0.1"><Image src={wh} alt="Installing a new water heater outside a Pomona home" widths={[600, 1000]} sizes="(max-width: 800px) 100vw, 620px" data-parallax="0.06" /></figure>
      <div class="wk-c slot" data-reveal="up"><Icon name="instagram" size={34} /><span>Next job photo from<br />@plumblord1<span class="d-only"> goes here</span></span></div>
      <div class="wk-d slot" data-reveal="up"><Icon name="instagram" size={34} /><span>Next job photo from<br />@plumblord1 goes here</span></div>
      <a href={SITE.instagram} target="_blank" rel="noopener" class="wk-e" data-reveal="up" data-tilt>
        <Icon name="instagram" size={40} />
        <span class="wk-e-n h-display" data-count="1156">1,156</span>
        <span class="wk-e-t">people follow Jim's jobs on Instagram</span>
        <span class="btn btn-ink btn-sm">Follow @plumblord1 <Icon name="arrow" size={18} /></span>
      </a>
    </div>
  </section>

  <!-- WHY -->
  <section class="why white section">
    <div class="wrap why-grid">
      <div>
        <Eyebrow>Why choose United</Eyebrow>
        <h2 class="h-display h2 why-h" data-split>Why Pomona<br /><span class="c-cobalt">calls United</span></h2>
        <p class="lead why-p" data-reveal="up">When a pipe bursts at 2 AM, you want someone who picks up, speaks your language and tells you the price <span class="d-only">before touching anything. That is how the Galvez brothers work.</span><span class="m-only">first.</span></p>
        <ul class="why-list" data-stagger="left">
          <li><span><Icon name="clock" size={18} /></span>A real person answers, 24/7</li>
          <li><span><Icon name="globe" size={18} /></span>Hablamos Español</li>
          <li><span><Icon name="tag" size={18} /></span>Clear price before any work starts</li>
          <li><span><Icon name="users" size={18} /></span>Family crew, all trained by Jim</li>
          <li><span><Icon name="camera" size={18} /></span>Text a photo, get a price range</li>
        </ul>
      </div>
      <figure class="why-photo" data-reveal="clip">
        <Image src={van} alt="Jaime “Jim” Galvez standing next to the United Plumbing work truck" widths={[500, 900]} sizes="(max-width: 900px) 100vw, 640px" data-parallax="0.06" />
        <figcaption class="why-name" data-reveal="left"><strong class="h-display">Jaime "Jim" Galvez</strong><small>Owner · United Plumbing</small></figcaption>
      </figure>
    </div>
  </section>

  <Wave from="#FFFFFF" to="#0B0F1A" />
  <ProcessSection />
  <Wave from="#0B0F1A" to="#FFFFFF" flip />
  <FaqSection faqs={faqs} />
  <Wave from="#FFFFFF" to="#0B0F1A" />
  <ContactSection />
  <Ticker items={['CALL 909-587-0711', '24/7', 'HABLAMOS ESPAÑOL', 'POMONA', 'CLAREMONT', 'CHINO', 'ONTARIO', 'UPLAND']} cyan reverse />
  <AreasSection />
</Base>

<style>
  /* HERO (Figma 225:482: 820 px photo area, 960 px total, form straddles at 730) */
  .hero { position: relative; overflow: hidden; padding: 0 0 30px; }
  .hero::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 140px; background: var(--paper); z-index: 1; }
  .hero-bg { position: absolute; inset: -12% 0 140px; z-index: 0; overflow: hidden; }
  .hero-bg img { width: 100%; height: 100%; object-fit: cover; object-position: 60% 50%; }
  .hero-bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(11,15,26,0) calc(100% - 260px), rgba(11,15,26,.9) 100%), linear-gradient(90deg, rgba(11,15,26,.96) 0%, rgba(11,15,26,.82) 45%, rgba(11,15,26,.25) 75%, rgba(11,15,26,.1) 100%); }
  .hero-grid { position: relative; z-index: 2; }
  .hero-copy { position: relative; z-index: 2; height: 730px; padding-top: 78px; }
  .hero-pills { display: flex; flex-wrap: wrap; gap: 10px; }
  .hpill { display: inline-flex; align-items: center; gap: 10px; padding: 8px 14px; border: 1px solid rgba(255,255,255,.18); border-radius: 10px; background: rgba(255,255,255,.08); backdrop-filter: blur(6px); color: #fff; transition: border-color .3s, transform .3s var(--ease-out); }
  .hpill:hover { border-color: var(--cyan); transform: translateY(-2px); }
  .hpill strong { display: block; font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: 20px; line-height: 24px; }
  .hpill small { display: block; font-size: 12px; line-height: 16px; font-weight: 500; color: #a3aec6; }
  .hero-h { margin-top: 14px; font-size: clamp(60px, 8.612vw, 124px); color: #fff; line-height: .88; letter-spacing: 0; }
  .hero-serve { margin-top: 20px; color: var(--cyan); font-weight: 600; font-size: 18px; line-height: 23px; }
  .hero-rule { display: block; width: 88px; height: 4px; margin-top: 12px; background: var(--yellow); border-radius: 2px; }
  .hero-p { margin-top: 24px; color: #d5dcea; font-size: 18px; line-height: 1.5; max-width: 620px; }
  .hero-btns { margin-top: 30px; }
  .hero-btns :global(.btn) { --bh: 72px; gap: 12px; letter-spacing: .02em; }
  .hero-btns :global(.btn .icon) { width: 22px; height: 22px; }
  .hero-btns :global(.btn-yellow) { font-size: 28px; padding: 0 28px; }
  .hero-btns :global(.btn-outline-white) { font-size: 26px; padding: 0 26px; background: transparent; }
  .hero-btns :global(.btn-two small) { font-size: 12px; margin-top: 4px; opacity: .8; }
  .hero-chips { margin-top: 26px; color: #fff; gap: 10px 31px; }
  .hero-chips :global(.chip-ico) { width: 34px; height: 34px; background: rgba(51,214,255,.14); }
  .hero-jim { position: absolute; z-index: 1; right: 66px; top: 46px; width: min(494px, 34.31vw); aspect-ratio: 494 / 774; }
  .hero-jim-img { position: relative; z-index: 1; display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 0; }
  .hero-glow { position: absolute; left: 4%; top: 13.4%; width: 113%; aspect-ratio: 1; background: radial-gradient(closest-side, rgba(31,79,216,.75), rgba(31,79,216,.35) 55%, rgba(31,79,216,0)); filter: blur(20px); transform: translate(-12.5%, -12.5%) scale(1.25); }
  .hero-tag { position: absolute; z-index: 2; left: calc(100% + 24px); top: 104px; width: 58px; height: 420px; display: flex; align-items: center; justify-content: center; writing-mode: vertical-rl; transform: rotate(180deg); background: var(--cobalt); color: #fff; border-radius: 8px; font-size: 22px; line-height: 1; letter-spacing: .06em; white-space: pre; }
  .hero-tag small { font-size: 22px; }
  .hero-form { position: relative; z-index: 3; }

  /* Homepage eyebrows (Figma: 13 px bold, 0.14em tracking, 16 px drop icon) */
  :global(main .eyebrow) { display: flex; width: fit-content; font-size: 13px; line-height: 17px; letter-spacing: .14em; }
  :global(main .head-center .eyebrow) { margin-inline: auto; }
  /* Figma buttons carry no glow at rest */
  :global(main .btn-yellow) { box-shadow: none; }
  :global(main .eyebrow .icon) { width: 16px; height: 16px; }

  /* REVIEWS (Figma 227:437: 640 tall) */
  .rev { padding-top: 40px; padding-bottom: 76px; overflow: hidden; }
  .rev-h { margin-top: 13px; font-size: clamp(34px, 4.445vw, 64px); line-height: .92; letter-spacing: 0; }
  .rev-hr { border: 0; height: 1px; background: #dce3ee; margin: 28px 0 21px; }
  .rev-car :global(.car-track) { gap: 30px; padding-inline: max(var(--gutter), calc((100vw - var(--wrap)) / 2)); scroll-padding-inline: max(var(--gutter), calc((100vw - var(--wrap)) / 2)); }
  .rev-car :global(.car-ctrl) { margin-top: -4px; }

  /* ABOUT (Figma 227:557: 730 px + 90 px wave; collage 80-690, copy from 690) */
  .ab.section { padding-block: 0; }
  .ab-grid { display: grid; grid-template-columns: 47.66% 1fr; min-height: 730px; }
  .ab-collage { position: relative; min-height: 730px; }
  .ab-block { position: absolute; left: -100vw; right: 59.02%; top: 170px; height: 520px; background: var(--cobalt); }
  .ab-main { position: absolute; left: 0; top: 110px; width: 77.05%; height: 560px; overflow: hidden; border-radius: 14px; }
  .ab-main img { width: 100%; height: 107%; translate: 0 -3.27%; object-fit: cover; }
  .ab-tilt { position: absolute; left: calc(65.74% - 125px); top: 400px; width: 250px; height: 310px; padding: 8px; background: #fff; border-radius: 10px; transform: rotate(5deg); box-shadow: 0 30px 60px -20px rgba(0,0,0,.6); transition: transform .5s var(--ease-out); }
  .ab-tilt:hover { transform: rotate(0deg) scale(1.03); }
  .ab-tilt img { width: 100%; height: 100%; object-fit: cover; border-radius: 6px; }
  .ab-badge { position: absolute; left: 60.33%; top: 84px; width: 124px; height: 124px; border-radius: 50%; background: #fff; display: grid; place-items: center; padding: 22px 14px 24px; box-shadow: 0 16px 30px -10px rgba(0,0,0,.6); }
  .ab-badge img { width: 96px; height: 78px; object-fit: contain; }
  .ab-copy { padding-top: 120px; }
  .ab-h { margin-top: 13px; font-size: clamp(42px, 4.167vw, 60px); line-height: .92; letter-spacing: 0; }
  .ab-list { margin-top: 30px; display: grid; gap: 24px; }
  .ab-list li { position: relative; padding-left: 22px; }
  .ab-list li::before { content: ''; position: absolute; left: 0; top: 2px; width: 4px; height: 64px; border-radius: 2px; background: var(--yellow); }
  .ab-list strong { display: block; color: #fff; font-size: 17px; line-height: 22px; }
  .ab-list p { color: #c3ccdd; font-size: 16px; line-height: 1.5; margin-top: 4px; max-width: 640px; }
  .ab-btns { margin-top: 32px; }
  .ab-btns :global(.btn) { --bh: 56px; padding: 0 28px; font-size: 22px; letter-spacing: .02em; }
  .ab-btns :global(.btn .icon) { width: 22px; height: 22px; }

  /* SERVICES (Figma 230:437: 1538 px + 90 px wave; 400 x 460 cards, 40 px gaps) */
  .sv { padding-top: 40px; padding-bottom: 72px; }
  .sv .h2 { margin-top: 13px; font-size: clamp(34px, 4.445vw, 64px); line-height: .92; letter-spacing: 0; }
  .sv .lead { margin: 20px auto 0; max-width: 680px; font-size: 17px; line-height: 1.5; color: #475569; }
  .sv-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; margin-top: 39px; }
  .sv-card { position: relative; background: #fff; border-radius: 4px; overflow: hidden; box-shadow: 0 10px 14px rgba(10,15,26,.08); border-bottom: 3px solid var(--cobalt); transition: box-shadow .4s; }
  .sv-card:hover { box-shadow: 0 30px 60px -26px rgba(31,79,216,.45); }
  .sv-img { position: relative; display: block; overflow: hidden; clip-path: polygon(0 0, calc(100% - 60px) 0, 100% 60px, 100% 100%, 0 100%); }
  .sv-img img { width: 100%; aspect-ratio: 400/250; object-fit: cover; transition: transform .8s var(--ease-out); }
  .sv-img .standin { left: 14px; top: 14px; width: 112px; height: 24px; padding: 0; display: grid; place-items: center; font-size: 11px; letter-spacing: .06em; opacity: .9; }
  .sv-card:hover .sv-img img { transform: scale(1.07); }
  .sv-ico { position: relative; display: grid; place-items: center; width: 72px; height: 72px; margin: -36px 0 0 24px; border-radius: 50%; background: var(--cobalt); color: #fff; border: 5px solid #fff; transition: transform .5s var(--ease-out); }
  .sv-ico :global(.icon) { width: 30px; height: 30px; }
