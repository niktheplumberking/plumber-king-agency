---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Btn from '../components/Btn.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Wave from '../components/Wave.astro';
import Ticker from '../components/Ticker.astro';
import CallbackForm from '../components/sections/CallbackForm.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import AreasSection from '../components/sections/AreasSection.astro';
import PageHero from '../components/company/PageHero.astro';
import HeroChips from '../components/company/HeroChips.astro';
import VideoTile from '../components/company/VideoTile.astro';
import { SITE } from '../data/site';
import wh from '../assets/img/job-water-heater.jpg';
import crawl from '../assets/img/job-crawlspace.jpg';
import snake from '../assets/img/job-drain-snake.jpg';
import roof from '../assets/img/job-roof.jpg';
import van from '../assets/img/jim-van.jpg';

type Cat = 'drains' | 'water' | 'leaks' | 'gas' | 'house';
const cats: { k: Cat | 'all'; label: string }[] = [
  { k: 'all', label: 'All' }, { k: 'drains', label: 'Drains & Sewer' }, { k: 'water', label: 'Water Heaters' },
  { k: 'leaks', label: 'Leaks & Pipes' }, { k: 'gas', label: 'Gas' }, { k: 'house', label: 'Around the House' },
];
const catName = Object.fromEntries(cats.map((c) => [c.k, c.label]));
const jobs = [
  { id: 'wh', img: wh, cat: 'water' as Cat, t: 'Water heater swap', c: 'Old tank out, new one in.', town: null, alt: 'A Galvez brother installing a new water heater outside a home', pos: '50% 60%' },
  { id: 'crawl', img: crawl, cat: 'leaks' as Cat, t: 'Crawl space repair', c: 'Working under the house in a tight crawl space.', town: null, alt: 'A United Plumbing plumber working on pipes in a tight crawl space', pos: '50% 35%' },
  { id: 'snake', img: snake, cat: 'drains' as Cat, t: 'Sewer line cleared', c: 'Drain machine on a backed-up line.', town: null, alt: 'A plumber running a drain machine on a backed-up sewer line', pos: '50% 50%' },
  { id: 'roof', img: roof, cat: 'house' as Cat, t: 'Up on the roof', c: 'Crew on the ladder, working up top.', town: null, alt: 'The United Plumbing crew carrying equipment up a ladder to a roof', pos: '50% 40%' },
  { id: 'van', img: van, cat: 'house' as Cat, t: 'On the way', c: 'One of our trucks heading to a call.', town: 'Pomona', alt: 'Jim Galvez next to a United Plumbing work truck in Pomona', pos: '70% 30%' },
];
const big = await Promise.all(jobs.map((j) => getImage({ src: j.img, width: 1600, format: 'webp' })));
const J = Object.fromEntries(jobs.map((j, i) => [j.id, { ...j, big: big[i].src, n: i }]));
const counts: Record<string, number> = { all: 9 };
jobs.forEach((j) => { counts[j.cat] = (counts[j.cat] ?? 0) + 1; });
const slots = 3; // empty job slots + the before/after slot make up the 9 tiles
---
<Base title="Our Plumbing Work | Real Jobs | Pomona & Nearby" description="Real photos from real United Plumbing jobs around Pomona: water heaters, sewer lines, crawl spaces and more. Call (909) 587-0711." crumbs={[{ name: 'Our work', href: '/our-work/' }]}>

  <PageHero crumbs={[{ name: 'Our work', href: '/our-work/' }]} class="wk-hero">
    <div class="wh-grid">
      <div>
        <p class="eyebrow on-dark wh-eb" data-hero="1" data-hero-fx="up"><Icon name="camera" size={14} />Our work</p>
        <h1 class="h-display wh-h" data-hero="2" data-hero-fx="lines">Real jobs,<br /><span class="c-yellow">real homes.</span></h1>
        <p class="wh-p" data-hero="3" data-hero-fx="up">No stock photos. These are our jobs around Pomona.</p>
        <div class="btn-row wh-btns" data-hero="4" data-hero-fx="up" data-hero-children>
          <Btn href={SITE.phoneHref} icon="phone" size="lg">Call {SITE.phoneDisplay}</Btn>
          <Btn href={SITE.smsHref} variant="outline-cyan" icon="message" size="lg">Text us a photo</Btn>
        </div>
        <HeroChips order="5" />
      </div>
      <div class="pol" data-hero="2" data-hero-fx="pop" data-hero-children>
        <figure class="pol-a"><Image src={wh} alt="" widths={[300, 520]} sizes="(max-width: 900px) 46vw, 260px" loading="eager" /><figcaption class="h-display">Water heater swap</figcaption></figure>
        <figure class="pol-b"><Image src={crawl} alt="" widths={[300, 520]} sizes="(max-width: 900px) 40vw, 240px" loading="eager" /><figcaption class="h-display">Crawl space repair</figcaption></figure>
        <figure class="pol-c"><Image src={snake} alt="" widths={[300, 520]} sizes="(max-width: 900px) 34vw, 240px" loading="eager" /><figcaption class="h-display">Sewer line cleared</figcaption></figure>
      </div>
    </div>
    <div class="wrap wh-form" slot="after" data-hero="6" data-hero-fx="up"><CallbackForm variant="bar" id="work-cb" title="Like what you see? Get a call back" /></div>
  </PageHero>

  <!-- GALLERY -->
  <section class="gal light">
    <div class="wrap gal-head">
      <div>
        <Eyebrow>Job gallery</Eyebrow>
        <h2 class="h-display h2 gal-h" data-split>Real work from<br /><span class="c-cobalt">real calls.</span></h2>
        <p class="lead gal-p" data-reveal="up">Each photo is a real United Plumbing job. Tap one to see it bigger.</p>
      </div>
      <a href={SITE.instagram} target="_blank" rel="noopener" class="gal-led" data-reveal="left">
        <small class="led">Real jobs so far</small>
        <span class="led gal-led-n">05</span>
        <span class="gal-led-t">more on<br />@plumblord1</span>
      </a>
    </div>
    <div class="wrap">
      <div class="gal-filters" role="group" aria-label="Filter jobs" data-stagger="pop">
        {cats.map((c, i) => (
          <button type="button" class:list={['gf', { on: i === 0 }]} data-filter={c.k} aria-pressed={i === 0 ? 'true' : 'false'}>
            {c.label}{c.k === 'all' && <span class="gf-n">{counts.all}</span>}
          </button>
        ))}
      </div>
      <p class="sr-only" aria-live="polite" data-gal-status></p>
      <div class="gal-grid" data-gal>
        {['wh', 'crawl'].map((id) => { const j = J[id]; return (
          <button type="button" class={`gt gt-photo gt-${id}`} data-cat={j.cat} data-lb={j.n} aria-label={`See bigger: ${j.t}`}>
            <Image src={j.img} alt={j.alt} widths={[400, 700, 1000]} sizes={id === 'crawl' ? '(max-width: 760px) 50vw, 620px' : '(max-width: 760px) 50vw, 300px'} style={`object-position:${j.pos}`} />
            <span class="gt-cat">{catName[j.cat]}</span>
            <span class="gt-go" aria-hidden="true"><Icon name="arrow" size={16} /></span>
            <span class="gt-cap"><strong class="h-display">{j.t}</strong><small>"{j.c}"</small><span class="gt-town"><Icon name="pin" size={13} />{j.town ?? <em class="ph">Town</em>}</span></span>
          </button>
        ); })}
        <a href={SITE.instagram} target="_blank" rel="noopener" class="gt gt-follow" data-fixed>
          <span class="gf-top"><span class="gf-ig"><Icon name="instagram" size={18} /></span>Follow the work</span>
          <span class="gf-stat"><span class="led c-yellow" data-count="1156">{SITE.instagramFollowers}</span><small>Instagram followers</small></span>
          <span class="gf-stat"><span class="led c-cyan">{SITE.facebookFollowers}</span><small>Facebook followers</small></span>
        </a>
        {['snake'].map((id) => { const j = J[id]; return (
          <button type="button" class={`gt gt-photo gt-${id}`} data-cat={j.cat} data-lb={j.n} aria-label={`See bigger: ${j.t}`}>
            <Image src={j.img} alt={j.alt} widths={[400, 700]} sizes="(max-width: 760px) 50vw, 300px" style={`object-position:${j.pos}`} />
            <span class="gt-cat">{catName[j.cat]}</span>
            <span class="gt-go" aria-hidden="true"><Icon name="arrow" size={16} /></span>
            <span class="gt-cap"><strong class="h-display">{j.t}</strong><small>"{j.c}"</small><span class="gt-town"><Icon name="pin" size={13} /><em class="ph">Town</em></span></span>
          </button>
        ); })}
        <div class="gt gt-ba" data-ba data-fixed style="--pos:50%">
          <div class="ba-side ba-before"><span class="ba-l led">Before</span><span class="ba-slot"><span class="ba-cam"><Icon name="camera" size={20} /></span>Before photo from @plumblord1</span></div>
          <div class="ba-side ba-after" aria-hidden="false"><span class="ba-l led">After</span><span class="ba-slot"><span class="ba-cam"><Icon name="camera" size={20} /></span>After photo from @plumblord1</span></div>
          <span class="ba-line" aria-hidden="true"><span class="ba-knob"><Icon name="chevronLeft" size={16} /><Icon name="chevronRight" size={16} /></span></span>
          <input type="range" min="0" max="100" value="50" class="ba-range" aria-label="Drag to compare the before and after photos" />
          <p class="ba-cap"><strong class="h-display">Before / after · <em class="ph">Town</em></strong><small>Caption goes here · drag to compare</small></p>
        </div>
        {['roof'].map((id) => { const j = J[id]; return (
          <button type="button" class={`gt gt-photo gt-${id}`} data-cat={j.cat} data-lb={j.n} aria-label={`See bigger: ${j.t}`}>
            <Image src={j.img} alt={j.alt} widths={[400, 700]} sizes="(max-width: 760px) 50vw, 300px" style={`object-position:${j.pos}`} />
            <span class="gt-cat">{catName[j.cat]}</span>
            <span class="gt-go" aria-hidden="true"><Icon name="arrow" size={16} /></span>
            <span class="gt-cap"><strong class="h-display">{j.t}</strong><small>"{j.c}"</small><span class="gt-town"><Icon name="pin" size={13} /><em class="ph">Town</em></span></span>
          </button>
        ); })}
        <div class="gt slot gt-s1" data-fixed><span class="slot-ring"><Icon name="camera" size={22} /></span><span>Job photo from @plumblord1 goes here</span><span class="slot-cap"><strong class="h-display">Job · Town</strong><small>Caption goes here</small></span></div>
        {['van'].map((id) => { const j = J[id]; return (
          <button type="button" class={`gt gt-photo gt-${id}`} data-cat={j.cat} data-lb={j.n} aria-label={`See bigger: ${j.t}`}>
            <Image src={j.img} alt={j.alt} widths={[600, 1000]} sizes="(max-width: 760px) 100vw, 620px" style={`object-position:${j.pos}`} />
            <span class="gt-cat">{catName[j.cat]}</span>
            <span class="gt-go" aria-hidden="true"><Icon name="arrow" size={16} /></span>
            <span class="gt-cap"><strong class="h-display">{j.t}</strong><small>"{j.c}"</small><span class="gt-town"><Icon name="pin" size={13} />{j.town}</span></span>
          </button>
        ); })}
        {Array.from({ length: slots - 1 }).map((_, k) => (
          <div class={`gt slot gt-s${k + 2}`} data-fixed><span class="slot-ring"><Icon name="camera" size={22} /></span><span>Job photo from @plumblord1 goes here</span><span class="slot-cap"><strong class="h-display">Job · Town</strong><small>Caption goes here</small></span></div>
        ))}
        <div class="gt gt-next" data-fixed>
          <p class="h-display">Your job<br />could be next.</p>
          <p class="gt-next-p">Text us a photo of the problem. Get a price range back.</p>
          <Btn href={SITE.smsHref} variant="ink" icon="message" size="md" full>Text a photo</Btn>
        </div>
      </div>
      <p class="gal-empty" data-gal-empty hidden>More jobs in this group are coming soon. <a href={SITE.instagram} target="_blank" rel="noopener" class="textlink">See them on Instagram <Icon name="arrow" size={14} /></a></p>
    </div>
  </section>

  <dialog class="lb" data-lightbox aria-label="Job photo">
    <div class="lb-in">
      <button type="button" class="lb-x" data-lb-close aria-label="Close"><Icon name="close" size={22} /></button>
      <button type="button" class="lb-nav lb-prev" data-lb-prev aria-label="Previous photo"><Icon name="chevronLeft" size={24} /></button>
      <figure class="lb-fig">
        <img data-lb-img alt="" />
        <figcaption><strong class="h-display" data-lb-t></strong><span data-lb-c></span></figcaption>
      </figure>
      <button type="button" class="lb-nav lb-next" data-lb-next aria-label="Next photo"><Icon name="chevronRight" size={24} /></button>
    </div>
  </dialog>
  <script type="application/json" data-lb-data set:html={JSON.stringify(jobs.map((j, i) => ({ src: big[i].src, alt: j.alt, t: j.t, c: `"${j.c}" · ${j.town ?? 'Town to be confirmed'}` })))} />

  <Wave from="#F3F6FB" to="#131B2E" />

  <!-- INSTAGRAM -->
  <section class="ig dark2">
    <div class="ig-glow" aria-hidden="true"></div>
    <div class="wrap ig-grid">
      <div>
        <Eyebrow>Video reviews</Eyebrow>
        <h2 class="h-display h2 ig-h" data-split><span class="c-white">More on</span><br /><span class="c-cyan">Instagram.</span></h2>
        <p class="lead ig-p" data-reveal="up">We post jobs and customer videos almost every week.</p>
        <div class="ig-stats" data-reveal="up">
          <span class="led c-yellow ig-n">{SITE.instagramFollowers}</span><small>Instagram<br />followers</small>
          <span class="ig-div" aria-hidden="true"></span>
          <span class="ig-fb"><span class="led c-cyan">{SITE.facebookFollowers}</span><small>Facebook</small></span>
        </div>
        <div data-reveal="up"><Btn href={SITE.instagram} target="_blank" icon="instagram" size="md" full>Follow @plumblord1</Btn></div>
      </div>
      <div class="ig-phones" data-stagger="up">
        <VideoTile variant="phone" caption="Video 1 · 38s" progress={70} />
        <VideoTile variant="phone" caption="Video 2 · 18s" progress={40} active class="ig-mid" />
        <VideoTile variant="phone" caption="Video 3 · 6s" progress={15} />
      </div>
    </div>
  </section>

  <ContactSection line1="Want your job" line2="done right?" text="Call (909) 587-0711, or leave your number and Jim's team calls you back. Same family crew you see in the photos." />
  <Ticker items={['CALL 909-587-0711', '24/7', 'HABLAMOS ESPAÑOL', 'POMONA', 'CLAREMONT', 'CHINO', 'ONTARIO', 'UPLAND']} cyan reverse />
  <AreasSection />
</Base>

<script>
  // Gallery filter, lightbox and before/after slider (page-only).
  const grid = document.querySelector<HTMLElement>('[data-gal]');
  const status = document.querySelector<HTMLElement>('[data-gal-status]');
  const empty = document.querySelector<HTMLElement>('[data-gal-empty]');
  document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((btn, _i, all) => {
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter!;
      all.forEach((b) => { const on = b === btn; b.classList.toggle('on', on); b.setAttribute('aria-pressed', String(on)); });
      let shown = 0;
      grid?.querySelectorAll<HTMLElement>('.gt').forEach((t) => {
        const show = f === 'all' || t.dataset.cat === f;
        t.hidden = !show; if (show) shown++;
        if (show && f !== 'all') t.animate?.([{ opacity: 0, transform: 'scale(.96)' }, { opacity: 1, transform: 'none' }], { duration: 380, easing: 'cubic-bezier(.22,1,.36,1)' });
      });
      grid?.classList.toggle('is-filtered', f !== 'all');
      if (empty) empty.hidden = shown > 0;
      if (status) status.textContent = `${shown} ${shown === 1 ? 'job' : 'jobs'} shown`;
    });
  });

  const dlg = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const data: { src: string; alt: string; t: string; c: string }[] = JSON.parse(document.querySelector('[data-lb-data]')?.textContent || '[]');
  let cur = 0; let opener: HTMLElement | null = null;
  const img = dlg?.querySelector<HTMLImageElement>('[data-lb-img]');
  const show = (i: number) => {
    cur = (i + data.length) % data.length; const d = data[cur];
    if (img) { img.src = d.src; img.alt = d.alt; img.animate?.([{ opacity: 0, transform: 'scale(.97)' }, { opacity: 1, transform: 'none' }], { duration: 320, easing: 'ease-out' }); }
    dlg!.querySelector('[data-lb-t]')!.textContent = d.t;
    dlg!.querySelector('[data-lb-c]')!.textContent = d.c;
  };
  document.querySelectorAll<HTMLElement>('[data-lb]').forEach((t) => t.addEventListener('click', () => {
    if (!dlg) return; opener = t; show(Number(t.dataset.lb)); dlg.showModal(); document.documentElement.classList.add('lb-open');
  }));
  dlg?.querySelector('[data-lb-close]')?.addEventListener('click', () => dlg.close());
  dlg?.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(cur - 1));
  dlg?.querySelector('[data-lb-next]')?.addEventListener('click', () => show(cur + 1));
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg?.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(cur - 1); if (e.key === 'ArrowRight') show(cur + 1); });
  dlg?.addEventListener('close', () => { document.documentElement.classList.remove('lb-open'); opener?.focus(); });

  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((ba) => {
    const r = ba.querySelector<HTMLInputElement>('.ba-range');
    r?.addEventListener('input', () => ba.style.setProperty('--pos', r.value + '%'));
  });
</script>

<style>
  :global(section.ct) { position: relative; isolation: isolate; }
  /* HERO */
  .wk-hero { padding-bottom: 0; }
  .wk-hero::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 70px; background: var(--paper); z-index: 1; }
  .wh-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 40px; align-items: center; margin-top: 14px; padding-bottom: 40px; }
  .wh-eb { color: var(--cyan); }
  .wh-h { margin-top: 12px; font-size: clamp(56px, 7.6vw, 108px); line-height: .86; color: #fff; }
  .wh-p { margin-top: 22px; font-size: 18px; color: var(--on-dark); }
  .wh-btns { margin-top: 30px; }
  .wh-btns :global(.btn) { --bh: 68px; font-size: 28px; }
  .wh-btns :global(.btn-outline-cyan) { background: rgba(11,15,26,.5); }
  .pol { position: relative; height: 520px; }
  .pol figure { position: absolute; padding: 9px 9px 0; background: #fff; border-radius: 3px; box-shadow: 0 30px 60px -18px rgba(0,0,0,.7); transition: transform .5s var(--ease-out); }
  .pol figure:hover { transform: rotate(0deg) scale(1.04) !important; z-index: 5; }
  .pol img { width: 100%; object-fit: cover; }
  .pol figcaption { padding: 10px 4px 14px; font-size: 18px; color: var(--ink); }
  .pol-a { left: 0; top: 30px; width: 46%; transform: rotate(-6deg); z-index: 1; }
  .pol-a img { aspect-ratio: 3/4; }
  .pol-b { right: 2%; top: 0; width: 44%; transform: rotate(5deg); }
  .pol-b img { aspect-ratio: 4/5; }
  .pol-c { left: 40%; top: 270px; width: 42%; transform: rotate(3deg); z-index: 2; }
  .pol-c img { aspect-ratio: 4/3; }
  .wh-form { position: relative; z-index: 3; }
  .wh-form :global(.cbf-bar-title) { text-align: left; font-size: 32px; margin-bottom: 18px; }

  /* GALLERY */
  .gal { padding: clamp(60px, 7vw, 90px) 0 clamp(70px, 8vw, 110px); }
  .gal-head { display: flex; justify-content: space-between; align-items: end; gap: 30px; }
  .gal-h { margin-top: 14px; }
  .gal-p { margin-top: 18px; }
  .gal-led { display: grid; grid-template-columns: auto 1fr; gap: 4px 26px; align-items: center; padding: 16px 22px; border-radius: 8px; background: var(--night); border: 2px solid var(--cobalt); box-shadow: 0 0 30px -10px rgba(31,79,216,.7); min-width: 250px; transition: transform .35s var(--ease-out); }
  .gal-led:hover { transform: translateY(-3px); }
  .gal-led small { grid-column: 1 / -1; color: var(--cyan); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; }
  .gal-led-n { color: var(--yellow); font-size: 46px; line-height: 1; text-shadow: 0 0 12px rgba(255,210,31,.5); }
  .gal-led-t { color: var(--on-dark-2); font-size: 12px; font-weight: 600; line-height: 1.3; }
  .gal-filters { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 40px; }
  .gf { display: inline-flex; align-items: center; gap: 8px; min-height: 46px; padding: 0 20px; border-radius: 99px; background: #fff; border: 1px solid #d8dfeb; color: var(--ink); font-weight: 700; font-size: 15px; transition: background .3s, color .3s, border-color .3s, transform .3s var(--ease-out); }
  .gf:hover { border-color: var(--cobalt); transform: translateY(-2px); }
  .gf.on { background: var(--cobalt); border-color: var(--cobalt); color: #fff; }
  .gf-n { display: grid; place-items: center; min-width: 24px; height: 22px; padding: 0 6px; border-radius: 99px; background: var(--yellow); color: var(--ink); font-size: 12px; }
  .gal-grid { display: grid; grid-template-columns: 1fr 2fr 1fr; grid-template-columns: repeat(4, 1fr); grid-auto-rows: 300px; gap: 20px; margin-top: 30px; }
  .gt { position: relative; overflow: hidden; border-radius: 10px; text-align: left; color: #fff; }
  .gt-photo { display: block; background: var(--night); cursor: zoom-in; }
  .gt-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .9s var(--ease-out); }
  .gt-photo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(11,15,26,.88) 0%, rgba(11,15,26,.2) 45%, transparent 70%); transition: opacity .4s; }
  .gt-photo:hover img, .gt-photo:focus-visible img { transform: scale(1.07); }
  .gt-cat { position: absolute; z-index: 2; left: 14px; top: 14px; padding: 5px 8px; border-radius: 4px; background: var(--yellow); color: var(--ink); font: 800 11px/1 var(--body); letter-spacing: .1em; text-transform: uppercase; }
  .gt-go { position: absolute; z-index: 2; right: 14px; top: 14px; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: #fff; color: var(--ink); transition: transform .4s var(--ease-out), background .3s; }
  .gt-photo:hover .gt-go { transform: rotate(-45deg) scale(1.1); background: var(--yellow); }
  .gt-cap { position: absolute; z-index: 2; left: 18px; right: 18px; bottom: 16px; display: grid; gap: 3px; }
  .gt-cap strong { font-size: 30px; line-height: .95; }
  .gt-cap small { font-size: 13px; color: #dfe5f2; }
  .gt-town { display: inline-flex; align-items: center; gap: 5px; margin-top: 4px; color: var(--cyan); font-size: 12px; font-weight: 700; }
  .gt-town .ph { font-style: normal; }
  .gt-wh { grid-column: 1; grid-row: 1 / 3; }
  .gt-crawl { grid-column: 2 / 4; grid-row: 1; }
  .gt-follow { grid-column: 4; grid-row: 1; }
  .gt-snake { grid-column: 2; grid-row: 2; }
  .gt-ba { grid-column: 3 / 5; grid-row: 2; }
  .gt-roof { grid-column: 1; grid-row: 3 / 5; }
