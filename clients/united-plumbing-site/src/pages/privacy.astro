---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import LegalLayout from '../components/company/LegalLayout.astro';
import { SITE } from '../data/site';
---
<Base title="Privacy Policy | United Plumbing" description="How United Plumbing uses the details you send through this website." crumbs={[{ name: 'Privacy policy', href: '/privacy/' }]}>
  <LegalLayout doc="privacy" line1="Privacy policy" line2="in plain words.">
    <div class="short">
      <p class="h-display short-h">The short version</p>
      <ul>
        <li><Icon name="phone" size={20} /><span>We use what you send us to call you back, quote and do the work.</span></li>
        <li><Icon name="shield" size={20} /><span>We do not sell your personal information.</span></li>
        <li><Icon name="mail" size={20} /><span>Want it fixed or deleted? Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a><span class="m-hide"> or call <a href={SITE.phoneHref}>{SITE.phoneDisplay}</a></span>.</span></li>
      </ul>
    </div>

    <h2 class="h-display lg-doc">Privacy policy</h2>
    <p class="lg-meta">/privacy/ · Last updated: <em class="ph">[effective date]</em></p>
    <p class="lg-intro">United Plumbing ("we", "us") runs this website. This page explains what we collect and what we do with it.</p>

    <section class="lg-s" id="collect">
      <h3 class="h-display lg-h"><span class="led">01</span>What we collect</h3>
      <ul>
        <li><strong>What you send us:</strong> your name, phone number, email, town or address, details about your plumbing problem, and any photo you upload.</li>
        <li><strong>Basic site data:</strong> like most websites, we may collect your browser type, pages you visit and the time of your visit, using cookies or analytics tools. <em class="ph">[Analytics tools: list them once installed]</em></li>
        <li><strong>Calls:</strong> if you call us, we may keep a record of the call time and number. <em class="ph">[Call tracking: confirm if used]</em></li>
      </ul>
    </section>

    <section class="lg-s" id="use">
      <h3 class="h-display lg-h"><span class="led">02</span>How we use it</h3>
      <ul>
        <li>To call, text or email you back about your request.</li>
        <li>To schedule and do the work, and to send you a quote or invoice.</li>
        <li>To ask for a review after the job.</li>
        <li>To see how people use the website so we can make it better.</li>
      </ul>
    </section>

    <section class="lg-s lg-dark" id="dont">
      <p class="led dk-eb">03 · What we don't do</p>
      <h3 class="h-display dk-h">We do not sell your personal information.</h3>
      <p>We do not share it, except with people who help us run the business (for example, our phone, email, website or scheduling providers), or if the law requires it.</p>
    </section>

    <section class="lg-s" id="texts">
      <h3 class="h-display lg-h"><span class="led">04</span>Texts and calls</h3>
      <p>If you send a form, you agree we can call or text you about that request. Reply STOP to any text to stop texts.</p>
    </section>

    <section class="lg-s" id="keep">
      <h3 class="h-display lg-h"><span class="led">05</span>How long we keep it</h3>
      <p>We keep your details as long as we need them for your job, our records, and the law.</p>
    </section>

    <section class="lg-s" id="choices">
      <h3 class="h-display lg-h"><span class="led">06</span><span>Your choices (California<span class="m-hide"> residents</span>)</span></h3>
      <p>You can ask us what personal information we have about you, ask us to fix it, or ask us to delete it.</p>
      <ul class="rights">
        <li><span><Icon name="search" size={20} /></span><strong class="h-display">Ask what we have</strong><small><span class="m-hide">What personal information we hold about you.</span><span class="m-show">What we hold about you, and why.</span></small></li>
        <li><span><Icon name="wrench" size={20} /></span><strong class="h-display">Ask us to fix it</strong><small>Correct anything we got wrong.</small></li>
        <li><span><Icon name="minus" size={20} /></span><strong class="h-display">Ask us to delete it</strong><small>We remove it and tell you when it is done.</small></li>
      </ul>
      <p>Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a> or call <a href={SITE.phoneHref}>{SITE.phoneDisplay}</a>. We will not treat you differently for asking.</p>
    </section>

    <section class="lg-s" id="kids">
      <h3 class="h-display lg-h"><span class="led">07</span>Kids and changes</h3>
      <p>This website is not for children under 13, and we do not knowingly collect their information. If we change this policy, we will update the date at the top.</p>
    </section>

    <section class="lg-s" id="contact">
      <h3 class="h-display lg-h"><span class="led">08</span>Contact</h3>
      <p>United Plumbing · Pomona, CA 91767 · <a href={SITE.phoneHref}>{SITE.phoneDisplay}</a> · <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      <p>See also our <a href="/terms/">Terms of use</a>, or <a href="/contact/">contact us</a>.</p>
    </section>
  </LegalLayout>
</Base>

<style>
  .short { position: relative; overflow: hidden; padding: 24px 32px 28px; border-radius: 14px; background: #f3f6fb; }
  .short::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 6px; background: var(--yellow); }
  .short-h { font-size: 24px; line-height: 29px; letter-spacing: 0; color: var(--ink); }
  .short ul { display: grid; gap: 12px; margin-top: 11px; }
  .short li { display: flex; gap: 12px; align-items: start; font-size: 16px; line-height: 1.5; font-weight: 500; color: var(--ink); }
  .short li :global(.icon) { flex: none; margin-top: 2px; color: var(--cobalt); }
  .short a { color: var(--cobalt); text-decoration: underline; overflow-wrap: anywhere; }
  .lg-dark { position: relative; overflow: hidden; height: 210px; margin-bottom: 48px; padding: 26px 32px 0 !important; border-radius: 16px; border-top: 0 !important; background: radial-gradient(220px 150px at 600px 130px, rgba(31,79,216,.7), transparent 100%), radial-gradient(rgba(255,255,255,.05) 1px, transparent 1.3px) 0 0/12px 12px, var(--night); }
  .lg-dark + :global(section.lg-s) { margin-top: 0; }
  .lg-dark p { max-width: 640px; color: #a3aec6 !important; font-size: 15px !important; line-height: 1.5 !important; }
  .dk-eb { color: var(--cyan) !important; font-size: 14px !important; line-height: 17px !important; letter-spacing: .06em; word-spacing: .2em; text-transform: uppercase; margin-top: 0 !important; }
  .dk-h { max-width: 640px; margin-top: 6px; font-size: 38px; line-height: .95; letter-spacing: 0; color: var(--yellow); }
  .lg-dark .dk-h + p { margin-top: 10px !important; }
  .rights { grid-template-columns: repeat(3, 1fr); gap: 24px !important; margin-top: 16px; }
  .rights li { display: block; height: 150px; padding: 19px !important; border-radius: 12px; background: #f3f6fb; border: 1px solid #dce3ee; }
  .rights li::before { display: none; }
  .rights span { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 10px; background: var(--cobalt); color: #fff; }
  .rights strong { display: block; margin-top: 14px; font-size: 22px; line-height: 26px; letter-spacing: 0; color: var(--ink) !important; font-weight: 900 !important; }
  .rights small { display: block; margin-top: 2px; font-size: 13px; line-height: 1.45; color: #475569; }
  .rights + p { margin-top: 20px !important; }
  .m-show { display: none; }
  @media (max-width: 640px) {
    .m-hide { display: none; }
    .m-show { display: inline; }
    .lg-dark { background: radial-gradient(130px 110px at 290px 120px, rgba(31,79,216,.7), transparent 100%), radial-gradient(rgba(255,255,255,.05) 1px, transparent 1.3px) 0 0/12px 12px, var(--night); }
    .short { padding: 18px 20px 20px 22px; border-radius: 12px; }
    .short::before { width: 5px; }
    .short-h { font-size: 22px; line-height: 26px; }
    .short ul { gap: 12px; margin-top: 10px; }
    .short li { gap: 10px; font-size: 15px; line-height: 22px; }
    .short li :global(.icon) { width: 18px; height: 18px; }
    .lg-dark { height: auto; margin: 0 0 24px; padding: 20px 22px 24px !important; border-radius: 14px; }
    .dk-eb { font-size: 11px !important; line-height: 13px !important; }
    .dk-h { margin-top: 9px; font-size: 30px; line-height: 28px; }
    .lg-dark p { font-size: 14px !important; }
    .lg-dark .dk-h + p { margin-top: 12px !important; }
    .rights { grid-template-columns: 1fr; gap: 10px !important; margin-top: 14px; }
    .rights li { display: grid; grid-template-columns: 40px 1fr; gap: 0 14px; height: 76px; align-content: center; padding: 0 16px !important; }
    .rights span { grid-row: 1 / 3; }
    .rights strong { margin-top: 0; font-size: 20px; line-height: 24px; }
    .rights small { margin-top: 3px; font-size: 13px; line-height: 17px; }
    .rights + p { margin-top: 16px !important; }
  }
</style>
