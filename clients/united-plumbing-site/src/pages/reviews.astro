---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Btn from '../components/Btn.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Wave from '../components/Wave.astro';
import Ticker from '../components/Ticker.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import PageHero from '../components/company/PageHero.astro';
import HeroChips from '../components/company/HeroChips.astro';
import VideoTile from '../components/company/VideoTile.astro';
import { SITE } from '../data/site';
import crawl from '../assets/img/job-crawlspace.jpg';

// Town tags come from Jim's own Instagram captions (scan of 6 Nov 2026). Clips stay on Instagram until Jim sends the files.
const byTown = [
  { town: 'Pomona' }, { town: 'Chino', job: 'Leak repair' }, { town: 'Ontario' }, { town: 'Santa Ana' }, { town: 'West Covina' }, { town: 'Riverside' },
  { town: 'La Verne' }, { town: 'San Bernardino' }, { town: 'Yorba Linda', job: 'John' }, { town: 'Orange County' }, { town: 'East LA', job: 'Drain service' },
];
const steps = [
  { t: 'Tap the button', d: 'It opens our Google page on your phone.', m: 'It opens our Google page.' },
  { t: 'Say how it went', d: 'A line or two in your own words.' },
  { t: 'Say what we fixed', d: 'And your town. That is what helps neighbors most.', m: 'And your town.' },
];
---
<Base title="United Plumbing Reviews | Video Reviews | Pomona" description="Watch real customers talk about United Plumbing on camera. Pomona and nearby towns. Call (909) 587-0711." crumbs={[{ name: 'Reviews', href: '/reviews/' }]}>

  <PageHero crumbs={[{ name: 'Reviews', href: '/reviews/' }]} class="rv-hero">
    <div class="rh-grid">
      <div class="rh-copy">
        <p class="rh-pill" data-hero="1" data-hero-fx="pop"><i></i>Reviews · Recorded on the job</p>
        <h1 class="h-display rh-h" data-hero="2" data-hero-fx="lines">Real customers.<br /><span class="c-yellow">On camera.</span></h1>
        <p class="rh-p" data-hero="3" data-hero-fx="up">Anyone can type a review. Our customers say it to the camera,<span class="d-only"> in their own homes,</span> right after the job.</p>
        <div class="btn-row rh-btns" data-hero="4" data-hero-fx="up" data-hero-children>
          <Btn href={SITE.phoneHref} icon="phone" size="lg">Call {SITE.phone}</Btn>
          <Btn href="#contact" variant="outline-cyan" icon="message" size="lg">Get a call back</Btn>
        </div>
        <HeroChips order="5" />
      </div>
      <a href={SITE.instagram} target="_blank" rel="noopener" class="vf" data-hero="2" data-hero-fx="right" aria-label="Watch our customers on Instagram, @plumblord1">
        <span class="vf-shadow" aria-hidden="true"></span>
        <span class="vf-in">
          <Image src={crawl} alt="" widths={[500, 900]} sizes="(max-width: 900px) 92vw, 560px" loading="eager" class="vf-img" />
          <span class="vf-grid" aria-hidden="true"></span>
          <span class="vf-c vf-tl" aria-hidden="true"></span><span class="vf-c vf-tr" aria-hidden="true"></span><span class="vf-c vf-bl" aria-hidden="true"></span><span class="vf-c vf-br" aria-hidden="true"></span>
          <span class="vf-rec led" aria-hidden="true"><i></i>REC 00:38</span>
          <span class="vf-hd led" aria-hidden="true">1080P</span>
          <span class="vf-play" aria-hidden="true"><Icon name="play" size={30} /></span>
          <span class="vf-cap"><Icon name="instagram" size={20} /><span><strong class="h-display">On the job with @plumblord1</strong><small>Customers talk, Jim films.<span class="d-only"> No scripts.</span></small></span></span>
        </span>
      </a>
    </div>
  </PageHero>

  <!-- WATCH THEM -->
  <section class="wt light">
    <div class="wrap head-center">
      <Eyebrow>Video reviews</Eyebrow>
      <h2 class="h-display h2" data-split>Don't take our word.<br /><span class="c-cobalt">Watch them say it.</span></h2>
      <p class="lead" data-reveal="up">Real customers on camera, filmed on the job by Jim and posted on Instagram.</p>
    </div>
    <div class="wrap">
      <div class="wt-band" data-reveal="up">
        <span class="led wt-rec"><i></i>REC</span>
        <div class="wt-band-t"><p class="h-display">Video reviews on Instagram</p><small>Customers from Pomona to Santa Ana, on camera. @plumblord1 · {SITE.instagramFollowers} followers</small></div>
        <Btn href={SITE.instagram} target="_blank" icon="instagram" size="md">Watch on Instagram</Btn>
      </div>
      <div class="ft">
        <div data-reveal="up"><VideoTile tag="Featured clip" job="10 Jan 2026" class="ft-vid" /></div>
        <figure class="ft-q" data-reveal="up">
          <p class="ft-eb"><Icon name="quote" size={72} stroke={0.75} /><span>In their own words</span></p>
          <blockquote class="h-display">“Very honest, very helpful, and they’re <span class="c-yellow">not out to beat you.</span>”</blockquote>
          <figcaption><span class="ft-rule" aria-hidden="true"></span><strong>Customer, video review · Instagram, 10 Jan 2026</strong><small>Watch her say it in the clip on the left.</small></figcaption>
        </figure>
      </div>
    </div>
  </section>

  <Wave from="#F3F6FB" to="#0B0F1A" />

  <!-- QUOTE WALL -->
  <section class="qw dark">
    <div class="qw-glow" aria-hidden="true"></div>
    <div class="wrap head-center">
      <Eyebrow>In their own words</Eyebrow>
      <h2 class="h-display h2" data-split><span class="c-white">What customers</span><br /><span class="c-cyan">say on camera.</span></h2>
      <p class="lead" data-reveal="up">Lines taken from Jim's Instagram video reviews.</p>
    </div>
    <div class="wrap qw-grid" data-stagger="up">
      <figure class="q q-yellow">
        <Icon name="quote" size={32} stroke={1.25} class="q-ico" />
        <blockquote class="h-display">“unbelievable service... they were so fast, they were so efficient... <span class="c-cobalt">I’m so happy</span>”</blockquote>
        <figcaption><span><small>Video review · Instagram</small></span><a href={SITE.instagram} target="_blank" rel="noopener" aria-label="See this video review on Instagram"><Icon name="instagram" size={16} /></a></figcaption>
      </figure>
      <figure class="q q-blue">
        <Icon name="quote" size={32} stroke={1.25} class="q-ico" />
        <blockquote class="h-display">“He came out very quickly... walked me through everything”</blockquote>
        <figcaption><span><strong>San Bernardino</strong><small>Video review · Instagram</small></span><a href={SITE.instagram} target="_blank" rel="noopener" aria-label="See this video review on Instagram"><Icon name="instagram" size={16} /></a></figcaption>
      </figure>
      <figure class="q q-dark q-john">
        <Icon name="quote" size={32} stroke={1.25} class="q-ico" />
        <blockquote class="h-display">“on a Sunday... <span class="c-yellow">He came as fast as he could</span>”</blockquote>
        <figcaption><span><strong>John · Yorba Linda</strong><small>Video review · Instagram</small></span><a href={SITE.instagram} target="_blank" rel="noopener" aria-label="See this video review on Instagram"><Icon name="instagram" size={16} /></a></figcaption>
      </figure>
      <figure class="q q-dark q-sew">
        <Icon name="quote" size={32} stroke={1.25} class="q-ico" />
        <blockquote class="h-display">“The sewage was bad... <span class="c-yellow">There’s no smell anymore</span>”</blockquote>
        <figcaption><span><small>Video review · Instagram</small></span><a href={SITE.instagram} target="_blank" rel="noopener" aria-label="See this video review on Instagram"><Icon name="instagram" size={16} /></a></figcaption>
      </figure>
      <figure class="q q-white">
        <Icon name="quote" size={32} stroke={1.25} class="q-ico" />
        <blockquote class="h-display">“I would recommend it to everybody... Good prices, good service”</blockquote>
        <figcaption><span><strong>Ontario</strong><small>Video review · Instagram</small></span><a href={SITE.instagram} target="_blank" rel="noopener" aria-label="See this video review on Instagram"><Icon name="instagram" size={16} /></a></figcaption>
      </figure>
      <figure class="q q-es">
        <Icon name="quote" size={24} stroke={1.5} class="q-ico" />
        <blockquote class="h-display"><em class="ph">[SPANISH LINE, word for word from clip #5]</em></blockquote>
        <p class="q-tr"><strong>Translated from Spanish:</strong> my sink was clogged and they came and helped me on the first call... very honest, very pleasant, highly recommended.</p>
        <figcaption><span><small>Video review · Instagram</small></span><a href={SITE.instagram} target="_blank" rel="noopener" aria-label="See this video review on Instagram"><Icon name="instagram" size={16} /></a></figcaption>
      </figure>
    </div>
  </section>

  <Wave from="#0B0F1A" to="#F3F6FB" flip />

  <!-- BY TOWN -->
  <section class="bt light">
    <div class="wrap">
      <p class="bt-h" data-reveal="up"><span>More video reviews, by town</span></p>
      <ul class="bt-grid" data-stagger="up">
        {byTown.map((v, i) => <li class:list={{ 'bt-extra': i >= 6 }}><VideoTile town={v.town} job={v.job} /></li>)}
        <li class="bt-extra"><a href={SITE.instagram} target="_blank" rel="noopener" class="bt-more"><Icon name="instagram" size={40} class="bt-ig" /><span class="h-display">More on<br />Instagram</span><Icon name="arrow" size={22} /></a></li>
      </ul>
      <p class="bt-also">Also on camera: La Verne · San Bernardino · Yorba Linda · Orange County · East LA and more</p>
      <div class="bt-cta" data-reveal="up"><Btn href={SITE.instagram} target="_blank" variant="ink" icon="instagram" size="md">Watch them all on Instagram</Btn></div>
    </div>
  </section>

  <Wave from="#F3F6FB" to="#0B0F1A" />

  <!-- GOOGLE (placeholders until the profile is live) -->
  <section class="gg dark">
    <div class="gg-glow" aria-hidden="true"></div>
    <div class="wrap gg-grid">
      <div class="gg-copy">
        <Eyebrow>Google</Eyebrow>
        <h2 class="h-display h2 gg-h" data-split><span class="c-white">Google reviews,</span><br /><span class="c-cyan">coming soon.</span></h2>
        <p class="lead gg-p" data-reveal="up">Our Google profile is new. If we've worked for you, we'd love your review. They will show up right here.</p>
        <div class="gg-cta" data-reveal="up">
          <span class="btn btn-yellow btn-md gg-btn" aria-disabled="true"><Icon name="arrow" size={20} />Leave us a Google review</span>
          <p class="gg-note"><em class="ph">Google review link goes here once the profile is live</em></p>
        </div>
      </div>
      <div class="gg-cards" data-stagger="up">
        {[0, 1, 2].map((k) => (
          <div class:list={['gc', `gc-${k}`]} data-tilt>
            <div class="gc-top"><span class="gc-tag">Google review goes here</span><span class="gc-g">G</span></div>
            <div class="gc-lines"><i></i><i></i><i class="s"></i></div>
            <div class="gc-who"><span class="gc-av"></span><span><strong>{k === 2 ? 'Your review could be next' : 'Customer name'}</strong><small>{k === 2 ? 'Had us out? Tell people.' : 'Town · Google review'}</small></span></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Wave from="#0B0F1A" to="#F3F6FB" flip />

  <!-- HAD US OUT -->
  <section class="ho light" id="review-steps">
    <div class="wrap ho-head">
      <div>
        <Eyebrow>Had us out?</Eyebrow>
        <h2 class="h-display h2" data-split>Had us out?<br /><span class="c-cobalt">Tell people.</span></h2>
      </div>
      <p class="lead" data-reveal="up">A short Google review that says what we fixed and what town you're in helps your neighbors find a plumber they can trust.</p>
    </div>
    <div class="wrap ho-grid">
      <ol class="ho-steps" data-stagger="up">
        {steps.map((s, i) => (
          <li class:list={{ last: i === 2 }}>
            <span class="led ho-n">{i + 1}</span>
            <div><h3 class="h-display">{s.t}</h3><p>{s.m ? <><span class="d-only">{s.d}</span><span class="m-only">{s.m}</span></> : s.d}</p></div>
          </li>
        ))}
      </ol>
      <div class="ho-qr" data-reveal="up">
        <p class="ho-qr-eb">Scan to review</p>
        <div class="ho-qr-box"><div><p class="h-display">QR code<br />goes here</p><small>After the profile is live</small></div></div>
        <span class="btn btn-yellow btn-md ho-qr-btn" aria-disabled="true"><Icon name="arrow" size={20} />Review us on Google</span>
        <p class="ho-qr-note">Link added after the profile is live</p>
      </div>
    </div>
  </section>

  <Wave from="#F3F6FB" to="#1F4FD8" />

  <!-- SEND A VIDEO -->
  <section class="sv2">
    <div class="wrap sv2-grid">
      <span class="sv2-ico" data-reveal="pop"><Icon name="video" size={40} /></span>
      <div>
        <h2 class="h-display h2 sv2-h" data-split><span class="c-white">Had a job done?</span><br /><span class="c-yellow">Send us a video.</span></h2>
        <p class="sv2-p" data-reveal="up">Film 10 seconds on your phone: what we fixed and your town. Text it to {SITE.phone} or tag @plumblord1<span class="d-only"> on Instagram</span>.</p>
      </div>
      <div class="sv2-btns" data-reveal="up">
        <Btn href={SITE.smsHref} icon="phone" size="md" full>Text us a video</Btn>
        <Btn href={SITE.instagram} target="_blank" variant="outline-white" icon="instagram" size="md" full>Tag @plumblord1</Btn>
      </div>
    </div>
  </section>

  <ContactSection line1="Ready to be" line2="our next video?" />
  <Ticker items={['CALL 909-587-0711', '24/7', 'HABLAMOS ESPAÑOL', 'POMONA', 'CLAREMONT', 'CHINO', 'ONTARIO', 'UPLAND']} cyan reverse />
</Base>

<style>
  :global(section.ct) { position: relative; isolation: isolate; }
  /* HERO (Figma 316:811, 800 tall; px from the section top) */
  :global(.phero.rv-hero) { padding: 63px 0 0; min-height: 800px; }
  :global(.rv-hero .phero-bg::after) { background: linear-gradient(90deg, rgba(11,15,26,.97) 0%, rgba(11,15,26,.9) 55%, rgba(11,15,26,.7) 100%); }
  :global(.rv-hero .phero-glow) { display: none; }
  .rh-grid { position: relative; margin-top: 29px; min-height: 616px; }
  .rh-copy { position: relative; z-index: 2; max-width: 640px; }
  .rh-pill { display: inline-flex; align-items: center; gap: 8px; height: 31px; padding: 0 14px; border-radius: 99px; background: rgba(255,59,59,.14); color: #ff8a8a; font: 700 13px/17px var(--body); letter-spacing: .12em; text-transform: uppercase; }
  .rh-pill i { width: 9px; height: 9px; border-radius: 50%; background: #ff3b3b; box-shadow: 0 0 8px #ff3b3b; }
  .rh-h { margin-top: 13px; font-size: 116px; line-height: .86; letter-spacing: 0; color: #fff; }
  .rh-p { margin-top: 29px; max-width: 560px; font-size: 20px; line-height: 1.5; color: #c9d2e3; }
  .rh-btns { margin-top: 36px; gap: 16px; }
  .rh-btns :global(.btn) { --bh: 72px; height: 72px; min-width: 330px; padding: 0 28px; font-size: 26px; letter-spacing: .02em; }
  .rh-btns :global(.btn-outline-cyan) { min-width: 270px; border-width: 2px; background: transparent; font-size: 24px; }
  .rh-copy :global(.hchips) { margin-top: 32px; }
  .vf { position: absolute; right: 0; top: -36px; display: block; width: 580px; height: 600px; }
  .vf::before { content: ''; position: absolute; left: 60px; top: 80px; width: 480px; height: 480px; border-radius: 50%; background: radial-gradient(closest-side, rgba(51,214,255,.35), transparent); filter: blur(30px); }
  .vf-shadow { position: absolute; inset: 16px -16px -16px 16px; border-radius: 24px; background: var(--cobalt); }
  .vf-in { position: relative; display: block; overflow: hidden; width: 100%; height: 100%; border-radius: 24px; background: var(--night); }
  .vf-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 40% 30%; transition: transform 1s var(--ease-out); }
  .vf:hover .vf-img { transform: scale(1.05); }
  .vf-grid { position: absolute; inset: 0; background: linear-gradient(90deg, transparent calc(33.333% - .5px), rgba(255,255,255,.15) calc(33.333% - .5px) calc(33.333% + .5px), transparent calc(33.333% + .5px) calc(66.667% - .5px), rgba(255,255,255,.15) calc(66.667% - .5px) calc(66.667% + .5px), transparent calc(66.667% + .5px)), linear-gradient(180deg, transparent 199.5px, rgba(255,255,255,.15) 199.5px 200.5px, transparent 200.5px 399.5px, rgba(255,255,255,.15) 399.5px 400.5px, transparent 400.5px), rgba(5,7,13,.45); }
  .vf-c { position: absolute; width: 44px; height: 44px; border: 3px solid var(--cyan); }
  .vf-tl { left: 24px; top: 24px; border-right: 0; border-bottom: 0; border-radius: 6px 0 0 0; } .vf-tr { right: 24px; top: 24px; border-left: 0; border-bottom: 0; border-radius: 0 6px 0 0; }
  .vf-bl { left: 24px; bottom: 24px; border-right: 0; border-top: 0; border-radius: 0 0 0 6px; } .vf-br { right: 24px; bottom: 24px; border-left: 0; border-top: 0; border-radius: 0 0 6px 0; }
  .vf-rec { position: absolute; left: 44px; top: 44px; display: inline-flex; align-items: center; gap: 8px; width: 150px; height: 36px; padding: 0 14px; border-radius: 8px; background: rgba(5,7,13,.9); color: #fff; font-size: 18px; line-height: 1; }
  .vf-rec i { width: 12px; height: 12px; border-radius: 50%; background: #ff3b3b; animation: vfblink 1.4s steps(2) infinite; }
  @keyframes vfblink { 50% { opacity: .2; } }
  .vf-hd { position: absolute; right: 44px; top: 44px; display: grid; place-items: center; width: 80px; height: 36px; border-radius: 8px; background: rgba(5,7,13,.9); color: var(--cyan); font-size: 18px; line-height: 1; }
  .vf-play { position: absolute; left: 50%; top: 50%; display: grid; place-items: center; width: 112px; height: 112px; margin: -56px 0 0 -56px; border-radius: 50%; background: var(--yellow); color: var(--ink); box-shadow: 0 0 30px rgba(255,209,31,.45); transition: transform .5s var(--ease-out), box-shadow .5s; }
  .vf-play :global(.icon) { width: 44px; height: 44px; fill: currentColor; margin-left: 6px; }
  .vf:hover .vf-play { transform: scale(1.1); box-shadow: 0 0 0 16px rgba(255,210,31,.2); }
  .vf-cap { position: absolute; left: 44px; right: 44px; bottom: 44px; display: flex; align-items: center; gap: 14px; height: 74px; padding: 0 18px; border-radius: 12px; background: rgba(5,7,13,.92); color: #fff; }
  .vf-cap :global(.icon) { width: 26px; height: 26px; color: var(--cyan); flex: none; }
  .vf-cap strong { display: block; font-size: 24px; line-height: 29px; font-weight: 800; letter-spacing: 0; }
  .vf-cap small { display: block; margin-top: 1px; font-size: 13px; line-height: 17px; color: #a3aec6; }

  /* shared section eyebrows: Figma 13 px / .14em */
  .wt :global(.eyebrow), .qw :global(.eyebrow), .gg :global(.eyebrow), .ho :global(.eyebrow) { display: flex; font-size: 13px; line-height: 17px; letter-spacing: .14em; }
  .head-center :global(.eyebrow) { justify-content: center; }

  /* WATCH (Figma 327:437: 1182 to the wave) */
  .wt { padding: 96px 0 0; min-height: 1182px; }
  .wt .h2 { margin-top: 13px; font-size: 64px; line-height: .92; }
  .wt .lead { margin-top: 22px; font-size: 19px; line-height: 25px; color: #475569; }
  .wt-band { position: relative; overflow: hidden; display: grid; grid-template-columns: 190px 1fr 310px; align-items: center; height: 150px; margin-top: 39px; padding: 0 40px; border-radius: 20px; background: radial-gradient(260px 160px at 150px 70px, rgba(31,79,216,.55), transparent 75%), #0b0f1a; color: #fff; }
  .wt-rec { display: inline-flex; align-items: center; gap: 12px; color: var(--yellow); font-size: 76px; line-height: 1; text-shadow: 0 0 16px rgba(255,210,31,.5); }
  .wt-rec i { width: 18px; height: 18px; border-radius: 50%; background: #ff3b3b; box-shadow: 0 0 12px #ff3b3b; animation: vfblink 1.4s steps(2) infinite; }
  .wt-band-t { align-self: start; padding-top: 34px; }
  .wt-band-t p { font-size: 44px; line-height: 53px; letter-spacing: .02em; }
  .wt-band-t small { display: block; margin: 3px 0 0 2px; font-size: 16px; line-height: 21px; color: #a3aec6; }
  .wt-band :global(.btn) { --bh: 64px; height: 64px; width: 310px; font-size: 22px; }
  .ft { display: grid; grid-template-columns: 360px minmax(0, 1fr); gap: 30px; margin-top: 50px; }
  .ft > div { display: flex; }
  .ft :global(.ft-vid) { width: 100%; height: 620px; aspect-ratio: auto; border-radius: 18px; }
  .ft :global(.ft-vid .vt-play) { top: 42%; width: 76px; height: 76px; margin: -38px 0 0 -38px; box-shadow: 0 0 24px rgba(255,209,31,.45); }
  .ft :global(.ft-vid .vt-play .icon) { width: 29px; height: 29px; }
  .ft-q { position: relative; overflow: hidden; display: flex; flex-direction: column; height: 620px; padding: 60px 60px 74px; border-radius: 22px; background: radial-gradient(260px 210px at 780px 50px, rgba(31,79,216,.6), transparent 75%), #0b0f1a; color: #fff; border-left: 8px solid var(--yellow); }
  .ft-eb { display: flex; align-items: center; gap: 18px; margin-left: -8px; color: var(--yellow); }
  .ft-eb :global(.icon) { width: 72px; height: 72px; }
  .ft-eb span { color: var(--cyan); font: 700 14px/18px var(--body); letter-spacing: .14em; text-transform: uppercase; }
  .ft-q blockquote { margin: 38px 0 0 -8px; max-width: 770px; font-size: 74px; line-height: .98; letter-spacing: 0; text-transform: none; }
  .ft-q figcaption { margin: auto 0 0 -8px; display: grid; }
  .ft-rule { display: block; width: 64px; height: 3px; margin-bottom: 21px; background: var(--cyan); }
  .ft-q strong { font-size: 18px; line-height: 23px; font-weight: 600; } .ft-q small { margin-top: 9px; color: #a3aec6; font-size: 15px; line-height: 20px; }

  /* QUOTE WALL (Figma 343:441: 1032 to the wave) */
  .qw { position: relative; overflow: hidden; padding: 70px 0 0; min-height: 1032px; }
  .qw-glow { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(260px 260px at 140px 460px, rgba(31,79,216,.35), transparent 75%), radial-gradient(260px 260px at 1260px 760px, rgba(168,38,95,.3), transparent 75%); }
  .qw .h2 { margin-top: 13px; font-size: 64px; line-height: .92; }
  .qw .lead { margin-top: 10px; font-size: 18px; line-height: 23px; color: #a3aec6; }
  .qw-grid { position: relative; display: grid; grid-template-columns: 300fr 300fr 310fr 310fr; grid-template-rows: 220px 100px 270px; gap: 20px; margin-top: 39px; }
  .q { position: relative; display: flex; flex-direction: column; padding: 26px 28px 20px; border-radius: 20px; transition: transform .45s var(--ease-out), box-shadow .45s; }
