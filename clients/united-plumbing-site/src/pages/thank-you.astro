---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Btn from '../components/Btn.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Wave from '../components/Wave.astro';
import Ticker from '../components/Ticker.astro';
import { SITE } from '../data/site';
import jim from '../assets/img/jim-cutout.png';

const sent = [
  { k: 'name', l: 'Name', m: 'Name', i: 'user' }, { k: 'phone', l: 'Phone', m: 'Phone', i: 'phone' },
  { k: 'zip', l: 'ZIP code', m: 'ZIP', i: 'pin' }, { k: 'problem', l: "What's wrong?", m: 'Problem', i: 'wrench' },
];
const steps = [
  { tag: 'Now', t: 'We got your request', d: "Your name, number and problem just landed with Jim's team. Nothing else to fill in." },
  { tag: 'Next', t: 'We call you back', d: `The call comes from ${SITE.phone}. Answer it, tell us what you see, or text a photo.` },
  { tag: 'On site', t: 'Clear price, then the fix', d: 'You hear the price before any work starts. You say yes, we fix it. No hidden fees.' },
];
const tips = [
  { i: 'drop', t: 'Shut off the water.', d: 'Main valve, or the small valve under the sink or toilet.' },
  { i: 'wrench', t: 'Stop using the drain', d: 'if it is backing up. No flushing, no running water into it.' },
  { i: 'flame', t: 'Smell gas? Leave.', d: 'Leave the house. Call SoCalGas from outside.' },
];
---
<Base title="Thanks, We Got Your Message | United Plumbing" description="Thanks for reaching out to United Plumbing. We will call you back from (909) 587-0711." noindex={true}>

  <section class="ty dark">
    <div class="ty-bg" aria-hidden="true"></div>
    <div class="wrap ty-in">
      <div class="ty-copy">
        <div class="ty-ok" data-hero="1" data-hero-fx="pop"><span class="ty-check"><Icon name="checkCircle" size={44} stroke={2} /></span><span class="ty-ok-t"><span>Message sent</span><span class="ty-ok-sep" aria-hidden="true">&nbsp;&nbsp;·&nbsp;&nbsp;</span><span>Thank you</span></span></div>
        <h1 class="h-display ty-h" data-hero="2" data-hero-fx="lines">Got it.<br />We'll call<br /><span class="c-yellow">you soon.</span></h1>
        <p class="ty-p" data-hero="3" data-hero-fx="up">Thanks<span data-fname></span>. Your message is with the family now. We'll call you back from {SITE.phoneDisplay}, so keep your phone close.</p>
        <p class="ty-small" data-hero="4" data-hero-fx="up">Calls usually go back within <em class="ph">[callback time: Jim to confirm]</em>.</p>
        <a href={SITE.phoneHref} class="ty-led" data-hero="5" data-hero-fx="up" aria-label={`Status: call queued. Tap to call ${SITE.phone}`}>
          <span class="led ty-led-top"><span class="d-only">Status&nbsp;&nbsp;&nbsp;·&nbsp;&nbsp;&nbsp;24/7&nbsp;&nbsp;&nbsp;·&nbsp;&nbsp;&nbsp;English / Español</span><span class="m-only">Status · 24/7 · EN / ES</span></span><i aria-hidden="true"></i>
          <span class="led ty-led-big">CALL QUEUED</span>
        </a>
      </div>
      <div class="ty-photo">
        <div class="ty-jim" data-hero="2" data-hero-fx="right">
          <span class="ty-ring" aria-hidden="true"></span>
          <Image src={jim} alt="Jim Galvez, owner of United Plumbing" widths={[320, 520, 860]} sizes="(max-width: 1180px) 250px, 428px" loading="eager" format="webp" class="ty-img" />
          <span class="ty-tag h-display"><span>Jim Galvez · Owner<span class="d-only"> &amp; plumber</span></span></span>
        </div>
        <div class="ty-card" data-sent-card data-hero="6" data-hero-fx="up">
          <p class="h-display ty-card-h">What you sent us</p>
          <dl>
            {sent.map((r) => <div><dt><Icon name={r.i} size={18} /><span class="d-only">{r.l}</span><span class="m-only">{r.m}</span></dt><dd data-sent={r.k}>Not sent</dd></div>)}
          </dl>
          <p class="ty-card-f">Wrong number? Call <a href={SITE.phoneHref}>{SITE.phone}</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <Wave from="#0B0F1A" to="#F3F6FB" flip />

  <section class="st3 light">
    <div class="wrap head-center">
      <Eyebrow>What happens next</Eyebrow>
      <h2 class="h-display h2 st3-h" data-split>Three steps.<br /><span class="c-cobalt">Then it gets fixed.</span></h2>
    </div>
    <div class="wrap st3-rail">
      <div class="st3-pipe" aria-hidden="true"><span data-progress></span></div>
      <ol class="st3-list" data-stagger="up">
        {steps.map((s, i) => (
          <li class:list={{ last: i === 2 }}>
            <span class="st3-tag led">{s.tag}</span>
            <span class="st3-node" aria-hidden="true"><i></i></span>
            <div class="st3-card" data-tilt>
              <span class="led st3-n">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="h-display">{s.t}</h3>
              <p>{s.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Wave from="#F3F6FB" to="#131B2E" flip />

  <section class="cw dark2">
    <div class="cw-bg dots-bg" aria-hidden="true"></div>
    <div class="wrap cw-grid">
      <div class="cw-y" data-reveal="up">
        <p class="cw-eb">Can't wait?</p>
        <h2 class="h-display cw-h">Water still running?</h2>
        <p class="cw-p">Don't wait for us to call. Call us now.</p>
        <a href={SITE.phoneHref} class="cw-led" aria-label={`Tap to call ${SITE.phone}, 24/7`}><span class="led cw-led-top">Tap to call&nbsp;&nbsp;·&nbsp;&nbsp;24/7</span><span class="led cw-led-big">{SITE.phone}</span></a>
        <div class="cw-row">
          <Btn href={SITE.phoneHref} variant="ink" icon="phone" size="lg" class="cw-call">Call {SITE.phoneDisplay}</Btn>
          <a href={SITE.backupHref} class="cw-backup">Backup line {SITE.backupPhone.replace(/^(\d{3})-/, '($1) ')}</a>
        </div>
      </div>
      <div class="cw-v" data-reveal="up">
        <h2 class="h-display cw-v-h">See what our<br />customers say</h2>
        <a href={SITE.instagram} target="_blank" rel="noopener" class="cw-tile" aria-label="Watch a video review on Instagram">
          <span class="cw-tile-top"><Icon name="instagram" size={22} />Video review · Instagram</span>
          <span class="cw-play" aria-hidden="true"><Icon name="play" size={24} /></span>
          <span class="led cw-tile-cap">Video 2 · 18s</span>
        </a>
        <p class="cw-stats"><span class="led c-yellow">{SITE.instagramFollowers}</span><small>Instagram followers<br />{SITE.facebookFollowers} on Facebook</small></p>
        <Btn href={SITE.instagram} target="_blank" variant="outline-cyan" icon="instagram" size="md" full class="cw-follow">Follow @plumblord1</Btn>
      </div>
    </div>
  </section>

  <Wave from="#131B2E" to="#F3F6FB" flip />

  <section class="tips light">
    <div class="wrap head-center">
      <Eyebrow>While you wait</Eyebrow>
      <h2 class="h-display h2 st3-h" data-split>3 things to do<br /><span class="c-cobalt">right now.</span></h2>
    </div>
    <ul class="wrap tips-grid" data-stagger="up">
      {tips.map((t, i) => (
        <li class:list={{ dark: i === 2 }} data-tilt>
          <div class="tip-top"><span class="tip-ico"><Icon name={t.i} size={32} /></span><span class="led tip-n">Tip {String(i + 1).padStart(2, '0')}</span></div>
          <h3 class="h-display">{t.t}</h3>
          <p>{t.d}</p>
        </li>
      ))}
    </ul>
    <div class="wrap tips-back" data-reveal="up"><a href="/" class="h-display"><Icon name="chevronLeft" size={20} stroke={2.5} />Back to home</a></div>
  </section>

  <Wave from="#F3F6FB" to="#0B0F1A" />
  <Ticker items={['CALL 909-587-0711', '24/7', 'HABLAMOS ESPAÑOL', 'POMONA', 'CLAREMONT', 'CHINO', 'ONTARIO', 'UPLAND']} cyan reverse />
</Base>

<script>
  // When the form back-end sends people here with their details in the query string, show them back.
  const q = new URLSearchParams(location.search);
  const name = (q.get('name') || '').trim();
  const fn = document.querySelector('[data-fname]');
  if (fn && name) fn.textContent = `, ${name.split(/\s+/)[0]}`;
  let any = false;
  document.querySelectorAll<HTMLElement>('[data-sent]').forEach((dd) => {
    const v = (q.get(dd.dataset.sent!) || '').trim();
    if (v) { dd.textContent = v; any = true; }
  });
  if (!any) document.querySelector('[data-sent-card]')?.classList.add('is-empty');
</script>

<style>
  /* Thank you, Figma 293:437 (desktop) and 301:437 (mobile 390). Positions follow the frame numbers. */
  .d-only { display: inline; } .m-only { display: none; }

  /* Hero, 03 Confirmation (760 tall + wave). */
  .ty { position: relative; z-index: 1; height: 762px; }
  .ty-bg { position: absolute; inset: 0; overflow: hidden; pointer-events: none;
    background-color: transparent;
    background-image: radial-gradient(rgba(255,255,255,.06) 1px, transparent 1.2px), radial-gradient(420px 420px at 1160px 340px, rgba(31,79,216,.7), rgba(31,79,216,.3) 45%, transparent 75%), radial-gradient(closest-side at 100px 620px, rgba(31,79,216,.28), transparent);
    background-size: 14px 14px, 100% 100%, 100% 100%; }
  .ty-in { position: relative; height: 100%; }
  .ty-copy { position: relative; z-index: 2; width: 780px; padding-top: 96px; }
  .ty-ok { display: flex; align-items: flex-start; gap: 24px; color: var(--cyan); font: 700 13px/normal var(--body); letter-spacing: .14em; text-transform: uppercase; }
  .ty-ok-t { margin-top: 30px; white-space: nowrap; }
  .ty-check { display: grid; place-items: center; flex: none; width: 88px; height: 88px; border-radius: 50%; background: #131b2e; border: 3px solid var(--cyan); color: var(--cyan); filter: drop-shadow(0 0 14px rgba(51,214,255,.45)); }
  .ty-h { margin-top: 32px; font-size: 100px; line-height: .88; letter-spacing: 0; color: #fff; }
  .ty-p { margin-top: 28px; max-width: 640px; font-size: 19px; line-height: 1.5; color: #a3aec6; }
  .ty-small { margin-top: 13px; color: var(--cyan); font: 600 14px/normal var(--body); }
  .ty-small .ph { font-style: normal; }
  .ty-led { position: relative; display: block; width: 640px; height: 116px; margin-top: 28px; border-radius: 14px; background: #070a12; border: 2px solid var(--cobalt); overflow: hidden;
    background-image: radial-gradient(rgba(255,255,255,.06) 1px, transparent 1.2px); background-size: 8px 8px; transition: box-shadow .3s; }
  .ty-led:hover { box-shadow: 0 0 40px -10px rgba(31,79,216,.9); }
  .ty-led i { position: absolute; left: 594px; top: 18px; width: 14px; height: 14px; border-radius: 50%; background: #ff3b3b; box-shadow: 0 0 10px #ff3b3b; animation: tyb 1.4s steps(2) infinite; }
  @keyframes tyb { 50% { opacity: .25; } }
  .ty-led-top { position: absolute; left: 22px; top: 14px; color: var(--cyan); font-size: 13px; line-height: normal; letter-spacing: .06em; text-transform: uppercase; white-space: nowrap; }
  .ty-led-big { position: absolute; left: 20px; top: 36px; color: var(--yellow); font-size: 52px; line-height: normal; letter-spacing: .02em; white-space: nowrap; text-shadow: 0 0 14px rgba(255,210,31,.45); }

  /* Photo zone: page x 780 to 1440 at 1440 wide. */
  .ty-photo { position: absolute; top: 0; right: -80px; width: 660px; height: 760px; }
  .ty-jim { position: absolute; inset: 0; overflow: hidden; }
  .ty-ring { position: absolute; left: 80px; top: 137px; width: 520px; height: 520px; border-radius: 50%; border: 2px dashed rgba(51,214,255,.45); opacity: .9; }
  .ty-img { position: absolute; left: 132px; top: 107px; width: 428px; height: 673px; object-fit: contain; }
  .ty-tag { position: absolute; left: 536px; top: 177px; display: grid; place-items: center; width: 44px; height: 250px; border-radius: 6px; background: var(--cobalt); color: #fff; }
  .ty-tag > span { writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; font-size: 15px; font-weight: 800; letter-spacing: 1.2px; line-height: 1; }
  .ty-card { position: absolute; left: 220px; top: 480px; z-index: 3; width: 360px; height: 250px; padding: 24px 24px 0; border-radius: 16px; background: #fff; color: var(--ink); overflow: hidden; box-shadow: 0 18px 40px rgba(0,0,0,.45); }
  .ty-card::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 6px; background: var(--yellow); }
  .ty-card-h { font-size: 22px; line-height: normal; letter-spacing: 0; }
  .ty-card dl { margin: 4px 0 0; }
  .ty-card dl > div { display: grid; grid-template-columns: 152px 1fr; align-items: center; height: 42px; border-bottom: 1px solid #dce3ee; font-size: 13px; line-height: normal; }
  .ty-card dl > div:last-child { border-bottom: 0; }
  .ty-card dt { display: flex; align-items: center; gap: 10px; color: #475569; font-weight: 600; }
  .ty-card dt :global(.icon) { color: var(--cobalt); }
  .ty-card dd { margin: 0; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ty-card.is-empty dd { color: #8a96ab; }
  .ty-card-f { font-size: 12px; line-height: normal; color: #475569; }
  .ty-card-f a { color: var(--cobalt); text-decoration: underline; }

  /* 04 What happens next (670 + wave). */
  .st3 { padding: 86px 0 32px; }
  .st3-h { margin-top: 8px; font-size: 60px; line-height: .92; letter-spacing: 0; }
  .st3-rail { position: relative; margin-top: 64px; }
  .st3-pipe { position: absolute; left: 0; right: 0; top: 36px; height: 8px; border-radius: 4px; background: var(--ink); }
  .st3-pipe span { position: absolute; left: 0; right: 0; top: 3px; height: 2px; border-radius: 1px; background: var(--cyan); }
  .st3-list { position: relative; display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
  .st3-list li { position: relative; padding-top: 86px; }
  .st3-tag { position: absolute; left: 70px; top: 0; color: #475569; font-size: 14px; line-height: normal; letter-spacing: .08em; text-transform: uppercase; }
  .last .st3-tag { color: var(--cobalt); }
  .st3-node { position: absolute; left: 20px; top: 22px; width: 36px; height: 36px; border-radius: 8px; background: var(--cobalt); }
  .st3-node i { position: absolute; left: 10px; top: 16px; width: 16px; height: 4px; border-radius: 2px; background: #fff; }
  .last .st3-node { background: var(--yellow); }
  .last .st3-node i { background: var(--ink); }
  .st3-card { position: relative; overflow: hidden; min-height: 260px; padding: 26px 26px 20px; border-radius: 16px; background: #fff; border: 1px solid #dce3ee; }
  .last .st3-card { background: radial-gradient(130px 100px at 349px 219px, rgba(31,79,216,.85), rgba(31,79,216,.25) 60%, transparent 100%), var(--night); border-color: var(--night); color: #fff; }
  .st3-n { display: grid; place-items: center; width: 104px; height: 80px; border-radius: 10px; background: #070a12; border: 2px solid var(--cobalt); color: var(--cyan); font-size: 52px; line-height: 1; letter-spacing: 0;
    background-image: radial-gradient(rgba(255,255,255,.06) 1px, transparent 1.2px); background-size: 8px 8px; }
  .last .st3-n { border-color: var(--yellow); color: var(--yellow); }
  .st3-card h3 { margin-top: 24px; font-size: 30px; line-height: .95; letter-spacing: 0; color: var(--ink); }
  .last .st3-card h3 { color: #fff; }
  .st3-card p { margin-top: 17px; font-size: 16px; line-height: 1.5; color: #475569; }
  .last .st3-card p { color: #a3aec6; }

  /* 05 Call now + follow (640 + wave). */
  .cw { position: relative; padding: 80px 0 62px; }
  .cw-bg { position: absolute; inset: 0; pointer-events: none; opacity: .8; }
  .cw-grid { position: relative; display: grid; grid-template-columns: minmax(0, 820fr) minmax(0, 420fr); gap: 40px; }
  .cw-y { min-height: 500px; padding: 74px 48px 40px; border-radius: 20px; background: var(--yellow); color: var(--ink); }
  .cw-eb { font: 700 14px/normal var(--body); letter-spacing: .14em; text-transform: uppercase; }
  .cw-h { margin-top: 10px; font-size: 72px; line-height: .9; letter-spacing: 0; }
  .cw-p { margin-top: 10px; font: 500 20px/normal var(--body); }
  .cw-led { position: relative; display: block; width: min(560px, 100%); height: 104px; margin-top: 24px; border-radius: 12px; background: #070a12;
    background-image: radial-gradient(rgba(255,255,255,.06) 1px, transparent 1.2px); background-size: 8px 8px; transition: transform .3s var(--ease-out); }
  .cw-led:hover { transform: translateY(-2px); }
  .cw-led-top { position: absolute; left: 24px; top: 14px; color: var(--cyan); font-size: 12px; line-height: normal; letter-spacing: .06em; text-transform: uppercase; white-space: nowrap; }
  .cw-led-big { position: absolute; left: 22px; top: 30px; color: var(--yellow); font-size: 56px; line-height: normal; letter-spacing: 0; white-space: nowrap; text-shadow: 0 0 14px rgba(255,210,31,.4); }
  .cw-row { display: flex; align-items: center; gap: 28px; margin-top: 24px; }
  .cw-row :global(.cw-call) { padding: 0 36px; font-size: 28px; letter-spacing: .02em; }
  .cw-row :global(.cw-call .icon) { width: 22px; height: 22px; }
  .cw-backup { min-height: 44px; display: inline-flex; align-items: center; font: 700 17px/normal var(--body); text-decoration: underline; text-underline-offset: 3px; }
  .cw-v { position: relative; overflow: hidden; min-height: 500px; padding: 30px 31px 0 32px; border-radius: 20px; border: 1px solid #24304a;
    background: radial-gradient(220px 180px at 340px 50px, rgba(168,38,95,.5), transparent), radial-gradient(200px 180px at 90px 430px, rgba(31,79,216,.45), transparent), var(--night); }
  .cw-v-h { color: #fff; font-size: 34px; line-height: .92; letter-spacing: 0; }
  .cw-tile { position: relative; display: block; overflow: hidden; width: 100%; height: 176px; margin-top: 19px; border-radius: 14px; border: 1px solid #24304a;
    background: radial-gradient(120px 90px at 178px 88px, rgba(31,79,216,.75), transparent), #070a12; transition: transform .45s var(--ease-out), border-color .3s, box-shadow .45s; }
  .cw-tile::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(rgba(255,255,255,.06) 1px, transparent 1.2px); background-size: 8px 8px; }
  .cw-tile:hover { transform: translateY(-4px); border-color: rgba(51,214,255,.5); box-shadow: 0 20px 40px -18px rgba(31,79,216,.7); }
  .cw-tile-top { position: absolute; left: 15px; top: 15px; display: flex; align-items: center; gap: 8px; color: #a3aec6; font: 700 11px/normal var(--body); letter-spacing: .1em; text-transform: uppercase; }
  .cw-tile-top :global(.icon) { color: #fff; }
  .cw-play { position: absolute; left: 147px; top: 57px; display: grid; place-items: center; width: 60px; height: 60px; border-radius: 50%; background: var(--yellow); color: var(--ink); transition: transform .45s var(--ease-out), box-shadow .45s; }
  .cw-play :global(.icon) { margin-left: 3px; }
  .cw-tile:hover .cw-play { transform: scale(1.1); box-shadow: 0 0 0 10px rgba(255,210,31,.18); }
  .cw-tile-cap { position: absolute; left: 15px; top: 146px; color: var(--cyan); font-size: 14px; line-height: normal; }
  .cw-stats { display: flex; align-items: flex-start; gap: 0; height: 58px; margin-top: 21px; }
  .cw-stats .led { width: 158px; font-size: 48px; line-height: normal; letter-spacing: 0; }
  .cw-stats small { margin-top: 8px; color: var(--cyan); font: 700 11px/1.5 var(--body); letter-spacing: .08em; text-transform: uppercase; }
  .cw-v :global(.cw-follow) { margin-top: 44px; }

  /* 06 While you wait (652 + wave). */
  .tips { padding: 86px 0 37px; }
  .tips-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; margin-top: 56px; }
  .tips-grid li { min-height: 252px; padding: 31px 26px 20px; border-radius: 16px; background: #fff; border: 1px solid #dce3ee; border-top: 14px solid var(--yellow); transition: transform .4s var(--ease-out), box-shadow .4s; }
  .tips-grid li:hover { box-shadow: 0 24px 44px -24px rgba(11,15,26,.35); }
  .tips-grid li.dark { background: var(--night); color: #fff; border-color: var(--night); border-top-color: var(--yellow); }
  .tip-top { display: flex; align-items: center; gap: 20px; }
  .tip-ico { display: grid; place-items: center; width: 64px; height: 64px; border-radius: 14px; background: var(--night); color: var(--cyan); }
  .dark .tip-ico { background: var(--yellow); color: var(--ink); }
  .tip-n { margin-top: -5px; color: var(--cobalt); font-size: 16px; line-height: normal; letter-spacing: .08em; text-transform: uppercase; }
  .dark .tip-n { color: var(--yellow); }
  .tips-grid h3 { margin-top: 24px; font-size: 32px; line-height: .95; letter-spacing: 0; color: var(--ink); }
  .tips-grid .dark h3 { color: #fff; }
  .tips-grid p { margin-top: 9px; font-size: 16px; line-height: 1.5; color: #475569; }
  .tips-grid .dark p { color: #a3aec6; }
  .tips-back { display: flex; justify-content: center; margin-top: 35px; }
  .tips-back a { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 12px; color: var(--cobalt); font-size: 22px; font-weight: 800; letter-spacing: 0; }
  .tips-back a :global(.icon) { transition: transform .3s var(--ease-out); }
  .tips-back a:hover :global(.icon) { transform: translateX(-4px); }

  /* Narrow desktop and tablet: stack the hero photo under the copy, as on the phone frame. */
  @media (max-width: 1180px) {
    .ty { height: auto; padding-top: 40px; }
    .ty-bg { background-image: radial-gradient(rgba(255,255,255,.06) 1px, transparent 1.2px), radial-gradient(260px 260px at 260px calc(100% - 160px), rgba(31,79,216,.7), rgba(31,79,216,.28) 45%, transparent 75%); background-size: 14px 14px, 100% 100%; }
    .ty-copy { width: auto; max-width: 780px; padding-top: 0; }
