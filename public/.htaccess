# Hostinger (Apache/LiteSpeed) settings for the static export.
# The live domain is the non-www https://plumberkingagency.com (matches the canonical tags).
Options -Indexes
ErrorDocument 404 /404.html
# The hero VSL: the right type, so browsers play it (nosniff is on below).
AddType video/mp4 .mp4

<IfModule mod_rewrite.c>
  RewriteEngine On
  # http:// or www. -> https://plumberkingagency.com in ONE redirect (SEO fix 6, 2026-10-23; it used to take two hops).
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
  # /index.html and /folder/index.html -> the clean address, so the homepage has one URL (SEO fix 11).
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [L,R=301,NC]
  # /about -> /about/ (folders hold index.html)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.*[^/])$ /$1/ [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Browsers use HTTPS only for a year (SEO fix 5). Not includeSubDomains: the mail subdomains stay as Namecheap set them.
  Header always set Strict-Transport-Security "max-age=31536000"
  # JS, CSS and fonts come from /_next/static with hashed names, so they can be cached forever.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Images cached for a year (SEO fix 7). RULE: a changed image must get a NEW file name, or returning visitors keep
  # the old one for up to a year. The VSL keeps a week.
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|ico|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(mp4|webm)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>
